definition 1
unit pdp11v7
implements direct_emitter_v1

# A compact PDP-11 backend for the original Unix V7 0407 a.out format. The
# generated program is a normal, writable-text V7 executable and uses the
# historical inline-argument system-call convention.
go backend {
	func emitWord(out *RTGEmitter, value int) {
		out.Uint16(value)
	}

	func putWord(data []byte, at int, value int) {
		data[at] = byte(value)
		data[at+1] = byte(value >> 8)
	}

	func registerOperand(reg RTGRegister) int {
		return reg.Code
	}

	func deferredOperand(reg RTGRegister) int {
		return 8 + reg.Code
	}

	func autoIncrementOperand(reg RTGRegister) int {
		return 16 + reg.Code
	}

	func autoDecrementOperand(reg RTGRegister) int {
		return 32 + reg.Code
	}

	func indexedOperand(reg RTGRegister) int {
		return 48 + reg.Code
	}

	func emitDouble(out *RTGEmitter, opcode int, source int, destination int) {
		emitWord(out, opcode|(source<<6)|destination)
	}

	func emitMove(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		emitDouble(out, 0x1000, registerOperand(source), registerOperand(destination))
	}

	func emitImmediate(out *RTGEmitter, destination RTGRegister, value int) {
		emitDouble(out, 0x1000, autoIncrementOperand(pc), registerOperand(destination))
		emitWord(out, value)
	}

	func emitAddImmediate(out *RTGEmitter, destination RTGRegister, value int) {
		if value == 0 {
			return
		}
		emitDouble(out, 0x6000, autoIncrementOperand(pc), registerOperand(destination))
		emitWord(out, value)
	}

	func emitAddress(out *RTGEmitter, destination RTGRegister, memory RTGAddress) {
		if RTGAddressValid(memory) {
			emitDouble(out, 0x1000, autoIncrementOperand(pc), registerOperand(destination))
			at := out.Len()
			emitWord(out, memory.Addend)
			RTGAddressRelocAt(out, memory, at)
			return
		}
		if memory.Base.Valid {
			emitMove(out, destination, memory.Base)
		} else {
			emitImmediate(out, destination, 0)
		}
		if memory.Index.Valid {
			scale := memory.Scale
			if scale <= 0 {
				scale = 1
			}
			for i := 0; i < scale; i++ {
				emitDouble(out, 0x6000, registerOperand(memory.Index), registerOperand(destination))
			}
		}
		emitAddImmediate(out, destination, memory.Displacement)
	}

	func memoryOperand(out *RTGEmitter, memory RTGAddress) int {
		emitAddress(out, address, memory)
		return deferredOperand(address)
	}

	func emitLoadWidth(out *RTGEmitter, destination RTGRegister, address RTGAddress, size int, signed bool) {
		operand := memoryOperand(out, address)
		if size == 1 {
			emitDouble(out, 0x9000, operand, registerOperand(destination))
			if !signed {
				emitDouble(out, 0x4000, autoIncrementOperand(pc), registerOperand(destination))
				emitWord(out, 0xff00)
			}
			return
		}
		// V7 permits packed data at odd addresses, while the PDP-11 traps on an
		// odd word access. Assemble native words from two byte operations.
		temporary := scratch
		if destination.Code == scratch.Code {
			temporary = tertiary
		}
		emitDouble(out, 0x9000, autoIncrementOperand(r4), registerOperand(destination))
		emitDouble(out, 0x4000, autoIncrementOperand(pc), registerOperand(destination))
		emitWord(out, 0xff00)
		emitDouble(out, 0x9000, deferredOperand(r4), registerOperand(temporary))
		emitDouble(out, 0x4000, autoIncrementOperand(pc), registerOperand(temporary))
		emitWord(out, 0xff00)
		emitWord(out, 0x00c0|registerOperand(temporary))
		emitDouble(out, 0x5000, registerOperand(temporary), registerOperand(destination))
	}

	func emitLoadNative(out *RTGEmitter, destination RTGRegister, address RTGAddress) {
		emitLoadWidth(out, destination, address, 2, true)
	}
	func emitLoadI32(out *RTGEmitter, destination RTGRegister, address RTGAddress) {
		emitLoadWidth(out, destination, address, 2, true)
	}
	func emitLoadU32(out *RTGEmitter, destination RTGRegister, address RTGAddress) {
		emitLoadWidth(out, destination, address, 2, false)
	}
	func emitLoadI16(out *RTGEmitter, destination RTGRegister, address RTGAddress) {
		emitLoadWidth(out, destination, address, 2, true)
	}
	func emitLoadU16(out *RTGEmitter, destination RTGRegister, address RTGAddress) {
		emitLoadWidth(out, destination, address, 2, false)
	}
	func emitLoadI8(out *RTGEmitter, destination RTGRegister, address RTGAddress) {
		emitLoadWidth(out, destination, address, 1, true)
	}
	func emitLoadU8(out *RTGEmitter, destination RTGRegister, address RTGAddress) {
		emitLoadWidth(out, destination, address, 1, false)
	}

	func emitStoreWidth(out *RTGEmitter, address RTGAddress, source RTGRegister, size int) {
		operand := memoryOperand(out, address)
		if size == 1 {
			emitDouble(out, 0x9000, registerOperand(source), operand)
			return
		}
		temporary := scratch
		if source.Code == scratch.Code {
			temporary = tertiary
		}
		emitDouble(out, 0x9000, registerOperand(source), autoIncrementOperand(r4))
		emitMove(out, temporary, source)
		emitWord(out, 0x00c0|registerOperand(temporary))
		emitDouble(out, 0x9000, registerOperand(temporary), deferredOperand(r4))
	}
	func emitStoreNative(out *RTGEmitter, address RTGAddress, source RTGRegister) {
		emitStoreWidth(out, address, source, 2)
	}
	func emitStoreU32(out *RTGEmitter, address RTGAddress, source RTGRegister) {
		emitStoreWidth(out, address, source, 2)
	}
	func emitStoreU16(out *RTGEmitter, address RTGAddress, source RTGRegister) {
		emitStoreWidth(out, address, source, 2)
	}
	func emitStoreU8(out *RTGEmitter, address RTGAddress, source RTGRegister) {
		emitStoreWidth(out, address, source, 1)
	}

	func emitBinary(out *RTGEmitter, opcode int, destination RTGRegister, source RTGRegister) {
		emitDouble(out, opcode, registerOperand(source), registerOperand(destination))
	}
	func emitAdd(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		emitBinary(out, 0x6000, destination, source)
	}
	func emitSubtract(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		emitBinary(out, 0xe000, destination, source)
	}
	func emitMultiply(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		// MUL leaves the low half in the odd register of the selected pair. The
		// compiler's ordinary scalar path uses primary (r0) here.
		if destination.Code == 0 {
			emitWord(out, 0x7000|registerOperand(source))
			emitMove(out, destination, r1)
			return
		}
		emitImmediate(out, destination, 0)
	}
	func emitBitAnd(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		// BIC is AND NOT, so invert through the scratch register.
		emitMove(out, scratch, source)
		emitDouble(out, 0x5000, autoIncrementOperand(pc), registerOperand(scratch))
		emitWord(out, 0xffff)
		emitBinary(out, 0x4000, destination, scratch)
	}
	func emitBitOr(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		emitBinary(out, 0x5000, destination, source)
	}
	func emitBitXor(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		emitWord(out, 0x7800|(source.Code<<6)|registerOperand(destination))
	}
	func emitCompare(out *RTGEmitter, left RTGRegister, right RTGRegister) {
		emitDouble(out, 0x2000, registerOperand(right), registerOperand(left))
	}
	func emitTest(out *RTGEmitter, left RTGRegister, right RTGRegister) {
		emitDouble(out, 0x3000, registerOperand(right), registerOperand(left))
	}
	func emitIncrement(out *RTGEmitter, operand RTGRegister) {
		emitWord(out, 0x0a80|registerOperand(operand))
	}
	func emitDecrement(out *RTGEmitter, operand RTGRegister) {
		emitWord(out, 0x0ac0|registerOperand(operand))
	}
	func emitShiftLeftImmediate(out *RTGEmitter, operand RTGRegister, value byte) {
		for i := 0; i < int(value); i++ {
			emitWord(out, 0x0cc0|registerOperand(operand))
		}
	}
	func emitShiftRightUnsignedImmediate(out *RTGEmitter, operand RTGRegister, value byte) {
		for i := 0; i < int(value); i++ {
			emitDouble(out, 0x4000, autoIncrementOperand(pc), registerOperand(operand))
			emitWord(out, 1)
			emitWord(out, 0x0c00|registerOperand(operand))
		}
	}
	func emitShiftRightSignedImmediate(out *RTGEmitter, operand RTGRegister, value byte) {
		for i := 0; i < int(value); i++ {
			emitWord(out, 0x0c80|registerOperand(operand))
		}
	}

	func emitAbsoluteControl(out *RTGEmitter, opcode int, label RTGLabel) {
		emitWord(out, opcode)
		at := out.Len()
		emitWord(out, 0)
		out.RelocAt(at, RTGLabelIndex(label))
	}
	func emitCall(out *RTGEmitter, label RTGLabel) {
		emitAbsoluteControl(out, 0x09df, label)
	}
	func emitCallIndirect(out *RTGEmitter, operand RTGRegister) {
		emitWord(out, 0x0800|(pc.Code<<6)|deferredOperand(operand))
	}
	func emitJump(out *RTGEmitter, label RTGLabel) {
		emitAbsoluteControl(out, 0x005f, label)
	}

	func inverseBranch(condition RTGCondition) int {
		if condition.Code == 0 { return 0x0200 }
		if condition.Code == 1 { return 0x0300 }
		if condition.Code == 2 { return 0x0600 }
		if condition.Code == 3 { return 0x0700 }
		if condition.Code == 4 { return 0x0400 }
		if condition.Code == 5 { return 0x0500 }
		if condition.Code == 6 { return 0x8600 }
		if condition.Code == 7 { return 0x8700 }
		if condition.Code == 8 { return 0x8200 }
		return 0x8300
	}
	func emitJumpCondition(out *RTGEmitter, condition RTGCondition, label RTGLabel) {
		emitWord(out, inverseBranch(condition)|2)
		emitJump(out, label)
	}
	func emitSetCondition(out *RTGEmitter, condition RTGCondition, destination RTGRegister) {
		emitImmediate(out, destination, 0)
		emitWord(out, inverseBranch(condition)|2)
		emitImmediate(out, destination, 1)
	}
	func emitReturn(out *RTGEmitter) {
		emitWord(out, 0x0087)
	}
	func emitLeave(out *RTGEmitter) {
		emitMove(out, sp, frame)
		emitDouble(out, 0x1000, autoIncrementOperand(sp), registerOperand(frame))
	}
	func emitHostSyscall(out *RTGEmitter) {
		// Generic host syscalls are not used by the V7 runtime hooks.
		emitWord(out, 0x8900)
	}
	func emitMoveImmediate(out *RTGEmitter, destination RTGRegister, value int64) {
		emitImmediate(out, destination, int(value))
	}
	func emitVariableShift(out *RTGEmitter, direction RTGShiftDirection, signed bool) {
		_ = signed
		if direction == RTGShiftLeft {
			emitWord(out, 0x7400|(primary.Code<<6)|registerOperand(tertiary))
			return
		}
		emitMove(out, scratch, tertiary)
		emitDouble(out, 0x5000, autoIncrementOperand(pc), registerOperand(scratch))
		emitWord(out, 0xffff)
		emitIncrement(out, scratch)
		emitWord(out, 0x7400|(primary.Code<<6)|registerOperand(scratch))
	}
	func emitSignedDivide(out *RTGEmitter, remainder bool) {
		// Sign extend primary into the r0:r1 dividend pair and divide by scratch.
		emitMove(out, scratch, tertiary)
		emitMove(out, r1, primary)
		emitWord(out, 0x0dc0|registerOperand(primary))
		emitWord(out, 0x7200|(primary.Code<<6)|registerOperand(scratch))
		if remainder {
			emitMove(out, primary, r1)
		}
	}
	func emitCopyBytes(out *RTGEmitter) {
		loop := out.NewLabel()
		done := out.NewLabel()
		emitImmediate(out, primary, 0)
		emitCompare(out, copyCount, primary)
		emitJumpCondition(out, eq, done)
		out.Mark(loop)
		emitDouble(out, 0x9000, autoIncrementOperand(copySource), autoIncrementOperand(copyDestination))
		emitDecrement(out, copyCount)
		emitJumpCondition(out, ne, loop)
		out.Mark(done)
	}

	func patchRelocations(out *RTGEmitter) {
		dataBase := len(out.Code())
		bssBase := dataBase + len(out.Data())
		for i := 0; i < out.RelocationCount(); i++ {
			at := out.RelocationOffset(i)
			target := out.LabelPosition(out.RelocationLabel(i))
			if target >= 0 {
				putWord(out.Code(), at, target)
			}
		}
		for i := 0; i < out.AbsoluteRelocationCount(); i++ {
			at := out.AbsoluteRelocationOffset(i)
			target, ok := RTGResolveAbsoluteRelocation(out,
				out.AbsoluteRelocationKind(i), out.AbsoluteRelocationAddend(i),
				dataBase, bssBase)
			if ok {
				putWord(out.Code(), at, target)
			}
		}
	}

	func frameStart(out *RTGEmitter) int {
		emitDouble(out, 0x1000, registerOperand(frame), autoDecrementOperand(sp))
		emitMove(out, frame, sp)
		emitDouble(out, 0xe000, autoIncrementOperand(pc), registerOperand(sp))
		at := out.Len()
		emitWord(out, 0)
		return at
	}
	func frameFinish(out *RTGEmitter, at int, stackUsed int) {
		putWord(out.Code(), at, RTGAlignValue(stackUsed, 2))
	}
	func pushRegister(out *RTGEmitter, source RTGRegister) {
		emitDouble(out, 0x1000, registerOperand(source), autoDecrementOperand(sp))
	}
	func pushImmediate(out *RTGEmitter, value int) {
		emitDouble(out, 0x1000, autoIncrementOperand(pc), autoDecrementOperand(sp))
		emitWord(out, value)
	}
	func popRegister(out *RTGEmitter, destination RTGRegister) {
		emitDouble(out, 0x1000, autoIncrementOperand(sp), registerOperand(destination))
	}
	func loadFrame(out *RTGEmitter, destination RTGRegister, offset int) {
		emitDouble(out, 0x1000, indexedOperand(frame), registerOperand(destination))
		emitWord(out, -offset)
	}
	func storeFrame(out *RTGEmitter, offset int, source RTGRegister) {
		emitDouble(out, 0x1000, registerOperand(source), indexedOperand(frame))
		emitWord(out, -offset)
	}
	func addressFrame(out *RTGEmitter, destination RTGRegister, offset int) {
		emitMove(out, destination, frame)
		emitAddImmediate(out, destination, -offset)
	}
	func storeParamWord(out *RTGEmitter, word int, offset int) {
		registers := []RTGRegister{r0, r1, r2, r3}
		register := primary
		if word >= 0 && word < len(registers) {
			register = registers[word]
		} else {
			popRegister(out, register)
		}
		storeFrame(out, offset, register)
	}
	func callWordCount(out *RTGEmitter, label RTGLabel, wordCount int) {
		registers := []RTGRegister{r0, r1, r2, r3}
		limit := wordCount
		if limit > len(registers) {
			limit = len(registers)
		}
		for i := 0; i < limit; i++ {
			popRegister(out, registers[i])
		}
		emitCall(out, label)
	}

	func v7Entry(out *RTGEmitter, parameterCount int, stateOffset int) bool {
		_ = out
		_ = stateOffset
		return parameterCount == 0
	}
	func v7Write(out *RTGEmitter) {
		// On entry: r0=fd, r1=buffer, r2=count. V7 takes write's last two
		// arguments from the words following the trap. 0407 text is writable,
		// so fill those two words immediately before entering the kernel.
		emitDouble(out, 0x1000, registerOperand(r1), indexedOperand(pc))
		emitWord(out, 6)
		emitDouble(out, 0x1000, registerOperand(r2), indexedOperand(pc))
		emitWord(out, 4)
		emitWord(out, 0x8904)
		emitWord(out, 0)
		emitWord(out, 0)
	}
	func v7Exit(out *RTGEmitter, status RTGRegister) {
		if status.Code != r0.Code {
			emitMove(out, r0, status)
		}
		emitWord(out, 0x8901)
	}

	func appendWord(data []byte, value int) []byte {
		return append(data, byte(value), byte(value>>8))
	}
	func v7Image(out *RTGEmitter) []byte {
		code := out.Code()
		data := out.Data()
		result := make([]byte, 0, 16+len(code)+len(data))
		result = appendWord(result, 0x0107)
		result = appendWord(result, len(code))
		result = appendWord(result, len(data))
		result = appendWord(result, out.BSSSize())
		result = appendWord(result, 0)
		result = appendWord(result, 0)
		result = appendWord(result, 0)
		result = appendWord(result, 1)
		result = append(result, code...)
		result = append(result, data...)
		return result
	}
}

arch pdp11 {
	alias = "pdp11"
	endian = little
	word_bits = 16
	pointer_bits = 16
	instruction_alignment = 2
	stack_word_bytes = 2
	stack_alignment = 2
	unaligned_memory = false
	patch_relocations = go patchRelocations
	registers integer = [r0, r1, r2, r3, r4, r5, sp, pc]
	locations {
		primary = r0
		secondary = r1
		tertiary = r2
		scratch = r3
		address = r4
		copy_destination = r4
		copy_source = r3
		copy_count = r2
		stack = sp
		frame = r5
	}
	conditions {
		eq = 0
		ne = 1
		sle = 2
		sgt = 3
		slt = 4
		sge = 5
		ult = 6
		uge = 7
		ule = 8
		ugt = 9
	}
	bind {
		move = go emitMove
		address = go emitAddress
		load.native = go emitLoadNative
		load.i32 = go emitLoadI32
		load.u32 = go emitLoadU32
		load.i16 = go emitLoadI16
		load.u16 = go emitLoadU16
		load.i8 = go emitLoadI8
		load.u8 = go emitLoadU8
		store.native = go emitStoreNative
		store.u32 = go emitStoreU32
		store.u16 = go emitStoreU16
		store.u8 = go emitStoreU8
		add = go emitAdd
		subtract = go emitSubtract
		multiply = go emitMultiply
		bit_and = go emitBitAnd
		bit_or = go emitBitOr
		bit_xor = go emitBitXor
		compare = go emitCompare
		test = go emitTest
		increment = go emitIncrement
		decrement = go emitDecrement
		shift_left_immediate = go emitShiftLeftImmediate
		shift_right_unsigned_immediate = go emitShiftRightUnsignedImmediate
		shift_right_signed_immediate = go emitShiftRightSignedImmediate
		call = go emitCall
		call_indirect = go emitCallIndirect
		jump = go emitJump
		jump_condition = go emitJumpCondition
		set_condition = go emitSetCondition
		return = go emitReturn
		leave = go emitLeave
		host_syscall = go emitHostSyscall
		move_immediate = go emitMoveImmediate
		variable_shift = go emitVariableShift
		signed_divide = go emitSignedDivide
		copy_bytes = go emitCopyBytes
	}
}

abi renvo_pdp11 {
	arch = pdp11
	frame_start = go frameStart
	frame_finish = go frameFinish
	push_register = go pushRegister
	push_immediate = go pushImmediate
	pop_register = go popRegister
	frame_load = go loadFrame
	frame_store = go storeFrame
	frame_address = go addressFrame
	store_param_word = go storeParamWord
	call_word_count = go callWordCount
	call_words = [r0, r1, r2, r3]
	overflow_stride = 2
	scalar_result = r0
	stack_alignment = 2
}

runtime unix_v7 {
	emit_entry = go v7Entry
	emit_exit = go v7Exit
	operation write { emit = go v7Write }
	operation print { use = write args = [stdout, buffer, count] }
}

format v7_aout_0407 {
	kind = "v7-a.out"
	byte_order = little
	address_bits = 16
	code_offset = 0
	image = go v7Image
}

target unixv7/pdp11 {
	family = native_v1
	os = unixv7
	arch = pdp11
	abi = renvo_pdp11
	runtime = unix_v7
	executable = v7_aout_0407
	build_tags = [unix, unixv7, pdp11]
	capabilities = [hosted, executable]
}
