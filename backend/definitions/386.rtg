	func x86_32Add(
		out *RTGEmitter, destination RTGRegister, source RTGRegister,
	) {
		x86_32Binary(out, 0x01, destination, source)
	}

	func x86_32Subtract(
		out *RTGEmitter, destination RTGRegister, source RTGRegister,
	) {
		x86_32Binary(out, 0x29, destination, source)
	}

	func x86_32Multiply(
		out *RTGEmitter, destination RTGRegister, source RTGRegister,
	) {
		out.Bytes2(0x0f, 0xaf)
		x86_32ModRM(out, 3, x86_32Low3(destination), x86_32Low3(source))
	}

	func x86_32BitAnd(
		out *RTGEmitter, destination RTGRegister, source RTGRegister,
	) {
		x86_32Binary(out, 0x21, destination, source)
	}

	func x86_32BitOr(
		out *RTGEmitter, destination RTGRegister, source RTGRegister,
	) {
		x86_32Binary(out, 0x09, destination, source)
	}

	func x86_32BitXor(
		out *RTGEmitter, destination RTGRegister, source RTGRegister,
	) {
		x86_32Binary(out, 0x31, destination, source)
	}

	func x86_32Compare(
		out *RTGEmitter, left RTGRegister, right RTGRegister,
	) {
		x86_32Binary(out, 0x39, left, right)
	}

	func x86_32Test(
		out *RTGEmitter, left RTGRegister, right RTGRegister,
	) {
		x86_32Binary(out, 0x85, left, right)
	}

	func x86_32Group(
		out *RTGEmitter, opcode byte, selector byte, operand RTGRegister,
	) {
		out.AppendByte(int(opcode))
		x86_32ModRM(out, 3, selector, x86_32Low3(operand))
	}

	func x86_32Increment(out *RTGEmitter, operand RTGRegister) {
		x86_32Group(out, 0xff, 0, operand)
	}

	func x86_32Decrement(out *RTGEmitter, operand RTGRegister) {
		x86_32Group(out, 0xff, 1, operand)
	}

	func x86_32ShiftImmediate(
		out *RTGEmitter,
		operand RTGRegister,
		value byte,
		selector byte,
	) {
		x86_32Group(out, 0xc1, selector, operand)
		out.AppendByte(int(value))
	}

	func x86_32ShiftLeftImmediate(
		out *RTGEmitter, operand RTGRegister, value byte,
	) {
		x86_32ShiftImmediate(out, operand, value, 4)
	}

	func x86_32ShiftRightUnsignedImmediate(
		out *RTGEmitter, operand RTGRegister, value byte,
	) {
		x86_32ShiftImmediate(out, operand, value, 5)
	}

	func x86_32ShiftRightSignedImmediate(
		out *RTGEmitter, operand RTGRegister, value byte,
	) {
		x86_32ShiftImmediate(out, operand, value, 7)
	}

	func x86_32Relative(out *RTGEmitter, opcode byte, label RTGLabel) {
		out.AppendByte(int(opcode))
		out.Rel32(label)
	}

	func x86_32Call(out *RTGEmitter, label RTGLabel) {
		x86_32Relative(out, 0xe8, label)
	}

	func x86_32CallIndirect(out *RTGEmitter, operand RTGRegister) {
		x86_32Group(out, 0xff, 2, operand)
	}

	func x86_32Jump(out *RTGEmitter, label RTGLabel) {
		x86_32Relative(out, 0xe9, label)
	}

	func x86_32JumpCondition(
		out *RTGEmitter, condition RTGCondition, label RTGLabel,
	) {
		out.Byte(0x0f)
		out.AppendByte(int(condition.JumpOpcode))
		out.Rel32(label)
	}

	func x86_32SetCondition(
		out *RTGEmitter,
		condition RTGCondition,
		destination RTGRegister,
	) {
		out.Byte(0x0f)
		out.AppendByte(int(condition.SetOpcode))
		x86_32ModRM(out, 3, 0, 0)
		out.Bytes2(0x0f, 0xb6)
		x86_32ModRM(out, 3, x86_32Low3(destination), 0)
	}

	func x86_32Return(out *RTGEmitter) {
		out.Byte(0xc3)
	}

	func x86_32Leave(out *RTGEmitter) {
		out.Byte(0xc9)
	}

	func x86_32HostSyscall(out *RTGEmitter) {
		out.Bytes2(0xcd, 0x80)
	}

	func x86_32MoveImmediate(
		out *RTGEmitter, destination RTGRegister, value int64,
	) {
		if value == 0 {
			x86_32Binary(out, 0x31, destination, destination)
			return
		}
		out.AppendByte(int(byte(0xb8 + x86_32Low3(destination))))
		RTGUint32(out, int(value))
	}

	func x86_32VariableShift(
		out *RTGEmitter, direction RTGShiftDirection, signed bool,
	) {
		x86_32Binary(out, 0x87, x86Primary, x86Tertiary)
		selector := byte(5)
		if direction == RTGShiftLeft {
			selector = 4
		} else if signed {
			selector = 7
		}
		x86_32Group(out, 0xd3, selector, x86Primary)
	}

	func x86_32SignedDivide(out *RTGEmitter, remainder bool) {
		x86_32Move(out, x86Scratch, x86Primary)
		x86_32Move(out, x86Primary, x86Tertiary)
		out.Byte(0x99)
		x86_32Group(out, 0xf7, 7, x86Scratch)
		if remainder {
			x86_32Move(out, x86Primary, x86Secondary)
		}
	}

	func x86_32CopyBytes(out *RTGEmitter) {
		destination := x86CopyDestination
		source := x86CopySource
		count := x86CopyCount
		scratch := x86Scratch
		forward := out.NewLabel()
		done := out.NewLabel()
		x86_32Compare(out, destination, source)
		x86_32JumpCondition(out, RTGCondition{JumpOpcode: 0x86}, forward)
		x86_32Address(out, scratch, RTGAddress{
			Base: source, Index: count, Scale: 1,
		})
		x86_32Compare(out, destination, scratch)
		x86_32JumpCondition(out, RTGCondition{JumpOpcode: 0x83}, forward)
		x86_32Address(out, source, RTGAddress{
			Base: source, Index: count, Scale: 1, Displacement: -1,
		})
		x86_32Address(out, destination, RTGAddress{
			Base: destination, Index: count, Scale: 1, Displacement: -1,
		})
		out.Bytes4(0xfd, 0xf3, 0xa4, 0xfc)
		x86_32Jump(out, done)
		out.Mark(forward)
		out.Bytes3(0xfc, 0xf3, 0xa4)
		out.Mark(done)
	}

	func x86_32PatchRelocations(out *RTGEmitter) {
		for i := 0; i < out.RelocationCount(); i++ {
			at := out.RelocationOffset(i)
			label := out.RelocationLabel(i)
			target := out.LabelPosition(label)
			if at < 0 || at+4 > len(out.Code()) || target < 0 {
				continue
			}
			addend := RTGGet32At(out.Code(), at)
			out.PatchUint32(at, target+addend-(at+4))
		}
	}

	func x86_32FrameStart(out *RTGEmitter) int {
		at := out.Len()
		out.Bytes4(0xc8, 0, 0, 0)
		return at
	}

	func x86_32FrameFinish(out *RTGEmitter, at int, stackUsed int) {
		frame := (stackUsed + 7) & -8
		if frame > 65528 {
			frame = 65528
		}
		out.SetByteAt(at+1, byte(frame))
		out.SetByteAt(at+2, byte(frame>>8))
	}
}

arch x86_32 {
	alias = "386"
	endian = little
	word_bits = 32
	pointer_bits = 32
	instruction_alignment = 1
	patch_relocations = go x86_32PatchRelocations
	registers gpr32 = [eax, ecx, edx, ebx, esp, ebp, esi, edi]
	locations {
		primary = eax
		secondary = edx
		tertiary = ecx
		scratch = ebx
		copy_destination = edi
		copy_source = esi
		copy_count = ecx
		stack = esp
		frame = ebp
	}
	conditions {
		eq  0x94 0x84
		ne  0x95 0x85
		slt 0x9c 0x8c
		sge 0x9d 0x8d
		sle 0x9e 0x8e
		sgt 0x9f 0x8f
		ult 0x92 0x82
		uge 0x93 0x83
		ule 0x96 0x86
		ugt 0x97 0x87
	}
	bind {
		move = go x86_32Move
		address = go x86_32Address
		load.native = go x86_32LoadNative
		load.i32 = go x86_32LoadI32
		load.u32 = go x86_32LoadU32
		load.i16 = go x86_32LoadI16
		load.u16 = go x86_32LoadU16
		load.i8 = go x86_32LoadI8
		load.u8 = go x86_32LoadU8
		store.native = go x86_32StoreNative
		store.u32 = go x86_32StoreU32
		store.u16 = go x86_32StoreU16
		store.u8 = go x86_32StoreU8
		add = go x86_32Add
		subtract = go x86_32Subtract
		multiply = go x86_32Multiply
		bit_and = go x86_32BitAnd
		bit_or = go x86_32BitOr
		bit_xor = go x86_32BitXor
		compare = go x86_32Compare
		test = go x86_32Test
		increment = go x86_32Increment
		decrement = go x86_32Decrement
		shift_left_immediate = go x86_32ShiftLeftImmediate
		shift_right_unsigned_immediate = go x86_32ShiftRightUnsignedImmediate
		shift_right_signed_immediate = go x86_32ShiftRightSignedImmediate
		call = go x86_32Call
		call_indirect = go x86_32CallIndirect
		jump = go x86_32Jump
		jump_condition = go x86_32JumpCondition
		set_condition = go x86_32SetCondition
		return = go x86_32Return
		leave = go x86_32Leave
		host_syscall = go x86_32HostSyscall
		move_immediate = go x86_32MoveImmediate
		variable_shift = go x86_32VariableShift
		signed_divide = go x86_32SignedDivide
		copy_bytes = go x86_32CopyBytes
	}
	exports {
		renvo386AsmSecondaryDisp = go renvo386AsmSecondaryDisp
		renvo386AsmMovRaxImm = go renvo386AsmMovRaxImm
		renvo386AsmMovRaxImm64 = go renvo386AsmMovRaxImm64
		renvo386AsmMovRegPCRel = go renvo386AsmMovRegPCRel
		renvo386AsmMovRdxImm = go renvo386AsmMovRdxImm
		renvo386AsmMovRdiRax = go renvo386AsmMovRdiRax
		renvo386AsmMovRaxRdx = go renvo386AsmMovRaxRdx
		renvo386AsmMovRsiRax = go renvo386AsmMovRsiRax
		renvo386AsmMovR8Rax = go renvo386AsmMovR8Rax
		renvo386AsmMovR9Rax = go renvo386AsmMovR9Rax
		renvo386AsmAddRdxRcx = go renvo386AsmAddRdxRcx
		renvo386AsmSyscall = go renvo386AsmSyscall
		renvo386AsmPopRdi = go renvo386AsmPopRdi
		renvo386AsmStackMem = go renvo386AsmStackMem
		renvo386AsmAddRdxImm = go renvo386AsmAddRdxImm
		renvo386AsmMemDisp = go renvo386AsmMemDisp
		renvo386AsmJccLabel = go renvo386AsmJccLabel
		renvo386AsmLoadQwordRaxIndexRcx8 = go renvo386AsmLoadQwordRaxIndexRcx8
		renvo386AsmLoadQwordRaxIndexRcxDisp = go renvo386AsmLoadQwordRaxIndexRcxDisp
		renvo386AsmLoadRaxMemRdxDisp = go renvo386AsmLoadRaxMemRdxDisp
		renvo386AsmLoadRaxMemRdxDispSize = go renvo386AsmLoadRaxMemRdxDispSize
		renvo386AsmLoadByteRaxIndexRcx = go renvo386AsmLoadByteRaxIndexRcx
		renvo386AsmLoadRaxIndexRcxSize = go renvo386AsmLoadRaxIndexRcxSize
		renvo386AsmStoreRaxMemRdxRcx8 = go renvo386AsmStoreRaxMemRdxRcx8
		renvo386AsmStoreRaxMemRdxDisp = go renvo386AsmStoreRaxMemRdxDisp
		renvo386AsmStoreRaxMemRdxDispSize = go renvo386AsmStoreRaxMemRdxDispSize
		renvo386AsmNormalizeRaxForKind = go renvo386AsmNormalizeRaxForKind
		renvo386AsmIncMemRdx = go renvo386AsmIncMemRdx
		renvo386AsmDecMemRdx = go renvo386AsmDecMemRdx
		renvo386AsmBoolNotRax = go renvo386AsmBoolNotRax
		renvo386AsmCmpRaxImm8 = go renvo386AsmCmpRaxImm8
		renvo386AsmAddRaxRcx = go renvo386AsmAddRaxRcx
		renvo386AsmSubRaxRcx = go renvo386AsmSubRaxRcx
		renvo386AsmShlRcxImm = go renvo386AsmShlRcxImm
		renvo386AsmShlRaxImm = go renvo386AsmShlRaxImm
		renvo386AsmSarRaxImm = go renvo386AsmSarRaxImm
		renvo386AsmShrRaxImm = go renvo386AsmShrRaxImm
		renvo386AsmDivLeftRcxRightRax = go renvo386AsmDivLeftRcxRightRax
		renvo386AsmCmpRcxRaxSet = go renvo386AsmCmpRcxRaxSet
		renvoAsmMovArg1Rax = go renvoAsmMovArg1Rax
	}
	relocation rel32 {
		width = 4
		signed = true
		scale = 1
		bits = 32
		relative_to = instruction_end
	}
}

abi renvo_x86_32 {
	arch = x86_32
	frame_start = go x86_32FrameStart
	frame_finish = go x86_32FrameFinish
	call_words = [ebx, esi, edx, ecx, eax, edi]
	overflow_stride = 4
	scalar_result = eax
}

abi cdecl32 {
	internal = renvo_x86_32
	arguments = [stack]
	result = [eax, edx]
	stack_alignment = 4
}

abi win32 {
	internal = renvo_x86_32
	arguments = [stack]
	result = [eax, edx]
	stack_alignment = 4
}

runtime linux_386 {
	emit_entry = go x86_32LinuxEntry

	syscall {
		number = eax
		arguments = [ebx, ecx, edx, esi, edi, ebp]
		result = eax
		instruction = int80
	}
	operation read { number = 3 args = [fd, buffer, count] }
	operation write { number = 4 args = [fd, buffer, count] }
	operation read_at { number = 180 args = [fd, buffer, count, offset] }
	operation write_at { number = 181 args = [fd, buffer, count, offset] }
	operation open { number = 5 args = [path, flags, mode] }
	operation close { number = 6 args = [fd] }
	operation chmod { number = 94 args = [fd, mode] }
	operation print { use = write args = [stderr, buffer, count] }
	operation exit { number = 1 args = [status] noreturn = true }
}

runtime windows_386 {
	emit_entry = go x86_32WindowsEntry
	emit_exit = go x86_32WindowsExit
	emit_static_call = go x86_32WindowsStaticCall
	emit_operation = go x86_32WindowsRuntimeOperation
	operations = [print, open, close, read, write, read_at, write_at, chmod]
}

format elf32_386 {
	byte_order = little
	address_bits = 32
	kind = elf
	machine = 3
	code_offset = 116
	image = go x86_32ELF32Image
}

format pe32_386 {
	byte_order = little
	address_bits = 32
	kind = pe
	machine = 0x014c
	code_offset = 0x1000
	image = go x86_32PE32Image
}

target linux/386 {
	os = linux
	arch = x86_32
	abi = cdecl32
	runtime = linux_386
	executable = elf32_386
	build_tags = [linux, unix, 386]
	capabilities = [hosted, executable, filesystem, heap, argv, environment]
}

target windows/386 {
	os = windows
	arch = x86_32
	abi = win32
	runtime = windows_386
	executable = pe32_386
	build_tags = [windows, 386]
	capabilities = [hosted, executable, filesystem, heap, argv, environment]
}
