	func x86_32StoreWidth(
		out *RTGEmitter,
		address RTGAddress,
		source RTGRegister,
		size int,
	) {
		if RTGAddressValid(address) {
			x86_32Address(out, x86Scratch, address)
			address = RTGAddress{Base: x86Scratch}
		}
		if size == 2 {
			out.Byte(0x66)
		}
		if size == 1 {
			out.Byte(0x88)
		} else {
			out.Byte(0x89)
		}
		x86_32Memory(out, x86_32Low3(source), address)
	}

