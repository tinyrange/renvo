definition 1
unit x86_32
implements direct_emitter_v1

# This closed definition owns the complete 32-bit x86 production encoder and
# its Linux and Windows target compositions.
go backend {
	func x86_32ELFAppend16(out []byte, value int) []byte {
		return append(out, byte(value), byte(value>>8))
	}

	func x86_32ELFAppend32(out []byte, value int) []byte {
		return append(out, byte(value), byte(value>>8), byte(value>>16), byte(value>>24))
	}

	func x86_32LinuxEntry(out *RTGEmitter, parameterCount int, stateOffset int) bool {
		_ = stateOffset
		if parameterCount == 0 {
			return true
		}
		if parameterCount < 0 || parameterCount > 2 {
			return false
		}
		argsOffset := out.ReserveBSS(32768, 16)
		environmentOffset := out.ReserveBSS(32768, 16)
		environmentLengthOffset := out.ReserveBSS(8, 8)
		argumentLoop := out.NewLabel()
		argumentLength := out.NewLabel()
		argumentLengthDone := out.NewLabel()
		argumentsDone := out.NewLabel()
		environmentLoop := out.NewLabel()
		environmentLength := out.NewLabel()
		environmentLengthDone := out.NewLabel()
		environmentDone := out.NewLabel()

		out.Text("\x8b\x04\x24\x89\xe6\x83\xc6\x04")
		renvo386AsmMovRegPCRel(out, 7, argsOffset, RTGRelocationAbsoluteBSS)
		out.Text("\x31\xc9")
		out.Mark(argumentLoop)
		out.Text("\x39\xc1")
		x86_32JumpCondition(out, RTGCondition{JumpOpcode: 0x8d}, argumentsDone)
		out.Text("\x8b\x14\x8e\x89\x17\x31\xdb")
		out.Mark(argumentLength)
		out.Text("\x80\x3c\x1a\x00")
		x86_32JumpCondition(out, RTGCondition{JumpOpcode: 0x84}, argumentLengthDone)
		out.Text("\x43")
		x86_32Jump(out, argumentLength)
		out.Mark(argumentLengthDone)
		out.Text("\x89\x5f\x08\x83\xc7\x10\x41")
		x86_32Jump(out, argumentLoop)
		out.Mark(argumentsDone)

		out.Text("\x8d\x74\x86\x08")
		renvo386AsmMovRegPCRel(out, 7, environmentOffset, RTGRelocationAbsoluteBSS)
		out.Text("\x31\xc9")
		out.Mark(environmentLoop)
		out.Text("\x8b\x14\x8e\x85\xd2")
		x86_32JumpCondition(out, RTGCondition{JumpOpcode: 0x84}, environmentDone)
		out.Text("\x89\x17\x31\xdb")
		out.Mark(environmentLength)
		out.Text("\x80\x3c\x1a\x00")
		x86_32JumpCondition(out, RTGCondition{JumpOpcode: 0x84}, environmentLengthDone)
		out.Text("\x43")
		x86_32Jump(out, environmentLength)
		out.Mark(environmentLengthDone)
		out.Text("\x89\x5f\x08\x83\xc7\x10\x41")
		x86_32Jump(out, environmentLoop)
		out.Mark(environmentDone)
		renvo386AsmMovRegPCRel(out, 6, environmentLengthOffset, RTGRelocationAbsoluteBSS)
		out.Uint16(0x0e89)

		renvo386AsmMovRegPCRel(out, 3, argsOffset, RTGRelocationAbsoluteBSS)
		out.Text("\x89\xc6\x89\xc2")
		renvo386AsmMovRegPCRel(out, 1, environmentOffset, RTGRelocationAbsoluteBSS)
		renvo386AsmMovRegPCRel(out, 0, environmentLengthOffset, RTGRelocationAbsoluteBSS)
		out.Uint16(0x008b)
		out.Text("\x89\xc7")
		return true
	}

	func x86_32WindowsEntry(out *RTGEmitter, parameterCount int, stateOffset int) bool {
		_ = stateOffset
		if parameterCount == 0 {
			return true
		}
		if parameterCount < 0 || parameterCount > 2 {
			return false
		}
		argsOffset := out.ReserveBSS(32768, 16)
		argsTextOffset := out.ReserveBSS(32768, 16)
		argsLengthOffset := out.ReserveBSS(8, 8)
		environmentOffset := out.ReserveBSS(32768, 16)
		environmentLengthOffset := out.ReserveBSS(8, 8)
		base := out.Len()
		out.Text("\xff\x15\x00\x00\x00\x00\x89\xc6\xbf\x00\x00\x00\x00\xb8\x00\x00\x00\x00\x89\xc2\x31\xdb\x80\x3e\x00\x0f\x84\x75\x00\x00\x00\x80\x3e\x20\x0f\x84\x09\x00\x00\x00\x80\x3e\x09\x0f\x85\x06\x00\x00\x00\x46\xe9\xdf\xff\xff\xff\x89\x17\x31\xc9\x31\xed\x8a\x06\x3c\x00\x0f\x84\x34\x00\x00\x00\x3c\x22\x0f\x85\x09\x00\x00\x00\x83\xf5\x01\x46\xe9\xe5\xff\xff\xff\x83\xfd\x00\x0f\x85\x10\x00\x00\x00\x3c\x20\x0f\x84\x12\x00\x00\x00\x3c\x09\x0f\x84\x0a\x00\x00\x00\x88\x02\x46\x42\x41\xe9\xc2\xff\xff\xff\xc6\x02\x00\x42\x89\x4f\x08\x83\xc7\x10\x43\x3c\x00\x0f\x84\x06\x00\x00\x00\x46\xe9\x82\xff\xff\xff\x89\xd8\xa3\x00\x00\x00\x00\xff\x15\x00\x00\x00\x00\x89\xc6\xbf\x00\x00\x00\x00\x31\xdb\x80\x3e\x00\x0f\x84\x23\x00\x00\x00\x89\x37\x31\xc9\x80\x3c\x0e\x00\x0f\x84\x06\x00\x00\x00\x41\xe9\xf0\xff\xff\xff\x89\x4f\x08\x01\xce\x46\x83\xc7\x10\x43\xe9\xd4\xff\xff\xff\x89\xd8\xa3\x00\x00\x00\x00\xbb\x00\x00\x00\x00\x8b\x35\x00\x00\x00\x00\x89\xf2\xb9\x00\x00\x00\x00\xa1\x00\x00\x00\x00\x89\xc7")
		out.AbsoluteReloc(base+2, 7, RTGRelocationImport)
		out.AbsoluteReloc(base+9, argsOffset, RTGRelocationAbsoluteBSS)
		out.AbsoluteReloc(base+14, argsTextOffset, RTGRelocationAbsoluteBSS)
		out.AbsoluteReloc(base+151, argsLengthOffset, RTGRelocationAbsoluteBSS)
		out.AbsoluteReloc(base+157, 9, RTGRelocationImport)
		out.AbsoluteReloc(base+164, environmentOffset, RTGRelocationAbsoluteBSS)
		out.AbsoluteReloc(base+217, environmentLengthOffset, RTGRelocationAbsoluteBSS)
		out.AbsoluteReloc(base+222, argsOffset, RTGRelocationAbsoluteBSS)
		out.AbsoluteReloc(base+228, argsLengthOffset, RTGRelocationAbsoluteBSS)
		out.AbsoluteReloc(base+235, environmentOffset, RTGRelocationAbsoluteBSS)
		out.AbsoluteReloc(base+240, environmentLengthOffset, RTGRelocationAbsoluteBSS)
		return true
	}

	func x86_32ELFPatchAbsoluteRelocations(a *RTGEmitter, codeOffset int, dataOffset int, bssOffset int) {
		for i := 0; i < a.AbsoluteRelocationCount(); i++ {
			at := a.AbsoluteRelocationOffset(i)
			addend := a.AbsoluteRelocationAddend(i)
			kind := a.AbsoluteRelocationKind(i)
			target := dataOffset + addend
			if kind == RTGRelocationAbsoluteBSS {
				target = bssOffset + addend
			}
			a.PatchUint32(at, target-(codeOffset+at-3))
		}
	}

	func x86_32ELF32Image(a *RTGEmitter) []byte {
		codeOffset := 116
		code := a.Code()
		data := a.Data()
		dataOffset := codeOffset + len(code)
		fileSize := dataOffset + len(data)
		bssOffset := RTGAlignValue(fileSize, 4096)
		x86_32ELFPatchAbsoluteRelocations(a, codeOffset, dataOffset, bssOffset)
		code = a.Code()
		var out []byte
		out = append(out, 0x7f, 'E', 'L', 'F', 1, 1, 1, 0)
		for len(out) < 16 { out = append(out, 0) }
		out = x86_32ELFAppend16(out, 3)
		out = x86_32ELFAppend16(out, 3)
		out = x86_32ELFAppend32(out, 1)
		out = x86_32ELFAppend32(out, codeOffset)
		out = x86_32ELFAppend32(out, 52)
		out = x86_32ELFAppend32(out, 0)
		out = x86_32ELFAppend32(out, 0)
		out = x86_32ELFAppend16(out, 52)
		out = x86_32ELFAppend16(out, 32)
		out = x86_32ELFAppend16(out, 2)
		out = x86_32ELFAppend16(out, 0)
		out = x86_32ELFAppend16(out, 0)
		out = x86_32ELFAppend16(out, 0)
		out = x86_32ELFAppend32(out, 1)
		out = x86_32ELFAppend32(out, 0)
		out = x86_32ELFAppend32(out, 0)
		out = x86_32ELFAppend32(out, 0)
		out = x86_32ELFAppend32(out, fileSize)
		out = x86_32ELFAppend32(out, fileSize)
		out = x86_32ELFAppend32(out, 5)
		out = x86_32ELFAppend32(out, 4096)
		out = x86_32ELFAppend32(out, 1)
		out = x86_32ELFAppend32(out, bssOffset)
		out = x86_32ELFAppend32(out, bssOffset)
		out = x86_32ELFAppend32(out, bssOffset)
		out = x86_32ELFAppend32(out, 0)
		out = x86_32ELFAppend32(out, a.BSSSize())
		out = x86_32ELFAppend32(out, 6)
		out = x86_32ELFAppend32(out, 4096)
		out = append(out, code...)
		out = append(out, data...)
		return out
	}

	type x86_32PELayout struct {
		importRVA int
		importSize int
		iatRVA int
		iatSize int
		iat []int
	}

	func x86_32PEPut16(out []byte, at int, value int) {
		out[at] = byte(value)
		out[at+1] = byte(value >> 8)
	}

	func x86_32PEPut32(out []byte, at int, value int) {
		out[at] = byte(value)
		out[at+1] = byte(value >> 8)
		out[at+2] = byte(value >> 16)
		out[at+3] = byte(value >> 24)
	}

	func x86_32PEUntil(out []byte, size int) []byte {
		for len(out) < size {
			out = append(out, 0)
		}
		return out
	}

	func x86_32PEString(out []byte, value string) []byte {
		for i := 0; i < len(value); i++ {
			out = append(out, value[i])
		}
		return append(out, 0)
	}

	func x86_32PEImportName(id int) string {
		if id == 1 { return "CreateFileA" }
		if id == 2 { return "CloseHandle" }
		if id == 3 { return "ReadFile" }
		if id == 4 { return "WriteFile" }
		if id == 5 { return "SetFilePointer" }
		if id == 6 { return "GetStdHandle" }
		if id == 7 { return "GetCommandLineA" }
		if id == 9 { return "GetEnvironmentStringsA" }
		return "ExitProcess"
	}

	func x86_32PEImportEntry(data []byte, layout *x86_32PELayout, dataRVA int, iltAt int, iatAt int, slot int, id int, name string) []byte {
		nameAt := len(data)
		data = append(data, 0, 0)
		data = x86_32PEString(data, name)
		if len(data)&1 != 0 {
			data = append(data, 0)
		}
		nameRVA := dataRVA + nameAt
		x86_32PEPut32(data, iltAt+slot*4, nameRVA)
		x86_32PEPut32(data, iatAt+slot*4, nameRVA)
		layout.iat[id] = dataRVA + iatAt + slot*4
		return data
	}

	func x86_32PEBuildImports(out *RTGEmitter, data []byte, dataRVA int) ([]byte, x86_32PELayout) {
		var layout x86_32PELayout
		staticCount := out.StaticImportCount()
		importAt := RTGAlignValue(len(data), 4)
		data = x86_32PEUntil(data, importAt+(staticCount+2)*20)
		iltAt := len(data)
		data = x86_32PEUntil(data, iltAt+40)
		iatAt := len(data)
		data = x86_32PEUntil(data, iatAt+40)
		customAt := len(data)
		data = x86_32PEUntil(data, customAt+staticCount*16)
		layout.iat = make([]int, 10+staticCount)
		for id := 1; id <= 9; id++ {
			data = x86_32PEImportEntry(data, &layout, dataRVA, iltAt, iatAt, id-1, id, x86_32PEImportName(id))
		}
		for i := 0; i < staticCount; i++ {
			customILT := customAt + i*16
			customIAT := customILT + 8
			data = x86_32PEImportEntry(data, &layout, dataRVA, customILT, customIAT, 0, 10+i, out.StaticImportName(i))
		}
		dllAt := len(data)
		data = x86_32PEString(data, "kernel32.dll")
		x86_32PEPut32(data, importAt, dataRVA+iltAt)
		x86_32PEPut32(data, importAt+12, dataRVA+dllAt)
		x86_32PEPut32(data, importAt+16, dataRVA+iatAt)
		for i := 0; i < staticCount; i++ {
			customILT := customAt + i*16
			customIAT := customILT + 8
			dllAt = len(data)
			data = x86_32PEString(data, out.StaticImportDLL(i))
			descriptor := importAt + (i+1)*20
			x86_32PEPut32(data, descriptor, dataRVA+customILT)
			x86_32PEPut32(data, descriptor+12, dataRVA+dllAt)
			x86_32PEPut32(data, descriptor+16, dataRVA+customIAT)
		}
		layout.importRVA = dataRVA + importAt
		layout.importSize = len(data) - importAt
		layout.iatRVA = dataRVA + iatAt
		layout.iatSize = customAt + staticCount*16 - iatAt
		return data, layout
	}

	func x86_32PEPatch(out *RTGEmitter, dataRVA int, dataSize int, layout x86_32PELayout) {
		for i := 0; i < out.AbsoluteRelocationCount(); i++ {
			at := out.AbsoluteRelocationOffset(i)
			addend := out.AbsoluteRelocationAddend(i)
			kind := out.AbsoluteRelocationKind(i)
			target := dataRVA + addend
			if kind == RTGRelocationAbsoluteBSS {
				target = dataRVA + dataSize + addend
			} else if kind == RTGRelocationImport {
				if addend > 0 && addend < len(layout.iat) {
					target = layout.iat[addend]
				}
			}
			out.PatchUint32(at, 0x400000+target)
		}
	}

	func x86_32PESection(out []byte, name string, virtualSize int, rva int, rawSize int, rawAt int, flags int) []byte {
		start := len(out)
		out = x86_32PEUntil(out, start+40)
		for i := 0; i < len(name); i++ {
			out[start+i] = name[i]
		}
		x86_32PEPut32(out, start+8, virtualSize)
		x86_32PEPut32(out, start+12, rva)
		x86_32PEPut32(out, start+16, rawSize)
		x86_32PEPut32(out, start+20, rawAt)
		x86_32PEPut32(out, start+36, flags)
		return out
	}

	func x86_32PEHeader(textRaw int, textSize int, dataRVA int, dataRaw int, dataSize int, layout x86_32PELayout, subsystem int) []byte {
		out := make([]byte, 0, 512)
		out = x86_32PEUntil(out, 512)
		x86_32PEPut16(out, 0, 0x5a4d)
		x86_32PEPut32(out, 0x3c, 0x80)
		pe := 0x80
		x86_32PEPut32(out, pe, 0x00004550)
		x86_32PEPut16(out, pe+4, 0x014c)
		x86_32PEPut16(out, pe+6, 2)
		x86_32PEPut16(out, pe+20, 0xe0)
		x86_32PEPut16(out, pe+22, 0x0102)
		opt := pe + 24
		x86_32PEPut16(out, opt, 0x10b)
		x86_32PEPut32(out, opt+4, textRaw)
		x86_32PEPut32(out, opt+8, dataRaw)
		x86_32PEPut32(out, opt+16, 0x1000)
		x86_32PEPut32(out, opt+20, 0x1000)
		x86_32PEPut32(out, opt+24, dataRVA)
		x86_32PEPut32(out, opt+28, 0x400000)
		x86_32PEPut32(out, opt+32, 0x1000)
		x86_32PEPut32(out, opt+36, 0x200)
		x86_32PEPut16(out, opt+40, 4)
		x86_32PEPut16(out, opt+48, 4)
		x86_32PEPut32(out, opt+56, RTGAlignValue(dataRVA+dataSize, 0x1000))
		x86_32PEPut32(out, opt+60, 0x200)
		x86_32PEPut16(out, opt+68, subsystem)
		x86_32PEPut16(out, opt+70, 0x100)
		x86_32PEPut32(out, opt+72, 0x100000)
		x86_32PEPut32(out, opt+76, 0x1000)
		x86_32PEPut32(out, opt+80, 0x100000)
		x86_32PEPut32(out, opt+84, 0x1000)
		x86_32PEPut32(out, opt+92, 16)
		x86_32PEPut32(out, opt+104, layout.importRVA)
		x86_32PEPut32(out, opt+108, layout.importSize)
		x86_32PEPut32(out, opt+192, layout.iatRVA)
		x86_32PEPut32(out, opt+196, layout.iatSize)
		out = out[:opt+224]
		out = x86_32PESection(out, ".text", textSize, 0x1000, textRaw, 0x200, 0x60000020)
		out = x86_32PESection(out, ".data", dataSize, dataRVA, dataRaw, 0x200+textRaw, 0xc0000040)
		return x86_32PEUntil(out, 0x200)
	}

	func x86_32PE32Image(out *RTGEmitter) []byte {
		code := out.Code()
		for len(code)%4 != 0 {
			code = append(code, 0)
		}
		out.SetCode(code)
		textSize := len(code)
		textRaw := RTGAlignValue(textSize, 0x200)
		dataRVA := RTGAlignValue(0x1000+textSize, 0x1000)
		data, layout := x86_32PEBuildImports(out, out.Data(), dataRVA)
		out.SetData(data)
		x86_32PEPatch(out, dataRVA, len(data), layout)
		dataRaw := RTGAlignValue(len(data), 0x200)
		dataSize := len(data) + out.BSSSize()
		image := x86_32PEHeader(textRaw, textSize, dataRVA, dataRaw, dataSize, layout, out.WindowsSubsystem())
		image = append(image, out.Code()...)
		image = x86_32PEUntil(image, 0x200+textRaw)
		image = append(image, data...)
		return x86_32PEUntil(image, 0x200+textRaw+dataRaw)
	}

	func x86_32WindowsExit(out *RTGEmitter, status RTGRegister) {
		out.AppendByte(0x50 + status.Code)
		out.Bytes2(0xff, 0x15)
		at := out.Len()
		out.Int32(0)
		out.AbsoluteReloc(at, 8, RTGRelocationImport)
	}

	func x86_32WindowsStaticCall(out *RTGEmitter, importID int, wordCount int) {
		out.Bytes2(0xff, 0x15)
		at := out.Len()
		out.Int32(0)
		out.AbsoluteReloc(at, importID, RTGRelocationImport)
	}

	func x86_32WindowsCallImport(out *RTGEmitter, importID int) {
		out.Bytes2(0xff, 0x15)
		at := out.Len()
		out.Int32(0)
		out.AbsoluteReloc(at, importID, RTGRelocationImport)
	}

	func x86_32WindowsRuntimeReadWrite(
		out *RTGEmitter, write bool, positional bool,
	) {
		helper := out.NewLabel()
		after := out.NewLabel()
		countOffset := out.ReserveBSS(16, 4)
		base := out.Len()
		x86_32Relative(out, 0xe9, after)
		out.Mark(helper)
		template := "\x83\xfb\x00\x0f\x84\x05\x00\x00\x00\xe9\x0a\x00\x00\x00\x6a\xf6\xff\x15\x00\x00\x00\x00\x89\xc3\x83\xf9\x00\x0f\x8c\x49\x00\x00\x00\x51\x52\x6a\x01\x6a\x00\x6a\x00\x53\xff\x15\x00\x00\x00\x00\xa3\x00\x00\x00\x00\x5a\x59\x51\x52\x6a\x00\x6a\x00\x51\x53\xff\x15\x00\x00\x00\x00\x5a\x59\x6a\x00\x68\x00\x00\x00\x00\x52\x56\x53\xff\x15\x00\x00\x00\x00\x83\xf8\x00\x0f\x84\x2d\x00\x00\x00\xa1\x00\x00\x00\x00\xe9\x26\x00\x00\x00\x6a\x00\x68\x00\x00\x00\x00\x52\x56\x53\xff\x15\x00\x00\x00\x00\x83\xf8\x00\x0f\x84\x06\x00\x00\x00\xa1\x00\x00\x00\x00\xc3\x6a\xff\x58\xc3\x6a\xff\x58\xa3\x00\x00\x00\x00\x6a\x00\x6a\x00\xa1\x00\x00\x00\x00\x50\x53\xff\x15\x00\x00\x00\x00\xa1\x00\x00\x00\x00\xc3"
		relocations := "\x17\x08\x31\x07\x36\x01\x46\x07\x4f\x00\x58\x05\x66\x00\x72\x00\x7b\x05\x89\x00\x96\x00\x9f\x01\xa7\x07\xac\x00"
		if write {
			template = "\x83\xfb\x01\x0f\x84\x0e\x00\x00\x00\x83\xfb\x02\x0f\x84\x14\x00\x00\x00\xe9\x19\x00\x00\x00\x6a\xf5\xff\x15\x00\x00\x00\x00\x89\xc3\xe9\x0a\x00\x00\x00\x6a\xf4\xff\x15\x00\x00\x00\x00\x89\xc3\x83\xf9\x00\x0f\x8c\x49\x00\x00\x00\x51\x52\x6a\x01\x6a\x00\x6a\x00\x53\xff\x15\x00\x00\x00\x00\xa3\x00\x00\x00\x00\x5a\x59\x51\x52\x6a\x00\x6a\x00\x51\x53\xff\x15\x00\x00\x00\x00\x5a\x59\x6a\x00\x68\x00\x00\x00\x00\x52\x56\x53\xff\x15\x00\x00\x00\x00\x83\xf8\x00\x0f\x84\x2d\x00\x00\x00\xa1\x00\x00\x00\x00\xe9\x26\x00\x00\x00\x6a\x00\x68\x00\x00\x00\x00\x52\x56\x53\xff\x15\x00\x00\x00\x00\x83\xf8\x00\x0f\x84\x06\x00\x00\x00\xa1\x00\x00\x00\x00\xc3\x6a\xff\x58\xc3\x6a\xff\x58\xa3\x00\x00\x00\x00\x6a\x00\x6a\x00\xa1\x00\x00\x00\x00\x50\x53\xff\x15\x00\x00\x00\x00\xa1\x00\x00\x00\x00\xc3"
			relocations = "\x20\x08\x2f\x08\x49\x07\x4e\x01\x5e\x07\x67\x00\x70\x06\x7e\x00\x8a\x00\x93\x06\xa1\x00\xae\x00\xb7\x01\xbf\x07\xc4\x00"
		}
		out.Text(template)
		for i := 0; i < len(relocations); i += 2 {
			at := base + int(relocations[i])
			kind := int(relocations[i+1])
			if kind < 2 {
				out.AbsoluteReloc(at, countOffset+kind*8, RTGRelocationAbsoluteBSS)
			} else {
				out.AbsoluteReloc(at, kind-2, RTGRelocationImport)
			}
		}
		out.Mark(after)
		if !positional {
			x86_32MoveImmediate(out, RTGRegister{Code: 1, Valid: true}, -1)
		}
		x86_32Relative(out, 0xe8, helper)
	}

	func x86_32WindowsTranslateCreateFileFlags(out *RTGEmitter) {
		edx := RTGRegister{Code: 2, Valid: true}
		ecx := RTGRegister{Code: 1, Valid: true}
		notReadWrite := out.NewLabel()
		accessDone := out.NewLabel()
		noCreate := out.NewLabel()
		createDone := out.NewLabel()

		x86_32MoveImmediate(out, edx, -2147483648)
		out.Bytes2(0xa8, 2)
		x86_32JumpCondition(out, RTGCondition{JumpOpcode: 0x84}, notReadWrite)
		x86_32MoveImmediate(out, edx, -1073741824)
		x86_32Relative(out, 0xe9, accessDone)
		out.Mark(notReadWrite)
		out.Bytes2(0xa8, 1)
		x86_32JumpCondition(out, RTGCondition{JumpOpcode: 0x84}, accessDone)
		x86_32MoveImmediate(out, edx, 0x40000000)
		out.Mark(accessDone)

		x86_32MoveImmediate(out, ecx, 3)
		out.Bytes2(0xa8, 64)
		x86_32JumpCondition(out, RTGCondition{JumpOpcode: 0x84}, noCreate)
		x86_32MoveImmediate(out, ecx, 4)
		out.AppendByte(0xa9)
		out.Int32(512)
		x86_32JumpCondition(out, RTGCondition{JumpOpcode: 0x84}, createDone)
		x86_32MoveImmediate(out, ecx, 2)
		x86_32Relative(out, 0xe9, createDone)
		out.Mark(noCreate)
		out.AppendByte(0xa9)
		out.Int32(512)
		x86_32JumpCondition(out, RTGCondition{JumpOpcode: 0x84}, createDone)
		x86_32MoveImmediate(out, ecx, 5)
		out.Mark(createDone)
	}

	func x86_32WindowsRuntimeOpen(out *RTGEmitter) {
		eax := RTGRegister{Code: 0, Valid: true}
		esi := RTGRegister{Code: 6, Valid: true}
		x86_32Move(out, eax, esi)
		x86_32WindowsTranslateCreateFileFlags(out)
		out.Bytes2(0x6a, 0)
		out.AppendByte(0x68)
		out.Int32(0x80)
		out.AppendByte(0x51)
		out.Bytes2(0x6a, 0)
		out.Bytes2(0x6a, 3)
		out.AppendByte(0x52)
		out.AppendByte(0x53)
		x86_32WindowsCallImport(out, 1)
	}

	func x86_32WindowsRuntimeClose(out *RTGEmitter) {
		eax := RTGRegister{Code: 0, Valid: true}
		failed := out.NewLabel()
		done := out.NewLabel()
		out.AppendByte(0x53)
		x86_32WindowsCallImport(out, 2)
		x86_32Test(out, eax, eax)
		x86_32JumpCondition(out, RTGCondition{JumpOpcode: 0x84}, failed)
		x86_32MoveImmediate(out, eax, 0)
		x86_32Relative(out, 0xe9, done)
		out.Mark(failed)
		x86_32MoveImmediate(out, eax, -1)
		out.Mark(done)
	}

	func x86_32WindowsRuntimeChmod(out *RTGEmitter) {
		eax := RTGRegister{Code: 0, Valid: true}
		ecx := RTGRegister{Code: 1, Valid: true}
		failed := out.NewLabel()
		done := out.NewLabel()
		out.Bytes2(0x6a, 1)
		out.Bytes2(0x6a, 0)
		out.Bytes2(0x6a, 0)
		out.AppendByte(0x53)
		x86_32WindowsCallImport(out, 5)
		x86_32MoveImmediate(out, ecx, -1)
		x86_32Binary(out, 0x39, eax, ecx)
		x86_32JumpCondition(out, RTGCondition{JumpOpcode: 0x84}, failed)
		x86_32MoveImmediate(out, eax, 0)
		x86_32Relative(out, 0xe9, done)
		out.Mark(failed)
		x86_32MoveImmediate(out, eax, -1)
		out.Mark(done)
	}

	func x86_32WindowsRuntimeOperation(
		out *RTGEmitter, operation int,
	) bool {
		if operation == RTGRuntimeRead {
			x86_32WindowsRuntimeReadWrite(out, false, false)
			return true
		}
		if operation == RTGRuntimeWrite {
			x86_32WindowsRuntimeReadWrite(out, true, false)
			return true
		}
		if operation == RTGRuntimeReadAt {
			x86_32WindowsRuntimeReadWrite(out, false, true)
			return true
		}
		if operation == RTGRuntimeWriteAt {
			x86_32WindowsRuntimeReadWrite(out, true, true)
			return true
		}
		if operation == RTGRuntimeOpen {
			x86_32WindowsRuntimeOpen(out)
			return true
		}
		if operation == RTGRuntimeClose {
			x86_32WindowsRuntimeClose(out)
			return true
		}
		if operation == RTGRuntimeChmod {
			x86_32WindowsRuntimeChmod(out)
			return true
		}
		return false
	}

