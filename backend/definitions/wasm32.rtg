	func renvoWasm32AsmMovRaxDataAddr(a *RTGEmitter, dataOff int) {
		renvoWasm32EmitRegImm(a, renvoWasm32OpMovRegImm, renvoWasm32RegRax, 0)
		a.AbsoluteReloc(len(a.Code())-4, dataOff, 0)
	}
	
	func renvoWasm32AsmMovRaxBssAddr(a *RTGEmitter, bssOff int) {
