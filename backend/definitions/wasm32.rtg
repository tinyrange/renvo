	func renvoWasm32AsmBuildArgvEnvSlices(a *RTGEmitter, bssOff int, envOff int, envLenOff int) {
		a.Int8(renvoWasm32OpBuildArgsEnv)
		at := len(a.Code())
		a.Int32(bssOff)
		a.AbsoluteReloc(at, bssOff, RTGRelocationAbsoluteBSS)
		at = len(a.Code())
		a.Int32(envOff)
		a.AbsoluteReloc(at, envOff, RTGRelocationAbsoluteBSS)
		at = len(a.Code())
		a.Int32(envLenOff)
		a.AbsoluteReloc(at, envLenOff, RTGRelocationAbsoluteBSS)
	}
	
