	func renvoWasm32EmitRegImm(a *RTGEmitter, op int, reg int, imm int) {
		a.SetCode(append(a.Code(), byte(op)))
		a.SetCode(append(a.Code(), byte(reg)))
		a.SetCode(RTGAppend32(a.Code(), imm))
	}
	
	func renvoWasm32EmitRegReg(a *RTGEmitter, op int, dst int, src int) {
		a.SetCode(append(a.Code(), byte(op)))
		a.SetCode(append(a.Code(), byte(dst)))
		a.SetCode(append(a.Code(), byte(src)))
	}
	
	func renvoWasm32EmitReg(a *RTGEmitter, op int, reg int) {
		a.SetCode(append(a.Code(), byte(op)))
		a.SetCode(append(a.Code(), byte(reg)))
	}
	
	func renvoWasm32EmitStack(a *RTGEmitter, op int, reg int, offset int) {
		a.SetCode(append(a.Code(), byte(op)))
		a.SetCode(append(a.Code(), byte(reg)))
		a.SetCode(RTGAppend32(a.Code(), offset))
	}
	
	func renvoWasm32EmitWideOp(a *RTGEmitter, op int, dest int, left int, right int, wasmOp int) {
		a.SetCode(append(a.Code(), byte(op)))
		if op == renvoWasm32OpWideBinary {
			a.SetCode(RTGAppend32(a.Code(), dest))
		}
		a.SetCode(RTGAppend32(a.Code(), left))
		a.SetCode(RTGAppend32(a.Code(), right))
		a.SetCode(append(a.Code(), byte(wasmOp)))
	}
	
	func renvoWasm32EmitMem(a *RTGEmitter, op int, reg int, base int, disp int, size int) {
		a.SetCode(append(a.Code(), byte(op)))
		a.SetCode(append(a.Code(), byte(reg)))
		a.SetCode(append(a.Code(), byte(base)))
		a.SetCode(RTGAppend32(a.Code(), disp))
		a.SetCode(append(a.Code(), byte(size)))
	}
	
	func renvoWasm32EmitIndex(a *RTGEmitter, op int, reg int, base int, index int, scale int, disp int, size int) {
		a.SetCode(append(a.Code(), byte(op)))
		a.SetCode(append(a.Code(), byte(reg)))
		a.SetCode(append(a.Code(), byte(base)))
		a.SetCode(append(a.Code(), byte(index)))
		a.SetCode(append(a.Code(), byte(scale)))
		a.SetCode(RTGAppend32(a.Code(), disp))
		a.SetCode(append(a.Code(), byte(size)))
	}
	
	func renvoWasm32EmitBranch(a *RTGEmitter, op int, label int) {
		a.SetCode(append(a.Code(), byte(op)))
		at := len(a.Code())
		a.SetCode(RTGAppend32(a.Code(), 0))
		a.RelocAt(at, label)
	}
	
	func renvoWasm32EmitCondBranch(a *RTGEmitter, cond int, label int) {
		a.SetCode(append(a.Code(), byte(renvoWasm32OpJCond)))
		a.SetCode(append(a.Code(), byte(cond)))
		at := len(a.Code())
		a.SetCode(RTGAppend32(a.Code(), 0))
		a.RelocAt(at, label)
	}
	
	func renvoWasm32EmitCallLabel(a *RTGEmitter, label int, wordCount int) {
		a.SetCode(append(a.Code(), byte(renvoWasm32OpCall)))
		at := len(a.Code())
		a.SetCode(RTGAppend32(a.Code(), 0))
		a.RelocAt(at, label)
		a.SetCode(RTGAppend32(a.Code(), wordCount))
	}
	
