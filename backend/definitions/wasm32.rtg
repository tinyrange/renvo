	func renvoWasm32Patch(a *RTGEmitter, dataBase int, bssBase int) {
		for i := 0; i+1 < a.RelocationWordCount(); i += 2 {
			at := a.RelocationWord(i)
			label := a.RelocationWord(i+1)
			target := a.LabelPosition(label)
			if target >= 0 {
				RTGPut32At(a.Code(), at, target)
			}
		}
		for i := 0; i+2 < a.AbsoluteRelocationWordCount(); i += 3 {
			at := a.AbsoluteRelocationWord(i)
			off := a.AbsoluteRelocationWord(i+1)
			kind := a.AbsoluteRelocationWord(i+2)
			target := dataBase + off
			if kind == RTGRelocationAbsoluteBSS {
				target = bssBase + off
			}
			RTGPut32At(a.Code(), at, target)
		}
	}
	
