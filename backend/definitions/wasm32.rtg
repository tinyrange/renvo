		return
	}
	
	func renvoWasmI32Load(out *renvoWasmBuffer, align int, off int) {
		renvoWasmPut(out, 0x28)
		renvoWasmAppendU32(out, align)
		renvoWasmAppendU32(out, off)
		return
	}
	
	func renvoWasmI32Load8U(out *renvoWasmBuffer) {
