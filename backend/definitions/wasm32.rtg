const renvoWasm32ImportFdPwrite = 3
const renvoWasm32ImportPathOpen = 4
const renvoWasm32ImportFdClose = 5
const renvoWasm32ImportFdstatGet = 6
const renvoWasm32ImportFdReaddir = 7
