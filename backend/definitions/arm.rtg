	relocation branch24 {
		width = 4
		signed = true
		scale = 4
		bits = 24
		relative_to = instruction
	}
	relocation address32 {
		width = 8
		signed = true
		scale = 1
		bits = 32
		relative_to = pc_at_add
	}
}

abi renvo_arm {
	arch = arm
	frame_start = go armFrameStart
	frame_finish = go armFrameFinish
	call_words = [r0, r1, r2, r3, r4, r5]
	overflow_stride = 4
	scalar_result = r0
}

abi aapcs32 {
	internal = renvo_arm
	arguments = [r0, r1, r2, r3]
	result = [r0, r1]
	stack_alignment = 8
}

runtime linux_arm {
	emit_entry = go armLinuxEntry

	syscall {
		number = r7
		arguments = [r0, r1, r2, r3, r4, r5]
		result = r0
		instruction = svc
	}
	operation read { number = 3 args = [fd, buffer, count] }
	operation write { number = 4 args = [fd, buffer, count] }
	operation read_at { number = 180 args = [fd, buffer, count, offset] }
	operation write_at { number = 181 args = [fd, buffer, count, offset] }
	operation open { number = 5 args = [path, flags, mode] }
	operation close { number = 6 args = [fd] }
	operation chmod { number = 94 args = [fd, mode] }
	operation print { use = write args = [stderr, buffer, count] }
	operation exit { number = 1 args = [status] noreturn = true }
}

format elf32_arm {
	byte_order = little
	address_bits = 32
	kind = elf
	machine = 40
	code_offset = 116
	image = go armELF32Image
}

target linux/arm {
	os = linux
	arch = arm
	abi = aapcs32
	runtime = linux_arm
	executable = elf32_arm
	build_tags = [linux, unix, arm]
	capabilities = [hosted, executable, filesystem, heap, argv, environment]
}
