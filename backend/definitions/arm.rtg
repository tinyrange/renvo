		renvoArmAsmPushRdx = go renvoArmAsmPushRdx
		renvoArmAsmPopRax = go renvoArmAsmPopRax
		renvoArmAsmPopRcx = go renvoArmAsmPopRcx
		renvoArmAsmPopRdx = go renvoArmAsmPopRdx
		renvoArmAsmPushImm = go renvoArmAsmPushImm
		renvoArmAsmStoreSliceStack = go renvoArmAsmStoreSliceStack
