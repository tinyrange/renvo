# Shared 32-bit ARM machine facts, encoder, direct-emitter bindings, and
# calling conventions. Target entrypoints own environment-specific behavior.
go backend {
	func asmAlign(a *RTGEmitter) {
		for a.Len()%4 != 0 {
			RTGByte(a, 0)
		}
	}

	func asmMovRegReg(a *RTGEmitter, dst int, src int) {
		if dst == src {
			return
		}
		asmEmit(a, 0xe1a00000|(dst<<12)|src)
	}

	func asmMovRegImm(a *RTGEmitter, reg int, imm int) {
		part := imm & 65535
		asmEmit(a, 0xe3000000|((part&0xf000)<<4)|(reg<<12)|(part&0x0fff))
		part = (imm >> 16) & 65535
		if part != 0 {
			asmEmit(a, 0xe3400000|((part&0xf000)<<4)|(reg<<12)|(part&0x0fff))
		}
	}

	func asmAddRegImm(a *RTGEmitter, dst int, src int, imm int) {
		if imm == 0 {
			asmMovRegReg(a, dst, src)
			return
		}
		tmp := scratch.Code
		if dst == tmp || src == tmp {
			tmp = scratch2.Code
		}
		if imm < 0 {
			asmMovRegImm(a, tmp, -imm)
			asmSubRegReg(a, dst, src, tmp)
			return
		}
		asmMovRegImm(a, tmp, imm)
		asmAddRegReg(a, dst, src, tmp)
	}

	func asmFrameStart(a *RTGEmitter) int {
		at := a.Len()
		asmEmit(a, 0xe3009000) // movw r9, #0
		asmEmit(a, 0xe04dd009) // sub sp, sp, r9
		return at
	}

	func asmPatchFrame(a *RTGEmitter, at int, stackUsed int) {
		frame := (stackUsed + 7) & -8
		if frame > 65528 {
			frame = 65528
		}
		a.PatchUint32(at, 0xe3009000|((frame&0xf000)<<4)|(frame&0x0fff))
	}

	func asmAddRegSmallImm(a *RTGEmitter, dst int, src int, imm int) {
		if imm < 0 {
			asmEmit(a, 0xe2400000|(src<<16)|(dst<<12)|(-imm))
			return
		}
		asmEmit(a, 0xe2800000|(src<<16)|(dst<<12)|imm)
	}

	func asmAddr(a *RTGEmitter, base int, disp int) int {
		if disp == 0 {
			return base
		}
		asmAddRegImm(a, address.Code, base, disp)
		return address.Code
	}

	func asmLoadStoreAddr(a *RTGEmitter, base int, disp int, size int) int {
		if size == 2 && (disp < 0 || disp > 255) {
			return asmAddr(a, base, disp)
		}
		if size != 2 && (disp < -4095 || disp > 4095) {
			return asmAddr(a, base, disp)
		}
		return base
	}

	func asmLoadRegMem(a *RTGEmitter, dst int, base int, disp int, size int) {
		addr := asmLoadStoreAddr(a, base, disp, size)
		if addr != base {
			disp = 0
		}
		up := 0x00800000
		if disp < 0 {
			up = 0
			disp = -disp
		}
		if size == 1 {
			asmEmit(a, 0xe5500000|up|(addr<<16)|(dst<<12)|disp)
			return
		}
		if size == 2 {
			asmEmit(a, 0xe15000f0|up|(addr<<16)|(dst<<12)|((disp&0xf0)<<4)|(disp&0x0f))
			return
		}
		asmEmit(a, 0xe5100000|up|(addr<<16)|(dst<<12)|disp)
	}

	func asmStoreRegMem(a *RTGEmitter, src int, base int, disp int, size int) {
		addr := asmLoadStoreAddr(a, base, disp, size)
		if addr != base {
			disp = 0
		}
		up := 0x00800000
		if disp < 0 {
			up = 0
			disp = -disp
		}
		if size == 1 {
			asmEmit(a, 0xe5400000|up|(addr<<16)|(src<<12)|disp)
			return
		}
		if size == 2 {
			asmEmit(a, 0xe14000b0|up|(addr<<16)|(src<<12)|((disp&0xf0)<<4)|(disp&0x0f))
			return
		}
		asmEmit(a, 0xe5000000|up|(addr<<16)|(src<<12)|disp)
	}

	func asmStackMem(a *RTGEmitter, offset int, base int, disp8 int, disp32 int) {
		if base == 0x8948 && disp8 == 0x45 {
			asmStoreRegStack(a, primary.Code, offset)
			return
		}
		if base == 0x8948 && disp8 == 0x55 {
			asmStoreRegStack(a, secondary.Code, offset)
			return
		}
		if base == 0x8948 && disp8 == 0x4d {
			asmStoreRegStack(a, tertiary.Code, offset)
			return
		}
		if base == 0x8b48 && disp8 == 0x45 {
			asmLoadRegStack(a, primary.Code, offset)
			return
		}
		if base == 0x8b48 && disp8 == 0x55 {
			asmLoadRegStack(a, secondary.Code, offset)
			return
		}
		if base == 0x8b48 && disp8 == 0x4d {
			asmLoadRegStack(a, tertiary.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x45 {
			asmLeaRegStack(a, primary.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x55 {
			asmLeaRegStack(a, secondary.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x7d {
			asmLeaRegStack(a, r3.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x75 {
			asmLeaRegStack(a, r4.Code, offset)
			return
		}
	}

	func asmMemDisp(a *RTGEmitter, disp int, op int, disp8 int, disp32 int) {
		if op == 0x8b48 && disp8 == 0x4a {
			asmLoadRegMem(a, tertiary.Code, secondary.Code, disp, 4)
			return
		}
		if op == 0x8b48 && disp8 == 0x52 {
			asmLoadRegMem(a, secondary.Code, secondary.Code, disp, 4)
			return
		}
		if op == 0x8948 && disp8 == 0x41 {
			asmStoreRegMem(a, primary.Code, tertiary.Code, disp, 4)
			return
		}
	}

	func asmLoadRaxIndexRcxSize(a *RTGEmitter, size int) {
		shift := 3
		if size == 1 {
			shift = 0
		}
		if size == 2 {
			shift = 1
		}
		if size == 4 {
			shift = 2
		}
		asmAddRegRegShift(a, address.Code, primary.Code, tertiary.Code, shift)
		asmLoadRegMem(a, primary.Code, address.Code, 0, size)
	}

	func asmNormalizeRaxForKind(a *RTGEmitter, kind int) {
		if kind == RTGScalarByte {
			asmEmit(a, 0xe6ef0070)
			return
		}
		if kind == RTGScalarInt8 {
			asmEmit(a, 0xe6af0070)
			return
		}
		if kind == RTGScalarInt16 {
			asmEmit(a, 0xe6bf0070)
			return
		}
		if kind == RTGScalarUint16 {
			asmEmit(a, 0xe6ff0070)
		}
	}

	func asmCmpRegImm(a *RTGEmitter, reg int, imm int) {
		if imm >= 0 && imm <= 255 {
			asmEmit(a, 0xe3500000|(reg<<16)|imm)
			return
		}
		tmp := scratch.Code
		if reg == tmp {
			tmp = scratch2.Code
		}
		asmMovRegImm(a, tmp, imm)
		asmCmpRegReg(a, reg, tmp)
	}

	func condFromSetcc(setcc int) int {
		if setcc == 0x94 {
			return 0
		}
		if setcc == 0x95 {
			return 1
		}
		if setcc == 0x9c {
			return 11
		}
		if setcc == 0x9e {
			return 13
		}
		if setcc == 0x9f {
			return 12
		}
		return 10
	}

	func asmDivLeftRcxRightRax(a *RTGEmitter, mod bool) {
		asmMovRegReg(a, scratch.Code, primary.Code)
		asmEmit(a, 0xe710f010|(primary.Code<<16)|(primary.Code<<8)|tertiary.Code)
		if mod {
			asmEmit(a, 0xe0600090|(tertiary.Code<<12)|(scratch.Code<<8)|primary.Code)
		}
	}

	func asmStoreRaxMemRdxRcxSize(a *RTGEmitter, size int) {
		shift := 3
		if size == 1 {
			shift = 0
		}
		if size == 2 {
			shift = 1
		}
		if size == 4 {
			shift = 2
		}
		asmAddRegRegShift(a, address.Code, secondary.Code, tertiary.Code, shift)
		asmStoreRegMem(a, primary.Code, address.Code, 0, size)
	}

	func emitAddress(
		out *RTGEmitter, destination RTGRegister, memory RTGAddress,
	) {
		if RTGAddressValid(memory) {
			part := memory.Addend & 65535
			at := out.Len()
			asmEmit(out,
				0xe3000000|((part&0xf000)<<4)|
					(destination.Code<<12)|(part&0x0fff))
			part = (memory.Addend >> 16) & 65535
			asmEmit(out,
				0xe3400000|((part&0xf000)<<4)|
					(destination.Code<<12)|(part&0x0fff))
			asmEmit(out,
				0xe08f0000|(destination.Code<<12)|destination.Code)
			RTGAddressRelocAt(out, memory, at)
			return
		}
		base := memory.Base.Code
		if memory.Index.Valid {
			shift := 0
			if memory.Scale == 2 {
				shift = 1
			} else if memory.Scale == 4 {
				shift = 2
			} else if memory.Scale == 8 {
				shift = 3
			}
			asmAddRegRegShift(
				out, destination.Code, base, memory.Index.Code, shift)
			base = destination.Code
		}
		asmAddRegImm(
			out, destination.Code, base, memory.Displacement)
	}

	func memoryAddress(
		out *RTGEmitter, memory RTGAddress, size int,
	) RTGAddress {
		limit := 4095
		if size == 2 {
			limit = 255
		}
		if RTGAddressValid(memory) || memory.Index.Valid ||
			memory.Displacement < -limit ||
			memory.Displacement > limit {
			emitAddress(out, address, memory)
			return RTGAddress{Base: address}
		}
		return memory
	}

	func loadExtra(
		out *RTGEmitter,
		destination RTGRegister,
		memory RTGAddress,
		opcode int,
	) {
		memory = memoryAddress(out, memory, 2)
		displacement := memory.Displacement
		up := 0x00800000
		if displacement < 0 {
			up = 0
			displacement = -displacement
		}
		asmEmit(out,
			opcode|up|(memory.Base.Code<<16)|
				(destination.Code<<12)|
				((displacement&0xf0)<<4)|(displacement&0x0f))
	}

	func variableShift(
		out *RTGEmitter, direction RTGShiftDirection, signed bool,
	) {
		kind := 0x20
		if direction == RTGShiftLeft {
			kind = 0
		} else if signed {
			kind = 0x40
		}
		asmEmit(out,
			0xe1a00010|(primary.Code<<12)|
				(primary.Code<<8)|kind|tertiary.Code)
	}

	func signedDivide(out *RTGEmitter, remainder bool) {
		asmMovRegReg(
			out, scratch.Code, primary.Code)
		asmEmit(out,
			0xe710f010|(primary.Code<<16)|
				(primary.Code<<8)|tertiary.Code)
		if remainder {
			asmEmit(out,
				0xe0600090|(tertiary.Code<<12)|
					(scratch.Code<<8)|primary.Code)
		}
	}

	func frameFinish(out *RTGEmitter, at int, stackUsed int) {
		frame := (stackUsed + 7) & -8
		if frame > 65528 {
			frame = 65528
		}
		out.PatchUint32(at, 0xe3009000|((frame&0xf000)<<4)|(frame&0x0fff))
	}
}

arch arm {
	alias = "arm"
	endian = little
	word_bits = 32
	pointer_bits = 32
	instruction_alignment = 4
	patch_relocations = arm32_labels
	registers gpr32 = [
		r0, r1, r2, r3, r4, r5, r6, r7,
		r8, r9, r10, r11, r12, r13, r14, r15
	]
	locations {
		primary = r0
		secondary = r1
		tertiary = r2
		system = r7
		scratch = r9
		scratch2 = r10
		address = r12
		copy_destination = r3
		copy_source = r4
		copy_count = r1
		frame = r11
		stack = r13
		link = r14
	}
	conditions {
		eq = 0
		ne = 1
		uge = 2
		ult = 3
		ugt = 8
		ule = 9
		sge = 10
		slt = 11
		sgt = 12
		sle = 13
	}
	forms {
		binary = word32(destination:reg@12+16, source:reg@0)
		multiply = word32(destination:reg@0+16, source:reg@8)
		compare = word32(left:reg@16, right:reg@0)
		unary = word32(operand:reg@12+16)
		register = word32(operand:reg@0)
		branch = word32(label:label@reloc)
		conditional_branch = word32(condition:condition@28, label:label@reloc)
		fixed = bytes
	}
	instructions {
		add binary 0xe0800000
		subtract binary 0xe0400000
		multiply multiply 0xe0000090
		bit_and binary 0xe0000000
		bit_or binary 0xe1800000
		bit_xor binary 0xe0200000
		compare compare 0xe1500000
		test compare 0xe1100000
		increment unary 0xe2800001
		decrement unary 0xe2400001
		call_indirect register 0xe12fff30
		call branch 0xeb000000
		jump branch 0xea000000
		jump_condition conditional_branch 0x0a000000
		return fixed [0x1e, 0xff, 0x2f, 0xe1]
		leave fixed [0x0b, 0xd0, 0xa0, 0xe1, 0x00, 0x48, 0xbd, 0xe8]
	}
	bind {
		move = sequence move
		address = go emitAddress
		load.native = go loadNative
		load.i32 = go loadI32
		load.u32 = go loadU32
		load.i16 = go loadI16
		load.u16 = go loadU16
		load.i8 = go loadI8
		load.u8 = go loadU8
		store.native = go storeNative
		store.u32 = go storeU32
		store.u16 = go storeU16
		store.u8 = go storeU8
		add = add
		subtract = subtract
		multiply = multiply
		bit_and = bit_and
		bit_or = bit_or
		bit_xor = bit_xor
		compare = compare
		test = test
		increment = increment
		decrement = decrement
		shift_left_immediate = sequence shiftLeftImmediate
		shift_right_unsigned_immediate = sequence shiftRightUnsignedImmediate
		shift_right_signed_immediate = sequence shiftRightSignedImmediate
		call = call
		call_indirect = call_indirect
		jump = jump
		jump_condition = jump_condition
		set_condition = sequence setCondition
		return = return
		leave = leave
		host_syscall = sequence hostSyscall
		move_immediate = sequence moveImmediate
		variable_shift = go variableShift
		signed_divide = go signedDivide
		copy_bytes = sequence copyBytes
	}
	exports {
		renvoArmAsmEmit = sequence asmEmit
		renvoArmAsmAlign = go asmAlign
		renvoArmAsmMovRegReg = go asmMovRegReg
		renvoArmAsmMovRegImm = go asmMovRegImm
		renvoArmAsmPatchMovRegImmAt = sequence asmPatchMovRegImmAt
		renvoArmAsmMovRegAbs = sequence asmMovRegAbs
		renvoArmAsmAddRegImm = go asmAddRegImm
		renvoArmAsmFrameStart = go asmFrameStart
		renvoArmAsmPatchFrame = go asmPatchFrame
		renvoArmAsmAddRegSmallImm = go asmAddRegSmallImm
		renvoArmAsmAddRegReg = sequence asmAddRegReg
		renvoArmAsmSubRegReg = sequence asmSubRegReg
		renvoArmAsmAddRegRegShift = sequence asmAddRegRegShift
		renvoArmAsmMulRegReg = sequence asmMulRegReg
		renvoArmAsmAddr = go asmAddr
		renvoArmAsmLoadStoreAddr = go asmLoadStoreAddr
		renvoArmAsmLoadRegMem = go asmLoadRegMem
		renvoArmAsmStoreRegMem = go asmStoreRegMem
		renvoArmAsmLoadRegStack = sequence asmLoadRegStack
		renvoArmAsmStoreRegStack = sequence asmStoreRegStack
		renvoArmAsmLeaRegStack = sequence asmLeaRegStack
		renvoArmAsmPushReg = sequence asmPushReg
		renvoArmAsmPopReg = sequence asmPopReg
		renvoArmAsmMovRaxImm = sequence asmMovRaxImm
		renvoArmAsmMovRaxImm64 = sequence asmMovRaxImm64
		renvoArmAsmMovRdxImm = sequence asmMovRdxImm
		renvoArmAsmMovRaxDataAddr = sequence asmMovRaxDataAddr
		renvoArmAsmMovRaxBssAddr = sequence asmMovRaxBssAddr
		renvoArmAsmMovR10BssAddr = sequence asmMovR10BssAddr
		renvoArmAsmAccessRaxBss = sequence asmAccessRaxBss
		renvoArmAsmLoadRaxBss = sequence asmLoadRaxBss
		renvoArmAsmStoreRaxBss = sequence asmStoreRaxBss
		renvoArmAsmMovRdiRax = sequence asmMovRdiRax
		renvoArmAsmMovRaxRdx = sequence asmMovRaxRdx
		renvoArmAsmMovRdxRax = sequence asmMovRdxRax
		renvoArmAsmMovRcxRax = sequence asmMovRcxRax
		renvoArmAsmMovRcxRdx = sequence asmMovRcxRdx
		renvoArmAsmMovRsiRax = sequence asmMovRsiRax
		renvoArmAsmMovR8Rax = sequence asmMovR8Rax
		renvoArmAsmMovR9Rax = sequence asmMovR9Rax
		renvoArmAsmAddRdxRcx = sequence asmAddRdxRcx
		renvoArmAsmSyscall = sequence asmSyscall
		renvoArmAsmPopRdi = sequence asmPopRdi
		renvoArmAsmPopRsi = sequence asmPopRsi
		renvoArmAsmStackMem = go asmStackMem
		renvoArmAsmAddRdxImm = sequence asmAddRdxImm
		renvoArmAsmMemDisp = go asmMemDisp
		renvoArmAsmLoadQwordRaxIndexRcx8 = sequence asmLoadQwordRaxIndexRcx8
		renvoArmAsmLoadQwordRaxIndexRcxDisp = sequence asmLoadQwordRaxIndexRcxDisp
		renvoArmAsmLoadRaxMemRdxDisp = sequence asmLoadRaxMemRdxDisp
		renvoArmAsmLoadRaxMemRdxDispSize = sequence asmLoadRaxMemRdxDispSize
		renvoArmAsmLoadByteRaxIndexRcx = sequence asmLoadByteRaxIndexRcx
		renvoArmAsmLoadRaxIndexRcxSize = go asmLoadRaxIndexRcxSize
		renvoArmAsmStoreRaxMemRdxRcx8 = sequence asmStoreRaxMemRdxRcx8
		renvoArmAsmStoreRaxMemRdxDisp = sequence asmStoreRaxMemRdxDisp
		renvoArmAsmStoreRaxMemRdxDispSize = sequence asmStoreRaxMemRdxDispSize
		renvoArmAsmNormalizeRaxForKind = go asmNormalizeRaxForKind
		renvoArmAsmIncMemRdx = sequence asmIncMemRdx
		renvoArmAsmDecMemRdx = sequence asmDecMemRdx
		renvoArmAsmBoolNotRax = sequence asmBoolNotRax
		renvoArmAsmNegRax = sequence asmNegRax
		renvoArmAsmCmpRaxImm8 = sequence asmCmpRaxImm8
		renvoArmAsmCmpRegImm = go asmCmpRegImm
		renvoArmAsmCmpRegReg = sequence asmCmpRegReg
		renvoArmAsmCsetRax = sequence asmCsetRax
		renvoArmCondFromSetcc = go condFromSetcc
		renvoArmAsmCmpRcxRaxSet = sequence asmCmpRcxRaxSet
		renvoArmAsmAddRaxRcx = sequence asmAddRaxRcx
		renvoArmAsmSubRaxRcx = sequence asmSubRaxRcx
		renvoArmAsmShlRcxImm = sequence asmShlRcxImm
		renvoArmAsmShlRaxImm = sequence asmShlRaxImm
		renvoArmAsmSarRaxImm = sequence asmSarRaxImm
		renvoArmAsmShrRaxImm = sequence asmShrRaxImm
		renvoArmAsmDivLeftRcxRightRax = go asmDivLeftRcxRightRax
		renvoArmAsmPushRax = sequence asmPushRax
		renvoArmAsmPushRcx = sequence asmPushRcx
		renvoArmAsmPushRdx = sequence asmPushRdx
		renvoArmAsmPopRax = sequence asmPopRax
		renvoArmAsmPopRcx = sequence asmPopRcx
		renvoArmAsmPopRdx = sequence asmPopRdx
		renvoArmAsmPushImm = sequence asmPushImm
		renvoArmAsmStoreSliceStack = sequence asmStoreSliceStack
		renvoArmAsmStoreAlMemRdxRcx1 = sequence asmStoreAlMemRdxRcx1
		renvoArmAsmStoreRaxMemRdxRcxSize = go asmStoreRaxMemRdxRcxSize
		renvoArmAsmIncRcx = sequence asmIncRcx
		renvoArmAsmIncRax = sequence asmIncRax
		renvoArmAsmImulRcxImm = sequence asmImulRcxImm
		renvoArmAsmLeave = sequence asmLeave
		renvoArmAsmRet = sequence asmRet
		renvoArmAsmCallLabel = sequence asmCallLabel
		renvoArmAsmJmpLabel = sequence asmJmpLabel
		renvoArmAsmBCondLabel = sequence asmBCondLabel
		renvoArmAsmJzLabel = sequence asmJzLabel
		renvoArmAsmJnzLabel = sequence asmJnzLabel
	}
	relocation branch24 {
		width = 4
		signed = true
		scale = 4
		bits = 24
		relative_to = instruction
	}
	relocation address32 {
		width = 8
		signed = true
		scale = 1
		bits = 32
		relative_to = pc_at_add
	}

	sequences {
		asmAddRaxRcx(a:emitter) {
			asmAddRegReg(a, primary.Code, primary.Code, tertiary.Code)
		}
		asmAddRdxImm(a:emitter, imm:int) {
			asmAddRegImm(a, secondary.Code, secondary.Code, imm)
		}
		asmAddRdxRcx(a:emitter) {
			asmAddRegReg(a, secondary.Code, secondary.Code, tertiary.Code)
		}
		asmAddRegReg(a:emitter, dst:int, left:int, right:int) {
			asmEmit(a, 0xe0800000 |(left << 16) |(dst << 12) | right)
		}
		asmAddRegRegShift(a:emitter, dst:int, left:int, right:int, shift:int) {
			asmEmit(a, 0xe0800000 |(left << 16) |(dst << 12) |(shift << 7) | right)
		}
		asmBoolNotRax(a:emitter) {
			asmCmpRaxImm8(a, 0)
			asmCsetRax(a, 0)
		}
		asmCmpRaxImm8(a:emitter, imm:int) {
			asmCmpRegImm(a, primary.Code, imm)
		}
		asmCmpRegReg(a:emitter, left:int, right:int) {
			asmEmit(a, 0xe1500000 |(left << 16) | right)
		}
		asmCsetRax(a:emitter, cond:int) {
			asmEmit(a, 0xe3a00000)
			asmEmit(a,(cond << 28) | 0x03a00001)
		}
		asmDecMemRdx(a:emitter) {
			asmLoadRegMem(a, scratch.Code, secondary.Code, 0, 4)
			asmAddRegImm(a, scratch.Code, scratch.Code, -1)
			asmStoreRegMem(a, scratch.Code, secondary.Code, 0, 4)
		}
		asmEmit(a:emitter, insn:int) {
			RTGUint32(a, insn)
		}
		asmImulRcxImm(a:emitter, imm:int) {
			asmMovRegImm(a, scratch.Code, imm)
			asmMulRegReg(a, tertiary.Code, tertiary.Code, scratch.Code)
		}
		asmIncMemRdx(a:emitter) {
			asmLoadRegMem(a, scratch.Code, secondary.Code, 0, 4)
			asmAddRegImm(a, scratch.Code, scratch.Code, 1)
			asmStoreRegMem(a, scratch.Code, secondary.Code, 0, 4)
		}
		asmIncRax(a:emitter) {
			asmAddRegImm(a, primary.Code, primary.Code, 1)
		}
		asmIncRcx(a:emitter) {
			asmAddRegImm(a, tertiary.Code, tertiary.Code, 1)
		}
		asmJnzLabel(a:emitter, label:int) {
			asmBCondLabel(a, label, 1)
		}
		asmJzLabel(a:emitter, label:int) {
			asmBCondLabel(a, label, 0)
		}
		asmLeaRegStack(a:emitter, dst:int, offset:int) {
			asmAddRegImm(a, dst, frame.Code, -offset)
		}
		asmLeave(a:emitter) {
			asmMovRegReg(a, stack.Code, frame.Code)
			asmEmit(a, 0xe8bd4800)
		}
		asmLoadByteRaxIndexRcx(a:emitter) {
			asmAddRegReg(a, address.Code, primary.Code, tertiary.Code)
			asmLoadRegMem(a, primary.Code, address.Code, 0, 1)
		}
		asmLoadQwordRaxIndexRcx8(a:emitter) {
			asmAddRegRegShift(a, address.Code, primary.Code, tertiary.Code, 3)
			asmLoadRegMem(a, primary.Code, address.Code, 0, 4)
		}
		asmLoadQwordRaxIndexRcxDisp(a:emitter, disp:int) {
			asmAddRegReg(a, address.Code, primary.Code, tertiary.Code)
			asmLoadRegMem(a, primary.Code, address.Code, disp, 4)
		}
		asmLoadRaxBss(a:emitter, bssOff:int) {
			asmAccessRaxBss(a, bssOff, 0xe79f0000 | address.Code)
		}
		asmLoadRaxMemRdxDisp(a:emitter, disp:int) {
			asmLoadRegMem(a, primary.Code, secondary.Code, disp, 4)
		}
		asmLoadRaxMemRdxDispSize(a:emitter, disp:int, size:int) {
			asmLoadRegMem(a, primary.Code, secondary.Code, disp, size)
		}
		asmLoadRegStack(a:emitter, dst:int, offset:int) {
			asmLoadRegMem(a, dst, frame.Code, -offset, 4)
		}
		asmMovR10BssAddr(a:emitter, bssOff:int) {
			asmMovRegAbs(a, r8.Code, bssOff, RTGRelocationAbsoluteBSS)
		}
		asmMovR8Rax(a:emitter) {
			asmMovRegReg(a, r5.Code, primary.Code)
		}
		asmMovR9Rax(a:emitter) {
			asmMovRegReg(a, r6.Code, primary.Code)
		}
		asmMovRaxBssAddr(a:emitter, bssOff:int) {
			asmMovRegAbs(a, primary.Code, bssOff, RTGRelocationAbsoluteBSS)
		}
		asmMovRaxDataAddr(a:emitter, dataOff:int) {
			asmMovRegAbs(a, primary.Code, dataOff, 0)
		}
		asmMovRaxImm(a:emitter, imm:int) {
			asmMovRegImm(a, primary.Code, imm)
		}
		asmMovRaxImm64(a:emitter, imm:int) {
			asmMovRaxImm(a, imm)
		}
		asmMovRaxRdx(a:emitter) {
			asmMovRegReg(a, primary.Code, secondary.Code)
		}
		asmMovRcxRax(a:emitter) {
			asmMovRegReg(a, tertiary.Code, primary.Code)
		}
		asmMovRcxRdx(a:emitter) {
			asmMovRegReg(a, tertiary.Code, secondary.Code)
		}
		asmMovRdiRax(a:emitter) {
			asmMovRegReg(a, r3.Code, primary.Code)
		}
		asmMovRdxImm(a:emitter, imm:int) {
			asmMovRegImm(a, secondary.Code, imm)
		}
		asmMovRdxRax(a:emitter) {
			asmMovRegReg(a, secondary.Code, primary.Code)
		}
		asmMovRsiRax(a:emitter) {
			asmMovRegReg(a, r4.Code, primary.Code)
		}
		asmMulRegReg(a:emitter, dst:int, left:int, right:int) {
			asmEmit(a, 0xe0000090 |(dst << 16) |(right << 8) | left)
		}
		asmNegRax(a:emitter) {
			asmEmit(a, 0xe2600000)
		}
		asmPopRax(a:emitter) {
			asmPopReg(a, primary.Code)
		}
		asmPopRcx(a:emitter) {
			asmPopReg(a, tertiary.Code)
		}
		asmPopRdi(a:emitter) {
			asmPopReg(a, r3.Code)
		}
		asmPopRdx(a:emitter) {
			asmPopReg(a, secondary.Code)
		}
		asmPopReg(a:emitter, reg:int) {
			asmEmit(a, 0xe49d0004 |(reg << 12))
		}
		asmPopRsi(a:emitter) {
			asmPopReg(a, r4.Code)
		}
		asmPushImm(a:emitter, imm:int) {
			asmMovRegImm(a, scratch.Code, imm)
			asmPushReg(a, scratch.Code)
		}
		asmPushRax(a:emitter) {
			asmPushReg(a, primary.Code)
		}
		asmPushRcx(a:emitter) {
			asmPushReg(a, tertiary.Code)
		}
		asmPushRdx(a:emitter) {
			asmPushReg(a, secondary.Code)
		}
		asmPushReg(a:emitter, reg:int) {
			asmEmit(a, 0xe52d0004 |(reg << 12))
		}
		asmRet(a:emitter) {
			asmEmit(a, 0xe12fff1e)
		}
		asmSarRaxImm(a:emitter, imm:int) {
			asmEmit(a, 0xe1a00040 |(primary.Code << 12) |(imm << 7) | primary.Code)
		}
		asmShlRaxImm(a:emitter, imm:int) {
			asmEmit(a, 0xe1a00000 |(primary.Code << 12) |(imm << 7) | primary.Code)
		}
		asmShlRcxImm(a:emitter, imm:int) {
			asmEmit(a, 0xe1a00000 |(tertiary.Code << 12) |(imm << 7) | tertiary.Code)
		}
		asmShrRaxImm(a:emitter, imm:int) {
			asmEmit(a, 0xe1a00020 |(primary.Code << 12) |(imm << 7) | primary.Code)
		}
		asmStoreAlMemRdxRcx1(a:emitter) {
			asmAddRegReg(a, address.Code, secondary.Code, tertiary.Code)
			asmStoreRegMem(a, primary.Code, address.Code, 0, 1)
		}
		asmStoreRaxBss(a:emitter, bssOff:int) {
			asmAccessRaxBss(a, bssOff, 0xe78f0000 | address.Code)
		}
		asmStoreRaxMemRdxDisp(a:emitter, disp:int) {
			asmStoreRegMem(a, primary.Code, secondary.Code, disp, 4)
		}
		asmStoreRaxMemRdxDispSize(a:emitter, disp:int, size:int) {
			asmStoreRegMem(a, primary.Code, secondary.Code, disp, size)
		}
		asmStoreRaxMemRdxRcx8(a:emitter) {
			asmAddRegRegShift(a, address.Code, secondary.Code, tertiary.Code, 3)
			asmStoreRegMem(a, primary.Code, address.Code, 0, 4)
		}
		asmStoreRegStack(a:emitter, src:int, offset:int) {
			asmStoreRegMem(a, src, frame.Code, -offset, 4)
		}
		asmStoreSliceStack(a:emitter, offset:int) {
			asmStoreRegStack(a, primary.Code, offset)
			asmStoreRegStack(a, secondary.Code, offset - 8)
			asmStoreRegStack(a, tertiary.Code, offset - 16)
		}
		asmSubRaxRcx(a:emitter) {
			asmSubRegReg(a, primary.Code, primary.Code, tertiary.Code)
		}
		asmSubRegReg(a:emitter, dst:int, left:int, right:int) {
			asmEmit(a, 0xe0400000 |(left << 16) |(dst << 12) | right)
		}
		asmSyscall(a:emitter) {
			asmMovRegReg(a, system.Code, primary.Code)
			asmMovRegReg(a, scratch.Code, secondary.Code)
			asmMovRegReg(a, 0, r3.Code)
			asmMovRegReg(a, 1, r4.Code)
			asmMovRegReg(a, 2, scratch.Code)
			asmMovRegReg(a, 3, r8.Code)
			asmMovRegReg(a, 4, r8.Code)
			asmMovRegImm(a, 5, 0)
			asmEmit(a, 0xef000000)
		}
		asmAccessRaxBss(a:emitter, bssOff:int, insn:int) {
			let at = a.Len()
			RTGUint32(a, 0xe3000000 |(address.Code << 12))
			RTGUint32(a, 0xe3400000 |(address.Code << 12))
			RTGUint32(a, insn)
			a.AbsoluteReloc(at, bssOff, RTGRelocationAbsoluteBSS)
		}
		asmBCondLabel(a:emitter, label:int, cond:int) {
			let at = a.Len()
			asmEmit(a,(cond << 28) | 0x0a000000)
			a.RelocAt(at, label)
		}
		asmCallLabel(a:emitter, label:int) {
			let at = a.Len()
			asmEmit(a, 0xeb000000)
			a.RelocAt(at, label)
		}
		asmCmpRcxRaxSet(a:emitter, setcc:int) {
			asmCmpRegReg(a, tertiary.Code, primary.Code)
			let cond = condFromSetcc(setcc)
			asmCsetRax(a, cond)
		}
		asmJmpLabel(a:emitter, label:int) {
			let at = a.Len()
			asmEmit(a, 0xea000000)
			a.RelocAt(at, label)
		}
		asmMovRegAbs(a:emitter, reg:int, off:int, kind:int) {
			let at = a.Len()
			RTGUint32(a, 0xe3000000 |(reg << 12))
			RTGUint32(a, 0xe3400000 |(reg << 12))
			RTGUint32(a, 0xe08f0000 |(reg << 12) | reg)
			a.AbsoluteReloc(at, off, kind)
		}
		asmPatchMovRegImmAt(a:emitter, at:int, reg:int, imm:int) {
			let part = imm & 65535
			a.PatchUint32(at, 0xe3000000 |((part & 0xf000) << 4) |(reg << 12) |(part & 0x0fff))
			set part =(imm >> 16) & 65535
			a.PatchUint32(at + 4, 0xe3400000 |((part & 0xf000) << 4) |(reg << 12) |(part & 0x0fff))
		}
		copyBytes(out:emitter) {
			let destination = r3
			let source = r4
			let count = secondary
			let value = scratch2
			let forward = out.NewLabel()
			let forwardLoop = out.NewLabel()
			let backwardLoop = out.NewLabel()
			let done = out.NewLabel()
			compare(out, destination, source)
			jumpCondition(out, record_condition(Code:9), forward)
			emitAddress(out, scratch, record_address(Base:source, Index:count, Scale:1,))
			compare(out, destination, scratch)
			jumpCondition(out, record_condition(Code:2), forward)
			emitAddress(out, source, record_address(Base:source, Index:count, Scale:1, Displacement:-1,))
			emitAddress(out, destination, record_address(Base:destination, Index:count, Scale:1, Displacement:-1,))
			out.Mark(backwardLoop)
			asmCmpRegImm(out, count.Code, 0)
			jumpCondition(out, record_condition(Code:0), done)
			loadU8(out, value, record_address(Base:source))
			storeU8(out, record_address(Base:destination), value)
			decrement(out, source)
			decrement(out, destination)
			decrement(out, count)
			jump(out, backwardLoop)
			out.Mark(forward)
			out.Mark(forwardLoop)
			asmCmpRegImm(out, count.Code, 0)
			jumpCondition(out, record_condition(Code:0), done)
			loadU8(out, value, record_address(Base:source))
			storeU8(out, record_address(Base:destination), value)
			increment(out, source)
			increment(out, destination)
			decrement(out, count)
			jump(out, forwardLoop)
			out.Mark(done)
		}
		frameStart(out:emitter) -> int {
			out.Bytes4(0x00, 0x48, 0x2d, 0xe9)
			asmMovRegReg(out, 11, 13)
			let at = out.Len()
			asmEmit(out, 0xe3009000)
			asmEmit(out, 0xe04dd009)
			return at
		}
		hostSyscall(out:emitter) {
			# Direct runtimes already place the syscall number and arguments in
			# their declared registers. The legacy compiler helper translates
			# Renvo's pseudo-register convention and would overwrite r7 here.
			asmEmit(out, 0xef000000)
		}
		move(out:emitter, destination:register, source:register) {
			asmMovRegReg(out, destination.Code, source.Code)
		}
		moveImmediate(out:emitter, destination:register, value:int64) {
			asmMovRegImm(out, destination.Code, int(value))
		}
		setCondition(out:emitter, condition:condition, destination:register) {
			asmEmit(out, 0xe3a00000 |(destination.Code << 12))
			asmEmit(out,(condition.Code << 28) | 0x03a00001 |(destination.Code << 12))
		}
		shiftLeftImmediate(out:emitter, operand:register, value:byte) {
			shiftImmediate(out, operand, value, 0)
		}
		shiftRightSignedImmediate(out:emitter, operand:register, value:byte) {
			shiftImmediate(out, operand, value, 0x40)
		}
		shiftRightUnsignedImmediate(out:emitter, operand:register, value:byte) {
			shiftImmediate(out, operand, value, 0x20)
		}
		loadI16(out:emitter, destination:register, address:address) {
			loadExtra(out, destination, address, 0xe15000f0)
		}
		loadI32(out:emitter, destination:register, address:address) {
			loadNative(out, destination, address)
		}
		loadI8(out:emitter, destination:register, address:address) {
			loadExtra(out, destination, address, 0xe15000d0)
		}
		loadNative(out:emitter, destination:register, address:address) {
			set address = memoryAddress(out, address, 4)
			asmLoadRegMem(out, destination.Code, address.Base.Code, address.Displacement, 4)
		}
		loadU16(out:emitter, destination:register, address:address) {
			loadExtra(out, destination, address, 0xe15000b0)
		}
		loadU32(out:emitter, destination:register, address:address) {
			loadNative(out, destination, address)
		}
		loadU8(out:emitter, destination:register, address:address) {
			set address = memoryAddress(out, address, 1)
			asmLoadRegMem(out, destination.Code, address.Base.Code, address.Displacement, 1)
		}
		shiftImmediate(out:emitter, operand:register, value:byte, kind:int) {
			asmEmit(out, 0xe1a00000 |(operand.Code << 12) |((int(value) & 31) << 7) | kind | operand.Code)
		}
		storeNative(out:emitter, address:address, source:register) {
			storeWidth(out, address, source, 4)
		}
		storeU16(out:emitter, address:address, source:register) {
			storeWidth(out, address, source, 2)
		}
		storeU32(out:emitter, address:address, source:register) {
			storeWidth(out, address, source, 4)
		}
		storeU8(out:emitter, address:address, source:register) {
			storeWidth(out, address, source, 1)
		}
		storeWidth(out:emitter, address:address, source:register, size:int) {
			set address = memoryAddress(out, address, size)
			asmStoreRegMem(out, source.Code, address.Base.Code, address.Displacement, size)
		}
	}
}

abi renvo_arm {
	arch = arm
	frame_start = sequence frameStart
	frame_finish = go frameFinish
	call_words = [r0, r1, r2, r3, r4, r5]
	overflow_stride = 4
	scalar_result = r0
}

abi aapcs32 {
	internal = renvo_arm
	arguments = [r0, r1, r2, r3]
	result = [r0, r1]
	stack_alignment = 8
}
