		renvoArmAsmStoreRaxMemRdxRcxSize = go renvoArmAsmStoreRaxMemRdxRcxSize
		renvoArmAsmIncRcx = go renvoArmAsmIncRcx
		renvoArmAsmIncRax = go renvoArmAsmIncRax
		renvoArmAsmImulRcxImm = go renvoArmAsmImulRcxImm
