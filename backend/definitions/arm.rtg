definition 1
unit arm
implements direct_emitter_v1

# This closed definition owns the complete 32-bit ARM production encoder and
# the advertised Linux target composition.
go backend {
	func renvoArmAsmEmit(a *RTGEmitter, insn int) {
		RTGUint32(a, insn)
	}

	func renvoArmAsmAlign(a *RTGEmitter) {
		for a.Len()%4 != 0 {
			RTGByte(a, 0)
		}
	}

	func renvoArmAsmMovRegReg(a *RTGEmitter, dst int, src int) {
		if dst == src {
			return
		}
		renvoArmAsmEmit(a, 0xe1a00000|(dst<<12)|src)
	}

	func renvoArmAsmMovRegImm(a *RTGEmitter, reg int, imm int) {
		part := imm & 65535
		renvoArmAsmEmit(a, 0xe3000000|((part&0xf000)<<4)|(reg<<12)|(part&0x0fff))
		part = (imm >> 16) & 65535
		if part != 0 {
			renvoArmAsmEmit(a, 0xe3400000|((part&0xf000)<<4)|(reg<<12)|(part&0x0fff))
		}
	}

	func renvoArmAsmPatchMovRegImmAt(a *RTGEmitter, at int, reg int, imm int) {
		part := imm & 65535
		a.PatchUint32( at, 0xe3000000|((part&0xf000)<<4)|(reg<<12)|(part&0x0fff))
		part = (imm >> 16) & 65535
		a.PatchUint32( at+4, 0xe3400000|((part&0xf000)<<4)|(reg<<12)|(part&0x0fff))
	}

	func renvoArmAsmMovRegAbs(a *RTGEmitter, reg int, off int, kind int) {
		at := a.Len()
		RTGUint32(a, 0xe3000000|(reg<<12))
		RTGUint32(a, 0xe3400000|(reg<<12))
		RTGUint32(a, 0xe08f0000|(reg<<12)|reg)
		a.AbsoluteReloc( at, off, kind)
	}

	func renvoArmAsmAddRegImm(a *RTGEmitter, dst int, src int, imm int) {
		if imm == 0 {
			renvoArmAsmMovRegReg(a, dst, src)
			return
		}
		tmp := armScratch.Code
		if dst == tmp || src == tmp {
			tmp = armScratch2.Code
		}
		if imm < 0 {
			renvoArmAsmMovRegImm(a, tmp, -imm)
			renvoArmAsmSubRegReg(a, dst, src, tmp)
			return
		}
		renvoArmAsmMovRegImm(a, tmp, imm)
		renvoArmAsmAddRegReg(a, dst, src, tmp)
	}

	func renvoArmAsmFrameStart(a *RTGEmitter) int {
		at := a.Len()
		renvoArmAsmEmit(a, 0xe3009000) // movw r9, #0
		renvoArmAsmEmit(a, 0xe04dd009) // sub sp, sp, r9
		return at
	}

	func renvoArmAsmPatchFrame(a *RTGEmitter, at int, stackUsed int) {
		frame := (stackUsed + 7) & -8
		if frame > 65528 {
			frame = 65528
		}
		a.PatchUint32( at, 0xe3009000|((frame&0xf000)<<4)|(frame&0x0fff))
	}

	func renvoArmAsmAddRegSmallImm(a *RTGEmitter, dst int, src int, imm int) {
		if imm < 0 {
			renvoArmAsmEmit(a, 0xe2400000|(src<<16)|(dst<<12)|(-imm))
			return
		}
		renvoArmAsmEmit(a, 0xe2800000|(src<<16)|(dst<<12)|imm)
	}

	func renvoArmAsmAddRegReg(a *RTGEmitter, dst int, left int, right int) {
		renvoArmAsmEmit(a, 0xe0800000|(left<<16)|(dst<<12)|right)
	}

	func renvoArmAsmSubRegReg(a *RTGEmitter, dst int, left int, right int) {
		renvoArmAsmEmit(a, 0xe0400000|(left<<16)|(dst<<12)|right)
	}

	func renvoArmAsmAddRegRegShift(a *RTGEmitter, dst int, left int, right int, shift int) {
		renvoArmAsmEmit(a, 0xe0800000|(left<<16)|(dst<<12)|(shift<<7)|right)
	}

	func renvoArmAsmMulRegReg(a *RTGEmitter, dst int, left int, right int) {
		renvoArmAsmEmit(a, 0xe0000090|(dst<<16)|(right<<8)|left)
	}

	func renvoArmAsmAddr(a *RTGEmitter, base int, disp int) int {
		if disp == 0 {
			return base
		}
		renvoArmAsmAddRegImm(a, armAddress.Code, base, disp)
		return armAddress.Code
	}

	func renvoArmAsmLoadStoreAddr(a *RTGEmitter, base int, disp int, size int) int {
		if size == 2 && (disp < 0 || disp > 255) {
			return renvoArmAsmAddr(a, base, disp)
		}
		if size != 2 && (disp < -4095 || disp > 4095) {
			return renvoArmAsmAddr(a, base, disp)
		}
		return base
	}

	func renvoArmAsmLoadRegMem(a *RTGEmitter, dst int, base int, disp int, size int) {
		addr := renvoArmAsmLoadStoreAddr(a, base, disp, size)
		if addr != base {
			disp = 0
		}
		up := 0x00800000
		if disp < 0 {
			up = 0
			disp = -disp
		}
		if size == 1 {
			renvoArmAsmEmit(a, 0xe5500000|up|(addr<<16)|(dst<<12)|disp)
			return
		}
		if size == 2 {
			renvoArmAsmEmit(a, 0xe15000f0|up|(addr<<16)|(dst<<12)|((disp&0xf0)<<4)|(disp&0x0f))
			return
		}
		renvoArmAsmEmit(a, 0xe5100000|up|(addr<<16)|(dst<<12)|disp)
	}

	func renvoArmAsmStoreRegMem(a *RTGEmitter, src int, base int, disp int, size int) {
		addr := renvoArmAsmLoadStoreAddr(a, base, disp, size)
		if addr != base {
			disp = 0
		}
		up := 0x00800000
		if disp < 0 {
			up = 0
			disp = -disp
		}
		if size == 1 {
			renvoArmAsmEmit(a, 0xe5400000|up|(addr<<16)|(src<<12)|disp)
			return
		}
		if size == 2 {
			renvoArmAsmEmit(a, 0xe14000b0|up|(addr<<16)|(src<<12)|((disp&0xf0)<<4)|(disp&0x0f))
			return
		}
		renvoArmAsmEmit(a, 0xe5000000|up|(addr<<16)|(src<<12)|disp)
	}

	func renvoArmAsmLoadRegStack(a *RTGEmitter, dst int, offset int) {
		renvoArmAsmLoadRegMem(a, dst, armFrame.Code, -offset, 4)
	}

	func renvoArmAsmStoreRegStack(a *RTGEmitter, src int, offset int) {
		renvoArmAsmStoreRegMem(a, src, armFrame.Code, -offset, 4)
	}

	func renvoArmAsmLeaRegStack(a *RTGEmitter, dst int, offset int) {
		renvoArmAsmAddRegImm(a, dst, armFrame.Code, -offset)
	}

	func renvoArmAsmPushReg(a *RTGEmitter, reg int) {
		renvoArmAsmEmit(a, 0xe52d0004|(reg<<12))
	}

	func renvoArmAsmPopReg(a *RTGEmitter, reg int) {
		renvoArmAsmEmit(a, 0xe49d0004|(reg<<12))
	}

	func renvoArmAsmMovRaxImm(a *RTGEmitter, imm int) {
		renvoArmAsmMovRegImm(a, armPrimary.Code, imm)
	}

	func renvoArmAsmMovRaxImm64(a *RTGEmitter, imm int) {
		renvoArmAsmMovRaxImm(a, imm)
	}

	func renvoArmAsmMovRdxImm(a *RTGEmitter, imm int) {
		renvoArmAsmMovRegImm(a, armSecondary.Code, imm)
	}

	func renvoArmAsmMovRaxDataAddr(a *RTGEmitter, dataOff int) {
		renvoArmAsmMovRegAbs(a, armPrimary.Code, dataOff, 0)
	}

	func renvoArmAsmMovRaxBssAddr(a *RTGEmitter, bssOff int) {
		renvoArmAsmMovRegAbs(a, armPrimary.Code, bssOff, RTGRelocationAbsoluteBSS)
	}

	func renvoArmAsmMovR10BssAddr(a *RTGEmitter, bssOff int) {
		renvoArmAsmMovRegAbs(a, armR8.Code, bssOff, RTGRelocationAbsoluteBSS)
	}

	func renvoArmAsmAccessRaxBss(a *RTGEmitter, bssOff int, insn int) {
		at := a.Len()
		RTGUint32(a, 0xe3000000|(armAddress.Code<<12))
		RTGUint32(a, 0xe3400000|(armAddress.Code<<12))
		RTGUint32(a, insn)
		a.AbsoluteReloc( at, bssOff, RTGRelocationAbsoluteBSS)
	}

	func renvoArmAsmLoadRaxBss(a *RTGEmitter, bssOff int) {
		renvoArmAsmAccessRaxBss(a, bssOff, 0xe79f0000|armAddress.Code)
	}

	func renvoArmAsmStoreRaxBss(a *RTGEmitter, bssOff int) {
		renvoArmAsmAccessRaxBss(a, bssOff, 0xe78f0000|armAddress.Code)
	}

	func renvoArmAsmMovRdiRax(a *RTGEmitter) {
		renvoArmAsmMovRegReg(a, armR3.Code, armPrimary.Code)
	}

	func renvoArmAsmMovRaxRdx(a *RTGEmitter) {
		renvoArmAsmMovRegReg(a, armPrimary.Code, armSecondary.Code)
	}

	func renvoArmAsmMovRdxRax(a *RTGEmitter) {
		renvoArmAsmMovRegReg(a, armSecondary.Code, armPrimary.Code)
	}

	func renvoArmAsmMovRcxRax(a *RTGEmitter) {
		renvoArmAsmMovRegReg(a, armTertiary.Code, armPrimary.Code)
	}

	func renvoArmAsmMovRcxRdx(a *RTGEmitter) {
		renvoArmAsmMovRegReg(a, armTertiary.Code, armSecondary.Code)
	}

	func renvoArmAsmMovRsiRax(a *RTGEmitter) {
		renvoArmAsmMovRegReg(a, armR4.Code, armPrimary.Code)
	}

	func renvoArmAsmMovR8Rax(a *RTGEmitter) {
		renvoArmAsmMovRegReg(a, armR5.Code, armPrimary.Code)
	}

	func renvoArmAsmMovR9Rax(a *RTGEmitter) {
		renvoArmAsmMovRegReg(a, armR6.Code, armPrimary.Code)
	}

	func renvoArmAsmAddRdxRcx(a *RTGEmitter) {
		renvoArmAsmAddRegReg(a, armSecondary.Code, armSecondary.Code, armTertiary.Code)
	}

	func renvoArmAsmSyscall(a *RTGEmitter) {
		renvoArmAsmMovRegReg(a, armSystem.Code, armPrimary.Code)
		renvoArmAsmMovRegReg(a, armScratch.Code, armSecondary.Code)
		renvoArmAsmMovRegReg(a, 0, armR3.Code)
		renvoArmAsmMovRegReg(a, 1, armR4.Code)
		renvoArmAsmMovRegReg(a, 2, armScratch.Code)
		renvoArmAsmMovRegReg(a, 3, armR8.Code)
		renvoArmAsmMovRegReg(a, 4, armR8.Code)
		renvoArmAsmMovRegImm(a, 5, 0)
		renvoArmAsmEmit(a, 0xef000000)
	}

	func renvoArmAsmPopRdi(a *RTGEmitter) {
		renvoArmAsmPopReg(a, armR3.Code)
	}

	func renvoArmAsmPopRsi(a *RTGEmitter) {
		renvoArmAsmPopReg(a, armR4.Code)
	}

	func renvoArmAsmStackMem(a *RTGEmitter, offset int, base int, disp8 int, disp32 int) {
		if base == 0x8948 && disp8 == 0x45 {
			renvoArmAsmStoreRegStack(a, armPrimary.Code, offset)
			return
		}
		if base == 0x8948 && disp8 == 0x55 {
			renvoArmAsmStoreRegStack(a, armSecondary.Code, offset)
			return
		}
		if base == 0x8948 && disp8 == 0x4d {
			renvoArmAsmStoreRegStack(a, armTertiary.Code, offset)
			return
		}
		if base == 0x8b48 && disp8 == 0x45 {
			renvoArmAsmLoadRegStack(a, armPrimary.Code, offset)
			return
		}
		if base == 0x8b48 && disp8 == 0x55 {
			renvoArmAsmLoadRegStack(a, armSecondary.Code, offset)
			return
		}
		if base == 0x8b48 && disp8 == 0x4d {
			renvoArmAsmLoadRegStack(a, armTertiary.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x45 {
			renvoArmAsmLeaRegStack(a, armPrimary.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x55 {
			renvoArmAsmLeaRegStack(a, armSecondary.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x7d {
			renvoArmAsmLeaRegStack(a, armR3.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x75 {
			renvoArmAsmLeaRegStack(a, armR4.Code, offset)
			return
		}
	}

	func renvoArmAsmAddRdxImm(a *RTGEmitter, imm int) {
		renvoArmAsmAddRegImm(a, armSecondary.Code, armSecondary.Code, imm)
	}

	func renvoArmAsmMemDisp(a *RTGEmitter, disp int, op int, disp8 int, disp32 int) {
		if op == 0x8b48 && disp8 == 0x4a {
			renvoArmAsmLoadRegMem(a, armTertiary.Code, armSecondary.Code, disp, 4)
			return
		}
		if op == 0x8b48 && disp8 == 0x52 {
			renvoArmAsmLoadRegMem(a, armSecondary.Code, armSecondary.Code, disp, 4)
			return
		}
		if op == 0x8948 && disp8 == 0x41 {
			renvoArmAsmStoreRegMem(a, armPrimary.Code, armTertiary.Code, disp, 4)
			return
		}
	}

	func renvoArmAsmLoadQwordRaxIndexRcx8(a *RTGEmitter) {
		renvoArmAsmAddRegRegShift(a, armAddress.Code, armPrimary.Code, armTertiary.Code, 3)
		renvoArmAsmLoadRegMem(a, armPrimary.Code, armAddress.Code, 0, 4)
	}

	func renvoArmAsmLoadQwordRaxIndexRcxDisp(a *RTGEmitter, disp int) {
		renvoArmAsmAddRegReg(a, armAddress.Code, armPrimary.Code, armTertiary.Code)
		renvoArmAsmLoadRegMem(a, armPrimary.Code, armAddress.Code, disp, 4)
	}

	func renvoArmAsmLoadRaxMemRdxDisp(a *RTGEmitter, disp int) {
		renvoArmAsmLoadRegMem(a, armPrimary.Code, armSecondary.Code, disp, 4)
	}

	func renvoArmAsmLoadRaxMemRdxDispSize(a *RTGEmitter, disp int, size int) {
		renvoArmAsmLoadRegMem(a, armPrimary.Code, armSecondary.Code, disp, size)
	}

	func renvoArmAsmLoadByteRaxIndexRcx(a *RTGEmitter) {
		renvoArmAsmAddRegReg(a, armAddress.Code, armPrimary.Code, armTertiary.Code)
		renvoArmAsmLoadRegMem(a, armPrimary.Code, armAddress.Code, 0, 1)
	}

	func renvoArmAsmLoadRaxIndexRcxSize(a *RTGEmitter, size int) {
		shift := 3
		if size == 1 {
			shift = 0
		}
		if size == 2 {
			shift = 1
		}
		if size == 4 {
			shift = 2
		}
		renvoArmAsmAddRegRegShift(a, armAddress.Code, armPrimary.Code, armTertiary.Code, shift)
		renvoArmAsmLoadRegMem(a, armPrimary.Code, armAddress.Code, 0, size)
	}

	func renvoArmAsmStoreRaxMemRdxRcx8(a *RTGEmitter) {
		renvoArmAsmAddRegRegShift(a, armAddress.Code, armSecondary.Code, armTertiary.Code, 3)
		renvoArmAsmStoreRegMem(a, armPrimary.Code, armAddress.Code, 0, 4)
	}

	func renvoArmAsmStoreRaxMemRdxDisp(a *RTGEmitter, disp int) {
		renvoArmAsmStoreRegMem(a, armPrimary.Code, armSecondary.Code, disp, 4)
	}

	func renvoArmAsmStoreRaxMemRdxDispSize(a *RTGEmitter, disp int, size int) {
		renvoArmAsmStoreRegMem(a, armPrimary.Code, armSecondary.Code, disp, size)
	}

	func renvoArmAsmNormalizeRaxForKind(a *RTGEmitter, kind int) {
		if kind == RTGScalarByte {
			renvoArmAsmEmit(a, 0xe6ef0070)
			return
		}
		if kind == RTGScalarInt8 {
			renvoArmAsmEmit(a, 0xe6af0070)
			return
		}
		if kind == RTGScalarInt16 {
			renvoArmAsmEmit(a, 0xe6bf0070)
			return
		}
		if kind == RTGScalarUint16 {
			renvoArmAsmEmit(a, 0xe6ff0070)
		}
	}

	func renvoArmAsmIncMemRdx(a *RTGEmitter) {
		renvoArmAsmLoadRegMem(a, armScratch.Code, armSecondary.Code, 0, 4)
		renvoArmAsmAddRegImm(a, armScratch.Code, armScratch.Code, 1)
		renvoArmAsmStoreRegMem(a, armScratch.Code, armSecondary.Code, 0, 4)
	}

	func renvoArmAsmDecMemRdx(a *RTGEmitter) {
		renvoArmAsmLoadRegMem(a, armScratch.Code, armSecondary.Code, 0, 4)
		renvoArmAsmAddRegImm(a, armScratch.Code, armScratch.Code, -1)
		renvoArmAsmStoreRegMem(a, armScratch.Code, armSecondary.Code, 0, 4)
	}

	func renvoArmAsmBoolNotRax(a *RTGEmitter) {
		renvoArmAsmCmpRaxImm8(a, 0)
		renvoArmAsmCsetRax(a, 0)
	}

	func renvoArmAsmNegRax(a *RTGEmitter) {
		renvoArmAsmEmit(a, 0xe2600000)
	}

	func renvoArmAsmCmpRaxImm8(a *RTGEmitter, imm int) {
		renvoArmAsmCmpRegImm(a, armPrimary.Code, imm)
	}

	func renvoArmAsmCmpRegImm(a *RTGEmitter, reg int, imm int) {
		if imm >= 0 && imm <= 255 {
			renvoArmAsmEmit(a, 0xe3500000|(reg<<16)|imm)
			return
		}
		tmp := armScratch.Code
		if reg == tmp {
			tmp = armScratch2.Code
		}
		renvoArmAsmMovRegImm(a, tmp, imm)
		renvoArmAsmCmpRegReg(a, reg, tmp)
	}

	func renvoArmAsmCmpRegReg(a *RTGEmitter, left int, right int) {
		renvoArmAsmEmit(a, 0xe1500000|(left<<16)|right)
	}

	func renvoArmAsmCsetRax(a *RTGEmitter, cond int) {
		renvoArmAsmEmit(a, 0xe3a00000)
		renvoArmAsmEmit(a, (cond<<28)|0x03a00001)
	}

	func renvoArmCondFromSetcc(setcc int) int {
		if setcc == 0x94 {
			return 0
		}
		if setcc == 0x95 {
			return 1
		}
		if setcc == 0x9c {
			return 11
		}
		if setcc == 0x9e {
			return 13
		}
		if setcc == 0x9f {
			return 12
		}
		return 10
	}

	func renvoArmAsmCmpRcxRaxSet(a *RTGEmitter, setcc int) {
		renvoArmAsmCmpRegReg(a, armTertiary.Code, armPrimary.Code)
		cond := renvoArmCondFromSetcc(setcc)
		renvoArmAsmCsetRax(a, cond)
	}

	func renvoArmAsmAddRaxRcx(a *RTGEmitter) {
		renvoArmAsmAddRegReg(a, armPrimary.Code, armPrimary.Code, armTertiary.Code)
	}

	func renvoArmAsmSubRaxRcx(a *RTGEmitter) {
		renvoArmAsmSubRegReg(a, armPrimary.Code, armPrimary.Code, armTertiary.Code)
	}

	func renvoArmAsmShlRcxImm(a *RTGEmitter, imm int) {
		renvoArmAsmEmit(a, 0xe1a00000|(armTertiary.Code<<12)|(imm<<7)|armTertiary.Code)
	}

	func renvoArmAsmShlRaxImm(a *RTGEmitter, imm int) {
		renvoArmAsmEmit(a, 0xe1a00000|(armPrimary.Code<<12)|(imm<<7)|armPrimary.Code)
	}

	func renvoArmAsmSarRaxImm(a *RTGEmitter, imm int) {
		renvoArmAsmEmit(a, 0xe1a00040|(armPrimary.Code<<12)|(imm<<7)|armPrimary.Code)
	}

	func renvoArmAsmShrRaxImm(a *RTGEmitter, imm int) {
		renvoArmAsmEmit(a, 0xe1a00020|(armPrimary.Code<<12)|(imm<<7)|armPrimary.Code)
	}

	func renvoArmAsmDivLeftRcxRightRax(a *RTGEmitter, mod bool) {
		renvoArmAsmMovRegReg(a, armScratch.Code, armPrimary.Code)
		renvoArmAsmEmit(a, 0xe710f010|(armPrimary.Code<<16)|(armPrimary.Code<<8)|armTertiary.Code)
		if mod {
			renvoArmAsmEmit(a, 0xe0600090|(armTertiary.Code<<12)|(armScratch.Code<<8)|armPrimary.Code)
		}
	}

	func renvoArmAsmPushRax(a *RTGEmitter) {
		renvoArmAsmPushReg(a, armPrimary.Code)
	}

	func renvoArmAsmPushRcx(a *RTGEmitter) {
		renvoArmAsmPushReg(a, armTertiary.Code)
	}

	func renvoArmAsmPushRdx(a *RTGEmitter) {
		renvoArmAsmPushReg(a, armSecondary.Code)
	}

	func renvoArmAsmPopRax(a *RTGEmitter) {
		renvoArmAsmPopReg(a, armPrimary.Code)
	}

	func renvoArmAsmPopRcx(a *RTGEmitter) {
		renvoArmAsmPopReg(a, armTertiary.Code)
	}

	func renvoArmAsmPopRdx(a *RTGEmitter) {
		renvoArmAsmPopReg(a, armSecondary.Code)
	}

	func renvoArmAsmPushImm(a *RTGEmitter, imm int) {
		renvoArmAsmMovRegImm(a, armScratch.Code, imm)
		renvoArmAsmPushReg(a, armScratch.Code)
	}

	func renvoArmAsmStoreSliceStack(a *RTGEmitter, offset int) {
		renvoArmAsmStoreRegStack(a, armPrimary.Code, offset)
		renvoArmAsmStoreRegStack(a, armSecondary.Code, offset-8)
		renvoArmAsmStoreRegStack(a, armTertiary.Code, offset-16)
	}

	func renvoArmAsmStoreAlMemRdxRcx1(a *RTGEmitter) {
		renvoArmAsmAddRegReg(a, armAddress.Code, armSecondary.Code, armTertiary.Code)
		renvoArmAsmStoreRegMem(a, armPrimary.Code, armAddress.Code, 0, 1)
	}

	func renvoArmAsmStoreRaxMemRdxRcxSize(a *RTGEmitter, size int) {
		shift := 3
		if size == 1 {
			shift = 0
		}
		if size == 2 {
			shift = 1
		}
		if size == 4 {
			shift = 2
		}
		renvoArmAsmAddRegRegShift(a, armAddress.Code, armSecondary.Code, armTertiary.Code, shift)
		renvoArmAsmStoreRegMem(a, armPrimary.Code, armAddress.Code, 0, size)
	}

	func renvoArmAsmIncRcx(a *RTGEmitter) {
		renvoArmAsmAddRegImm(a, armTertiary.Code, armTertiary.Code, 1)
	}

	func renvoArmAsmIncRax(a *RTGEmitter) {
		renvoArmAsmAddRegImm(a, armPrimary.Code, armPrimary.Code, 1)
	}

	func renvoArmAsmImulRcxImm(a *RTGEmitter, imm int) {
		renvoArmAsmMovRegImm(a, armScratch.Code, imm)
		renvoArmAsmMulRegReg(a, armTertiary.Code, armTertiary.Code, armScratch.Code)
	}

	func renvoArmAsmLeave(a *RTGEmitter) {
		renvoArmAsmMovRegReg(a, armStack.Code, armFrame.Code)
		renvoArmAsmEmit(a, 0xe8bd4800)
	}

	func renvoArmAsmRet(a *RTGEmitter) {
		renvoArmAsmEmit(a, 0xe12fff1e)
	}

	func renvoArmAsmCallLabel(a *RTGEmitter, label int) {
		at := a.Len()
		renvoArmAsmEmit(a, 0xeb000000)
		a.RelocAt(at, label)
	}

	func renvoArmAsmJmpLabel(a *RTGEmitter, label int) {
		at := a.Len()
		renvoArmAsmEmit(a, 0xea000000)
		a.RelocAt(at, label)
	}

	func renvoArmAsmBCondLabel(a *RTGEmitter, label int, cond int) {
		at := a.Len()
		renvoArmAsmEmit(a, (cond<<28)|0x0a000000)
		a.RelocAt(at, label)
	}

	func renvoArmAsmJzLabel(a *RTGEmitter, label int) {
		renvoArmAsmBCondLabel(a, label, 0)
	}

	func renvoArmAsmJnzLabel(a *RTGEmitter, label int) {
		renvoArmAsmBCondLabel(a, label, 1)
	}
}

arch arm {
	alias = "arm"
	endian = little
	word_bits = 32
	pointer_bits = 32
	instruction_alignment = 4
	registers gpr32 = [
		r0, r1, r2, r3, r4, r5, r6, r7,
		r8, r9, r10, r11, r12, r13, r14, r15
	]
	locations {
		primary = r0
		secondary = r1
		tertiary = r2
		system = r7
		scratch = r9
		scratch2 = r10
		address = r12
		frame = r11
		stack = r13
		link = r14
	}
	exports {
		renvoArmAsmEmit = go renvoArmAsmEmit
		renvoArmAsmAlign = go renvoArmAsmAlign
		renvoArmAsmMovRegReg = go renvoArmAsmMovRegReg
		renvoArmAsmMovRegImm = go renvoArmAsmMovRegImm
