		renvoArmAsmJzLabel = go renvoArmAsmJzLabel
		renvoArmAsmJnzLabel = go renvoArmAsmJnzLabel
	}
	relocation branch24 {
		width = 4
		signed = true
		scale = 4
		bits = 24
		relative_to = instruction
	}
}

abi aapcs32 {
	arch = arm
	arguments = [r0, r1, r2, r3]
	result = [r0, r1]
	stack_alignment = 8
}

runtime linux_arm {
	operations = [print, open, close, read, write, chmod]
}

format elf32_arm {
	byte_order = little
	address_bits = 32
	kind = elf
	machine = 40
}

target linux/arm {
	os = linux
	arch = arm
	abi = aapcs32
	runtime = linux_arm
	executable = elf32_arm
	build_tags = [linux, unix, arm]
	capabilities = [hosted, executable, filesystem, heap, argv, environment]
}
