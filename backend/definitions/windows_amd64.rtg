		write_relocation 320 import 5
		write_relocation 331 bss count
	}

	entry template {
		max_parameters = 2
		bss args 32768 16
		bss argsText 32768 16
		bss argsLength 8 8
		bss environment 32768 16
		bss environmentLength 8 8
		code = "\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\xc6\x4c\x8d\x15\x00\x00\x00\x00\x48\x8d\x05\x00\x00\x00\x00\x50\x5a\x4d\x31\xdb\x80\x3e\x00\x0f\x84\x62\x00\x00\x00\x80\x3e\x20\x74\x05\x80\x3e\x09\x75\x05\x48\xff\xc6\xeb\xe8\x49\x89\x12\x31\xc9\x45\x31\xc0\x8a\x06\x3c\x00\x74\x28\x3c\x22\x75\x09\x41\x83\xf0\x01\x48\xff\xc6\xeb\xed\x41\x83\xf8\x00\x75\x08\x3c\x20\x74\x11\x3c\x09\x74\x0d\x88\x02\x48\xff\xc6\x48\xff\xc2\x48\xff\xc1\xeb\xd2\xc6\x02\x00\x48\xff\xc2\x49\x89\x4a\x08\x49\x83\xc2\x10\x49\xff\xc3\x3c\x00\x74\x08\x48\xff\xc6\xe9\x95\xff\xff\xff\x4c\x89\xd8\x48\x89\x05\x00\x00\x00\x00\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\xc6\x4c\x8d\x15\x00\x00\x00\x00\x4d\x31\xdb\x80\x3e\x00\x74\x23\x49\x89\x32\x31\xc9\x80\x3c\x0e\x00\x74\x05\x48\xff\xc1\xeb\xf5\x49\x89\x4a\x08\x48\x01\xce\x48\xff\xc6\x49\x83\xc2\x10\x49\xff\xc3\xeb\xd8\x4c\x89\xd8\x48\x89\x05\x00\x00\x00\x00\x48\x8d\x05\x00\x00\x00\x00\x50\x5f\x48\x8b\x05\x00\x00\x00\x00\x50\x5e\x50\x5a\x48\x8d\x05\x00\x00\x00\x00\x50\x59\x48\x8b\x05\x00\x00\x00\x00\x49\x89\xc0\x49\x89\xc1"
		relocation 6 import 7
		relocation 20 bss args
		relocation 27 bss argsText
		relocation 149 bss argsLength
		relocation 159 import 9
		relocation 173 bss environment
		relocation 226 bss environmentLength
		relocation 233 bss args
		relocation 242 bss argsLength
		relocation 253 bss environment
		relocation 262 bss environmentLength
	}

	entry {
		arguments.source = call GetCommandLineA
		arguments.parse = go windowsCommandLine
		environment.source = call GetEnvironmentStringsA
		environment.parse = nul_terminated_pairs
		result = [slice(arguments), slice(environment)]
	}

	operation open {
		emit = go windowsBuiltinRuntimeOpen
		call = CreateFileA
		arguments = [
			path,
			access(flags),
			share_read | share_write,
			null,
			disposition(flags),
			normal_attributes,
			null
		]
		result = handle_or_error
	}

	operation close {
		emit = go windowsBuiltinRuntimeClose
		call = CloseHandle
		arguments = [fd]
		result = bool_or_error
	}

	operation read {
		call = ReadFile
		arguments = [fd, buffer, count, address(transferred), null]
		result = transferred_or_error
	}

	operation write {
		call = WriteFile
		arguments = [fd, buffer, count, address(transferred), null]
		result = transferred_or_error
	}

	operation read_at {
		sequence = [seek(fd, offset), read(fd, buffer, count)]
	}

	operation write_at {
		sequence = [seek(fd, offset), write(fd, buffer, count)]
	}

	operation seek {
		call = SetFilePointer
		arguments = [fd, low32(offset), address(high32(offset)), begin]
		result = position_or_error
	}

	operation print {
		sequence = [GetStdHandle(stderr), write(result, buffer, count)]
	}

	operation chmod {
		emit = go windowsBuiltinRuntimeChmod
		unsupported = "Win32 target does not expose chmod"
	}

	operation exit {
		call = ExitProcess
		arguments = [status]
		noreturn = true
	}
}

target windows/amd64 {
	family = native_v1
	os = windows
	arch = x86_64
	abi = windows_x86_64
	runtime = win32_x86_64
	executable = pe64_x86_64
	object = coff64_object_x86_64
	subsystem = console
	build_tags = ["windows", "amd64"]
	capabilities = [
		hosted, executable, object, filesystem, heap,
		argv, environment, imports, linkstatic, windows_gui
	]
}
