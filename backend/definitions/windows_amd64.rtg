definition 1
unit native
implements direct_emitter_v1

@import "x86_64.rtg"

go backend {
	func windowsExit(out *RTGEmitter, status RTGRegister) {
		if status.Code != 1 {
			if status.Code >= 8 {
				out.Byte(0x49)
			} else {
				out.Byte(0x48)
			}
			out.Byte(0x89)
			out.AppendByte(0xc1 | (status.Code&7)<<3)
		}
		out.Bytes4(0x48, 0x83, 0xec, 0x28)
		out.Bytes2(0xff, 0x15)
		at := out.Len()
		out.Int32(0)
		out.AbsoluteReloc(at, 8, RTGRelocationImport)
	}

	func windowsLoadRAXFromR10(out *RTGEmitter, offset int) {
		if offset <= 127 {
			out.Bytes4(0x49, 0x8b, 0x42, offset)
			return
		}
		out.Bytes3(0x49, 0x8b, 0x82)
		out.Int32(offset)
	}

	func windowsLoadRAXFromRSP(out *RTGEmitter, offset int) {
		if offset <= 127 {
			out.Bytes4(0x48, 0x8b, 0x44, 0x24)
			out.Byte(offset)
			return
		}
		out.Bytes4(0x48, 0x8b, 0x84, 0x24)
		out.Int32(offset)
	}

	func windowsStoreRAXToRSP(out *RTGEmitter, offset int) {
		if offset <= 127 {
			out.Bytes4(0x48, 0x89, 0x44, 0x24)
			out.Byte(offset)
			return
		}
		out.Bytes4(0x48, 0x89, 0x84, 0x24)
		out.Int32(offset)
	}

	func windowsStoreR10ToRSP(out *RTGEmitter, offset int) {
		if offset <= 127 {
			out.Bytes4(0x4c, 0x89, 0x54, 0x24)
			out.Byte(offset)
			return
		}
		out.Bytes4(0x4c, 0x89, 0x94, 0x24)
		out.Int32(offset)
	}

	func windowsStaticCall(out *RTGEmitter, importID int, wordCount int) {
		if wordCount > 0 {
			out.Byte(0x59)
		}
		if wordCount > 1 {
			out.Byte(0x5a)
		}
		if wordCount > 2 {
			out.Bytes2(0x41, 0x58)
		}
		if wordCount > 3 {
			out.Bytes2(0x41, 0x59)
		}
		stackWords := 0
		if wordCount > 4 {
			stackWords = wordCount - 4
		}
		out.Bytes3(0x49, 0x89, 0xe2)
		out.Bytes4(0x48, 0x83, 0xe4, 0xf0)
		savedRSPOff := 32 + stackWords*8
		allocation := RTGAlignValue(savedRSPOff+8, 16)
		if RTGInt8Fits(allocation) {
			out.Bytes4(0x48, 0x83, 0xec, allocation)
		} else {
			out.Bytes3(0x48, 0x81, 0xec)
			out.Int32(allocation)
		}
		for i := 0; i < stackWords; i++ {
			windowsLoadRAXFromR10(out, i*8)
			windowsStoreRAXToRSP(out, 32+i*8)
		}
		windowsStoreR10ToRSP(out, savedRSPOff)
		out.Bytes2(0xff, 0x15)
		at := out.Len()
		out.Int32(0)
		out.AbsoluteReloc(at, importID, RTGRelocationImport)
		out.Bytes3(0x49, 0x89, 0xc2)
		windowsLoadRAXFromRSP(out, savedRSPOff)
		out.Bytes3(0x48, 0x89, 0xc4)
		if stackWords > 0 {
			adjust := stackWords * 8
			if RTGInt8Fits(adjust) {
				out.Bytes4(0x48, 0x83, 0xc4, adjust)
			} else {
				out.Bytes3(0x48, 0x81, 0xc4)
				out.Int32(adjust)
			}
		}
		out.Bytes3(0x4c, 0x89, 0xd0)
	}

	func windowsConditionalJump(out *RTGEmitter, opcode byte, label RTGLabel) {
		out.Bytes2(0x0f, int(opcode))
		out.Rel32(label)
	}

	func windowsBuiltinRuntimeClose(out *RTGEmitter) {
		failed := out.NewLabel()
		done := out.NewLabel()
		windowsCallImport(out, 2)
		out.Bytes2(0x85, 0xc0)
		windowsConditionalJump(out, 0x84, failed)
		out.Bytes2(0x31, 0xc0)
		out.Byte(0xe9)
		out.Rel32(done)
		out.Mark(failed)
		out.Bytes2(0x6a, -1)
		out.Byte(0x58)
		out.Mark(done)
	}

	func windowsBuiltinRuntimeChmod(out *RTGEmitter) {
		failed := out.NewLabel()
		done := out.NewLabel()
		out.Bytes2(0x31, 0xd2)
		out.Bytes3(0x45, 0x31, 0xc0)
		out.Bytes2(0x41, 0xb9)
		out.Int32(1)
		windowsCallImport(out, 5)
		out.Bytes3(0x83, 0xf8, -1)
		windowsConditionalJump(out, 0x84, failed)
		out.Bytes2(0x31, 0xc0)
		out.Byte(0xe9)
		out.Rel32(done)
		out.Mark(failed)
		out.Bytes2(0x6a, -1)
		out.Byte(0x58)
		out.Mark(done)
	}

	func windowsBuiltinTranslateCreateFileFlags(out *RTGEmitter) {
		notReadWrite := out.NewLabel()
		accessDone := out.NewLabel()
		noCreate := out.NewLabel()
		createDone := out.NewLabel()
		out.Byte(0x68)
		out.Int32(-2147483648)
		out.Byte(0x5a)
		out.Bytes2(0xa8, 2)
		windowsConditionalJump(out, 0x84, notReadWrite)
		out.Byte(0x68)
		out.Int32(-1073741824)
		out.Byte(0x5a)
		out.Byte(0xe9)
		out.Rel32(accessDone)
		out.Mark(notReadWrite)
		out.Bytes2(0xa8, 1)
		windowsConditionalJump(out, 0x84, accessDone)
		out.Byte(0xba)
		out.Int32(0x40000000)
		out.Mark(accessDone)
		out.Bytes2(0x41, 0xba)
		out.Int32(3)
		out.Bytes2(0xa8, 64)
		windowsConditionalJump(out, 0x84, noCreate)
		out.Bytes2(0x41, 0xba)
		out.Int32(4)
		out.Byte(0xa9)
		out.Int32(512)
		windowsConditionalJump(out, 0x84, createDone)
		out.Bytes2(0x41, 0xba)
		out.Int32(2)
		out.Byte(0xe9)
		out.Rel32(createDone)
		out.Mark(noCreate)
		out.Byte(0xa9)
		out.Int32(512)
		windowsConditionalJump(out, 0x84, createDone)
		out.Bytes2(0x41, 0xba)
		out.Int32(5)
		out.Mark(createDone)
		out.Bytes2(0x41, 0xb8)
		out.Int32(3)
		out.Bytes3(0x45, 0x31, 0xc9)
	}

	func windowsBuiltinRuntimeOpen(out *RTGEmitter) {
		out.Bytes3(0x49, 0x89, 0xfb)
		out.Bytes3(0x48, 0x89, 0xf0)
		windowsBuiltinTranslateCreateFileFlags(out)
		out.Bytes3(0x4c, 0x89, 0xd9)
		base := out.Len()
		out.Text("\x41\x54\x49\x89\xe4\x48\x83\xe4\xf0\x48\x83\xec\x40\x44\x89\x54\x24\x20\xc7\x44\x24\x28\x80\x00\x00\x00\x48\xc7\x44\x24\x30\x00\x00\x00\x00\xff\x15\x00\x00\x00\x00\x49\x89\xc3\x4c\x89\xe4\x41\x5c\x4c\x89\xd8")
		out.AbsoluteReloc(base+37, 1, RTGRelocationImport)
	}
}

# Image fields are declared here. Header/section/relocation are generic
# definition-language constructs, not precompiled PE backends.
extend arch x86_64 {
	sequences {
		windowsCallImport(out:emitter, importID:int) {
			let base = out.Len()
			out.Text("\x41\x54\x49\x89\xe4\x48\x83\xe4\xf0\x48\x83\xec\x20\xff\x15\x00\x00\x00\x00\x49\x89\xc3\x4c\x89\xe4\x41\x5c\x4c\x89\xd8")
			out.AbsoluteReloc(base+15, importID, RTGRelocationImport)
		}
		windowsRuntimeChmod(out:emitter) {
			let failed = out.NewLabel()
			let done = out.NewLabel()
			moveImmediate(out, record_register(Code:2, Valid:true), 0)
			moveImmediate(out, record_register(Code:8, Valid:true), 0)
			moveImmediate(out, record_register(Code:9, Valid:true), 1)
			windowsCallImport(out, 5)
			moveImmediate(out, record_register(Code:2, Valid:true), -1)
			encodeRegisterToRM(out, 0x39, record_register(Code:0, Valid:true), record_register(Code:2, Valid:true), 32)
			jumpCondition(out, record_condition(JumpOpcode:0x84), failed)
			moveImmediate(out, record_register(Code:0, Valid:true), 0)
			encodeRelative(out, 0xe9, done)
			out.Mark(failed)
			moveImmediate(out, record_register(Code:0, Valid:true), -1)
			out.Mark(done)
		}
		windowsRuntimeClose(out:emitter) {
			let failed = out.NewLabel()
			let done = out.NewLabel()
			windowsCallImport(out, 2)
			encodeRegisterToRM(out, 0x85, record_register(Code:0, Valid:true), record_register(Code:0, Valid:true), 32)
			jumpCondition(out, record_condition(JumpOpcode:0x84), failed)
			moveImmediate(out, record_register(Code:0, Valid:true), 0)
			encodeRelative(out, 0xe9, done)
			out.Mark(failed)
			moveImmediate(out, record_register(Code:0, Valid:true), -1)
			out.Mark(done)
		}
		windowsRuntimeOpen(out:emitter) {
			encodeRegisterToRM(out, 0x89, record_register(Code:11, Valid:true), record_register(Code:7, Valid:true), 64)
			encodeRegisterToRM(out, 0x89, record_register(Code:0, Valid:true), record_register(Code:6, Valid:true), 64)
			windowsTranslateCreateFileFlags(out)
			encodeRegisterToRM(out, 0x89, record_register(Code:1, Valid:true), record_register(Code:11, Valid:true), 64)
			let base = out.Len()
			out.Text("\x41\x54\x49\x89\xe4\x48\x83\xe4\xf0\x48\x83\xec\x40\x44\x89\x54\x24\x20\xc7\x44\x24\x28\x80\x00\x00\x00\x48\xc7\x44\x24\x30\x00\x00\x00\x00\xff\x15\x00\x00\x00\x00\x49\x89\xc3\x4c\x89\xe4\x41\x5c\x4c\x89\xd8")
			out.AbsoluteReloc(base+37, 1, RTGRelocationImport)
		}
		windowsTranslateCreateFileFlags(out:emitter) {
			let notReadWrite = out.NewLabel()
			let accessDone = out.NewLabel()
			let noCreate = out.NewLabel()
			let createDone = out.NewLabel()
			moveImmediate(out, record_register(Code:2, Valid:true), -2147483648)
			out.Bytes2(0xa8, 2)
			jumpCondition(out, record_condition(JumpOpcode:0x84), notReadWrite)
			moveImmediate(out, record_register(Code:2, Valid:true), -1073741824)
			encodeRelative(out, 0xe9, accessDone)
			out.Mark(notReadWrite)
			out.Bytes2(0xa8, 1)
			jumpCondition(out, record_condition(JumpOpcode:0x84), accessDone)
			moveImmediate(out, record_register(Code:2, Valid:true), 0x40000000)
			out.Mark(accessDone)
			moveImmediate(out, record_register(Code:10, Valid:true), 3)
			out.Bytes2(0xa8, 64)
			jumpCondition(out, record_condition(JumpOpcode:0x84), noCreate)
			moveImmediate(out, record_register(Code:10, Valid:true), 4)
			out.AppendByte(0xa9)
			out.Int32(512)
			jumpCondition(out, record_condition(JumpOpcode:0x84), createDone)
			moveImmediate(out, record_register(Code:10, Valid:true), 2)
			encodeRelative(out, 0xe9, createDone)
			out.Mark(noCreate)
			out.AppendByte(0xa9)
			out.Int32(512)
			jumpCondition(out, record_condition(JumpOpcode:0x84), createDone)
			moveImmediate(out, record_register(Code:10, Valid:true), 5)
			out.Mark(createDone)
			moveImmediate(out, record_register(Code:8, Valid:true), 3)
			moveImmediate(out, record_register(Code:9, Valid:true), 0)
		}
	}
}

format pe64_x86_64 {
	kind = pe
	byte_order = little
	address_bits = 64
	machine = 0x8664
	code_offset = 0x1000
	image = pe_executable
	patch_image = pe_relative32
	image_base = 0x400000
	headers_size = 0x200
	file_alignment = 0x200
	section_alignment = 0x1000
	text_rva = 0x1000
	coff_characteristics = 0x22
	dll_characteristics = 0x100
	os_version_major = 4
	os_version_minor = 0
	image_version_major = 0
	image_version_minor = 0
	subsystem_version_major = 4
	subsystem_version_minor = 0
	stack_reserve = 0x800000
	stack_commit = 0x1000
	heap_reserve = 0x100000
	heap_commit = 0x1000

	dos_header {
		magic = [0x4d, 0x5a]
		pe_offset = 0x80
	}

	coff_header {
		machine = 0x8664
		sections = 2
		optional_header_size = 0xf0
		characteristics = executable | large_address_aware
	}

	optional_header {
		magic = 0x20b
		entry = rva(text.start)
		code_base = rva(text.start)
		image_base = 0x400000
		section_alignment = 0x1000
		file_alignment = 0x200
		subsystem = target.subsystem
		stack_reserve = 8MiB
		stack_commit = 4KiB
		heap_reserve = 1MiB
		directories = [imports.directory, imports.iat]
	}

	section text {
		name = ".text"
		flags = code | execute | read
		virtual = text
		raw_alignment = 0x200
	}

	section data {
		name = ".data"
		flags = initialized_data | read | write
		virtual = data + bss
		raw = data
		raw_alignment = 0x200
	}

	imports {
		thunk_bytes = 8
		library = "KERNEL32.dll"
		names = target.runtime.imports

		descriptor size=20 {
			u32 original_first_thunk = rva(import_lookup_table)
			u32 timestamp = 0
			u32 forwarder_chain = 0
			u32 name = rva(library_name)
			u32 first_thunk = rva(import_address_table)
		}

		import_lookup_table {
			entries names as u64 rva(hint_name(entry))
			terminator = u64 0
		}

		import_address_table {
			entries names as u64 rva(hint_name(entry))
			terminator = u64 0
		}

		hint_name(entry) {
			u16 0
			ascii entry
			u8 0
			align 2
		}

		library_name {
			ascii library
			u8 0
		}

		directory.rva = rva(descriptor)
		directory.size = sizeof(descriptor)
		iat.rva = rva(import_address_table)
		iat.size = sizeof(import_address_table)
	}

	relocation import = rel32 from instruction_end to imports.iat_entry
	relocation data = rel32 from instruction_end to data
	relocation bss = rel32 from instruction_end to bss
}

format coff64_object_x86_64 {
	kind = coff
	byte_order = little
	address_bits = 64
	machine = 0x8664
	sections = [text, data, bss]
	symbol_table entry_size=18 {
		name = inline_8_or_string_offset
		value = section_offset
		section = section_index
		type = symbol_type
		storage_class = symbol_visibility
		auxiliaries = 0
	}

	string_table {
		u32 size
		entries long_symbol_names {
			ascii long_symbol_name
			u8 0
		}
	}

	relocation label { number = 0x0004 kind = rel32 addend = -4 }
	relocation data { number = 0x0004 kind = rel32 addend = -4 }
	relocation bss { number = 0x0004 kind = rel32 addend = -4 }
	relocation abs64 { number = 0x0001 kind = absolute width = 64 }
}

abi windows_x86_64 {
	internal = renvo_x86_64
	arguments = [rcx, rdx, r8, r9]
	result = [rax, rdx]
	caller_saved = [rax, rcx, rdx, r8, r9, r10, r11]
	callee_saved = [rbx, rbp, rdi, rsi, r12, r13, r14, r15]
	stack_alignment = 16
	shadow_space = 32
	stack_probe {
		page_bytes = 4096
		direction = down
		touch_each_page = true
	}
}

runtime win32_x86_64 {
	emit_exit = go windowsExit
	emit_static_call = go windowsStaticCall

	imports "kernel32.dll" = [
		CreateFileA,
		CloseHandle,
		ReadFile,
		WriteFile,
		SetFilePointer,
		GetStdHandle,
		GetCommandLineA,
		ExitProcess,
		GetEnvironmentStringsA
	]

	io_template {
		bss count 8 8
		bss position 8 8
		read_code = "\x57\x56\x52\x51\x48\x83\x7c\x24\x18\x00\x74\x02\xeb\x18\xb9\xf6\xff\xff\xff\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\x44\x24\x18\x48\x83\x3c\x24\x00\x0f\x8c\x80\x00\x00\x00\x48\x8b\x4c\x24\x18\x31\xd2\x45\x31\xc0\x41\xb9\x01\x00\x00\x00\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\x05\x00\x00\x00\x00\x48\x8b\x4c\x24\x18\x48\x8b\x14\x24\x45\x31\xc0\x45\x31\xc9\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x8b\x4c\x24\x18\x48\x8b\x54\x24\x10\x4c\x8b\x44\x24\x08\x48\x8d\x05\x00\x00\x00\x00\x49\x89\xc1\x48\x83\xec\x28\x48\xc7\x44\x24\x20\x00\x00\x00\x00\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x83\xf8\x00\x74\x52\x48\x8b\x05\x00\x00\x00\x00\xeb\x4c\x48\x8b\x4c\x24\x18\x48\x8b\x54\x24\x10\x4c\x8b\x44\x24\x08\x48\x8d\x05\x00\x00\x00\x00\x49\x89\xc1\x48\x83\xec\x28\x48\xc7\x44\x24\x20\x00\x00\x00\x00\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x83\xf8\x00\x74\x0c\x48\x8b\x05\x00\x00\x00\x00\x48\x83\xc4\x20\xc3\x6a\xff\x58\x48\x83\xc4\x20\xc3\x6a\xff\x58\x48\x89\x05\x00\x00\x00\x00\x48\x8b\x4c\x24\x18\x48\x8b\x05\x00\x00\x00\x00\x50\x5a\x45\x31\xc0\x45\x31\xc9\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x8b\x05\x00\x00\x00\x00\x48\x83\xc4\x20\xc3"
		write_code = "\x57\x56\x52\x51\x48\x83\x7c\x24\x18\x01\x74\x0a\x48\x83\x7c\x24\x18\x02\x74\x1c\xeb\x32\xb9\xf5\xff\xff\xff\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\x44\x24\x18\xeb\x18\xb9\xf4\xff\xff\xff\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\x44\x24\x18\x48\x83\x3c\x24\x00\x0f\x8c\x80\x00\x00\x00\x48\x8b\x4c\x24\x18\x31\xd2\x45\x31\xc0\x41\xb9\x01\x00\x00\x00\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\x05\x00\x00\x00\x00\x48\x8b\x4c\x24\x18\x48\x8b\x14\x24\x45\x31\xc0\x45\x31\xc9\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x8b\x4c\x24\x18\x48\x8b\x54\x24\x10\x4c\x8b\x44\x24\x08\x48\x8d\x05\x00\x00\x00\x00\x49\x89\xc1\x48\x83\xec\x28\x48\xc7\x44\x24\x20\x00\x00\x00\x00\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x83\xf8\x00\x74\x52\x48\x8b\x05\x00\x00\x00\x00\xeb\x4c\x48\x8b\x4c\x24\x18\x48\x8b\x54\x24\x10\x4c\x8b\x44\x24\x08\x48\x8d\x05\x00\x00\x00\x00\x49\x89\xc1\x48\x83\xec\x28\x48\xc7\x44\x24\x20\x00\x00\x00\x00\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x83\xf8\x00\x74\x0c\x48\x8b\x05\x00\x00\x00\x00\x48\x83\xc4\x20\xc3\x6a\xff\x58\x48\x83\xc4\x20\xc3\x6a\xff\x58\x48\x89\x05\x00\x00\x00\x00\x48\x8b\x4c\x24\x18\x48\x8b\x05\x00\x00\x00\x00\x50\x5a\x45\x31\xc0\x45\x31\xc9\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x8b\x05\x00\x00\x00\x00\x48\x83\xc4\x20\xc3"
		read_relocation 25 import 6
		read_relocation 71 import 5
		read_relocation 82 bss position
		read_relocation 107 import 5
		read_relocation 133 bss count
		read_relocation 155 import 3
		read_relocation 171 bss count
		read_relocation 195 bss count
