		read_relocation 286 import 5
		read_relocation 297 bss count
		write_relocation 33 import 6
		write_relocation 59 import 6
		write_relocation 105 import 5
		write_relocation 116 bss position
		write_relocation 141 import 5
		write_relocation 167 bss count
		write_relocation 189 import 4
