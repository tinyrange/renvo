func renvoAarch64AsmCmpRegImm(a *renvoAsm, reg int, imm int) {
	if imm >= 0 && imm <= 4095 {
		renvoAarch64AsmEmit(a, 0xf100001f|(imm<<10)|(reg<<5))
		return
	}
	renvoAarch64AsmMovRegImm(a, renvoAarch64RegTmp, imm)
	renvoAarch64AsmCmpRegReg(a, reg, renvoAarch64RegTmp)
}

