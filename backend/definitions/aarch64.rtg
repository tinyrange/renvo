		renvoAarch64AsmJzLabel = go renvoAarch64AsmJzLabel
		renvoAarch64AsmJnzLabel = go renvoAarch64AsmJnzLabel
	}

	relocation branch26 {
		width = 4
		signed = true
		scale = 4
		bits = 26
		relative_to = instruction
	}

	relocation branch19 {
		width = 4
		signed = true
		scale = 4
		bits = 19
		relative_to = instruction
	}

	relocation address21 {
		width = 4
		signed = true
		scale = 1
		bits = 21
		relative_to = instruction
	}
}

abi aapcs64 {
	arch = aarch64
	frame_start = go aarch64FrameStart
	frame_finish = go aarch64FrameFinish
	arguments = [x0, x1, x2, x3, x4, x5, x6, x7]
	result = [x0, x1]
	stack_alignment = 16
}

abi windows_arm64 {
	arch = aarch64
	frame_start = go aarch64FrameStart
	frame_finish = go aarch64FrameFinish
	arguments = [x0, x1, x2, x3, x4, x5, x6, x7]
	result = [x0, x1]
	stack_alignment = 16
}

runtime linux_aarch64 {
	emit_entry = go aarch64LinuxEntry

	syscall {
		number = x8
		arguments = [x0, x1, x2, x3, x4, x5]
		result = x0
		instruction = svc
	}
	operation read { number = 63 args = [fd, buffer, count] }
	operation write { number = 64 args = [fd, buffer, count] }
	operation read_at { number = 67 args = [fd, buffer, count, offset] }
	operation write_at { number = 68 args = [fd, buffer, count, offset] }
	operation open { number = 56 args = [dirfd, path, flags, mode] }
	operation close { number = 57 args = [fd] }
	operation chmod { number = 52 args = [fd, mode] }
	operation print { use = write args = [stderr, buffer, count] }
	operation exit { number = 93 args = [status] noreturn = true }
}

runtime darwin_arm64 {
		entry_state_bytes = 24
		emit_entry_start = go aarch64DarwinEntryStart
		emit_entry = go aarch64DarwinEntry
		emit_exit = go aarch64DarwinExit
	emit_operation = go aarch64DarwinRuntimeOperation
	operations = [print, open, close, read, write, read_at, write_at, chmod]
}

runtime windows_arm64 {
	emit_entry = go aarch64WindowsEntry
	emit_exit = go aarch64WindowsExit
	emit_static_call = go aarch64WindowsStaticCall
	emit_operation = go aarch64WindowsRuntimeOperation
	operations = [print, open, close, read, write, read_at, write_at, chmod]
}

format elf64_aarch64 {
	byte_order = little
	address_bits = 64
	kind = elf
	machine = 183
	code_offset = 176
	image = go aarch64ELF64Image
}

format macho64_arm64 {
	byte_order = little
	address_bits = 64
	kind = "mach-o"
	cpu = 0x0100000c
	code_offset = 0x1000
	image = go aarch64MachImage
}

format pe64_arm64 {
	byte_order = little
	address_bits = 64
	kind = pe
	machine = 0xaa64
	code_offset = 0x1000
	image = go aarch64PE64Image
}

target linux/aarch64 {
	os = linux
	arch = aarch64
	abi = aapcs64
	runtime = linux_aarch64
	executable = elf64_aarch64
	build_tags = [linux, unix, aarch64, arm64]
	capabilities = [hosted, executable, filesystem, heap, argv, environment]
}

target darwin/arm64 {
	os = darwin
	arch = aarch64
	abi = aapcs64
	runtime = darwin_arm64
	executable = macho64_arm64
	build_tags = [darwin, unix, aarch64, arm64]
	capabilities = [hosted, executable, filesystem, heap, argv, environment]
}

target windows/arm64 {
	os = windows
	arch = aarch64
	abi = windows_arm64
	runtime = windows_arm64
	executable = pe64_arm64
	build_tags = [windows, aarch64, arm64]
	capabilities = [hosted, executable, filesystem, heap, argv, environment, windows_gui]
}
