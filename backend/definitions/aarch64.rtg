definition 1
unit aarch64
implements direct_emitter_v1

# This closed definition owns the complete AArch64 direct-emitter encoder and
# every advertised AArch64 target composition. The explicit exports are the
# stable production contract used by target-neutral lowering.
go backend {
	func renvoAarch64AsmEmit(a *RTGEmitter, insn int) {
		RTGUint32(a, insn)
	}

	func renvoAarch64AsmAlign(a *RTGEmitter) {
		for a.Len()%4 != 0 {
			RTGByte(a, 0)
		}
	}

	func renvoAarch64AsmMovRegReg(a *RTGEmitter, dst int, src int) {
		if dst == src {
			return
		}
		renvoAarch64AsmEmit(a, 0xaa0003e0|(src<<16)|dst)
	}

	func renvoAarch64AsmMovRegImm(a *RTGEmitter, reg int, imm int) {
		if imm < 0 {
			inv := -imm - 1
			part := inv & 65535
			renvoAarch64AsmEmit(a, 0x92800000|(part<<5)|reg)
			for i := 1; i < 4; i++ {
				targetPart := (imm >> (i * 16)) & 65535
				if targetPart != 65535 {
					renvoAarch64AsmEmit(a, 0xf2800000|(i<<21)|(targetPart<<5)|reg)
				}
			}
			return
		}
		part := imm & 65535
		renvoAarch64AsmEmit(a, 0xd2800000|(part<<5)|reg)
		for i := 1; i < 4; i++ {
			part = (imm >> (i * 16)) & 65535
			if part != 0 {
				renvoAarch64AsmEmit(a, 0xf2800000|(i<<21)|(part<<5)|reg)
			}
		}
	}

	func renvoAarch64AsmPatchMovRegImmAt(a *RTGEmitter, at int, reg int, imm int) {
		part := imm & 65535
		a.PatchUint32( at, 0xd2800000|(part<<5)|reg)
		for i := 1; i < 4; i++ {
			part = (imm >> (i * 16)) & 65535
			a.PatchUint32( at+i*4, 0xf2800000|(i<<21)|(part<<5)|reg)
		}
	}

	func renvoAarch64AsmMovRegAbs(a *RTGEmitter, reg int, off int, kind int) {
		at := a.Len()
		renvoAarch64AsmMovRegImm(a, reg, 0)
		renvoAarch64AsmEmit(a, 0xf2800000|(1<<21)|reg)
		renvoAarch64AsmEmit(a, 0xf2800000|(2<<21)|reg)
		renvoAarch64AsmEmit(a, 0xf2800000|(3<<21)|reg)
		a.AbsoluteReloc( at, off, kind)
	}

	func renvoAarch64AsmAddRegImm(a *RTGEmitter, dst int, src int, imm int) {
		if imm == 0 {
			renvoAarch64AsmMovRegReg(a, dst, src)
			return
		}
		op := 0x91000000
		if imm < 0 {
			op = 0xd1000000
			imm = -imm
		}
		cur := src
		for imm > 0 {
			shift := 0
			chunk := imm
			if chunk > 4095 {
				chunk = imm / 4096
				if chunk > 4095 {
					chunk = 4095
				}
				shift = 1
				imm = imm - chunk*4096
			} else {
				imm = 0
			}
			renvoAarch64AsmEmit(a, op|(shift<<22)|(chunk<<10)|(cur<<5)|dst)
			cur = dst
		}
	}

	func renvoAarch64AsmAddRegReg(a *RTGEmitter, dst int, left int, right int) {
		renvoAarch64AsmEmit(a, 0x8b000000|(right<<16)|(left<<5)|dst)
	}

	func renvoAarch64AsmSubRegReg(a *RTGEmitter, dst int, left int, right int) {
		renvoAarch64AsmEmit(a, 0xcb000000|(right<<16)|(left<<5)|dst)
	}

	func renvoAarch64AsmAddRegRegShift(a *RTGEmitter, dst int, left int, right int, shift int) {
		renvoAarch64AsmEmit(a, 0x8b000000|(right<<16)|(shift<<10)|(left<<5)|dst)
	}

	func renvoAarch64AsmMulRegReg(a *RTGEmitter, dst int, left int, right int) {
		renvoAarch64AsmEmit(a, 0x9b007c00|(right<<16)|(left<<5)|dst)
	}

	func renvoAarch64AsmAddr(a *RTGEmitter, base int, disp int) int {
		if disp == 0 {
			return base
		}
		renvoAarch64AsmAddRegImm(a, aarch64Address.Code, base, disp)
		return aarch64Address.Code
	}

	func renvoAarch64AsmLoadRegMem(a *RTGEmitter, dst int, base int, disp int, size int) {
		if disp != 0 && disp >= -256 && disp <= 255 {
			imm := (disp & 511) << 12
			if size == 1 {
				renvoAarch64AsmEmit(a, 0x38400000|imm|(base<<5)|dst)
				return
			}
			if size == 2 {
				renvoAarch64AsmEmit(a, 0x78400000|imm|(base<<5)|dst)
				return
			}
			if size == 4 {
				renvoAarch64AsmEmit(a, 0xb8400000|imm|(base<<5)|dst)
				return
			}
			renvoAarch64AsmEmit(a, 0xf8400000|imm|(base<<5)|dst)
			return
		}
		addr := renvoAarch64AsmAddr(a, base, disp)
		if size == 1 {
			renvoAarch64AsmEmit(a, 0x39400000|(addr<<5)|dst)
			return
		}
		if size == 2 {
			renvoAarch64AsmEmit(a, 0x79800000|(addr<<5)|dst)
			return
		}
		if size == 4 {
			renvoAarch64AsmEmit(a, 0xb9800000|(addr<<5)|dst)
			return
		}
		renvoAarch64AsmEmit(a, 0xf9400000|(addr<<5)|dst)
	}

	func renvoAarch64AsmStoreRegMem(a *RTGEmitter, src int, base int, disp int, size int) {
		if disp != 0 && disp >= -256 && disp <= 255 {
			imm := (disp & 511) << 12
			if size == 1 {
				renvoAarch64AsmEmit(a, 0x38000000|imm|(base<<5)|src)
				return
			}
			if size == 2 {
				renvoAarch64AsmEmit(a, 0x78000000|imm|(base<<5)|src)
				return
			}
			if size == 4 {
				renvoAarch64AsmEmit(a, 0xb8000000|imm|(base<<5)|src)
				return
			}
			renvoAarch64AsmEmit(a, 0xf8000000|imm|(base<<5)|src)
			return
		}
		addr := renvoAarch64AsmAddr(a, base, disp)
		if size == 1 {
			renvoAarch64AsmEmit(a, 0x39000000|(addr<<5)|src)
			return
		}
		if size == 2 {
			renvoAarch64AsmEmit(a, 0x79000000|(addr<<5)|src)
			return
		}
		if size == 4 {
			renvoAarch64AsmEmit(a, 0xb9000000|(addr<<5)|src)
			return
		}
		renvoAarch64AsmEmit(a, 0xf9000000|(addr<<5)|src)
	}

	func renvoAarch64AsmLoadRegStack(a *RTGEmitter, dst int, offset int) {
		renvoAarch64AsmLoadRegMem(a, dst, aarch64Frame.Code, -offset, 8)
	}

	func renvoAarch64AsmStoreRegStack(a *RTGEmitter, src int, offset int) {
		renvoAarch64AsmStoreRegMem(a, src, aarch64Frame.Code, -offset, 8)
	}

	func renvoAarch64AsmLeaRegStack(a *RTGEmitter, dst int, offset int) {
		renvoAarch64AsmAddRegImm(a, dst, aarch64Frame.Code, -offset)
	}

	func renvoAarch64AsmPushReg(a *RTGEmitter, reg int) {
		renvoAarch64AsmEmit(a, 0xf81f0fe0|reg)
	}

	func renvoAarch64AsmPopReg(a *RTGEmitter, reg int) {
		renvoAarch64AsmEmit(a, 0xf84107e0|reg)
	}

	func renvoAarch64AsmMovRaxImm(a *RTGEmitter, imm int) {
		renvoAarch64AsmMovRegImm(a, aarch64Primary.Code, imm)
	}

	func renvoAarch64AsmMovRaxImm64(a *RTGEmitter, imm int) {
		renvoAarch64AsmMovRaxImm(a, imm)
	}

	func renvoAarch64AsmMovRdxImm(a *RTGEmitter, imm int) {
		renvoAarch64AsmMovRegImm(a, aarch64Secondary.Code, imm)
	}

	func renvoAarch64AsmMovRaxDataAddr(a *RTGEmitter, dataOff int) {
		renvoAarch64AsmMovRegAbs(a, aarch64Primary.Code, dataOff, 0)
	}

	func renvoAarch64AsmMovRaxBssAddr(a *RTGEmitter, bssOff int) {
		renvoAarch64AsmMovRegAbs(a, aarch64Primary.Code, bssOff, RTGRelocationAbsoluteBSS)
	}

	func renvoAarch64AsmMovR10BssAddr(a *RTGEmitter, bssOff int) {
		renvoAarch64AsmMovRegAbs(a, aarch64X7.Code, bssOff, RTGRelocationAbsoluteBSS)
	}

	func renvoAarch64AsmLoadRaxBss(a *RTGEmitter, bssOff int) {
		renvoAarch64AsmMovRegAbs(a, aarch64Address.Code, bssOff, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmLoadRegMem(a, aarch64Primary.Code, aarch64Address.Code, 0, 8)
	}

	func renvoAarch64AsmStoreRaxBss(a *RTGEmitter, bssOff int) {
		renvoAarch64AsmMovRegAbs(a, aarch64Address.Code, bssOff, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmStoreRegMem(a, aarch64Primary.Code, aarch64Address.Code, 0, 8)
	}

	func renvoAarch64AsmMovRdiRax(a *RTGEmitter) {
		renvoAarch64AsmMovRegReg(a, aarch64X3.Code, aarch64Primary.Code)
	}

	func renvoAarch64AsmMovRaxRdx(a *RTGEmitter) {
		renvoAarch64AsmMovRegReg(a, aarch64Primary.Code, aarch64Secondary.Code)
	}

	func renvoAarch64AsmMovRdxRax(a *RTGEmitter) {
		renvoAarch64AsmMovRegReg(a, aarch64Secondary.Code, aarch64Primary.Code)
	}

	func renvoAarch64AsmMovRcxRax(a *RTGEmitter) {
		renvoAarch64AsmMovRegReg(a, aarch64Tertiary.Code, aarch64Primary.Code)
	}

	func renvoAarch64AsmMovRcxRdx(a *RTGEmitter) {
		renvoAarch64AsmMovRegReg(a, aarch64Tertiary.Code, aarch64Secondary.Code)
	}

	func renvoAarch64AsmMovRsiRax(a *RTGEmitter) {
		renvoAarch64AsmMovRegReg(a, aarch64X4.Code, aarch64Primary.Code)
	}

	func renvoAarch64AsmMovR8Rax(a *RTGEmitter) {
		renvoAarch64AsmMovRegReg(a, aarch64X5.Code, aarch64Primary.Code)
	}

	func renvoAarch64AsmMovR9Rax(a *RTGEmitter) {
		renvoAarch64AsmMovRegReg(a, aarch64X6.Code, aarch64Primary.Code)
	}

	func renvoAarch64AsmAddRdxRcx(a *RTGEmitter) {
		renvoAarch64AsmAddRegReg(a, aarch64Secondary.Code, aarch64Secondary.Code, aarch64Tertiary.Code)
	}

	func renvoAarch64AsmSyscall(a *RTGEmitter) {
		renvoAarch64AsmMovRegReg(a, aarch64System.Code, aarch64Primary.Code)
		renvoAarch64AsmMovRegReg(a, aarch64Scratch.Code, aarch64Secondary.Code)
		renvoAarch64AsmMovRegReg(a, 0, aarch64X3.Code)
		renvoAarch64AsmMovRegReg(a, 1, aarch64X4.Code)
		renvoAarch64AsmMovRegReg(a, 2, aarch64Scratch.Code)
		renvoAarch64AsmMovRegReg(a, 3, aarch64X7.Code)
		renvoAarch64AsmEmit(a, 0xd4000001)
	}

	func renvoAarch64AsmPopRdi(a *RTGEmitter) {
		renvoAarch64AsmPopReg(a, aarch64X3.Code)
	}

	func renvoAarch64AsmPopRsi(a *RTGEmitter) {
		renvoAarch64AsmPopReg(a, aarch64X4.Code)
	}

	func renvoAarch64AsmStackMem(a *RTGEmitter, offset int, base int, disp8 int, disp32 int) {
		if base == 0x8948 && disp8 == 0x45 {
			renvoAarch64AsmStoreRegStack(a, aarch64Primary.Code, offset)
			return
		}
		if base == 0x8948 && disp8 == 0x55 {
			renvoAarch64AsmStoreRegStack(a, aarch64Secondary.Code, offset)
			return
		}
		if base == 0x8948 && disp8 == 0x4d {
			renvoAarch64AsmStoreRegStack(a, aarch64Tertiary.Code, offset)
			return
		}
		if base == 0x8b48 && disp8 == 0x45 {
			renvoAarch64AsmLoadRegStack(a, aarch64Primary.Code, offset)
			return
		}
		if base == 0x8b48 && disp8 == 0x55 {
			renvoAarch64AsmLoadRegStack(a, aarch64Secondary.Code, offset)
			return
		}
		if base == 0x8b48 && disp8 == 0x4d {
			renvoAarch64AsmLoadRegStack(a, aarch64Tertiary.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x45 {
			renvoAarch64AsmLeaRegStack(a, aarch64Primary.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x55 {
			renvoAarch64AsmLeaRegStack(a, aarch64Secondary.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x7d {
			renvoAarch64AsmLeaRegStack(a, aarch64X3.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x75 {
			renvoAarch64AsmLeaRegStack(a, aarch64X4.Code, offset)
			return
		}
	}

	func renvoAarch64AsmAddRdxImm(a *RTGEmitter, imm int) {
		renvoAarch64AsmAddRegImm(a, aarch64Secondary.Code, aarch64Secondary.Code, imm)
	}

	func renvoAarch64AsmMemDisp(a *RTGEmitter, disp int, op int, disp8 int, disp32 int) {
		if op == 0x8b48 && disp8 == 0x4a {
			renvoAarch64AsmLoadRegMem(a, aarch64Tertiary.Code, aarch64Secondary.Code, disp, 8)
			return
		}
		if op == 0x8b48 && disp8 == 0x52 {
			renvoAarch64AsmLoadRegMem(a, aarch64Secondary.Code, aarch64Secondary.Code, disp, 8)
			return
		}
	}

	func renvoAarch64AsmLoadQwordRaxIndexRcx8(a *RTGEmitter) {
		renvoAarch64AsmAddRegRegShift(a, aarch64Address.Code, aarch64Primary.Code, aarch64Tertiary.Code, 3)
		renvoAarch64AsmLoadRegMem(a, aarch64Primary.Code, aarch64Address.Code, 0, 8)
	}

	func renvoAarch64AsmLoadQwordRaxIndexRcxDisp(a *RTGEmitter, disp int) {
		renvoAarch64AsmAddRegReg(a, aarch64Address.Code, aarch64Primary.Code, aarch64Tertiary.Code)
		renvoAarch64AsmLoadRegMem(a, aarch64Primary.Code, aarch64Address.Code, disp, 8)
	}

	func renvoAarch64AsmLoadRaxMemRdxDisp(a *RTGEmitter, disp int) {
		renvoAarch64AsmLoadRegMem(a, aarch64Primary.Code, aarch64Secondary.Code, disp, 8)
	}

	func renvoAarch64AsmLoadRaxMemRdxDispSize(a *RTGEmitter, disp int, size int) {
		renvoAarch64AsmLoadRegMem(a, aarch64Primary.Code, aarch64Secondary.Code, disp, size)
	}

	func renvoAarch64AsmLoadByteRaxIndexRcx(a *RTGEmitter) {
		renvoAarch64AsmAddRegRegShift(a, aarch64Address.Code, aarch64Primary.Code, aarch64Tertiary.Code, 0)
		renvoAarch64AsmLoadRegMem(a, aarch64Primary.Code, aarch64Address.Code, 0, 1)
	}

	func renvoAarch64AsmLoadRaxIndexRcxSize(a *RTGEmitter, size int) {
		shift := 3
		if size == 1 {
			shift = 0
		}
		if size == 2 {
			shift = 1
		}
		if size == 4 {
			shift = 2
		}
		renvoAarch64AsmAddRegRegShift(a, aarch64Address.Code, aarch64Primary.Code, aarch64Tertiary.Code, shift)
		renvoAarch64AsmLoadRegMem(a, aarch64Primary.Code, aarch64Address.Code, 0, size)
	}

	func renvoAarch64AsmStoreRaxMemRdxRcx8(a *RTGEmitter) {
		renvoAarch64AsmAddRegRegShift(a, aarch64Address.Code, aarch64Secondary.Code, aarch64Tertiary.Code, 3)
		renvoAarch64AsmStoreRegMem(a, aarch64Primary.Code, aarch64Address.Code, 0, 8)
	}

	func renvoAarch64AsmStoreRaxMemRdxDisp(a *RTGEmitter, disp int) {
		renvoAarch64AsmStoreRegMem(a, aarch64Primary.Code, aarch64Secondary.Code, disp, 8)
	}

	func renvoAarch64AsmStoreRaxMemRdxDispSize(a *RTGEmitter, disp int, size int) {
		renvoAarch64AsmStoreRegMem(a, aarch64Primary.Code, aarch64Secondary.Code, disp, size)
	}

	func renvoAarch64AsmNormalizeRaxForKind(a *RTGEmitter, kind int) {
		if kind == RTGScalarByte {
			renvoAarch64AsmEmit(a, 0x92401c00)
			return
		}
		if kind == RTGScalarInt8 {
			renvoAarch64AsmEmit(a, 0x93401c00)
			return
		}
		if kind == RTGScalarInt16 {
			renvoAarch64AsmEmit(a, 0x93403c00)
			return
		}
		if kind == RTGScalarUint16 {
			renvoAarch64AsmEmit(a, 0x92403c00)
			return
		}
		if kind == RTGScalarInt32 {
			renvoAarch64AsmEmit(a, 0x93407c00)
			return
		}
		if kind == RTGScalarUint32 {
			renvoAarch64AsmEmit(a, 0x92407c00)
		}
	}

	func renvoAarch64AsmIncMemRdx(a *RTGEmitter) {
		renvoAarch64AsmLoadRegMem(a, aarch64Scratch.Code, aarch64Secondary.Code, 0, 8)
		renvoAarch64AsmAddRegImm(a, aarch64Scratch.Code, aarch64Scratch.Code, 1)
		renvoAarch64AsmStoreRegMem(a, aarch64Scratch.Code, aarch64Secondary.Code, 0, 8)
	}

	func renvoAarch64AsmDecMemRdx(a *RTGEmitter) {
		renvoAarch64AsmLoadRegMem(a, aarch64Scratch.Code, aarch64Secondary.Code, 0, 8)
		renvoAarch64AsmAddRegImm(a, aarch64Scratch.Code, aarch64Scratch.Code, -1)
		renvoAarch64AsmStoreRegMem(a, aarch64Scratch.Code, aarch64Secondary.Code, 0, 8)
	}

	func renvoAarch64AsmBoolNotRax(a *RTGEmitter) {
		renvoAarch64AsmCmpRaxImm8(a, 0)
		renvoAarch64AsmCsetRax(a, 0)
	}

	func renvoAarch64AsmNegRax(a *RTGEmitter) {
		renvoAarch64AsmSubRegReg(a, aarch64Primary.Code, aarch64Zero.Code, aarch64Primary.Code)
	}

	func renvoAarch64AsmCmpRaxImm8(a *RTGEmitter, imm int) {
		renvoAarch64AsmCmpRegImm(a, aarch64Primary.Code, imm)
	}

	func renvoAarch64AsmCmpRegImm(a *RTGEmitter, reg int, imm int) {
		if imm >= 0 && imm <= 4095 {
			renvoAarch64AsmEmit(a, 0xf100001f|(imm<<10)|(reg<<5))
			return
		}
		renvoAarch64AsmMovRegImm(a, aarch64Scratch.Code, imm)
		renvoAarch64AsmCmpRegReg(a, reg, aarch64Scratch.Code)
	}

	func renvoAarch64AsmCmpRegReg(a *RTGEmitter, left int, right int) {
		renvoAarch64AsmEmit(a, 0xeb00001f|(right<<16)|(left<<5))
	}

	func renvoAarch64AsmCsetRax(a *RTGEmitter, cond int) {
		renvoAarch64AsmEmit(a, 0x9a9f07e0|((cond^1)<<12))
	}

	func renvoAarch64AsmAddRaxRcx(a *RTGEmitter) {
		renvoAarch64AsmAddRegReg(a, aarch64Primary.Code, aarch64Primary.Code, aarch64Tertiary.Code)
	}

	func renvoAarch64AsmSubRaxRcx(a *RTGEmitter) {
		renvoAarch64AsmSubRegReg(a, aarch64Primary.Code, aarch64Primary.Code, aarch64Tertiary.Code)
	}

	func renvoAarch64AsmShlRcxImm(a *RTGEmitter, imm int) {
		renvoAarch64AsmEmit(a, 0xd3400000|((64-imm)<<16)|((63-imm)<<10)|(aarch64Tertiary.Code<<5)|aarch64Tertiary.Code)
	}

	func renvoAarch64AsmShlRaxImm(a *RTGEmitter, imm int) {
		renvoAarch64AsmEmit(a, 0xd3400000|((64-imm)<<16)|((63-imm)<<10))
	}

	func renvoAarch64AsmSarRaxImm(a *RTGEmitter, imm int) {
		renvoAarch64AsmEmit(a, 0x9340fc00|(imm<<16))
	}

	func renvoAarch64AsmDivLeftRcxRightRax(a *RTGEmitter, mod bool) {
		renvoAarch64AsmMovRegReg(a, aarch64Scratch.Code, aarch64Primary.Code)
		renvoAarch64AsmEmit(a, 0x9ac00c40)
		if mod {
			renvoAarch64AsmEmit(a, 0x9b098800)
		}
	}

	func renvoAarch64CondFromSetcc(setcc int) int {
		if setcc == 0x94 {
			return 0
		}
		if setcc == 0x95 {
			return 1
		}
		if setcc == 0x92 {
			return 3
		}
		if setcc == 0x93 {
			return 2
		}
		if setcc == 0x96 {
			return 9
		}
		if setcc == 0x97 {
			return 8
		}
		if setcc == 0x9c {
			return 11
		}
		if setcc == 0x9e {
			return 13
		}
		if setcc == 0x9f {
			return 12
		}
		return 10
	}

	func renvoAarch64AsmCmpRcxRaxSet(a *RTGEmitter, setcc int) {
		renvoAarch64AsmCmpRegReg(a, aarch64Tertiary.Code, aarch64Primary.Code)
		cond := renvoAarch64CondFromSetcc(setcc)
		renvoAarch64AsmCsetRax(a, cond)
	}

	func renvoAarch64AsmPushRax(a *RTGEmitter) {
		renvoAarch64AsmPushReg(a, aarch64Primary.Code)
	}

	func renvoAarch64AsmPushRcx(a *RTGEmitter) {
		renvoAarch64AsmPushReg(a, aarch64Tertiary.Code)
	}

	func renvoAarch64AsmPushRdx(a *RTGEmitter) {
		renvoAarch64AsmPushReg(a, aarch64Secondary.Code)
	}

	func renvoAarch64AsmPopRax(a *RTGEmitter) {
		renvoAarch64AsmPopReg(a, aarch64Primary.Code)
	}

	func renvoAarch64AsmPopRcx(a *RTGEmitter) {
		renvoAarch64AsmPopReg(a, aarch64Tertiary.Code)
	}

	func renvoAarch64AsmPopRdx(a *RTGEmitter) {
		renvoAarch64AsmPopReg(a, aarch64Secondary.Code)
	}

	func renvoAarch64AsmPushImm(a *RTGEmitter, imm int) {
		renvoAarch64AsmMovRegImm(a, aarch64Scratch.Code, imm)
		renvoAarch64AsmPushReg(a, aarch64Scratch.Code)
	}

	func renvoAarch64AsmStoreSliceStack(a *RTGEmitter, offset int) {
		renvoAarch64AsmStoreRegStack(a, aarch64Primary.Code, offset)
		renvoAarch64AsmStoreRegStack(a, aarch64Secondary.Code, offset-8)
		renvoAarch64AsmStoreRegStack(a, aarch64Tertiary.Code, offset-16)
	}

	func renvoAarch64AsmStoreAlMemRdxRcx1(a *RTGEmitter) {
		renvoAarch64AsmAddRegRegShift(a, aarch64Address.Code, aarch64Secondary.Code, aarch64Tertiary.Code, 0)
		renvoAarch64AsmStoreRegMem(a, aarch64Primary.Code, aarch64Address.Code, 0, 1)
	}

	func renvoAarch64AsmStoreRaxMemRdxRcxSize(a *RTGEmitter, size int) {
		shift := 3
		if size == 1 {
			shift = 0
		}
		if size == 2 {
			shift = 1
		}
		if size == 4 {
			shift = 2
		}
		renvoAarch64AsmAddRegRegShift(a, aarch64Address.Code, aarch64Secondary.Code, aarch64Tertiary.Code, shift)
		renvoAarch64AsmStoreRegMem(a, aarch64Primary.Code, aarch64Address.Code, 0, size)
	}

	func renvoAarch64AsmIncRcx(a *RTGEmitter) {
		renvoAarch64AsmAddRegImm(a, aarch64Tertiary.Code, aarch64Tertiary.Code, 1)
	}

	func renvoAarch64AsmIncRax(a *RTGEmitter) {
		renvoAarch64AsmAddRegImm(a, aarch64Primary.Code, aarch64Primary.Code, 1)
	}

	func renvoAarch64AsmImulRcxImm(a *RTGEmitter, imm int) {
		renvoAarch64AsmMovRegImm(a, aarch64Scratch.Code, imm)
		renvoAarch64AsmEmit(a, 0x9b007c00|(aarch64Scratch.Code<<16)|(aarch64Tertiary.Code<<5)|aarch64Tertiary.Code)
	}

	func renvoAarch64AsmLeave(a *RTGEmitter) {
		renvoAarch64AsmEmit(a, 0x910003bf)
		renvoAarch64AsmEmit(a, 0xa8c17bfd)
	}

	func renvoAarch64AsmRet(a *RTGEmitter) {
		renvoAarch64AsmEmit(a, 0xd65f03c0)
	}

	func renvoAarch64AsmCallLabel(a *RTGEmitter, label int) {
		at := a.Len()
		renvoAarch64AsmEmit(a, 0x94000000)
		a.RelocAt(at, label)
	}

	func renvoAarch64AsmJmpLabel(a *RTGEmitter, label int) {
		at := a.Len()
		renvoAarch64AsmEmit(a, 0x14000000)
		a.RelocAt(at, label)
	}

	func renvoAarch64AsmBCondLabel(a *RTGEmitter, label int, cond int) {
		at := a.Len()
		renvoAarch64AsmEmit(a, 0x54000000|cond)
		a.RelocAt(at, label)
	}

	func renvoAarch64AsmJzLabel(a *RTGEmitter, label int) {
		renvoAarch64AsmBCondLabel(a, label, 0)
	}

	func renvoAarch64AsmJnzLabel(a *RTGEmitter, label int) {
		renvoAarch64AsmBCondLabel(a, label, 1)
	}
}
arch aarch64 {
	alias = "aarch64"
	endian = little
	word_bits = 64
	pointer_bits = 64
	instruction_alignment = 4

	registers gpr64 = [
		x0, x1, x2, x3, x4, x5, x6, x7,
		x8, x9, x10, x11, x12, x13, x14, x15,
		x16, x17, x18, x19, x20, x21, x22, x23,
		x24, x25, x26, x27, x28, x29, x30, sp
	]

	locations {
		primary = x0
		secondary = x1
		tertiary = x2
		call_words = [x3, x4, x1, x2, x5, x6]
		system = x8
		scratch = x9
		scratch2 = x10
		address = x12
		frame = x29
		link = x30
		stack = sp
		zero = xzr
	}

	conditions {
		eq = 0
		ne = 1
		uge = 2
		ult = 3
		ugt = 8
		ule = 9
		sge = 10
		slt = 11
		sgt = 12
		sle = 13
	}

	exports {
		renvoAarch64AsmEmit = go renvoAarch64AsmEmit
		renvoAarch64AsmAlign = go renvoAarch64AsmAlign
		renvoAarch64AsmMovRegReg = go renvoAarch64AsmMovRegReg
		renvoAarch64AsmMovRegImm = go renvoAarch64AsmMovRegImm
		renvoAarch64AsmPatchMovRegImmAt = go renvoAarch64AsmPatchMovRegImmAt
		renvoAarch64AsmMovRegAbs = go renvoAarch64AsmMovRegAbs
		renvoAarch64AsmAddRegImm = go renvoAarch64AsmAddRegImm
		renvoAarch64AsmAddRegReg = go renvoAarch64AsmAddRegReg
		renvoAarch64AsmSubRegReg = go renvoAarch64AsmSubRegReg
		renvoAarch64AsmAddRegRegShift = go renvoAarch64AsmAddRegRegShift
		renvoAarch64AsmMulRegReg = go renvoAarch64AsmMulRegReg
		renvoAarch64AsmAddr = go renvoAarch64AsmAddr
		renvoAarch64AsmLoadRegMem = go renvoAarch64AsmLoadRegMem
		renvoAarch64AsmStoreRegMem = go renvoAarch64AsmStoreRegMem
		renvoAarch64AsmLoadRegStack = go renvoAarch64AsmLoadRegStack
		renvoAarch64AsmStoreRegStack = go renvoAarch64AsmStoreRegStack
		renvoAarch64AsmLeaRegStack = go renvoAarch64AsmLeaRegStack
		renvoAarch64AsmPushReg = go renvoAarch64AsmPushReg
		renvoAarch64AsmPopReg = go renvoAarch64AsmPopReg
		renvoAarch64AsmMovRaxImm = go renvoAarch64AsmMovRaxImm
		renvoAarch64AsmMovRaxImm64 = go renvoAarch64AsmMovRaxImm64
		renvoAarch64AsmMovRdxImm = go renvoAarch64AsmMovRdxImm
		renvoAarch64AsmMovRaxDataAddr = go renvoAarch64AsmMovRaxDataAddr
		renvoAarch64AsmMovRaxBssAddr = go renvoAarch64AsmMovRaxBssAddr
		renvoAarch64AsmMovR10BssAddr = go renvoAarch64AsmMovR10BssAddr
		renvoAarch64AsmLoadRaxBss = go renvoAarch64AsmLoadRaxBss
		renvoAarch64AsmStoreRaxBss = go renvoAarch64AsmStoreRaxBss
		renvoAarch64AsmMovRdiRax = go renvoAarch64AsmMovRdiRax
		renvoAarch64AsmMovRaxRdx = go renvoAarch64AsmMovRaxRdx
		renvoAarch64AsmMovRdxRax = go renvoAarch64AsmMovRdxRax
		renvoAarch64AsmMovRcxRax = go renvoAarch64AsmMovRcxRax
		renvoAarch64AsmMovRcxRdx = go renvoAarch64AsmMovRcxRdx
		renvoAarch64AsmMovRsiRax = go renvoAarch64AsmMovRsiRax
		renvoAarch64AsmMovR8Rax = go renvoAarch64AsmMovR8Rax
		renvoAarch64AsmMovR9Rax = go renvoAarch64AsmMovR9Rax
		renvoAarch64AsmAddRdxRcx = go renvoAarch64AsmAddRdxRcx
		renvoAarch64AsmSyscall = go renvoAarch64AsmSyscall
		renvoAarch64AsmPopRdi = go renvoAarch64AsmPopRdi
		renvoAarch64AsmPopRsi = go renvoAarch64AsmPopRsi
		renvoAarch64AsmStackMem = go renvoAarch64AsmStackMem
		renvoAarch64AsmAddRdxImm = go renvoAarch64AsmAddRdxImm
		renvoAarch64AsmMemDisp = go renvoAarch64AsmMemDisp
		renvoAarch64AsmLoadQwordRaxIndexRcx8 = go renvoAarch64AsmLoadQwordRaxIndexRcx8
		renvoAarch64AsmLoadQwordRaxIndexRcxDisp = go renvoAarch64AsmLoadQwordRaxIndexRcxDisp
		renvoAarch64AsmLoadRaxMemRdxDisp = go renvoAarch64AsmLoadRaxMemRdxDisp
		renvoAarch64AsmLoadRaxMemRdxDispSize = go renvoAarch64AsmLoadRaxMemRdxDispSize
		renvoAarch64AsmLoadByteRaxIndexRcx = go renvoAarch64AsmLoadByteRaxIndexRcx
		renvoAarch64AsmLoadRaxIndexRcxSize = go renvoAarch64AsmLoadRaxIndexRcxSize
		renvoAarch64AsmStoreRaxMemRdxRcx8 = go renvoAarch64AsmStoreRaxMemRdxRcx8
		renvoAarch64AsmStoreRaxMemRdxDisp = go renvoAarch64AsmStoreRaxMemRdxDisp
		renvoAarch64AsmStoreRaxMemRdxDispSize = go renvoAarch64AsmStoreRaxMemRdxDispSize
		renvoAarch64AsmNormalizeRaxForKind = go renvoAarch64AsmNormalizeRaxForKind
		renvoAarch64AsmIncMemRdx = go renvoAarch64AsmIncMemRdx
		renvoAarch64AsmDecMemRdx = go renvoAarch64AsmDecMemRdx
		renvoAarch64AsmBoolNotRax = go renvoAarch64AsmBoolNotRax
		renvoAarch64AsmNegRax = go renvoAarch64AsmNegRax
		renvoAarch64AsmCmpRaxImm8 = go renvoAarch64AsmCmpRaxImm8
		renvoAarch64AsmCmpRegImm = go renvoAarch64AsmCmpRegImm
		renvoAarch64AsmCmpRegReg = go renvoAarch64AsmCmpRegReg
		renvoAarch64AsmCsetRax = go renvoAarch64AsmCsetRax
		renvoAarch64AsmAddRaxRcx = go renvoAarch64AsmAddRaxRcx
		renvoAarch64AsmSubRaxRcx = go renvoAarch64AsmSubRaxRcx
		renvoAarch64AsmShlRcxImm = go renvoAarch64AsmShlRcxImm
		renvoAarch64AsmShlRaxImm = go renvoAarch64AsmShlRaxImm
		renvoAarch64AsmSarRaxImm = go renvoAarch64AsmSarRaxImm
		renvoAarch64AsmDivLeftRcxRightRax = go renvoAarch64AsmDivLeftRcxRightRax
		renvoAarch64CondFromSetcc = go renvoAarch64CondFromSetcc
		renvoAarch64AsmCmpRcxRaxSet = go renvoAarch64AsmCmpRcxRaxSet
		renvoAarch64AsmPushRax = go renvoAarch64AsmPushRax
		renvoAarch64AsmPushRcx = go renvoAarch64AsmPushRcx
		renvoAarch64AsmPushRdx = go renvoAarch64AsmPushRdx
		renvoAarch64AsmPopRax = go renvoAarch64AsmPopRax
		renvoAarch64AsmPopRcx = go renvoAarch64AsmPopRcx
		renvoAarch64AsmPopRdx = go renvoAarch64AsmPopRdx
		renvoAarch64AsmPushImm = go renvoAarch64AsmPushImm
		renvoAarch64AsmStoreSliceStack = go renvoAarch64AsmStoreSliceStack
		renvoAarch64AsmStoreAlMemRdxRcx1 = go renvoAarch64AsmStoreAlMemRdxRcx1
		renvoAarch64AsmStoreRaxMemRdxRcxSize = go renvoAarch64AsmStoreRaxMemRdxRcxSize
		renvoAarch64AsmIncRcx = go renvoAarch64AsmIncRcx
		renvoAarch64AsmIncRax = go renvoAarch64AsmIncRax
		renvoAarch64AsmImulRcxImm = go renvoAarch64AsmImulRcxImm
		renvoAarch64AsmLeave = go renvoAarch64AsmLeave
		renvoAarch64AsmRet = go renvoAarch64AsmRet
		renvoAarch64AsmCallLabel = go renvoAarch64AsmCallLabel
		renvoAarch64AsmJmpLabel = go renvoAarch64AsmJmpLabel
		renvoAarch64AsmBCondLabel = go renvoAarch64AsmBCondLabel
		renvoAarch64AsmJzLabel = go renvoAarch64AsmJzLabel
		renvoAarch64AsmJnzLabel = go renvoAarch64AsmJnzLabel
	}

	relocation branch26 {
		width = 4
		signed = true
		scale = 4
		bits = 26
		relative_to = instruction
	}

	relocation branch19 {
		width = 4
		signed = true
		scale = 4
		bits = 19
		relative_to = instruction
	}
}

abi aapcs64 {
	arch = aarch64
	arguments = [x0, x1, x2, x3, x4, x5, x6, x7]
	result = [x0, x1]
	stack_alignment = 16
}

abi windows_arm64 {
	arch = aarch64
	arguments = [x0, x1, x2, x3, x4, x5, x6, x7]
	result = [x0, x1]
	stack_alignment = 16
}

runtime linux_aarch64 {
	operations = [print, open, close, read, write, chmod]
}

runtime darwin_arm64 {
	operations = [print, open, close, read, write, chmod]
}

runtime windows_arm64 {
	operations = [print, open, close, read, write, chmod]
}

format elf64_aarch64 {
	byte_order = little
	address_bits = 64
	kind = elf
	machine = 183
}

format macho64_arm64 {
	byte_order = little
	address_bits = 64
	kind = "mach-o"
	cpu = 0x0100000c
}

format pe64_arm64 {
	byte_order = little
	address_bits = 64
	kind = pe
	machine = 0xaa64
}

target linux/aarch64 {
	os = linux
	arch = aarch64
	abi = aapcs64
	runtime = linux_aarch64
	executable = elf64_aarch64
	build_tags = [linux, unix, aarch64, arm64]
	capabilities = [hosted, executable, filesystem, heap, argv, environment]
}

target darwin/arm64 {
	os = darwin
	arch = aarch64
	abi = aapcs64
	runtime = darwin_arm64
	executable = macho64_arm64
	build_tags = [darwin, unix, aarch64, arm64]
	capabilities = [hosted, executable, filesystem, heap, argv, environment]
}

target windows/arm64 {
	os = windows
	arch = aarch64
	abi = windows_arm64
	runtime = windows_arm64
	executable = pe64_arm64
	build_tags = [windows, aarch64, arm64]
	capabilities = [hosted, executable, filesystem, heap, argv, environment, windows_gui]
}
