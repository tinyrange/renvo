	}

	func renvoAarch64AsmShlRcxImm(a *RTGEmitter, imm int) {
		renvoAarch64AsmEmit(a, 0xd3400000|((64-imm)<<16)|((63-imm)<<10)|(aarch64Tertiary.Code<<5)|aarch64Tertiary.Code)
	}

	func renvoAarch64AsmShlRaxImm(a *RTGEmitter, imm int) {
		renvoAarch64AsmEmit(a, 0xd3400000|((64-imm)<<16)|((63-imm)<<10))
	}

	func renvoAarch64AsmSarRaxImm(a *RTGEmitter, imm int) {
		renvoAarch64AsmEmit(a, 0x9340fc00|(imm<<16))
	}

	func renvoAarch64AsmDivLeftRcxRightRax(a *RTGEmitter, mod bool) {
		renvoAarch64AsmMovRegReg(a, aarch64Scratch.Code, aarch64Primary.Code)
		renvoAarch64AsmEmit(a, 0x9ac00c40)
		if mod {
			renvoAarch64AsmEmit(a, 0x9b098800)
		}
	}

	func renvoAarch64CondFromSetcc(setcc int) int {
		if setcc == 0x94 {
			return 0
		}
		if setcc == 0x95 {
			return 1
		}
		if setcc == 0x92 {
			return 3
		}
		if setcc == 0x93 {
			return 2
		}
		if setcc == 0x96 {
			return 9
		}
		if setcc == 0x97 {
			return 8
		}
		if setcc == 0x9c {
			return 11
		}
		if setcc == 0x9e {
			return 13
		}
		if setcc == 0x9f {
			return 12
		}
		return 10
	}

	func renvoAarch64AsmCmpRcxRaxSet(a *RTGEmitter, setcc int) {
		renvoAarch64AsmCmpRegReg(a, aarch64Tertiary.Code, aarch64Primary.Code)
		cond := renvoAarch64CondFromSetcc(setcc)
		renvoAarch64AsmCsetRax(a, cond)
	}

	func renvoAarch64AsmPushRax(a *RTGEmitter) {
		renvoAarch64AsmPushReg(a, aarch64Primary.Code)
	}

	func renvoAarch64AsmPushRcx(a *RTGEmitter) {
		renvoAarch64AsmPushReg(a, aarch64Tertiary.Code)
	}

	func renvoAarch64AsmPushRdx(a *RTGEmitter) {
		renvoAarch64AsmPushReg(a, aarch64Secondary.Code)
	}

	func renvoAarch64AsmPopRax(a *RTGEmitter) {
		renvoAarch64AsmPopReg(a, aarch64Primary.Code)
	}

	func renvoAarch64AsmPopRcx(a *RTGEmitter) {
		renvoAarch64AsmPopReg(a, aarch64Tertiary.Code)
	}

	func renvoAarch64AsmPopRdx(a *RTGEmitter) {
		renvoAarch64AsmPopReg(a, aarch64Secondary.Code)
	}

	func renvoAarch64AsmPushImm(a *RTGEmitter, imm int) {
		renvoAarch64AsmMovRegImm(a, aarch64Scratch.Code, imm)
		renvoAarch64AsmPushReg(a, aarch64Scratch.Code)
	}

	func renvoAarch64AsmStoreSliceStack(a *RTGEmitter, offset int) {
		renvoAarch64AsmStoreRegStack(a, aarch64Primary.Code, offset)
		renvoAarch64AsmStoreRegStack(a, aarch64Secondary.Code, offset-8)
		renvoAarch64AsmStoreRegStack(a, aarch64Tertiary.Code, offset-16)
	}

	func renvoAarch64AsmStoreAlMemRdxRcx1(a *RTGEmitter) {
		renvoAarch64AsmAddRegRegShift(a, aarch64Address.Code, aarch64Secondary.Code, aarch64Tertiary.Code, 0)
		renvoAarch64AsmStoreRegMem(a, aarch64Primary.Code, aarch64Address.Code, 0, 1)
	}

	func renvoAarch64AsmStoreRaxMemRdxRcxSize(a *RTGEmitter, size int) {
		shift := 3
		if size == 1 {
			shift = 0
		}
		if size == 2 {
			shift = 1
		}
		if size == 4 {
			shift = 2
		}
		renvoAarch64AsmAddRegRegShift(a, aarch64Address.Code, aarch64Secondary.Code, aarch64Tertiary.Code, shift)
		renvoAarch64AsmStoreRegMem(a, aarch64Primary.Code, aarch64Address.Code, 0, size)
	}

	func renvoAarch64AsmIncRcx(a *RTGEmitter) {
		renvoAarch64AsmAddRegImm(a, aarch64Tertiary.Code, aarch64Tertiary.Code, 1)
	}

	func renvoAarch64AsmIncRax(a *RTGEmitter) {
		renvoAarch64AsmAddRegImm(a, aarch64Primary.Code, aarch64Primary.Code, 1)
	}

	func renvoAarch64AsmImulRcxImm(a *RTGEmitter, imm int) {
		renvoAarch64AsmMovRegImm(a, aarch64Scratch.Code, imm)
		renvoAarch64AsmEmit(a, 0x9b007c00|(aarch64Scratch.Code<<16)|(aarch64Tertiary.Code<<5)|aarch64Tertiary.Code)
	}

	func renvoAarch64AsmLeave(a *RTGEmitter) {
		renvoAarch64AsmEmit(a, 0x910003bf)
		renvoAarch64AsmEmit(a, 0xa8c17bfd)
	}

	func renvoAarch64AsmRet(a *RTGEmitter) {
		renvoAarch64AsmEmit(a, 0xd65f03c0)
	}

	func renvoAarch64AsmCallLabel(a *RTGEmitter, label int) {
		at := a.Len()
		renvoAarch64AsmEmit(a, 0x94000000)
		a.RelocAt(at, label)
	}

	func renvoAarch64AsmJmpLabel(a *RTGEmitter, label int) {
		at := a.Len()
		renvoAarch64AsmEmit(a, 0x14000000)
		a.RelocAt(at, label)
	}

	func renvoAarch64AsmBCondLabel(a *RTGEmitter, label int, cond int) {
		at := a.Len()
		renvoAarch64AsmEmit(a, 0x54000000|cond)
		a.RelocAt(at, label)
	}

	func renvoAarch64AsmJzLabel(a *RTGEmitter, label int) {
		renvoAarch64AsmBCondLabel(a, label, 0)
	}

	func renvoAarch64AsmJnzLabel(a *RTGEmitter, label int) {
		renvoAarch64AsmBCondLabel(a, label, 1)
	}

	// direct_emitter_v1 uses registers and addresses rather than the historical
	// x86-named value helpers above. These algorithms are the architecture
	// boundary used by generated backends.
	func aarch64Move(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		renvoAarch64AsmMovRegReg(out, destination.Code, source.Code)
	}

	func aarch64EmitADR(out *RTGEmitter, destination RTGRegister, address RTGAddress) {
		addend := address.Addend
		insn := 0x10000000 | destination.Code
		insn = insn | ((addend & 3) << 29)
		insn = insn | (((addend >> 2) & 0x7ffff) << 5)
		at := out.Len()
		renvoAarch64AsmEmit(out, insn)
		RTGAddressRelocAt(out, address, at)
	}

	func aarch64EmitAddress(out *RTGEmitter, destination RTGRegister, address RTGAddress) {
		if RTGAddressValid(address) {
			aarch64EmitADR(out, destination, address)
			return
		}
		base := address.Base.Code
		if address.Index.Valid {
			shift := 0
			if address.Scale == 2 {
				shift = 1
			} else if address.Scale == 4 {
				shift = 2
			} else if address.Scale == 8 {
				shift = 3
			}
			renvoAarch64AsmAddRegRegShift(
				out, destination.Code, base, address.Index.Code, shift)
			base = destination.Code
		}
		renvoAarch64AsmAddRegImm(
			out, destination.Code, base, address.Displacement)
	}

	func aarch64MemoryBase(out *RTGEmitter, address RTGAddress) int {
		if RTGAddressValid(address) || address.Index.Valid {
			aarch64EmitAddress(out, aarch64Address, address)
			return aarch64Address.Code
		}
		if address.Displacement < -256 || address.Displacement > 255 {
			aarch64EmitAddress(out, aarch64Address, address)
			return aarch64Address.Code
		}
		return address.Base.Code
	}

	func aarch64LoadWidth(
		out *RTGEmitter,
		destination RTGRegister,
		address RTGAddress,
		size int,
		signed bool,
	) {
		base := aarch64MemoryBase(out, address)
		displacement := address.Displacement
		if base == aarch64Address.Code {
			displacement = 0
		}
		imm := (displacement & 511) << 12
		op := 0xf8400000
		if size == 1 {
			op = 0x38400000
			if signed {
				op = 0x38800000
			}
		} else if size == 2 {
			op = 0x78400000
			if signed {
				op = 0x78800000
			}
		} else if size == 4 {
			op = 0xb8400000
			if signed {
				op = 0xb8800000
			}
		}
		renvoAarch64AsmEmit(
			out, op|imm|(base<<5)|destination.Code)
	}

	func aarch64LoadNative(
		out *RTGEmitter, destination RTGRegister, address RTGAddress,
	) {
		aarch64LoadWidth(out, destination, address, 8, false)
	}

	func aarch64LoadI32(
		out *RTGEmitter, destination RTGRegister, address RTGAddress,
	) {
		aarch64LoadWidth(out, destination, address, 4, true)
	}

	func aarch64LoadU32(
		out *RTGEmitter, destination RTGRegister, address RTGAddress,
	) {
		aarch64LoadWidth(out, destination, address, 4, false)
	}

	func aarch64LoadI16(
		out *RTGEmitter, destination RTGRegister, address RTGAddress,
	) {
		aarch64LoadWidth(out, destination, address, 2, true)
	}

	func aarch64LoadU16(
		out *RTGEmitter, destination RTGRegister, address RTGAddress,
	) {
		aarch64LoadWidth(out, destination, address, 2, false)
	}

	func aarch64LoadI8(
		out *RTGEmitter, destination RTGRegister, address RTGAddress,
	) {
		aarch64LoadWidth(out, destination, address, 1, true)
	}

	func aarch64LoadU8(
		out *RTGEmitter, destination RTGRegister, address RTGAddress,
	) {
		aarch64LoadWidth(out, destination, address, 1, false)
	}

	func aarch64StoreWidth(
		out *RTGEmitter,
		address RTGAddress,
		source RTGRegister,
		size int,
	) {
		base := aarch64MemoryBase(out, address)
		displacement := address.Displacement
		if base == aarch64Address.Code {
			displacement = 0
		}
		imm := (displacement & 511) << 12
		op := 0xf8000000
		if size == 1 {
			op = 0x38000000
		} else if size == 2 {
			op = 0x78000000
		} else if size == 4 {
			op = 0xb8000000
		}
		renvoAarch64AsmEmit(out, op|imm|(base<<5)|source.Code)
	}

	func aarch64StoreNative(
		out *RTGEmitter, address RTGAddress, source RTGRegister,
	) {
		aarch64StoreWidth(out, address, source, 8)
	}

	func aarch64StoreU32(
		out *RTGEmitter, address RTGAddress, source RTGRegister,
	) {
		aarch64StoreWidth(out, address, source, 4)
	}

	func aarch64StoreU16(
		out *RTGEmitter, address RTGAddress, source RTGRegister,
	) {
		aarch64StoreWidth(out, address, source, 2)
	}

	func aarch64StoreU8(
		out *RTGEmitter, address RTGAddress, source RTGRegister,
	) {
		aarch64StoreWidth(out, address, source, 1)
	}

	func aarch64Add(
		out *RTGEmitter, destination RTGRegister, source RTGRegister,
	) {
		renvoAarch64AsmAddRegReg(
			out, destination.Code, destination.Code, source.Code)
	}

	func aarch64Subtract(
		out *RTGEmitter, destination RTGRegister, source RTGRegister,
	) {
		renvoAarch64AsmSubRegReg(
			out, destination.Code, destination.Code, source.Code)
	}

	func aarch64Multiply(
		out *RTGEmitter, destination RTGRegister, source RTGRegister,
	) {
		renvoAarch64AsmMulRegReg(
			out, destination.Code, destination.Code, source.Code)
	}

	func aarch64BitAnd(
		out *RTGEmitter, destination RTGRegister, source RTGRegister,
	) {
		renvoAarch64AsmEmit(out,
			0x8a000000|(source.Code<<16)|
				(destination.Code<<5)|destination.Code)
	}

	func aarch64BitOr(
		out *RTGEmitter, destination RTGRegister, source RTGRegister,
	) {
		renvoAarch64AsmEmit(out,
			0xaa000000|(source.Code<<16)|
				(destination.Code<<5)|destination.Code)
	}

	func aarch64BitXor(
		out *RTGEmitter, destination RTGRegister, source RTGRegister,
	) {
		renvoAarch64AsmEmit(out,
			0xca000000|(source.Code<<16)|
				(destination.Code<<5)|destination.Code)
	}

	func aarch64Compare(
		out *RTGEmitter, left RTGRegister, right RTGRegister,
	) {
		renvoAarch64AsmCmpRegReg(out, left.Code, right.Code)
	}

	func aarch64Test(
		out *RTGEmitter, left RTGRegister, right RTGRegister,
	) {
		renvoAarch64AsmEmit(
			out, 0xea00001f|(right.Code<<16)|(left.Code<<5))
	}

	func aarch64Increment(out *RTGEmitter, operand RTGRegister) {
		renvoAarch64AsmAddRegImm(
			out, operand.Code, operand.Code, 1)
	}

	func aarch64Decrement(out *RTGEmitter, operand RTGRegister) {
		renvoAarch64AsmAddRegImm(
			out, operand.Code, operand.Code, -1)
	}

	func aarch64ShiftLeftImmediate(
		out *RTGEmitter, operand RTGRegister, value byte,
	) {
		shift := int(value) & 63
		renvoAarch64AsmEmit(out,
			0xd3400000|((64-shift)<<16)|((63-shift)<<10)|
				(operand.Code<<5)|operand.Code)
	}

	func aarch64ShiftRightUnsignedImmediate(
		out *RTGEmitter, operand RTGRegister, value byte,
	) {
		renvoAarch64AsmEmit(out,
			0xd340fc00|((int(value)&63)<<16)|
				(operand.Code<<5)|operand.Code)
	}

	func aarch64ShiftRightSignedImmediate(
		out *RTGEmitter, operand RTGRegister, value byte,
	) {
		renvoAarch64AsmEmit(out,
			0x9340fc00|((int(value)&63)<<16)|
				(operand.Code<<5)|operand.Code)
	}

	func aarch64Call(out *RTGEmitter, label RTGLabel) {
		renvoAarch64AsmEmit(out, 0x94000000)
		RTGReloc(out, label)
	}

	func aarch64CallIndirect(out *RTGEmitter, operand RTGRegister) {
		renvoAarch64AsmEmit(out, 0xd63f0000|(operand.Code<<5))
	}

	func aarch64Jump(out *RTGEmitter, label RTGLabel) {
		renvoAarch64AsmEmit(out, 0x14000000)
		RTGReloc(out, label)
	}

	func aarch64JumpCondition(
		out *RTGEmitter, condition RTGCondition, label RTGLabel,
	) {
		renvoAarch64AsmEmit(out, 0x54000000|condition.Code)
		RTGReloc(out, label)
	}

	func aarch64SetCondition(
		out *RTGEmitter,
		condition RTGCondition,
		destination RTGRegister,
	) {
		renvoAarch64AsmEmit(out,
			0x9a9f07e0|((condition.Code^1)<<12)|destination.Code)
	}

	func aarch64Return(out *RTGEmitter) {
		renvoAarch64AsmRet(out)
	}

	func aarch64Leave(out *RTGEmitter) {
		renvoAarch64AsmLeave(out)
	}

	func aarch64HostSyscall(out *RTGEmitter) {
		renvoAarch64AsmSyscall(out)
	}

	func aarch64MoveImmediate(
		out *RTGEmitter, destination RTGRegister, value int64,
	) {
		renvoAarch64AsmMovRegImm(
			out, destination.Code, int(value))
	}

	func aarch64VariableShift(
		out *RTGEmitter, direction RTGShiftDirection, signed bool,
	) {
		op := 0x9ac02400
		if direction == RTGShiftLeft {
			op = 0x9ac02000
		} else if signed {
			op = 0x9ac02800
		}
		renvoAarch64AsmEmit(out,
			op|(aarch64Primary.Code<<16)|
				(aarch64Tertiary.Code<<5)|aarch64Primary.Code)
	}

	func aarch64SignedDivide(out *RTGEmitter, remainder bool) {
		renvoAarch64AsmMovRegReg(
			out, aarch64Scratch.Code, aarch64Primary.Code)
		renvoAarch64AsmEmit(out,
			0x9ac00c00|(aarch64Primary.Code<<16)|
				(aarch64Tertiary.Code<<5)|aarch64Primary.Code)
		if remainder {
			renvoAarch64AsmEmit(out,
				0x9b008000|(aarch64Scratch.Code<<16)|
					(aarch64Primary.Code<<10)|
					(aarch64Tertiary.Code<<5)|aarch64Primary.Code)
		}
	}

	func aarch64CopyBytes(out *RTGEmitter) {
		destination := aarch64X3
		source := aarch64X4
		count := aarch64Secondary
		value := aarch64Scratch2
		forward := out.NewLabel()
		forwardLoop := out.NewLabel()
		backwardLoop := out.NewLabel()
		done := out.NewLabel()

		aarch64Compare(out, destination, source)
		aarch64JumpCondition(out, RTGCondition{Code: 9}, forward)
		aarch64EmitAddress(out, aarch64Scratch, RTGAddress{
			Base: source, Index: count, Scale: 1,
		})
		aarch64Compare(out, destination, aarch64Scratch)
		aarch64JumpCondition(out, RTGCondition{Code: 2}, forward)
		aarch64EmitAddress(out, source, RTGAddress{
			Base: source, Index: count, Scale: 1, Displacement: -1,
		})
		aarch64EmitAddress(out, destination, RTGAddress{
			Base: destination, Index: count, Scale: 1, Displacement: -1,
		})
		out.Mark(backwardLoop)
		aarch64Compare(out, count, aarch64Zero)
		aarch64JumpCondition(out, RTGCondition{Code: 0}, done)
		aarch64LoadU8(out, value, RTGAddress{Base: source})
		aarch64StoreU8(out, RTGAddress{Base: destination}, value)
		aarch64Decrement(out, source)
		aarch64Decrement(out, destination)
		aarch64Decrement(out, count)
		aarch64Jump(out, backwardLoop)

		out.Mark(forward)
		out.Mark(forwardLoop)
		aarch64Compare(out, count, aarch64Zero)
		aarch64JumpCondition(out, RTGCondition{Code: 0}, done)
		aarch64LoadU8(out, value, RTGAddress{Base: source})
		aarch64StoreU8(out, RTGAddress{Base: destination}, value)
		aarch64Increment(out, source)
		aarch64Increment(out, destination)
		aarch64Decrement(out, count)
		aarch64Jump(out, forwardLoop)
		out.Mark(done)
	}

	func aarch64PatchRelocations(out *RTGEmitter) {
		for i := 0; i < out.RelocationCount(); i++ {
			at := out.RelocationOffset(i)
			label := out.RelocationLabel(i)
			target := out.LabelPosition(label)
			if at < 0 || at+4 > len(out.Code()) || target < 0 {
				continue
			}
			insn := RTGGet32At(out.Code(), at)
			displacement := target - at
			if (insn & 0xfc000000) == 0x94000000 {
				out.PatchUint32(
					at, 0x94000000|((displacement/4)&0x03ffffff))
			} else if (insn & 0xfc000000) == 0x14000000 {
				out.PatchUint32(
					at, 0x14000000|((displacement/4)&0x03ffffff))
			} else if (insn & 0xff000010) == 0x54000000 {
				out.PatchUint32(at,
					(insn&0xff00001f)|
						(((displacement/4)&0x7ffff)<<5))
			} else if (insn & 0x9f000000) == 0x10000000 {
				addend := (insn >> 29) & 3
				addend = addend | (((insn >> 5) & 0x7ffff) << 2)
				if (addend & 0x100000) != 0 {
					addend = addend - 0x200000
				}
				displacement = displacement + addend
				out.PatchUint32(at,
					0x10000000|(insn&31)|
						((displacement&3)<<29)|
						(((displacement>>2)&0x7ffff)<<5))
			}
		}
	}

	func aarch64FrameStart(out *RTGEmitter) int {
		renvoAarch64AsmEmit(out, 0xa9bf7bfd)
		renvoAarch64AsmEmit(out, 0x910003fd)
		at := out.Len()
		renvoAarch64AsmEmit(out, 0xd503201f)
		renvoAarch64AsmEmit(out, 0xd503201f)
		return at
	}

	func aarch64FrameFinish(out *RTGEmitter, at int, stackUsed int) {
		frame := (stackUsed + 15) & -16
		high := frame / 4096
		low := frame % 4096
		if high > 0 {
			out.PatchUint32(at, 0xd14003ff|(high<<10))
		}
		if low > 0 {
			out.PatchUint32(at+4, 0xd10003ff|(low<<10))
		}
	}
}
arch aarch64 {
	alias = "aarch64"
	endian = little
	word_bits = 64
	pointer_bits = 64
	instruction_alignment = 4
	patch_relocations = go aarch64PatchRelocations

	registers gpr64 = [
		x0, x1, x2, x3, x4, x5, x6, x7,
		x8, x9, x10, x11, x12, x13, x14, x15,
		x16, x17, x18, x19, x20, x21, x22, x23,
		x24, x25, x26, x27, x28, x29, x30, sp
	]

	locations {
		primary = x0
		secondary = x1
		tertiary = x2
		call_words = [x3, x4, x1, x2, x5, x6]
		system = x8
		scratch = x9
		scratch2 = x10
		address = x12
		copy_destination = x3
		copy_source = x4
		copy_count = x1
		frame = x29
		link = x30
		stack = sp
		zero = xzr
	}

	conditions {
		eq = 0
		ne = 1
		uge = 2
		ult = 3
		ugt = 8
		ule = 9
		sge = 10
		slt = 11
		sgt = 12
		sle = 13
	}

	bind {
		move = go aarch64Move
		address = go aarch64EmitAddress
		load.native = go aarch64LoadNative
		load.i32 = go aarch64LoadI32
		load.u32 = go aarch64LoadU32
		load.i16 = go aarch64LoadI16
		load.u16 = go aarch64LoadU16
		load.i8 = go aarch64LoadI8
		load.u8 = go aarch64LoadU8
		store.native = go aarch64StoreNative
		store.u32 = go aarch64StoreU32
		store.u16 = go aarch64StoreU16
		store.u8 = go aarch64StoreU8
		add = go aarch64Add
		subtract = go aarch64Subtract
		multiply = go aarch64Multiply
		bit_and = go aarch64BitAnd
		bit_or = go aarch64BitOr
		bit_xor = go aarch64BitXor
		compare = go aarch64Compare
		test = go aarch64Test
		increment = go aarch64Increment
		decrement = go aarch64Decrement
		shift_left_immediate = go aarch64ShiftLeftImmediate
		shift_right_unsigned_immediate = go aarch64ShiftRightUnsignedImmediate
		shift_right_signed_immediate = go aarch64ShiftRightSignedImmediate
		call = go aarch64Call
		call_indirect = go aarch64CallIndirect
		jump = go aarch64Jump
		jump_condition = go aarch64JumpCondition
		set_condition = go aarch64SetCondition
		return = go aarch64Return
		leave = go aarch64Leave
		host_syscall = go aarch64HostSyscall
		move_immediate = go aarch64MoveImmediate
		variable_shift = go aarch64VariableShift
		signed_divide = go aarch64SignedDivide
		copy_bytes = go aarch64CopyBytes
	}

	exports {
		renvoAarch64AsmEmit = go renvoAarch64AsmEmit
