		global_init_frame_end = renvoAarch64CompilerGlobalInitFrameEnd
		ieee_binary_stack = renvoAarch64CompilerIEEEBinaryStack
		ieee_convert_float_stack = renvoAarch64CompilerIEEEConvertFloatStack
