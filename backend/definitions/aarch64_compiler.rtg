		cmp_primary_imm8_discard = renvoAarch64CompilerCmpPrimaryImm8Discard
		shl_tertiary_imm = renvoAarch64CompilerShlTertiaryImm
		shl_primary_imm = renvoAarch64CompilerShlPrimaryImm
		sar_primary_imm = renvoAarch64CompilerSarPrimaryImm
		div_left_tertiary_right_primary = renvoAarch64CompilerDivLeftTertiaryRightPrimary
		cmp_tertiary_primary_set = renvoAarch64CompilerCmpTertiaryPrimarySet
		store_primary_mem_secondary_tertiary_size = renvoAarch64CompilerStorePrimaryMemSecondaryTertiarySize
		cmp_tertiary_primary_jump = renvoAarch64CompilerCmpTertiaryPrimaryJump
		push_imm = renvoAarch64CompilerPushImm
