go compiler {
	func renvoAarch64CompilerBitwisePrimaryTertiary(a *renvoAsm, op byte) {
		instruction := 0x8a000040
		if op == '|' {
			instruction = 0xaa000040
		} else if op == '^' {
			instruction = 0xca000040
		} else if op != '&' {
			a.patchFailed = true
			return
		}
		renvoAarch64AsmEmit(a, instruction)
	}
}

