# Immediate, frame-branch, and runtime-boundary emission.
go compiler {
	func renvoAarch64CompilerPrimaryImm(a *renvoAsm, imm int) {
		renvoAarch64AsmMovRaxImm(a, imm)
	}

	func renvoAarch64CompilerSyscall(a *renvoAsm) {
		renvoAarch64AsmSyscall(a)
	}

	func renvoAarch64CompilerPushStackWord(a *renvoAsm, offset int) {
		renvoAsmPushStack(a, offset)
	}

	func renvoAarch64CompilerJcmpStackStack(a *renvoAsm, left int, right int, label int, setcc int) {
		renvoAsmPushStack(a, left)
		renvoAsmLoadPrimaryStack(a, right)
		renvoAsmPopTertiary(a)
		renvoAsmCmpTertiaryPrimaryJump(a, setcc, label)
	}

	func renvoAarch64CompilerJcmpStackImm(a *renvoAsm, offset int, value int, label int, setcc int) {
		renvoAsmPushStack(a, offset)
		renvoAsmPrimaryImm(a, value)
		renvoAsmPopTertiary(a)
		renvoAsmCmpTertiaryPrimaryJump(a, setcc, label)
	}
}

go compiler {
	func renvoAarch64CompilerPrimaryImm64(a *renvoAsm, imm int, high int) {
		renvoAarch64AsmMovRaxImm(a, imm)
		part := high & 65535
		extension := imm >> 31 & 65535
		if part != extension {
			renvoAarch64AsmEmit(a, 0xf2c00000|(part<<5)|renvoAarch64RegRax)
		}
		part = high >> 16 & 65535
		if part != extension {
			renvoAarch64AsmEmit(a, 0xf2e00000|(part<<5)|renvoAarch64RegRax)
		}
	}
}

