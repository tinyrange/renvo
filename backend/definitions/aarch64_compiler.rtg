		push_stack_word = renvoAarch64CompilerPushStackWord
		jcmp_stack_stack = renvoAarch64CompilerJcmpStackStack
		jcmp_stack_imm = renvoAarch64CompilerJcmpStackImm
		secondary_imm = renvoAarch64CompilerSecondaryImm
		primary_data_addr = renvoAarch64CompilerPrimaryDataAddr
		primary_bss_addr = renvoAarch64CompilerPrimaryBssAddr
		load_primary_bss = renvoAarch64CompilerLoadPrimaryBss
		store_primary_bss = renvoAarch64CompilerStorePrimaryBss
		pop_call_word0 = renvoAarch64CompilerPopCallWord0
		pop_call_word1 = renvoAarch64CompilerPopCallWord1
		add_secondary_imm = renvoAarch64CompilerAddSecondaryImm
