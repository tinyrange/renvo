		load_primary_mem_secondary_disp = renvoAarch64CompilerLoadPrimaryMemSecondaryDisp
		load_primary_mem_secondary_disp_size = renvoAarch64CompilerLoadPrimaryMemSecondaryDispSize
		load_primary_index_tertiary_size = renvoAarch64CompilerLoadPrimaryIndexTertiarySize
