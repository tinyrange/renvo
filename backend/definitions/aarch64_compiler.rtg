go compiler {
	func renvoAarch64CompilerInstallThreadState(g *renvoLinearGen) {
		return
	}

	func renvoAarch64CompilerLoadPrimaryThreadState(g *renvoLinearGen, stateOffset int) {
		renvoAsmPushSecondary(&g.asm)
		renvoAsmLoadPrimaryBss(&g.asm, g.threadStatePointerOff)
		renvoAsmCopyPrimaryToSecondary(&g.asm)
		renvoAsmLoadPrimaryMemSecondaryDisp(&g.asm, stateOffset)
		renvoAsmPopSecondary(&g.asm)
	}

	func renvoAarch64CompilerStorePrimaryThreadState(g *renvoLinearGen, stateOffset int) {
		renvoAsmPushSecondary(&g.asm)
		renvoAsmPushPrimary(&g.asm)
		renvoAsmLoadPrimaryBss(&g.asm, g.threadStatePointerOff)
		renvoAsmCopyPrimaryToSecondary(&g.asm)
		renvoAsmPopPrimary(&g.asm)
		renvoAsmStorePrimaryMemSecondaryDisp(&g.asm, stateOffset)
		renvoAsmPopSecondary(&g.asm)
	}

	func renvoAarch64CompilerRuntimeStack(g *renvoLinearGen, ep *renvoExprParse, e *renvoExpr, count int) bool {
		if count == 5 {
			renvoAsmPrimaryImm(&g.asm, 0)
		}
		return true
	}

	func renvoAarch64CompilerUncheckedNonNilPrimary(g *renvoLinearGen) {
		renvoAsmCallLabel(&g.asm, renvoEnsureNonNilCheckHelper(g, false))
	}

	func renvoAarch64CompilerUncheckedNonNilSecondary(g *renvoLinearGen) {
		renvoAsmCallLabel(&g.asm, renvoEnsureNonNilCheckHelper(g, true))
	}
}

