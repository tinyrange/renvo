runtime windows_arm64 {
	entry sequence aarch64.windowsEntry {
		max_parameters = 2
		bss args 32768 16
		bss argsText 32768 16
		bss argsLength 8 8
		bss environment 32768 16
		bss environmentLength 8 8
	}
	emit_exit = sequence aarch64.windowsExit
	emit_static_call = go aarch64.windowsStaticCall
	imports "kernel32.dll" = [
		CreateFileA, CloseHandle, ReadFile, WriteFile, SetFilePointer,
		GetStdHandle, GetCommandLineA, ExitProcess, GetEnvironmentStringsA
	]
	operation read { emit = sequence aarch64.windowsRead }
	operation write { emit = sequence aarch64.windowsWrite }
	operation read_at { emit = sequence aarch64.windowsReadAt }
	operation write_at { emit = sequence aarch64.windowsWriteAt }
	operation open { emit = sequence aarch64.windowsRuntimeOpen }
	operation close { emit = sequence aarch64.windowsRuntimeClose }
	operation chmod { emit = sequence aarch64.windowsRuntimeChmod }
	operation print { use = write }
}

format pe64_arm64 {
	byte_order = little
	address_bits = 64
	kind = pe
	machine = 0xaa64
	code_offset = 0x1000
	image = pe_executable
	patch_image = go aarch64.pEPatch
	image_base = 0x40000000
	image_base_high = 1
	file_alignment = 0x200
	section_alignment = 0x1000
	coff_characteristics = 0x22
	dll_characteristics = 0x8100
	os_version_major = 6
	os_version_minor = 1
	image_version_major = 1
	image_version_minor = 0
	subsystem_version_major = 6
	subsystem_version_minor = 1
	stack_reserve = 0x800000
	stack_commit = 0x1000
	heap_reserve = 0x100000
	heap_commit = 0x1000
}

target windows/arm64 {
	family = native_v1
	os = windows
	arch = aarch64
	abi = windows_arm64
	runtime = windows_arm64
	executable = pe64_arm64
	build_tags = [windows, aarch64, arm64]
	capabilities = [hosted, executable, filesystem, heap, argv, environment, windows_gui]
}
