# The 32-bit x86 slice owns its encoder and Linux and Windows compositions.
go backend {

	func renvo386AsmSecondaryDisp(a *RTGEmitter, disp int) {
		if disp == 0 {
			a.Int8(0x02)
			return
		}
		if RTGInt8Fits(disp) {
			a.Bytes2(0x42, disp)
			return
		}
		a.Int8(0x82)
		a.Int32(disp)
	}

	func renvo386AsmMovRaxImm(a *RTGEmitter, imm int) {
		if imm == 0 {
			a.Uint16( 0xc031)
			return
		}
		if RTGInt8Fits(imm) {
			a.Bytes2( 0x6a, imm)
			a.Int8(0x58)
			return
		}
		if imm >= -2147483647 && imm <= 2147483647 {
			a.Int8( 0xb8)
			a.Int32( imm)
			return
		}
		a.Int8( 0xb8)
		a.Int32( imm)
	}

	func renvo386AsmMovRdxImm(a *RTGEmitter, imm int) {
		if imm == 0 {
			a.Uint16( 0xd231)
			return
		}
		if RTGInt8Fits(imm) {
			a.Bytes2( 0x6a, imm)
			a.Int8(0x5a)
			return
		}
		if imm >= 0 {
			if imm <= 2147483647 {
				a.Int8( 0xba)
				a.Int32( imm)
				return
			}
		} else {
			if imm >= -2147483647 {
				a.Int8( 0xba)
				a.Int32( imm)
				return
			}
		}
		a.Int8( 0xba)
		a.Int32( imm)
	}

	func renvo386AsmStackMem(a *RTGEmitter, offset int, base int, disp8 int, disp32 int) {
		if base > 0xff {
			a.Int8( base>>8)
		} else {
			a.Int8( base)
		}
		if offset >= 0 && offset <= 128 {
			a.Int8( disp8)
			a.Int8( -offset)
			return
		}
		a.Int8( disp32)
		a.Int32( -offset)
	}

	func renvo386AsmAddRdxImm(a *RTGEmitter, imm int) {
		if RTGInt8Fits(imm) {
			a.Bytes3( 0x83, 0xc2, imm)
			return
		}
		a.Uint16( 0xc281)
		a.Int32( imm)
	}

	func renvo386AsmMemDisp(a *RTGEmitter, disp int, op int, disp8 int, disp32 int) {
		if op > 0xff {
			a.Int8( op>>8)
		} else {
			a.Int8( op)
		}
		if RTGInt8Fits(disp) {
			a.Bytes2( disp8, disp)
			return
		}
		a.Int8( disp32)
		a.Int32( disp)
	}

	func renvo386AsmLoadQwordRaxIndexRcxDisp(a *RTGEmitter, disp int) {
		a.Int8( 0x8b)
		if RTGInt8Fits(disp) {
			a.Bytes3( 0x44, 0x8, disp)
			return
		}
		a.Uint16( 0x0884)
		a.Int32( disp)
	}

	func renvo386AsmLoadRaxMemRdxDisp(a *RTGEmitter, disp int) {
		if disp == 0 {
			a.Uint16( 0x028b)
			return
		}
		renvo386AsmMemDisp(a, disp, 0x8b48, 0x42, 0x82)
	}

	func renvo386AsmLoadRaxMemRdxDispSize(a *RTGEmitter, disp int, size int) {
		if size == 1 {
			a.Uint16( 0xb60f)
			renvo386AsmSecondaryDisp(a, disp)
			return
		}
		if size == 2 {
			a.Uint16( 0xbf0f)
			renvo386AsmSecondaryDisp(a, disp)
			return
		}
		renvo386AsmLoadRaxMemRdxDisp(a, disp)
	}

	func renvo386AsmLoadRaxIndexRcxSize(a *RTGEmitter, size int) {
		if size == 1 {
			renvo386AsmLoadByteRaxIndexRcx(a)
			return
		}
		if size == 2 {
			a.Int32( 0x4804bf0f)
			return
		}
		if size == 4 {
			a.Uint24( 0x88048b)
			return
		}
		renvo386AsmLoadQwordRaxIndexRcx8(a)
	}

	func renvo386AsmStoreRaxMemRdxDisp(a *RTGEmitter, disp int) {
		if disp == 0 {
			a.Uint16( 0x0289)
			return
		}
		renvo386AsmMemDisp(a, disp, 0x8948, 0x42, 0x82)
	}

	func renvo386AsmStoreRaxMemRdxDispSize(a *RTGEmitter, disp int, size int) {
		if size == 1 {
			a.Int8( 0x88)
			renvo386AsmSecondaryDisp(a, disp)
			return
		}
		if size == 2 {
			a.Uint16( 0x8966)
			renvo386AsmSecondaryDisp(a, disp)
			return
		}
		renvo386AsmStoreRaxMemRdxDisp(a, disp)
	}

	func renvo386AsmNormalizeRaxForKind(a *RTGEmitter, kind int) {
		if kind == RTGScalarByte {
			a.Uint24( 0xc0b60f)
			return
		}
		if kind == RTGScalarInt8 {
			a.Uint24( 0xc0be0f)
			return
		}
		if kind == RTGScalarInt16 {
			a.Int8( 0x98)
			return
		}
		if kind == RTGScalarUint16 {
			a.Uint24( 0xc0b70f)
		}
	}

	func renvo386AsmCmpRaxImm8(a *RTGEmitter, imm int) {
		if imm == 0 {
			a.Uint16( 0xc085)
			return
		}
		a.Bytes3( 0x83, 0xf8, imm)
	}

	func renvo386AsmDivLeftRcxRightRax(a *RTGEmitter, mod bool) {
		a.Uint16( 0xc389)
		a.Uint16( 0xc889)
		a.Int8( 0x99)
		a.Uint16( 0xfbf7)
		if mod {
			a.Uint16( 0xd089)
		}
	}

	func x86_32Memory(out *RTGEmitter, reg byte, address RTGAddress) {
		base := address.Base
		index := address.Index
		displacement := address.Displacement
		mode := byte(0)
		if !base.Valid {
			mode = 0
		} else if displacement != 0 || x86_32Low3(base) == 5 {
			mode = 2
			if RTGSignedFits(int64(displacement), 8) {
				mode = 1
			}
		}
		needsSIB := index.Valid || base.Valid && x86_32Low3(base) == 4
		if needsSIB {
			x86_32ModRM(out, mode, reg, 4)
			indexCode := byte(4)
			if index.Valid {
				indexCode = x86_32Low3(index)
			}
			baseCode := byte(5)
			if base.Valid {
				baseCode = x86_32Low3(base)
			}
			shift := byte(0)
			if address.Scale == 2 {
				shift = 1
			} else if address.Scale == 4 {
				shift = 2
			} else if address.Scale == 8 {
				shift = 3
			}
			out.AppendByte(int(shift<<6 | indexCode<<3 | baseCode))
		} else if base.Valid {
			x86_32ModRM(out, mode, reg, x86_32Low3(base))
		} else {
			x86_32ModRM(out, 0, reg, 5)
		}
		if !base.Valid || mode == 2 {
			out.Int32(displacement)
		} else if mode == 1 {
			out.Int8(displacement)
		}
	}

	func x86_32Address(
		out *RTGEmitter, destination RTGRegister, address RTGAddress,
	) {
		if RTGAddressValid(address) {
			// CALL pushes the address immediately after its displacement. The
			// relocation bias converts the ordinary field-end relative fixup
			// into target+addend minus that saved address.
			out.Byte(0xe8)
			out.Int32(0)
			out.AppendByte(int(0x58 + x86_32Low3(destination)))
			out.Byte(0x81)
			x86_32ModRM(out, 3, 0, x86_32Low3(destination))
			at := out.Len()
			out.Int32(address.Addend + 7)
			RTGAddressRelocAt(out, address, at)
			return
		}
		out.Byte(0x8d)
		x86_32Memory(out, x86_32Low3(destination), address)
	}

	func x86_32LoadOpcode(
		out *RTGEmitter,
		destination RTGRegister,
		address RTGAddress,
		opcode int,
	) {
		if RTGAddressValid(address) {
			x86_32Address(out, destination, address)
			address = RTGAddress{Base: destination}
		}
		if opcode > 0xff {
			out.AppendByte(int(byte(opcode >> 8)))
		}
		out.AppendByte(int(byte(opcode)))
		x86_32Memory(out, x86_32Low3(destination), address)
	}

	func x86_32StoreWidth(
		out *RTGEmitter,
		address RTGAddress,
		source RTGRegister,
		size int,
	) {
		if RTGAddressValid(address) {
			x86_32Address(out, x86_32Scratch, address)
			address = RTGAddress{Base: x86_32Scratch}
		}
		if size == 2 {
			out.Byte(0x66)
		}
		if size == 1 {
			out.Byte(0x88)
		} else {
			out.Byte(0x89)
		}
		x86_32Memory(out, x86_32Low3(source), address)
	}

	func x86_32MoveImmediate(
		out *RTGEmitter, destination RTGRegister, value int64,
	) {
		if value == 0 {
			x86_32Binary(out, 0x31, destination, destination)
			return
		}
		out.AppendByte(int(byte(0xb8 + x86_32Low3(destination))))
		RTGUint32(out, int(value))
	}

	func x86_32VariableShift(
		out *RTGEmitter, direction RTGShiftDirection, signed bool,
	) {
		x86_32Binary(out, 0x87, x86_32Primary, x86_32Tertiary)
		selector := byte(5)
		if direction == RTGShiftLeft {
			selector = 4
		} else if signed {
			selector = 7
		}
		x86_32Group(out, 0xd3, selector, x86_32Primary)
	}

	func x86_32SignedDivide(out *RTGEmitter, remainder bool) {
		x86_32Move(out, x86_32Scratch, x86_32Primary)
		x86_32Move(out, x86_32Primary, x86_32Tertiary)
		out.Byte(0x99)
		x86_32Group(out, 0xf7, 7, x86_32Scratch)
		if remainder {
			x86_32Move(out, x86_32Primary, x86_32Secondary)
		}
	}

	func x86_32FrameFinish(out *RTGEmitter, at int, stackUsed int) {
		frame := (stackUsed + 7) & -8
		if frame > 65528 {
			frame = 65528
		}
		out.SetByteAt(at+1, byte(frame))
		out.SetByteAt(at+2, byte(frame>>8))
	}
}

arch x86_32 {
	alias = "386"
	endian = little
	word_bits = 32
	pointer_bits = 32
	instruction_alignment = 1
	patch_relocations = relative32_le
	registers gpr32 = [eax, ecx, edx, ebx, esp, ebp, esi, edi]
	locations {
		primary = eax
		secondary = edx
		tertiary = ecx
		scratch = ebx
		copy_destination = edi
		copy_source = esi
		copy_count = ecx
		stack = esp
		frame = ebp
	}
	conditions {
		eq  0x94 0x84
		ne  0x95 0x85
		slt 0x9c 0x8c
		sge 0x9d 0x8d
		sle 0x9e 0x8e
		sgt 0x9f 0x8f
		ult 0x92 0x82
		uge 0x93 0x83
		ule 0x96 0x86
		ugt 0x97 0x87
	}
	forms {
		binary = sequence x86_32Binary
		load = go x86_32LoadOpcode
		store = go x86_32StoreWidth
		group = sequence x86_32Group
		shift = sequence x86_32ShiftImmediate
		relative = sequence x86_32Relative
		jump_condition = sequence x86_32JumpCondition
		fixed = bytes
	}
	instructions {
		move binary 0x89
		load_native load 0x8b
		load_i32 load 0x8b
		load_u32 load 0x8b
		load_i16 load 0x0fbf
		load_u16 load 0x0fb7
		load_i8 load 0x0fbe
		load_u8 load 0x0fb6
		store_native store 0 size=4
		store_u32 store 0 size=4
		store_u16 store 0 size=2
		store_u8 store 0 size=1
		add binary 0x01
		subtract binary 0x29
		bit_and binary 0x21
		bit_or binary 0x09
		bit_xor binary 0x31
		compare binary 0x39
		test binary 0x85
		increment group 0xff /0
		decrement group 0xff /1
		shift_left_immediate shift 0xc1 /4
		shift_right_unsigned_immediate shift 0xc1 /5
		shift_right_signed_immediate shift 0xc1 /7
		call relative 0xe8
		call_indirect group 0xff /2
		jump relative 0xe9
		jump_cond jump_condition 0
		return fixed [0xc3]
		leave fixed [0xc9]
		host_syscall fixed [0xcd, 0x80]
	}
	bind {
		move = move
		address = go x86_32Address
		load.native = load_native
		load.i32 = load_i32
		load.u32 = load_u32
		load.i16 = load_i16
		load.u16 = load_u16
		load.i8 = load_i8
		load.u8 = load_u8
		store.native = store_native
		store.u32 = store_u32
		store.u16 = store_u16
		store.u8 = store_u8
		add = add
		subtract = subtract
		multiply = sequence x86_32Multiply
		bit_and = bit_and
		bit_or = bit_or
		bit_xor = bit_xor
		compare = compare
		test = test
		increment = increment
		decrement = decrement
		shift_left_immediate = shift_left_immediate
		shift_right_unsigned_immediate = shift_right_unsigned_immediate
		shift_right_signed_immediate = shift_right_signed_immediate
		call = call
		call_indirect = call_indirect
		jump = jump
		jump_condition = jump_cond
		set_condition = sequence x86_32SetCondition
		return = return
		leave = leave
		host_syscall = host_syscall
		move_immediate = go x86_32MoveImmediate
		variable_shift = go x86_32VariableShift
		signed_divide = go x86_32SignedDivide
		copy_bytes = sequence x86_32CopyBytes
	}
	exports {
		renvo386AsmSecondaryDisp = go renvo386AsmSecondaryDisp
		renvo386AsmMovRaxImm = go renvo386AsmMovRaxImm
		renvo386AsmMovRaxImm64 = sequence renvo386AsmMovRaxImm64
		renvo386AsmMovRegPCRel = sequence renvo386AsmMovRegPCRel
		renvo386AsmMovRdxImm = go renvo386AsmMovRdxImm
		renvo386AsmMovRdiRax = sequence renvo386AsmMovRdiRax
		renvo386AsmMovRaxRdx = sequence renvo386AsmMovRaxRdx
		renvo386AsmMovRsiRax = sequence renvo386AsmMovRsiRax
		renvo386AsmMovR8Rax = sequence renvo386AsmMovR8Rax
		renvo386AsmMovR9Rax = sequence renvo386AsmMovR9Rax
		renvo386AsmAddRdxRcx = sequence renvo386AsmAddRdxRcx
		renvo386AsmSyscall = sequence renvo386AsmSyscall
		renvo386AsmPopRdi = sequence renvo386AsmPopRdi
		renvo386AsmStackMem = go renvo386AsmStackMem
		renvo386AsmAddRdxImm = go renvo386AsmAddRdxImm
		renvo386AsmMemDisp = go renvo386AsmMemDisp
		renvo386AsmJccLabel = sequence renvo386AsmJccLabel
		renvo386AsmLoadQwordRaxIndexRcx8 = sequence renvo386AsmLoadQwordRaxIndexRcx8
		renvo386AsmLoadQwordRaxIndexRcxDisp = go renvo386AsmLoadQwordRaxIndexRcxDisp
		renvo386AsmLoadRaxMemRdxDisp = go renvo386AsmLoadRaxMemRdxDisp
		renvo386AsmLoadRaxMemRdxDispSize = go renvo386AsmLoadRaxMemRdxDispSize
		renvo386AsmLoadByteRaxIndexRcx = sequence renvo386AsmLoadByteRaxIndexRcx
		renvo386AsmLoadRaxIndexRcxSize = go renvo386AsmLoadRaxIndexRcxSize
		renvo386AsmStoreRaxMemRdxRcx8 = sequence renvo386AsmStoreRaxMemRdxRcx8
		renvo386AsmStoreRaxMemRdxDisp = go renvo386AsmStoreRaxMemRdxDisp
		renvo386AsmStoreRaxMemRdxDispSize = go renvo386AsmStoreRaxMemRdxDispSize
		renvo386AsmNormalizeRaxForKind = go renvo386AsmNormalizeRaxForKind
		renvo386AsmIncMemRdx = sequence renvo386AsmIncMemRdx
		renvo386AsmDecMemRdx = sequence renvo386AsmDecMemRdx
		renvo386AsmBoolNotRax = sequence renvo386AsmBoolNotRax
		renvo386AsmCmpRaxImm8 = go renvo386AsmCmpRaxImm8
		renvo386AsmAddRaxRcx = sequence renvo386AsmAddRaxRcx
		renvo386AsmSubRaxRcx = sequence renvo386AsmSubRaxRcx
		renvo386AsmShlRcxImm = sequence renvo386AsmShlRcxImm
		renvo386AsmShlRaxImm = sequence renvo386AsmShlRaxImm
		renvo386AsmSarRaxImm = sequence renvo386AsmSarRaxImm
		renvo386AsmShrRaxImm = sequence renvo386AsmShrRaxImm
		renvo386AsmDivLeftRcxRightRax = go renvo386AsmDivLeftRcxRightRax
		renvo386AsmCmpRcxRaxSet = sequence renvo386AsmCmpRcxRaxSet
		renvoAsmMovArg1Rax = sequence renvoAsmMovArg1Rax
	}
	relocation rel32 {
		width = 4
		signed = true
		scale = 1
		bits = 32
		relative_to = instruction_end
	}

	sequences {
		renvo386AsmAddRaxRcx(a:emitter) {
			call a.Uint16(0xc801)

		}
		renvo386AsmAddRdxRcx(a:emitter) {
			call a.Uint16(0xca01)

		}
		renvo386AsmBoolNotRax(a:emitter) {
			call a.Bytes3(0x83,0xf0,1)

		}
		renvo386AsmCmpRcxRaxSet(a:emitter, setcc:int) {
			call a.Uint24(0x0fc139)

			call a.Bytes3(setcc,0xc0,0xf)

			call a.Uint16(0xc0b6)

		}
		renvo386AsmDecMemRdx(a:emitter) {
			call a.Uint16(0x0aff)

		}
		renvo386AsmIncMemRdx(a:emitter) {
			call a.Uint16(0x02ff)

		}
		renvo386AsmLoadByteRaxIndexRcx(a:emitter) {
			call a.Int32(0x0804b60f)

		}
		renvo386AsmLoadQwordRaxIndexRcx8(a:emitter) {
			call a.Uint24(0xc8048b)

		}
		renvo386AsmMovR8Rax(a:emitter) {
			call a.Uint16(0xc389)

		}
		renvo386AsmMovR9Rax(a:emitter) {
			call a.Uint16(0xc389)

		}
		renvo386AsmMovRaxImm64(a:emitter, imm:int) {
			call renvo386AsmMovRaxImm(a,imm)

		}
		renvo386AsmMovRaxRdx(a:emitter) {
			call a.Uint16(0xd089)

		}
		renvo386AsmMovRdiRax(a:emitter) {
			call a.Uint16(0xc389)

		}
		renvo386AsmMovRsiRax(a:emitter) {
			call a.Uint16(0xc189)

		}
		renvo386AsmPopRdi(a:emitter) {
			call a.Int8(0x5b)

		}
		renvo386AsmSarRaxImm(a:emitter, imm:int) {
			call a.Bytes3(0xc1,0xf8,imm)

		}
		renvo386AsmShlRaxImm(a:emitter, imm:int) {
			call a.Bytes3(0xc1,0xe0,imm)

		}
		renvo386AsmShlRcxImm(a:emitter, imm:int) {
			call a.Bytes3(0xc1,0xe1,imm)

		}
		renvo386AsmShrRaxImm(a:emitter, imm:int) {
			call a.Bytes3(0xc1,0xe8,imm)

		}
		renvo386AsmStoreRaxMemRdxRcx8(a:emitter) {
			call a.Uint24(0xca0489)

		}
		renvo386AsmSubRaxRcx(a:emitter) {
			call a.Uint16(0xc829)

		}
		renvo386AsmSyscall(a:emitter) {
			call a.Uint16(0x80cd)

		}
		renvoAsmMovArg1Rax(a:emitter) {
			call a.Uint16(0xc689)

		}

		renvo386AsmJccLabel(a:emitter, op:int, label:int) {
			call a.Bytes2(0x0f,op)

			let at = a.Len()

			call a.Int32(0)

			call a.RelocAt(at,label)

		}
		renvo386AsmMovRegPCRel(a:emitter, reg:int, off:int, kind:int) {
			call a.Int8(0xe8)

			call a.Int32(0)

			call a.Int8(0x58|reg)

			call a.Bytes2(0x81,0xc0|reg)

			let at = a.Len()

			call a.Int32(0)

			call a.AbsoluteReloc(at,off,kind)

		}

		x86_32Binary(out:emitter, opcode:byte, destination:register, source:register) {
			call out.AppendByte(int(opcode))
			call x86_32ModRM(out,3,x86_32Low3(source),x86_32Low3(destination))
		}
		x86_32CopyBytes(out:emitter) {
			let destination = x86_32CopyDestination
			let source = x86_32CopySource
			let count = x86_32CopyCount
			let scratch = x86_32Scratch
			let forward = out.NewLabel()
			let done = out.NewLabel()
			call x86_32Compare(out,destination,source)
			call x86_32JumpCondition(out,record_condition(JumpOpcode:0x86),forward)
			call x86_32Address(out,scratch,record_address(Base:source,Index:count,Scale:1,))
			call x86_32Compare(out,destination,scratch)
			call x86_32JumpCondition(out,record_condition(JumpOpcode:0x83),forward)
			call x86_32Address(out,source,record_address(Base:source,Index:count,Scale:1,Displacement:-1,))
			call x86_32Address(out,destination,record_address(Base:destination,Index:count,Scale:1,Displacement:-1,))
			call out.Bytes4(0xfd,0xf3,0xa4,0xfc)
			call x86_32Jump(out,done)
			call out.Mark(forward)
			call out.Bytes3(0xfc,0xf3,0xa4)
			call out.Mark(done)
		}
		x86_32FrameStart(out:emitter) -> int {
			let at = out.Len()
			call out.Bytes4(0xc8,0,0,0)
			return at
		}
		x86_32Group(out:emitter, opcode:byte, selector:byte, operand:register) {
			call out.AppendByte(int(opcode))
			call x86_32ModRM(out,3,selector,x86_32Low3(operand))
		}
		x86_32JumpCondition(out:emitter, condition:condition, label:label) {
			call out.Byte(0x0f)
			call out.AppendByte(int(condition.JumpOpcode))
			call out.Rel32(label)
		}
		x86_32Multiply(out:emitter, destination:register, source:register) {
			call out.Bytes2(0x0f,0xaf)
			call x86_32ModRM(out,3,x86_32Low3(destination),x86_32Low3(source))
		}
