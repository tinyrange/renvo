# The x86-64 slice owns its encoder and Linux, Windows, and Linux-kernel
# compositions. Irregular algorithms remain typed Go; target composition is
# declarative below.
go backend {
	func nativeAppend32(out []byte, value int) []byte {
		out = append(out, byte(value), byte(value>>8), byte(value>>16), byte(value>>24))
		return out
	}

	func nativeAppend16(out []byte, value int) []byte {
		return append(out, byte(value), byte(value>>8))
	}

	func nativeAppend64(out []byte, value int) []byte {
		out = nativeAppend32(out, value)
		out = nativeAppend32(out, value>>32)
		return out
	}

	func x86KernelStaticCall(out *RTGEmitter, importID int, wordCount int) {
		registers := []RTGRegister{
			{Code: 7, Valid: true},
			{Code: 6, Valid: true},
			{Code: 2, Valid: true},
			{Code: 1, Valid: true},
			{Code: 8, Valid: true},
			{Code: 9, Valid: true},
		}
		for i := 0; i < wordCount && i < len(registers); i++ {
			x86OpcodeRegister(out, 0x58, registers[i])
		}
		out.Byte(0xe8)
		at := out.Len()
		out.Int32(0)
		out.AbsoluteReloc(at, importID, RTGRelocationImport)
	}

	func x86KernelRuntimeOperation(out *RTGEmitter, operation int) bool {
		if operation != RTGRuntimeWrite {
			return false
		}
		rax := RTGRegister{Code: 0, Valid: true}
		rsi := RTGRegister{Code: 6, Valid: true}
		rdi := RTGRegister{Code: 7, Valid: true}
		rdx := RTGRegister{Code: 2, Valid: true}
		x86RRRM(out, 0x89, rax, rsi, 64)
		x86RRRM(out, 0x89, rsi, rdx, 64)
		x86RRRM(out, 0x89, rdx, rax, 64)
		data := out.Data()
		formatOffset := len(data)
		data = append(data, '%', '.', '*', 's', 0)
		out.SetData(data)
		x86RMR(out, 0x8d, rdi, RTGAddress{
			Kind: 1, Addend: formatOffset,
		}, 64)
		x86MoveImmediate(out, rax, 0)
		importID := out.ExternalImport("_printk")
		out.Byte(0xe8)
		at := out.Len()
		out.Int32(0)
		out.AbsoluteReloc(at, importID, RTGRelocationImport)
		return true
	}

	func x86WindowsExit(out *RTGEmitter, status RTGRegister) {
		if status.Code != 1 {
			x86RRRM(out, 0x89, RTGRegister{Code: 1, Valid: true}, status, 64)
		}
		out.Bytes4(0x48, 0x83, 0xec, 0x28)
		out.Bytes2(0xff, 0x15)
		at := out.Len()
		out.Int32(0)
		out.AbsoluteReloc(at, 8, RTGRelocationImport)
	}

	func x86WindowsLoadRAXFromR10(out *RTGEmitter, offset int) {
		if offset <= 127 {
			out.Bytes4(0x49, 0x8b, 0x42, offset)
			return
		}
		out.Bytes3(0x49, 0x8b, 0x82)
		out.Int32(offset)
	}

	func x86WindowsLoadRAXFromRSP(out *RTGEmitter, offset int) {
		if offset <= 127 {
			out.Bytes4(0x48, 0x8b, 0x44, 0x24)
			out.Byte(offset)
			return
		}
		out.Bytes4(0x48, 0x8b, 0x84, 0x24)
		out.Int32(offset)
	}

	func x86WindowsStoreRAXToRSP(out *RTGEmitter, offset int) {
		if offset <= 127 {
			out.Bytes4(0x48, 0x89, 0x44, 0x24)
			out.Byte(offset)
			return
		}
		out.Bytes4(0x48, 0x89, 0x84, 0x24)
		out.Int32(offset)
	}

	func x86WindowsStoreR10ToRSP(out *RTGEmitter, offset int) {
		if offset <= 127 {
			out.Bytes4(0x4c, 0x89, 0x54, 0x24)
			out.Byte(offset)
			return
		}
		out.Bytes4(0x4c, 0x89, 0x94, 0x24)
		out.Int32(offset)
	}

	func x86WindowsStaticCall(out *RTGEmitter, importID int, wordCount int) {
		if wordCount > 0 {
			x86OpcodeRegister(out, 0x58, RTGRegister{Code: 1, Valid: true})
		}
		if wordCount > 1 {
			x86OpcodeRegister(out, 0x58, RTGRegister{Code: 2, Valid: true})
		}
		if wordCount > 2 {
			out.Bytes2(0x41, 0x58)
		}
		if wordCount > 3 {
			out.Bytes2(0x41, 0x59)
		}
		stackWords := 0
		if wordCount > 4 {
			stackWords = wordCount - 4
		}
		out.Bytes3(0x49, 0x89, 0xe2)
		out.Bytes4(0x48, 0x83, 0xe4, 0xf0)
		savedRSPOff := 32 + stackWords*8
		allocation := RTGAlignValue(savedRSPOff+8, 16)
		if RTGSignedFits(int64(allocation), 8) {
			out.Bytes4(0x48, 0x83, 0xec, allocation)
		} else {
			out.Bytes3(0x48, 0x81, 0xec)
			out.Int32(allocation)
		}
		for i := 0; i < stackWords; i++ {
			x86WindowsLoadRAXFromR10(out, i*8)
			x86WindowsStoreRAXToRSP(out, 32+i*8)
		}
		x86WindowsStoreR10ToRSP(out, savedRSPOff)
		out.Bytes2(0xff, 0x15)
		at := out.Len()
		out.Int32(0)
		out.AbsoluteReloc(at, importID, RTGRelocationImport)
		out.Bytes3(0x49, 0x89, 0xc2)
		x86WindowsLoadRAXFromRSP(out, savedRSPOff)
		out.Bytes3(0x48, 0x89, 0xc4)
		if stackWords > 0 {
			adjust := stackWords * 8
			if RTGSignedFits(int64(adjust), 8) {
				out.Bytes4(0x48, 0x83, 0xc4, adjust)
			} else {
				out.Bytes3(0x48, 0x81, 0xc4)
				out.Int32(adjust)
			}
		}
		out.Bytes3(0x4c, 0x89, 0xd0)
	}

	func renvoAmd64AsmSecondaryDisp(a *RTGEmitter, disp int) {
		if disp == 0 {
			a.Int8(0x02)
		} else if RTGInt8Fits(disp) {
			a.Bytes2(0x42, disp)
		} else {
			a.Int8(0x82)
			a.Int32(disp)
		}
	}

	func renvoAmd64AsmMovRaxImm(a *RTGEmitter, imm int) {
		if imm == 0 {
			a.Uint16(0xc031)
			return
		}
		if RTGInt8Fits(imm) {
			a.Bytes2(0x6a, imm)
			RTGPopPrimary(a)
			return
		}
		if imm>>32 == 0 {
			a.Int8(0xb8)
			a.Int32(imm)
			return
		}
		if imm >= -2147483647 && imm <= 2147483647 {
			a.Int8(0x68)
			a.Int32(imm)
			RTGPopPrimary(a)
			return
		}
		a.Uint16(0xb848)
		a.Int64(imm)
	}

	func renvoAmd64AsmMovRdiRax(a *RTGEmitter) {
		if renvoAmd64RewritePrimaryLoad(a, 7, false) {
			return
		}
		a.Uint16(0x5f50)
	}
	func renvoAmd64AsmMovRsiRax(a *RTGEmitter) {
		if renvoAmd64RewritePrimaryLoad(a, 6, false) {
			return
		}
		a.Uint16(0x5e50)
	}

	func renvoAmd64RewritePrimaryLoad(a *RTGEmitter, reg int, pushed bool) bool {
		load := a.PrimaryLoad()
		if pushed {
			load = -load
		}
		end := load >> 3
		at := end - (load & 7)
		if pushed {
			end++
		}
		if load <= 0 || end != a.Len() {
			return false
		}
		a.AddByteAt(at, byte(reg*8))
		if pushed {
			a.Truncate(a.Len() - 1)
		}
		a.SetPrimaryLoad(0)
		return true
	}

	func renvoAmd64RewritePrimaryLoadCompare(a *RTGEmitter, imm int) bool {
		load := a.PrimaryLoad()
		end := load >> 3
		if load <= 0 || end != a.Len() {
			return false
		}
		at := end - (load & 7)
		// RIP-relative displacements use the original instruction end as their
		// base, so only stack and register-relative loads can grow by one byte.
		if a.ByteAt(at)&0xc7 == 0x05 {
			return false
		}
		// Turn `movq memory, %rax; cmpq immediate, %rax` into the shorter direct
		// memory comparison. Callers use this only when the loaded value is dead
		// after the flags are consumed.
		a.SetByteAt(at-1, 0x83)
		a.AddByteAt(at, 0x38)
		a.AppendByte(imm)
		a.SetPrimaryLoad(0)
		return true
	}

	func renvoAmd64AsmMemDisp(a *RTGEmitter, disp int, op int, disp8 int, disp32 int) {
		a.Uint16(op)
		if RTGInt8Fits(disp) {
			a.Bytes2(disp8, disp)
			return
		}
		a.Int8(disp32)
		a.Int32(disp)
	}

	func renvoAmd64AsmLoadQwordRaxIndexRcxDisp(a *RTGEmitter, disp int) {
		a.Uint16(0x8b48)
		if RTGInt8Fits(disp) {
			a.Bytes3(0x44, 0x8, disp)
			return
		}
		a.Uint16(0x0884)
		a.Int32(disp)
	}

	func renvoAmd64AsmLoadRaxMemRdxDisp(a *RTGEmitter, disp int) {
		if disp == 0 {
			a.Uint24(0x028b48)
			a.SetPrimaryLoad(a.Len()*8 + 1)
			return
		}
		renvoAmd64AsmMemDisp(a, disp, 0x8b48, 0x42, 0x82)
		distance := 2
		if !RTGInt8Fits(disp) {
			distance = 5
		}
		a.SetPrimaryLoad(a.Len()*8 + distance)
	}
	func renvoAmd64AsmLoadRaxMemRdxDispSize(a *RTGEmitter, disp int, size int) {
		if size == 1 {
			a.Uint24(0xb60f48)
			renvoAmd64AsmSecondaryDisp(a, disp)
			return
		}
		if size == 2 {
			a.Uint24(0xbf0f48)
			renvoAmd64AsmSecondaryDisp(a, disp)
			return
		}
		if size == 4 {
			renvoAmd64AsmMemDisp(a, disp, 0x6348, 0x42, 0x82)
			return
		}
		renvoAmd64AsmLoadRaxMemRdxDisp(a, disp)
	}

	func renvoAmd64AsmLoadRaxIndexRcxSize(a *RTGEmitter, size int) {
		if size == 1 {
			renvoAmd64AsmLoadByteRaxIndexRcx(a)
			return
		}
		if size == 2 {
			a.Int32(0x04bf0f48)
			a.Int8(0x48)
			return
		}
		if size == 4 {
			a.Int32(0x88046348)
			return
		}
		renvoAmd64AsmLoadQwordRaxIndexRcx8(a)
	}

	func renvoAmd64AsmStoreRaxMemRdxDisp(a *RTGEmitter, disp int) {
		if disp == 0 {
			a.Uint24(0x028948)
			return
		}
		renvoAmd64AsmMemDisp(a, disp, 0x8948, 0x42, 0x82)
	}
	func renvoAmd64AsmStoreRaxMemRdxDispSize(a *RTGEmitter, disp int, size int) {
		if size == 1 {
			a.Int8(0x88)
			renvoAmd64AsmSecondaryDisp(a, disp)
			return
		}
		if size == 2 {
			a.Uint16(0x8966)
			renvoAmd64AsmSecondaryDisp(a, disp)
			return
		}
		if size == 4 {
			a.Int8(0x89)
			renvoAmd64AsmSecondaryDisp(a, disp)
			return
		}
		renvoAmd64AsmStoreRaxMemRdxDisp(a, disp)
	}
	func renvoAmd64CodeEnds(a *RTGEmitter, suffix string) bool {
		start := a.Len() - len(suffix)
		if start < 0 {
			return false
		}
		for i := 0; i < len(suffix); i++ {
			if a.ByteAt(start+i) != suffix[i] {
				return false
			}
		}
		return true
	}
	func renvoAmd64AsmNormalizeRaxForKind(a *RTGEmitter, kind int) {
		if kind == RTGScalarByte {
			if renvoAmd64CodeEnds(a, "\x0f\xb6\xc0") || renvoAmd64CodeEnds(a, "\x48\x0f\xb6\x02") || renvoAmd64CodeEnds(a, "\x48\x0f\xb6\x04\x08") {
				return
			}
			a.Uint24(0xc0b60f)
			return
		}
		if kind == RTGScalarInt8 {
			a.Int32(0xc0be0f48)
			return
		}
		if kind == RTGScalarInt16 {
			a.Int32(0xc0bf0f48)
			return
		}
		if kind == RTGScalarUint16 {
			a.Int32(0xc0b70f48)
			return
		}
		if kind == RTGScalarInt32 {
			if renvoAmd64CodeEnds(a, "\x48\x63\xc0") || renvoAmd64CodeEnds(a, "\x48\x63\x04\x88") {
				return
			}
			a.Uint24(0xc06348)
			return
		}
		if kind == RTGScalarUint32 {
			a.Uint16(0xc089)
		}
	}

	func renvoAmd64AsmCmpRaxImm8(a *RTGEmitter, imm int) {
		if imm == 0 {
			// Integer values occupy the full native register on amd64. Testing only
			// EAX makes values whose low word is zero (for example 1 << 40) compare
			// equal to zero and can send both user control flow and the compiler's
			// own immediate-selection logic down the wrong path.
			a.Uint24(0xc08548)
			return
		}
		a.Bytes4(0x48, 0x83, 0xf8, imm)
	}

	func renvoAmd64AsmCmpRaxImm8Discard(a *RTGEmitter, imm int) {
		if renvoAmd64RewritePrimaryLoadCompare(a, imm) {
			return
		}
		renvoAmd64AsmCmpRaxImm8(a, imm)
	}
	func renvoAmd64AsmDivLeftRcxRightRax(a *RTGEmitter, mod bool) {
		if mod {
			a.Text("\x48\x83\xf8\xff\x75\x10\x6a\x01\x5a\x48\xc1\xe2\x3f\x48\x39\xd1\x75\x04\x31\xc0\xeb\x10\x53\x48\x89\xc3\x48\x89\xc8\x48\x99\x48\xf7\xfb\x48\x89\xd0\x5b")
			return
		}
		a.Text("\x48\x83\xf8\xff\x75\x11\x6a\x01\x5a\x48\xc1\xe2\x3f\x48\x39\xd1\x75\x05\x48\x89\xc8\xeb\x0d\x53\x48\x89\xc3\x48\x89\xc8\x48\x99\x48\xf7\xfb\x5b")
	}

	func x86Opcode(out *RTGEmitter, opcode uint32) {
		if opcode > 0xff {
			out.AppendByte(int(opcode >> 8))
		}
		out.AppendByte(int(opcode))
	}

	func x86REX(out *RTGEmitter, wide bool, reg RTGRegister, index RTGRegister, base RTGRegister, byteRegister RTGRegister) {
		w := byte(0)
		if wide {
			w = 1
		}
		r := x86High(reg)
		x := byte(0)
		if index.Valid {
			x = x86High(index)
		}
		b := byte(0)
		if base.Valid {
			b = x86High(base)
		}
		needsByteREX := byteRegister.Valid && byteRegister.Code >= 4
		if w != 0 || r != 0 || x != 0 || b != 0 || needsByteREX {
			out.AppendByte(int(0x40 | w<<3 | r<<2 | x<<1 | b))
		}
	}

	func x86Memory(out *RTGEmitter, reg byte, address RTGAddress) {
		if RTGAddressValid(address) {
			x86ModRM(out, 0, reg, 5)
			RTGAddressRel32Addend(out, address)
			return
		}
		base := address.Base
		index := address.Index
		displacement := address.Displacement
		needsSIB := index.Valid || x86Low3(base) == 4
		mode := byte(0)
		if displacement != 0 || x86Low3(base) == 5 {
			mode = 2
			if RTGSignedFits(int64(displacement), 8) {
				mode = 1
			}
		}
		if needsSIB {
			x86ModRM(out, mode, reg, 4)
			indexCode := byte(4)
			if index.Valid {
				indexCode = x86Low3(index)
			}
			out.AppendByte(int(byte(RTGLog2(address.Scale))<<6 | indexCode<<3 | x86Low3(base)))
		} else {
			x86ModRM(out, mode, reg, x86Low3(base))
		}
		if mode == 1 {
			out.AppendByte(displacement)
		} else if mode == 2 {
			RTGUint32(out, displacement)
		}
	}

	func x86RRRM(out *RTGEmitter, opcode uint32, destination RTGRegister, source RTGRegister, width int) {
		if width == 16 {
			out.Byte(0x66)
		}
		byteRegister := RTGNoRegister
		if width == 8 {
			byteRegister = source
		}
		x86REX(out, width == 64, source, RTGNoRegister, destination, byteRegister)
		x86Opcode(out, opcode)
		x86ModRM(out, 3, x86Low3(source), x86Low3(destination))
	}

	func x86RR(out *RTGEmitter, opcode uint32, destination RTGRegister, source RTGRegister, width int) {
		x86REX(out, width == 64, destination, RTGNoRegister, source, RTGNoRegister)
		x86Opcode(out, opcode)
		x86ModRM(out, 3, x86Low3(destination), x86Low3(source))
	}

	func x86RMR(out *RTGEmitter, opcode uint32, destination RTGRegister, address RTGAddress, width int) {
		if width == 16 {
			out.Byte(0x66)
		}
		x86REX(out, width == 64, destination, address.Index, address.Base, RTGNoRegister)
		x86Opcode(out, opcode)
		x86Memory(out, x86Low3(destination), address)
	}

	func x86RRM(out *RTGEmitter, opcode uint32, address RTGAddress, source RTGRegister, width int) {
		if width == 16 {
			out.Byte(0x66)
		}
		byteRegister := RTGNoRegister
		if width == 8 {
			byteRegister = source
		}
		x86REX(out, width == 64, source, address.Index, address.Base, byteRegister)
		x86Opcode(out, opcode)
		x86Memory(out, x86Low3(source), address)
	}

	func x86Group(out *RTGEmitter, opcode uint32, selector byte, operand RTGRegister, width int) {
		x86REX(out, width == 64, RTGNoRegister, RTGNoRegister, operand, RTGNoRegister)
		x86Opcode(out, opcode)
		x86ModRM(out, 3, selector, x86Low3(operand))
	}

	func x86GroupImmediate8(out *RTGEmitter, opcode uint32, selector byte, operand RTGRegister, value byte, width int) {
		x86Group(out, opcode, selector, operand, width)
		out.AppendByte(int(value))
	}

	func x86Relative(out *RTGEmitter, opcode uint32, label RTGLabel) {
		x86Opcode(out, opcode)
		out.Rel32(label)
	}

	func x86MoveImmediate(out *RTGEmitter, destination RTGRegister, value int64) {
		if destination.Code == 0 && value == 0 {
			out.Bytes2(0x31, 0xc0)
		} else if destination.Code != 4 && RTGSignedFits(value, 8) {
			out.Bytes2(0x6a, int(value))
			x86OpcodeRegister(out, 0x58, destination)
		} else if value >= 0 && RTGUnsignedFits(uint64(value), 32) {
			x86OpcodeRegister(out, 0xb8, destination)
			RTGUint32(out, int(value))
		} else if RTGSignedFits(value, 32) {
			out.Byte(0x68)
			RTGUint32(out, int(value))
			x86OpcodeRegister(out, 0x58, destination)
		} else {
			x86REX(out, true, RTGNoRegister, RTGNoRegister, destination, RTGNoRegister)
			out.AppendByte(int(0xb8 + x86Low3(destination)))
			out.Uint64(uint64(value))
		}
	}

	func x86OpcodeRegister(out *RTGEmitter, opcode byte, operand RTGRegister) {
		if x86High(operand) != 0 {
			out.Byte(0x41)
		}
		out.AppendByte(int(opcode + x86Low3(operand)))
	}

	func x86VariableShift(out *RTGEmitter, direction RTGShiftDirection, signed bool) {
		x86_64Xchg64(out, RTGRegister{Code: 0, Valid: true}, RTGRegister{Code: 1, Valid: true})
		if direction == RTGShiftLeft {
			x86_64ShlCL64(out, RTGRegister{Code: 0, Valid: true})
		} else if signed {
			x86_64SarCL64(out, RTGRegister{Code: 0, Valid: true})
		} else {
			x86_64ShrCL64(out, RTGRegister{Code: 0, Valid: true})
		}
	}

	func x86SignedDivide(out *RTGEmitter, remainder bool) {
		primary := RTGRegister{Code: 0, Valid: true}
		secondary := RTGRegister{Code: 2, Valid: true}
		tertiary := RTGRegister{Code: 1, Valid: true}
		scratch := RTGRegister{Code: 3, Valid: true}
		ordinary := out.NewLabel()
		done := out.NewLabel()
		x86MoveImmediate(out, secondary, -1)
		x86RRRM(out, 0x39, primary, secondary, 64)
		x86JumpCondition(out, RTGCondition{JumpOpcode: 0x85}, ordinary)
		x86MoveImmediate(out, secondary, 1)
		x86GroupImmediate8(out, 0xc1, 4, secondary, 63, 64)
		x86RRRM(out, 0x39, tertiary, secondary, 64)
		x86JumpCondition(out, RTGCondition{JumpOpcode: 0x85}, ordinary)
		if remainder {
			x86MoveImmediate(out, primary, 0)
		} else {
			x86RRRM(out, 0x89, primary, tertiary, 64)
		}
		x86Relative(out, 0xe9, done)
		out.Mark(ordinary)
		x86OpcodeRegister(out, 0x50, scratch)
		x86RRRM(out, 0x89, scratch, primary, 64)
		x86RRRM(out, 0x89, primary, tertiary, 64)
		out.Bytes2(0x48, 0x99)
		x86Group(out, 0xf7, 7, scratch, 64)
		if remainder {
			x86RRRM(out, 0x89, primary, secondary, 64)
		}
		x86OpcodeRegister(out, 0x58, scratch)
		out.Mark(done)
	}

	func x86FrameFinish(out *RTGEmitter, at int, stackUsed int) {
		frame := (stackUsed + 15) & -16
		if frame > 65520 {
			frame = 65520
		}
		out.SetByteAt(at+1, byte(frame))
		out.SetByteAt(at+2, byte(frame>>8))
	}
}
arch x86_64 {
    alias = "amd64"
    endian = little
    word_bits = 64
    pointer_bits = 64
    instruction_alignment = 1
    stack_word_bytes = 8
    stack_alignment = 16
    unaligned_memory = true
    patch_relocations = relative32_le

    # List position is the architectural register number. The x86 encoder
    # derives low3, REX bits, byte-register names, RSP/R12 SIB rules, and
    # RBP/R13 displacement rules from this single list.
    registers gpr64 = [
        rax, rcx, rdx, rbx, rsp, rbp, rsi, rdi,
        r8, r9, r10, r11, r12, r13, r14, r15
    ]

    locations {
        primary = rax
        secondary = rdx
        tertiary = rcx
        scratch = r10
        division_scratch = rbx
        copy_destination = rdi
        copy_source = rsi
        copy_count = rcx
        stack = rsp
        frame = rbp
    }

    # One row supplies both SETcc and near Jcc. Unsigned conditions no longer
    # need separate hand-written lowering functions.
    conditions {
        eq  0x94 0x84
        ne  0x95 0x85
        slt 0x9c 0x8c
        sge 0x9d 0x8d
        sle 0x9e 0x8e
        sgt 0x9f 0x8f
        ult 0x92 0x82
        uge 0x93 0x83
        ule 0x96 0x86
        ugt 0x97 0x87
    }

    # Width and extension policy is stated once per source-language scalar.
    scalars {
        zero_extend { bool:1 byte:1 uint16:2 uint32:4 }
        sign_extend { int8:1 int16:2 int32:4 }
        native { int:8 int64:8 uint64:8 pointer:8 }
    }

    forms {
        rr_rm = go x86RRRM
        rr = go x86RR
        rm_r = go x86RMR
        r_rm = go x86RRM
        group = go x86Group
        group_imm8 = go x86GroupImmediate8
        opcode_reg = go x86OpcodeRegister
        relative = go x86Relative
        set_condition = sequence x86SetCondition
        jump_condition = sequence x86JumpCondition
        fixed = bytes
    }

    instructions {
        mov64 rr_rm 0x89
        load64 rm_r 0x8b
        lea64 rm_r 0x8d
        load_i32 rm_r 0x63
        load_u32 rm_r 0x8b width=32
        load_i16 rm_r 0x0fbf
        load_u16 rm_r 0x0fb7
        load_i8 rm_r 0x0fbe
        load_u8 rm_r 0x0fb6
        store64 r_rm 0x89
        store32 r_rm 0x89 width=32
        store16 r_rm 0x89 width=16
        store8 r_rm 0x88 width=8

        add64 rr_rm 0x01
        sub64 rr_rm 0x29
        and64 rr_rm 0x21
        or64 rr_rm 0x09
        xor64 rr_rm 0x31
        cmp64 rr_rm 0x39
        test64 rr_rm 0x85
        imul64 rr 0x0faf
        xchg64 rr_rm 0x87

        inc64 group 0xff /0
        dec64 group 0xff /1
        shl_imm64 group_imm8 0xc1 /4
        shr_imm64 group_imm8 0xc1 /5
        sar_imm64 group_imm8 0xc1 /7
        shl_cl64 group 0xd3 /4
        shr_cl64 group 0xd3 /5
        sar_cl64 group 0xd3 /7
        call_reg group 0xff /2 width=64

        push_reg opcode_reg 0x50
        pop_reg opcode_reg 0x58
        setcc set_condition
        jcc_rel32 jump_condition relocation=rel32
        call_rel32 relative 0xe8 relocation=rel32
        jump_rel32 relative 0xe9 relocation=rel32

        ret fixed [0xc3]
        leave fixed [0xc9]
        syscall fixed [0x0f, 0x05]
    }

    bind {
        move = mov64
        address = lea64
        load.native = load64
        load.i32 = load_i32
        load.u32 = load_u32
        load.i16 = load_i16
        load.u16 = load_u16
        load.i8 = load_i8
        load.u8 = load_u8
        store.native = store64
        store.u32 = store32
        store.u16 = store16
        store.u8 = store8
        add = add64
        subtract = sub64
        multiply = imul64
        bit_and = and64
        bit_or = or64
        bit_xor = xor64
        compare = cmp64
        test = test64
        increment = inc64
        decrement = dec64
        shift_left_immediate = shl_imm64
        shift_right_unsigned_immediate = shr_imm64
        shift_right_signed_immediate = sar_imm64
        call = call_rel32
        call_indirect = call_reg
        jump = jump_rel32
        jump_condition = jcc_rel32
        set_condition = setcc
        return = ret
        leave = leave
        host_syscall = syscall
        move_immediate = go x86MoveImmediate
        variable_shift = go x86VariableShift
        signed_divide = go x86SignedDivide
        copy_bytes = sequence x86CopyBytes
    }

    # Target-neutral lowering consumes these stable, generated exports; their
    # architecture-specific implementations remain owned by this definition.
    exports {
		renvoAmd64AsmSecondaryDisp = go renvoAmd64AsmSecondaryDisp
        renvoAmd64AsmMovRaxImm = go renvoAmd64AsmMovRaxImm
        renvoAmd64AsmMovR10BssAddr = sequence renvoAmd64AsmMovR10BssAddr
        renvoAmd64AsmLoadRaxBss = sequence renvoAmd64AsmLoadRaxBss
        renvoAmd64AsmStoreRaxBss = sequence renvoAmd64AsmStoreRaxBss
        renvoAmd64AsmMovRdiRax = go renvoAmd64AsmMovRdiRax
        renvoAmd64AsmMovRsiRax = go renvoAmd64AsmMovRsiRax
        renvoAmd64RewritePrimaryLoad = go renvoAmd64RewritePrimaryLoad
        renvoAmd64RewritePrimaryLoadCompare = go renvoAmd64RewritePrimaryLoadCompare
        renvoAmd64AsmMovR8Rax = sequence renvoAmd64AsmMovR8Rax
        renvoAmd64AsmMovR9Rax = sequence renvoAmd64AsmMovR9Rax
        renvoAmd64AsmMemDisp = go renvoAmd64AsmMemDisp
        renvoAmd64AsmLoadQwordRaxIndexRcx8 = sequence renvoAmd64AsmLoadQwordRaxIndexRcx8
        renvoAmd64AsmLoadQwordRaxIndexRcxDisp = go renvoAmd64AsmLoadQwordRaxIndexRcxDisp
        renvoAmd64AsmLoadRaxMemRdxDisp = go renvoAmd64AsmLoadRaxMemRdxDisp
        renvoAmd64AsmLoadRaxMemRdxDispSize = go renvoAmd64AsmLoadRaxMemRdxDispSize
        renvoAmd64AsmLoadByteRaxIndexRcx = sequence renvoAmd64AsmLoadByteRaxIndexRcx
        renvoAmd64AsmLoadRaxIndexRcxSize = go renvoAmd64AsmLoadRaxIndexRcxSize
        renvoAmd64AsmStoreRaxMemRdxRcx8 = sequence renvoAmd64AsmStoreRaxMemRdxRcx8
        renvoAmd64AsmStoreRaxMemRdxDisp = go renvoAmd64AsmStoreRaxMemRdxDisp
        renvoAmd64AsmStoreRaxMemRdxDispSize = go renvoAmd64AsmStoreRaxMemRdxDispSize
        renvoAmd64CodeEnds = go renvoAmd64CodeEnds
        renvoAmd64AsmNormalizeRaxForKind = go renvoAmd64AsmNormalizeRaxForKind
        renvoAmd64AsmIncMemRdx = sequence renvoAmd64AsmIncMemRdx
        renvoAmd64AsmDecMemRdx = sequence renvoAmd64AsmDecMemRdx
        renvoAmd64AsmCmpRaxImm8 = go renvoAmd64AsmCmpRaxImm8
        renvoAmd64AsmCmpRaxImm8Discard = go renvoAmd64AsmCmpRaxImm8Discard
        renvoAmd64AsmDivLeftRcxRightRax = go renvoAmd64AsmDivLeftRcxRightRax
        renvoAmd64AsmCmpRcxRaxSet = sequence renvoAmd64AsmCmpRcxRaxSet
    }

    relocation rel32 {
        width = 4
        signed = true
        relative_to = field_end
        kinds = [label, data, bss, import]
    }

    frame {
        base = rbp
        stack = rsp
        alignment = 16
        maximum = 65520
        prologue = [0xc8, frame_size:u16le, 0x00]
        epilogue = [leave, ret]
        overflow_arguments = rbp + 16
    }

	sequences {
		renvoAmd64AsmCmpRcxRaxSet(a:emitter, setcc:int) {
			call a.Int32(0x0fc13948)

			call a.Bytes3(setcc,0xc0,0xf)

			call a.Uint16(0xc0b6)

		}
		renvoAmd64AsmDecMemRdx(a:emitter) {
			call a.Uint24(0x0aff48)

		}
		renvoAmd64AsmIncMemRdx(a:emitter) {
			call a.Uint24(0x02ff48)

		}
		renvoAmd64AsmLoadByteRaxIndexRcx(a:emitter) {
			call a.Int32(0x04b60f48)

			call a.Int8(0x8)

		}
		renvoAmd64AsmLoadQwordRaxIndexRcx8(a:emitter) {
			call a.Int32(0xc8048b48)

		}
		renvoAmd64AsmMovR8Rax(a:emitter) {
			call a.Uint24(0xc08949)

		}
		renvoAmd64AsmMovR9Rax(a:emitter) {
			call a.Uint24(0xc18949)

		}
		renvoAmd64AsmStoreRaxMemRdxRcx8(a:emitter) {
			call a.Int32(0xca048948)

		}

		renvoAmd64AsmLoadRaxBss(a:emitter, bssOff:int) {
			call a.Uint24(0x058b48)

			let at = a.Len()

			call a.Int32(0)

			call a.AbsoluteReloc(at,bssOff,RTGRelocationAbsoluteBSS)

			call a.SetPrimaryLoad(a.Len()*8+5)

		}
		renvoAmd64AsmMovR10BssAddr(a:emitter, bssOff:int) {
			call a.Uint24(0x158d4c)

			let at = a.Len()

			call a.Int32(0)

			call a.AbsoluteReloc(at,bssOff,RTGRelocationAbsoluteBSS)

		}
		renvoAmd64AsmStoreRaxBss(a:emitter, bssOff:int) {
			call a.Uint24(0x058948)

			let at = a.Len()

			call a.Int32(0)

			call a.AbsoluteReloc(at,bssOff,RTGRelocationAbsoluteBSS)

		}

		x86CopyBytes(out:emitter) {
			let destination = record_register(Code:7,Valid:true)
			let source = record_register(Code:6,Valid:true)
			let count = record_register(Code:1,Valid:true)
			let scratch = record_register(Code:10,Valid:true)
			let forward = out.NewLabel()
			let done = out.NewLabel()
			call x86RRRM(out,0x39,destination,source,64)
			call x86JumpCondition(out,record_condition(JumpOpcode:0x86),forward)
			call x86RMR(out,0x8d,scratch,record_address(Base:source,Index:count,Scale:1),64)
			call x86RRRM(out,0x39,destination,scratch,64)
			call x86JumpCondition(out,record_condition(JumpOpcode:0x83),forward)
			call x86RMR(out,0x8d,source,record_address(Base:source,Index:count,Scale:1,Displacement:-1),64)
			call x86RMR(out,0x8d,destination,record_address(Base:destination,Index:count,Scale:1,Displacement:-1),64)
			call out.Bytes4(0xfd,0xf3,0xa4,0xfc)
			call x86Relative(out,0xe9,done)
			call out.Mark(forward)
			call out.Bytes3(0xfc,0xf3,0xa4)
			call out.Mark(done)
		}
		x86FrameStart(out:emitter) -> int {
			let at = out.Len()
			call out.Bytes4(0xc8,0,0,0)
			return at
		}
		x86JumpCondition(out:emitter, condition:condition, label:label) {
			call out.Byte(0x0f)
			call out.AppendByte(int(condition.JumpOpcode))
			call out.Rel32(label)
		}
		x86KernelCallbackAddress(out:emitter, label:label) {
			call out.Bytes3(0x48,0x8d,0x05)
			call out.Rel32(label)
		}
		x86KernelEntryEpilogue(out:emitter) {
			call out.Text("\x48\x83\xc4\x08\x41\x5f\x41\x5e\x41\x5d\x41\x5c\x5b\xc9\xc3")
		}
		x86KernelEntryPrologue(out:emitter) {
			call out.Text("\xf3\x0f\x1e\xfa\x55\x48\x89\xe5\x53\x41\x54\x41\x55\x41\x56\x41\x57\x48\x83\xec\x08")
		}
		x86SetCondition(out:emitter, condition:condition, destination:register) {
			call x86REX(out,false,RTGNoRegister,RTGNoRegister,destination,destination)
			call out.Byte(0x0f)
			call out.AppendByte(int(condition.SetOpcode))
			call x86ModRM(out,3,0,x86Low3(destination))
		}

		x86High(reg:register) -> byte {
			return byte(reg.Code>>3)&1
		}
		x86KernelAppend16(out:bytes, value:int) -> bytes {
			return append(out,byte(value),byte(value>>8))
		}
		x86KernelAppendELFHeader(out:bytes, sectionOffset:int, sectionCount:int, namesIndex:int) -> bytes {
			set out = append(out,0x7f,'E','L','F',2,1,1,0)
			set out = append(out,0,0,0,0,0,0,0,0)
			set out = x86KernelAppend16(out,1)
			set out = x86KernelAppend16(out,62)
			set out = nativeAppend32(out,1)
			set out = nativeAppend64(out,0)
			set out = nativeAppend64(out,0)
			set out = nativeAppend64(out,sectionOffset)
			set out = nativeAppend32(out,0)
			set out = x86KernelAppend16(out,64)
			set out = x86KernelAppend16(out,0)
			set out = x86KernelAppend16(out,0)
			set out = x86KernelAppend16(out,64)
			set out = x86KernelAppend16(out,sectionCount)
			set out = x86KernelAppend16(out,namesIndex)
			return out
		}
		x86KernelAppendRelocation(out:bytes, offset:int, symbol:int, kind:int, addend:int) -> bytes {
			set out = nativeAppend64(out,offset)
			set out = nativeAppend64(out,symbol<<32|kind)
			set out = nativeAppend64(out,addend)
			return out
		}
		x86KernelAppendSection(out:bytes, name:int, kind:int, flags:int, offset:int, size:int, link:int, info:int, alignment:int, entrySize:int) -> bytes {
			set out = nativeAppend32(out,name)
			set out = nativeAppend32(out,kind)
			set out = nativeAppend64(out,flags)
			set out = nativeAppend64(out,0)
			set out = nativeAppend64(out,offset)
			set out = nativeAppend64(out,size)
			set out = nativeAppend32(out,link)
			set out = nativeAppend32(out,info)
			set out = nativeAppend64(out,alignment)
			set out = nativeAppend64(out,entrySize)
			return out
		}
		x86KernelAppendSymbol(out:bytes, name:int, info:int, section:int, value:int, size:int) -> bytes {
			set out = nativeAppend32(out,name)
			set out = append(out,byte(info),0)
			set out = x86KernelAppend16(out,section)
			set out = nativeAppend64(out,value)
			set out = nativeAppend64(out,size)
			return out
		}
		x86Low3(reg:register) -> byte {
			return byte(reg.Code&7)
		}
		x86ModRM(out:emitter, mode:byte, reg:byte, rm:byte) {
			call out.AppendByte(int(mode<<6|(reg&7)<<3|rm&7))
		}
		x86WindowsCallImport(out:emitter, importID:int) {
			call out.Bytes4(0x48,0x83,0xec,0x28)
			call out.Bytes2(0xff,0x15)
			let at = out.Len()
			call out.Int32(0)
			call out.AbsoluteReloc(at,importID,RTGRelocationImport)
			call out.Bytes4(0x48,0x83,0xc4,0x28)
		}
		x86WindowsRuntimeChmod(out:emitter) {
			let rax = record_register(Code:0,Valid:true)
			let rcx = record_register(Code:1,Valid:true)
			let rdx = record_register(Code:2,Valid:true)
			let rdi = record_register(Code:7,Valid:true)
			let r8 = record_register(Code:8,Valid:true)
			let r9 = record_register(Code:9,Valid:true)
			let failed = out.NewLabel()
			let done = out.NewLabel()
			call x86RRRM(out,0x89,rcx,rdi,64)
			call x86MoveImmediate(out,rdx,0)
			call x86MoveImmediate(out,r8,0)
			call x86MoveImmediate(out,r9,1)
			call x86WindowsCallImport(out,5)
			call x86MoveImmediate(out,rdx,-1)
			call x86RRRM(out,0x39,rax,rdx,32)
			call x86JumpCondition(out,record_condition(JumpOpcode:0x84),failed)
			call x86MoveImmediate(out,rax,0)
			call x86Relative(out,0xe9,done)
			call out.Mark(failed)
			call x86MoveImmediate(out,rax,-1)
			call out.Mark(done)
		}
		x86WindowsRuntimeClose(out:emitter) {
			let rax = record_register(Code:0,Valid:true)
			let rcx = record_register(Code:1,Valid:true)
			let rdi = record_register(Code:7,Valid:true)
			let failed = out.NewLabel()
			let done = out.NewLabel()
			call x86RRRM(out,0x89,rcx,rdi,64)
			call x86WindowsCallImport(out,2)
			call x86RRRM(out,0x85,rax,rax,32)
			call x86JumpCondition(out,record_condition(JumpOpcode:0x84),failed)
			call x86MoveImmediate(out,rax,0)
			call x86Relative(out,0xe9,done)
			call out.Mark(failed)
			call x86MoveImmediate(out,rax,-1)
			call out.Mark(done)
		}
		x86WindowsRuntimeOpen(out:emitter) {
			let rax = record_register(Code:0,Valid:true)
			let rcx = record_register(Code:1,Valid:true)
			let rsi = record_register(Code:6,Valid:true)
			let rdi = record_register(Code:7,Valid:true)
			let r11 = record_register(Code:11,Valid:true)
			call x86RRRM(out,0x89,r11,rdi,64)
			call x86RRRM(out,0x89,rax,rsi,64)
			call x86WindowsTranslateCreateFileFlags(out)
			call x86RRRM(out,0x89,rcx,r11,64)
			let base = out.Len()
			call out.Text("\x41\x54\x49\x89\xe4\x48\x83\xe4\xf0\x48\x83\xec\x40\x44\x89\x54\x24\x20\xc7\x44\x24\x28\x80\x00\x00\x00\x48\xc7\x44\x24\x30\x00\x00\x00\x00\xff\x15\x00\x00\x00\x00\x49\x89\xc3\x4c\x89\xe4\x41\x5c\x4c\x89\xd8")
			call out.AbsoluteReloc(base+37,1,RTGRelocationImport)
		}

		x86WindowsTranslateCreateFileFlags(out:emitter) {
			let rdx = record_register(Code:2,Valid:true)
			let r8 = record_register(Code:8,Valid:true)
			let r9 = record_register(Code:9,Valid:true)
			let r10 = record_register(Code:10,Valid:true)
			let notReadWrite = out.NewLabel()
			let accessDone = out.NewLabel()
			let noCreate = out.NewLabel()
			let createDone = out.NewLabel()
			call x86MoveImmediate(out,rdx,-2147483648)
			call out.Bytes2(0xa8,2)
			call x86JumpCondition(out,record_condition(JumpOpcode:0x84),notReadWrite)
			call x86MoveImmediate(out,rdx,-1073741824)
			call x86Relative(out,0xe9,accessDone)
			call out.Mark(notReadWrite)
			call out.Bytes2(0xa8,1)
			call x86JumpCondition(out,record_condition(JumpOpcode:0x84),accessDone)
			call x86MoveImmediate(out,rdx,0x40000000)
			call out.Mark(accessDone)
			call x86MoveImmediate(out,r10,3)
			call out.Bytes2(0xa8,64)
			call x86JumpCondition(out,record_condition(JumpOpcode:0x84),noCreate)
			call x86MoveImmediate(out,r10,4)
			call out.AppendByte(0xa9)
			call out.Int32(512)
			call x86JumpCondition(out,record_condition(JumpOpcode:0x84),createDone)
			call x86MoveImmediate(out,r10,2)
			call x86Relative(out,0xe9,createDone)
			call out.Mark(noCreate)
			call out.AppendByte(0xa9)
			call out.Int32(512)
			call x86JumpCondition(out,record_condition(JumpOpcode:0x84),createDone)
			call x86MoveImmediate(out,r10,5)
			call out.Mark(createDone)
			call x86MoveImmediate(out,r8,3)
			call x86MoveImmediate(out,r9,0)
		}
}
}

# Image fields are declared here. Header/section/relocation are generic
# definition-language constructs, not precompiled ELF or PE backends.
format elf64_x86_64 {
    kind = elf
    code_offset = 176
    image = elf_executable
    patch_absolute = relative32_le
    patch_pc_bias = 4
    byte_order = little
    address_bits = 64
    file_alignment = 0x1000
    machine = 62
    flags = 0

    header elf {
        magic = [0x7f, 0x45, 0x4c, 0x46]
        class = 2
        data = 1
        version = 1
        osabi = 0
        type = 3
        machine = 62
        entry = address(text.start)
        program_header_offset = sizeof(elf_header)
        section_header_offset = stripped ? 0 : sections.offset
        flags = 0
        elf_header_size = 64
        program_header_size = 56
        program_header_count = 2
        section_header_size = stripped ? 0 : 64
        section_header_count = stripped ? 0 : sections.count
        section_name_index = stripped ? 0 : sections.names
    }

    segment text {
        type = load
        flags = read | execute
        file = [headers.start, data.file_start)
        memory = [headers.start, data.memory_start)
        alignment = 0x1000
    }

    segment data {
        type = load
        flags = read | write
        file = [data.file_start, data.file_end)
        memory = [data.memory_start, bss.end)
        alignment = 0x1000
    }

    sections when !stripped {
        text progbits alloc|execute align=16
        data progbits alloc|write align=8
        bss nobits alloc|write align=8
        symtab symtab entry_size=24 link=strtab
        strtab strtab
        shstrtab strtab
    }

    relocation {
        label = rel32
        data = rel32
        bss = rel32
    }
}

format elf64_object_x86_64 {
    kind = "elf-relocatable"
    kernel_image = linux_module_elf
    byte_order = little
    address_bits = 64
    machine = 62
    type = relocatable
    append64 = sequence nativeAppend64
    append_header = sequence x86KernelAppendELFHeader
    append_relocation = sequence x86KernelAppendRelocation
    append_section = sequence x86KernelAppendSection
    append_symbol = sequence x86KernelAppendSymbol

    sections {
        text progbits alloc|execute align=16
        rela_text rela entry_size=24 link=symtab info=text
        data progbits alloc|write align=8
        bss nobits alloc|write align=8
        symtab symtab entry_size=24 link=strtab
        strtab strtab
        shstrtab strtab
    }

    relocation label { number = 2 kind = pc_relative width = 32 addend = -4 }
    relocation data  { number = 2 kind = pc_relative width = 32 addend = -4 }
    relocation bss   { number = 2 kind = pc_relative width = 32 addend = -4 }
    relocation abs64 { number = 1 kind = absolute width = 64 addend = 0 }
}

format pe64_x86_64 {
    kind = pe
    byte_order = little
    address_bits = 64
    machine = 0x8664
    code_offset = 0x1000
    image = pe_executable
    patch_image = pe_relative32
    image_base = 0x400000
    headers_size = 0x200
    file_alignment = 0x200
    section_alignment = 0x1000
    text_rva = 0x1000
    coff_characteristics = 0x22
    dll_characteristics = 0x100
    os_version_major = 4
    os_version_minor = 0
    image_version_major = 0
    image_version_minor = 0
    subsystem_version_major = 4
    subsystem_version_minor = 0
    stack_reserve = 0x800000
    stack_commit = 0x1000
    heap_reserve = 0x100000
    heap_commit = 0x1000

    dos_header {
        magic = [0x4d, 0x5a]
        pe_offset = 0x80
    }

    coff_header {
        machine = 0x8664
        sections = 2
        optional_header_size = 0xf0
        characteristics = executable | large_address_aware
    }

    optional_header {
        magic = 0x20b
        entry = rva(text.start)
        code_base = rva(text.start)
        image_base = 0x400000
        section_alignment = 0x1000
        file_alignment = 0x200
        subsystem = target.subsystem
        stack_reserve = 8MiB
        stack_commit = 4KiB
        heap_reserve = 1MiB
        directories = [imports.directory, imports.iat]
    }

    section text {
        name = ".text"
        flags = code | execute | read
        virtual = text
        raw_alignment = 0x200
    }

    section data {
        name = ".data"
        flags = initialized_data | read | write
        virtual = data + bss
        raw = data
        raw_alignment = 0x200
    }

    imports {
        thunk_bytes = 8
        library = "KERNEL32.dll"
        names = target.runtime.imports

        descriptor size=20 {
            u32 original_first_thunk = rva(import_lookup_table)
            u32 timestamp = 0
            u32 forwarder_chain = 0
            u32 name = rva(library_name)
            u32 first_thunk = rva(import_address_table)
        }

        import_lookup_table {
            entries names as u64 rva(hint_name(entry))
            terminator = u64 0
        }

        import_address_table {
            entries names as u64 rva(hint_name(entry))
            terminator = u64 0
        }

        hint_name(entry) {
            u16 0
            ascii entry
            u8 0
            align 2
        }

        library_name {
            ascii library
            u8 0
        }

        directory.rva = rva(descriptor)
        directory.size = sizeof(descriptor)
        iat.rva = rva(import_address_table)
        iat.size = sizeof(import_address_table)
    }

    relocation import = rel32 from instruction_end to imports.iat_entry
    relocation data = rel32 from instruction_end to data
    relocation bss = rel32 from instruction_end to bss
}

format coff64_object_x86_64 {
    kind = coff
    byte_order = little
    address_bits = 64
    machine = 0x8664
    sections = [text, data, bss]
    symbol_table entry_size=18 {
        name = inline_8_or_string_offset
        value = section_offset
        section = section_index
        type = symbol_type
        storage_class = symbol_visibility
        auxiliaries = 0
    }

    string_table {
        u32 size
        entries long_symbol_names {
            ascii long_symbol_name
            u8 0
        }
    }

    relocation label { number = 0x0004 kind = rel32 addend = -4 }
    relocation data  { number = 0x0004 kind = rel32 addend = -4 }
    relocation bss   { number = 0x0004 kind = rel32 addend = -4 }
    relocation abs64 { number = 0x0001 kind = absolute width = 64 }
}

# Runtime declarations define only the supported boundary. Missing operations
# are rejected during definition validation rather than silently emulated.
runtime linux_x86_64 {
    entry process_stack {
        argc = word(rsp, 0)
        argv = words(rsp + 8, argc)
        envp = words(rsp + 16 + argc * 8, until_null)
        string = nul_terminated_bytes
        result = [slice(argv), slice(envp)]
    }

    entry template {
        max_parameters = 2
        bss args 32768 16
        bss environment 32768 16
        bss environmentLength 8 8
        code = "\x48\x8b\x04\x24\x49\x89\xc0\x4c\x8d\x4c\x24\x08\x4c\x8d\x15\x00\x00\x00\x00\x4d\x89\xd4\x4d\x31\xdb\x4d\x39\xc3\x7d\x22\x4b\x8b\x3c\xd9\x49\x89\x3a\x48\x31\xc0\x80\x3c\x07\x00\x74\x05\x48\xff\xc0\xeb\xf5\x49\x89\x42\x08\x49\x83\xc2\x10\x49\xff\xc3\xeb\xd9\x4c\x8d\x4c\x24\x08\x49\x83\x39\x00\x74\x06\x49\x83\xc1\x08\xeb\xf4\x49\x83\xc1\x08\x4c\x8d\x15\x00\x00\x00\x00\x4d\x31\xdb\x4b\x8b\x3c\xd9\x48\x83\xff\x00\x74\x1e\x49\x89\x3a\x48\x31\xc0\x80\x3c\x07\x00\x74\x05\x48\xff\xc0\xeb\xf5\x49\x89\x42\x08\x49\x83\xc2\x10\x49\xff\xc3\xeb\xd8\x4c\x89\xd8\x48\x89\x05\x00\x00\x00\x00\x4c\x89\xe7\x4c\x89\xc6\x4c\x89\xc2\x48\x8d\x05\x00\x00\x00\x00\x50\x59\x48\x8b\x05\x00\x00\x00\x00\x49\x89\xc0\x49\x89\xc1"
        relocation 15 bss args
        relocation 88 bss environment
        relocation 141 bss environmentLength
        relocation 157 bss environment
        relocation 166 bss environmentLength
    }

    syscall {
        number = rax
        arguments = [rdi, rsi, rdx, r10, r8, r9]
        result = rax
        error = negative
        instruction = syscall
    }

    operation read     { number = 0  args = [fd, buffer, count] }
    operation write    { number = 1  args = [fd, buffer, count] }
    operation open     { number = 2  args = [path, flags, mode] }
    operation close    { number = 3  args = [fd] }
    operation read_at  { number = 17 args = [fd, buffer, count, offset] }
    operation write_at { number = 18 args = [fd, buffer, count, offset] }
    operation chmod    { number = 91 args = [fd, mode] }
    operation print    { use = write args = [stderr, buffer, count] }
    operation exit     { number = 60 args = [status] noreturn = true }
}

runtime win32_x86_64 {
    emit_exit = go x86WindowsExit
    emit_static_call = go x86WindowsStaticCall

    imports "kernel32.dll" = [
        CreateFileA,
        CloseHandle,
        ReadFile,
        WriteFile,
        SetFilePointer,
        GetStdHandle,
        GetCommandLineA,
        ExitProcess,
        GetEnvironmentStringsA
    ]

    io_template {
        bss count 8 8
        bss position 8 8
        read_code = "\x57\x56\x52\x51\x48\x83\x7c\x24\x18\x00\x74\x02\xeb\x18\xb9\xf6\xff\xff\xff\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\x44\x24\x18\x48\x83\x3c\x24\x00\x0f\x8c\x80\x00\x00\x00\x48\x8b\x4c\x24\x18\x31\xd2\x45\x31\xc0\x41\xb9\x01\x00\x00\x00\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\x05\x00\x00\x00\x00\x48\x8b\x4c\x24\x18\x48\x8b\x14\x24\x45\x31\xc0\x45\x31\xc9\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x8b\x4c\x24\x18\x48\x8b\x54\x24\x10\x4c\x8b\x44\x24\x08\x48\x8d\x05\x00\x00\x00\x00\x49\x89\xc1\x48\x83\xec\x28\x48\xc7\x44\x24\x20\x00\x00\x00\x00\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x83\xf8\x00\x74\x52\x48\x8b\x05\x00\x00\x00\x00\xeb\x4c\x48\x8b\x4c\x24\x18\x48\x8b\x54\x24\x10\x4c\x8b\x44\x24\x08\x48\x8d\x05\x00\x00\x00\x00\x49\x89\xc1\x48\x83\xec\x28\x48\xc7\x44\x24\x20\x00\x00\x00\x00\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x83\xf8\x00\x74\x0c\x48\x8b\x05\x00\x00\x00\x00\x48\x83\xc4\x20\xc3\x6a\xff\x58\x48\x83\xc4\x20\xc3\x6a\xff\x58\x48\x89\x05\x00\x00\x00\x00\x48\x8b\x4c\x24\x18\x48\x8b\x05\x00\x00\x00\x00\x50\x5a\x45\x31\xc0\x45\x31\xc9\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x8b\x05\x00\x00\x00\x00\x48\x83\xc4\x20\xc3"
        write_code = "\x57\x56\x52\x51\x48\x83\x7c\x24\x18\x01\x74\x0a\x48\x83\x7c\x24\x18\x02\x74\x1c\xeb\x32\xb9\xf5\xff\xff\xff\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\x44\x24\x18\xeb\x18\xb9\xf4\xff\xff\xff\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\x44\x24\x18\x48\x83\x3c\x24\x00\x0f\x8c\x80\x00\x00\x00\x48\x8b\x4c\x24\x18\x31\xd2\x45\x31\xc0\x41\xb9\x01\x00\x00\x00\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\x05\x00\x00\x00\x00\x48\x8b\x4c\x24\x18\x48\x8b\x14\x24\x45\x31\xc0\x45\x31\xc9\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x8b\x4c\x24\x18\x48\x8b\x54\x24\x10\x4c\x8b\x44\x24\x08\x48\x8d\x05\x00\x00\x00\x00\x49\x89\xc1\x48\x83\xec\x28\x48\xc7\x44\x24\x20\x00\x00\x00\x00\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x83\xf8\x00\x74\x52\x48\x8b\x05\x00\x00\x00\x00\xeb\x4c\x48\x8b\x4c\x24\x18\x48\x8b\x54\x24\x10\x4c\x8b\x44\x24\x08\x48\x8d\x05\x00\x00\x00\x00\x49\x89\xc1\x48\x83\xec\x28\x48\xc7\x44\x24\x20\x00\x00\x00\x00\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x83\xf8\x00\x74\x0c\x48\x8b\x05\x00\x00\x00\x00\x48\x83\xc4\x20\xc3\x6a\xff\x58\x48\x83\xc4\x20\xc3\x6a\xff\x58\x48\x89\x05\x00\x00\x00\x00\x48\x8b\x4c\x24\x18\x48\x8b\x05\x00\x00\x00\x00\x50\x5a\x45\x31\xc0\x45\x31\xc9\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x8b\x05\x00\x00\x00\x00\x48\x83\xc4\x20\xc3"
        read_relocation 33 import 6
        read_relocation 79 import 5
        read_relocation 90 bss position
        read_relocation 115 import 5
        read_relocation 141 bss count
        read_relocation 163 import 3
        read_relocation 179 bss count
        read_relocation 203 bss count
        read_relocation 225 import 3
        read_relocation 241 bss count
        read_relocation 264 bss count
        read_relocation 276 bss position
        read_relocation 294 import 5
        read_relocation 305 bss count
        write_relocation 38 import 6
        write_relocation 77 import 6
        write_relocation 123 import 5
        write_relocation 134 bss position
        write_relocation 159 import 5
        write_relocation 185 bss count
        write_relocation 207 import 4
        write_relocation 223 bss count
        write_relocation 247 bss count
        write_relocation 269 import 4
        write_relocation 285 bss count
        write_relocation 308 bss count
        write_relocation 320 bss position
        write_relocation 338 import 5
        write_relocation 349 bss count
    }

    entry template {
        max_parameters = 2
        bss args 32768 16
        bss argsText 32768 16
        bss argsLength 8 8
        bss environment 32768 16
        bss environmentLength 8 8
        code = "\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\xc6\x4c\x8d\x15\x00\x00\x00\x00\x48\x8d\x05\x00\x00\x00\x00\x50\x5a\x4d\x31\xdb\x80\x3e\x00\x0f\x84\x62\x00\x00\x00\x80\x3e\x20\x74\x05\x80\x3e\x09\x75\x05\x48\xff\xc6\xeb\xe8\x49\x89\x12\x31\xc9\x45\x31\xc0\x8a\x06\x3c\x00\x74\x28\x3c\x22\x75\x09\x41\x83\xf0\x01\x48\xff\xc6\xeb\xed\x41\x83\xf8\x00\x75\x08\x3c\x20\x74\x11\x3c\x09\x74\x0d\x88\x02\x48\xff\xc6\x48\xff\xc2\x48\xff\xc1\xeb\xd2\xc6\x02\x00\x48\xff\xc2\x49\x89\x4a\x08\x49\x83\xc2\x10\x49\xff\xc3\x3c\x00\x74\x08\x48\xff\xc6\xe9\x95\xff\xff\xff\x4c\x89\xd8\x48\x89\x05\x00\x00\x00\x00\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\xc6\x4c\x8d\x15\x00\x00\x00\x00\x4d\x31\xdb\x80\x3e\x00\x74\x23\x49\x89\x32\x31\xc9\x80\x3c\x0e\x00\x74\x05\x48\xff\xc1\xeb\xf5\x49\x89\x4a\x08\x48\x01\xce\x48\xff\xc6\x49\x83\xc2\x10\x49\xff\xc3\xeb\xd8\x4c\x89\xd8\x48\x89\x05\x00\x00\x00\x00\x48\x8d\x05\x00\x00\x00\x00\x50\x5f\x48\x8b\x05\x00\x00\x00\x00\x50\x5e\x50\x5a\x48\x8d\x05\x00\x00\x00\x00\x50\x59\x48\x8b\x05\x00\x00\x00\x00\x49\x89\xc0\x49\x89\xc1"
        relocation 6 import 7
        relocation 20 bss args
        relocation 27 bss argsText
        relocation 149 bss argsLength
        relocation 159 import 9
        relocation 173 bss environment
        relocation 226 bss environmentLength
        relocation 233 bss args
        relocation 242 bss argsLength
        relocation 253 bss environment
        relocation 262 bss environmentLength
    }

    entry {
        arguments.source = call GetCommandLineA
        arguments.parse = go windowsCommandLine
        environment.source = call GetEnvironmentStringsA
        environment.parse = nul_terminated_pairs
        result = [slice(arguments), slice(environment)]
    }

    operation open {
        emit = sequence x86WindowsRuntimeOpen
        call = CreateFileA
        arguments = [
            path,
            access(flags),
            share_read | share_write,
            null,
            disposition(flags),
            normal_attributes,
            null
        ]
        result = handle_or_error
    }

    operation close {
        emit = sequence x86WindowsRuntimeClose
        call = CloseHandle
        arguments = [fd]
        result = bool_or_error
    }

    operation read {
        call = ReadFile
        arguments = [fd, buffer, count, address(transferred), null]
        result = transferred_or_error
    }

    operation write {
        call = WriteFile
        arguments = [fd, buffer, count, address(transferred), null]
        result = transferred_or_error
    }

    operation read_at {
        sequence = [seek(fd, offset), read(fd, buffer, count)]
    }

    operation write_at {
        sequence = [seek(fd, offset), write(fd, buffer, count)]
    }

    operation seek {
        call = SetFilePointer
        arguments = [fd, low32(offset), address(high32(offset)), begin]
        result = position_or_error
    }

    operation print {
        sequence = [GetStdHandle(stderr), write(result, buffer, count)]
    }

    operation chmod {
        emit = sequence x86WindowsRuntimeChmod
        unsupported = "Win32 target does not expose chmod"
    }

    operation exit {
        call = ExitProcess
        arguments = [status]
        noreturn = true
    }
}

runtime linux_kernel_x86_64 {
    entry_prologue = sequence x86KernelEntryPrologue
    entry_epilogue = sequence x86KernelEntryEpilogue
    emit_callback_address = sequence x86KernelCallbackAddress
    emit_static_call = go x86KernelStaticCall
    emit_operation = go x86KernelRuntimeOperation

    entry = kernel_module_init
    exit = kernel_module_exit
    operation print { import = printk }
    operation open { unsupported = "kernel module runtime has no file API" }
    operation close { unsupported = "kernel module runtime has no file API" }
    operation read { unsupported = "kernel module runtime has no file API" }
    operation write { unsupported = "kernel module runtime has no file API" }
    operation chmod { unsupported = "kernel module runtime has no file API" }
}

abi renvo_x86_64 {
    arch = x86_64
    frame_start = sequence x86FrameStart
    frame_finish = go x86FrameFinish
    call_words = [rdi, rsi, rdx, rcx, r8, r9]
    overflow_stride = 8
    scalar_result = rax
    string_result = [rax, rdx]
    slice_result = [rax, rdx, rcx]
    hidden_result_word = 0
}

abi sysv_x86_64 {
    internal = renvo_x86_64
    arguments = [rdi, rsi, rdx, rcx, r8, r9]
    result = [rax, rdx]
    caller_saved = [rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11]
    callee_saved = [rbx, rbp, r12, r13, r14, r15]
    stack_alignment = 16
    red_zone = unused
}

abi windows_x86_64 {
    internal = renvo_x86_64
    arguments = [rcx, rdx, r8, r9]
    result = [rax, rdx]
    caller_saved = [rax, rcx, rdx, r8, r9, r10, r11]
    callee_saved = [rbx, rbp, rdi, rsi, r12, r13, r14, r15]
    stack_alignment = 16
    shadow_space = 32
    stack_probe {
        page_bytes = 4096
        direction = down
        touch_each_page = true
    }
}

target linux/amd64 {
	family = native_v1
	os = linux
    arch = x86_64
    abi = sysv_x86_64
    runtime = linux_x86_64
    executable = elf64_x86_64
    object = elf64_object_x86_64
    build_tags = ["linux", "unix", "amd64"]
    capabilities = [
        hosted, executable, object, filesystem, heap,
        argv, environment, linkstatic
    ]
}

target windows/amd64 {
	family = native_v1
	os = windows
    arch = x86_64
    abi = windows_x86_64
    runtime = win32_x86_64
    executable = pe64_x86_64
    object = coff64_object_x86_64
    subsystem = console
    build_tags = ["windows", "amd64"]
    capabilities = [
        hosted, executable, object, filesystem, heap,
        argv, environment, imports, linkstatic, windows_gui
    ]
}

target linux-kernel/amd64 {
	family = native_v1
	os = linux
    arch = x86_64
    abi = sysv_x86_64
    runtime = linux_kernel_x86_64
    object = elf64_object_x86_64
    build_tags = ["linux", "unix", "amd64", "renvo_kernel"]
    capabilities = [freestanding, kernel_module, object, imports, linkstatic]
}
