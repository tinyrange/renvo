		windowsCallImport(out:emitter, importID:int) {
			asmMovRegAbs(out, 16, importID, RTGRelocationImport)
			asmLoadRegMem(out, 16, 16, 0, 8)
			asmEmit(out, 0xd63f0200)
		}
		darwinRead(out:emitter) {
			asmMovRegReg(out, 9, 1)
			asmMovRegReg(out, 0, 3)
			asmMovRegReg(out, 1, 4)
			asmMovRegReg(out, 2, 9)
			darwinCallImport(out, "_read")
		}
		darwinWrite(out:emitter) {
			asmMovRegReg(out, 9, 1)
			asmMovRegReg(out, 0, 3)
			asmMovRegReg(out, 1, 4)
			asmMovRegReg(out, 2, 9)
			darwinCallImport(out, "_write")
		}
		darwinReadAt(out:emitter) {
			asmMovRegReg(out, 9, 1)
			asmMovRegReg(out, 10, 2)
			asmMovRegReg(out, 0, 3)
			asmMovRegReg(out, 1, 4)
			asmMovRegReg(out, 2, 9)
			asmMovRegReg(out, 3, 10)
			darwinCallImport(out, "_pread")
		}
		darwinWriteAt(out:emitter) {
			asmMovRegReg(out, 9, 1)
			asmMovRegReg(out, 10, 2)
			asmMovRegReg(out, 0, 3)
			asmMovRegReg(out, 1, 4)
			asmMovRegReg(out, 2, 9)
			asmMovRegReg(out, 3, 10)
			darwinCallImport(out, "_pwrite")
		}
		darwinOpen(out:emitter) {
			asmMovRegReg(out, 9, 1)
			asmMovRegReg(out, 0, 3)
			asmMovRegReg(out, 1, 4)
			asmPushReg(out, 9)
			darwinCallImport(out, "_open")
			asmAddRegImm(out, 31, 31, 16)
		}
		darwinClose(out:emitter) {
			asmMovRegReg(out, 0, 3)
			darwinCallImport(out, "_close")
		}
		darwinChmod(out:emitter) {
			asmMovRegReg(out, 0, 3)
			asmMovRegReg(out, 1, 4)
			darwinCallImport(out, "_fchmod")
		}
		windowsRuntimeChmod(out:emitter) {
			let failed = out.NewLabel()
			let done = out.NewLabel()
			asmMovRegReg(out, 0, 3)
			asmMovRegImm(out, 1, 0)
			asmMovRegImm(out, 2, 0)
			asmMovRegImm(out, 3, 1)
			windowsCallImport(out, 5)
			asmMovRegImm(out, 9, -1)
			asmCmpRegReg(out, 0, 9)
			jumpCondition(out, record_condition(Code:0), failed)
			asmMovRegImm(out, 0, 0)
			jump(out, done)
			out.Mark(failed)
			asmMovRegImm(out, 0, -1)
			out.Mark(done)
		}
		windowsRuntimeClose(out:emitter) {
			let failed = out.NewLabel()
			let done = out.NewLabel()
			asmMovRegReg(out, 0, 3)
			windowsCallImport(out, 2)
			asmCmpRegImm(out, 0, 0)
			jumpCondition(out, record_condition(Code:0), failed)
			asmMovRegImm(out, 0, 0)
			jump(out, done)
			out.Mark(failed)
			asmMovRegImm(out, 0, -1)
