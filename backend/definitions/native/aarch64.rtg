			loadWidth(out, destination, address, 2, true)
		}
		loadI32(out:emitter, destination:register, address:address) {
			loadWidth(out, destination, address, 4, true)
		}
		loadI8(out:emitter, destination:register, address:address) {
			loadWidth(out, destination, address, 1, true)
