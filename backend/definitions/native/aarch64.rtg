		aarch64CopyBytes(out:emitter) {
			let destination = aarch64X3
			let source = aarch64X4
			let count = aarch64Secondary
			let value = aarch64Scratch2
			let forward = out.NewLabel()
			let forwardLoop = out.NewLabel()
			let backwardLoop = out.NewLabel()
			let done = out.NewLabel()
			call aarch64Compare(out,destination,source)
			call aarch64JumpCondition(out,record_condition(Code:9),forward)
			call aarch64EmitAddress(out,aarch64Scratch,record_address(Base:source,Index:count,Scale:1,))
			call aarch64Compare(out,destination,aarch64Scratch)
			call aarch64JumpCondition(out,record_condition(Code:2),forward)
			call aarch64EmitAddress(out,source,record_address(Base:source,Index:count,Scale:1,Displacement:-1,))
			call aarch64EmitAddress(out,destination,record_address(Base:destination,Index:count,Scale:1,Displacement:-1,))
			call out.Mark(backwardLoop)
			call aarch64Compare(out,count,aarch64Zero)
			call aarch64JumpCondition(out,record_condition(Code:0),done)
			call aarch64LoadU8(out,value,record_address(Base:source))
			call aarch64StoreU8(out,record_address(Base:destination),value)
			call aarch64Decrement(out,source)
			call aarch64Decrement(out,destination)
			call aarch64Decrement(out,count)
			call aarch64Jump(out,backwardLoop)
			call out.Mark(forward)
			call out.Mark(forwardLoop)
			call aarch64Compare(out,count,aarch64Zero)
			call aarch64JumpCondition(out,record_condition(Code:0),done)
			call aarch64LoadU8(out,value,record_address(Base:source))
			call aarch64StoreU8(out,record_address(Base:destination),value)
			call aarch64Increment(out,source)
			call aarch64Increment(out,destination)
			call aarch64Decrement(out,count)
			call aarch64Jump(out,forwardLoop)
			call out.Mark(done)
