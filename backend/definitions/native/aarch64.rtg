			call renvoAarch64AsmStoreRegMem(out,9,10,0,8)
			call renvoAarch64AsmLoadRegMem(out,0,31,48,8)
			call renvoAarch64AsmMovRegAbs(out,9,positionOffset,RTGRelocationAbsoluteBSS)
			call renvoAarch64AsmLoadRegMem(out,1,9,0,8)
			call renvoAarch64AsmMovRegImm(out,2,0)
			call renvoAarch64AsmMovRegImm(out,3,0)
			call aarch64WindowsCallImport(out,5)
			call renvoAarch64AsmMovRegAbs(out,9,resultOffset,RTGRelocationAbsoluteBSS)
			call renvoAarch64AsmLoadRegMem(out,0,9,0,8)
			call aarch64Jump(out,done)
			call out.Mark(positionFailed)
			call renvoAarch64AsmMovRegImm(out,0,-1)
			call aarch64Jump(out,done)
			call out.Mark(sequential)
			call aarch64WindowsReadWriteCall(out,3,countOffset)
			call renvoAarch64AsmCmpRegImm(out,0,0)
			call aarch64JumpCondition(out,record_condition(Code:0),failed)
			call renvoAarch64AsmMovRegAbs(out,9,countOffset,RTGRelocationAbsoluteBSS)
			call renvoAarch64AsmLoadRegMem(out,0,9,0,8)
			call aarch64Jump(out,done)
			call out.Mark(failed)
			call renvoAarch64AsmMovRegImm(out,0,-1)
			call out.Mark(done)
			call renvoAarch64AsmAddRegImm(out,31,31,64)
			call renvoAarch64AsmPopReg(out,30)
			call renvoAarch64AsmRet(out)
			call out.Mark(after)
			call aarch64Call(out,helper)
		}
		aarch64WindowsWriteAt(out:emitter) {
			let helper = out.NewLabel()
			let after = out.NewLabel()
			let countOffset = out.ReserveBSS(8,8)
			let positionOffset = out.ReserveBSS(8,8)
			let resultOffset = out.ReserveBSS(8,8)
			let standard = out.NewLabel()
			let standardError = out.NewLabel()
			let handleReady = out.NewLabel()
			let sequential = out.NewLabel()
			let positionFailed = out.NewLabel()
			let ioFailed = out.NewLabel()
			let restore = out.NewLabel()
			let failed = out.NewLabel()
			let done = out.NewLabel()
			call aarch64Jump(out,after)
			call out.Mark(helper)
			call renvoAarch64AsmPushReg(out,30)
			call renvoAarch64AsmPushReg(out,3)
			call renvoAarch64AsmPushReg(out,4)
			call renvoAarch64AsmPushReg(out,2)
			call renvoAarch64AsmPushReg(out,1)
			call renvoAarch64AsmLoadRegMem(out,9,31,48,8)
			call renvoAarch64AsmCmpRegImm(out,9,1)
			call aarch64JumpCondition(out,record_condition(Code:0),standard)
			call renvoAarch64AsmCmpRegImm(out,9,2)
			call aarch64JumpCondition(out,record_condition(Code:0),standardError)
			call renvoAarch64AsmStoreRegMem(out,9,31,48,8)
			call aarch64Jump(out,handleReady)
			call out.Mark(standard)
			let standardHandle = -10
			set standardHandle = -11
			call renvoAarch64AsmMovRegImm(out,0,standardHandle)
			call aarch64WindowsCallImport(out,6)
			call renvoAarch64AsmStoreRegMem(out,0,31,48,8)
			call aarch64Jump(out,handleReady)
			call out.Mark(standardError)
			call renvoAarch64AsmMovRegImm(out,0,-12)
			call aarch64WindowsCallImport(out,6)
			call renvoAarch64AsmStoreRegMem(out,0,31,48,8)
			call out.Mark(handleReady)
			call renvoAarch64AsmLoadRegMem(out,9,31,0,8)
			call renvoAarch64AsmCmpRegImm(out,9,0)
			call aarch64JumpCondition(out,record_condition(Code:11),sequential)
			call renvoAarch64AsmLoadRegMem(out,0,31,48,8)
			call renvoAarch64AsmMovRegImm(out,1,0)
			call renvoAarch64AsmMovRegImm(out,2,0)
			call renvoAarch64AsmMovRegImm(out,3,1)
			call aarch64WindowsCallImport(out,5)
			call renvoAarch64AsmMovRegImm(out,9,0xffffffff)
			call renvoAarch64AsmCmpRegReg(out,0,9)
			call aarch64JumpCondition(out,record_condition(Code:0),positionFailed)
			call renvoAarch64AsmMovRegAbs(out,9,positionOffset,RTGRelocationAbsoluteBSS)
			call renvoAarch64AsmStoreRegMem(out,0,9,0,8)
			call renvoAarch64AsmLoadRegMem(out,0,31,48,8)
			call renvoAarch64AsmLoadRegMem(out,1,31,0,8)
			call renvoAarch64AsmMovRegImm(out,2,0)
			call renvoAarch64AsmMovRegImm(out,3,0)
			call aarch64WindowsCallImport(out,5)
			call renvoAarch64AsmMovRegImm(out,9,0xffffffff)
			call renvoAarch64AsmCmpRegReg(out,0,9)
			call aarch64JumpCondition(out,record_condition(Code:0),ioFailed)
			call aarch64WindowsReadWriteCall(out,4,countOffset)
			call renvoAarch64AsmCmpRegImm(out,0,0)
			call aarch64JumpCondition(out,record_condition(Code:0),ioFailed)
			call renvoAarch64AsmMovRegAbs(out,9,countOffset,RTGRelocationAbsoluteBSS)
			call renvoAarch64AsmLoadRegMem(out,9,9,0,8)
			call aarch64Jump(out,restore)
			call out.Mark(ioFailed)
			call renvoAarch64AsmMovRegImm(out,9,-1)
			call out.Mark(restore)
			call renvoAarch64AsmMovRegAbs(out,10,resultOffset,RTGRelocationAbsoluteBSS)
			call renvoAarch64AsmStoreRegMem(out,9,10,0,8)
			call renvoAarch64AsmLoadRegMem(out,0,31,48,8)
			call renvoAarch64AsmMovRegAbs(out,9,positionOffset,RTGRelocationAbsoluteBSS)
			call renvoAarch64AsmLoadRegMem(out,1,9,0,8)
			call renvoAarch64AsmMovRegImm(out,2,0)
			call renvoAarch64AsmMovRegImm(out,3,0)
			call aarch64WindowsCallImport(out,5)
			call renvoAarch64AsmMovRegAbs(out,9,resultOffset,RTGRelocationAbsoluteBSS)
			call renvoAarch64AsmLoadRegMem(out,0,9,0,8)
			call aarch64Jump(out,done)
			call out.Mark(positionFailed)
			call renvoAarch64AsmMovRegImm(out,0,-1)
			call aarch64Jump(out,done)
			call out.Mark(sequential)
			call aarch64WindowsReadWriteCall(out,4,countOffset)
			call renvoAarch64AsmCmpRegImm(out,0,0)
			call aarch64JumpCondition(out,record_condition(Code:0),failed)
			call renvoAarch64AsmMovRegAbs(out,9,countOffset,RTGRelocationAbsoluteBSS)
			call renvoAarch64AsmLoadRegMem(out,0,9,0,8)
			call aarch64Jump(out,done)
			call out.Mark(failed)
			call renvoAarch64AsmMovRegImm(out,0,-1)
			call out.Mark(done)
			call renvoAarch64AsmAddRegImm(out,31,31,64)
			call renvoAarch64AsmPopReg(out,30)
			call renvoAarch64AsmRet(out)
			call out.Mark(after)
			call aarch64Call(out,helper)
		}
}
}

abi aapcs64 {
	arch = aarch64
	frame_start = sequence aarch64FrameStart
	frame_finish = go aarch64FrameFinish
	arguments = [x0, x1, x2, x3, x4, x5, x6, x7]
	result = [x0, x1]
	stack_alignment = 16
}

abi windows_arm64 {
	arch = aarch64
	frame_start = sequence aarch64FrameStart
	frame_finish = go aarch64FrameFinish
	arguments = [x0, x1, x2, x3, x4, x5, x6, x7]
	result = [x0, x1]
	stack_alignment = 16
}

runtime linux_aarch64 {
		entry sequence aarch64LinuxEntry {
		max_parameters = 2
		bss args 32768 16
		bss environment 32768 16
		bss environmentLength 8 8
	}

	syscall {
		number = x8
		arguments = [x0, x1, x2, x3, x4, x5]
		result = x0
		instruction = svc
	}
	operation read { number = 63 args = [fd, buffer, count] }
	operation write { number = 64 args = [fd, buffer, count] }
	operation read_at { number = 67 args = [fd, buffer, count, offset] }
	operation write_at { number = 68 args = [fd, buffer, count, offset] }
	operation open { number = 56 args = [dirfd, path, flags, mode] }
	operation close { number = 57 args = [fd] }
	operation chmod { number = 52 args = [fd, mode] }
	operation print { use = write args = [stderr, buffer, count] }
	operation exit { number = 93 args = [status] noreturn = true }
}

runtime darwin_arm64 {
	entry sequence aarch64DarwinEntry {
		max_parameters = 2
		requires_state = true
		bss args 32768 16
		bss environment 32768 16
	}
	entry_state_bytes = 24
	emit_exit = sequence aarch64DarwinExit
	operation read { emit = sequence aarch64DarwinRead }
	operation write { emit = sequence aarch64DarwinWrite }
	operation read_at { emit = sequence aarch64DarwinReadAt }
	operation write_at { emit = sequence aarch64DarwinWriteAt }
	operation open { emit = sequence aarch64DarwinOpen }
	operation close { emit = sequence aarch64DarwinClose }
	operation chmod { emit = sequence aarch64DarwinChmod }
	operation print { use = write }
}

runtime windows_arm64 {
		entry sequence aarch64WindowsEntry {
		max_parameters = 2
		bss args 32768 16
		bss argsText 32768 16
		bss argsLength 8 8
		bss environment 32768 16
		bss environmentLength 8 8
	}
	emit_exit = sequence aarch64WindowsExit
	emit_static_call = go aarch64WindowsStaticCall
	imports "kernel32.dll" = [
		CreateFileA, CloseHandle, ReadFile, WriteFile, SetFilePointer,
		GetStdHandle, GetCommandLineA, ExitProcess, GetEnvironmentStringsA
	]
	operation read { emit = sequence aarch64WindowsRead }
	operation write { emit = sequence aarch64WindowsWrite }
	operation read_at { emit = sequence aarch64WindowsReadAt }
	operation write_at { emit = sequence aarch64WindowsWriteAt }
	operation open { emit = sequence aarch64WindowsRuntimeOpen }
	operation close { emit = sequence aarch64WindowsRuntimeClose }
	operation chmod { emit = sequence aarch64WindowsRuntimeChmod }
	operation print { use = write }
}

format elf64_aarch64 {
	byte_order = little
	address_bits = 64
	kind = elf
	machine = 183
	code_offset = 176
	file_alignment = 0x1000
	flags = 0
	image = elf_executable
	patch_absolute = aarch64_page_address
}

format macho64_arm64 {
	byte_order = little
	address_bits = 64
	kind = "mach-o"
	cpu = 0x0100000c
	code_offset = 0x1000
	image = sequence aarch64MachImage
}

format pe64_arm64 {
	byte_order = little
	address_bits = 64
	kind = pe
	machine = 0xaa64
	code_offset = 0x1000
	image = pe_executable
	patch_image = go aarch64PEPatch
	image_base = 0x40000000
	image_base_high = 1
	file_alignment = 0x200
	section_alignment = 0x1000
	coff_characteristics = 0x22
	dll_characteristics = 0x8100
	os_version_major = 6
	os_version_minor = 1
	image_version_major = 1
	image_version_minor = 0
	subsystem_version_major = 6
	subsystem_version_minor = 1
	stack_reserve = 0x800000
	stack_commit = 0x1000
	heap_reserve = 0x100000
	heap_commit = 0x1000
}

target linux/aarch64 {
	family = native_v1
	os = linux
	arch = aarch64
	abi = aapcs64
	runtime = linux_aarch64
	executable = elf64_aarch64
	build_tags = [linux, unix, aarch64, arm64]
	capabilities = [hosted, executable, filesystem, heap, argv, environment]
}

target darwin/arm64 {
	family = native_v1
	os = darwin
	arch = aarch64
	abi = aapcs64
	runtime = darwin_arm64
	executable = macho64_arm64
	build_tags = [darwin, unix, aarch64, arm64]
	capabilities = [hosted, executable, filesystem, heap, argv, environment]
}

target windows/arm64 {
	family = native_v1
	os = windows
	arch = aarch64
	abi = windows_arm64
	runtime = windows_arm64
	executable = pe64_arm64
	build_tags = [windows, aarch64, arm64]
	capabilities = [hosted, executable, filesystem, heap, argv, environment, windows_gui]
}
