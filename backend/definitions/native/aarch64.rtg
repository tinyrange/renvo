# The AArch64 slice owns its direct emitter and every advertised AArch64
# composition. Its explicit exports are the stable production contract used by
# target-neutral lowering.
go backend {
	const machCodeOffset = 0x1000
	const machImageBase = 0x100000000
	const machPageSize = 0x4000
	const machLibSystem = "/usr/lib/libSystem.B.dylib"

	func machAppendStringZ(out []byte, value string) []byte {
		for i := 0; i < len(value); i++ {
			out = append(out, value[i])
		}
		return append(out, 0)
	}

	func machAppendUntil(out []byte, size int) []byte {
		for len(out) < size {
			out = append(out, 0)
		}
		return out
	}

	func machAppendULEB(out []byte, value int) []byte {
		for {
			b := byte(value & 127)
			value = value >> 7
			if value != 0 {
				b = b | 128
			}
			out = append(out, b)
			if value == 0 {
				return out
			}
		}
	}

	func machAppendName16(out []byte, name string) []byte {
		for i := 0; i < 16; i++ {
			if i < len(name) {
				out = append(out, name[i])
			} else {
				out = append(out, 0)
			}
		}
		return out
	}

	func machExtraDylibs(out *RTGEmitter) []string {
		var dylibs []string
		for i := 0; i < out.DynamicImportCount(); i++ {
			dylib := out.DynamicImportLibrary(i)
			if dylib == machLibSystem {
				continue
			}
			found := false
			for j := 0; j < len(dylibs); j++ {
				if dylibs[j] == dylib {
					found = true
				}
			}
			if !found {
				dylibs = append(dylibs, dylib)
			}
		}
		return dylibs
	}

	func machDylibOrdinal(out *RTGEmitter, dylib string) int {
		if dylib == machLibSystem {
			return 1
		}
		dylibs := machExtraDylibs(out)
		for i := 0; i < len(dylibs); i++ {
			if dylibs[i] == dylib {
				return i + 2
			}
		}
		return 0
	}

	type machImportLayout struct {
		got []int
	}

	func machPatchAbsoluteRelocations(
		out *RTGEmitter, dataFileOff int, dataSize int,
	) {
		for i := 0; i < out.AbsoluteRelocationCount(); i++ {
			at := out.AbsoluteRelocationOffset(i)
			addend := out.AbsoluteRelocationAddend(i)
			kind := out.AbsoluteRelocationKind(i)
			target := dataFileOff + addend
			if kind == RTGRelocationAbsoluteBSS {
				target = dataFileOff + dataSize + addend
			}
			insn := RTGGet32At(out.Code(), at)
			reg := insn & 31
			address := machImageBase + target
			pc := machImageBase + machCodeOffset + at
			delta := (address >> 12) - (pc >> 12)
			imm := delta & 0x1fffff
			out.PatchUint32(at,
				0x90000000|((imm&3)<<29)|
					(((imm>>2)&0x7ffff)<<5)|reg)
			out.PatchUint32(at+4,
				0x91000000|((address&0xfff)<<10)|(reg<<5)|reg)
			out.PatchUint32(at+8, 0xd503201f)
			out.PatchUint32(at+12, 0xd503201f)
		}
	}

	func machPrepareImports(
		out *RTGEmitter,
	) machImportLayout {
		var layout machImportLayout
		count := out.DynamicImportCount()
		layout.got = make([]int, count)
		stubs := make([]int, count)
		for i := 0; i < count; i++ {
			asmAlign(out)
			out.Mark(out.DynamicImportLabel(i))
			stubs[i] = out.Len()
			asmEmit(out, 0x90000010)
			asmEmit(out, 0xf9400210)
			asmEmit(out, 0xd61f0200)
		}
		out.Patch()
		dataFileOff := RTGAlignValue(
			machCodeOffset+out.Len(), machPageSize)
		data := out.Data()
		data = machAppendUntil(data, RTGAlignValue(len(data), 8))
		for i := 0; i < count; i++ {
			layout.got[i] = len(data)
			data = machAppend64(data, 0)
		}
		data = machAppendUntil(
			data, RTGAlignValue(len(data), machPageSize))
		out.SetData(data)
		machPatchAbsoluteRelocations(
			out, dataFileOff, len(data))
		for i := 0; i < count; i++ {
			stubAt := stubs[i]
			target := machImageBase +
				dataFileOff + layout.got[i]
			pc := machImageBase +
				machCodeOffset + stubAt
			machPatchADRP(out, stubAt, pc, target)
			pageOff := target & 0xfff
			out.PatchUint32(
				stubAt+4, 0xf9400210|((pageOff/8)<<10))
		}
		return layout
	}

	func machBuildBindData(
		out *RTGEmitter, got []int,
	) []byte {
		bind := make([]byte, 0, 256)
		bind = append(bind, 0x51)
		for i := 0; i < out.DynamicImportCount(); i++ {
			ordinal := machDylibOrdinal(
				out, out.DynamicImportLibrary(i))
			if ordinal < 16 {
				bind = append(bind, byte(0x10|ordinal))
			} else {
				bind = append(bind, 0x20)
				bind = machAppendULEB(bind, ordinal)
			}
			bind = append(bind, 0x40)
			bind = machAppendStringZ(
				bind, out.DynamicImportName(i))
			bind = append(bind, 0x72)
			bind = machAppendULEB(bind, got[i])
			bind = append(bind, 0x90)
		}
		return append(bind, 0)
	}

	func machBuildStringTable(out *RTGEmitter) []byte {
		strtab := make([]byte, 0, 128)
		strtab = append(strtab, 0)
		strtab = machAppendStringZ(strtab, "_main")
		for i := 0; i < out.DynamicImportCount(); i++ {
			strtab = machAppendStringZ(
				strtab, out.DynamicImportName(i))
		}
		return strtab
	}

	func machBuildSymbolTable(out *RTGEmitter) []byte {
		count := out.DynamicImportCount()
		symtab := make([]byte, 0, 16*(count+1))
		symtab = machAppend32(symtab, 1)
		symtab = append(symtab, 0x0f, 1)
		symtab = machAppend16(symtab, 0)
		symtab = machAppend64(
			symtab, machImageBase+machCodeOffset)
		nameOff := 7
		for i := 0; i < count; i++ {
			symtab = machAppend32(symtab, nameOff)
			symtab = append(symtab, 1, 0)
			symtab = machAppend16(symtab, 0x100)
			symtab = machAppend64(symtab, 0)
			nameOff += len(out.DynamicImportName(i)) + 1
		}
		return symtab
	}

	func machHeader(
		out *RTGEmitter,
		textFileSize int,
		dataFileOff int,
		dataFileSize int,
		dataVMSize int,
		linkeditOff int,
		linkeditSize int,
		bindOff int,
		bindSize int,
		symOff int,
		symbolCount int,
		strOff int,
		strSize int,
		undefinedCount int,
		sigOff int,
		sigSize int,
	) []byte {
		dylibs := machExtraDylibs(out)
		commandSize := 856
		for i := 0; i < len(dylibs); i++ {
			commandSize += machDylibCommandSize(dylibs[i])
		}
		header := make([]byte, 0, machCodeOffset)
		header = machAppend32(header, 0xfeedfacf)
		header = machAppend32(header, 0x0100000c)
		header = machAppend32(header, 0)
		header = machAppend32(header, 2)
		header = machAppend32(header, 13+len(dylibs))
		header = machAppend32(header, commandSize)
		header = machAppend32(header, 0x200085)
		header = machAppend32(header, 0)
		header = machAppendSegment64(
			header, "__PAGEZERO", 0, machImageBase,
			0, 0, 0, 0)
		header = machAppendTextSegment(
			header, len(out.Code()), textFileSize)
		header = machAppendDataSegment(
			header, dataFileOff, dataFileSize, out.BSSSize())
		header = machAppendSegment64(
			header,
			"__LINKEDIT",
			machImageBase+dataFileOff+dataVMSize,
			RTGAlignValue(linkeditSize, machPageSize),
			linkeditOff,
			linkeditSize,
			1,
			1,
		)
		header = machAppend32(header, 0x80000022)
		header = machAppend32(header, 48)
		header = machAppend32(header, 0)
		header = machAppend32(header, 0)
		header = machAppend32(header, bindOff)
		header = machAppend32(header, bindSize)
		for i := 0; i < 6; i++ {
			header = machAppend32(header, 0)
		}
		header = machAppend32(header, 0x02)
		header = machAppend32(header, 24)
		header = machAppend32(header, symOff)
		header = machAppend32(header, symbolCount)
		header = machAppend32(header, strOff)
		header = machAppend32(header, strSize)
		header = machAppend32(header, 0x0b)
		header = machAppend32(header, 80)
		header = machAppend32(header, 0)
		header = machAppend32(header, 0)
		header = machAppend32(header, 0)
		header = machAppend32(header, 1)
		header = machAppend32(header, 1)
		header = machAppend32(header, undefinedCount)
		for i := 0; i < 12; i++ {
			header = machAppend32(header, 0)
		}
		cmdStart := len(header)
		header = machAppend32(header, 0x0e)
		header = machAppend32(header, 32)
		header = machAppend32(header, 12)
		header = machAppendStringZ(header, "/usr/lib/dyld")
		header = machAppendUntil(header, cmdStart+32)
		header = machAppendDylibCommand(
			header, machLibSystem)
		for i := 0; i < len(dylibs); i++ {
			header = machAppendDylibCommand(
				header, dylibs[i])
		}
		header = machAppend32(header, 0x1b)
		header = machAppend32(header, 24)
		header = machAppend32(header, 0x52544758)
		header = machAppend32(header, 0x44415257)
		header = machAppend32(header, 0x494e4152)
		header = machAppend32(header, 0x4d363400)
		header = machAppend32(header, 0x32)
		header = machAppend32(header, 24)
		header = machAppend32(header, 1)
		header = machAppend32(header, 0x000b0000)
		header = machAppend32(header, 0x000b0000)
		header = machAppend32(header, 0)
		header = machAppend32(header, 0x80000028)
		header = machAppend32(header, 24)
		header = machAppend64(header, machCodeOffset)
		header = machAppend64(header, 0)
		header = machAppend32(header, 0x1d)
		header = machAppend32(header, 16)
		header = machAppend32(header, sigOff)
		header = machAppend32(header, sigSize)
		return machAppendUntil(header, machCodeOffset)
	}

	func machSHA256Schedule(
		message []byte, chunk int, words []int,
	) {
		for i := 0; i < 16; i++ {
			at := chunk + i*4
			word := int(message[at]) << 24
			word = word | (int(message[at+1]) << 16)
			word = word | (int(message[at+2]) << 8)
			word = word | int(message[at+3])
			words[i] = word & 0xffffffff
		}
		for i := 16; i < 64; i++ {
			x := words[i-15] & 0xffffffff
			y := words[i-2] & 0xffffffff
			s0 := ((x >> 7) | ((x << 25) & 0xffffffff))
			s0 = s0 ^ ((x >> 18) | ((x << 14) & 0xffffffff))
			s0 = s0 ^ (x >> 3)
			s1 := ((y >> 17) | ((y << 15) & 0xffffffff))
			s1 = s1 ^ ((y >> 19) | ((y << 13) & 0xffffffff))
			s1 = s1 ^ (y >> 10)
			word := words[i-16] + s0
			word = word + words[i-7] + s1
			words[i] = word & 0xffffffff
		}
	}

	func machSHA256Rounds(
		words []int, constants []int, values []int,
	) {
		a := values[0]
		b := values[1]
		c := values[2]
		d := values[3]
		e := values[4]
		f := values[5]
		g := values[6]
		h := values[7]
		for i := 0; i < 64; i++ {
			e32 := e & 0xffffffff
			a32 := a & 0xffffffff
			s1 := (e32 >> 6) | ((e32 << 26) & 0xffffffff)
			s1 = s1 ^ ((e32 >> 11) | ((e32 << 21) & 0xffffffff))
			s1 = s1 ^ ((e32 >> 25) | ((e32 << 7) & 0xffffffff))
			choose := (e & f) ^ ((e ^ 0xffffffff) & g)
			t1 := h + s1 + choose
			t1 = (t1 + constants[i] + words[i]) & 0xffffffff
			s0 := (a32 >> 2) | ((a32 << 30) & 0xffffffff)
			s0 = s0 ^ ((a32 >> 13) | ((a32 << 19) & 0xffffffff))
			s0 = s0 ^ ((a32 >> 22) | ((a32 << 10) & 0xffffffff))
			majority := (a & b) ^ (a & c) ^ (b & c)
			t2 := (s0 + majority) & 0xffffffff
			h = g
			g = f
			f = e
			e = (d + t1) & 0xffffffff
			d = c
			c = b
			b = a
			a = (t1 + t2) & 0xffffffff
		}
		values[0] = (values[0] + a) & 0xffffffff
		values[1] = (values[1] + b) & 0xffffffff
		values[2] = (values[2] + c) & 0xffffffff
		values[3] = (values[3] + d) & 0xffffffff
		values[4] = (values[4] + e) & 0xffffffff
		values[5] = (values[5] + f) & 0xffffffff
		values[6] = (values[6] + g) & 0xffffffff
		values[7] = (values[7] + h) & 0xffffffff
	}

	func machSHA256(data []byte) []byte {
		messageSize := len(data) + 1 + 8
		messageSize = RTGAlignValue(messageSize, 64)
		message := make([]byte, messageSize)
		for i := 0; i < len(data); i++ {
			message[i] = data[i]
		}
		message[len(data)] = 0x80
		bits := len(data) * 8
		for i := 0; i < 8; i++ {
			message[messageSize-1-i] = byte(bits >> (i * 8))
		}
		values := []int{
			0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
			0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
		}
		constants := machSHA256Constants()
		words := make([]int, 64)
		for chunk := 0; chunk < len(message); chunk += 64 {
			machSHA256Schedule(message, chunk, words)
			machSHA256Rounds(words, constants, values)
		}
		hash := make([]byte, 0, 32)
		for i := 0; i < len(values); i++ {
			hash = append(hash, byte(values[i]>>24))
			hash = append(hash, byte(values[i]>>16))
			hash = append(hash, byte(values[i]>>8))
			hash = append(hash, byte(values[i]))
		}
		return hash
	}

	func machCodeSignature(
		code []byte, identifier string, executableLimit int,
	) []byte {
		slots := (len(code) + 16383) / 16384
		identifierOffset := 88
		hashOffset := identifierOffset + len(identifier) + 1
		codeDirectorySize := hashOffset + slots*32
		totalSize := 20 + codeDirectorySize
		signature := make([]byte, 0, totalSize)
		signature = machAppendBE32(signature, 0xfade0cc0)
		signature = machAppendBE32(signature, totalSize)
		signature = machAppendBE32(signature, 1)
		signature = machAppendBE32(signature, 0)
		signature = machAppendBE32(signature, 20)
		signature = machAppendBE32(signature, 0xfade0c02)
		signature = machAppendBE32(
			signature, codeDirectorySize)
		signature = machAppendBE32(signature, 0x20400)
		signature = machAppendBE32(signature, 0x2)
		signature = machAppendBE32(signature, hashOffset)
		signature = machAppendBE32(
			signature, identifierOffset)
		signature = machAppendBE32(signature, 0)
		signature = machAppendBE32(signature, slots)
		signature = machAppendBE32(signature, len(code))
		signature = append(signature, 32, 2, 0, 14)
		signature = machAppendBE32(signature, 0)
		signature = machAppendBE32(signature, 0)
		signature = machAppendBE32(signature, 0)
		signature = machAppendBE32(signature, 0)
		signature = machAppendBE64(signature, 0)
		signature = machAppendBE64(signature, 0)
		signature = machAppendBE64(
			signature, executableLimit)
		signature = machAppendBE64(signature, 1)
		for i := 0; i < len(identifier); i++ {
			signature = append(signature, identifier[i])
		}
		signature = append(signature, 0)
		for slot := 0; slot < slots; slot++ {
			start := slot * 16384
			end := start + 16384
			if end > len(code) {
				end = len(code)
			}
			hash := machSHA256(code[start:end])
			signature = append(signature, hash...)
		}
		return signature
	}

	func pEPatch(out *RTGEmitter, dataRVA int, dataSize int, iat []int) {
		for i := 0; i < out.AbsoluteRelocationCount(); i++ {
			at := out.AbsoluteRelocationOffset(i)
			addend := out.AbsoluteRelocationAddend(i)
			kind := out.AbsoluteRelocationKind(i)
			target := dataRVA + addend
			if kind == RTGRelocationAbsoluteBSS {
				target = dataRVA + dataSize + addend
			} else if kind == RTGRelocationImport {
				if addend > 0 && addend < len(iat) {
					target = iat[addend]
				}
			}
			insn := RTGGet32At(out.Code(), at)
			reg := insn & 31
			pc := 0x1000 + at
			delta := (target >> 12) - (pc >> 12)
			imm := delta & 0x1fffff
			out.PatchUint32(at, 0x90000000|((imm&3)<<29)|(((imm>>2)&0x7ffff)<<5)|reg)
			out.PatchUint32(at+4, 0x91000000|((target&0xfff)<<10)|(reg<<5)|reg)
			out.PatchUint32(at+8, 0xd503201f)
			out.PatchUint32(at+12, 0xd503201f)
		}
	}

	func windowsStaticCall(out *RTGEmitter, importID int, wordCount int) {
		registerWords := wordCount
		if registerWords > 8 {
			registerWords = 8
		}
		for i := 0; i < registerWords; i++ {
			asmPopReg(out, i)
		}
		stackWords := wordCount - registerWords
		asmEmit(out, 0x910003e9)
		savedSPOff := stackWords * 8
		allocation := RTGAlignValue(savedSPOff+8, 16)
		asmAddRegImm(out, 31, 31, -allocation)
		for i := 0; i < stackWords; i++ {
			asmLoadRegMem(out, 10, 9, i*16, 8)
			asmStoreRegMem(out, 10, 31, i*8, 8)
		}
		asmStoreRegMem(out, 9, 31, savedSPOff, 8)
		windowsCallImport(out, importID)
		asmMovRegReg(out, 10, 0)
		asmLoadRegMem(out, 9, 31, savedSPOff, 8)
		asmEmit(out, 0x9100013f)
		asmAddRegImm(out, 31, 31, stackWords*16)
		asmMovRegReg(out, 0, 10)
	}

	func asmAlign(a *RTGEmitter) {
		for a.Len()%4 != 0 {
			RTGByte(a, 0)
		}
	}

	func asmMovRegReg(a *RTGEmitter, dst int, src int) {
		if dst == src {
			return
		}
		asmEmit(a, 0xaa0003e0|(src<<16)|dst)
	}

	func asmMovRegImm(a *RTGEmitter, reg int, imm int) {
		if imm < 0 {
			inv := -imm - 1
			part := inv & 65535
			asmEmit(a, 0x92800000|(part<<5)|reg)
			for i := 1; i < 4; i++ {
				targetPart := (imm >> (i * 16)) & 65535
				if targetPart != 65535 {
					asmEmit(a, 0xf2800000|(i<<21)|(targetPart<<5)|reg)
				}
			}
			return
		}
		part := imm & 65535
		asmEmit(a, 0xd2800000|(part<<5)|reg)
		for i := 1; i < 4; i++ {
			part = (imm >> (i * 16)) & 65535
			if part != 0 {
				asmEmit(a, 0xf2800000|(i<<21)|(part<<5)|reg)
			}
		}
	}

	func asmPatchMovRegImmAt(a *RTGEmitter, at int, reg int, imm int) {
		part := imm & 65535
		a.PatchUint32(at, 0xd2800000|(part<<5)|reg)
		for i := 1; i < 4; i++ {
			part = (imm >> (i * 16)) & 65535
			a.PatchUint32(at+i*4, 0xf2800000|(i<<21)|(part<<5)|reg)
		}
	}

	func asmAddRegImm(a *RTGEmitter, dst int, src int, imm int) {
		if imm == 0 {
			asmMovRegReg(a, dst, src)
			return
		}
		op := 0x91000000
		if imm < 0 {
			op = 0xd1000000
			imm = -imm
		}
		cur := src
		for imm > 0 {
			shift := 0
			chunk := imm
			if chunk > 4095 {
				chunk = imm / 4096
				if chunk > 4095 {
					chunk = 4095
				}
				shift = 1
				imm = imm - chunk*4096
			} else {
				imm = 0
			}
			asmEmit(a, op|(shift<<22)|(chunk<<10)|(cur<<5)|dst)
			cur = dst
		}
	}

	func asmAddr(a *RTGEmitter, base int, disp int) int {
		if disp == 0 {
			return base
		}
		asmAddRegImm(a, address.Code, base, disp)
		return address.Code
	}

	func asmLoadRegMem(a *RTGEmitter, dst int, base int, disp int, size int) {
		if disp != 0 && disp >= -256 && disp <= 255 {
			imm := (disp & 511) << 12
			if size == 1 {
				asmEmit(a, 0x38400000|imm|(base<<5)|dst)
				return
			}
			if size == 2 {
				asmEmit(a, 0x78400000|imm|(base<<5)|dst)
				return
			}
			if size == 4 {
				asmEmit(a, 0xb8400000|imm|(base<<5)|dst)
				return
			}
			asmEmit(a, 0xf8400000|imm|(base<<5)|dst)
			return
		}
		addr := asmAddr(a, base, disp)
		if size == 1 {
			asmEmit(a, 0x39400000|(addr<<5)|dst)
			return
		}
		if size == 2 {
			asmEmit(a, 0x79800000|(addr<<5)|dst)
			return
		}
		if size == 4 {
			asmEmit(a, 0xb9800000|(addr<<5)|dst)
			return
		}
		asmEmit(a, 0xf9400000|(addr<<5)|dst)
	}

	func asmStoreRegMem(a *RTGEmitter, src int, base int, disp int, size int) {
		if disp != 0 && disp >= -256 && disp <= 255 {
			imm := (disp & 511) << 12
			if size == 1 {
				asmEmit(a, 0x38000000|imm|(base<<5)|src)
				return
			}
			if size == 2 {
				asmEmit(a, 0x78000000|imm|(base<<5)|src)
				return
			}
			if size == 4 {
				asmEmit(a, 0xb8000000|imm|(base<<5)|src)
				return
			}
			asmEmit(a, 0xf8000000|imm|(base<<5)|src)
			return
		}
		addr := asmAddr(a, base, disp)
		if size == 1 {
			asmEmit(a, 0x39000000|(addr<<5)|src)
			return
		}
		if size == 2 {
			asmEmit(a, 0x79000000|(addr<<5)|src)
			return
		}
		if size == 4 {
			asmEmit(a, 0xb9000000|(addr<<5)|src)
			return
		}
		asmEmit(a, 0xf9000000|(addr<<5)|src)
	}

	func asmStackMem(a *RTGEmitter, offset int, base int, disp8 int, disp32 int) {
		if base == 0x8948 && disp8 == 0x45 {
			asmStoreRegStack(a, primary.Code, offset)
			return
		}
		if base == 0x8948 && disp8 == 0x55 {
			asmStoreRegStack(a, secondary.Code, offset)
			return
		}
		if base == 0x8948 && disp8 == 0x4d {
			asmStoreRegStack(a, tertiary.Code, offset)
			return
		}
		if base == 0x8b48 && disp8 == 0x45 {
			asmLoadRegStack(a, primary.Code, offset)
			return
		}
		if base == 0x8b48 && disp8 == 0x55 {
			asmLoadRegStack(a, secondary.Code, offset)
			return
		}
		if base == 0x8b48 && disp8 == 0x4d {
			asmLoadRegStack(a, tertiary.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x45 {
			asmLeaRegStack(a, primary.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x55 {
			asmLeaRegStack(a, secondary.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x7d {
			asmLeaRegStack(a, x3.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x75 {
			asmLeaRegStack(a, x4.Code, offset)
			return
		}
	}

	func asmMemDisp(a *RTGEmitter, disp int, op int, disp8 int, disp32 int) {
		if op == 0x8b48 && disp8 == 0x4a {
			asmLoadRegMem(a, tertiary.Code, secondary.Code, disp, 8)
			return
		}
		if op == 0x8b48 && disp8 == 0x52 {
			asmLoadRegMem(a, secondary.Code, secondary.Code, disp, 8)
			return
		}
	}

	func asmLoadRaxIndexRcxSize(a *RTGEmitter, size int) {
		shift := 3
		if size == 1 {
			shift = 0
		}
		if size == 2 {
			shift = 1
		}
		if size == 4 {
			shift = 2
		}
		asmAddRegRegShift(a, address.Code, primary.Code, tertiary.Code, shift)
		asmLoadRegMem(a, primary.Code, address.Code, 0, size)
	}

	func asmNormalizeRaxForKind(a *RTGEmitter, kind int) {
		if kind == RTGScalarByte {
			asmEmit(a, 0x92401c00)
			return
		}
		if kind == RTGScalarInt8 {
			asmEmit(a, 0x93401c00)
			return
		}
		if kind == RTGScalarInt16 {
			asmEmit(a, 0x93403c00)
			return
		}
		if kind == RTGScalarUint16 {
			asmEmit(a, 0x92403c00)
			return
		}
		if kind == RTGScalarInt32 {
			asmEmit(a, 0x93407c00)
			return
		}
		if kind == RTGScalarUint32 {
			asmEmit(a, 0x92407c00)
		}
	}

	func asmCmpRegImm(a *RTGEmitter, reg int, imm int) {
		if imm >= 0 && imm <= 4095 {
			asmEmit(a, 0xf100001f|(imm<<10)|(reg<<5))
			return
		}
		asmMovRegImm(a, scratch.Code, imm)
		asmCmpRegReg(a, reg, scratch.Code)
	}

	func asmDivLeftRcxRightRax(a *RTGEmitter, mod bool) {
		asmMovRegReg(a, scratch.Code, primary.Code)
		asmEmit(a, 0x9ac00c40)
		if mod {
			asmEmit(a, 0x9b098800)
		}
	}

	func condFromSetcc(setcc int) int {
		if setcc == 0x94 {
			return 0
		}
		if setcc == 0x95 {
			return 1
		}
		if setcc == 0x92 {
			return 3
		}
		if setcc == 0x93 {
			return 2
		}
		if setcc == 0x96 {
			return 9
		}
		if setcc == 0x97 {
			return 8
		}
		if setcc == 0x9c {
			return 11
		}
		if setcc == 0x9e {
			return 13
		}
		if setcc == 0x9f {
			return 12
		}
		return 10
	}

	func asmStoreRaxMemRdxRcxSize(a *RTGEmitter, size int) {
		shift := 3
		if size == 1 {
			shift = 0
		}
		if size == 2 {
			shift = 1
		}
		if size == 4 {
			shift = 2
		}
		asmAddRegRegShift(a, address.Code, secondary.Code, tertiary.Code, shift)
		asmStoreRegMem(a, primary.Code, address.Code, 0, size)
	}

	// These address-aware algorithms form the architecture boundary used by
	// generated direct-emitter backends.

	func emitAddress(out *RTGEmitter, destination RTGRegister, memory RTGAddress) {
		if RTGAddressValid(memory) {
			emitADR(out, destination, memory)
			return
		}
		base := memory.Base.Code
		if memory.Index.Valid {
			shift := 0
			if memory.Scale == 2 {
				shift = 1
			} else if memory.Scale == 4 {
				shift = 2
			} else if memory.Scale == 8 {
				shift = 3
			}
			asmAddRegRegShift(
				out, destination.Code, base, memory.Index.Code, shift)
			base = destination.Code
		}
		asmAddRegImm(
			out, destination.Code, base, memory.Displacement)
	}

	func memoryBase(out *RTGEmitter, memory RTGAddress) int {
		if RTGAddressValid(memory) || memory.Index.Valid {
			emitAddress(out, address, memory)
			return address.Code
		}
		if memory.Displacement < -256 || memory.Displacement > 255 {
			emitAddress(out, address, memory)
			return address.Code
		}
		return memory.Base.Code
	}

	func loadWidth(
		out *RTGEmitter,
		destination RTGRegister,
		memory RTGAddress,
		size int,
		signed bool,
	) {
		base := memoryBase(out, memory)
		displacement := memory.Displacement
		if base == address.Code {
			displacement = 0
		}
		imm := (displacement & 511) << 12
		op := 0xf8400000
		if size == 1 {
			op = 0x38400000
			if signed {
				op = 0x38800000
			}
		} else if size == 2 {
			op = 0x78400000
			if signed {
				op = 0x78800000
			}
		} else if size == 4 {
			op = 0xb8400000
			if signed {
				op = 0xb8800000
			}
		}
		asmEmit(
			out, op|imm|(base<<5)|destination.Code)
	}

	func storeWidth(
		out *RTGEmitter,
		memory RTGAddress,
		source RTGRegister,
		size int,
	) {
		base := memoryBase(out, memory)
		displacement := memory.Displacement
		if base == address.Code {
			displacement = 0
		}
		imm := (displacement & 511) << 12
		op := 0xf8000000
		if size == 1 {
			op = 0x38000000
		} else if size == 2 {
			op = 0x78000000
		} else if size == 4 {
			op = 0xb8000000
		}
		asmEmit(out, op|imm|(base<<5)|source.Code)
	}

	func variableShift(
		out *RTGEmitter, direction RTGShiftDirection, signed bool,
	) {
		op := 0x9ac02400
		if direction == RTGShiftLeft {
			op = 0x9ac02000
		} else if signed {
			op = 0x9ac02800
		}
		asmEmit(out,
			op|(primary.Code<<16)|
				(tertiary.Code<<5)|primary.Code)
	}

	func signedDivide(out *RTGEmitter, remainder bool) {
		asmMovRegReg(
			out, scratch.Code, primary.Code)
		asmEmit(out,
			0x9ac00c00|(primary.Code<<16)|
				(tertiary.Code<<5)|primary.Code)
		if remainder {
			asmEmit(out,
				0x9b008000|(scratch.Code<<16)|
					(primary.Code<<10)|
					(tertiary.Code<<5)|primary.Code)
		}
	}

	func frameFinish(out *RTGEmitter, at int, stackUsed int) {
		frame := (stackUsed + 15) & -16
		high := frame / 4096
		low := frame % 4096
		if high > 0 {
			out.PatchUint32(at, 0xd14003ff|(high<<10))
		}
		if low > 0 {
			out.PatchUint32(at+4, 0xd10003ff|(low<<10))
		}
	}
}
arch aarch64 {
	alias = "aarch64"
	endian = little
	word_bits = 64
	pointer_bits = 64
	instruction_alignment = 4
	patch_relocations = aarch64_labels

	registers gpr64 = [
		x0, x1, x2, x3, x4, x5, x6, x7,
		x8, x9, x10, x11, x12, x13, x14, x15,
		x16, x17, x18, x19, x20, x21, x22, x23,
		x24, x25, x26, x27, x28, x29, x30, sp
	]

	locations {
		primary = x0
		secondary = x1
		tertiary = x2
		call_words = [x3, x4, x1, x2, x5, x6]
		system = x8
		scratch = x9
		scratch2 = x10
		address = x12
		copy_destination = x3
		copy_source = x4
		copy_count = x1
		frame = x29
		link = x30
		stack = sp
		zero = xzr
	}

	conditions {
		eq = 0
		ne = 1
		uge = 2
		ult = 3
		ugt = 8
		ule = 9
		sge = 10
		slt = 11
		sgt = 12
		sle = 13
	}

	# AArch64's regular register and branch instructions are bit-field rows.
	# Immediate synthesis, addressing, and other stateful algorithms remain
	# narrow Go hooks below.
	forms {
		binary = word32(destination:reg@0+5, source:reg@16)
		compare = word32(left:reg@5, right:reg@16)
		unary = word32(operand:reg@0+5)
		register = word32(operand:reg@5)
		branch = word32(label:label@reloc)
		conditional_branch = word32(condition:condition@0, label:label@reloc)
		fixed = bytes
	}

	instructions {
		add binary 0x8b000000
		subtract binary 0xcb000000
		multiply binary 0x9b007c00
		bit_and binary 0x8a000000
		bit_or binary 0xaa000000
		bit_xor binary 0xca000000
		compare compare 0xeb00001f
		test compare 0xea00001f
		increment unary 0x91000400
		decrement unary 0xd1000400
		call_indirect register 0xd63f0000
		call branch 0x94000000
		jump branch 0x14000000
		jump_condition conditional_branch 0x54000000
		return fixed [0xc0, 0x03, 0x5f, 0xd6]
		leave fixed [0xbf, 0x03, 0x00, 0x91, 0xfd, 0x7b, 0xc1, 0xa8]
	}

	bind {
		move = sequence move
		address = go emitAddress
		load.native = go loadNative
		load.i32 = go loadI32
		load.u32 = go loadU32
		load.i16 = go loadI16
		load.u16 = go loadU16
		load.i8 = go loadI8
		load.u8 = go loadU8
		store.native = go storeNative
		store.u32 = go storeU32
		store.u16 = go storeU16
		store.u8 = go storeU8
		add = add
		subtract = subtract
		multiply = multiply
		bit_and = bit_and
		bit_or = bit_or
		bit_xor = bit_xor
		compare = compare
		test = test
		increment = increment
		decrement = decrement
		shift_left_immediate = sequence shiftLeftImmediate
		shift_right_unsigned_immediate = sequence shiftRightUnsignedImmediate
		shift_right_signed_immediate = sequence shiftRightSignedImmediate
		call = call
		call_indirect = call_indirect
		jump = jump
		jump_condition = jump_condition
		set_condition = sequence setCondition
		return = return
		leave = leave
		host_syscall = sequence hostSyscall
		move_immediate = sequence moveImmediate
		variable_shift = go variableShift
		signed_divide = go signedDivide
		copy_bytes = sequence copyBytes
	}

	exports {
		renvoAarch64AsmEmit = sequence asmEmit
		renvoAarch64AsmAlign = go asmAlign
		renvoAarch64AsmMovRegReg = go asmMovRegReg
		renvoAarch64AsmMovRegImm = go asmMovRegImm
		renvoAarch64AsmPatchMovRegImmAt = go asmPatchMovRegImmAt
		renvoAarch64AsmMovRegAbs = sequence asmMovRegAbs
		renvoAarch64AsmAddRegImm = go asmAddRegImm
		renvoAarch64AsmAddRegReg = sequence asmAddRegReg
		renvoAarch64AsmSubRegReg = sequence asmSubRegReg
		renvoAarch64AsmAddRegRegShift = sequence asmAddRegRegShift
		renvoAarch64AsmMulRegReg = sequence asmMulRegReg
		renvoAarch64AsmAddr = go asmAddr
		renvoAarch64AsmLoadRegMem = go asmLoadRegMem
		renvoAarch64AsmStoreRegMem = go asmStoreRegMem
		renvoAarch64AsmLoadRegStack = sequence asmLoadRegStack
		renvoAarch64AsmStoreRegStack = sequence asmStoreRegStack
		renvoAarch64AsmLeaRegStack = sequence asmLeaRegStack
		renvoAarch64AsmPushReg = sequence asmPushReg
		renvoAarch64AsmPopReg = sequence asmPopReg
		renvoAarch64AsmMovRaxImm = sequence asmMovRaxImm
		renvoAarch64AsmMovRaxImm64 = sequence asmMovRaxImm64
		renvoAarch64AsmMovRdxImm = sequence asmMovRdxImm
		renvoAarch64AsmMovRaxDataAddr = sequence asmMovRaxDataAddr
		renvoAarch64AsmMovRaxBssAddr = sequence asmMovRaxBssAddr
		renvoAarch64AsmMovR10BssAddr = sequence asmMovR10BssAddr
		renvoAarch64AsmLoadRaxBss = sequence asmLoadRaxBss
		renvoAarch64AsmStoreRaxBss = sequence asmStoreRaxBss
		renvoAarch64AsmMovRdiRax = sequence asmMovRdiRax
		renvoAarch64AsmMovRaxRdx = sequence asmMovRaxRdx
		renvoAarch64AsmMovRdxRax = sequence asmMovRdxRax
		renvoAarch64AsmMovRcxRax = sequence asmMovRcxRax
		renvoAarch64AsmMovRcxRdx = sequence asmMovRcxRdx
		renvoAarch64AsmMovRsiRax = sequence asmMovRsiRax
		renvoAarch64AsmMovR8Rax = sequence asmMovR8Rax
		renvoAarch64AsmMovR9Rax = sequence asmMovR9Rax
		renvoAarch64AsmAddRdxRcx = sequence asmAddRdxRcx
		renvoAarch64AsmSyscall = sequence asmSyscall
		renvoAarch64AsmPopRdi = sequence asmPopRdi
		renvoAarch64AsmPopRsi = sequence asmPopRsi
		renvoAarch64AsmStackMem = go asmStackMem
		renvoAarch64AsmAddRdxImm = sequence asmAddRdxImm
		renvoAarch64AsmMemDisp = go asmMemDisp
		renvoAarch64AsmLoadQwordRaxIndexRcx8 = sequence asmLoadQwordRaxIndexRcx8
		renvoAarch64AsmLoadQwordRaxIndexRcxDisp = sequence asmLoadQwordRaxIndexRcxDisp
		renvoAarch64AsmLoadRaxMemRdxDisp = sequence asmLoadRaxMemRdxDisp
		renvoAarch64AsmLoadRaxMemRdxDispSize = sequence asmLoadRaxMemRdxDispSize
		renvoAarch64AsmLoadByteRaxIndexRcx = sequence asmLoadByteRaxIndexRcx
		renvoAarch64AsmLoadRaxIndexRcxSize = go asmLoadRaxIndexRcxSize
		renvoAarch64AsmStoreRaxMemRdxRcx8 = sequence asmStoreRaxMemRdxRcx8
		renvoAarch64AsmStoreRaxMemRdxDisp = sequence asmStoreRaxMemRdxDisp
		renvoAarch64AsmStoreRaxMemRdxDispSize = sequence asmStoreRaxMemRdxDispSize
		renvoAarch64AsmNormalizeRaxForKind = go asmNormalizeRaxForKind
		renvoAarch64AsmIncMemRdx = sequence asmIncMemRdx
		renvoAarch64AsmDecMemRdx = sequence asmDecMemRdx
		renvoAarch64AsmBoolNotRax = sequence asmBoolNotRax
		renvoAarch64AsmNegRax = sequence asmNegRax
		renvoAarch64AsmCmpRaxImm8 = sequence asmCmpRaxImm8
		renvoAarch64AsmCmpRegImm = go asmCmpRegImm
		renvoAarch64AsmCmpRegReg = sequence asmCmpRegReg
		renvoAarch64AsmCsetRax = sequence asmCsetRax
		renvoAarch64AsmAddRaxRcx = sequence asmAddRaxRcx
		renvoAarch64AsmSubRaxRcx = sequence asmSubRaxRcx
		renvoAarch64AsmShlRcxImm = sequence asmShlRcxImm
		renvoAarch64AsmShlRaxImm = sequence asmShlRaxImm
		renvoAarch64AsmSarRaxImm = sequence asmSarRaxImm
		renvoAarch64AsmDivLeftRcxRightRax = go asmDivLeftRcxRightRax
		renvoAarch64CondFromSetcc = go condFromSetcc
		renvoAarch64AsmCmpRcxRaxSet = sequence asmCmpRcxRaxSet
		renvoAarch64AsmPushRax = sequence asmPushRax
		renvoAarch64AsmPushRcx = sequence asmPushRcx
		renvoAarch64AsmPushRdx = sequence asmPushRdx
		renvoAarch64AsmPopRax = sequence asmPopRax
		renvoAarch64AsmPopRcx = sequence asmPopRcx
		renvoAarch64AsmPopRdx = sequence asmPopRdx
		renvoAarch64AsmPushImm = sequence asmPushImm
		renvoAarch64AsmStoreSliceStack = sequence asmStoreSliceStack
		renvoAarch64AsmStoreAlMemRdxRcx1 = sequence asmStoreAlMemRdxRcx1
		renvoAarch64AsmStoreRaxMemRdxRcxSize = go asmStoreRaxMemRdxRcxSize
		renvoAarch64AsmIncRcx = sequence asmIncRcx
		renvoAarch64AsmIncRax = sequence asmIncRax
		renvoAarch64AsmImulRcxImm = sequence asmImulRcxImm
		renvoAarch64AsmLeave = sequence asmLeave
		renvoAarch64AsmRet = sequence asmRet
		renvoAarch64AsmCallLabel = sequence asmCallLabel
		renvoAarch64AsmJmpLabel = sequence asmJmpLabel
		renvoAarch64AsmBCondLabel = sequence asmBCondLabel
		renvoAarch64AsmJzLabel = sequence asmJzLabel
		renvoAarch64AsmJnzLabel = sequence asmJnzLabel
	}

	relocation branch26 {
		width = 4
		signed = true
		scale = 4
		bits = 26
		relative_to = instruction
	}

	relocation branch19 {
		width = 4
		signed = true
		scale = 4
		bits = 19
		relative_to = instruction
	}

	relocation address21 {
		width = 4
		signed = true
		scale = 1
		bits = 21
		relative_to = instruction
	}

	sequences {
		asmAddRaxRcx(a:emitter) {
			asmAddRegReg(a, primary.Code, primary.Code, tertiary.Code)
		}
		asmAddRdxImm(a:emitter, imm:int) {
			asmAddRegImm(a, secondary.Code, secondary.Code, imm)
		}
		asmAddRdxRcx(a:emitter) {
			asmAddRegReg(a, secondary.Code, secondary.Code, tertiary.Code)
		}
		asmAddRegReg(a:emitter, dst:int, left:int, right:int) {
			asmEmit(a, 0x8b000000|(right<<16)|(left<<5)|dst)
		}
		asmAddRegRegShift(a:emitter, dst:int, left:int, right:int, shift:int) {
			asmEmit(a, 0x8b000000|(right<<16)|(shift<<10)|(left<<5)|dst)
		}
		asmBoolNotRax(a:emitter) {
			asmCmpRaxImm8(a, 0)
			asmCsetRax(a, 0)
		}
		asmCmpRaxImm8(a:emitter, imm:int) {
			asmCmpRegImm(a, primary.Code, imm)
		}
		asmCmpRegReg(a:emitter, left:int, right:int) {
			asmEmit(a, 0xeb00001f|(right<<16)|(left<<5))
		}
		asmCsetRax(a:emitter, cond:int) {
			asmEmit(a, 0x9a9f07e0|((cond^1)<<12))
		}
		asmDecMemRdx(a:emitter) {
			asmLoadRegMem(a, scratch.Code, secondary.Code, 0, 8)
			asmAddRegImm(a, scratch.Code, scratch.Code, -1)
			asmStoreRegMem(a, scratch.Code, secondary.Code, 0, 8)
		}
		asmEmit(a:emitter, insn:int) {
			RTGUint32(a, insn)
		}
		asmImulRcxImm(a:emitter, imm:int) {
			asmMovRegImm(a, scratch.Code, imm)
			asmEmit(a, 0x9b007c00|(scratch.Code<<16)|(tertiary.Code<<5)|tertiary.Code)
		}
		asmIncMemRdx(a:emitter) {
			asmLoadRegMem(a, scratch.Code, secondary.Code, 0, 8)
			asmAddRegImm(a, scratch.Code, scratch.Code, 1)
			asmStoreRegMem(a, scratch.Code, secondary.Code, 0, 8)
		}
		asmIncRax(a:emitter) {
			asmAddRegImm(a, primary.Code, primary.Code, 1)
		}
		asmIncRcx(a:emitter) {
			asmAddRegImm(a, tertiary.Code, tertiary.Code, 1)
		}
		asmJnzLabel(a:emitter, label:int) {
			asmBCondLabel(a, label, 1)
		}
		asmJzLabel(a:emitter, label:int) {
			asmBCondLabel(a, label, 0)
		}
		asmLeaRegStack(a:emitter, dst:int, offset:int) {
			asmAddRegImm(a, dst, frame.Code, -offset)
		}
		asmLeave(a:emitter) {
			asmEmit(a, 0x910003bf)
			asmEmit(a, 0xa8c17bfd)
		}
		asmLoadByteRaxIndexRcx(a:emitter) {
			asmAddRegRegShift(a, address.Code, primary.Code, tertiary.Code, 0)
			asmLoadRegMem(a, primary.Code, address.Code, 0, 1)
		}
		asmLoadQwordRaxIndexRcx8(a:emitter) {
			asmAddRegRegShift(a, address.Code, primary.Code, tertiary.Code, 3)
			asmLoadRegMem(a, primary.Code, address.Code, 0, 8)
		}
		asmLoadQwordRaxIndexRcxDisp(a:emitter, disp:int) {
			asmAddRegReg(a, address.Code, primary.Code, tertiary.Code)
			asmLoadRegMem(a, primary.Code, address.Code, disp, 8)
		}
		asmLoadRaxBss(a:emitter, bssOff:int) {
			asmMovRegAbs(a, address.Code, bssOff, RTGRelocationAbsoluteBSS)
			asmLoadRegMem(a, primary.Code, address.Code, 0, 8)
		}
		asmLoadRaxMemRdxDisp(a:emitter, disp:int) {
			asmLoadRegMem(a, primary.Code, secondary.Code, disp, 8)
		}
		asmLoadRaxMemRdxDispSize(a:emitter, disp:int, size:int) {
			asmLoadRegMem(a, primary.Code, secondary.Code, disp, size)
		}
		asmLoadRegStack(a:emitter, dst:int, offset:int) {
			asmLoadRegMem(a, dst, frame.Code, -offset, 8)
		}
		asmMovR10BssAddr(a:emitter, bssOff:int) {
			asmMovRegAbs(a, x7.Code, bssOff, RTGRelocationAbsoluteBSS)
		}
