			let ioFailed = out.NewLabel()
			let restore = out.NewLabel()
			let failed = out.NewLabel()
			let done = out.NewLabel()
			jump(out, after)
			out.Mark(helper)
			asmPushReg(out, 30)
			asmPushReg(out, 3)
			asmPushReg(out, 4)
			asmPushReg(out, 2)
			asmPushReg(out, 1)
			asmLoadRegMem(out, 9, 31, 48, 8)
			asmCmpRegImm(out, 9, 0)
			jumpCondition(out, record_condition(Code:0), standard)
			asmStoreRegMem(out, 9, 31, 48, 8)
			jump(out, handleReady)
			out.Mark(standard)
			let standardHandle = -10
			asmMovRegImm(out, 0, standardHandle)
			windowsCallImport(out, 6)
			asmStoreRegMem(out, 0, 31, 48, 8)
			jump(out, handleReady)
			out.Mark(standardError)
			asmMovRegImm(out, 0, -12)
			windowsCallImport(out, 6)
			asmStoreRegMem(out, 0, 31, 48, 8)
			out.Mark(handleReady)
			asmLoadRegMem(out, 9, 31, 0, 8)
			asmCmpRegImm(out, 9, 0)
			jumpCondition(out, record_condition(Code:11), sequential)
			asmLoadRegMem(out, 0, 31, 48, 8)
			asmMovRegImm(out, 1, 0)
			asmMovRegImm(out, 2, 0)
			asmMovRegImm(out, 3, 1)
			windowsCallImport(out, 5)
			asmMovRegImm(out, 9, 0xffffffff)
			asmCmpRegReg(out, 0, 9)
			jumpCondition(out, record_condition(Code:0), positionFailed)
			asmMovRegAbs(out, 9, positionOffset, RTGRelocationAbsoluteBSS)
			asmStoreRegMem(out, 0, 9, 0, 8)
			asmLoadRegMem(out, 0, 31, 48, 8)
			asmLoadRegMem(out, 1, 31, 0, 8)
			asmMovRegImm(out, 2, 0)
			asmMovRegImm(out, 3, 0)
			windowsCallImport(out, 5)
			asmMovRegImm(out, 9, 0xffffffff)
			asmCmpRegReg(out, 0, 9)
			jumpCondition(out, record_condition(Code:0), ioFailed)
			windowsReadWriteCall(out, 3, countOffset)
			asmCmpRegImm(out, 0, 0)
			jumpCondition(out, record_condition(Code:0), ioFailed)
			asmMovRegAbs(out, 9, countOffset, RTGRelocationAbsoluteBSS)
			asmLoadRegMem(out, 9, 9, 0, 8)
			jump(out, restore)
			out.Mark(ioFailed)
			asmMovRegImm(out, 9, -1)
			out.Mark(restore)
			asmMovRegAbs(out, 10, resultOffset, RTGRelocationAbsoluteBSS)
			asmStoreRegMem(out, 9, 10, 0, 8)
			asmLoadRegMem(out, 0, 31, 48, 8)
			asmMovRegAbs(out, 9, positionOffset, RTGRelocationAbsoluteBSS)
			asmLoadRegMem(out, 1, 9, 0, 8)
			asmMovRegImm(out, 2, 0)
			asmMovRegImm(out, 3, 0)
			windowsCallImport(out, 5)
			asmMovRegAbs(out, 9, resultOffset, RTGRelocationAbsoluteBSS)
			asmLoadRegMem(out, 0, 9, 0, 8)
			jump(out, done)
			out.Mark(positionFailed)
			asmMovRegImm(out, 0, -1)
			jump(out, done)
			out.Mark(sequential)
			windowsReadWriteCall(out, 3, countOffset)
			asmCmpRegImm(out, 0, 0)
			jumpCondition(out, record_condition(Code:0), failed)
			asmMovRegAbs(out, 9, countOffset, RTGRelocationAbsoluteBSS)
			asmLoadRegMem(out, 0, 9, 0, 8)
			jump(out, done)
			out.Mark(failed)
			asmMovRegImm(out, 0, -1)
			out.Mark(done)
			asmAddRegImm(out, 31, 31, 64)
			asmPopReg(out, 30)
			asmRet(out)
			out.Mark(after)
			call(out, helper)
		}
		windowsWriteAt(out:emitter) {
			let helper = out.NewLabel()
			let after = out.NewLabel()
			let countOffset = out.ReserveBSS(8, 8)
			let positionOffset = out.ReserveBSS(8, 8)
			let resultOffset = out.ReserveBSS(8, 8)
			let standard = out.NewLabel()
			let standardError = out.NewLabel()
			let handleReady = out.NewLabel()
			let sequential = out.NewLabel()
			let positionFailed = out.NewLabel()
			let ioFailed = out.NewLabel()
			let restore = out.NewLabel()
			let failed = out.NewLabel()
			let done = out.NewLabel()
			jump(out, after)
			out.Mark(helper)
			asmPushReg(out, 30)
			asmPushReg(out, 3)
			asmPushReg(out, 4)
			asmPushReg(out, 2)
			asmPushReg(out, 1)
			asmLoadRegMem(out, 9, 31, 48, 8)
			asmCmpRegImm(out, 9, 1)
			jumpCondition(out, record_condition(Code:0), standard)
			asmCmpRegImm(out, 9, 2)
			jumpCondition(out, record_condition(Code:0), standardError)
			asmStoreRegMem(out, 9, 31, 48, 8)
			jump(out, handleReady)
			out.Mark(standard)
			let standardHandle = -10
			set standardHandle = -11
			asmMovRegImm(out, 0, standardHandle)
			windowsCallImport(out, 6)
			asmStoreRegMem(out, 0, 31, 48, 8)
			jump(out, handleReady)
			out.Mark(standardError)
			asmMovRegImm(out, 0, -12)
			windowsCallImport(out, 6)
			asmStoreRegMem(out, 0, 31, 48, 8)
			out.Mark(handleReady)
			asmLoadRegMem(out, 9, 31, 0, 8)
			asmCmpRegImm(out, 9, 0)
			jumpCondition(out, record_condition(Code:11), sequential)
			asmLoadRegMem(out, 0, 31, 48, 8)
			asmMovRegImm(out, 1, 0)
			asmMovRegImm(out, 2, 0)
			asmMovRegImm(out, 3, 1)
			windowsCallImport(out, 5)
			asmMovRegImm(out, 9, 0xffffffff)
			asmCmpRegReg(out, 0, 9)
			jumpCondition(out, record_condition(Code:0), positionFailed)
			asmMovRegAbs(out, 9, positionOffset, RTGRelocationAbsoluteBSS)
			asmStoreRegMem(out, 0, 9, 0, 8)
			asmLoadRegMem(out, 0, 31, 48, 8)
			asmLoadRegMem(out, 1, 31, 0, 8)
			asmMovRegImm(out, 2, 0)
			asmMovRegImm(out, 3, 0)
			windowsCallImport(out, 5)
			asmMovRegImm(out, 9, 0xffffffff)
			asmCmpRegReg(out, 0, 9)
			jumpCondition(out, record_condition(Code:0), ioFailed)
			windowsReadWriteCall(out, 4, countOffset)
			asmCmpRegImm(out, 0, 0)
			jumpCondition(out, record_condition(Code:0), ioFailed)
			asmMovRegAbs(out, 9, countOffset, RTGRelocationAbsoluteBSS)
			asmLoadRegMem(out, 9, 9, 0, 8)
			jump(out, restore)
			out.Mark(ioFailed)
			asmMovRegImm(out, 9, -1)
			out.Mark(restore)
			asmMovRegAbs(out, 10, resultOffset, RTGRelocationAbsoluteBSS)
			asmStoreRegMem(out, 9, 10, 0, 8)
			asmLoadRegMem(out, 0, 31, 48, 8)
			asmMovRegAbs(out, 9, positionOffset, RTGRelocationAbsoluteBSS)
			asmLoadRegMem(out, 1, 9, 0, 8)
			asmMovRegImm(out, 2, 0)
			asmMovRegImm(out, 3, 0)
			windowsCallImport(out, 5)
			asmMovRegAbs(out, 9, resultOffset, RTGRelocationAbsoluteBSS)
			asmLoadRegMem(out, 0, 9, 0, 8)
			jump(out, done)
			out.Mark(positionFailed)
			asmMovRegImm(out, 0, -1)
			jump(out, done)
			out.Mark(sequential)
			windowsReadWriteCall(out, 4, countOffset)
			asmCmpRegImm(out, 0, 0)
			jumpCondition(out, record_condition(Code:0), failed)
			asmMovRegAbs(out, 9, countOffset, RTGRelocationAbsoluteBSS)
			asmLoadRegMem(out, 0, 9, 0, 8)
			jump(out, done)
			out.Mark(failed)
			asmMovRegImm(out, 0, -1)
			out.Mark(done)
			asmAddRegImm(out, 31, 31, 64)
			asmPopReg(out, 30)
			asmRet(out)
			out.Mark(after)
			call(out, helper)
		}
}
}

abi aapcs64 {
	arch = aarch64
	frame_start = sequence frameStart
	frame_finish = go frameFinish
	arguments = [x0, x1, x2, x3, x4, x5, x6, x7]
	result = [x0, x1]
	stack_alignment = 16
}

abi windows_arm64 {
	arch = aarch64
	frame_start = sequence frameStart
	frame_finish = go frameFinish
	arguments = [x0, x1, x2, x3, x4, x5, x6, x7]
	result = [x0, x1]
	stack_alignment = 16
}

runtime linux_aarch64 {
		entry sequence linuxEntry {
		max_parameters = 2
		bss args 32768 16
		bss environment 32768 16
		bss environmentLength 8 8
	}

	syscall {
		number = x8
		arguments = [x0, x1, x2, x3, x4, x5]
		result = x0
		instruction = svc
	}
	operation read { number = 63 args = [fd, buffer, count] }
	operation write { number = 64 args = [fd, buffer, count] }
	operation read_at { number = 67 args = [fd, buffer, count, offset] }
	operation write_at { number = 68 args = [fd, buffer, count, offset] }
	operation open { number = 56 args = [dirfd, path, flags, mode] }
	operation close { number = 57 args = [fd] }
	operation chmod { number = 52 args = [fd, mode] }
	operation print { use = write args = [stderr, buffer, count] }
	operation exit { number = 93 args = [status] noreturn = true }
}

runtime darwin_arm64 {
	entry sequence darwinEntry {
		max_parameters = 2
		requires_state = true
		bss args 32768 16
		bss environment 32768 16
	}
	entry_state_bytes = 24
	emit_exit = sequence darwinExit
	operation read { emit = sequence darwinRead }
	operation write { emit = sequence darwinWrite }
	operation read_at { emit = sequence darwinReadAt }
	operation write_at { emit = sequence darwinWriteAt }
	operation open { emit = sequence darwinOpen }
	operation close { emit = sequence darwinClose }
	operation chmod { emit = sequence darwinChmod }
	operation print { use = write }
}

runtime windows_arm64 {
		entry sequence windowsEntry {
		max_parameters = 2
		bss args 32768 16
		bss argsText 32768 16
		bss argsLength 8 8
		bss environment 32768 16
		bss environmentLength 8 8
	}
	emit_exit = sequence windowsExit
	emit_static_call = go windowsStaticCall
	imports "kernel32.dll" = [
		CreateFileA, CloseHandle, ReadFile, WriteFile, SetFilePointer,
		GetStdHandle, GetCommandLineA, ExitProcess, GetEnvironmentStringsA
	]
	operation read { emit = sequence windowsRead }
	operation write { emit = sequence windowsWrite }
	operation read_at { emit = sequence windowsReadAt }
	operation write_at { emit = sequence windowsWriteAt }
	operation open { emit = sequence windowsRuntimeOpen }
	operation close { emit = sequence windowsRuntimeClose }
	operation chmod { emit = sequence windowsRuntimeChmod }
	operation print { use = write }
}

format elf64_aarch64 {
	byte_order = little
	address_bits = 64
	kind = elf
	machine = 183
	code_offset = 176
	file_alignment = 0x1000
	flags = 0
	image = elf_executable
	patch_absolute = aarch64_page_address
}

format macho64_arm64 {
	byte_order = little
	address_bits = 64
	kind = "mach-o"
	cpu = 0x0100000c
	code_offset = 0x1000
	image = sequence machImage
}

format pe64_arm64 {
	byte_order = little
	address_bits = 64
	kind = pe
	machine = 0xaa64
	code_offset = 0x1000
	image = pe_executable
	patch_image = go pEPatch
	image_base = 0x40000000
	image_base_high = 1
	file_alignment = 0x200
	section_alignment = 0x1000
	coff_characteristics = 0x22
	dll_characteristics = 0x8100
	os_version_major = 6
	os_version_minor = 1
	image_version_major = 1
	image_version_minor = 0
	subsystem_version_major = 6
	subsystem_version_minor = 1
	stack_reserve = 0x800000
	stack_commit = 0x1000
	heap_reserve = 0x100000
	heap_commit = 0x1000
}

target linux/aarch64 {
	family = native_v1
	os = linux
	arch = aarch64
	abi = aapcs64
	runtime = linux_aarch64
	executable = elf64_aarch64
	build_tags = [linux, unix, aarch64, arm64]
	capabilities = [hosted, executable, filesystem, heap, argv, environment]
}

target darwin/arm64 {
	family = native_v1
	os = darwin
	arch = aarch64
	abi = aapcs64
	runtime = darwin_arm64
	executable = macho64_arm64
	build_tags = [darwin, unix, aarch64, arm64]
	capabilities = [hosted, executable, filesystem, heap, argv, environment]
}

target windows/arm64 {
	family = native_v1
	os = windows
	arch = aarch64
	abi = windows_arm64
	runtime = windows_arm64
	executable = pe64_arm64
	build_tags = [windows, aarch64, arm64]
	capabilities = [hosted, executable, filesystem, heap, argv, environment, windows_gui]
}
