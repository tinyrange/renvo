		asmSyscall(a:emitter) {
			asmMovRegReg(a, system.Code, primary.Code)
			asmMovRegReg(a, scratch.Code, secondary.Code)
			asmMovRegReg(a, 0, x3.Code)
			asmMovRegReg(a, 1, x4.Code)
			asmMovRegReg(a, 2, scratch.Code)
			asmMovRegReg(a, 3, x7.Code)
			asmEmit(a, 0xd4000001)
		}
		asmBCondLabel(a:emitter, label:int, cond:int) {
			let at = a.Len()
			asmEmit(a, 0x54000000|cond)
			a.RelocAt(at, label)
		}
		asmCallLabel(a:emitter, label:int) {
			let at = a.Len()
			asmEmit(a, 0x94000000)
			a.RelocAt(at, label)
		}
		asmCmpRcxRaxSet(a:emitter, setcc:int) {
			asmCmpRegReg(a, tertiary.Code, primary.Code)
			let cond = condFromSetcc(setcc)
			asmCsetRax(a, cond)
		}
		asmJmpLabel(a:emitter, label:int) {
			let at = a.Len()
			asmEmit(a, 0x14000000)
			a.RelocAt(at, label)
		}
		asmMovRegAbs(a:emitter, reg:int, off:int, kind:int) {
			let at = a.Len()
			asmMovRegImm(a, reg, 0)
			asmEmit(a, 0xf2800000|(1<<21)|reg)
			asmEmit(a, 0xf2800000|(2<<21)|reg)
			asmEmit(a, 0xf2800000|(3<<21)|reg)
			a.AbsoluteReloc(at, off, kind)
		}
		copyBytes(out:emitter) {
			let destination = x3
			let source = x4
			let count = secondary
			let value = scratch2
			let forward = out.NewLabel()
			let forwardLoop = out.NewLabel()
			let backwardLoop = out.NewLabel()
			let done = out.NewLabel()
			compare(out, destination, source)
			jumpCondition(out, record_condition(Code:9), forward)
			emitAddress(out, scratch, record_address(Base:source, Index:count, Scale:1, ))
			compare(out, destination, scratch)
			jumpCondition(out, record_condition(Code:2), forward)
			emitAddress(out, source, record_address(Base:source, Index:count, Scale:1, Displacement:-1, ))
			emitAddress(out, destination, record_address(Base:destination, Index:count, Scale:1, Displacement:-1, ))
			out.Mark(backwardLoop)
			compare(out, count, zero)
			jumpCondition(out, record_condition(Code:0), done)
			loadU8(out, value, record_address(Base:source))
			storeU8(out, record_address(Base:destination), value)
			decrement(out, source)
			decrement(out, destination)
			decrement(out, count)
			jump(out, backwardLoop)
			out.Mark(forward)
			out.Mark(forwardLoop)
			compare(out, count, zero)
			jumpCondition(out, record_condition(Code:0), done)
			loadU8(out, value, record_address(Base:source))
			storeU8(out, record_address(Base:destination), value)
			increment(out, source)
			increment(out, destination)
			decrement(out, count)
			jump(out, forwardLoop)
			out.Mark(done)
		}
		darwinExit(out:emitter, status:register) {
			asmMovRegReg(out, 0, status.Code)
			darwinCallImport(out, "_exit")
		}
		frameStart(out:emitter) -> int {
			asmEmit(out, 0xa9bf7bfd)
			asmEmit(out, 0x910003fd)
			let at = out.Len()
			asmEmit(out, 0xd503201f)
			asmEmit(out, 0xd503201f)
			return at
		}
		hostSyscall(out:emitter) {
			asmSyscall(out)
		}
		machImage(out:emitter) -> bytes {
			let imports = machPrepareImports(out)
			let dataFileOff = RTGAlignValue(machCodeOffset+out.Len(), machPageSize)
			let bind = machBuildBindData(out, imports.got)
			let symtab = machBuildSymbolTable(out)
			let strtab = machBuildStringTable(out)
			let undefinedCount = out.DynamicImportCount()
			let textFileSize = dataFileOff
			let dataFileSize = len(out.Data())
			let dataVMSize = RTGAlignValue(dataFileSize+out.BSSSize(), machPageSize)
			let linkeditOff = dataFileOff+dataFileSize
			let bindOff = linkeditOff
			let symOff = RTGAlignValue(bindOff+len(bind), 8)
			let strOff = symOff+len(symtab)
			let sigOff = RTGAlignValue(strOff+len(strtab), 16)
			let sigSize = machCodeSignatureSize(sigOff, "renvo")
			let linkeditSize = sigOff+sigSize-linkeditOff
			let image = machHeader(out, textFileSize, dataFileOff, dataFileSize, dataVMSize, linkeditOff, linkeditSize, bindOff, len(bind), symOff, 1+undefinedCount, strOff, len(strtab), undefinedCount, sigOff, sigSize, )
			set image = append(image, out.Code()...)
			set image = machAppendUntil(image, dataFileOff)
			set image = append(image, out.Data()...)
			set image = machAppendUntil(image, bindOff)
			set image = append(image, bind...)
			set image = machAppendUntil(image, symOff)
			set image = append(image, symtab...)
			set image = append(image, strtab...)
			set image = machAppendUntil(image, sigOff)
			let signature = machCodeSignature(image, "renvo", textFileSize)
			return append(image, signature...)
		}
		move(out:emitter, destination:register, source:register) {
			asmMovRegReg(out, destination.Code, source.Code)
		}
		moveImmediate(out:emitter, destination:register, value:int64) {
			asmMovRegImm(out, destination.Code, int(value))
		}
		setCondition(out:emitter, condition:condition, destination:register) {
			asmEmit(out, 0x9a9f07e0|((condition.Code^1)<<12)|destination.Code)
		}
		shiftLeftImmediate(out:emitter, operand:register, value:byte) {
			let shift = int(value)&63
			asmEmit(out, 0xd3400000|((64-shift)<<16)|((63-shift)<<10)|(operand.Code<<5)|operand.Code)
		}
		shiftRightSignedImmediate(out:emitter, operand:register, value:byte) {
			asmEmit(out, 0x9340fc00|((int(value)&63)<<16)|(operand.Code<<5)|operand.Code)
		}
		shiftRightUnsignedImmediate(out:emitter, operand:register, value:byte) {
			asmEmit(out, 0xd340fc00|((int(value)&63)<<16)|(operand.Code<<5)|operand.Code)
		}
		windowsExit(out:emitter, status:register) {
			asmMovRegReg(out, 0, status.Code)
			windowsCallImport(out, 8)
		}
		darwinCallImport(out:emitter, name:string) {
			let index = out.DynamicImport(machLibSystem, name)
			asmCallLabel(out, out.DynamicImportLabel(index))
		}
		emitADR(out:emitter, destination:register, address:address) {
			let addend = address.Addend
			let insn = 0x10000000|destination.Code
			set insn = insn|((addend&3)<<29)
			set insn = insn|(((addend>>2)&0x7ffff)<<5)
			let at = out.Len()
			asmEmit(out, insn)
			RTGAddressRelocAt(out, address, at)
		}
