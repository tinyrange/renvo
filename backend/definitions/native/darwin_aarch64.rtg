runtime darwin_arm64 {
	entry sequence aarch64.darwinEntry {
		max_parameters = 2
		requires_state = true
		bss args 32768 16
		bss environment 32768 16
	}
	entry_state_bytes = 24
	emit_exit = sequence aarch64.darwinExit
	operation read { emit = sequence aarch64.darwinRead }
	operation write { emit = sequence aarch64.darwinWrite }
	operation read_at { emit = sequence aarch64.darwinReadAt }
	operation write_at { emit = sequence aarch64.darwinWriteAt }
	operation open { emit = sequence aarch64.darwinOpen }
	operation close { emit = sequence aarch64.darwinClose }
	operation chmod { emit = sequence aarch64.darwinChmod }
	operation print { use = write }
}

format macho64_arm64 {
	byte_order = little
	address_bits = 64
	kind = "mach-o"
	cpu = 0x0100000c
	code_offset = 0x1000
	image = sequence aarch64.machImage
}

target darwin/arm64 {
	family = native_v1
	os = darwin
	arch = aarch64
	abi = aapcs64
	runtime = darwin_arm64
	executable = macho64_arm64
	build_tags = [darwin, unix, aarch64, arm64]
	capabilities = [hosted, executable, filesystem, heap, argv, environment]
}
