		}
		renvoArmAsmJzLabel(a:emitter, label:int) {
			call renvoArmAsmBCondLabel(a,label,0)

		}
		renvoArmAsmLeaRegStack(a:emitter, dst:int, offset:int) {
			call renvoArmAsmAddRegImm(a,dst,armFrame.Code,-offset)

		}
		renvoArmAsmLeave(a:emitter) {
			call renvoArmAsmMovRegReg(a,armStack.Code,armFrame.Code)

			call renvoArmAsmEmit(a,0xe8bd4800)

		}
		renvoArmAsmLoadByteRaxIndexRcx(a:emitter) {
			call renvoArmAsmAddRegReg(a,armAddress.Code,armPrimary.Code,armTertiary.Code)

			call renvoArmAsmLoadRegMem(a,armPrimary.Code,armAddress.Code,0,1)

		}
		renvoArmAsmLoadQwordRaxIndexRcx8(a:emitter) {
			call renvoArmAsmAddRegRegShift(a,armAddress.Code,armPrimary.Code,armTertiary.Code,3)

			call renvoArmAsmLoadRegMem(a,armPrimary.Code,armAddress.Code,0,4)

		}
		renvoArmAsmLoadQwordRaxIndexRcxDisp(a:emitter, disp:int) {
			call renvoArmAsmAddRegReg(a,armAddress.Code,armPrimary.Code,armTertiary.Code)

			call renvoArmAsmLoadRegMem(a,armPrimary.Code,armAddress.Code,disp,4)

		}
