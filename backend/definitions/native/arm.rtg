		}
		renvoArmAsmImulRcxImm(a:emitter, imm:int) {
			call renvoArmAsmMovRegImm(a,armScratch.Code,imm)

			call renvoArmAsmMulRegReg(a,armTertiary.Code,armTertiary.Code,armScratch.Code)

		}
		renvoArmAsmIncMemRdx(a:emitter) {
			call renvoArmAsmLoadRegMem(a,armScratch.Code,armSecondary.Code,0,4)

			call renvoArmAsmAddRegImm(a,armScratch.Code,armScratch.Code,1)

			call renvoArmAsmStoreRegMem(a,armScratch.Code,armSecondary.Code,0,4)

