			call renvoArmAsmMovRegReg(a,0,armR3.Code)

			call renvoArmAsmMovRegReg(a,1,armR4.Code)

			call renvoArmAsmMovRegReg(a,2,armScratch.Code)

			call renvoArmAsmMovRegReg(a,3,armR8.Code)

			call renvoArmAsmMovRegReg(a,4,armR8.Code)

			call renvoArmAsmMovRegImm(a,5,0)

			call renvoArmAsmEmit(a,0xef000000)

		}

		renvoArmAsmAccessRaxBss(a:emitter, bssOff:int, insn:int) {
			let at = a.Len()

			call RTGUint32(a,0xe3000000|(armAddress.Code<<12))

			call RTGUint32(a,0xe3400000|(armAddress.Code<<12))

			call RTGUint32(a,insn)

			call a.AbsoluteReloc(at,bssOff,RTGRelocationAbsoluteBSS)

		}
		renvoArmAsmBCondLabel(a:emitter, label:int, cond:int) {
			let at = a.Len()

			call renvoArmAsmEmit(a,(cond<<28)|0x0a000000)

			call a.RelocAt(at,label)

		}
		renvoArmAsmCallLabel(a:emitter, label:int) {
			let at = a.Len()

			call renvoArmAsmEmit(a,0xeb000000)

			call a.RelocAt(at,label)

		}
		renvoArmAsmCmpRcxRaxSet(a:emitter, setcc:int) {
			call renvoArmAsmCmpRegReg(a,armTertiary.Code,armPrimary.Code)

