		renvoArmAsmPushRcx(a:emitter) {
			call renvoArmAsmPushReg(a,armTertiary.Code)

		}
		renvoArmAsmPushRdx(a:emitter) {
			call renvoArmAsmPushReg(a,armSecondary.Code)

