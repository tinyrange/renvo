			call renvoArmAsmCsetRax(a,cond)

		}
		renvoArmAsmJmpLabel(a:emitter, label:int) {
			let at = a.Len()

			call renvoArmAsmEmit(a,0xea000000)

			call a.RelocAt(at,label)

		}
		renvoArmAsmMovRegAbs(a:emitter, reg:int, off:int, kind:int) {
			let at = a.Len()

			call RTGUint32(a,0xe3000000|(reg<<12))

			call RTGUint32(a,0xe3400000|(reg<<12))

			call RTGUint32(a,0xe08f0000|(reg<<12)|reg)

			call a.AbsoluteReloc(at,off,kind)

		}
		renvoArmAsmPatchMovRegImmAt(a:emitter, at:int, reg:int, imm:int) {
			let part = imm&65535

			call a.PatchUint32(at,0xe3000000|((part&0xf000)<<4)|(reg<<12)|(part&0x0fff))

			set part = (imm>>16)&65535

			call a.PatchUint32(at+4,0xe3400000|((part&0xf000)<<4)|(reg<<12)|(part&0x0fff))

		}

		armCopyBytes(out:emitter) {
			let destination = armR3
			let source = armR4
			let count = armSecondary
			let value = armScratch2
			let forward = out.NewLabel()
			let forwardLoop = out.NewLabel()
			let backwardLoop = out.NewLabel()
			let done = out.NewLabel()
			call armCompare(out,destination,source)
			call armJumpCondition(out,record_condition(Code:9),forward)
			call armEmitAddress(out,armScratch,record_address(Base:source,Index:count,Scale:1,))
			call armCompare(out,destination,armScratch)
			call armJumpCondition(out,record_condition(Code:2),forward)
			call armEmitAddress(out,source,record_address(Base:source,Index:count,Scale:1,Displacement:-1,))
			call armEmitAddress(out,destination,record_address(Base:destination,Index:count,Scale:1,Displacement:-1,))
			call out.Mark(backwardLoop)
			call renvoArmAsmCmpRegImm(out,count.Code,0)
			call armJumpCondition(out,record_condition(Code:0),done)
			call armLoadU8(out,value,record_address(Base:source))
			call armStoreU8(out,record_address(Base:destination),value)
			call armDecrement(out,source)
			call armDecrement(out,destination)
			call armDecrement(out,count)
			call armJump(out,backwardLoop)
			call out.Mark(forward)
			call out.Mark(forwardLoop)
			call renvoArmAsmCmpRegImm(out,count.Code,0)
			call armJumpCondition(out,record_condition(Code:0),done)
			call armLoadU8(out,value,record_address(Base:source))
			call armStoreU8(out,record_address(Base:destination),value)
			call armIncrement(out,source)
			call armIncrement(out,destination)
			call armDecrement(out,count)
			call armJump(out,forwardLoop)
			call out.Mark(done)
		}
		armFrameStart(out:emitter) -> int {
			call out.Bytes4(0x00,0x48,0x2d,0xe9)
			call renvoArmAsmMovRegReg(out,11,13)
			let at = out.Len()
			call renvoArmAsmEmit(out,0xe3009000)
			call renvoArmAsmEmit(out,0xe04dd009)
			return at
		}
		armHostSyscall(out:emitter) {
			call renvoArmAsmSyscall(out)
		}
		armMove(out:emitter, destination:register, source:register) {
			call renvoArmAsmMovRegReg(out,destination.Code,source.Code)
		}
		armMoveImmediate(out:emitter, destination:register, value:int64) {
			call renvoArmAsmMovRegImm(out,destination.Code,int(value))
		}
		armSetCondition(out:emitter, condition:condition, destination:register) {
			call renvoArmAsmEmit(out,0xe3a00000|(destination.Code<<12))
			call renvoArmAsmEmit(out,(condition.Code<<28)|0x03a00001|(destination.Code<<12))
		}
		armShiftLeftImmediate(out:emitter, operand:register, value:byte) {
			call armShiftImmediate(out,operand,value,0)
		}
		armShiftRightSignedImmediate(out:emitter, operand:register, value:byte) {
			call armShiftImmediate(out,operand,value,0x40)
		}
		armShiftRightUnsignedImmediate(out:emitter, operand:register, value:byte) {
			call armShiftImmediate(out,operand,value,0x20)
		}

		armLoadI16(out:emitter, destination:register, address:address) {
			call armLoadExtra(out,destination,address,0xe15000f0)
		}
		armLoadI32(out:emitter, destination:register, address:address) {
			call armLoadNative(out,destination,address)
		}
		armLoadI8(out:emitter, destination:register, address:address) {
			call armLoadExtra(out,destination,address,0xe15000d0)
		}
		armLoadNative(out:emitter, destination:register, address:address) {
			set address = armMemoryAddress(out,address,4)
			call renvoArmAsmLoadRegMem(out,destination.Code,address.Base.Code,address.Displacement,4)
		}
		armLoadU16(out:emitter, destination:register, address:address) {
			call armLoadExtra(out,destination,address,0xe15000b0)
		}
		armLoadU32(out:emitter, destination:register, address:address) {
			call armLoadNative(out,destination,address)
		}
		armLoadU8(out:emitter, destination:register, address:address) {
			set address = armMemoryAddress(out,address,1)
			call renvoArmAsmLoadRegMem(out,destination.Code,address.Base.Code,address.Displacement,1)
		}
		armShiftImmediate(out:emitter, operand:register, value:byte, kind:int) {
			call renvoArmAsmEmit(out,0xe1a00000|(operand.Code<<12)|((int(value)&31)<<7)|kind|operand.Code)
		}
		armStoreNative(out:emitter, address:address, source:register) {
			call armStoreWidth(out,address,source,4)
		}
		armStoreU16(out:emitter, address:address, source:register) {
			call armStoreWidth(out,address,source,2)
		}
		armStoreU32(out:emitter, address:address, source:register) {
			call armStoreWidth(out,address,source,4)
		}
		armStoreU8(out:emitter, address:address, source:register) {
			call armStoreWidth(out,address,source,1)
		}
		armStoreWidth(out:emitter, address:address, source:register, size:int) {
			set address = armMemoryAddress(out,address,size)
			call renvoArmAsmStoreRegMem(out,source.Code,address.Base.Code,address.Displacement,size)
		}
}
}

abi renvo_arm {
	arch = arm
	frame_start = sequence armFrameStart
	frame_finish = go armFrameFinish
	call_words = [r0, r1, r2, r3, r4, r5]
	overflow_stride = 4
	scalar_result = r0
}

abi aapcs32 {
	internal = renvo_arm
	arguments = [r0, r1, r2, r3]
	result = [r0, r1]
	stack_alignment = 8
}

runtime linux_arm {
	entry template {
