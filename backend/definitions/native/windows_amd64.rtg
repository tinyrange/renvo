# Image fields are declared here. Header/section/relocation are generic
# definition-language constructs, not precompiled PE backends.
format pe64_x86_64 {
	kind = pe
	byte_order = little
	address_bits = 64
	machine = 0x8664
	code_offset = 0x1000
	image = pe_executable
	patch_image = pe_relative32
	image_base = 0x400000
	headers_size = 0x200
	file_alignment = 0x200
	section_alignment = 0x1000
	text_rva = 0x1000
	coff_characteristics = 0x22
	dll_characteristics = 0x100
	os_version_major = 4
	os_version_minor = 0
	image_version_major = 0
	image_version_minor = 0
	subsystem_version_major = 4
	subsystem_version_minor = 0
	stack_reserve = 0x800000
	stack_commit = 0x1000
	heap_reserve = 0x100000
	heap_commit = 0x1000

	dos_header {
		magic = [0x4d, 0x5a]
		pe_offset = 0x80
	}

	coff_header {
		machine = 0x8664
		sections = 2
		optional_header_size = 0xf0
		characteristics = executable | large_address_aware
	}

	optional_header {
		magic = 0x20b
		entry = rva(text.start)
		code_base = rva(text.start)
		image_base = 0x400000
		section_alignment = 0x1000
		file_alignment = 0x200
		subsystem = target.subsystem
		stack_reserve = 8MiB
		stack_commit = 4KiB
		heap_reserve = 1MiB
		directories = [imports.directory, imports.iat]
	}

	section text {
		name = ".text"
		flags = code | execute | read
		virtual = text
		raw_alignment = 0x200
	}

	section data {
		name = ".data"
		flags = initialized_data | read | write
		virtual = data + bss
		raw = data
		raw_alignment = 0x200
	}

	imports {
		thunk_bytes = 8
		library = "KERNEL32.dll"
		names = target.runtime.imports

		descriptor size=20 {
			u32 original_first_thunk = rva(import_lookup_table)
			u32 timestamp = 0
			u32 forwarder_chain = 0
			u32 name = rva(library_name)
			u32 first_thunk = rva(import_address_table)
		}

		import_lookup_table {
			entries names as u64 rva(hint_name(entry))
			terminator = u64 0
		}

		import_address_table {
			entries names as u64 rva(hint_name(entry))
			terminator = u64 0
		}

		hint_name(entry) {
			u16 0
			ascii entry
			u8 0
			align 2
		}

		library_name {
			ascii library
			u8 0
		}

		directory.rva = rva(descriptor)
		directory.size = sizeof(descriptor)
		iat.rva = rva(import_address_table)
		iat.size = sizeof(import_address_table)
	}

	relocation import = rel32 from instruction_end to imports.iat_entry
	relocation data = rel32 from instruction_end to data
	relocation bss = rel32 from instruction_end to bss
}

format coff64_object_x86_64 {
	kind = coff
	byte_order = little
	address_bits = 64
	machine = 0x8664
	sections = [text, data, bss]
	symbol_table entry_size=18 {
		name = inline_8_or_string_offset
		value = section_offset
		section = section_index
		type = symbol_type
		storage_class = symbol_visibility
		auxiliaries = 0
	}

	string_table {
		u32 size
		entries long_symbol_names {
			ascii long_symbol_name
			u8 0
		}
	}

	relocation label { number = 0x0004 kind = rel32 addend = -4 }
	relocation data { number = 0x0004 kind = rel32 addend = -4 }
	relocation bss { number = 0x0004 kind = rel32 addend = -4 }
	relocation abs64 { number = 0x0001 kind = absolute width = 64 }
}

runtime win32_x86_64 {
	emit_exit = go x86_64.windowsExit
	emit_static_call = go x86_64.windowsStaticCall

	imports "kernel32.dll" = [
		CreateFileA,
		CloseHandle,
		ReadFile,
		WriteFile,
		SetFilePointer,
		GetStdHandle,
		GetCommandLineA,
		ExitProcess,
		GetEnvironmentStringsA
	]

	io_template {
		bss count 8 8
		bss position 8 8
		read_code = "\x57\x56\x52\x51\x48\x83\x7c\x24\x18\x00\x74\x02\xeb\x18\xb9\xf6\xff\xff\xff\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\x44\x24\x18\x48\x83\x3c\x24\x00\x0f\x8c\x80\x00\x00\x00\x48\x8b\x4c\x24\x18\x31\xd2\x45\x31\xc0\x41\xb9\x01\x00\x00\x00\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\x05\x00\x00\x00\x00\x48\x8b\x4c\x24\x18\x48\x8b\x14\x24\x45\x31\xc0\x45\x31\xc9\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x8b\x4c\x24\x18\x48\x8b\x54\x24\x10\x4c\x8b\x44\x24\x08\x48\x8d\x05\x00\x00\x00\x00\x49\x89\xc1\x48\x83\xec\x28\x48\xc7\x44\x24\x20\x00\x00\x00\x00\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x83\xf8\x00\x74\x52\x48\x8b\x05\x00\x00\x00\x00\xeb\x4c\x48\x8b\x4c\x24\x18\x48\x8b\x54\x24\x10\x4c\x8b\x44\x24\x08\x48\x8d\x05\x00\x00\x00\x00\x49\x89\xc1\x48\x83\xec\x28\x48\xc7\x44\x24\x20\x00\x00\x00\x00\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x83\xf8\x00\x74\x0c\x48\x8b\x05\x00\x00\x00\x00\x48\x83\xc4\x20\xc3\x6a\xff\x58\x48\x83\xc4\x20\xc3\x6a\xff\x58\x48\x89\x05\x00\x00\x00\x00\x48\x8b\x4c\x24\x18\x48\x8b\x05\x00\x00\x00\x00\x50\x5a\x45\x31\xc0\x45\x31\xc9\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x8b\x05\x00\x00\x00\x00\x48\x83\xc4\x20\xc3"
		write_code = "\x57\x56\x52\x51\x48\x83\x7c\x24\x18\x01\x74\x0a\x48\x83\x7c\x24\x18\x02\x74\x1c\xeb\x32\xb9\xf5\xff\xff\xff\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\x44\x24\x18\xeb\x18\xb9\xf4\xff\xff\xff\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\x44\x24\x18\x48\x83\x3c\x24\x00\x0f\x8c\x80\x00\x00\x00\x48\x8b\x4c\x24\x18\x31\xd2\x45\x31\xc0\x41\xb9\x01\x00\x00\x00\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\x05\x00\x00\x00\x00\x48\x8b\x4c\x24\x18\x48\x8b\x14\x24\x45\x31\xc0\x45\x31\xc9\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x8b\x4c\x24\x18\x48\x8b\x54\x24\x10\x4c\x8b\x44\x24\x08\x48\x8d\x05\x00\x00\x00\x00\x49\x89\xc1\x48\x83\xec\x28\x48\xc7\x44\x24\x20\x00\x00\x00\x00\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x83\xf8\x00\x74\x52\x48\x8b\x05\x00\x00\x00\x00\xeb\x4c\x48\x8b\x4c\x24\x18\x48\x8b\x54\x24\x10\x4c\x8b\x44\x24\x08\x48\x8d\x05\x00\x00\x00\x00\x49\x89\xc1\x48\x83\xec\x28\x48\xc7\x44\x24\x20\x00\x00\x00\x00\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x83\xf8\x00\x74\x0c\x48\x8b\x05\x00\x00\x00\x00\x48\x83\xc4\x20\xc3\x6a\xff\x58\x48\x83\xc4\x20\xc3\x6a\xff\x58\x48\x89\x05\x00\x00\x00\x00\x48\x8b\x4c\x24\x18\x48\x8b\x05\x00\x00\x00\x00\x50\x5a\x45\x31\xc0\x45\x31\xc9\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x8b\x05\x00\x00\x00\x00\x48\x83\xc4\x20\xc3"
		read_relocation 33 import 6
		read_relocation 79 import 5
		read_relocation 90 bss position
		read_relocation 115 import 5
		read_relocation 141 bss count
		read_relocation 163 import 3
		read_relocation 179 bss count
		read_relocation 203 bss count
		read_relocation 225 import 3
		read_relocation 241 bss count
		read_relocation 264 bss count
		read_relocation 276 bss position
		read_relocation 294 import 5
		read_relocation 305 bss count
		write_relocation 38 import 6
		write_relocation 77 import 6
		write_relocation 123 import 5
		write_relocation 134 bss position
		write_relocation 159 import 5
		write_relocation 185 bss count
		write_relocation 207 import 4
		write_relocation 223 bss count
		write_relocation 247 bss count
		write_relocation 269 import 4
		write_relocation 285 bss count
		write_relocation 308 bss count
		write_relocation 320 bss position
		write_relocation 338 import 5
		write_relocation 349 bss count
	}

	entry template {
		max_parameters = 2
		bss args 32768 16
		bss argsText 32768 16
		bss argsLength 8 8
		bss environment 32768 16
		bss environmentLength 8 8
		code = "\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\xc6\x4c\x8d\x15\x00\x00\x00\x00\x48\x8d\x05\x00\x00\x00\x00\x50\x5a\x4d\x31\xdb\x80\x3e\x00\x0f\x84\x62\x00\x00\x00\x80\x3e\x20\x74\x05\x80\x3e\x09\x75\x05\x48\xff\xc6\xeb\xe8\x49\x89\x12\x31\xc9\x45\x31\xc0\x8a\x06\x3c\x00\x74\x28\x3c\x22\x75\x09\x41\x83\xf0\x01\x48\xff\xc6\xeb\xed\x41\x83\xf8\x00\x75\x08\x3c\x20\x74\x11\x3c\x09\x74\x0d\x88\x02\x48\xff\xc6\x48\xff\xc2\x48\xff\xc1\xeb\xd2\xc6\x02\x00\x48\xff\xc2\x49\x89\x4a\x08\x49\x83\xc2\x10\x49\xff\xc3\x3c\x00\x74\x08\x48\xff\xc6\xe9\x95\xff\xff\xff\x4c\x89\xd8\x48\x89\x05\x00\x00\x00\x00\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\xc6\x4c\x8d\x15\x00\x00\x00\x00\x4d\x31\xdb\x80\x3e\x00\x74\x23\x49\x89\x32\x31\xc9\x80\x3c\x0e\x00\x74\x05\x48\xff\xc1\xeb\xf5\x49\x89\x4a\x08\x48\x01\xce\x48\xff\xc6\x49\x83\xc2\x10\x49\xff\xc3\xeb\xd8\x4c\x89\xd8\x48\x89\x05\x00\x00\x00\x00\x48\x8d\x05\x00\x00\x00\x00\x50\x5f\x48\x8b\x05\x00\x00\x00\x00\x50\x5e\x50\x5a\x48\x8d\x05\x00\x00\x00\x00\x50\x59\x48\x8b\x05\x00\x00\x00\x00\x49\x89\xc0\x49\x89\xc1"
		relocation 6 import 7
		relocation 20 bss args
		relocation 27 bss argsText
		relocation 149 bss argsLength
		relocation 159 import 9
		relocation 173 bss environment
		relocation 226 bss environmentLength
		relocation 233 bss args
		relocation 242 bss argsLength
		relocation 253 bss environment
		relocation 262 bss environmentLength
	}

	entry {
		arguments.source = call GetCommandLineA
		arguments.parse = go x86_64.windowsCommandLine
		environment.source = call GetEnvironmentStringsA
		environment.parse = nul_terminated_pairs
		result = [slice(arguments), slice(environment)]
	}

	operation open {
		emit = sequence x86_64.windowsRuntimeOpen
		call = CreateFileA
		arguments = [
			path,
			access(flags),
			share_read | share_write,
			null,
			disposition(flags),
			normal_attributes,
			null
		]
		result = handle_or_error
	}

	operation close {
		emit = sequence x86_64.windowsRuntimeClose
		call = CloseHandle
		arguments = [fd]
		result = bool_or_error
	}

	operation read {
		call = ReadFile
		arguments = [fd, buffer, count, address(transferred), null]
		result = transferred_or_error
	}

	operation write {
		call = WriteFile
		arguments = [fd, buffer, count, address(transferred), null]
		result = transferred_or_error
	}

	operation read_at {
		sequence = [seek(fd, offset), read(fd, buffer, count)]
	}

	operation write_at {
		sequence = [seek(fd, offset), write(fd, buffer, count)]
	}

	operation seek {
		call = SetFilePointer
		arguments = [fd, low32(offset), address(high32(offset)), begin]
		result = position_or_error
	}

	operation print {
		sequence = [GetStdHandle(stderr), write(result, buffer, count)]
	}

	operation chmod {
		emit = sequence x86_64.windowsRuntimeChmod
		unsupported = "Win32 target does not expose chmod"
	}

	operation exit {
		call = ExitProcess
		arguments = [status]
		noreturn = true
	}
}

target windows/amd64 {
	family = native_v1
	os = windows
	arch = x86_64
	abi = windows_x86_64
	runtime = win32_x86_64
	executable = pe64_x86_64
	object = coff64_object_x86_64
	subsystem = console
	build_tags = ["windows", "amd64"]
	capabilities = [
		hosted, executable, object, filesystem, heap,
		argv, environment, imports, linkstatic, windows_gui
	]
}
