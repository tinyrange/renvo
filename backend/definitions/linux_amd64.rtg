definition 1
unit native
implements direct_emitter_v1

@import "elf_amd64.rtg"

go backend {
	func linuxObjectStaticCall(
		out *RTGEmitter, importID int, wordCount int,
	) {
		vectorMask := wordCount >> 8
		wordCount &= 255
		integerCount := 0
		vectorCount := 0
		for i := 0; i < wordCount; i++ {
			if vectorMask&(1<<i) != 0 {
				out.Byte(0x58)
				out.Bytes4(0xf2, 0x48, 0x0f, 0x2a)
				out.Byte(0xc0 | vectorCount<<3)
				vectorCount++
			} else {
				if integerCount == 0 {
					out.Byte(0x5f)
				} else if integerCount == 1 {
					out.Byte(0x5e)
				} else if integerCount == 2 {
					out.Byte(0x5a)
				} else if integerCount == 3 {
					out.Byte(0x59)
				} else if integerCount == 4 {
					out.Bytes2(0x41, 0x58)
				} else {
					out.Bytes2(0x41, 0x59)
				}
				integerCount++
			}
		}
		if vectorCount != 0 {
			out.Byte(0xb8)
			out.Int32(4)
			out.Bytes4(0xf2, 0x4c, 0x0f, 0x2a)
			out.Byte(0xc0)
			for i := 0; i < vectorCount; i++ {
				out.Bytes4(0xf2, 0x41, 0x0f, 0x5e)
				out.Byte(0xc0 | i<<3)
			}
		}
		externalID := out.ExternalImport(out.StaticImportName(importID))
		// Expression evaluation can leave an odd number of words below the
		// arguments. Preserve that exact stack pointer while aligning the SysV
		// call boundary; the foreign callee may freely clobber r11.
		out.Bytes3(0x49, 0x89, 0xe3)
		out.Bytes4(0x48, 0x83, 0xe4, 0xf0)
		out.Bytes4(0x48, 0x83, 0xec, 0x10)
		out.Bytes4(0x4c, 0x89, 0x5c, 0x24)
		out.Byte(0x08)
		// Fixed callees ignore AL; variadic callees use it as the vector count.
		out.Byte(0xb0)
		out.Byte(vectorCount)
		out.Byte(0xe8)
		at := out.Len()
		out.Int32(0)
		out.AbsoluteReloc(at, externalID, RTGRelocationImport)
		out.Bytes4(0x48, 0x8b, 0x64, 0x24)
		out.Byte(0x08)
	}
}

# Linux uses the SysV call words for ordinary Renvo calls but the kernel syscall
# convention moves the buffer length and positional offset into different
# registers. Keep those compact shuffles in the target definition so the
# checked-in production projection does not own handwritten ABI bytes.
extend arch x86_64 {
	sequences {
		linuxPrepareReadWriteBuffer(out:emitter) {
			out.Uint16(0x5a51)
		}
		linuxMoveOffsetArgument(out:emitter) {
			out.Uint24(0xc28949)
		}
	}
}

# Runtime declarations define only the supported boundary. Missing operations
# are rejected during definition validation rather than silently emulated.
runtime linux_x86_64 {
	prepare_read_write_buffer = sequence linuxPrepareReadWriteBuffer
	move_offset_argument = sequence linuxMoveOffsetArgument
	emit_static_call = go linuxObjectStaticCall

	entry process_stack {
		argc = word(rsp, 0)
		argv = words(rsp + 8, argc)
		envp = words(rsp + 16 + argc * 8, until_null)
		string = nul_terminated_bytes
		result = [slice(argv), slice(envp)]
	}

	entry template {
		max_parameters = 2
		bss args 32768 16
		bss environment 32768 16
		bss environmentLength 8 8
		code = "\x48\x8b\x04\x24\x49\x89\xc0\x4c\x8d\x4c\x24\x08\x4c\x8d\x15\x00\x00\x00\x00\x4d\x89\xd4\x4d\x31\xdb\x4d\x39\xc3\x7d\x22\x4b\x8b\x3c\xd9\x49\x89\x3a\x48\x31\xc0\x80\x3c\x07\x00\x74\x05\x48\xff\xc0\xeb\xf5\x49\x89\x42\x08\x49\x83\xc2\x10\x49\xff\xc3\xeb\xd9\x4c\x8d\x4c\x24\x08\x49\x83\x39\x00\x74\x06\x49\x83\xc1\x08\xeb\xf4\x49\x83\xc1\x08\x4c\x8d\x15\x00\x00\x00\x00\x4d\x31\xdb\x4b\x8b\x3c\xd9\x48\x83\xff\x00\x74\x1e\x49\x89\x3a\x48\x31\xc0\x80\x3c\x07\x00\x74\x05\x48\xff\xc0\xeb\xf5\x49\x89\x42\x08\x49\x83\xc2\x10\x49\xff\xc3\xeb\xd8\x4c\x89\xd8\x48\x89\x05\x00\x00\x00\x00\x4c\x89\xe7\x4c\x89\xc6\x4c\x89\xc2\x48\x8d\x05\x00\x00\x00\x00\x50\x59\x48\x8b\x05\x00\x00\x00\x00\x49\x89\xc0\x49\x89\xc1"
		relocation 15 bss args
		relocation 88 bss environment
		relocation 141 bss environmentLength
		relocation 157 bss environment
		relocation 166 bss environmentLength
	}

	syscall {
		number = rax
		arguments = [rdi, rsi, rdx, r10, r8, r9]
		result = rax
		error = negative
		instruction = syscall
	}

	operation read { number = 0 args = [fd, buffer, count] }
	operation write { number = 1 args = [fd, buffer, count] }
	operation open { number = 2 args = [path, flags, mode] }
	operation close { number = 3 args = [fd] }
	operation read_at { number = 17 args = [fd, buffer, count, offset] }
	operation write_at { number = 18 args = [fd, buffer, count, offset] }
	operation chmod { number = 91 args = [fd, mode] }
	operation print { use = write args = [stderr, buffer, count] }
	operation exit { number = 60 args = [status] noreturn = true }
}

target linux/amd64 {
	family = native_v1
	os = linux
	arch = x86_64
	abi = sysv_x86_64
	runtime = linux_x86_64
	executable = elf64_x86_64
	object = elf64_object_x86_64
	build_tags = ["linux", "unix", "amd64"]
	capabilities = [
		hosted, executable, object, filesystem, heap,
		argv, environment, linkstatic
	]
}
