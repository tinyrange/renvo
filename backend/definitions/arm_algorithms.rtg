# Immediate, frame-branch, and runtime-boundary emission.
go compiler {
	func renvoArmCompilerPrimaryImm(a *renvoAsm, imm int) {
		renvoArmAsmMovRaxImm(a, imm)
	}

	func renvoArmCompilerSyscall(a *renvoAsm) {
		renvoArmAsmSyscall(a)
	}

	func renvoArmCompilerPushStackWord(a *renvoAsm, offset int) {
		renvoAsmPushStack(a, offset)
	}

	func renvoArmCompilerJcmpStackStack(a *renvoAsm, left int, right int, label int, setcc int) {
		renvoAsmPushStack(a, left)
		renvoAsmLoadPrimaryStack(a, right)
		renvoAsmPopTertiary(a)
		renvoAsmCmpTertiaryPrimaryJump(a, setcc, label)
	}

	func renvoArmCompilerJcmpStackImm(a *renvoAsm, offset int, value int, label int, setcc int) {
		renvoAsmPushStack(a, offset)
		renvoAsmPrimaryImm(a, value)
		renvoAsmPopTertiary(a)
		renvoAsmCmpTertiaryPrimaryJump(a, setcc, label)
	}
}

go compiler {
	func renvoArmCompilerPrimaryImm64(a *renvoAsm, imm int, high int) {
		// This operation materializes one native scalar. Paired-word lowering
		// handles the high half separately on this 32-bit backend.
		renvoArmAsmMovRaxImm(a, imm)
	}
}

