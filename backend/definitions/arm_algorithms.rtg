go compiler {
	func renvoArmCompilerFunctionFrameStart(g *renvoLinearGen, label int) int {
		a := &g.asm
		renvoArmAsmAlign(a)
		renvoAsmMarkLabel(a, label)
		renvoArmAsmEmit(a, 0xe92d4800)
		renvoArmAsmMovRegReg(a, renvoArmRegFp, renvoArmRegSp)
		return renvoArmAsmFrameStart(a)
	}
}

go compiler {
	func renvoArmCompilerFunctionFrameFinish(g *renvoLinearGen, framePatch int) {
		renvoArmAsmPatchFrame(&g.asm, framePatch, g.stackPeak)
