# Immediate, frame-branch, and runtime-boundary emission.
go compiler {
	func renvoArmCompilerPrimaryImm(a *renvoAsm, imm int) {
		renvoArmAsmMovRaxImm(a, imm)
	}

	func renvoArmCompilerSyscall(a *renvoAsm) {
		renvoArmAsmSyscall(a)
	}

	func renvoArmCompilerPushStackWord(a *renvoAsm, offset int) {
		renvoAsmPushStack(a, offset)
	}

	func renvoArmCompilerJcmpStackStack(a *renvoAsm, left int, right int, label int, setcc int) {
		renvoAsmPushStack(a, left)
		renvoAsmLoadPrimaryStack(a, right)
		renvoAsmPopTertiary(a)
		renvoAsmCmpTertiaryPrimaryJump(a, setcc, label)
	}

	func renvoArmCompilerJcmpStackImm(a *renvoAsm, offset int, value int, label int, setcc int) {
		renvoAsmPushStack(a, offset)
		renvoAsmPrimaryImm(a, value)
		renvoAsmPopTertiary(a)
		renvoAsmCmpTertiaryPrimaryJump(a, setcc, label)
	}
}

go compiler {
	func renvoArmCompilerPrimaryImm64(a *renvoAsm, imm int, high int) {
		// This operation materializes one native scalar. Paired-word lowering
		// handles the high half separately on this 32-bit backend.
		renvoArmAsmMovRaxImm(a, imm)
	}
}

go compiler {
	func renvoArmCompilerPatch(a *renvoAsm) {
		rtgArmPatchRelocations(a)
		renvoAsmSetDataOffsets(a)
	}

	func renvoArmCompilerMulPrimaryTertiary(a *renvoAsm) {
		renvoArmAsmMulRegReg(a, renvoArmRegRax, renvoArmRegRcx, renvoArmRegRax)
	}
}

go compiler {
	func renvoArmCompilerGlobalInitFrameStart(g *renvoLinearGen) int {
		a := &g.asm
		renvoArmAsmEmit(a, 0xe92d4800)
		renvoArmAsmMovRegReg(a, renvoArmRegFp, renvoArmRegSp)
		return renvoArmAsmFrameStart(a)
	}

	func renvoArmCompilerGlobalInitFrameEnd(g *renvoLinearGen, framePatch int) {
		renvoAsmLeave(&g.asm)
		renvoArmAsmPatchFrame(&g.asm, framePatch, g.stackPeak)
	}

	func renvoArmCompilerIEEEBinaryStack(g *renvoLinearGen, dest int, left int, right int, op byte, size int) bool {
		return renvoArmAsmVFPBinaryStack(&g.asm, dest, left, right, op, size)
	}

	func renvoArmCompilerIEEEConvertFloatStack(g *renvoLinearGen, dest int, source int, sourceSize int, destSize int) {
		renvoArmAsmVFPConvertFloatStack(&g.asm, dest, source, sourceSize, destSize)
	}

	func renvoArmCompilerIEEEIntToFloatStack(g *renvoLinearGen, offset int, intSize int, floatSize int, signed bool) {
		renvoArmAsmVFPIntToFloatStack(&g.asm, offset, intSize, floatSize, signed)
	}

	func renvoArmCompilerIEEEFloatToIntStack(g *renvoLinearGen, dest int, source int, floatSize int, intSize int, signed bool) {
		renvoArmAsmVFPFloatToIntStack(&g.asm, dest, source, floatSize, intSize, signed)
	}

	func renvoArmCompilerIEEENegateStack(g *renvoLinearGen, offset int, size int) {
		highOffset := offset
		if size == 8 {
			highOffset -= 4
		}
		renvoAsmLoadPrimaryStack(&g.asm, highOffset)
		renvoArmAsmEmit(&g.asm, -476016382) // mov r9, #0x80000000
		renvoArmAsmEmit(&g.asm, -534773751) // eor r0, r0, r9
		renvoAsmStorePrimaryStack(&g.asm, highOffset)
	}
}

go compiler {
	func renvoArmCompilerIEEECompareStack(g *renvoLinearGen, left int, right int, kind int, c0 byte, c1 byte) bool {
		size := 8
		if kind == renvoTypeFloat32 {
			size = 4
		}
		renvoArmAsmVFPCompareStack(&g.asm, left, right, size)
		cond := 12
		if c0 == '=' {
			cond = 0
		} else if c0 == '!' {
			cond = 1
		} else if c0 == '<' {
			cond = 4
			if c1 == '=' {
				cond = 9
			}
		} else if c0 == '>' && c1 == '=' {
			cond = 10
		}
		renvoArmAsmCsetRax(&g.asm, cond)
		return true
	}

	func renvoArmCompilerIEEENegatePrimary(g *renvoLinearGen, kind int) bool {
		if kind == renvoTypeFloat32 {
			return renvoEmit32BitIEEEFloatNegatePrimary(g)
		}
		return false
	}
}

go compiler {
	func renvoArmCompilerIEEEConversionPrimary(g *renvoLinearGen, sourceKind int, destKind int) bool {
		a := &g.asm
		temp := renvoAddUnnamedLocal(g, renvoTypeInt64)
		renvoAsmStorePrimaryStack(a, temp)
		if !renvoTypeKindIsFloat(sourceKind) && destKind == renvoTypeFloat32 {
			renvo32IEEEIntToFloatStack(g, temp, 4, 4, !renvoTypeKindIsUnsignedInteger(sourceKind))
		} else if sourceKind == renvoTypeFloat32 && !renvoTypeKindIsFloat(destKind) {
			renvo32IEEEFloatToIntStack(g, temp, temp, 4, 4, !renvoTypeKindIsUnsignedInteger(destKind))
		} else {
			return false
		}
		renvoAsmLoadPrimaryStack(a, temp)
		return true
	}

	func renvoArmCompilerIEEEArithmeticPrimaryTertiary(g *renvoLinearGen, opChar byte, kind int) bool {
		a := &g.asm
		if kind != renvoTypeFloat32 {
			return false
		}
		left := renvoAddUnnamedLocal(g, renvoBuiltinTypeFloat32)
		right := renvoAddUnnamedLocal(g, renvoBuiltinTypeFloat32)
		result := renvoAddUnnamedLocal(g, renvoBuiltinTypeFloat32)
		renvoAsmStorePrimaryStack(a, right)
		renvoAsmCopyTertiaryToPrimary(a)
		renvoAsmStorePrimaryStack(a, left)
		if !renvo32IEEEBinaryStack(g, result, left, right, opChar, 4) {
			return false
		}
		renvoAsmLoadPrimaryStack(a, result)
		return true
	}

	func renvoArmCompilerIEEEComparePrimaryTertiary(g *renvoLinearGen, c0 byte, c1 byte, kind int) bool {
		return false
	}
}

go compiler {
	func renvoArmCompilerUnsignedDividePrimaryTertiary(g *renvoLinearGen, mod bool) bool {
		renvoArmAsmMovRegReg(&g.asm, 9, 0)
		renvoArmAsmEmit(&g.asm, 0xe730f010|(0<<16)|(0<<8)|2)
		if mod {
			renvoArmAsmEmit(&g.asm, 0xe0600090|(2<<12)|(9<<8)|0)
		}
		return true
	}
}

