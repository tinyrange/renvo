		renvoAsmLoadPrimaryBss(a, globalOffset)
		renvoAsmPushImm(a, 1)
		renvoAsmPopTertiary(a)
		if inc {
			renvoAsmAddPrimaryTertiary(a)
		} else {
			renvoAsmSubPrimaryTertiary(a)
		}
		renvoAsmStorePrimaryBss(a, globalOffset)
		return true
	}
}

