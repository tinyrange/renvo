definition 1
unit native
implements direct_emitter_v1

@import "x86_32.rtg"

extend arch x86_32 {
	sequences {
		windowsExit(out:emitter, status:register) {
			out.AppendByte(0x50+status.Code)
			out.Bytes2(0xff, 0x15)
			let at = out.Len()
			out.Int32(0)
			out.AbsoluteReloc(at, 8, RTGRelocationImport)
		}
		windowsStaticCall(out:emitter, importID:int, wordCount:int) {
			out.Bytes2(0xff, 0x15)
			let at = out.Len()
			out.Int32(0)
			out.AbsoluteReloc(at, importID, RTGRelocationImport)
		}
		windowsCallImport(out:emitter, importID:int) {
			out.Bytes2(0xff, 0x15)
			let at = out.Len()
			out.Int32(0)
			out.AbsoluteReloc(at, importID, RTGRelocationImport)
		}
		windowsRuntimeChmod(out:emitter) {
			let eax = record_register(Code:0, Valid:true)
			let ecx = record_register(Code:1, Valid:true)
			let failed = out.NewLabel()
			let done = out.NewLabel()
			out.Bytes2(0x6a, 1)
			out.Bytes2(0x6a, 0)
			out.Bytes2(0x6a, 0)
			out.AppendByte(0x53)
			windowsCallImport(out, 5)
			moveImmediate(out, ecx, -1)
			encodeBinary(out, 0x39, eax, ecx)
			jumpCondition(out, record_condition(JumpOpcode:0x84), failed)
			moveImmediate(out, eax, 0)
			encodeRelative(out, 0xe9, done)
			out.Mark(failed)
			moveImmediate(out, eax, -1)
			out.Mark(done)
		}
		windowsRuntimeClose(out:emitter) {
			let eax = record_register(Code:0, Valid:true)
			let failed = out.NewLabel()
			let done = out.NewLabel()
			out.AppendByte(0x53)
			windowsCallImport(out, 2)
			test(out, eax, eax)
			jumpCondition(out, record_condition(JumpOpcode:0x84), failed)
			moveImmediate(out, eax, 0)
			encodeRelative(out, 0xe9, done)
			out.Mark(failed)
			moveImmediate(out, eax, -1)
			out.Mark(done)
		}
		windowsRuntimeOpen(out:emitter) {
			let eax = record_register(Code:0, Valid:true)
			let esi = record_register(Code:6, Valid:true)
			move(out, eax, esi)
			windowsTranslateCreateFileFlags(out)
			out.Bytes2(0x6a, 0)
			out.AppendByte(0x68)
			out.Int32(0x80)
			out.AppendByte(0x51)
			out.Bytes2(0x6a, 0)
			out.Bytes2(0x6a, 3)
			out.AppendByte(0x52)
			out.AppendByte(0x53)
			windowsCallImport(out, 1)
		}
		windowsTranslateCreateFileFlags(out:emitter) {
			let edx = record_register(Code:2, Valid:true)
			let ecx = record_register(Code:1, Valid:true)
			let notReadWrite = out.NewLabel()
			let accessDone = out.NewLabel()
			let noCreate = out.NewLabel()
			let createDone = out.NewLabel()
			moveImmediate(out, edx, -2147483648)
			out.Bytes2(0xa8, 2)
			jumpCondition(out, record_condition(JumpOpcode:0x84), notReadWrite)
			moveImmediate(out, edx, -1073741824)
			encodeRelative(out, 0xe9, accessDone)
			out.Mark(notReadWrite)
			out.Bytes2(0xa8, 1)
			jumpCondition(out, record_condition(JumpOpcode:0x84), accessDone)
			moveImmediate(out, edx, 0x40000000)
			out.Mark(accessDone)
			moveImmediate(out, ecx, 3)
			out.Bytes2(0xa8, 64)
			jumpCondition(out, record_condition(JumpOpcode:0x84), noCreate)
			moveImmediate(out, ecx, 4)
			out.AppendByte(0xa9)
			out.Int32(512)
			jumpCondition(out, record_condition(JumpOpcode:0x84), createDone)
			moveImmediate(out, ecx, 2)
			encodeRelative(out, 0xe9, createDone)
			out.Mark(noCreate)
			out.AppendByte(0xa9)
			out.Int32(512)
			jumpCondition(out, record_condition(JumpOpcode:0x84), createDone)
			moveImmediate(out, ecx, 5)
			out.Mark(createDone)
		}
	}
}

abi win32 {
	internal = renvo_x86_32
	arguments = [stack]
	result = [eax, edx]
	stack_alignment = 4
}

runtime windows_386 {
	emit_exit = sequence windowsExit
	emit_static_call = sequence windowsStaticCall
	imports "kernel32.dll" = [
		CreateFileA, CloseHandle, ReadFile, WriteFile, SetFilePointer,
		GetStdHandle, GetCommandLineA, ExitProcess, GetEnvironmentStringsA
	]
	io_template {
		bss count 16 4
		read_code = "\x83\xfb\x00\x0f\x84\x05\x00\x00\x00\xe9\x0a\x00\x00\x00\x6a\xf6\xff\x15\x00\x00\x00\x00\x89\xc3\x83\xf9\x00\x0f\x8c\x49\x00\x00\x00\x51\x52\x6a\x01\x6a\x00\x6a\x00\x53\xff\x15\x00\x00\x00\x00\xa3\x00\x00\x00\x00\x5a\x59\x51\x52\x6a\x00\x6a\x00\x51\x53\xff\x15\x00\x00\x00\x00\x5a\x59\x6a\x00\x68\x00\x00\x00\x00\x52\x56\x53\xff\x15\x00\x00\x00\x00\x83\xf8\x00\x0f\x84\x2d\x00\x00\x00\xa1\x00\x00\x00\x00\xe9\x26\x00\x00\x00\x6a\x00\x68\x00\x00\x00\x00\x52\x56\x53\xff\x15\x00\x00\x00\x00\x83\xf8\x00\x0f\x84\x06\x00\x00\x00\xa1\x00\x00\x00\x00\xc3\x6a\xff\x58\xc3\x6a\xff\x58\xa3\x00\x00\x00\x00\x6a\x00\x6a\x00\xa1\x00\x00\x00\x00\x50\x53\xff\x15\x00\x00\x00\x00\xa1\x00\x00\x00\x00\xc3"
		write_code = "\x83\xfb\x01\x0f\x84\x0e\x00\x00\x00\x83\xfb\x02\x0f\x84\x14\x00\x00\x00\xe9\x19\x00\x00\x00\x6a\xf5\xff\x15\x00\x00\x00\x00\x89\xc3\xe9\x0a\x00\x00\x00\x6a\xf4\xff\x15\x00\x00\x00\x00\x89\xc3\x83\xf9\x00\x0f\x8c\x49\x00\x00\x00\x51\x52\x6a\x01\x6a\x00\x6a\x00\x53\xff\x15\x00\x00\x00\x00\xa3\x00\x00\x00\x00\x5a\x59\x51\x52\x6a\x00\x6a\x00\x51\x53\xff\x15\x00\x00\x00\x00\x5a\x59\x6a\x00\x68\x00\x00\x00\x00\x52\x56\x53\xff\x15\x00\x00\x00\x00\x83\xf8\x00\x0f\x84\x2d\x00\x00\x00\xa1\x00\x00\x00\x00\xe9\x26\x00\x00\x00\x6a\x00\x68\x00\x00\x00\x00\x52\x56\x53\xff\x15\x00\x00\x00\x00\x83\xf8\x00\x0f\x84\x06\x00\x00\x00\xa1\x00\x00\x00\x00\xc3\x6a\xff\x58\xc3\x6a\xff\x58\xa3\x00\x00\x00\x00\x6a\x00\x6a\x00\xa1\x00\x00\x00\x00\x50\x53\xff\x15\x00\x00\x00\x00\xa1\x00\x00\x00\x00\xc3"
		read_relocation 23 import 6
		read_relocation 49 import 5
		read_relocation 54 bss count 8
		read_relocation 70 import 5
		read_relocation 79 bss count
		read_relocation 88 import 3
		read_relocation 102 bss count
		read_relocation 114 bss count
		read_relocation 123 import 3
		read_relocation 137 bss count
		read_relocation 150 bss count
		read_relocation 159 bss count 8
		read_relocation 167 import 5
		read_relocation 172 bss count
		write_relocation 32 import 6
		write_relocation 47 import 6
		write_relocation 73 import 5
		write_relocation 78 bss count 8
		write_relocation 94 import 5
		write_relocation 103 bss count
		write_relocation 112 import 4
		write_relocation 126 bss count
		write_relocation 138 bss count
		write_relocation 147 import 4
		write_relocation 161 bss count
		write_relocation 174 bss count
		write_relocation 183 bss count 8
		write_relocation 191 import 5
		write_relocation 196 bss count
	}
	entry template {
		max_parameters = 2
		bss args 32768 16
		bss argsText 32768 16
		bss argsLength 8 8
		bss environment 32768 16
		bss environmentLength 8 8
		code = "\xff\x15\x00\x00\x00\x00\x89\xc6\xbf\x00\x00\x00\x00\xb8\x00\x00\x00\x00\x89\xc2\x31\xdb\x80\x3e\x00\x0f\x84\x75\x00\x00\x00\x80\x3e\x20\x0f\x84\x09\x00\x00\x00\x80\x3e\x09\x0f\x85\x06\x00\x00\x00\x46\xe9\xdf\xff\xff\xff\x89\x17\x31\xc9\x31\xed\x8a\x06\x3c\x00\x0f\x84\x34\x00\x00\x00\x3c\x22\x0f\x85\x09\x00\x00\x00\x83\xf5\x01\x46\xe9\xe5\xff\xff\xff\x83\xfd\x00\x0f\x85\x10\x00\x00\x00\x3c\x20\x0f\x84\x12\x00\x00\x00\x3c\x09\x0f\x84\x0a\x00\x00\x00\x88\x02\x46\x42\x41\xe9\xc2\xff\xff\xff\xc6\x02\x00\x42\x89\x4f\x08\x83\xc7\x10\x43\x3c\x00\x0f\x84\x06\x00\x00\x00\x46\xe9\x82\xff\xff\xff\x89\xd8\xa3\x00\x00\x00\x00\xff\x15\x00\x00\x00\x00\x89\xc6\xbf\x00\x00\x00\x00\x31\xdb\x80\x3e\x00\x0f\x84\x23\x00\x00\x00\x89\x37\x31\xc9\x80\x3c\x0e\x00\x0f\x84\x06\x00\x00\x00\x41\xe9\xf0\xff\xff\xff\x89\x4f\x08\x01\xce\x46\x83\xc7\x10\x43\xe9\xd4\xff\xff\xff\x89\xd8\xa3\x00\x00\x00\x00\xbb\x00\x00\x00\x00\x8b\x35\x00\x00\x00\x00\x89\xf2\xb9\x00\x00\x00\x00\xa1\x00\x00\x00\x00\x89\xc7"
		relocation 2 import 7
		relocation 9 bss args
		relocation 14 bss argsText
		relocation 151 bss argsLength
		relocation 157 import 9
		relocation 164 bss environment
		relocation 217 bss environmentLength
		relocation 222 bss args
		relocation 228 bss argsLength
		relocation 235 bss environment
		relocation 240 bss environmentLength
	}
	operation read { template = io }
	operation write { template = io }
	operation read_at { template = io }
	operation write_at { template = io }
	operation open { emit = sequence windowsRuntimeOpen }
	operation close { emit = sequence windowsRuntimeClose }
	operation chmod { emit = sequence windowsRuntimeChmod }
	operation print { use = write }
}

format pe32_386 {
	byte_order = little
	address_bits = 32
	kind = pe
	machine = 0x014c
	code_offset = 0x1000
	image = pe_executable
	patch_image = pe_absolute32
	image_base = 0x400000
	file_alignment = 0x200
	section_alignment = 0x1000
	coff_characteristics = 0x0102
	dll_characteristics = 0x100
	os_version_major = 4
	os_version_minor = 0
	image_version_major = 0
	image_version_minor = 0
	subsystem_version_major = 4
	subsystem_version_minor = 0
	stack_reserve = 0x100000
	stack_commit = 0x1000
	heap_reserve = 0x100000
	heap_commit = 0x1000
}

target windows/386 {
	family = native_v1
	os = windows
	arch = x86_32
	abi = win32
	runtime = windows_386
	executable = pe32_386
	build_tags = [windows, 386]
	capabilities = [hosted, executable, filesystem, heap, argv, environment]
}
