	func x86WindowsTranslateCreateFileFlags(out *RTGEmitter) {
		rdx := RTGRegister{Code: 2, Valid: true}
		r8 := RTGRegister{Code: 8, Valid: true}
		r9 := RTGRegister{Code: 9, Valid: true}
		r10 := RTGRegister{Code: 10, Valid: true}
		notReadWrite := out.NewLabel()
		accessDone := out.NewLabel()
		noCreate := out.NewLabel()
		createDone := out.NewLabel()

		x86MoveImmediate(out, rdx, -2147483648)
		out.Bytes2(0xa8, 2)
		x86JumpCondition(out, RTGCondition{JumpOpcode: 0x84}, notReadWrite)
		x86MoveImmediate(out, rdx, -1073741824)
		x86Relative(out, 0xe9, accessDone)
		out.Mark(notReadWrite)
		out.Bytes2(0xa8, 1)
		x86JumpCondition(out, RTGCondition{JumpOpcode: 0x84}, accessDone)
		x86MoveImmediate(out, rdx, 0x40000000)
		out.Mark(accessDone)

		x86MoveImmediate(out, r10, 3)
		out.Bytes2(0xa8, 64)
		x86JumpCondition(out, RTGCondition{JumpOpcode: 0x84}, noCreate)
		x86MoveImmediate(out, r10, 4)
		out.AppendByte(0xa9)
		out.Int32(512)
		x86JumpCondition(out, RTGCondition{JumpOpcode: 0x84}, createDone)
		x86MoveImmediate(out, r10, 2)
		x86Relative(out, 0xe9, createDone)
		out.Mark(noCreate)
		out.AppendByte(0xa9)
		out.Int32(512)
		x86JumpCondition(out, RTGCondition{JumpOpcode: 0x84}, createDone)
		x86MoveImmediate(out, r10, 5)
		out.Mark(createDone)
		x86MoveImmediate(out, r8, 3)
		x86MoveImmediate(out, r9, 0)
	}

	func x86WindowsRuntimeOpen(out *RTGEmitter) {
		rax := RTGRegister{Code: 0, Valid: true}
		rcx := RTGRegister{Code: 1, Valid: true}
		rsi := RTGRegister{Code: 6, Valid: true}
		rdi := RTGRegister{Code: 7, Valid: true}
		r11 := RTGRegister{Code: 11, Valid: true}
		x86RRRM(out, 0x89, r11, rdi, 64)
		x86RRRM(out, 0x89, rax, rsi, 64)
		x86WindowsTranslateCreateFileFlags(out)
		x86RRRM(out, 0x89, rcx, r11, 64)
		base := out.Len()
		out.Text("\x41\x54\x49\x89\xe4\x48\x83\xe4\xf0\x48\x83\xec\x40\x44\x89\x54\x24\x20\xc7\x44\x24\x28\x80\x00\x00\x00\x48\xc7\x44\x24\x30\x00\x00\x00\x00\xff\x15\x00\x00\x00\x00\x49\x89\xc3\x4c\x89\xe4\x41\x5c\x4c\x89\xd8")
		out.AbsoluteReloc(base+37, 1, RTGRelocationImport)
	}

	func x86WindowsRuntimeClose(out *RTGEmitter) {
		rax := RTGRegister{Code: 0, Valid: true}
		rcx := RTGRegister{Code: 1, Valid: true}
		rdi := RTGRegister{Code: 7, Valid: true}
		failed := out.NewLabel()
		done := out.NewLabel()
		x86RRRM(out, 0x89, rcx, rdi, 64)
		x86WindowsCallImport(out, 2)
		x86RRRM(out, 0x85, rax, rax, 32)
		x86JumpCondition(out, RTGCondition{JumpOpcode: 0x84}, failed)
		x86MoveImmediate(out, rax, 0)
		x86Relative(out, 0xe9, done)
		out.Mark(failed)
		x86MoveImmediate(out, rax, -1)
		out.Mark(done)
	}

	func x86WindowsRuntimeChmod(out *RTGEmitter) {
		rax := RTGRegister{Code: 0, Valid: true}
		rcx := RTGRegister{Code: 1, Valid: true}
		rdx := RTGRegister{Code: 2, Valid: true}
		rdi := RTGRegister{Code: 7, Valid: true}
		r8 := RTGRegister{Code: 8, Valid: true}
		r9 := RTGRegister{Code: 9, Valid: true}
		failed := out.NewLabel()
		done := out.NewLabel()
		x86RRRM(out, 0x89, rcx, rdi, 64)
		x86MoveImmediate(out, rdx, 0)
		x86MoveImmediate(out, r8, 0)
		x86MoveImmediate(out, r9, 1)
		x86WindowsCallImport(out, 5)
		x86MoveImmediate(out, rdx, -1)
		x86RRRM(out, 0x39, rax, rdx, 32)
		x86JumpCondition(out, RTGCondition{JumpOpcode: 0x84}, failed)
		x86MoveImmediate(out, rax, 0)
		x86Relative(out, 0xe9, done)
		out.Mark(failed)
		x86MoveImmediate(out, rax, -1)
		out.Mark(done)
	}

	func x86WindowsRuntimeOperation(
		out *RTGEmitter, operation int,
	) bool {
		if operation == RTGRuntimeRead {
			x86WindowsRuntimeReadWrite(out, false, false)
			return true
		}
		if operation == RTGRuntimeWrite {
			x86WindowsRuntimeReadWrite(out, true, false)
			return true
		}
		if operation == RTGRuntimeReadAt {
			x86WindowsRuntimeReadWrite(out, false, true)
			return true
		}
		if operation == RTGRuntimeWriteAt {
			x86WindowsRuntimeReadWrite(out, true, true)
			return true
		}
		if operation == RTGRuntimeOpen {
			x86WindowsRuntimeOpen(out)
			return true
		}
		if operation == RTGRuntimeClose {
			x86WindowsRuntimeClose(out)
			return true
		}
		if operation == RTGRuntimeChmod {
			x86WindowsRuntimeChmod(out)
			return true
		}
		return false
	}

	func x86WindowsLoadRAXFromR10(out *RTGEmitter, offset int) {
		if offset <= 127 {
			out.Bytes4(0x49, 0x8b, 0x42, offset)
			return
		}
		out.Bytes3(0x49, 0x8b, 0x82)
		out.Int32(offset)
	}

	func x86WindowsLoadRAXFromRSP(out *RTGEmitter, offset int) {
		if offset <= 127 {
			out.Bytes4(0x48, 0x8b, 0x44, 0x24)
			out.Byte(offset)
			return
		}
		out.Bytes4(0x48, 0x8b, 0x84, 0x24)
		out.Int32(offset)
	}

	func x86WindowsStoreRAXToRSP(out *RTGEmitter, offset int) {
		if offset <= 127 {
			out.Bytes4(0x48, 0x89, 0x44, 0x24)
			out.Byte(offset)
			return
		}
		out.Bytes4(0x48, 0x89, 0x84, 0x24)
		out.Int32(offset)
	}

	func x86WindowsStoreR10ToRSP(out *RTGEmitter, offset int) {
		if offset <= 127 {
			out.Bytes4(0x4c, 0x89, 0x54, 0x24)
			out.Byte(offset)
			return
		}
		out.Bytes4(0x4c, 0x89, 0x94, 0x24)
		out.Int32(offset)
	}

	func x86WindowsStaticCall(out *RTGEmitter, importID int, wordCount int) {
		if wordCount > 0 {
			x86OpcodeRegister(out, 0x58, RTGRegister{Code: 1, Valid: true})
		}
		if wordCount > 1 {
			x86OpcodeRegister(out, 0x58, RTGRegister{Code: 2, Valid: true})
		}
		if wordCount > 2 {
			out.Bytes2(0x41, 0x58)
		}
		if wordCount > 3 {
			out.Bytes2(0x41, 0x59)
		}
		stackWords := 0
		if wordCount > 4 {
			stackWords = wordCount - 4
		}
		out.Bytes3(0x49, 0x89, 0xe2)
		out.Bytes4(0x48, 0x83, 0xe4, 0xf0)
		savedRSPOff := 32 + stackWords*8
		allocation := RTGAlignValue(savedRSPOff+8, 16)
		if RTGSignedFits(int64(allocation), 8) {
			out.Bytes4(0x48, 0x83, 0xec, allocation)
		} else {
			out.Bytes3(0x48, 0x81, 0xec)
			out.Int32(allocation)
		}
		for i := 0; i < stackWords; i++ {
			x86WindowsLoadRAXFromR10(out, i*8)
			x86WindowsStoreRAXToRSP(out, 32+i*8)
		}
		x86WindowsStoreR10ToRSP(out, savedRSPOff)
		out.Bytes2(0xff, 0x15)
		at := out.Len()
		out.Int32(0)
		out.AbsoluteReloc(at, importID, RTGRelocationImport)
		out.Bytes3(0x49, 0x89, 0xc2)
		x86WindowsLoadRAXFromRSP(out, savedRSPOff)
		out.Bytes3(0x48, 0x89, 0xc4)
		if stackWords > 0 {
			adjust := stackWords * 8
			if RTGSignedFits(int64(adjust), 8) {
				out.Bytes4(0x48, 0x83, 0xc4, adjust)
			} else {
				out.Bytes3(0x48, 0x81, 0xc4)
				out.Int32(adjust)
			}
		}
		out.Bytes3(0x4c, 0x89, 0xd0)
	}

	func renvoAmd64AsmSecondaryDisp(a *RTGEmitter, disp int) {
		if disp == 0 {
			a.Int8(0x02)
		} else if RTGInt8Fits(disp) {
			a.Bytes2(0x42, disp)
		} else {
			a.Int8(0x82)
			a.Int32(disp)
		}
	}

	func renvoAmd64AsmMovRaxImm(a *RTGEmitter, imm int) {
		if imm == 0 {
			a.Uint16(0xc031)
			return
		}
		if RTGInt8Fits(imm) {
			a.Bytes2(0x6a, imm)
			RTGPopPrimary(a)
			return
		}
		if imm>>32 == 0 {
			a.Int8(0xb8)
			a.Int32(imm)
			return
		}
		if imm >= -2147483647 && imm <= 2147483647 {
			a.Int8(0x68)
			a.Int32(imm)
			RTGPopPrimary(a)
			return
		}
		a.Uint16(0xb848)
		a.Int64(imm)
	}

