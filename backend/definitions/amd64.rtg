definition 1
unit x86_64
implements direct_emitter_v1

# X86 algorithms are ordinary Go emitted into the generated backend package.
# The checked-in x86-64 production encoder is projected directly from these
# typed algorithms. Target composition remains declarative below.
go backend {
	func renvoAmd64AsmSecondaryDisp(a *RTGEmitter, disp int) {
		if disp == 0 {
			a.Int8(0x02)
		} else if RTGInt8Fits(disp) {
			a.Bytes2(0x42, disp)
		} else {
			a.Int8(0x82)
			a.Int32(disp)
		}
	}

	func renvoAmd64AsmMovRaxImm(a *RTGEmitter, imm int) {
		if imm == 0 {
			a.Uint16(0xc031)
			return
		}
		if RTGInt8Fits(imm) {
			a.Bytes2(0x6a, imm)
			RTGPopPrimary(a)
			return
		}
		if imm>>32 == 0 {
			a.Int8(0xb8)
			a.Int32(imm)
			return
		}
		if imm >= -2147483647 && imm <= 2147483647 {
			a.Int8(0x68)
			a.Int32(imm)
			RTGPopPrimary(a)
			return
		}
		a.Uint16(0xb848)
		a.Int64(imm)
	}

	func renvoAmd64AsmMovR10BssAddr(a *RTGEmitter, bssOff int) {
		a.Uint24(0x158d4c)
		at := a.Len()
		a.Int32(0)
		a.AbsoluteReloc(at, bssOff, RTGRelocationAbsoluteBSS)
	}
	func renvoAmd64AsmLoadRaxBss(a *RTGEmitter, bssOff int) {
		a.Uint24(0x058b48)
		at := a.Len()
		a.Int32(0)
		a.AbsoluteReloc(at, bssOff, RTGRelocationAbsoluteBSS)
		a.SetPrimaryLoad(a.Len()*8 + 5)
	}
	func renvoAmd64AsmStoreRaxBss(a *RTGEmitter, bssOff int) {
		a.Uint24(0x058948)
		at := a.Len()
		a.Int32(0)
		a.AbsoluteReloc(at, bssOff, RTGRelocationAbsoluteBSS)
	}
	func renvoAmd64AsmMovRdiRax(a *RTGEmitter) {
		if renvoAmd64RewritePrimaryLoad(a, 7, false) {
			return
		}
		a.Uint16(0x5f50)
	}
	func renvoAmd64AsmMovRsiRax(a *RTGEmitter) {
		if renvoAmd64RewritePrimaryLoad(a, 6, false) {
			return
		}
		a.Uint16(0x5e50)
	}

	func renvoAmd64RewritePrimaryLoad(a *RTGEmitter, reg int, pushed bool) bool {
		load := a.PrimaryLoad()
		if pushed {
			load = -load
		}
		end := load >> 3
		at := end - (load & 7)
		if pushed {
			end++
		}
		if load <= 0 || end != a.Len() {
			return false
		}
		a.AddByteAt(at, byte(reg*8))
		if pushed {
			a.Truncate(a.Len() - 1)
		}
		a.SetPrimaryLoad(0)
		return true
	}

	func renvoAmd64RewritePrimaryLoadCompare(a *RTGEmitter, imm int) bool {
		load := a.PrimaryLoad()
		end := load >> 3
		if load <= 0 || end != a.Len() {
			return false
		}
		at := end - (load & 7)
		// RIP-relative displacements use the original instruction end as their
		// base, so only stack and register-relative loads can grow by one byte.
		if a.ByteAt(at)&0xc7 == 0x05 {
			return false
		}
		// Turn `movq memory, %rax; cmpq immediate, %rax` into the shorter direct
		// memory comparison. Callers use this only when the loaded value is dead
		// after the flags are consumed.
		a.SetByteAt(at-1, 0x83)
		a.AddByteAt(at, 0x38)
		a.AppendByte(imm)
		a.SetPrimaryLoad(0)
		return true
	}

	func renvoAmd64AsmMovR8Rax(a *RTGEmitter) {
		a.Uint24(0xc08949)
	}
	func renvoAmd64AsmMovR9Rax(a *RTGEmitter) {
		a.Uint24(0xc18949)
	}
	func renvoAmd64AsmMemDisp(a *RTGEmitter, disp int, op int, disp8 int, disp32 int) {
		a.Uint16(op)
		if RTGInt8Fits(disp) {
			a.Bytes2(disp8, disp)
			return
		}
		a.Int8(disp32)
		a.Int32(disp)
	}
	func renvoAmd64AsmLoadQwordRaxIndexRcx8(a *RTGEmitter) {
		a.Int32(0xc8048b48)
	}
	func renvoAmd64AsmLoadQwordRaxIndexRcxDisp(a *RTGEmitter, disp int) {
		a.Uint16(0x8b48)
		if RTGInt8Fits(disp) {
			a.Bytes3(0x44, 0x8, disp)
			return
		}
		a.Uint16(0x0884)
		a.Int32(disp)
	}

	func renvoAmd64AsmLoadRaxMemRdxDisp(a *RTGEmitter, disp int) {
		if disp == 0 {
			a.Uint24(0x028b48)
			a.SetPrimaryLoad(a.Len()*8 + 1)
			return
		}
		renvoAmd64AsmMemDisp(a, disp, 0x8b48, 0x42, 0x82)
		distance := 2
		if !RTGInt8Fits(disp) {
			distance = 5
		}
		a.SetPrimaryLoad(a.Len()*8 + distance)
	}
	func renvoAmd64AsmLoadRaxMemRdxDispSize(a *RTGEmitter, disp int, size int) {
		if size == 1 {
			a.Uint24(0xb60f48)
			renvoAmd64AsmSecondaryDisp(a, disp)
			return
		}
		if size == 2 {
			a.Uint24(0xbf0f48)
			renvoAmd64AsmSecondaryDisp(a, disp)
			return
		}
		if size == 4 {
			renvoAmd64AsmMemDisp(a, disp, 0x6348, 0x42, 0x82)
			return
		}
		renvoAmd64AsmLoadRaxMemRdxDisp(a, disp)
	}
	func renvoAmd64AsmLoadByteRaxIndexRcx(a *RTGEmitter) {
		a.Int32(0x04b60f48)
		a.Int8(0x8)
	}
	func renvoAmd64AsmLoadRaxIndexRcxSize(a *RTGEmitter, size int) {
		if size == 1 {
			renvoAmd64AsmLoadByteRaxIndexRcx(a)
			return
		}
		if size == 2 {
			a.Int32(0x04bf0f48)
			a.Int8(0x48)
			return
		}
		if size == 4 {
			a.Int32(0x88046348)
			return
		}
		renvoAmd64AsmLoadQwordRaxIndexRcx8(a)
	}
	func renvoAmd64AsmStoreRaxMemRdxRcx8(a *RTGEmitter) {
		a.Int32(0xca048948)
	}
	func renvoAmd64AsmStoreRaxMemRdxDisp(a *RTGEmitter, disp int) {
		if disp == 0 {
			a.Uint24(0x028948)
			return
		}
		renvoAmd64AsmMemDisp(a, disp, 0x8948, 0x42, 0x82)
	}
	func renvoAmd64AsmStoreRaxMemRdxDispSize(a *RTGEmitter, disp int, size int) {
		if size == 1 {
			a.Int8(0x88)
			renvoAmd64AsmSecondaryDisp(a, disp)
			return
		}
		if size == 2 {
			a.Uint16(0x8966)
			renvoAmd64AsmSecondaryDisp(a, disp)
			return
		}
		if size == 4 {
			a.Int8(0x89)
			renvoAmd64AsmSecondaryDisp(a, disp)
			return
		}
		renvoAmd64AsmStoreRaxMemRdxDisp(a, disp)
	}
	func renvoAmd64CodeEnds(a *RTGEmitter, suffix string) bool {
		start := a.Len() - len(suffix)
		if start < 0 {
			return false
		}
		for i := 0; i < len(suffix); i++ {
			if a.ByteAt(start+i) != suffix[i] {
				return false
			}
		}
		return true
	}
	func renvoAmd64AsmNormalizeRaxForKind(a *RTGEmitter, kind int) {
		if kind == RTGScalarByte {
			if renvoAmd64CodeEnds(a, "\x0f\xb6\xc0") || renvoAmd64CodeEnds(a, "\x48\x0f\xb6\x02") || renvoAmd64CodeEnds(a, "\x48\x0f\xb6\x04\x08") {
				return
			}
			a.Uint24(0xc0b60f)
			return
		}
		if kind == RTGScalarInt8 {
			a.Int32(0xc0be0f48)
			return
		}
		if kind == RTGScalarInt16 {
			a.Int32(0xc0bf0f48)
			return
		}
		if kind == RTGScalarUint16 {
			a.Int32(0xc0b70f48)
			return
		}
		if kind == RTGScalarInt32 {
			if renvoAmd64CodeEnds(a, "\x48\x63\xc0") || renvoAmd64CodeEnds(a, "\x48\x63\x04\x88") {
				return
			}
			a.Uint24(0xc06348)
			return
		}
		if kind == RTGScalarUint32 {
			a.Uint16(0xc089)
		}
	}
	func renvoAmd64AsmIncMemRdx(a *RTGEmitter) {
		a.Uint24(0x02ff48)
	}
	func renvoAmd64AsmDecMemRdx(a *RTGEmitter) {
		a.Uint24(0x0aff48)
	}
	func renvoAmd64AsmCmpRaxImm8(a *RTGEmitter, imm int) {
		if imm == 0 {
			// Integer values occupy the full native register on amd64. Testing only
			// EAX makes values whose low word is zero (for example 1 << 40) compare
			// equal to zero and can send both user control flow and the compiler's
			// own immediate-selection logic down the wrong path.
			a.Uint24(0xc08548)
			return
		}
		a.Bytes4(0x48, 0x83, 0xf8, imm)
	}

	func renvoAmd64AsmCmpRaxImm8Discard(a *RTGEmitter, imm int) {
		if renvoAmd64RewritePrimaryLoadCompare(a, imm) {
			return
		}
		renvoAmd64AsmCmpRaxImm8(a, imm)
	}
	func renvoAmd64AsmDivLeftRcxRightRax(a *RTGEmitter, mod bool) {
		if mod {
			a.Text("\x48\x83\xf8\xff\x75\x10\x6a\x01\x5a\x48\xc1\xe2\x3f\x48\x39\xd1\x75\x04\x31\xc0\xeb\x10\x53\x48\x89\xc3\x48\x89\xc8\x48\x99\x48\xf7\xfb\x48\x89\xd0\x5b")
			return
		}
		a.Text("\x48\x83\xf8\xff\x75\x11\x6a\x01\x5a\x48\xc1\xe2\x3f\x48\x39\xd1\x75\x05\x48\x89\xc8\xeb\x0d\x53\x48\x89\xc3\x48\x89\xc8\x48\x99\x48\xf7\xfb\x5b")
	}

	func renvoAmd64AsmCmpRcxRaxSet(a *RTGEmitter, setcc int) {
		a.Int32(0x0fc13948)
		a.Bytes3(setcc, 0xc0, 0xf)
		a.Uint16(0xc0b6)
	}
}
arch x86_64 {
    alias = "amd64"
    endian = little
    word_bits = 64
    pointer_bits = 64
    instruction_alignment = 1
    stack_word_bytes = 8
    stack_alignment = 16
    unaligned_memory = true

    # List position is the architectural register number. The x86 encoder
    # derives low3, REX bits, byte-register names, RSP/R12 SIB rules, and
    # RBP/R13 displacement rules from this single list.
    registers gpr64 = [
        rax, rcx, rdx, rbx, rsp, rbp, rsi, rdi,
        r8, r9, r10, r11, r12, r13, r14, r15
    ]

    locations {
        primary = rax
        secondary = rdx
        tertiary = rcx
        scratch = r10
        division_scratch = rbx
        copy_destination = rdi
        copy_source = rsi
        copy_count = rcx
        stack = rsp
        frame = rbp
    }

    # One row supplies both SETcc and near Jcc. Unsigned conditions no longer
    # need separate hand-written lowering functions.
    conditions {
        eq  0x94 0x84
        ne  0x95 0x85
        slt 0x9c 0x8c
        sge 0x9d 0x8d
        sle 0x9e 0x8e
        sgt 0x9f 0x8f
        ult 0x92 0x82
        uge 0x93 0x83
        ule 0x96 0x86
        ugt 0x97 0x87
    }

    # Width and extension policy is stated once per source-language scalar.
    scalars {
        zero_extend { bool:1 byte:1 uint16:2 uint32:4 }
        sign_extend { int8:1 int16:2 int32:4 }
        native { int:8 int64:8 uint64:8 pointer:8 }
    }

    # Form names are declarative aliases for ordinary Go functions above.
    # A row is specialized into a direct call with its opcode, width, and
    # selector constants; there is no function registry in the result.
    exports {
		renvoAmd64AsmSecondaryDisp = go renvoAmd64AsmSecondaryDisp
        renvoAmd64AsmMovRaxImm = go renvoAmd64AsmMovRaxImm
        renvoAmd64AsmMovR10BssAddr = go renvoAmd64AsmMovR10BssAddr
        renvoAmd64AsmLoadRaxBss = go renvoAmd64AsmLoadRaxBss
        renvoAmd64AsmStoreRaxBss = go renvoAmd64AsmStoreRaxBss
        renvoAmd64AsmMovRdiRax = go renvoAmd64AsmMovRdiRax
        renvoAmd64AsmMovRsiRax = go renvoAmd64AsmMovRsiRax
        renvoAmd64RewritePrimaryLoad = go renvoAmd64RewritePrimaryLoad
        renvoAmd64RewritePrimaryLoadCompare = go renvoAmd64RewritePrimaryLoadCompare
        renvoAmd64AsmMovR8Rax = go renvoAmd64AsmMovR8Rax
        renvoAmd64AsmMovR9Rax = go renvoAmd64AsmMovR9Rax
        renvoAmd64AsmMemDisp = go renvoAmd64AsmMemDisp
        renvoAmd64AsmLoadQwordRaxIndexRcx8 = go renvoAmd64AsmLoadQwordRaxIndexRcx8
        renvoAmd64AsmLoadQwordRaxIndexRcxDisp = go renvoAmd64AsmLoadQwordRaxIndexRcxDisp
        renvoAmd64AsmLoadRaxMemRdxDisp = go renvoAmd64AsmLoadRaxMemRdxDisp
        renvoAmd64AsmLoadRaxMemRdxDispSize = go renvoAmd64AsmLoadRaxMemRdxDispSize
        renvoAmd64AsmLoadByteRaxIndexRcx = go renvoAmd64AsmLoadByteRaxIndexRcx
        renvoAmd64AsmLoadRaxIndexRcxSize = go renvoAmd64AsmLoadRaxIndexRcxSize
        renvoAmd64AsmStoreRaxMemRdxRcx8 = go renvoAmd64AsmStoreRaxMemRdxRcx8
        renvoAmd64AsmStoreRaxMemRdxDisp = go renvoAmd64AsmStoreRaxMemRdxDisp
        renvoAmd64AsmStoreRaxMemRdxDispSize = go renvoAmd64AsmStoreRaxMemRdxDispSize
        renvoAmd64CodeEnds = go renvoAmd64CodeEnds
        renvoAmd64AsmNormalizeRaxForKind = go renvoAmd64AsmNormalizeRaxForKind
        renvoAmd64AsmIncMemRdx = go renvoAmd64AsmIncMemRdx
        renvoAmd64AsmDecMemRdx = go renvoAmd64AsmDecMemRdx
        renvoAmd64AsmCmpRaxImm8 = go renvoAmd64AsmCmpRaxImm8
        renvoAmd64AsmCmpRaxImm8Discard = go renvoAmd64AsmCmpRaxImm8Discard
        renvoAmd64AsmDivLeftRcxRightRax = go renvoAmd64AsmDivLeftRcxRightRax
        renvoAmd64AsmCmpRcxRaxSet = go renvoAmd64AsmCmpRcxRaxSet
    }

    relocation rel32 {
        width = 4
        signed = true
        relative_to = field_end
        kinds = [label, data, bss, import]
    }

    frame {
        base = rbp
        stack = rsp
        alignment = 16
        maximum = 65520
        prologue = [0xc8, frame_size:u16le, 0x00]
        epilogue = [leave, ret]
        overflow_arguments = rbp + 16
    }

}

# Image fields are declared here. Header/section/relocation are generic
# definition-language constructs, not precompiled ELF or PE backends.
format elf64_x86_64 {
    byte_order = little
    address_bits = 64
    file_alignment = 0x1000
    machine = 62

    header elf {
        magic = [0x7f, 0x45, 0x4c, 0x46]
        class = 2
        data = 1
        version = 1
        osabi = 0
        type = 3
        machine = 62
        entry = address(text.start)
        program_header_offset = sizeof(elf_header)
        section_header_offset = stripped ? 0 : sections.offset
        flags = 0
        elf_header_size = 64
        program_header_size = 56
        program_header_count = 2
        section_header_size = stripped ? 0 : 64
        section_header_count = stripped ? 0 : sections.count
        section_name_index = stripped ? 0 : sections.names
    }

    segment text {
        type = load
        flags = read | execute
        file = [headers.start, data.file_start)
        memory = [headers.start, data.memory_start)
        alignment = 0x1000
    }

    segment data {
        type = load
        flags = read | write
        file = [data.file_start, data.file_end)
        memory = [data.memory_start, bss.end)
        alignment = 0x1000
    }

    sections when !stripped {
        text progbits alloc|execute align=16
        data progbits alloc|write align=8
        bss nobits alloc|write align=8
        symtab symtab entry_size=24 link=strtab
        strtab strtab
        shstrtab strtab
    }

    relocation {
        label = rel32
        data = rel32
        bss = rel32
    }
}

format elf64_object_x86_64 {
    byte_order = little
    address_bits = 64
    machine = 62
    type = relocatable

    sections {
        text progbits alloc|execute align=16
        rela_text rela entry_size=24 link=symtab info=text
        data progbits alloc|write align=8
        bss nobits alloc|write align=8
        symtab symtab entry_size=24 link=strtab
        strtab strtab
        shstrtab strtab
    }

    relocation label { number = 2 kind = pc_relative width = 32 addend = -4 }
    relocation data  { number = 2 kind = pc_relative width = 32 addend = -4 }
    relocation bss   { number = 2 kind = pc_relative width = 32 addend = -4 }
    relocation abs64 { number = 1 kind = absolute width = 64 addend = 0 }
}

format pe64_x86_64 {
    byte_order = little
    address_bits = 64
    machine = 0x8664
    image_base = 0x400000
    headers_size = 0x200
    file_alignment = 0x200
    section_alignment = 0x1000
    text_rva = 0x1000

    dos_header {
        magic = [0x4d, 0x5a]
        pe_offset = 0x80
    }

    coff_header {
        machine = 0x8664
        sections = 2
        optional_header_size = 0xf0
        characteristics = executable | large_address_aware
    }

    optional_header {
        magic = 0x20b
        entry = rva(text.start)
        code_base = rva(text.start)
        image_base = 0x400000
        section_alignment = 0x1000
        file_alignment = 0x200
        subsystem = target.subsystem
        stack_reserve = 8MiB
        stack_commit = 4KiB
        heap_reserve = 1MiB
        directories = [imports.directory, imports.iat]
    }

    section text {
        name = ".text"
        flags = code | execute | read
        virtual = text
        raw_alignment = 0x200
    }

    section data {
        name = ".data"
        flags = initialized_data | read | write
        virtual = data + bss
        raw = data
        raw_alignment = 0x200
    }

    imports {
        thunk_bytes = 8
        library = "KERNEL32.dll"
        names = target.runtime.imports

        descriptor size=20 {
            u32 original_first_thunk = rva(import_lookup_table)
            u32 timestamp = 0
            u32 forwarder_chain = 0
            u32 name = rva(library_name)
            u32 first_thunk = rva(import_address_table)
        }

        import_lookup_table {
            entries names as u64 rva(hint_name(entry))
            terminator = u64 0
        }

        import_address_table {
            entries names as u64 rva(hint_name(entry))
            terminator = u64 0
        }

        hint_name(entry) {
            u16 0
            ascii entry
            u8 0
            align 2
        }

        library_name {
            ascii library
            u8 0
        }

        directory.rva = rva(descriptor)
        directory.size = sizeof(descriptor)
        iat.rva = rva(import_address_table)
        iat.size = sizeof(import_address_table)
    }

    relocation import = rel32 from instruction_end to imports.iat_entry
    relocation data = rel32 from instruction_end to data
    relocation bss = rel32 from instruction_end to bss
}

format coff64_object_x86_64 {
    byte_order = little
    address_bits = 64
    machine = 0x8664
    sections = [text, data, bss]
    symbol_table entry_size=18 {
        name = inline_8_or_string_offset
        value = section_offset
        section = section_index
        type = symbol_type
        storage_class = symbol_visibility
        auxiliaries = 0
    }

    string_table {
        u32 size
        entries long_symbol_names {
            ascii long_symbol_name
            u8 0
        }
    }

    relocation label { number = 0x0004 kind = rel32 addend = -4 }
    relocation data  { number = 0x0004 kind = rel32 addend = -4 }
    relocation bss   { number = 0x0004 kind = rel32 addend = -4 }
    relocation abs64 { number = 0x0001 kind = absolute width = 64 }
}

# Runtime declarations define only the supported boundary. Missing operations
# are rejected during definition validation rather than silently emulated.
runtime linux_x86_64 {
    entry process_stack {
        argc = word(rsp, 0)
        argv = words(rsp + 8, argc)
        envp = words(rsp + 16 + argc * 8, until_null)
        string = nul_terminated_bytes
        result = [slice(argv), slice(envp)]
    }

    syscall {
        number = rax
        arguments = [rdi, rsi, rdx, r10, r8, r9]
        result = rax
        error = negative
        instruction = syscall
    }

    operation read     { number = 0  args = [fd, buffer, count] }
    operation write    { number = 1  args = [fd, buffer, count] }
    operation open     { number = 2  args = [path, flags, mode] }
    operation close    { number = 3  args = [fd] }
    operation read_at  { number = 17 args = [fd, buffer, count, offset] }
    operation write_at { number = 18 args = [fd, buffer, count, offset] }
    operation chmod    { number = 91 args = [fd, mode] }
    operation print    { use = write args = [stderr, buffer, count] }
    operation exit     { number = 60 args = [status] noreturn = true }
}

runtime win32_x86_64 {
    imports "KERNEL32.dll" = [
        CreateFileA,
        CloseHandle,
        ReadFile,
        WriteFile,
        SetFilePointer,
        GetStdHandle,
        GetCommandLineA,
        ExitProcess,
        GetEnvironmentStringsA
    ]

    entry {
        arguments.source = call GetCommandLineA
        arguments.parse = go windowsCommandLine
        environment.source = call GetEnvironmentStringsA
        environment.parse = nul_terminated_pairs
        result = [slice(arguments), slice(environment)]
    }

    operation open {
        call = CreateFileA
        arguments = [
            path,
            access(flags),
            share_read | share_write,
            null,
            disposition(flags),
            normal_attributes,
            null
        ]
        result = handle_or_error
    }

    operation close {
        call = CloseHandle
        arguments = [fd]
        result = bool_or_error
    }

    operation read {
        call = ReadFile
        arguments = [fd, buffer, count, address(transferred), null]
        result = transferred_or_error
    }

    operation write {
        call = WriteFile
        arguments = [fd, buffer, count, address(transferred), null]
        result = transferred_or_error
    }

    operation read_at {
        sequence = [seek(fd, offset), read(fd, buffer, count)]
    }

    operation write_at {
        sequence = [seek(fd, offset), write(fd, buffer, count)]
    }

    operation seek {
        call = SetFilePointer
        arguments = [fd, low32(offset), address(high32(offset)), begin]
        result = position_or_error
    }

    operation print {
        sequence = [GetStdHandle(stderr), write(result, buffer, count)]
    }

    operation chmod {
        unsupported = "Win32 target does not expose chmod"
    }

    operation exit {
        call = ExitProcess
        arguments = [status]
        noreturn = true
    }
}

runtime linux_kernel_x86_64 {
    entry = kernel_module_init
    exit = kernel_module_exit
    operation print { import = printk }
    operation open { unsupported = "kernel module runtime has no file API" }
    operation close { unsupported = "kernel module runtime has no file API" }
    operation read { unsupported = "kernel module runtime has no file API" }
    operation write { unsupported = "kernel module runtime has no file API" }
    operation chmod { unsupported = "kernel module runtime has no file API" }
}

abi renvo_x86_64 {
    arch = x86_64
    call_words = [rdi, rsi, rdx, rcx, r8, r9]
    overflow_stride = 8
    scalar_result = rax
    string_result = [rax, rdx]
    slice_result = [rax, rdx, rcx]
    hidden_result_word = 0
}

abi sysv_x86_64 {
    internal = renvo_x86_64
    arguments = [rdi, rsi, rdx, rcx, r8, r9]
    result = [rax, rdx]
    caller_saved = [rax, rcx, rdx, rsi, rdi, r8, r9, r10, r11]
    callee_saved = [rbx, rbp, r12, r13, r14, r15]
    stack_alignment = 16
    red_zone = unused
}

abi windows_x86_64 {
    internal = renvo_x86_64
    arguments = [rcx, rdx, r8, r9]
    result = [rax, rdx]
    caller_saved = [rax, rcx, rdx, r8, r9, r10, r11]
    callee_saved = [rbx, rbp, rdi, rsi, r12, r13, r14, r15]
    stack_alignment = 16
    shadow_space = 32
    stack_probe {
        page_bytes = 4096
        direction = down
        touch_each_page = true
    }
}

target linux/amd64 {
    arch = x86_64
    abi = sysv_x86_64
    runtime = linux_x86_64
    executable = elf64_x86_64
    object = elf64_object_x86_64
    build_tags = ["linux", "amd64"]
    capabilities = [
        hosted, executable, object, filesystem, heap,
        argv, environment, linkstatic
    ]
}

target windows/amd64 {
    arch = x86_64
    abi = windows_x86_64
    runtime = win32_x86_64
    executable = pe64_x86_64
    object = coff64_object_x86_64
    subsystem = console
    build_tags = ["windows", "amd64"]
    capabilities = [
        hosted, executable, object, filesystem, heap,
        argv, environment, imports, linkstatic, windows_gui
    ]
}

target linux-kernel/amd64 {
    arch = x86_64
    abi = sysv_x86_64
    runtime = linux_kernel_x86_64
    object = elf64_object_x86_64
    build_tags = ["linux", "amd64", "renvo_kernel"]
    capabilities = [freestanding, kernel_module, object, imports, linkstatic]
}
