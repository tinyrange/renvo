	func x86ELFPatchAbsoluteRelocations(a *RTGEmitter, codeOffset int, dataOffset int, bssOffset int) {
		for i := 0; i < a.AbsoluteRelocationCount(); i++ {
			at := a.AbsoluteRelocationOffset(i)
			addend := a.AbsoluteRelocationAddend(i)
			kind := a.AbsoluteRelocationKind(i)
			target := dataOffset + addend
			if kind == RTGRelocationAbsoluteBSS {
				target = bssOffset + addend
			}
			a.PatchUint32(at, target-(codeOffset+at+4))
		}
	}

	func x86ELF64Image(a *RTGEmitter) []byte {
		codeOffset := 176
		code := a.Code()
		data := a.Data()
		dataOffset := codeOffset + len(code)
		fileSize := dataOffset + len(data)
		bssOffset := RTGAlignValue(fileSize, 4096)
		x86ELFPatchAbsoluteRelocations(a, codeOffset, dataOffset, bssOffset)
		code = a.Code()
		var out []byte
		out = append(out, 0x7f, 'E', 'L', 'F', 2, 1, 1, 0)
		for len(out) < 16 {
			out = append(out, 0)
		}
		out = append(out, 3, 0, 62, 0)
		out = x86ELFAppend32(out, 1)
		out = x86ELFAppend64(out, codeOffset)
		out = x86ELFAppend64(out, 64)
		out = x86ELFAppend64(out, 0)
		out = x86ELFAppend32(out, 0)
		out = append(out, 64, 0, 56, 0, 2, 0, 0, 0, 0, 0, 0, 0)
		out = x86ELFAppend32(out, 1)
		out = x86ELFAppend32(out, 5)
		out = x86ELFAppend64(out, 0)
		out = x86ELFAppend64(out, 0)
		out = x86ELFAppend64(out, 0)
		out = x86ELFAppend64(out, fileSize)
		out = x86ELFAppend64(out, fileSize)
		out = x86ELFAppend64(out, 4096)
		out = x86ELFAppend32(out, 1)
		out = x86ELFAppend32(out, 6)
		out = x86ELFAppend64(out, bssOffset)
		out = x86ELFAppend64(out, bssOffset)
		out = x86ELFAppend64(out, bssOffset)
		out = x86ELFAppend64(out, 0)
		out = x86ELFAppend64(out, a.BSSSize())
		out = x86ELFAppend64(out, 4096)
		out = append(out, code...)
		out = append(out, data...)
		return out
	}

	type x86PELayout struct {
		importRVA int
		importSize int
		iatRVA int
		iatSize int
		iat []int
	}

	func x86PEPut16(out []byte, at int, value int) {
		out[at] = byte(value)
		out[at+1] = byte(value >> 8)
	}

	func x86PEPut64(out []byte, at int, value int) {
		x86ELFPut32(out, at, value)
		x86ELFPut32(out, at+4, 0)
	}

	func x86PEUntil(out []byte, size int) []byte {
		for len(out) < size {
			out = append(out, 0)
		}
		return out
	}

	func x86PEString(out []byte, value string) []byte {
		for i := 0; i < len(value); i++ {
			out = append(out, value[i])
		}
		return append(out, 0)
	}

	func x86PEImportName(id int) string {
		if id == 1 { return "CreateFileA" }
		if id == 2 { return "CloseHandle" }
		if id == 3 { return "ReadFile" }
		if id == 4 { return "WriteFile" }
		if id == 5 { return "SetFilePointer" }
		if id == 6 { return "GetStdHandle" }
		if id == 7 { return "GetCommandLineA" }
		if id == 9 { return "GetEnvironmentStringsA" }
		return "ExitProcess"
	}

	func x86PEImportEntry(data []byte, layout *x86PELayout, dataRVA int, iltAt int, iatAt int, slot int, id int, name string) []byte {
		nameAt := len(data)
		data = append(data, 0, 0)
		data = x86PEString(data, name)
		if len(data)&1 != 0 {
			data = append(data, 0)
		}
		nameRVA := dataRVA + nameAt
		x86PEPut64(data, iltAt+slot*8, nameRVA)
		x86PEPut64(data, iatAt+slot*8, nameRVA)
		layout.iat[id] = dataRVA + iatAt + slot*8
		return data
	}

	func x86PEBuildImports(out *RTGEmitter, data []byte, dataRVA int) ([]byte, x86PELayout) {
		var layout x86PELayout
		staticCount := out.StaticImportCount()
		importAt := RTGAlignValue(len(data), 8)
		data = x86PEUntil(data, importAt+(staticCount+2)*20)
		iltAt := len(data)
		data = x86PEUntil(data, iltAt+80)
		iatAt := len(data)
		data = x86PEUntil(data, iatAt+80)
		customAt := len(data)
		data = x86PEUntil(data, customAt+staticCount*32)
		layout.iat = make([]int, 10+staticCount)
		for id := 1; id <= 9; id++ {
			data = x86PEImportEntry(data, &layout, dataRVA, iltAt, iatAt, id-1, id, x86PEImportName(id))
		}
		for i := 0; i < staticCount; i++ {
			customILT := customAt + i*32
			customIAT := customILT + 16
			data = x86PEImportEntry(data, &layout, dataRVA, customILT, customIAT, 0, 10+i, out.StaticImportName(i))
		}
		dllAt := len(data)
		data = x86PEString(data, "kernel32.dll")
		x86ELFPut32(data, importAt, dataRVA+iltAt)
		x86ELFPut32(data, importAt+12, dataRVA+dllAt)
		x86ELFPut32(data, importAt+16, dataRVA+iatAt)
		for i := 0; i < staticCount; i++ {
			customILT := customAt + i*32
			customIAT := customILT + 16
			dllAt = len(data)
			data = x86PEString(data, out.StaticImportDLL(i))
			descriptor := importAt + (i+1)*20
			x86ELFPut32(data, descriptor, dataRVA+customILT)
			x86ELFPut32(data, descriptor+12, dataRVA+dllAt)
			x86ELFPut32(data, descriptor+16, dataRVA+customIAT)
		}
		layout.importRVA = dataRVA + importAt
		layout.importSize = len(data) - importAt
		layout.iatRVA = dataRVA + iatAt
		layout.iatSize = customAt + staticCount*32 - iatAt
		return data, layout
	}

	func x86PEPatch(out *RTGEmitter, dataRVA int, dataSize int, layout x86PELayout) {
		for i := 0; i < out.AbsoluteRelocationCount(); i++ {
			at := out.AbsoluteRelocationOffset(i)
			addend := out.AbsoluteRelocationAddend(i)
			kind := out.AbsoluteRelocationKind(i)
			target := dataRVA + addend
			if kind == RTGRelocationAbsoluteBSS {
				target = dataRVA + dataSize + addend
			} else if kind == RTGRelocationImport {
				if addend > 0 && addend < len(layout.iat) {
					target = layout.iat[addend]
				}
			}
			out.PatchUint32(at, target-(0x1000+at+4))
		}
	}

	func x86PESection(out []byte, name string, virtualSize int, rva int, rawSize int, rawAt int, flags int) []byte {
		start := len(out)
		out = x86PEUntil(out, start+40)
		for i := 0; i < len(name); i++ {
			out[start+i] = name[i]
		}
		x86ELFPut32(out, start+8, virtualSize)
		x86ELFPut32(out, start+12, rva)
		x86ELFPut32(out, start+16, rawSize)
		x86ELFPut32(out, start+20, rawAt)
		x86ELFPut32(out, start+36, flags)
		return out
	}

	func x86PEHeader(textRaw int, textSize int, dataRVA int, dataRaw int, dataSize int, layout x86PELayout, subsystem int) []byte {
		out := make([]byte, 0, 512)
		out = x86PEUntil(out, 512)
		x86PEPut16(out, 0, 0x5a4d)
		x86ELFPut32(out, 0x3c, 0x80)
		pe := 0x80
		x86ELFPut32(out, pe, 0x00004550)
		x86PEPut16(out, pe+4, 0x8664)
		x86PEPut16(out, pe+6, 2)
		x86PEPut16(out, pe+20, 0xf0)
		x86PEPut16(out, pe+22, 0x22)
		opt := pe + 24
		x86PEPut16(out, opt, 0x20b)
		x86ELFPut32(out, opt+4, textRaw)
		x86ELFPut32(out, opt+8, dataRaw)
		x86ELFPut32(out, opt+16, 0x1000)
		x86ELFPut32(out, opt+20, 0x1000)
		x86PEPut64(out, opt+24, 0x400000)
		x86ELFPut32(out, opt+32, 0x1000)
		x86ELFPut32(out, opt+36, 0x200)
		x86PEPut16(out, opt+40, 4)
		x86PEPut16(out, opt+48, 4)
		x86ELFPut32(out, opt+56, RTGAlignValue(dataRVA+dataSize, 0x1000))
		x86ELFPut32(out, opt+60, 0x200)
		x86PEPut16(out, opt+68, subsystem)
		x86PEPut16(out, opt+70, 0x100)
		x86PEPut64(out, opt+72, 0x800000)
		x86PEPut64(out, opt+80, 0x1000)
		x86PEPut64(out, opt+88, 0x100000)
		x86PEPut64(out, opt+96, 0x1000)
		x86ELFPut32(out, opt+108, 16)
		x86ELFPut32(out, opt+120, layout.importRVA)
		x86ELFPut32(out, opt+124, layout.importSize)
		x86ELFPut32(out, opt+208, layout.iatRVA)
		x86ELFPut32(out, opt+212, layout.iatSize)
		out = out[:opt+240]
		out = x86PESection(out, ".text", textSize, 0x1000, textRaw, 0x200, 0x60000020)
		out = x86PESection(out, ".data", dataSize, dataRVA, dataRaw, 0x200+textRaw, 0xc0000040)
		return x86PEUntil(out, 0x200)
	}

	func x86PE64Image(out *RTGEmitter) []byte {
		code := out.Code()
		for len(code)%8 != 0 {
			code = append(code, 0)
		}
		out.SetCode(code)
		textSize := len(code)
		textRaw := RTGAlignValue(textSize, 0x200)
		dataRVA := RTGAlignValue(0x1000+textSize, 0x1000)
		data, layout := x86PEBuildImports(out, out.Data(), dataRVA)
		out.SetData(data)
		x86PEPatch(out, dataRVA, len(data), layout)
		dataRaw := RTGAlignValue(len(data), 0x200)
		dataSize := len(data) + out.BSSSize()
		image := x86PEHeader(textRaw, textSize, dataRVA, dataRaw, dataSize, layout, out.WindowsSubsystem())
		image = append(image, out.Code()...)
		image = x86PEUntil(image, 0x200+textRaw)
		image = append(image, data...)
		return x86PEUntil(image, 0x200+textRaw+dataRaw)
	}

	func x86WindowsExit(out *RTGEmitter, status RTGRegister) {
		if status.Code != 1 {
			x86RRRM(out, 0x89, RTGRegister{Code: 1, Valid: true}, status, 64)
		}
		out.Bytes4(0x48, 0x83, 0xec, 0x28)
		out.Bytes2(0xff, 0x15)
		at := out.Len()
		out.Int32(0)
		out.AbsoluteReloc(at, 8, RTGRelocationImport)
	}

	func x86WindowsCallImport(out *RTGEmitter, importID int) {
		out.Bytes4(0x48, 0x83, 0xec, 0x28)
		out.Bytes2(0xff, 0x15)
		at := out.Len()
		out.Int32(0)
		out.AbsoluteReloc(at, importID, RTGRelocationImport)
		out.Bytes4(0x48, 0x83, 0xc4, 0x28)
	}

	func x86WindowsRuntimeReadWrite(
		out *RTGEmitter, write bool, positional bool,
	) {
		helper := out.NewLabel()
		after := out.NewLabel()
		countOffset := out.ReserveBSS(8, 8)
		positionOffset := out.ReserveBSS(8, 8)
		base := out.Len()
		x86Relative(out, 0xe9, after)
		out.Mark(helper)
		importID := 3
		template := "\x57\x56\x52\x51\x48\x83\x7c\x24\x18\x00\x74\x02\xeb\x18\xb9\xf6\xff\xff\xff\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\x44\x24\x18\x48\x83\x3c\x24\x00\x0f\x8c\x80\x00\x00\x00\x48\x8b\x4c\x24\x18\x31\xd2\x45\x31\xc0\x41\xb9\x01\x00\x00\x00\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x89\x05\x00\x00\x00\x00\x48\x8b\x4c\x24\x18\x48\x8b\x14\x24\x45\x31\xc0\x45\x31\xc9\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x8b\x4c\x24\x18\x48\x8b\x54\x24\x10\x4c\x8b\x44\x24\x08\x48\x8d\x05\x00\x00\x00\x00\x49\x89\xc1\x48\x83\xec\x28\x48\xc7\x44\x24\x20\x00\x00\x00\x00\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x83\xf8\x00\x74\x52\x48\x8b\x05\x00\x00\x00\x00\xeb\x4c\x48\x8b\x4c\x24\x18\x48\x8b\x54\x24\x10\x4c\x8b\x44\x24\x08\x48\x8d\x05\x00\x00\x00\x00\x49\x89\xc1\x48\x83\xec\x28\x48\xc7\x44\x24\x20\x00\x00\x00\x00\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x83\xf8\x00\x74\x0c\x48\x8b\x05\x00\x00\x00\x00\x48\x83\xc4\x20\xc3\x6a\xff\x58\x48\x83\xc4\x20\xc3\x6a\xff\x58\x48\x89\x05\x00\x00\x00\x00\x48\x8b\x4c\x24\x18\x48\x8b\x05\x00\x00\x00\x00\x50\x5a\x45\x31\xc0\x45\x31\xc9\x48\x83\xec\x28\xff\x15\x00\x00\x00\x00\x48\x83\xc4\x28\x48\x8b\x05\x00\x00\x00\x00\x48\x83\xc4\x20\xc3"
		commonOffset := 24
		if write {
			importID = 4
