go compiler {
	func renvo386CompilerBitwisePrimaryTertiary(a *renvoAsm, op byte) {
		instruction := 0xc821
		if op == '|' {
			instruction = 0xc809
		} else if op == '^' {
			instruction = 0xc831
		} else if op != '&' {
			a.patchFailed = true
			return
		}
		renvoAsmEmit16(a, instruction)
	}
}

