		}
		renvoAsmLoadPrimaryStack(&g.asm, right)
		renvo386AsmStackMem(&g.asm, left, 0x39, 0x45, 0x85)
		renvoEmitCompareJumpOp(&g.asm, c0, c1, label, jumpIfTrue, unsigned)
		return true
	}
}

