go compiler {
	func renvo386CompilerPushImm(a *renvoAsm, imm int) {
		renvoNonNil(a)
		if renvoAsmImmFits8Signed(imm) {
			renvoAsmEmit2(a, 0x6a, imm)
			return
		}
		if imm >= -2147483647 && imm <= 2147483647 {
			renvoAsmEmit8(a, 0x68)
			renvoAsmEmit32(a, imm)
			return
		}
		renvoAsmPrimaryImm(a, imm)
		renvoAsmPushPrimary(a)
	}

	func renvo386CompilerStorePrimaryStack(a *renvoAsm, offset int) {
		renvoNonNil(a)
		renvoAsmStackMem(a, offset, 0x8948, 0x45, 0x85)
		if renvoFixedTarget == 0 && a.c.code16 {
			a.lastPrimaryStoreEnd = len(a.code)
			a.lastPrimaryStoreOff = offset
		}
	}

	func renvo386CompilerStoreSecondaryStack(a *renvoAsm, offset int) {
		renvoNonNil(a)
		renvoAsmStackMem(a, offset, 0x8948, 0x55, 0x95)
	}

	func renvo386CompilerLoadPrimaryStack(a *renvoAsm, offset int) {
		renvoNonNil(a)
		if renvoFixedTarget == 0 && a.c.code16 {
			n := len(a.code)
			if a.lastPrimaryStoreEnd == n && a.lastPrimaryStoreOff == offset {
				return
			}
		}
		renvoAsmStackMem(a, offset, 0x8b48, 0x45, 0x85)
		if renvoFixedTarget == 0 && a.c.code16 {
			distance := 2
			if offset < 0 || offset > 128 {
				distance = 5
			}
			a.lastPrimaryLoad = len(a.code)*8 + distance
		}
	}

	func renvo386CompilerIncStack(a *renvoAsm, offset int) {
		renvoNonNil(a)
		renvoAsmLoadPrimaryStack(a, offset)
		renvoAsmIncPrimary(a)
		renvoAsmStorePrimaryStack(a, offset)
	}

	func renvo386CompilerDecStack(a *renvoAsm, offset int) {
		renvoNonNil(a)
		renvoAsmLoadPrimaryStack(a, offset)
		renvoAsmPushImm(a, 1)
		renvoAsmPopTertiary(a)
		renvoAsmSubPrimaryTertiary(a)
		renvoAsmStorePrimaryStack(a, offset)
	}

	func renvo386CompilerAddressPrimaryStack(a *renvoAsm, offset int) {
		renvoNonNil(a)
		renvoAsmStackMem(a, offset, 0x8d48, 0x45, 0x85)
		if renvoFixedTarget == 0 && a.c.code16 {
			distance := 2
			if offset < 0 || offset > 128 {
				distance = 5
			}
			a.lastPrimaryLoad = len(a.code)*8 + distance
		}
	}

	func renvo386CompilerAddressCallWord0Stack(a *renvoAsm, offset int) {
		renvoNonNil(a)
		renvoAsmStackMem(a, offset, 0x8d48, 0x7d, 0xbd)
	}

	func renvo386CompilerAddressCallWord1Stack(a *renvoAsm, offset int) {
		renvoNonNil(a)
		renvoAsmStackMem(a, offset, 0x8d48, 0x75, 0xb5)
	}

	func renvo386CompilerLoadSecondaryStack(a *renvoAsm, offset int) {
		renvoNonNil(a)
		renvoAsmStackMem(a, offset, 0x8b48, 0x55, 0x95)
	}

	func renvo386CompilerLoadTertiaryStack(a *renvoAsm, offset int) {
		renvoNonNil(a)
		renvoAsmStackMem(a, offset, 0x8b48, 0x4d, 0x8d)
	}

	func renvo386CompilerStoreSliceStack(a *renvoAsm, offset int) {
		renvoAsmStorePrimarySecondaryStack(a, offset, offset-8)
		renvoAsmStackMem(a, offset-16, 0x8948, 0x4d, 0x8d)
	}

	func renvo386CompilerMulTertiaryImm(a *renvoAsm, imm int) {
		renvoNonNil(a)
		if imm == 1 {
			return
		}
		if renvoAsmImmFits8Signed(imm) {
			renvoAsmEmit3(a, 0x6b, 0xc9, imm)
			return
		}
		renvoAsmEmit16(a, 0xc969)
		renvoAsmEmit32(a, imm)
	}

	func renvo386CompilerCallLabel(a *renvoAsm, label int) {
		renvoNonNil(a)
		renvoAsmEmit8(a, 0xe8)
		at := len(a.code)
		renvoAsmEmit32(a, 0)
		renvoAsmAddReloc(a, at, label)
	}

	func renvo386CompilerJmpLabel(a *renvoAsm, label int) {
		renvoNonNil(a)
		renvoAsmEmit8(a, 0xe9)
		at := len(a.code)
		renvoAsmEmit32(a, 0)
		renvoAsmAddReloc(a, at, label)
	}

	func renvo386CompilerJzLabel(a *renvoAsm, label int) {
		renvoNonNil(a)
		renvoAsmEmit16(a, 0x840f)
		at := len(a.code)
		renvoAsmEmit32(a, 0)
		renvoAsmAddReloc(a, at, label)
	}

	func renvo386CompilerJnzLabel(a *renvoAsm, label int) {
		renvoNonNil(a)
		renvoAsmEmit16(a, 0x850f)
		at := len(a.code)
		renvoAsmEmit32(a, 0)
		renvoAsmAddReloc(a, at, label)
	}
}

go compiler {
	func renvo386CompilerSecondaryImm(a *renvoAsm, imm int) {
		renvoNonNil(a)
		renvo386AsmMovRdxImm(a, imm)
	}

	func renvo386CompilerPrimaryDataAddr(a *renvoAsm, dataOff int) {
		renvoNonNil(a)
		renvo386AsmMovRaxAddr(a, dataOff, 0)
	}

	func renvo386CompilerPrimaryBssAddr(a *renvoAsm, bssOff int) {
		renvoNonNil(a)
		renvo386AsmMovRaxAddr(a, bssOff, renvoAbsBssReloc)
	}

	func renvo386CompilerLoadPrimaryBss(a *renvoAsm, bssOff int) {
		renvoNonNil(a)
		renvo386AsmLoadRaxBss(a, bssOff)
	}

	func renvo386CompilerStorePrimaryBss(a *renvoAsm, bssOff int) {
		renvoNonNil(a)
		renvo386AsmStoreRaxBss(a, bssOff)
	}

	func renvo386CompilerPopCallWord0(a *renvoAsm) {
		renvoNonNil(a)
		if renvoFixedTarget == 0 && a.c.code16 {
			if renvo386CancelAdjacentPush(a, 0x57) {
				return
			}
		}
		if renvoFixedTarget == 0 && a.c.code16 {
			if renvo386RewritePrimaryLoad(a, 7, true) {
				return
			}
			if renvo386CancelAdjacentPush(a, 0x50) {
				renvoAsmEmit16(a, 0xc389)
				return
			}
		}
		renvo386AsmPopRdi(a)
	}

	func renvo386CompilerPopCallWord1(a *renvoAsm) {
		renvoNonNil(a)
		if renvoFixedTarget == 0 && a.c.code16 {
			if renvo386CancelAdjacentPush(a, 0x56) {
				return
			}
			if renvo386RewritePrimaryLoad(a, 6, true) {
				return
			}
			if renvo386CancelAdjacentPush(a, 0x50) {
				renvoAsmEmit16(a, 0xc689)
				return
			}
		}
		renvoAsmEmit8(a, 0x5e)
	}

	func renvo386CompilerAddSecondaryImm(a *renvoAsm, imm int) {
		renvoNonNil(a)
		renvo386AsmAddRdxImm(a, imm)
	}

	func renvo386CompilerLoadQwordPrimaryIndexTertiaryDisp(a *renvoAsm, disp int) {
		renvoNonNil(a)
		renvo386AsmLoadQwordRaxIndexRcxDisp(a, disp)
	}

	func renvo386CompilerLoadPrimaryMemSecondaryDisp(a *renvoAsm, disp int) {
		renvoNonNil(a)
		renvo386AsmLoadRaxMemRdxDisp(a, disp)
		if renvoFixedTarget == 0 && a.c.code16 {
			distance := 1
			if disp != 0 {
				distance = 2
				if !renvoAsmImmFits8Signed(disp) {
					distance = 5
				}
			}
			a.lastPrimaryLoad = len(a.code)*8 + distance
		}
	}

	func renvo386CompilerLoadPrimaryMemSecondaryDispSize(a *renvoAsm, disp int, size int) {
		renvoNonNil(a)
		renvo386AsmLoadRaxMemRdxDispSize(a, disp, size)
		if renvoFixedTarget == 0 && a.c.code16 {
			distance := 1
			if disp != 0 {
				distance = 2
				if !renvoAsmImmFits8Signed(disp) {
					distance = 5
				}
			}
			a.lastPrimaryLoad = len(a.code)*8 + distance
		}
	}

	func renvo386CompilerLoadPrimaryIndexTertiarySize(a *renvoAsm, size int) {
		renvoNonNil(a)
		renvo386AsmLoadRaxIndexRcxSize(a, size)
		if renvoFixedTarget == 0 && a.c.code16 && (size == 1 || size == 2) {
			a.lastPrimaryLoad = len(a.code)*8 + 2
		}
	}

	func renvo386CompilerStorePrimaryMemSecondaryDisp(a *renvoAsm, disp int) {
		renvoNonNil(a)
		renvo386AsmStoreRaxMemRdxDisp(a, disp)
	}

	func renvo386CompilerStorePrimaryMemSecondaryDispSize(a *renvoAsm, disp int, size int) {
		renvoNonNil(a)
		renvo386AsmStoreRaxMemRdxDispSize(a, disp, size)
	}

	func renvo386CompilerNormalizePrimaryForKind(a *renvoAsm, kind int) {
		renvoNonNil(a)
		if renvoFixedTarget == 0 && a.c.code16 && renvo386FusePrimaryLoadNormalization(a, kind) {
			return
		}
		if renvoFixedTarget == 0 && a.c.code16 && renvo386PrimaryNormalizationRepeated(a, kind) {
			return
		}
		renvo386AsmNormalizeRaxForKind(a, kind)
	}

	func renvo386CompilerCmpPrimaryImm8(a *renvoAsm, imm int) {
		renvoNonNil(a)
		renvo386AsmCmpRaxImm8(a, imm)
	}

	func renvo386CompilerCmpPrimaryImm8Discard(a *renvoAsm, imm int) {
		renvoNonNil(a)
		if renvoFixedTarget == 0 && a.c.code16 && renvo386RewritePrimaryLoadCompare(a, imm) {
			return
		}
		renvoAsmCmpPrimaryImm8(a, imm)
	}

	func renvo386CompilerShlTertiaryImm(a *renvoAsm, imm int) {
		renvoNonNil(a)
		renvo386AsmShlRcxImm(a, imm)
	}

	func renvo386CompilerShlPrimaryImm(a *renvoAsm, imm int) {
		renvoNonNil(a)
		renvo386AsmShlRaxImm(a, imm)
	}

	func renvo386CompilerSarPrimaryImm(a *renvoAsm, imm int) {
		renvoNonNil(a)
		renvo386AsmSarRaxImm(a, imm)
	}

	func renvo386CompilerDivLeftTertiaryRightPrimary(a *renvoAsm, mod bool) {
		renvoNonNil(a)
		renvo386AsmDivLeftRcxRightRax(a, mod)
	}

	func renvo386CompilerCmpTertiaryPrimarySet(a *renvoAsm, setcc int) {
		renvoNonNil(a)
		renvo386AsmCmpRcxRaxSet(a, setcc)
	}

	func renvo386CompilerStorePrimaryMemSecondaryTertiarySize(a *renvoAsm, size int) {
		renvoNonNil(a)
		if size == 1 {
			renvoAsmStoreByteMemSecondaryTertiary(a)
			return
		}
		if size == 2 {
			renvoAsmEmit32(a, 0x4a048966)
			return
		}
		if size == 4 {
			renvoAsmEmit24(a, 0x8a0489)
			return
		}
		renvoAsmStorePrimaryMemSecondaryTertiary8(a)
	}

	func renvo386CompilerCmpTertiaryPrimaryJump(a *renvoAsm, setcc int, label int) {
		renvoNonNil(a)
		renvoAsmEmit16(a, 0xc139)
		renvo386AsmJccLabel(a, setcc-0x10, label)
	}
}

# Immediate, frame-branch, and runtime-boundary emission.
go compiler {
	func renvo386CompilerPrimaryImm(a *renvoAsm, imm int) {
		renvo386AsmMovRaxImm(a, imm)
	}

	func renvo386CompilerSyscall(a *renvoAsm) {
		renvo386AsmSyscall(a)
	}

	func renvo386CompilerPushStackWord(a *renvoAsm, offset int) {
		if renvoFixedTarget == 0 && a.c.code16 {
			// The 386 call adapter recognizes contiguous load/push argument words and
			// rewrites the whole sequence into direct frame-to-register loads.  Emit
			// the analyzable form for code16, where avoiding both PUSH and POP also
			// removes two operand-size prefixes per argument.
			renvoAsmPushStack(a, offset)
			return
		}
		renvoAsmEmit8(a, 0xff)
		if offset >= 0 && offset <= 128 {
			renvoAsmEmit8(a, 0x75)
			renvoAsmEmit8(a, -offset)
			return
		}
		renvoAsmEmit8(a, 0xb5)
		renvoAsmEmit32(a, -offset)
		return
	}

	func renvo386CompilerJcmpStackStack(a *renvoAsm, left int, right int, label int, setcc int) {
		if renvoFixedTarget == 0 && a.c.code16 {
			// Compare the right frame value in EAX directly with the left frame
			// value.  The stack-machine sequence used on the other compact targets
			// adds a push, pop, and (for code16) two operand-size overrides without
			// changing either operand.
			renvoAsmLoadPrimaryStack(a, right)
			renvoAsmStackMem(a, left, 0x39, 0x45, 0x85)
			renvo386AsmJccLabel(a, setcc-0x10, label)
			return
		}
		renvoAsmPushStack(a, left)
		renvoAsmLoadPrimaryStack(a, right)
		renvoAsmPopTertiary(a)
		renvoAsmCmpTertiaryPrimaryJump(a, setcc, label)
	}

	func renvo386CompilerJcmpStackImm(a *renvoAsm, offset int, value int, label int, setcc int) {
		if renvoFixedTarget == 0 && a.c.code16 {
			if renvoAsmImmFits8Signed(value) {
				renvoAsmStackMem(a, offset, 0x83, 0x7d, 0xbd)
				renvoAsmEmit8(a, value)
			} else {
				renvoAsmStackMem(a, offset, 0x81, 0x7d, 0xbd)
				renvoAsmEmit32(a, value)
			}
			renvo386AsmJccLabel(a, setcc-0x10, label)
			return
		}
		renvoAsmPushStack(a, offset)
		renvoAsmPrimaryImm(a, value)
		renvoAsmPopTertiary(a)
		renvoAsmCmpTertiaryPrimaryJump(a, setcc, label)
	}
}

go compiler {
	func renvo386CompilerPrimaryImm64(a *renvoAsm, imm int, high int) {
		// This operation materializes one native scalar. Paired-word lowering
		// handles the high half separately on this 32-bit backend.
		renvo386AsmMovRaxImm(a, imm)
	}
}

go compiler {
	func renvo386CompilerPatch(a *renvoAsm) {
		rtgX8632PatchRelocations(a)
		renvoAsmSetDataOffsets(a)
		if renvoFixedTarget == renvoTargetLinuxKernelAmd64 ||
			renvoFixedTarget == 0 && targetIsKernelModule(a.c) {
			return
		}
		renvoAsmPatchDataDisplacements32(a)
	}

	func renvo386CompilerMulPrimaryTertiary(a *renvoAsm) {
		renvoAsmEmit24(a, 0xc1af0f)
	}
}

go compiler {
	func renvo386FusePrimaryLoadNormalization(a *renvoAsm, kind int) bool {
		load := a.lastPrimaryLoad
		end := load >> 3
		modrm := end - (load & 7)
		if load <= 0 || end != len(a.code) || modrm < 2 || a.code[modrm-2] != 0x0f {
			return false
		}
		opcode := a.code[modrm-1]
		if kind == renvoTypeByte || kind == renvoTypeBool {
			return opcode == 0xb6
		}
		if kind == renvoTypeInt8 && opcode == 0xb6 {
			a.code[modrm-1] = 0xbe
			return true
		}
		if kind == renvoTypeInt16 {
			return opcode == 0xbf
		}
		if kind == renvoTypeUint16 && opcode == 0xbf {
			a.code[modrm-1] = 0xb7
			return true
		}
		return false
	}

	func renvo386PrimaryNormalizationRepeated(a *renvoAsm, kind int) bool {
		opcode := 0
		size := 0
		if kind == renvoTypeByte || kind == renvoTypeBool {
			opcode, size = 0xc0b60f, 3
		} else if kind == renvoTypeInt8 {
			opcode, size = 0xc0be0f, 3
		} else if kind == renvoTypeInt16 {
			opcode, size = 0x98, 1
		} else if kind == renvoTypeUint16 {
			opcode, size = 0xc0b70f, 3
		} else {
			return false
		}
		if len(a.code) < size {
			return false
		}
		for i := 0; i < len(a.labelPos); i++ {
			if int(a.labelPos[i]) == len(a.code) {
				return false
			}
		}
		start := len(a.code) - size
		for i := 0; i < size; i++ {
			if a.code[start+i] != byte(opcode>>(8*i)) {
				return false
			}
		}
		return true
	}
}

go compiler {
	func renvo386CompilerGlobalInitFrameStart(g *renvoLinearGen) int {
		a := &g.asm
		framePatch := len(a.code)
		renvoAsmEmit32(a, 0x000000c8)
		return framePatch
	}

	func renvo386CompilerGlobalInitFrameEnd(g *renvoLinearGen, framePatch int) {
		renvoAsmLeave(&g.asm)
		if framePatch < 0 {
			return
		}
		frame := renvoAlignValue(g.stackPeak, 16)
		if frame > 65520 {
			frame = 65520
		}
		g.asm.code[framePatch+1] = byte(frame & 255)
		g.asm.code[framePatch+2] = byte((frame >> 8) & 255)
	}

	func renvo386CompilerIEEEBinaryStack(g *renvoLinearGen, dest int, left int, right int, op byte, size int) bool {
		return renvo386AsmX87BinaryStack(&g.asm, dest, left, right, op, size)
	}

	func renvo386CompilerIEEEConvertFloatStack(g *renvoLinearGen, dest int, source int, sourceSize int, destSize int) {
		renvo386AsmX87ConvertFloatStack(&g.asm, dest, source, sourceSize, destSize)
	}

	func renvo386CompilerIEEEIntToFloatStack(g *renvoLinearGen, offset int, intSize int, floatSize int, signed bool) {
		renvo386AsmX87IntToFloatStack(&g.asm, offset, intSize, floatSize, signed)
	}

	func renvo386CompilerIEEEFloatToIntStack(g *renvoLinearGen, dest int, source int, floatSize int, intSize int, signed bool) {
		renvo386AsmX87FloatToIntStack(&g.asm, dest, source, floatSize, intSize, signed)
	}

	func renvo386CompilerIEEENegateStack(g *renvoLinearGen, offset int, size int) {
		renvo386AsmX87NegateStack(&g.asm, offset, size)
		return
	}
}

go compiler {
	func renvo386CompilerIEEECompareStack(g *renvoLinearGen, left int, right int, kind int, c0 byte, c1 byte) bool {
		size := 8
		if kind == renvoTypeFloat32 {
			size = 4
		}
		renvoAsmEmitText(&g.asm, "\x31\xc0\x31\xd2")
		renvo386AsmX87CompareStack(&g.asm, left, right, size)
		renvo386IEEECompareFlagsResult(&g.asm, c0, c1)
		return true
	}

	func renvo386CompilerIEEENegatePrimary(g *renvoLinearGen, kind int) bool {
		if kind == renvoTypeFloat32 {
			return renvoEmit32BitIEEEFloatNegatePrimary(g)
		}
		return false
	}
}

go compiler {
	func renvo386CompilerIEEEConversionPrimary(g *renvoLinearGen, sourceKind int, destKind int) bool {
		a := &g.asm
		temp := renvoAddUnnamedLocal(g, renvoTypeInt64)
		renvoAsmStorePrimaryStack(a, temp)
		if !renvoTypeKindIsFloat(sourceKind) && destKind == renvoTypeFloat32 {
			renvo32IEEEIntToFloatStack(g, temp, 4, 4, !renvoTypeKindIsUnsignedInteger(sourceKind))
		} else if sourceKind == renvoTypeFloat32 && !renvoTypeKindIsFloat(destKind) {
			renvo32IEEEFloatToIntStack(g, temp, temp, 4, 4, !renvoTypeKindIsUnsignedInteger(destKind))
		} else {
			return false
		}
		renvoAsmLoadPrimaryStack(a, temp)
		return true
	}

	func renvo386CompilerIEEEArithmeticPrimaryTertiary(g *renvoLinearGen, opChar byte, kind int) bool {
		a := &g.asm
		if kind != renvoTypeFloat32 {
			return false
		}
		left := renvoAddUnnamedLocal(g, renvoBuiltinTypeFloat32)
		right := renvoAddUnnamedLocal(g, renvoBuiltinTypeFloat32)
		result := renvoAddUnnamedLocal(g, renvoBuiltinTypeFloat32)
		renvoAsmStorePrimaryStack(a, right)
		renvoAsmCopyTertiaryToPrimary(a)
		renvoAsmStorePrimaryStack(a, left)
		if !renvo32IEEEBinaryStack(g, result, left, right, opChar, 4) {
			return false
		}
		renvoAsmLoadPrimaryStack(a, result)
		return true
	}

	func renvo386CompilerIEEEComparePrimaryTertiary(g *renvoLinearGen, c0 byte, c1 byte, kind int) bool {
		return false
	}
}

go compiler {
	func renvo386IEEECompareFlagsResult(a *renvoAsm, c0 byte, c1 byte) {
		first := 0x97 // seta: greater-than, unordered is false
		second := 0
		combine := byte(0)
		if c0 == '=' {
			first, second, combine = 0x94, 0x9b, 0x20 // equal and ordered
		} else if c0 == '!' {
			first, second, combine = 0x95, 0x9a, 0x08 // unequal or unordered
		} else if c0 == '<' {
			first, second, combine = 0x92, 0x9b, 0x20 // below and ordered
			if c1 == '=' {
				first = 0x96 // below-or-equal and ordered
			}
		} else if c0 == '>' && c1 == '=' {
			first = 0x93 // above-or-equal; unordered is below
		}
		renvoAsmEmit3(a, 0x0f, first, 0xc0)
		if second != 0 {
			renvoAsmEmit3(a, 0x0f, second, 0xc2)
			renvoAsmEmit2(a, int(combine), 0xd0)
		}
	}
}

go compiler {
	func renvo386CompilerUnsignedDividePrimaryTertiary(g *renvoLinearGen, mod bool) bool {
		renvoAsmEmitText(&g.asm, "\x53\x89\xc3\x89\xc8\x31\xd2\xf7\xf3")
		if mod {
			renvoAsmEmit16(&g.asm, 0xd089)
		}
		renvoAsmEmit8(&g.asm, 0x5b)
		return true
	}
}

go compiler {
	func renvo386CompilerStoreIncomingCallWord(g *renvoLinearGen, word int, offset int) {
		renvo386StoreParamWord(g, word, offset)
	}

	func renvo386CompilerCallWithWordCount(g *renvoLinearGen, fnIndex int, wordCount int) {
		if !(renvoFixedTarget == 0 && g.c.code16 && renvo386EmitDirectCallWithWordCount(g, fnIndex, wordCount)) {
			renvo386EmitCallWithWordCount(g, fnIndex, wordCount)
		}
	}
}

