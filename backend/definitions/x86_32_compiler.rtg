go compiler {
	func renvo386CompilerFoldedIndexedScalarLoad(a *renvoAsm, elementSize int, size int, signed bool) {
		scale := 0
		if elementSize == 2 {
			scale = 1
		} else if elementSize == 4 {
			scale = 2
		} else if elementSize == 8 {
			scale = 3
		}
		sib := scale<<6 | 0x02
		if size == 1 {
			opcode := 0xb6
			if signed {
				opcode = 0xbe
			}
			renvoAsmEmit3(a, 0x0f, opcode, 0x04)
			renvoAsmEmit8(a, sib)
		} else if size == 2 {
			opcode := 0xb7
			if signed {
				opcode = 0xbf
			}
			renvoAsmEmit3(a, 0x0f, opcode, 0x04)
			renvoAsmEmit8(a, sib)
		} else {
			renvoAsmEmit3(a, 0x8b, 0x04, sib)
		}
	}
}

