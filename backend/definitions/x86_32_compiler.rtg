	func renvo386CompilerIncrementGlobalWord(g *renvoLinearGen, globalOffset int, inc bool) bool {
		a := &g.asm
		renvoAsmPrimaryBssAddr(a, globalOffset)
		opcode := 0x08ff
		if inc {
			opcode = 0x00ff
		}
		renvoAsmEmit16(a, opcode)
		return true
	}
}

