			call x86_32Jump(out,done)
			call out.Mark(forward)
			call out.Bytes3(0xfc,0xf3,0xa4)
			call out.Mark(done)
		}
		x86_32ELF32Image(a:emitter) -> bytes {
			let codeOffset = 116
			let dataOffset = codeOffset+len(a.Code())
			let fileSize = dataOffset+len(a.Data())
			let bssOffset = RTGAlignValue(fileSize,4096)
			call x86_32ELFPatchAbsoluteRelocations(a,codeOffset,dataOffset,bssOffset)
			return nativeELFExecutable32(a,3,0,codeOffset)
		}
		x86_32FrameStart(out:emitter) -> int {
			let at = out.Len()
			call out.Bytes4(0xc8,0,0,0)
			return at
		}
		x86_32Group(out:emitter, opcode:byte, selector:byte, operand:register) {
			call out.AppendByte(int(opcode))
			call x86_32ModRM(out,3,selector,x86_32Low3(operand))
		}
		x86_32JumpCondition(out:emitter, condition:condition, label:label) {
			call out.Byte(0x0f)
			call out.AppendByte(int(condition.JumpOpcode))
			call out.Rel32(label)
		}
		x86_32Multiply(out:emitter, destination:register, source:register) {
			call out.Bytes2(0x0f,0xaf)
			call x86_32ModRM(out,3,x86_32Low3(destination),x86_32Low3(source))
		}
		x86_32Relative(out:emitter, opcode:byte, label:label) {
			call out.AppendByte(int(opcode))
			call out.Rel32(label)
		}
		x86_32SetCondition(out:emitter, condition:condition, destination:register) {
			call out.Byte(0x0f)
			call out.AppendByte(int(condition.SetOpcode))
			call x86_32ModRM(out,3,0,0)
			call out.Bytes2(0x0f,0xb6)
			call x86_32ModRM(out,3,x86_32Low3(destination),0)
		}
		x86_32ShiftImmediate(out:emitter, operand:register, value:byte, selector:byte) {
			call x86_32Group(out,0xc1,selector,operand)
			call out.AppendByte(int(value))
		}
		x86_32WindowsExit(out:emitter, status:register) {
			call out.AppendByte(0x50+status.Code)
			call out.Bytes2(0xff,0x15)
			let at = out.Len()
			call out.Int32(0)
			call out.AbsoluteReloc(at,8,RTGRelocationImport)
		}
		x86_32WindowsStaticCall(out:emitter, importID:int, wordCount:int) {
			call out.Bytes2(0xff,0x15)
			let at = out.Len()
			call out.Int32(0)
			call out.AbsoluteReloc(at,importID,RTGRelocationImport)
		}

		x86_32Low3(reg:register) -> byte {
			return byte(reg.Code&7)
		}
		x86_32ModRM(out:emitter, mode:byte, reg:byte, rm:byte) {
			call out.AppendByte(int(mode<<6|(reg&7)<<3|rm&7))
		}
		x86_32WindowsCallImport(out:emitter, importID:int) {
			call out.Bytes2(0xff,0x15)
			let at = out.Len()
			call out.Int32(0)
			call out.AbsoluteReloc(at,importID,RTGRelocationImport)
		}
		x86_32WindowsRuntimeChmod(out:emitter) {
			let eax = record_register(Code:0,Valid:true)
			let ecx = record_register(Code:1,Valid:true)
			let failed = out.NewLabel()
			let done = out.NewLabel()
			call out.Bytes2(0x6a,1)
			call out.Bytes2(0x6a,0)
			call out.Bytes2(0x6a,0)
			call out.AppendByte(0x53)
			call x86_32WindowsCallImport(out,5)
			call x86_32MoveImmediate(out,ecx,-1)
			call x86_32Binary(out,0x39,eax,ecx)
			call x86_32JumpCondition(out,record_condition(JumpOpcode:0x84),failed)
			call x86_32MoveImmediate(out,eax,0)
			call x86_32Relative(out,0xe9,done)
			call out.Mark(failed)
			call x86_32MoveImmediate(out,eax,-1)
			call out.Mark(done)
		}
		x86_32WindowsRuntimeClose(out:emitter) {
			let eax = record_register(Code:0,Valid:true)
			let failed = out.NewLabel()
			let done = out.NewLabel()
			call out.AppendByte(0x53)
			call x86_32WindowsCallImport(out,2)
			call x86_32Test(out,eax,eax)
			call x86_32JumpCondition(out,record_condition(JumpOpcode:0x84),failed)
			call x86_32MoveImmediate(out,eax,0)
			call x86_32Relative(out,0xe9,done)
			call out.Mark(failed)
			call x86_32MoveImmediate(out,eax,-1)
			call out.Mark(done)
		}
		x86_32WindowsRuntimeOpen(out:emitter) {
			let eax = record_register(Code:0,Valid:true)
			let esi = record_register(Code:6,Valid:true)
			call x86_32Move(out,eax,esi)
			call x86_32WindowsTranslateCreateFileFlags(out)
			call out.Bytes2(0x6a,0)
			call out.AppendByte(0x68)
			call out.Int32(0x80)
			call out.AppendByte(0x51)
			call out.Bytes2(0x6a,0)
			call out.Bytes2(0x6a,3)
			call out.AppendByte(0x52)
			call out.AppendByte(0x53)
			call x86_32WindowsCallImport(out,1)
		}
		x86_32WindowsTranslateCreateFileFlags(out:emitter) {
			let edx = record_register(Code:2,Valid:true)
			let ecx = record_register(Code:1,Valid:true)
			let notReadWrite = out.NewLabel()
			let accessDone = out.NewLabel()
			let noCreate = out.NewLabel()
			let createDone = out.NewLabel()
			call x86_32MoveImmediate(out,edx,-2147483648)
			call out.Bytes2(0xa8,2)
			call x86_32JumpCondition(out,record_condition(JumpOpcode:0x84),notReadWrite)
			call x86_32MoveImmediate(out,edx,-1073741824)
			call x86_32Relative(out,0xe9,accessDone)
			call out.Mark(notReadWrite)
			call out.Bytes2(0xa8,1)
			call x86_32JumpCondition(out,record_condition(JumpOpcode:0x84),accessDone)
			call x86_32MoveImmediate(out,edx,0x40000000)
			call out.Mark(accessDone)
			call x86_32MoveImmediate(out,ecx,3)
			call out.Bytes2(0xa8,64)
			call x86_32JumpCondition(out,record_condition(JumpOpcode:0x84),noCreate)
			call x86_32MoveImmediate(out,ecx,4)
			call out.AppendByte(0xa9)
			call out.Int32(512)
			call x86_32JumpCondition(out,record_condition(JumpOpcode:0x84),createDone)
			call x86_32MoveImmediate(out,ecx,2)
			call x86_32Relative(out,0xe9,createDone)
			call out.Mark(noCreate)
			call out.AppendByte(0xa9)
			call out.Int32(512)
			call x86_32JumpCondition(out,record_condition(JumpOpcode:0x84),createDone)
			call x86_32MoveImmediate(out,ecx,5)
			call out.Mark(createDone)
		}
}
}

abi renvo_x86_32 {
	arch = x86_32
	frame_start = sequence x86_32FrameStart
	frame_finish = go x86_32FrameFinish
	call_words = [ebx, esi, edx, ecx, eax, edi]
	overflow_stride = 4
	scalar_result = eax
}

abi cdecl32 {
	internal = renvo_x86_32
	arguments = [stack]
	result = [eax, edx]
	stack_alignment = 4
}

abi win32 {
	internal = renvo_x86_32
	arguments = [stack]
	result = [eax, edx]
	stack_alignment = 4
}

runtime linux_386 {
	emit_entry = go x86_32LinuxEntry

	syscall {
		number = eax
		arguments = [ebx, ecx, edx, esi, edi, ebp]
		result = eax
		instruction = int80
	}
	operation read { number = 3 args = [fd, buffer, count] }
	operation write { number = 4 args = [fd, buffer, count] }
	operation read_at { number = 180 args = [fd, buffer, count, offset] }
	operation write_at { number = 181 args = [fd, buffer, count, offset] }
	operation open { number = 5 args = [path, flags, mode] }
	operation close { number = 6 args = [fd] }
	operation chmod { number = 94 args = [fd, mode] }
	operation print { use = write args = [stderr, buffer, count] }
	operation exit { number = 1 args = [status] noreturn = true }
}

runtime windows_386 {
	emit_entry = go x86_32WindowsEntry
	emit_exit = sequence x86_32WindowsExit
	emit_static_call = sequence x86_32WindowsStaticCall
	emit_operation = go x86_32WindowsRuntimeOperation
	operations = [print, open, close, read, write, read_at, write_at, chmod]
}

format elf32_386 {
	byte_order = little
	address_bits = 32
	kind = elf
	machine = 3
	code_offset = 116
	image = sequence x86_32ELF32Image
}

format pe32_386 {
	byte_order = little
	address_bits = 32
	kind = pe
	machine = 0x014c
	code_offset = 0x1000
	image = go x86_32PE32Image
}

target linux/386 {
	family = native_v1
	os = linux
	arch = x86_32
	abi = cdecl32
	runtime = linux_386
	executable = elf32_386
	build_tags = [linux, unix, 386]
	capabilities = [hosted, executable, filesystem, heap, argv, environment]
}

target windows/386 {
	family = native_v1
	os = windows
	arch = x86_32
	abi = win32
	runtime = windows_386
	executable = pe32_386
	build_tags = [windows, 386]
	capabilities = [hosted, executable, filesystem, heap, argv, environment]
}

# This closed definition owns the complete AArch64 direct-emitter encoder and
# every advertised AArch64 target composition. The explicit exports are the
# stable production contract used by target-neutral lowering.
go backend {
	func aarch64LinuxEntry(out *RTGEmitter, parameterCount int, stateOffset int) bool {
		_ = stateOffset
		if parameterCount == 0 {
			return true
		}
		if parameterCount < 0 || parameterCount > 2 {
			return false
		}
		argsOffset := out.ReserveBSS(32768, 16)
		environmentOffset := out.ReserveBSS(32768, 16)
		environmentLengthOffset := out.ReserveBSS(8, 8)
		argumentLoop := out.NewLabel()
		argumentLength := out.NewLabel()
		argumentLengthDone := out.NewLabel()
		argumentsDone := out.NewLabel()
		environmentLoop := out.NewLabel()
		environmentLength := out.NewLabel()
		environmentLengthDone := out.NewLabel()
		environmentDone := out.NewLabel()

		renvoAarch64AsmLoadRegMem(out, 13, 31, 0, 8)
		renvoAarch64AsmAddRegImm(out, 10, 31, 8)
		renvoAarch64AsmMovRegAbs(out, 7, argsOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmMovRegImm(out, 11, 0)
		out.Mark(argumentLoop)
		renvoAarch64AsmCmpRegReg(out, 11, 13)
		aarch64JumpCondition(out, RTGCondition{Code: 0}, argumentsDone)
		renvoAarch64AsmAddRegRegShift(out, 12, 10, 11, 3)
		renvoAarch64AsmLoadRegMem(out, 12, 12, 0, 8)
		renvoAarch64AsmStoreRegMem(out, 12, 7, 0, 8)
		renvoAarch64AsmMovRegImm(out, 0, 0)
		out.Mark(argumentLength)
		renvoAarch64AsmAddRegReg(out, 9, 12, 0)
		renvoAarch64AsmLoadRegMem(out, 9, 9, 0, 1)
		renvoAarch64AsmCmpRegImm(out, 9, 0)
		aarch64JumpCondition(out, RTGCondition{Code: 0}, argumentLengthDone)
		renvoAarch64AsmAddRegImm(out, 0, 0, 1)
		aarch64Jump(out, argumentLength)
		out.Mark(argumentLengthDone)
		renvoAarch64AsmStoreRegMem(out, 0, 7, 8, 8)
		renvoAarch64AsmAddRegImm(out, 7, 7, 16)
		renvoAarch64AsmAddRegImm(out, 11, 11, 1)
		aarch64Jump(out, argumentLoop)
		out.Mark(argumentsDone)

		renvoAarch64AsmAddRegRegShift(out, 10, 10, 13, 3)
		renvoAarch64AsmAddRegImm(out, 10, 10, 8)
		renvoAarch64AsmMovRegAbs(out, 7, environmentOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmMovRegImm(out, 11, 0)
		out.Mark(environmentLoop)
		renvoAarch64AsmLoadRegMem(out, 12, 10, 0, 8)
		renvoAarch64AsmCmpRegImm(out, 12, 0)
		aarch64JumpCondition(out, RTGCondition{Code: 0}, environmentDone)
		renvoAarch64AsmStoreRegMem(out, 12, 7, 0, 8)
		renvoAarch64AsmMovRegImm(out, 0, 0)
		out.Mark(environmentLength)
		renvoAarch64AsmAddRegReg(out, 9, 12, 0)
		renvoAarch64AsmLoadRegMem(out, 9, 9, 0, 1)
		renvoAarch64AsmCmpRegImm(out, 9, 0)
		aarch64JumpCondition(out, RTGCondition{Code: 0}, environmentLengthDone)
		renvoAarch64AsmAddRegImm(out, 0, 0, 1)
		aarch64Jump(out, environmentLength)
		out.Mark(environmentLengthDone)
		renvoAarch64AsmStoreRegMem(out, 0, 7, 8, 8)
		renvoAarch64AsmAddRegImm(out, 7, 7, 16)
		renvoAarch64AsmAddRegImm(out, 10, 10, 8)
		renvoAarch64AsmAddRegImm(out, 11, 11, 1)
		aarch64Jump(out, environmentLoop)
		out.Mark(environmentDone)
		renvoAarch64AsmMovRegAbs(out, 12, environmentLengthOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmStoreRegMem(out, 11, 12, 0, 8)

		renvoAarch64AsmMovRegAbs(out, 3, argsOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmMovRegReg(out, 4, 13)
		renvoAarch64AsmMovRegReg(out, 1, 13)
		renvoAarch64AsmMovRegAbs(out, 2, environmentOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmMovRegReg(out, 5, 11)
		renvoAarch64AsmMovRegReg(out, 6, 11)
		return true
	}

	func aarch64ELFPatchAbsoluteRelocations(a *RTGEmitter, codeOffset int, dataOffset int, bssOffset int) {
		code := a.Code()
		for i := 0; i < a.AbsoluteRelocationCount(); i++ {
			at := a.AbsoluteRelocationOffset(i)
			addend := a.AbsoluteRelocationAddend(i)
			kind := a.AbsoluteRelocationKind(i)
			target := dataOffset + addend
			if kind == RTGRelocationAbsoluteBSS {
				target = bssOffset + addend
			}
			insn := int(code[at]) | int(code[at+1])<<8 | int(code[at+2])<<16 | int(code[at+3])<<24
			reg := insn & 31
			pcPage := (codeOffset + at) & -4096
			targetPage := target & -4096
			pageDelta := (targetPage - pcPage) >> 12
			immlo := pageDelta & 3
			immhi := pageDelta >> 2 & 524287
			a.PatchUint32(at, 0x90000000|(immlo<<29)|(immhi<<5)|reg)
			a.PatchUint32(at+4, 0x91000000|((target&4095)<<10)|(reg<<5)|reg)
			a.PatchUint32(at+8, 0xd503201f)
			a.PatchUint32(at+12, 0xd503201f)
		}
	}



	const aarch64MachCodeOffset = 0x1000
	const aarch64MachImageBase = 0x100000000
	const aarch64MachPageSize = 0x4000
	const aarch64MachLibSystem = "/usr/lib/libSystem.B.dylib"

	func aarch64DarwinEntryStart(out *RTGEmitter, stateOffset int) bool {
		if stateOffset < 0 {
			return false
		}
		renvoAarch64AsmMovRegAbs(out, 9, stateOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmStoreRegMem(out, 0, 9, 0, 8)
		renvoAarch64AsmStoreRegMem(out, 1, 9, 8, 8)
		renvoAarch64AsmStoreRegMem(out, 2, 9, 16, 8)
		return true
	}

	func aarch64DarwinEntry(out *RTGEmitter, parameterCount int, stateOffset int) bool {
		if parameterCount == 0 {
			return true
		}
		if parameterCount < 0 || parameterCount > 2 || stateOffset < 0 {
			return false
		}
		argsOffset := out.ReserveBSS(32768, 16)
		environmentOffset := out.ReserveBSS(32768, 16)
		argumentLoop := out.NewLabel()
		argumentLength := out.NewLabel()
		argumentLengthDone := out.NewLabel()
		argumentsDone := out.NewLabel()
		environmentLoop := out.NewLabel()
		environmentLength := out.NewLabel()
		environmentLengthDone := out.NewLabel()
		environmentDone := out.NewLabel()

		renvoAarch64AsmMovRegAbs(out, 9, stateOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmLoadRegMem(out, 13, 9, 0, 8)
		renvoAarch64AsmLoadRegMem(out, 14, 9, 8, 8)
		renvoAarch64AsmLoadRegMem(out, 15, 9, 16, 8)
		renvoAarch64AsmMovRegAbs(out, 10, argsOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmMovRegImm(out, 11, 0)
		out.Mark(argumentLoop)
		renvoAarch64AsmCmpRegImm(out, 11, 2048)
		aarch64JumpCondition(out, RTGCondition{Code: 10}, argumentsDone)
		renvoAarch64AsmCmpRegReg(out, 11, 13)
		aarch64JumpCondition(out, RTGCondition{Code: 0}, argumentsDone)
		renvoAarch64AsmAddRegRegShift(out, 12, 14, 11, 3)
		renvoAarch64AsmLoadRegMem(out, 12, 12, 0, 8)
		renvoAarch64AsmStoreRegMem(out, 12, 10, 0, 8)
		renvoAarch64AsmMovRegImm(out, 0, 0)
		out.Mark(argumentLength)
		renvoAarch64AsmAddRegReg(out, 9, 12, 0)
		renvoAarch64AsmLoadRegMem(out, 9, 9, 0, 1)
		renvoAarch64AsmCmpRegImm(out, 9, 0)
		aarch64JumpCondition(out, RTGCondition{Code: 0}, argumentLengthDone)
		renvoAarch64AsmAddRegImm(out, 0, 0, 1)
		aarch64Jump(out, argumentLength)
		out.Mark(argumentLengthDone)
		renvoAarch64AsmStoreRegMem(out, 0, 10, 8, 8)
		renvoAarch64AsmAddRegImm(out, 10, 10, 16)
		renvoAarch64AsmAddRegImm(out, 11, 11, 1)
		aarch64Jump(out, argumentLoop)
		out.Mark(argumentsDone)
		renvoAarch64AsmMovRegReg(out, 13, 11)

		renvoAarch64AsmMovRegAbs(out, 10, environmentOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmMovRegImm(out, 11, 0)
		out.Mark(environmentLoop)
		renvoAarch64AsmCmpRegImm(out, 11, 2048)
		aarch64JumpCondition(out, RTGCondition{Code: 10}, environmentDone)
		renvoAarch64AsmLoadRegMem(out, 12, 15, 0, 8)
		renvoAarch64AsmCmpRegImm(out, 12, 0)
		aarch64JumpCondition(out, RTGCondition{Code: 0}, environmentDone)
		renvoAarch64AsmStoreRegMem(out, 12, 10, 0, 8)
		renvoAarch64AsmMovRegImm(out, 0, 0)
		out.Mark(environmentLength)
		renvoAarch64AsmAddRegReg(out, 9, 12, 0)
		renvoAarch64AsmLoadRegMem(out, 9, 9, 0, 1)
		renvoAarch64AsmCmpRegImm(out, 9, 0)
		aarch64JumpCondition(out, RTGCondition{Code: 0}, environmentLengthDone)
		renvoAarch64AsmAddRegImm(out, 0, 0, 1)
		aarch64Jump(out, environmentLength)
		out.Mark(environmentLengthDone)
		renvoAarch64AsmStoreRegMem(out, 0, 10, 8, 8)
		renvoAarch64AsmAddRegImm(out, 10, 10, 16)
		renvoAarch64AsmAddRegImm(out, 15, 15, 8)
		renvoAarch64AsmAddRegImm(out, 11, 11, 1)
		aarch64Jump(out, environmentLoop)
		out.Mark(environmentDone)

		renvoAarch64AsmMovRegAbs(out, 3, argsOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmMovRegReg(out, 4, 13)
		renvoAarch64AsmMovRegReg(out, 1, 13)
		renvoAarch64AsmMovRegAbs(out, 2, environmentOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmMovRegReg(out, 5, 11)
		renvoAarch64AsmMovRegReg(out, 6, 11)
		return true
	}







	func aarch64MachAppendStringZ(out []byte, value string) []byte {
		for i := 0; i < len(value); i++ {
			out = append(out, value[i])
		}
		return append(out, 0)
	}

	func aarch64MachAppendUntil(out []byte, size int) []byte {
		for len(out) < size {
			out = append(out, 0)
		}
		return out
	}

	func aarch64MachAppendULEB(out []byte, value int) []byte {
		for {
			b := byte(value & 127)
			value = value >> 7
			if value != 0 {
				b = b | 128
			}
			out = append(out, b)
			if value == 0 {
				return out
			}
		}
	}

	func aarch64MachAppendName16(out []byte, name string) []byte {
		for i := 0; i < 16; i++ {
			if i < len(name) {
				out = append(out, name[i])
			} else {
				out = append(out, 0)
			}
		}
		return out
	}









	func aarch64MachExtraDylibs(out *RTGEmitter) []string {
		var dylibs []string
		for i := 0; i < out.DynamicImportCount(); i++ {
			dylib := out.DynamicImportLibrary(i)
			if dylib == aarch64MachLibSystem {
				continue
			}
			found := false
			for j := 0; j < len(dylibs); j++ {
				if dylibs[j] == dylib {
					found = true
				}
			}
			if !found {
				dylibs = append(dylibs, dylib)
			}
		}
		return dylibs
	}

	func aarch64MachDylibOrdinal(out *RTGEmitter, dylib string) int {
		if dylib == aarch64MachLibSystem {
			return 1
		}
		dylibs := aarch64MachExtraDylibs(out)
		for i := 0; i < len(dylibs); i++ {
			if dylibs[i] == dylib {
				return i + 2
			}
		}
		return 0
	}







	type aarch64MachImportLayout struct {
		got []int
	}

	func aarch64MachPatchAbsoluteRelocations(
		out *RTGEmitter, dataFileOff int, dataSize int,
	) {
		for i := 0; i < out.AbsoluteRelocationCount(); i++ {
			at := out.AbsoluteRelocationOffset(i)
			addend := out.AbsoluteRelocationAddend(i)
			kind := out.AbsoluteRelocationKind(i)
			target := dataFileOff + addend
			if kind == RTGRelocationAbsoluteBSS {
				target = dataFileOff + dataSize + addend
			}
			insn := RTGGet32At(out.Code(), at)
			reg := insn & 31
			address := aarch64MachImageBase + target
			pc := aarch64MachImageBase + aarch64MachCodeOffset + at
			delta := (address >> 12) - (pc >> 12)
			imm := delta & 0x1fffff
			out.PatchUint32(at,
				0x90000000|((imm&3)<<29)|
					(((imm>>2)&0x7ffff)<<5)|reg)
			out.PatchUint32(at+4,
				0x91000000|((address&0xfff)<<10)|(reg<<5)|reg)
			out.PatchUint32(at+8, 0xd503201f)
			out.PatchUint32(at+12, 0xd503201f)
		}
	}

	func aarch64MachPrepareImports(
		out *RTGEmitter,
	) aarch64MachImportLayout {
		var layout aarch64MachImportLayout
		count := out.DynamicImportCount()
		layout.got = make([]int, count)
		stubs := make([]int, count)
		for i := 0; i < count; i++ {
			renvoAarch64AsmAlign(out)
			out.Mark(out.DynamicImportLabel(i))
			stubs[i] = out.Len()
			renvoAarch64AsmEmit(out, 0x90000010)
			renvoAarch64AsmEmit(out, 0xf9400210)
			renvoAarch64AsmEmit(out, 0xd61f0200)
		}
		out.Patch()
		dataFileOff := RTGAlignValue(
			aarch64MachCodeOffset+out.Len(), aarch64MachPageSize)
		data := out.Data()
		data = aarch64MachAppendUntil(data, RTGAlignValue(len(data), 8))
		for i := 0; i < count; i++ {
			layout.got[i] = len(data)
			data = aarch64MachAppend64(data, 0)
		}
		data = aarch64MachAppendUntil(
			data, RTGAlignValue(len(data), aarch64MachPageSize))
		out.SetData(data)
		aarch64MachPatchAbsoluteRelocations(
			out, dataFileOff, len(data))
		for i := 0; i < count; i++ {
			stubAt := stubs[i]
			target := aarch64MachImageBase +
				dataFileOff + layout.got[i]
			pc := aarch64MachImageBase +
				aarch64MachCodeOffset + stubAt
			aarch64MachPatchADRP(out, stubAt, pc, target)
			pageOff := target & 0xfff
			out.PatchUint32(
				stubAt+4, 0xf9400210|((pageOff/8)<<10))
		}
		return layout
	}

	func aarch64MachBuildBindData(
		out *RTGEmitter, got []int,
	) []byte {
		bind := make([]byte, 0, 256)
		bind = append(bind, 0x51)
		for i := 0; i < out.DynamicImportCount(); i++ {
			ordinal := aarch64MachDylibOrdinal(
				out, out.DynamicImportLibrary(i))
			if ordinal < 16 {
				bind = append(bind, byte(0x10|ordinal))
			} else {
				bind = append(bind, 0x20)
				bind = aarch64MachAppendULEB(bind, ordinal)
			}
			bind = append(bind, 0x40)
			bind = aarch64MachAppendStringZ(
				bind, out.DynamicImportName(i))
			bind = append(bind, 0x72)
			bind = aarch64MachAppendULEB(bind, got[i])
			bind = append(bind, 0x90)
		}
		return append(bind, 0)
	}

	func aarch64MachBuildStringTable(out *RTGEmitter) []byte {
		strtab := make([]byte, 0, 128)
		strtab = append(strtab, 0)
		strtab = aarch64MachAppendStringZ(strtab, "_main")
		for i := 0; i < out.DynamicImportCount(); i++ {
			strtab = aarch64MachAppendStringZ(
				strtab, out.DynamicImportName(i))
		}
		return strtab
	}

	func aarch64MachBuildSymbolTable(out *RTGEmitter) []byte {
		count := out.DynamicImportCount()
		symtab := make([]byte, 0, 16*(count+1))
		symtab = aarch64MachAppend32(symtab, 1)
		symtab = append(symtab, 0x0f, 1)
		symtab = aarch64MachAppend16(symtab, 0)
		symtab = aarch64MachAppend64(
			symtab, aarch64MachImageBase+aarch64MachCodeOffset)
		nameOff := 7
		for i := 0; i < count; i++ {
			symtab = aarch64MachAppend32(symtab, nameOff)
			symtab = append(symtab, 1, 0)
			symtab = aarch64MachAppend16(symtab, 0x100)
			symtab = aarch64MachAppend64(symtab, 0)
			nameOff += len(out.DynamicImportName(i)) + 1
		}
		return symtab
	}

	func aarch64MachHeader(
		out *RTGEmitter,
		textFileSize int,
		dataFileOff int,
		dataFileSize int,
		dataVMSize int,
		linkeditOff int,
		linkeditSize int,
		bindOff int,
		bindSize int,
		symOff int,
		symbolCount int,
		strOff int,
		strSize int,
		undefinedCount int,
		sigOff int,
		sigSize int,
	) []byte {
		dylibs := aarch64MachExtraDylibs(out)
		commandSize := 856
		for i := 0; i < len(dylibs); i++ {
			commandSize += aarch64MachDylibCommandSize(dylibs[i])
		}
		header := make([]byte, 0, aarch64MachCodeOffset)
		header = aarch64MachAppend32(header, 0xfeedfacf)
		header = aarch64MachAppend32(header, 0x0100000c)
		header = aarch64MachAppend32(header, 0)
		header = aarch64MachAppend32(header, 2)
		header = aarch64MachAppend32(header, 13+len(dylibs))
		header = aarch64MachAppend32(header, commandSize)
		header = aarch64MachAppend32(header, 0x200085)
		header = aarch64MachAppend32(header, 0)
		header = aarch64MachAppendSegment64(
			header, "__PAGEZERO", 0, aarch64MachImageBase,
			0, 0, 0, 0)
		header = aarch64MachAppendTextSegment(
			header, len(out.Code()), textFileSize)
		header = aarch64MachAppendDataSegment(
			header, dataFileOff, dataFileSize, out.BSSSize())
		header = aarch64MachAppendSegment64(
			header,
			"__LINKEDIT",
			aarch64MachImageBase+dataFileOff+dataVMSize,
			RTGAlignValue(linkeditSize, aarch64MachPageSize),
			linkeditOff,
			linkeditSize,
			1,
			1,
		)
		header = aarch64MachAppend32(header, 0x80000022)
		header = aarch64MachAppend32(header, 48)
		header = aarch64MachAppend32(header, 0)
		header = aarch64MachAppend32(header, 0)
		header = aarch64MachAppend32(header, bindOff)
		header = aarch64MachAppend32(header, bindSize)
		for i := 0; i < 6; i++ {
			header = aarch64MachAppend32(header, 0)
		}
		header = aarch64MachAppend32(header, 0x02)
		header = aarch64MachAppend32(header, 24)
		header = aarch64MachAppend32(header, symOff)
		header = aarch64MachAppend32(header, symbolCount)
		header = aarch64MachAppend32(header, strOff)
		header = aarch64MachAppend32(header, strSize)
		header = aarch64MachAppend32(header, 0x0b)
		header = aarch64MachAppend32(header, 80)
		header = aarch64MachAppend32(header, 0)
		header = aarch64MachAppend32(header, 0)
		header = aarch64MachAppend32(header, 0)
		header = aarch64MachAppend32(header, 1)
		header = aarch64MachAppend32(header, 1)
		header = aarch64MachAppend32(header, undefinedCount)
		for i := 0; i < 12; i++ {
			header = aarch64MachAppend32(header, 0)
		}
		cmdStart := len(header)
		header = aarch64MachAppend32(header, 0x0e)
		header = aarch64MachAppend32(header, 32)
		header = aarch64MachAppend32(header, 12)
		header = aarch64MachAppendStringZ(header, "/usr/lib/dyld")
		header = aarch64MachAppendUntil(header, cmdStart+32)
		header = aarch64MachAppendDylibCommand(
			header, aarch64MachLibSystem)
		for i := 0; i < len(dylibs); i++ {
			header = aarch64MachAppendDylibCommand(
				header, dylibs[i])
		}
		header = aarch64MachAppend32(header, 0x1b)
		header = aarch64MachAppend32(header, 24)
		header = aarch64MachAppend32(header, 0x52544758)
		header = aarch64MachAppend32(header, 0x44415257)
		header = aarch64MachAppend32(header, 0x494e4152)
		header = aarch64MachAppend32(header, 0x4d363400)
		header = aarch64MachAppend32(header, 0x32)
		header = aarch64MachAppend32(header, 24)
		header = aarch64MachAppend32(header, 1)
		header = aarch64MachAppend32(header, 0x000b0000)
		header = aarch64MachAppend32(header, 0x000b0000)
		header = aarch64MachAppend32(header, 0)
		header = aarch64MachAppend32(header, 0x80000028)
		header = aarch64MachAppend32(header, 24)
		header = aarch64MachAppend64(header, aarch64MachCodeOffset)
		header = aarch64MachAppend64(header, 0)
		header = aarch64MachAppend32(header, 0x1d)
		header = aarch64MachAppend32(header, 16)
		header = aarch64MachAppend32(header, sigOff)
		header = aarch64MachAppend32(header, sigSize)
		return aarch64MachAppendUntil(header, aarch64MachCodeOffset)
	}







	func aarch64MachSHA256Schedule(
		message []byte, chunk int, words []int,
	) {
		for i := 0; i < 16; i++ {
			at := chunk + i*4
			word := int(message[at]) << 24
			word = word | (int(message[at+1]) << 16)
			word = word | (int(message[at+2]) << 8)
			word = word | int(message[at+3])
			words[i] = word & 0xffffffff
		}
		for i := 16; i < 64; i++ {
			x := words[i-15] & 0xffffffff
			y := words[i-2] & 0xffffffff
			s0 := ((x >> 7) | ((x << 25) & 0xffffffff))
			s0 = s0 ^ ((x >> 18) | ((x << 14) & 0xffffffff))
			s0 = s0 ^ (x >> 3)
			s1 := ((y >> 17) | ((y << 15) & 0xffffffff))
			s1 = s1 ^ ((y >> 19) | ((y << 13) & 0xffffffff))
			s1 = s1 ^ (y >> 10)
			word := words[i-16] + s0
			word = word + words[i-7] + s1
			words[i] = word & 0xffffffff
		}
	}

	func aarch64MachSHA256Rounds(
		words []int, constants []int, values []int,
	) {
		a := values[0]
		b := values[1]
		c := values[2]
		d := values[3]
		e := values[4]
		f := values[5]
		g := values[6]
		h := values[7]
		for i := 0; i < 64; i++ {
			e32 := e & 0xffffffff
			a32 := a & 0xffffffff
			s1 := (e32 >> 6) | ((e32 << 26) & 0xffffffff)
			s1 = s1 ^ ((e32 >> 11) | ((e32 << 21) & 0xffffffff))
			s1 = s1 ^ ((e32 >> 25) | ((e32 << 7) & 0xffffffff))
			choose := (e & f) ^ ((e ^ 0xffffffff) & g)
			t1 := h + s1 + choose
			t1 = (t1 + constants[i] + words[i]) & 0xffffffff
			s0 := (a32 >> 2) | ((a32 << 30) & 0xffffffff)
			s0 = s0 ^ ((a32 >> 13) | ((a32 << 19) & 0xffffffff))
			s0 = s0 ^ ((a32 >> 22) | ((a32 << 10) & 0xffffffff))
			majority := (a & b) ^ (a & c) ^ (b & c)
			t2 := (s0 + majority) & 0xffffffff
			h = g
			g = f
			f = e
			e = (d + t1) & 0xffffffff
			d = c
			c = b
			b = a
			a = (t1 + t2) & 0xffffffff
		}
		values[0] = (values[0] + a) & 0xffffffff
		values[1] = (values[1] + b) & 0xffffffff
		values[2] = (values[2] + c) & 0xffffffff
		values[3] = (values[3] + d) & 0xffffffff
		values[4] = (values[4] + e) & 0xffffffff
		values[5] = (values[5] + f) & 0xffffffff
		values[6] = (values[6] + g) & 0xffffffff
		values[7] = (values[7] + h) & 0xffffffff
	}

	func aarch64MachSHA256(data []byte) []byte {
		messageSize := len(data) + 1 + 8
		messageSize = RTGAlignValue(messageSize, 64)
		message := make([]byte, messageSize)
		for i := 0; i < len(data); i++ {
			message[i] = data[i]
		}
		message[len(data)] = 0x80
		bits := len(data) * 8
		for i := 0; i < 8; i++ {
			message[messageSize-1-i] = byte(bits >> (i * 8))
		}
		values := []int{
			0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a,
			0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19,
		}
		constants := aarch64MachSHA256Constants()
		words := make([]int, 64)
		for chunk := 0; chunk < len(message); chunk += 64 {
			aarch64MachSHA256Schedule(message, chunk, words)
			aarch64MachSHA256Rounds(words, constants, values)
		}
		hash := make([]byte, 0, 32)
		for i := 0; i < len(values); i++ {
			hash = append(hash, byte(values[i]>>24))
			hash = append(hash, byte(values[i]>>16))
			hash = append(hash, byte(values[i]>>8))
			hash = append(hash, byte(values[i]))
		}
		return hash
	}



	func aarch64MachCodeSignature(
		code []byte, identifier string, executableLimit int,
	) []byte {
		slots := (len(code) + 16383) / 16384
		identifierOffset := 88
		hashOffset := identifierOffset + len(identifier) + 1
		codeDirectorySize := hashOffset + slots*32
		totalSize := 20 + codeDirectorySize
		signature := make([]byte, 0, totalSize)
		signature = aarch64MachAppendBE32(signature, 0xfade0cc0)
		signature = aarch64MachAppendBE32(signature, totalSize)
		signature = aarch64MachAppendBE32(signature, 1)
		signature = aarch64MachAppendBE32(signature, 0)
		signature = aarch64MachAppendBE32(signature, 20)
		signature = aarch64MachAppendBE32(signature, 0xfade0c02)
		signature = aarch64MachAppendBE32(
			signature, codeDirectorySize)
		signature = aarch64MachAppendBE32(signature, 0x20400)
		signature = aarch64MachAppendBE32(signature, 0x2)
		signature = aarch64MachAppendBE32(signature, hashOffset)
		signature = aarch64MachAppendBE32(
			signature, identifierOffset)
		signature = aarch64MachAppendBE32(signature, 0)
		signature = aarch64MachAppendBE32(signature, slots)
		signature = aarch64MachAppendBE32(signature, len(code))
		signature = append(signature, 32, 2, 0, 14)
		signature = aarch64MachAppendBE32(signature, 0)
		signature = aarch64MachAppendBE32(signature, 0)
		signature = aarch64MachAppendBE32(signature, 0)
		signature = aarch64MachAppendBE32(signature, 0)
		signature = aarch64MachAppendBE64(signature, 0)
		signature = aarch64MachAppendBE64(signature, 0)
		signature = aarch64MachAppendBE64(
			signature, executableLimit)
		signature = aarch64MachAppendBE64(signature, 1)
		for i := 0; i < len(identifier); i++ {
			signature = append(signature, identifier[i])
		}
		signature = append(signature, 0)
		for slot := 0; slot < slots; slot++ {
			start := slot * 16384
			end := start + 16384
			if end > len(code) {
				end = len(code)
			}
			hash := aarch64MachSHA256(code[start:end])
			signature = append(signature, hash...)
		}
		return signature
	}







	func aarch64DarwinRuntimeOperation(
		out *RTGEmitter, operation int,
	) bool {
		if operation == RTGRuntimeRead ||
			operation == RTGRuntimeWrite {
			renvoAarch64AsmMovRegReg(out, 9, 1)
			renvoAarch64AsmMovRegReg(out, 0, 3)
			renvoAarch64AsmMovRegReg(out, 1, 4)
			renvoAarch64AsmMovRegReg(out, 2, 9)
			name := "_read"
			if operation == RTGRuntimeWrite {
				name = "_write"
			}
			aarch64DarwinCallImport(out, name)
			return true
		}
		if operation == RTGRuntimeReadAt ||
			operation == RTGRuntimeWriteAt {
			renvoAarch64AsmMovRegReg(out, 9, 1)
			renvoAarch64AsmMovRegReg(out, 10, 2)
			renvoAarch64AsmMovRegReg(out, 0, 3)
			renvoAarch64AsmMovRegReg(out, 1, 4)
			renvoAarch64AsmMovRegReg(out, 2, 9)
			renvoAarch64AsmMovRegReg(out, 3, 10)
			name := "_pread"
			if operation == RTGRuntimeWriteAt {
				name = "_pwrite"
			}
			aarch64DarwinCallImport(out, name)
			return true
		}
		if operation == RTGRuntimeOpen {
			renvoAarch64AsmMovRegReg(out, 9, 1)
			renvoAarch64AsmMovRegReg(out, 0, 3)
			renvoAarch64AsmMovRegReg(out, 1, 4)
			renvoAarch64AsmPushReg(out, 9)
			aarch64DarwinCallImport(out, "_open")
			renvoAarch64AsmAddRegImm(out, 31, 31, 16)
			return true
		}
		if operation == RTGRuntimeClose {
			renvoAarch64AsmMovRegReg(out, 0, 3)
			aarch64DarwinCallImport(out, "_close")
			return true
		}
		if operation == RTGRuntimeChmod {
			renvoAarch64AsmMovRegReg(out, 0, 3)
			renvoAarch64AsmMovRegReg(out, 1, 4)
			aarch64DarwinCallImport(out, "_fchmod")
			return true
		}
		return false
	}

	func aarch64PEPatch(out *RTGEmitter, dataRVA int, dataSize int, layout nativePELayout) {
		for i := 0; i < out.AbsoluteRelocationCount(); i++ {
			at := out.AbsoluteRelocationOffset(i)
			addend := out.AbsoluteRelocationAddend(i)
			kind := out.AbsoluteRelocationKind(i)
			target := dataRVA + addend
			if kind == RTGRelocationAbsoluteBSS {
				target = dataRVA + dataSize + addend
			} else if kind == RTGRelocationImport {
				if addend > 0 && addend < len(layout.iat) {
					target = layout.iat[addend]
				}
			}
			insn := RTGGet32At(out.Code(), at)
			reg := insn & 31
			pc := 0x1000 + at
			delta := (target >> 12) - (pc >> 12)
			imm := delta & 0x1fffff
			out.PatchUint32(at, 0x90000000|((imm&3)<<29)|(((imm>>2)&0x7ffff)<<5)|reg)
			out.PatchUint32(at+4, 0x91000000|((target&0xfff)<<10)|(reg<<5)|reg)
			out.PatchUint32(at+8, 0xd503201f)
			out.PatchUint32(at+12, 0xd503201f)
		}
	}

	func aarch64PEHeader(textRaw int, textSize int, dataRVA int, dataRaw int, dataSize int, layout nativePELayout, subsystem int) []byte {
		out := make([]byte, 0, 512)
		out = nativeUntil(out, 512)
		nativePut16(out, 0, 0x5a4d)
		nativePut32(out, 0x3c, 0x80)
		pe := 0x80
		nativePut32(out, pe, 0x00004550)
		nativePut16(out, pe+4, 0xaa64)
		nativePut16(out, pe+6, 2)
		nativePut16(out, pe+20, 0xf0)
		nativePut16(out, pe+22, 0x22)
		opt := pe + 24
		nativePut16(out, opt, 0x20b)
		out[opt+2] = 3
		nativePut32(out, opt+4, textRaw)
		nativePut32(out, opt+8, dataRaw)
		nativePut32(out, opt+16, 0x1000)
		nativePut32(out, opt+20, 0x1000)
		nativePut64(out, opt+24, 0x140000000)
		nativePut32(out, opt+32, 0x1000)
		nativePut32(out, opt+36, 0x200)
		nativePut16(out, opt+40, 6)
		nativePut16(out, opt+42, 1)
		nativePut16(out, opt+44, 1)
		nativePut16(out, opt+48, 6)
		nativePut16(out, opt+50, 1)
		nativePut32(out, opt+56, RTGAlignValue(dataRVA+dataSize, 0x1000))
		nativePut32(out, opt+60, 0x200)
		nativePut16(out, opt+68, subsystem)
		nativePut16(out, opt+70, 0x8100)
		nativePut64(out, opt+72, 0x800000)
		nativePut64(out, opt+80, 0x1000)
		nativePut64(out, opt+88, 0x100000)
		nativePut64(out, opt+96, 0x1000)
		nativePut32(out, opt+108, 16)
		nativePut32(out, opt+120, layout.importRVA)
		nativePut32(out, opt+124, layout.importSize)
		nativePut32(out, opt+208, layout.iatRVA)
		nativePut32(out, opt+212, layout.iatSize)
		out = out[:opt+240]
		out = nativePESection(out, ".text", textSize, 0x1000, textRaw, 0x200, 0x60000020)
		out = nativePESection(out, ".data", dataSize, dataRVA, dataRaw, 0x200+textRaw, 0xc0000040)
		return nativeUntil(out, 0x200)
	}

	func aarch64PE64Image(out *RTGEmitter) []byte {
		code := out.Code()
		for len(code)%8 != 0 {
			code = append(code, 0)
		}
		out.SetCode(code)
		textSize := len(code)
		textRaw := RTGAlignValue(textSize, 0x200)
		dataRVA := RTGAlignValue(0x1000+textSize, 0x1000)
		data, layout := nativePEBuildImports(out, out.Data(), dataRVA, 8)
		out.SetData(data)
		aarch64PEPatch(out, dataRVA, len(data), layout)
		dataRaw := RTGAlignValue(len(data), 0x200)
		dataSize := len(data) + out.BSSSize()
		image := aarch64PEHeader(textRaw, textSize, dataRVA, dataRaw, dataSize, layout, out.WindowsSubsystem())
		image = append(image, out.Code()...)
		image = nativeUntil(image, 0x200+textRaw)
		image = append(image, data...)
		return nativeUntil(image, 0x200+textRaw+dataRaw)
	}



	func aarch64WindowsEntry(out *RTGEmitter, parameterCount int, stateOffset int) bool {
		_ = stateOffset
		if parameterCount == 0 {
			return true
		}
		if parameterCount < 0 || parameterCount > 2 {
			return false
		}
		argsOffset := out.ReserveBSS(32768, 16)
		argsTextOffset := out.ReserveBSS(32768, 16)
		argsLengthOffset := out.ReserveBSS(8, 8)
		environmentOffset := out.ReserveBSS(32768, 16)
		environmentLengthOffset := out.ReserveBSS(8, 8)
		skip := out.NewLabel()
		start := out.NewLabel()
		copyArgument := out.NewLabel()
		quote := out.NewLabel()
		setQuote := out.NewLabel()
		copyCharacter := out.NewLabel()
		argumentDone := out.NewLabel()
		argumentsDone := out.NewLabel()

		aarch64WindowsCallImport(out, 7)
		renvoAarch64AsmMovRegReg(out, 9, 0)
		renvoAarch64AsmMovRegAbs(out, 10, argsOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmMovRegAbs(out, 11, argsTextOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmMovRegImm(out, 12, 0)
		out.Mark(skip)
		renvoAarch64AsmLoadRegMem(out, 13, 9, 0, 1)
		renvoAarch64AsmCmpRegImm(out, 13, 0)
		aarch64JumpCondition(out, RTGCondition{Code: 0}, argumentsDone)
		renvoAarch64AsmCmpRegImm(out, 13, ' ')
		aarch64JumpCondition(out, RTGCondition{Code: 1}, start)
		renvoAarch64AsmAddRegImm(out, 9, 9, 1)
		aarch64Jump(out, skip)
		out.Mark(start)
		renvoAarch64AsmCmpRegImm(out, 13, 9)
		aarch64JumpCondition(out, RTGCondition{Code: 1}, copyArgument)
		renvoAarch64AsmAddRegImm(out, 9, 9, 1)
		aarch64Jump(out, skip)

		out.Mark(copyArgument)
		renvoAarch64AsmMovRegReg(out, 14, 11)
		renvoAarch64AsmMovRegImm(out, 15, 0)
		renvoAarch64AsmMovRegImm(out, 17, 0)
		copyLoop := out.NewLabel()
		out.Mark(copyLoop)
		renvoAarch64AsmLoadRegMem(out, 13, 9, 0, 1)
		renvoAarch64AsmCmpRegImm(out, 13, 0)
		aarch64JumpCondition(out, RTGCondition{Code: 0}, argumentDone)
		renvoAarch64AsmCmpRegImm(out, 13, '"')
		aarch64JumpCondition(out, RTGCondition{Code: 0}, quote)
		renvoAarch64AsmCmpRegImm(out, 17, 0)
		aarch64JumpCondition(out, RTGCondition{Code: 1}, copyCharacter)
		renvoAarch64AsmCmpRegImm(out, 13, ' ')
		aarch64JumpCondition(out, RTGCondition{Code: 0}, argumentDone)
		renvoAarch64AsmCmpRegImm(out, 13, 9)
		aarch64JumpCondition(out, RTGCondition{Code: 0}, argumentDone)
		out.Mark(copyCharacter)
		renvoAarch64AsmStoreRegMem(out, 13, 11, 0, 1)
		renvoAarch64AsmAddRegImm(out, 9, 9, 1)
		renvoAarch64AsmAddRegImm(out, 11, 11, 1)
		renvoAarch64AsmAddRegImm(out, 15, 15, 1)
		aarch64Jump(out, copyLoop)
		out.Mark(quote)
		renvoAarch64AsmCmpRegImm(out, 17, 0)
		aarch64JumpCondition(out, RTGCondition{Code: 0}, setQuote)
		renvoAarch64AsmMovRegImm(out, 17, 0)
		renvoAarch64AsmAddRegImm(out, 9, 9, 1)
		aarch64Jump(out, copyLoop)
		out.Mark(setQuote)
		renvoAarch64AsmMovRegImm(out, 17, 1)
		renvoAarch64AsmAddRegImm(out, 9, 9, 1)
		aarch64Jump(out, copyLoop)

		out.Mark(argumentDone)
		renvoAarch64AsmStoreRegMem(out, 31, 11, 0, 1)
		renvoAarch64AsmStoreRegMem(out, 14, 10, 0, 8)
		renvoAarch64AsmStoreRegMem(out, 15, 10, 8, 8)
		renvoAarch64AsmAddRegImm(out, 10, 10, 16)
		renvoAarch64AsmAddRegImm(out, 11, 11, 1)
		renvoAarch64AsmAddRegImm(out, 12, 12, 1)
		renvoAarch64AsmCmpRegImm(out, 13, 0)
		aarch64JumpCondition(out, RTGCondition{Code: 0}, argumentsDone)
		renvoAarch64AsmAddRegImm(out, 9, 9, 1)
		aarch64Jump(out, skip)

		out.Mark(argumentsDone)
		renvoAarch64AsmMovRegAbs(out, 9, argsLengthOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmStoreRegMem(out, 12, 9, 0, 8)

		environmentLoop := out.NewLabel()
		environmentLength := out.NewLabel()
		environmentStringDone := out.NewLabel()
		environmentDone := out.NewLabel()
		aarch64WindowsCallImport(out, 9)
		renvoAarch64AsmMovRegReg(out, 9, 0)
		renvoAarch64AsmMovRegAbs(out, 10, environmentOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmMovRegImm(out, 11, 0)
		out.Mark(environmentLoop)
		renvoAarch64AsmLoadRegMem(out, 12, 9, 0, 1)
		renvoAarch64AsmCmpRegImm(out, 12, 0)
		aarch64JumpCondition(out, RTGCondition{Code: 0}, environmentDone)
		renvoAarch64AsmStoreRegMem(out, 9, 10, 0, 8)
		renvoAarch64AsmMovRegImm(out, 13, 0)
		out.Mark(environmentLength)
		renvoAarch64AsmAddRegReg(out, 14, 9, 13)
		renvoAarch64AsmLoadRegMem(out, 12, 14, 0, 1)
		renvoAarch64AsmCmpRegImm(out, 12, 0)
		aarch64JumpCondition(out, RTGCondition{Code: 0}, environmentStringDone)
		renvoAarch64AsmAddRegImm(out, 13, 13, 1)
		aarch64Jump(out, environmentLength)
		out.Mark(environmentStringDone)
		renvoAarch64AsmStoreRegMem(out, 13, 10, 8, 8)
		renvoAarch64AsmAddRegImm(out, 10, 10, 16)
		renvoAarch64AsmAddRegImm(out, 13, 13, 1)
		renvoAarch64AsmAddRegReg(out, 9, 9, 13)
		renvoAarch64AsmAddRegImm(out, 11, 11, 1)
		aarch64Jump(out, environmentLoop)
		out.Mark(environmentDone)
		renvoAarch64AsmMovRegAbs(out, 9, environmentLengthOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmStoreRegMem(out, 11, 9, 0, 8)

		renvoAarch64AsmMovRegAbs(out, 3, argsOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmMovRegAbs(out, 9, argsLengthOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmLoadRegMem(out, 4, 9, 0, 8)
		renvoAarch64AsmMovRegReg(out, 1, 4)
		renvoAarch64AsmMovRegAbs(out, 2, environmentOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmMovRegReg(out, 5, 11)
		renvoAarch64AsmMovRegReg(out, 6, 11)
		return true
	}



	func aarch64WindowsRuntimeReadWrite(
		out *RTGEmitter, write bool, positional bool,
	) {
		helper := out.NewLabel()
		after := out.NewLabel()
		countOffset := out.ReserveBSS(8, 8)
		positionOffset := out.ReserveBSS(8, 8)
		resultOffset := out.ReserveBSS(8, 8)
		standard := out.NewLabel()
		standardError := out.NewLabel()
		handleReady := out.NewLabel()
		sequential := out.NewLabel()
		positionFailed := out.NewLabel()
		ioFailed := out.NewLabel()
		restore := out.NewLabel()
		failed := out.NewLabel()
		done := out.NewLabel()
		aarch64Jump(out, after)
		out.Mark(helper)
		renvoAarch64AsmPushReg(out, 30)
		renvoAarch64AsmPushReg(out, 3)
		renvoAarch64AsmPushReg(out, 4)
		renvoAarch64AsmPushReg(out, 2)
		renvoAarch64AsmPushReg(out, 1)
		renvoAarch64AsmLoadRegMem(out, 9, 31, 48, 8)
		if write {
			renvoAarch64AsmCmpRegImm(out, 9, 1)
			aarch64JumpCondition(out, RTGCondition{Code: 0}, standard)
			renvoAarch64AsmCmpRegImm(out, 9, 2)
			aarch64JumpCondition(out, RTGCondition{Code: 0}, standardError)
		} else {
			renvoAarch64AsmCmpRegImm(out, 9, 0)
			aarch64JumpCondition(out, RTGCondition{Code: 0}, standard)
		}
		renvoAarch64AsmStoreRegMem(out, 9, 31, 48, 8)
		aarch64Jump(out, handleReady)
		out.Mark(standard)
		standardHandle := -10
		if write {
			standardHandle = -11
		}
		renvoAarch64AsmMovRegImm(out, 0, standardHandle)
		aarch64WindowsCallImport(out, 6)
		renvoAarch64AsmStoreRegMem(out, 0, 31, 48, 8)
		aarch64Jump(out, handleReady)
		out.Mark(standardError)
		renvoAarch64AsmMovRegImm(out, 0, -12)
		aarch64WindowsCallImport(out, 6)
		renvoAarch64AsmStoreRegMem(out, 0, 31, 48, 8)
		out.Mark(handleReady)
		renvoAarch64AsmLoadRegMem(out, 9, 31, 0, 8)
		renvoAarch64AsmCmpRegImm(out, 9, 0)
		aarch64JumpCondition(out, RTGCondition{Code: 11}, sequential)

		renvoAarch64AsmLoadRegMem(out, 0, 31, 48, 8)
		renvoAarch64AsmMovRegImm(out, 1, 0)
		renvoAarch64AsmMovRegImm(out, 2, 0)
		renvoAarch64AsmMovRegImm(out, 3, 1)
		aarch64WindowsCallImport(out, 5)
		renvoAarch64AsmMovRegImm(out, 9, 0xffffffff)
		renvoAarch64AsmCmpRegReg(out, 0, 9)
		aarch64JumpCondition(out, RTGCondition{Code: 0}, positionFailed)
		renvoAarch64AsmMovRegAbs(out, 9, positionOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmStoreRegMem(out, 0, 9, 0, 8)

		renvoAarch64AsmLoadRegMem(out, 0, 31, 48, 8)
		renvoAarch64AsmLoadRegMem(out, 1, 31, 0, 8)
		renvoAarch64AsmMovRegImm(out, 2, 0)
		renvoAarch64AsmMovRegImm(out, 3, 0)
		aarch64WindowsCallImport(out, 5)
		renvoAarch64AsmMovRegImm(out, 9, 0xffffffff)
		renvoAarch64AsmCmpRegReg(out, 0, 9)
		aarch64JumpCondition(out, RTGCondition{Code: 0}, ioFailed)
		aarch64WindowsReadWriteCall(out, write, countOffset)
		renvoAarch64AsmCmpRegImm(out, 0, 0)
		aarch64JumpCondition(out, RTGCondition{Code: 0}, ioFailed)
		renvoAarch64AsmMovRegAbs(out, 9, countOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmLoadRegMem(out, 9, 9, 0, 8)
		aarch64Jump(out, restore)
		out.Mark(ioFailed)
		renvoAarch64AsmMovRegImm(out, 9, -1)
		out.Mark(restore)
		renvoAarch64AsmMovRegAbs(out, 10, resultOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmStoreRegMem(out, 9, 10, 0, 8)
		renvoAarch64AsmLoadRegMem(out, 0, 31, 48, 8)
		renvoAarch64AsmMovRegAbs(out, 9, positionOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmLoadRegMem(out, 1, 9, 0, 8)
		renvoAarch64AsmMovRegImm(out, 2, 0)
		renvoAarch64AsmMovRegImm(out, 3, 0)
		aarch64WindowsCallImport(out, 5)
		renvoAarch64AsmMovRegAbs(out, 9, resultOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmLoadRegMem(out, 0, 9, 0, 8)
		aarch64Jump(out, done)

		out.Mark(positionFailed)
		renvoAarch64AsmMovRegImm(out, 0, -1)
		aarch64Jump(out, done)

		out.Mark(sequential)
		aarch64WindowsReadWriteCall(out, write, countOffset)
		renvoAarch64AsmCmpRegImm(out, 0, 0)
		aarch64JumpCondition(out, RTGCondition{Code: 0}, failed)
		renvoAarch64AsmMovRegAbs(out, 9, countOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmLoadRegMem(out, 0, 9, 0, 8)
		aarch64Jump(out, done)
		out.Mark(failed)
		renvoAarch64AsmMovRegImm(out, 0, -1)
		out.Mark(done)
		renvoAarch64AsmAddRegImm(out, 31, 31, 64)
		renvoAarch64AsmPopReg(out, 30)
		renvoAarch64AsmRet(out)
		out.Mark(after)
		if !positional {
			renvoAarch64AsmMovRegImm(out, 2, -1)
		}
		aarch64Call(out, helper)
	}

	func aarch64WindowsReadWriteCall(
		out *RTGEmitter, write bool, countOffset int,
	) {
		renvoAarch64AsmLoadRegMem(out, 0, 31, 48, 8)
		renvoAarch64AsmLoadRegMem(out, 1, 31, 32, 8)
		renvoAarch64AsmLoadRegMem(out, 2, 31, 16, 8)
		renvoAarch64AsmMovRegAbs(out, 3, countOffset, RTGRelocationAbsoluteBSS)
		renvoAarch64AsmMovRegImm(out, 4, 0)
		importID := 3
		if write {
			importID = 4
		}
		aarch64WindowsCallImport(out, importID)
	}











	func aarch64WindowsRuntimeOperation(
		out *RTGEmitter, operation int,
	) bool {
		if operation == RTGRuntimeRead {
			aarch64WindowsRuntimeReadWrite(out, false, false)
			return true
		}
		if operation == RTGRuntimeWrite {
			aarch64WindowsRuntimeReadWrite(out, true, false)
			return true
		}
		if operation == RTGRuntimeReadAt {
			aarch64WindowsRuntimeReadWrite(out, false, true)
			return true
		}
		if operation == RTGRuntimeWriteAt {
			aarch64WindowsRuntimeReadWrite(out, true, true)
			return true
		}
		if operation == RTGRuntimeOpen {
			aarch64WindowsRuntimeOpen(out)
			return true
		}
		if operation == RTGRuntimeClose {
			aarch64WindowsRuntimeClose(out)
			return true
		}
		if operation == RTGRuntimeChmod {
			aarch64WindowsRuntimeChmod(out)
			return true
		}
		return false
	}

	func aarch64WindowsStaticCall(out *RTGEmitter, importID int, wordCount int) {
		registerWords := wordCount
		if registerWords > 8 {
			registerWords = 8
		}
		for i := 0; i < registerWords; i++ {
			renvoAarch64AsmPopReg(out, i)
		}
		stackWords := wordCount - registerWords
		renvoAarch64AsmEmit(out, 0x910003e9)
		savedSPOff := stackWords * 8
		allocation := RTGAlignValue(savedSPOff+8, 16)
		renvoAarch64AsmAddRegImm(out, 31, 31, -allocation)
		for i := 0; i < stackWords; i++ {
			renvoAarch64AsmLoadRegMem(out, 10, 9, i*16, 8)
			renvoAarch64AsmStoreRegMem(out, 10, 31, i*8, 8)
		}
		renvoAarch64AsmStoreRegMem(out, 9, 31, savedSPOff, 8)
		aarch64WindowsCallImport(out, importID)
		renvoAarch64AsmMovRegReg(out, 10, 0)
		renvoAarch64AsmLoadRegMem(out, 9, 31, savedSPOff, 8)
		renvoAarch64AsmEmit(out, 0x9100013f)
		renvoAarch64AsmAddRegImm(out, 31, 31, stackWords*16)
		renvoAarch64AsmMovRegReg(out, 0, 10)
	}



	func renvoAarch64AsmAlign(a *RTGEmitter) {
		for a.Len()%4 != 0 {
			RTGByte(a, 0)
		}
	}

	func renvoAarch64AsmMovRegReg(a *RTGEmitter, dst int, src int) {
		if dst == src {
			return
		}
		renvoAarch64AsmEmit(a, 0xaa0003e0|(src<<16)|dst)
	}

	func renvoAarch64AsmMovRegImm(a *RTGEmitter, reg int, imm int) {
		if imm < 0 {
			inv := -imm - 1
			part := inv & 65535
			renvoAarch64AsmEmit(a, 0x92800000|(part<<5)|reg)
			for i := 1; i < 4; i++ {
				targetPart := (imm >> (i * 16)) & 65535
				if targetPart != 65535 {
					renvoAarch64AsmEmit(a, 0xf2800000|(i<<21)|(targetPart<<5)|reg)
				}
			}
			return
		}
		part := imm & 65535
		renvoAarch64AsmEmit(a, 0xd2800000|(part<<5)|reg)
		for i := 1; i < 4; i++ {
			part = (imm >> (i * 16)) & 65535
			if part != 0 {
				renvoAarch64AsmEmit(a, 0xf2800000|(i<<21)|(part<<5)|reg)
			}
		}
	}

	func renvoAarch64AsmPatchMovRegImmAt(a *RTGEmitter, at int, reg int, imm int) {
		part := imm & 65535
		a.PatchUint32( at, 0xd2800000|(part<<5)|reg)
		for i := 1; i < 4; i++ {
			part = (imm >> (i * 16)) & 65535
			a.PatchUint32( at+i*4, 0xf2800000|(i<<21)|(part<<5)|reg)
		}
	}



	func renvoAarch64AsmAddRegImm(a *RTGEmitter, dst int, src int, imm int) {
		if imm == 0 {
			renvoAarch64AsmMovRegReg(a, dst, src)
			return
		}
		op := 0x91000000
		if imm < 0 {
			op = 0xd1000000
			imm = -imm
		}
		cur := src
		for imm > 0 {
			shift := 0
			chunk := imm
			if chunk > 4095 {
				chunk = imm / 4096
				if chunk > 4095 {
					chunk = 4095
				}
				shift = 1
				imm = imm - chunk*4096
			} else {
				imm = 0
			}
			renvoAarch64AsmEmit(a, op|(shift<<22)|(chunk<<10)|(cur<<5)|dst)
			cur = dst
		}
	}









	func renvoAarch64AsmAddr(a *RTGEmitter, base int, disp int) int {
		if disp == 0 {
			return base
		}
		renvoAarch64AsmAddRegImm(a, aarch64Address.Code, base, disp)
		return aarch64Address.Code
	}

	func renvoAarch64AsmLoadRegMem(a *RTGEmitter, dst int, base int, disp int, size int) {
		if disp != 0 && disp >= -256 && disp <= 255 {
			imm := (disp & 511) << 12
			if size == 1 {
				renvoAarch64AsmEmit(a, 0x38400000|imm|(base<<5)|dst)
				return
			}
			if size == 2 {
				renvoAarch64AsmEmit(a, 0x78400000|imm|(base<<5)|dst)
				return
			}
			if size == 4 {
				renvoAarch64AsmEmit(a, 0xb8400000|imm|(base<<5)|dst)
				return
			}
			renvoAarch64AsmEmit(a, 0xf8400000|imm|(base<<5)|dst)
			return
		}
		addr := renvoAarch64AsmAddr(a, base, disp)
		if size == 1 {
			renvoAarch64AsmEmit(a, 0x39400000|(addr<<5)|dst)
			return
		}
		if size == 2 {
			renvoAarch64AsmEmit(a, 0x79800000|(addr<<5)|dst)
			return
		}
		if size == 4 {
			renvoAarch64AsmEmit(a, 0xb9800000|(addr<<5)|dst)
			return
		}
		renvoAarch64AsmEmit(a, 0xf9400000|(addr<<5)|dst)
	}

	func renvoAarch64AsmStoreRegMem(a *RTGEmitter, src int, base int, disp int, size int) {
		if disp != 0 && disp >= -256 && disp <= 255 {
			imm := (disp & 511) << 12
			if size == 1 {
				renvoAarch64AsmEmit(a, 0x38000000|imm|(base<<5)|src)
				return
			}
			if size == 2 {
				renvoAarch64AsmEmit(a, 0x78000000|imm|(base<<5)|src)
				return
			}
			if size == 4 {
				renvoAarch64AsmEmit(a, 0xb8000000|imm|(base<<5)|src)
				return
			}
			renvoAarch64AsmEmit(a, 0xf8000000|imm|(base<<5)|src)
			return
		}
		addr := renvoAarch64AsmAddr(a, base, disp)
		if size == 1 {
			renvoAarch64AsmEmit(a, 0x39000000|(addr<<5)|src)
			return
		}
		if size == 2 {
			renvoAarch64AsmEmit(a, 0x79000000|(addr<<5)|src)
			return
		}
		if size == 4 {
			renvoAarch64AsmEmit(a, 0xb9000000|(addr<<5)|src)
			return
		}
		renvoAarch64AsmEmit(a, 0xf9000000|(addr<<5)|src)
	}



















































	func renvoAarch64AsmStackMem(a *RTGEmitter, offset int, base int, disp8 int, disp32 int) {
		if base == 0x8948 && disp8 == 0x45 {
			renvoAarch64AsmStoreRegStack(a, aarch64Primary.Code, offset)
			return
		}
		if base == 0x8948 && disp8 == 0x55 {
			renvoAarch64AsmStoreRegStack(a, aarch64Secondary.Code, offset)
			return
		}
		if base == 0x8948 && disp8 == 0x4d {
			renvoAarch64AsmStoreRegStack(a, aarch64Tertiary.Code, offset)
			return
		}
		if base == 0x8b48 && disp8 == 0x45 {
			renvoAarch64AsmLoadRegStack(a, aarch64Primary.Code, offset)
			return
		}
		if base == 0x8b48 && disp8 == 0x55 {
			renvoAarch64AsmLoadRegStack(a, aarch64Secondary.Code, offset)
			return
		}
		if base == 0x8b48 && disp8 == 0x4d {
			renvoAarch64AsmLoadRegStack(a, aarch64Tertiary.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x45 {
			renvoAarch64AsmLeaRegStack(a, aarch64Primary.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x55 {
			renvoAarch64AsmLeaRegStack(a, aarch64Secondary.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x7d {
			renvoAarch64AsmLeaRegStack(a, aarch64X3.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x75 {
			renvoAarch64AsmLeaRegStack(a, aarch64X4.Code, offset)
			return
		}
	}



	func renvoAarch64AsmMemDisp(a *RTGEmitter, disp int, op int, disp8 int, disp32 int) {
		if op == 0x8b48 && disp8 == 0x4a {
			renvoAarch64AsmLoadRegMem(a, aarch64Tertiary.Code, aarch64Secondary.Code, disp, 8)
			return
		}
		if op == 0x8b48 && disp8 == 0x52 {
			renvoAarch64AsmLoadRegMem(a, aarch64Secondary.Code, aarch64Secondary.Code, disp, 8)
			return
		}
	}











	func renvoAarch64AsmLoadRaxIndexRcxSize(a *RTGEmitter, size int) {
		shift := 3
		if size == 1 {
			shift = 0
		}
		if size == 2 {
			shift = 1
		}
		if size == 4 {
			shift = 2
		}
		renvoAarch64AsmAddRegRegShift(a, aarch64Address.Code, aarch64Primary.Code, aarch64Tertiary.Code, shift)
		renvoAarch64AsmLoadRegMem(a, aarch64Primary.Code, aarch64Address.Code, 0, size)
	}







	func renvoAarch64AsmNormalizeRaxForKind(a *RTGEmitter, kind int) {
		if kind == RTGScalarByte {
			renvoAarch64AsmEmit(a, 0x92401c00)
			return
		}
		if kind == RTGScalarInt8 {
			renvoAarch64AsmEmit(a, 0x93401c00)
			return
		}
		if kind == RTGScalarInt16 {
			renvoAarch64AsmEmit(a, 0x93403c00)
			return
		}
		if kind == RTGScalarUint16 {
			renvoAarch64AsmEmit(a, 0x92403c00)
			return
		}
		if kind == RTGScalarInt32 {
			renvoAarch64AsmEmit(a, 0x93407c00)
			return
		}
		if kind == RTGScalarUint32 {
			renvoAarch64AsmEmit(a, 0x92407c00)
		}
	}











	func renvoAarch64AsmCmpRegImm(a *RTGEmitter, reg int, imm int) {
		if imm >= 0 && imm <= 4095 {
			renvoAarch64AsmEmit(a, 0xf100001f|(imm<<10)|(reg<<5))
			return
		}
		renvoAarch64AsmMovRegImm(a, aarch64Scratch.Code, imm)
		renvoAarch64AsmCmpRegReg(a, reg, aarch64Scratch.Code)
	}















	func renvoAarch64AsmDivLeftRcxRightRax(a *RTGEmitter, mod bool) {
		renvoAarch64AsmMovRegReg(a, aarch64Scratch.Code, aarch64Primary.Code)
		renvoAarch64AsmEmit(a, 0x9ac00c40)
		if mod {
			renvoAarch64AsmEmit(a, 0x9b098800)
		}
	}

	func renvoAarch64CondFromSetcc(setcc int) int {
		if setcc == 0x94 {
			return 0
		}
		if setcc == 0x95 {
			return 1
		}
		if setcc == 0x92 {
			return 3
		}
		if setcc == 0x93 {
			return 2
		}
		if setcc == 0x96 {
			return 9
		}
		if setcc == 0x97 {
			return 8
		}
		if setcc == 0x9c {
			return 11
		}
		if setcc == 0x9e {
			return 13
		}
		if setcc == 0x9f {
			return 12
		}
		return 10
	}





















	func renvoAarch64AsmStoreRaxMemRdxRcxSize(a *RTGEmitter, size int) {
		shift := 3
		if size == 1 {
			shift = 0
		}
		if size == 2 {
			shift = 1
		}
		if size == 4 {
			shift = 2
		}
		renvoAarch64AsmAddRegRegShift(a, aarch64Address.Code, aarch64Secondary.Code, aarch64Tertiary.Code, shift)
		renvoAarch64AsmStoreRegMem(a, aarch64Primary.Code, aarch64Address.Code, 0, size)
	}





















	// direct_emitter_v1 uses registers and addresses rather than the historical
	// x86-named value helpers above. These algorithms are the architecture
	// boundary used by generated backends.




	func aarch64EmitAddress(out *RTGEmitter, destination RTGRegister, address RTGAddress) {
		if RTGAddressValid(address) {
			aarch64EmitADR(out, destination, address)
			return
		}
		base := address.Base.Code
		if address.Index.Valid {
			shift := 0
			if address.Scale == 2 {
				shift = 1
			} else if address.Scale == 4 {
				shift = 2
			} else if address.Scale == 8 {
				shift = 3
			}
			renvoAarch64AsmAddRegRegShift(
				out, destination.Code, base, address.Index.Code, shift)
			base = destination.Code
		}
		renvoAarch64AsmAddRegImm(
			out, destination.Code, base, address.Displacement)
	}

	func aarch64MemoryBase(out *RTGEmitter, address RTGAddress) int {
		if RTGAddressValid(address) || address.Index.Valid {
			aarch64EmitAddress(out, aarch64Address, address)
			return aarch64Address.Code
		}
		if address.Displacement < -256 || address.Displacement > 255 {
			aarch64EmitAddress(out, aarch64Address, address)
			return aarch64Address.Code
		}
		return address.Base.Code
	}

	func aarch64LoadWidth(
		out *RTGEmitter,
		destination RTGRegister,
		address RTGAddress,
		size int,
		signed bool,
	) {
		base := aarch64MemoryBase(out, address)
		displacement := address.Displacement
		if base == aarch64Address.Code {
			displacement = 0
		}
		imm := (displacement & 511) << 12
		op := 0xf8400000
		if size == 1 {
			op = 0x38400000
			if signed {
				op = 0x38800000
			}
		} else if size == 2 {
			op = 0x78400000
			if signed {
				op = 0x78800000
			}
		} else if size == 4 {
			op = 0xb8400000
			if signed {
				op = 0xb8800000
			}
		}
		renvoAarch64AsmEmit(
			out, op|imm|(base<<5)|destination.Code)
	}















	func aarch64StoreWidth(
		out *RTGEmitter,
		address RTGAddress,
		source RTGRegister,
		size int,
	) {
		base := aarch64MemoryBase(out, address)
		displacement := address.Displacement
		if base == aarch64Address.Code {
			displacement = 0
		}
		imm := (displacement & 511) << 12
		op := 0xf8000000
		if size == 1 {
			op = 0x38000000
		} else if size == 2 {
			op = 0x78000000
		} else if size == 4 {
			op = 0xb8000000
		}
		renvoAarch64AsmEmit(out, op|imm|(base<<5)|source.Code)
	}





















	func aarch64VariableShift(
		out *RTGEmitter, direction RTGShiftDirection, signed bool,
	) {
		op := 0x9ac02400
		if direction == RTGShiftLeft {
			op = 0x9ac02000
		} else if signed {
			op = 0x9ac02800
		}
		renvoAarch64AsmEmit(out,
			op|(aarch64Primary.Code<<16)|
				(aarch64Tertiary.Code<<5)|aarch64Primary.Code)
	}

	func aarch64SignedDivide(out *RTGEmitter, remainder bool) {
		renvoAarch64AsmMovRegReg(
			out, aarch64Scratch.Code, aarch64Primary.Code)
		renvoAarch64AsmEmit(out,
			0x9ac00c00|(aarch64Primary.Code<<16)|
				(aarch64Tertiary.Code<<5)|aarch64Primary.Code)
		if remainder {
			renvoAarch64AsmEmit(out,
				0x9b008000|(aarch64Scratch.Code<<16)|
					(aarch64Primary.Code<<10)|
					(aarch64Tertiary.Code<<5)|aarch64Primary.Code)
		}
	}



	func aarch64PatchRelocations(out *RTGEmitter) {
		for i := 0; i < out.RelocationCount(); i++ {
			at := out.RelocationOffset(i)
			label := out.RelocationLabel(i)
			target := out.LabelPosition(label)
			if at < 0 || at+4 > len(out.Code()) || target < 0 {
				continue
			}
			insn := RTGGet32At(out.Code(), at)
			displacement := target - at
			if (insn & 0xfc000000) == 0x94000000 {
				out.PatchUint32(
					at, 0x94000000|((displacement/4)&0x03ffffff))
			} else if (insn & 0xfc000000) == 0x14000000 {
				out.PatchUint32(
					at, 0x14000000|((displacement/4)&0x03ffffff))
			} else if (insn & 0xff000010) == 0x54000000 {
				out.PatchUint32(at,
					(insn&0xff00001f)|
						(((displacement/4)&0x7ffff)<<5))
			} else if (insn & 0x9f000000) == 0x10000000 {
				addend := (insn >> 29) & 3
				addend = addend | (((insn >> 5) & 0x7ffff) << 2)
				if (addend & 0x100000) != 0 {
					addend = addend - 0x200000
				}
				displacement = displacement + addend
				out.PatchUint32(at,
					0x10000000|(insn&31)|
						((displacement&3)<<29)|
						(((displacement>>2)&0x7ffff)<<5))
			}
		}
	}



	func aarch64FrameFinish(out *RTGEmitter, at int, stackUsed int) {
		frame := (stackUsed + 15) & -16
		high := frame / 4096
		low := frame % 4096
		if high > 0 {
			out.PatchUint32(at, 0xd14003ff|(high<<10))
		}
		if low > 0 {
			out.PatchUint32(at+4, 0xd10003ff|(low<<10))
		}
	}
}
arch aarch64 {
	alias = "aarch64"
	endian = little
	word_bits = 64
	pointer_bits = 64
	instruction_alignment = 4
	patch_relocations = go aarch64PatchRelocations

	registers gpr64 = [
		x0, x1, x2, x3, x4, x5, x6, x7,
		x8, x9, x10, x11, x12, x13, x14, x15,
		x16, x17, x18, x19, x20, x21, x22, x23,
		x24, x25, x26, x27, x28, x29, x30, sp
	]

	locations {
		primary = x0
		secondary = x1
		tertiary = x2
		call_words = [x3, x4, x1, x2, x5, x6]
		system = x8
		scratch = x9
		scratch2 = x10
		address = x12
		copy_destination = x3
		copy_source = x4
		copy_count = x1
