		bit_and = bit_and
		bit_or = bit_or
		bit_xor = bit_xor
		compare = compare
		test = test
		increment = increment
		decrement = decrement
		shift_left_immediate = shift_left_immediate
		shift_right_unsigned_immediate = shift_right_unsigned_immediate
		shift_right_signed_immediate = shift_right_signed_immediate
