	func x86ELFPatchAbsoluteRelocations(a *RTGEmitter, codeOffset int, dataOffset int, bssOffset int) {
		for i := 0; i < a.AbsoluteRelocationCount(); i++ {
			at := a.AbsoluteRelocationOffset(i)
			addend := a.AbsoluteRelocationAddend(i)
			kind := a.AbsoluteRelocationKind(i)
			target := dataOffset + addend
			if kind == RTGRelocationAbsoluteBSS {
				target = bssOffset + addend
			}
			a.PatchUint32(at, target-(codeOffset+at+4))
		}
	}



	type nativePELayout struct {
		importRVA int
		importSize int
		iatRVA int
		iatSize int
		iat []int
	}

	func nativePut16(out []byte, at int, value int) {
		out[at] = byte(value)
		out[at+1] = byte(value >> 8)
	}

	func nativePut64(out []byte, at int, value int) {
		nativePut32(out, at, value)
		nativePut32(out, at+4, 0)
	}

	func nativeUntil(out []byte, size int) []byte {
		for len(out) < size {
			out = append(out, 0)
		}
		return out
	}

	func nativeStringZ(out []byte, value string) []byte {
		for i := 0; i < len(value); i++ {
			out = append(out, value[i])
		}
		return append(out, 0)
	}

	func nativePEImportName(id int) string {
		if id == 1 { return "CreateFileA" }
		if id == 2 { return "CloseHandle" }
		if id == 3 { return "ReadFile" }
		if id == 4 { return "WriteFile" }
		if id == 5 { return "SetFilePointer" }
		if id == 6 { return "GetStdHandle" }
		if id == 7 { return "GetCommandLineA" }
		if id == 9 { return "GetEnvironmentStringsA" }
		return "ExitProcess"
	}

	func nativePEImportEntry(data []byte, layout *nativePELayout, dataRVA int, iltAt int, iatAt int, slot int, id int, name string, wordBytes int) []byte {
		nameAt := len(data)
		data = append(data, 0, 0)
		data = nativeStringZ(data, name)
		if len(data)&1 != 0 {
			data = append(data, 0)
		}
		nameRVA := dataRVA + nameAt
		if wordBytes == 4 {
			nativePut32(data, iltAt+slot*wordBytes, nameRVA)
			nativePut32(data, iatAt+slot*wordBytes, nameRVA)
		} else {
			nativePut64(data, iltAt+slot*wordBytes, nameRVA)
			nativePut64(data, iatAt+slot*wordBytes, nameRVA)
		}
		layout.iat[id] = dataRVA + iatAt + slot*wordBytes
		return data
	}

	func nativePEBuildImports(out *RTGEmitter, data []byte, dataRVA int, wordBytes int) ([]byte, nativePELayout) {
		var layout nativePELayout
		staticCount := out.StaticImportCount()
		importAt := RTGAlignValue(len(data), wordBytes)
		data = nativeUntil(data, importAt+(staticCount+2)*20)
		iltAt := len(data)
		data = nativeUntil(data, iltAt+10*wordBytes)
		iatAt := len(data)
		data = nativeUntil(data, iatAt+10*wordBytes)
		customAt := len(data)
		data = nativeUntil(data, customAt+staticCount*4*wordBytes)
		layout.iat = make([]int, 10+staticCount)
		for id := 1; id <= 9; id++ {
			data = nativePEImportEntry(data, &layout, dataRVA, iltAt, iatAt, id-1, id, nativePEImportName(id), wordBytes)
		}
		for i := 0; i < staticCount; i++ {
			customILT := customAt + i*4*wordBytes
			customIAT := customILT + 2*wordBytes
			data = nativePEImportEntry(data, &layout, dataRVA, customILT, customIAT, 0, 10+i, out.StaticImportName(i), wordBytes)
		}
		dllAt := len(data)
		data = nativeStringZ(data, "kernel32.dll")
		nativePut32(data, importAt, dataRVA+iltAt)
		nativePut32(data, importAt+12, dataRVA+dllAt)
		nativePut32(data, importAt+16, dataRVA+iatAt)
		for i := 0; i < staticCount; i++ {
			customILT := customAt + i*4*wordBytes
			customIAT := customILT + 2*wordBytes
			dllAt = len(data)
			data = nativeStringZ(data, out.StaticImportDLL(i))
			descriptor := importAt + (i+1)*20
			nativePut32(data, descriptor, dataRVA+customILT)
			nativePut32(data, descriptor+12, dataRVA+dllAt)
			nativePut32(data, descriptor+16, dataRVA+customIAT)
		}
		layout.importRVA = dataRVA + importAt
		layout.importSize = len(data) - importAt
		layout.iatRVA = dataRVA + iatAt
		layout.iatSize = customAt + staticCount*4*wordBytes - iatAt
		return data, layout
	}

	func x86PEPatch(out *RTGEmitter, dataRVA int, dataSize int, layout nativePELayout) {
		for i := 0; i < out.AbsoluteRelocationCount(); i++ {
			at := out.AbsoluteRelocationOffset(i)
			addend := out.AbsoluteRelocationAddend(i)
			kind := out.AbsoluteRelocationKind(i)
			target := dataRVA + addend
			if kind == RTGRelocationAbsoluteBSS {
				target = dataRVA + dataSize + addend
			} else if kind == RTGRelocationImport {
				if addend > 0 && addend < len(layout.iat) {
					target = layout.iat[addend]
				}
			}
			out.PatchUint32(at, target-(0x1000+at+4))
		}
	}

	func x86PEHeader(textRaw int, textSize int, dataRVA int, dataRaw int, dataSize int, layout nativePELayout, subsystem int) []byte {
		out := make([]byte, 0, 512)
		out = nativeUntil(out, 512)
		nativePut16(out, 0, 0x5a4d)
		nativePut32(out, 0x3c, 0x80)
		pe := 0x80
		nativePut32(out, pe, 0x00004550)
		nativePut16(out, pe+4, 0x8664)
		nativePut16(out, pe+6, 2)
		nativePut16(out, pe+20, 0xf0)
		nativePut16(out, pe+22, 0x22)
		opt := pe + 24
		nativePut16(out, opt, 0x20b)
		nativePut32(out, opt+4, textRaw)
		nativePut32(out, opt+8, dataRaw)
		nativePut32(out, opt+16, 0x1000)
		nativePut32(out, opt+20, 0x1000)
		nativePut64(out, opt+24, 0x400000)
		nativePut32(out, opt+32, 0x1000)
		nativePut32(out, opt+36, 0x200)
		nativePut16(out, opt+40, 4)
		nativePut16(out, opt+48, 4)
		nativePut32(out, opt+56, RTGAlignValue(dataRVA+dataSize, 0x1000))
		nativePut32(out, opt+60, 0x200)
		nativePut16(out, opt+68, subsystem)
		nativePut16(out, opt+70, 0x100)
		nativePut64(out, opt+72, 0x800000)
		nativePut64(out, opt+80, 0x1000)
		nativePut64(out, opt+88, 0x100000)
		nativePut64(out, opt+96, 0x1000)
		nativePut32(out, opt+108, 16)
		nativePut32(out, opt+120, layout.importRVA)
		nativePut32(out, opt+124, layout.importSize)
		nativePut32(out, opt+208, layout.iatRVA)
		nativePut32(out, opt+212, layout.iatSize)
		out = out[:opt+240]
		out = nativePESection(out, ".text", textSize, 0x1000, textRaw, 0x200, 0x60000020)
		out = nativePESection(out, ".data", dataSize, dataRVA, dataRaw, 0x200+textRaw, 0xc0000040)
		return nativeUntil(out, 0x200)
	}

	func x86PE64Image(out *RTGEmitter) []byte {
		code := out.Code()
		for len(code)%8 != 0 {
			code = append(code, 0)
		}
		out.SetCode(code)
		textSize := len(code)
		textRaw := RTGAlignValue(textSize, 0x200)
		dataRVA := RTGAlignValue(0x1000+textSize, 0x1000)
		data, layout := nativePEBuildImports(out, out.Data(), dataRVA, 8)
		out.SetData(data)
		x86PEPatch(out, dataRVA, len(data), layout)
		dataRaw := RTGAlignValue(len(data), 0x200)
		dataSize := len(data) + out.BSSSize()
		image := x86PEHeader(textRaw, textSize, dataRVA, dataRaw, dataSize, layout, out.WindowsSubsystem())
		image = append(image, out.Code()...)
		image = nativeUntil(image, 0x200+textRaw)
		image = append(image, data...)
		return nativeUntil(image, 0x200+textRaw+dataRaw)
	}

	func x86WindowsExit(out *RTGEmitter, status RTGRegister) {
		if status.Code != 1 {
			x86RRRM(out, 0x89, RTGRegister{Code: 1, Valid: true}, status, 64)
		}
		out.Bytes4(0x48, 0x83, 0xec, 0x28)
		out.Bytes2(0xff, 0x15)
		at := out.Len()
		out.Int32(0)
		out.AbsoluteReloc(at, 8, RTGRelocationImport)
	}



