		x86_32CopyBytes(out:emitter) {
			let destination = x86_32CopyDestination
			let source = x86_32CopySource
			let count = x86_32CopyCount
			let scratch = x86_32Scratch
			let forward = out.NewLabel()
			let done = out.NewLabel()
			call x86_32Compare(out,destination,source)
			call x86_32JumpCondition(out,record_condition(JumpOpcode:0x86),forward)
			call x86_32Address(out,scratch,record_address(Base:source,Index:count,Scale:1,))
			call x86_32Compare(out,destination,scratch)
			call x86_32JumpCondition(out,record_condition(JumpOpcode:0x83),forward)
