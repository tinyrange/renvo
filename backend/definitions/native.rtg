definition 1
unit native
implements direct_emitter_v1

# X86 algorithms are ordinary Go emitted into the generated backend package.
# The checked-in x86-64 production encoder is projected directly from these
# typed algorithms. Target composition remains declarative below.
go backend {
	func nativeAppend32(out []byte, value int) []byte {
		out = append(out, byte(value), byte(value>>8), byte(value>>16), byte(value>>24))
		return out
	}

	func nativeAppend16(out []byte, value int) []byte {
		return append(out, byte(value), byte(value>>8))
	}

	func nativeAppend64(out []byte, value int) []byte {
		out = nativeAppend32(out, value)
		out = nativeAppend32(out, value>>32)
		return out
	}

	func nativeELFExecutable64(a *RTGEmitter, machine int, flags int, codeOffset int) []byte {
		code := a.Code()
		data := a.Data()
		fileSize := codeOffset + len(code) + len(data)
		bssOffset := RTGAlignValue(fileSize, 4096)
		var out []byte
		out = append(out, 0x7f, 'E', 'L', 'F', 2, 1, 1, 0)
		for len(out) < 16 {
			out = append(out, 0)
		}
		out = nativeAppend16(out, 3)
		out = nativeAppend16(out, machine)
		out = nativeAppend32(out, 1)
		out = nativeAppend64(out, codeOffset)
		out = nativeAppend64(out, 64)
		out = nativeAppend64(out, 0)
		out = nativeAppend32(out, flags)
		out = nativeAppend16(out, 64)
		out = nativeAppend16(out, 56)
		out = nativeAppend16(out, 2)
		out = nativeAppend16(out, 0)
		out = nativeAppend16(out, 0)
		out = nativeAppend16(out, 0)
		out = nativeAppend32(out, 1)
		out = nativeAppend32(out, 5)
		out = nativeAppend64(out, 0)
		out = nativeAppend64(out, 0)
		out = nativeAppend64(out, 0)
		out = nativeAppend64(out, fileSize)
		out = nativeAppend64(out, fileSize)
		out = nativeAppend64(out, 4096)
		out = nativeAppend32(out, 1)
		out = nativeAppend32(out, 6)
		out = nativeAppend64(out, bssOffset)
		out = nativeAppend64(out, bssOffset)
		out = nativeAppend64(out, bssOffset)
		out = nativeAppend64(out, 0)
		out = nativeAppend64(out, a.BSSSize())
		out = nativeAppend64(out, 4096)
		out = append(out, code...)
		out = append(out, data...)
		return out
	}

	func nativeELFExecutable32(a *RTGEmitter, machine int, flags int, codeOffset int) []byte {
		code := a.Code()
		data := a.Data()
		fileSize := codeOffset + len(code) + len(data)
		bssOffset := RTGAlignValue(fileSize, 4096)
		var out []byte
		out = append(out, 0x7f, 'E', 'L', 'F', 1, 1, 1, 0)
		for len(out) < 16 {
			out = append(out, 0)
		}
		out = nativeAppend16(out, 3)
		out = nativeAppend16(out, machine)
		out = nativeAppend32(out, 1)
		out = nativeAppend32(out, codeOffset)
		out = nativeAppend32(out, 52)
		out = nativeAppend32(out, 0)
		out = nativeAppend32(out, flags)
		out = nativeAppend16(out, 52)
		out = nativeAppend16(out, 32)
		out = nativeAppend16(out, 2)
		out = nativeAppend16(out, 0)
		out = nativeAppend16(out, 0)
		out = nativeAppend16(out, 0)
		out = nativeAppend32(out, 1)
		out = nativeAppend32(out, 0)
		out = nativeAppend32(out, 0)
		out = nativeAppend32(out, 0)
		out = nativeAppend32(out, fileSize)
		out = nativeAppend32(out, fileSize)
		out = nativeAppend32(out, 5)
		out = nativeAppend32(out, 4096)
		out = nativeAppend32(out, 1)
		out = nativeAppend32(out, bssOffset)
		out = nativeAppend32(out, bssOffset)
		out = nativeAppend32(out, bssOffset)
		out = nativeAppend32(out, 0)
		out = nativeAppend32(out, a.BSSSize())
		out = nativeAppend32(out, 6)
		out = nativeAppend32(out, 4096)
		out = append(out, code...)
		out = append(out, data...)
		return out
	}







	func x86KernelStaticCall(out *RTGEmitter, importID int, wordCount int) {
		registers := []RTGRegister{
			{Code: 7, Valid: true},
			{Code: 6, Valid: true},
			{Code: 2, Valid: true},
			{Code: 1, Valid: true},
			{Code: 8, Valid: true},
			{Code: 9, Valid: true},
		}
		for i := 0; i < wordCount && i < len(registers); i++ {
			x86OpcodeRegister(out, 0x58, registers[i])
		}
		out.Byte(0xe8)
		at := out.Len()
		out.Int32(0)
		out.AbsoluteReloc(at, importID, RTGRelocationImport)
	}

	func x86KernelRuntimeOperation(out *RTGEmitter, operation int) bool {
		if operation != RTGRuntimeWrite {
			return false
		}
		rax := RTGRegister{Code: 0, Valid: true}
		rsi := RTGRegister{Code: 6, Valid: true}
		rdi := RTGRegister{Code: 7, Valid: true}
		rdx := RTGRegister{Code: 2, Valid: true}
		x86RRRM(out, 0x89, rax, rsi, 64)
		x86RRRM(out, 0x89, rsi, rdx, 64)
		x86RRRM(out, 0x89, rdx, rax, 64)
		data := out.Data()
		formatOffset := len(data)
		data = append(data, '%', '.', '*', 's', 0)
		out.SetData(data)
		x86RMR(out, 0x8d, rdi, RTGAddress{
			Kind: 1, Addend: formatOffset,
		}, 64)
		x86MoveImmediate(out, rax, 0)
		importID := out.ExternalImport("_printk")
		out.Byte(0xe8)
		at := out.Len()
		out.Int32(0)
		out.AbsoluteReloc(at, importID, RTGRelocationImport)
		return true
	}

	func nativePut32(out []byte, at int, value int) {
		out[at] = byte(value)
		out[at+1] = byte(value >> 8)
		out[at+2] = byte(value >> 16)
		out[at+3] = byte(value >> 24)
	}

	func x86KernelGet32(data []byte, at int) int {
		if at < 0 || at+4 > len(data) {
			return 0
		}
		value := int(data[at])
		value |= int(data[at+1]) << 8
		value |= int(data[at+2]) << 16
		value |= int(data[at+3]) << 24
		return value
	}

	func x86KernelBTFString(data []byte, base int, offset int, value string) bool {
		position := base + offset
		if offset < 0 || position < 0 || position+len(value) >= len(data) {
			return false
		}
		for i := 0; i < len(value); i++ {
			if data[position+i] != value[i] {
				return false
			}
		}
		return data[position+len(value)] == 0
	}

	type x86KernelModuleLayout struct {
		size int
		nameOffset int
		initOffset int
		exitOffset int
		ok bool
	}

	func x86KernelBTFModuleLayout(data []byte) x86KernelModuleLayout {
		var result x86KernelModuleLayout
		if len(data) < 24 || data[0] != 0x9f || data[1] != 0xeb {
			return result
		}
		headerLength := x86KernelGet32(data, 4)
		typeStart := headerLength + x86KernelGet32(data, 8)
		typeEnd := typeStart + x86KernelGet32(data, 12)
		stringStart := headerLength + x86KernelGet32(data, 16)
		if headerLength < 24 || typeStart < headerLength ||
			typeEnd > len(data) || stringStart < headerLength ||
			stringStart >= len(data) {
			return result
		}
		position := typeStart
		for position+12 <= typeEnd {
			name := x86KernelGet32(data, position)
			info := x86KernelGet32(data, position+4)
			size := x86KernelGet32(data, position+8)
			kind := (info >> 24) & 31
			count := info & 65535
			extra := 0
			if kind == 1 {
				extra = 4
			} else if kind == 3 {
				extra = 12
			} else if kind == 4 || kind == 5 {
				extra = count * 12
			} else if kind == 6 || kind == 13 {
				extra = count * 8
			} else if kind == 14 || kind == 17 {
				extra = 4
			} else if kind == 15 || kind == 19 {
				extra = count * 12
			}
			next := position + 12 + extra
			if next > typeEnd || next <= position {
				return result
			}
			if kind == 4 &&
				x86KernelBTFString(data, stringStart, name, "module") {
				nameOffset := -1
				initOffset := -1
				exitOffset := -1
				member := position + 12
				for i := 0; i < count; i++ {
					memberName := x86KernelGet32(data, member)
					bitOffset := x86KernelGet32(data, member+8) & 0x00ffffff
					if bitOffset%8 == 0 {
						if x86KernelBTFString(
							data, stringStart, memberName, "name",
						) {
							nameOffset = bitOffset / 8
						} else if x86KernelBTFString(
							data, stringStart, memberName, "init",
						) {
							initOffset = bitOffset / 8
						} else if x86KernelBTFString(
							data, stringStart, memberName, "exit",
						) {
							exitOffset = bitOffset / 8
						}
					}
					member += 12
				}
				result.size = size
				result.nameOffset = nameOffset
				result.initOffset = initOffset
				result.exitOffset = exitOffset
				result.ok = nameOffset >= 0 && initOffset >= 0
				return result
			}
			position = next
		}
		return result
	}

	func x86KernelHexDigit(ch byte) int {
		if ch >= '0' && ch <= '9' {
			return int(ch - '0')
		}
		if ch >= 'a' && ch <= 'f' {
			return int(ch-'a') + 10
		}
		if ch >= 'A' && ch <= 'F' {
			return int(ch-'A') + 10
		}
		return -1
	}

	func x86KernelSymbolCRC(data []byte, symbol string) (int, bool) {
		line := 0
		for line < len(data) {
			end := line
			for end < len(data) && data[end] != '\n' {
				end++
			}
			firstTab := line
			for firstTab < end && data[firstTab] != '\t' {
				firstTab++
			}
			secondTab := firstTab + 1
			for secondTab < end && data[secondTab] != '\t' {
				secondTab++
			}
			if secondTab-firstTab-1 == len(symbol) {
				match := true
				for i := 0; i < len(symbol); i++ {
					if data[firstTab+1+i] != symbol[i] {
						match = false
					}
				}
				if match {
					value := 0
					start := line
					if start+2 <= firstTab &&
						data[start] == '0' && data[start+1] == 'x' {
						start += 2
					}
					for i := start; i < firstTab; i++ {
						digit := x86KernelHexDigit(data[i])
						if digit < 0 {
							return 0, false
						}
						value = value<<4 | digit
					}
					return value, true
				}
			}
			line = end + 1
		}
		return 0, false
	}

	func x86KernelSymbolGPLOnly(data []byte, symbol string) bool {
		line := 0
		for line < len(data) {
			end := line
			for end < len(data) && data[end] != '\n' {
				end++
			}
			firstTab := line
			for firstTab < end && data[firstTab] != '\t' {
				firstTab++
			}
			secondTab := firstTab + 1
			for secondTab < end && data[secondTab] != '\t' {
				secondTab++
			}
			if secondTab-firstTab-1 == len(symbol) {
				match := true
				for i := 0; i < len(symbol); i++ {
					if data[firstTab+1+i] != symbol[i] {
						match = false
					}
				}
				if match {
					thirdTab := secondTab + 1
					for thirdTab < end && data[thirdTab] != '\t' {
						thirdTab++
					}
					exportStart := thirdTab + 1
					exportEnd := exportStart
					for exportEnd < end && data[exportEnd] != '\t' {
						exportEnd++
					}
					if exportEnd-exportStart < 4 {
						return false
					}
					if data[exportEnd-4] != '_' || data[exportEnd-3] != 'G' {
						return false
					}
					return data[exportEnd-2] == 'P' && data[exportEnd-1] == 'L'
				}
			}
			line = end + 1
		}
		return false
	}

	func x86KernelLicenseGPLCompatible(license string) bool {
		if license == "GPL" || license == "GPL v2" {
			return true
		}
		if license == "GPL and additional rights" ||
			license == "Dual BSD/GPL" {
			return true
		}
		return license == "Dual MIT/GPL" || license == "Dual MPL/GPL"
	}

	func x86KernelContains(text string, needle string) bool {
		if len(needle) == 0 || len(needle) > len(text) {
			return false
		}
		for i := 0; i+len(needle) <= len(text); i++ {
			match := true
			for j := 0; j < len(needle); j++ {
				if text[i+j] != needle[j] {
					match = false
				}
			}
			if match {
				return true
			}
		}
		return false
	}

	func x86KernelVermagic(
		release string, version string, exitOffset int, symvers []byte,
	) string {
		out := release
		if x86KernelContains(version, " SMP ") ||
			x86KernelContains(version, " SMP") {
			out += " SMP"
		}
		if x86KernelContains(version, "PREEMPT") {
			out += " preempt"
		}
		if exitOffset >= 0 {
			out += " mod_unload"
		}
		crc, ok := x86KernelSymbolCRC(symvers, "module_layout")
		if ok && crc != 0 {
			out += " modversions"
		}
		return out + " "
	}

	func x86KernelAppendString(out []byte, value string) []byte {
		for i := 0; i < len(value); i++ {
			out = append(out, value[i])
		}
		return append(out, 0)
	}



	func x86KernelUntil(out []byte, size int) []byte {
		for len(out) < size {
			out = append(out, 0)
		}
		return out
	}





	func x86KernelAppendVersion(out []byte, symbol string, crc int) []byte {
		start := len(out)
		out = nativeAppend64(out, crc)
		for i := 0; i < len(symbol) && i < 55; i++ {
			out = append(out, symbol[i])
		}
		out = append(out, 0)
		return x86KernelUntil(out, start+64)
	}





	func x86KernelModuleImage(
		emitter *RTGEmitter, initLabel RTGLabel, exitLabel RTGLabel,
	) []byte {
		initPosition := emitter.LabelPosition(RTGLabelIndex(initLabel))
		exitPosition := emitter.LabelPosition(RTGLabelIndex(exitLabel))
		layout := x86KernelBTFModuleLayout(emitter.KernelBTF())
		if initPosition < 0 || !layout.ok || layout.size <= 0 {
			return nil
		}
		moduleName := emitter.KernelModuleName()
		license := emitter.KernelLicense()
		symvers := emitter.KernelSymvers()
		if moduleName == "" || license == "" || len(symvers) == 0 {
			return nil
		}

		var strings []byte
		strings = append(strings, 0)
		initName := len(strings)
		strings = x86KernelAppendString(strings, "init_module")
		exitName := len(strings)
		strings = x86KernelAppendString(strings, "cleanup_module")
		moduleSymbolName := len(strings)
		strings = x86KernelAppendString(strings, "__this_module")
		var importNames []int
		for i := 0; i < emitter.ExternalImportCount(); i++ {
			importNames = append(importNames, len(strings))
			strings = x86KernelAppendString(
				strings, emitter.ExternalImportName(i),
			)
		}

		var symbols []byte
		symbols = x86KernelAppendSymbol(symbols, 0, 0, 0, 0, 0)
		symbols = x86KernelAppendSymbol(symbols, 0, 3, 1, 0, 0)
		symbols = x86KernelAppendSymbol(symbols, 0, 3, 3, 0, 0)
		symbols = x86KernelAppendSymbol(symbols, 0, 3, 4, 0, 0)
		symbols = x86KernelAppendSymbol(symbols, 0, 3, 7, 0, 0)
		initSymbol := 5
		symbols = x86KernelAppendSymbol(
			symbols, initName, 18, 1, initPosition, 0,
		)
		exitSymbol := 0
		if exitPosition >= 0 {
			exitSymbol = len(symbols) / 24
			symbols = x86KernelAppendSymbol(
				symbols, exitName, 18, 1, exitPosition, 0,
			)
		}
		symbols = x86KernelAppendSymbol(
			symbols, moduleSymbolName, 17, 7, 0, layout.size,
		)
		var importSymbols []int
		for i := 0; i < len(importNames); i++ {
			importSymbols = append(importSymbols, len(symbols)/24)
			symbols = x86KernelAppendSymbol(
				symbols, importNames[i], 16, 0, 0, 0,
			)
		}

		var textRelocations []byte
		for i := 0; i < emitter.AbsoluteRelocationCount(); i++ {
			at := emitter.AbsoluteRelocationOffset(i)
			addend := emitter.AbsoluteRelocationAddend(i)
			kind := emitter.AbsoluteRelocationKind(i)
			if kind == RTGRelocationAbsoluteBSS {
				textRelocations = x86KernelAppendRelocation(
					textRelocations, at, 3, 2, addend-4,
				)
			} else if kind == RTGRelocationImport {
				if addend < 0 || addend >= len(importSymbols) {
					return nil
				}
				textRelocations = x86KernelAppendRelocation(
					textRelocations, at, importSymbols[addend], 4, -4,
				)
			} else {
				textRelocations = x86KernelAppendRelocation(
					textRelocations, at, 2, 2, addend-4,
				)
			}
		}

		thisModule := make([]byte, layout.size)
		if layout.nameOffset+len(moduleName) >= len(thisModule) {
			return nil
		}
		for i := 0; i < len(moduleName); i++ {
			thisModule[layout.nameOffset+i] = moduleName[i]
		}
		var moduleRelocations []byte
		moduleRelocations = x86KernelAppendRelocation(
			moduleRelocations, layout.initOffset, initSymbol, 1, 0,
		)
		if exitSymbol != 0 && layout.exitOffset >= 0 {
			moduleRelocations = x86KernelAppendRelocation(
				moduleRelocations, layout.exitOffset, exitSymbol, 1, 0,
			)
		}

		var versions []byte
		moduleCRC, moduleOK := x86KernelSymbolCRC(
			symvers, "module_layout",
		)
		if moduleOK && moduleCRC != 0 {
			versions = x86KernelAppendVersion(
				versions, "module_layout", moduleCRC,
			)
		}
		for i := 0; i < len(importSymbols); i++ {
			name := emitter.ExternalImportName(i)
			if x86KernelSymbolGPLOnly(symvers, name) &&
				!x86KernelLicenseGPLCompatible(license) {
				return nil
			}
			crc, ok := x86KernelSymbolCRC(symvers, name)
			if !ok {
				return nil
			}
			if crc != 0 {
				versions = x86KernelAppendVersion(versions, name, crc)
			}
		}

		var moduleInfo []byte
		moduleInfo = x86KernelAppendString(
			moduleInfo, "license="+license,
		)
		moduleInfo = x86KernelAppendString(moduleInfo, "depends=")
		moduleInfo = x86KernelAppendString(
			moduleInfo, "name="+moduleName,
		)
		moduleInfo = x86KernelAppendString(
			moduleInfo,
			"vermagic="+x86KernelVermagic(
				emitter.KernelRelease(), emitter.KernelVersion(),
				layout.exitOffset, symvers,
			),
		)

		var sectionNames []byte
		sectionNames = append(sectionNames, 0)
		textName := len(sectionNames)
		sectionNames = x86KernelAppendString(sectionNames, ".text")
		textRelocationName := len(sectionNames)
		sectionNames = x86KernelAppendString(sectionNames, ".rela.text")
		dataName := len(sectionNames)
		sectionNames = x86KernelAppendString(sectionNames, ".rodata")
		bssName := len(sectionNames)
		sectionNames = x86KernelAppendString(sectionNames, ".bss")
		infoName := len(sectionNames)
		sectionNames = x86KernelAppendString(sectionNames, ".modinfo")
		versionName := len(sectionNames)
		sectionNames = x86KernelAppendString(sectionNames, "__versions")
		moduleNameSection := len(sectionNames)
		sectionNames = x86KernelAppendString(
			sectionNames, ".gnu.linkonce.this_module",
		)
		moduleRelocationName := len(sectionNames)
		sectionNames = x86KernelAppendString(
			sectionNames, ".rela.gnu.linkonce.this_module",
		)
		symbolName := len(sectionNames)
		sectionNames = x86KernelAppendString(sectionNames, ".symtab")
		stringName := len(sectionNames)
		sectionNames = x86KernelAppendString(sectionNames, ".strtab")
		sectionStringName := len(sectionNames)
		sectionNames = x86KernelAppendString(sectionNames, ".shstrtab")

		code := emitter.Code()
		data := emitter.Data()
		var image []byte
		image = x86KernelUntil(image, 64)
		textOffset := RTGAlignValue(len(image), 16)
		image = x86KernelUntil(image, textOffset)
		image = append(image, code...)
		textRelocationOffset := RTGAlignValue(len(image), 8)
		image = x86KernelUntil(image, textRelocationOffset)
		image = append(image, textRelocations...)
		dataOffset := RTGAlignValue(len(image), 8)
		image = x86KernelUntil(image, dataOffset)
		image = append(image, data...)
		bssOffset := len(image)
		infoOffset := len(image)
		image = append(image, moduleInfo...)
		versionOffset := RTGAlignValue(len(image), 8)
		image = x86KernelUntil(image, versionOffset)
		image = append(image, versions...)
		moduleOffset := RTGAlignValue(len(image), 64)
		image = x86KernelUntil(image, moduleOffset)
		image = append(image, thisModule...)
		moduleRelocationOffset := RTGAlignValue(len(image), 8)
		image = x86KernelUntil(image, moduleRelocationOffset)
		image = append(image, moduleRelocations...)
		symbolOffset := RTGAlignValue(len(image), 8)
		image = x86KernelUntil(image, symbolOffset)
		image = append(image, symbols...)
		stringOffset := len(image)
		image = append(image, strings...)
		sectionStringOffset := len(image)
		image = append(image, sectionNames...)
		sectionOffset := RTGAlignValue(len(image), 8)
		image = x86KernelUntil(image, sectionOffset)
		image = x86KernelAppendSection(image, 0, 0, 0, 0, 0, 0, 0, 0, 0)
		image = x86KernelAppendSection(
			image, textName, 1, 6, textOffset, len(code), 0, 0, 16, 0,
		)
		image = x86KernelAppendSection(
			image, textRelocationName, 4, 64, textRelocationOffset,
			len(textRelocations), 9, 1, 8, 24,
		)
		image = x86KernelAppendSection(
			image, dataName, 1, 2, dataOffset, len(data), 0, 0, 8, 0,
		)
		image = x86KernelAppendSection(
			image, bssName, 8, 3, bssOffset, emitter.BSSSize(),
			0, 0, 8, 0,
		)
		image = x86KernelAppendSection(
			image, infoName, 1, 2, infoOffset, len(moduleInfo),
			0, 0, 1, 0,
		)
		image = x86KernelAppendSection(
			image, versionName, 1, 2, versionOffset, len(versions),
			0, 0, 8, 0,
		)
		image = x86KernelAppendSection(
			image, moduleNameSection, 1, 3, moduleOffset,
			len(thisModule), 0, 0, 64, 0,
		)
		image = x86KernelAppendSection(
			image, moduleRelocationName, 4, 64, moduleRelocationOffset,
			len(moduleRelocations), 9, 7, 8, 24,
		)
		image = x86KernelAppendSection(
			image, symbolName, 2, 0, symbolOffset, len(symbols),
			10, 5, 8, 24,
		)
		image = x86KernelAppendSection(
			image, stringName, 3, 0, stringOffset, len(strings),
			0, 0, 1, 0,
		)
		image = x86KernelAppendSection(
			image, sectionStringName, 3, 0, sectionStringOffset,
			len(sectionNames), 0, 0, 1, 0,
		)
		var header []byte
		header = x86KernelAppendELFHeader(header, sectionOffset, 12, 11)
		for i := 0; i < len(header); i++ {
			image[i] = header[i]
		}
		return image
	}

