		aarch64MachImage(out:emitter) -> bytes {
			let imports = aarch64MachPrepareImports(out)
			let dataFileOff = RTGAlignValue(aarch64MachCodeOffset+out.Len(),aarch64MachPageSize)
			let bind = aarch64MachBuildBindData(out,imports.got)
			let symtab = aarch64MachBuildSymbolTable(out)
			let strtab = aarch64MachBuildStringTable(out)
			let undefinedCount = out.DynamicImportCount()
			let textFileSize = dataFileOff
			let dataFileSize = len(out.Data())
			let dataVMSize = RTGAlignValue(dataFileSize+out.BSSSize(),aarch64MachPageSize)
			let linkeditOff = dataFileOff+dataFileSize
			let bindOff = linkeditOff
			let symOff = RTGAlignValue(bindOff+len(bind),8)
			let strOff = symOff+len(symtab)
			let sigOff = RTGAlignValue(strOff+len(strtab),16)
			let sigSize = aarch64MachCodeSignatureSize(sigOff,"renvo")
			let linkeditSize = sigOff+sigSize-linkeditOff
			let image = aarch64MachHeader(out,textFileSize,dataFileOff,dataFileSize,dataVMSize,linkeditOff,linkeditSize,bindOff,len(bind),symOff,1+undefinedCount,strOff,len(strtab),undefinedCount,sigOff,sigSize,)
			set image = append(image,out.Code()...)
			set image = aarch64MachAppendUntil(image,dataFileOff)
			set image = append(image,out.Data()...)
			set image = aarch64MachAppendUntil(image,bindOff)
			set image = append(image,bind...)
			set image = aarch64MachAppendUntil(image,symOff)
			set image = append(image,symtab...)
			set image = append(image,strtab...)
			set image = aarch64MachAppendUntil(image,sigOff)
			let signature = aarch64MachCodeSignature(image,"renvo",textFileSize)
			return append(image,signature...)
