go compiler {
	func renvoAmd64CompilerSliceBackingSize(a *renvoAsm, elemSize int) int {
		backingSize := 0
		if renvoFixedTarget != 0 {
			count := 4096
			if elemSize == 1 {
				count = 65536
			}
			backingSize = elemSize * count
			if backingSize < 8192 {
				backingSize = 8192
			}
			if backingSize > 65536 {
				backingSize = 65536
			}
			if backingSize < elemSize {
				backingSize = elemSize
			}
		} else {
			backingSize = elemSize * 8192
			if backingSize < 4096 {
				backingSize = 4096
			}
			if backingSize > 65536 {
				backingSize = 65536
			}
		}
		return backingSize
	}
}

