go compiler {
	func renvoAmd64CompilerCompoundLocalAssign(g *renvoLinearGen, ep *renvoExprParse, idx int, offset int, tok int, op byte, kind int, size int) int {
		if kind != renvoTypeInt {
			return -1
		}
		memoryOp := 0
		if op == '+' {
			memoryOp = 0x0148
		} else if op == '-' {
			memoryOp = 0x2948
		} else if op == '&' {
			memoryOp = 0x2148
		} else if op == '|' {
			memoryOp = 0x0948
		} else if op == '^' {
			memoryOp = 0x3148
		} else {
			return -1
		}
		// An authored call can change the target through an alias. Preserve its
		// original value before evaluating that operand in ordinary lowering.
		if !renvoStringCompareOperandIsReadOnly(g, ep, idx) {
			return -1
		}
		if !renvoEmitScalarExprForKind(g, ep, idx, kind) {
			return 0
		}
		renvoAmd64AsmStackMem(&g.asm, offset, memoryOp, 0x45, 0x85)
		return 1
	}
}

