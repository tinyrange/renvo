		}
		renvoAsmEmit8(&g.asm, 0xe8)
		relocationAt := len(g.asm.code)
		renvoAsmEmit32(&g.asm, 0)
		renvoAsmAddAbsReloc(&g.asm, relocationAt, externalID, renvoImportReloc)
		return true
	}
}

