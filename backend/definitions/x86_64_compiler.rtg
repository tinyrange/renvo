# Adapter for the private legacy emitter protocol; semantic IDs are not opcodes.
go compiler {
	func renvoAmd64CompilerLegacyCondition(condition int) int {
		if condition == renvoConditionEqual {
			return 0x94
		}
		if condition == renvoConditionNotEqual {
			return 0x95
		}
		if condition == renvoConditionSignedLess {
			return 0x9c
		}
		if condition == renvoConditionSignedGreaterEqual {
			return 0x9d
		}
		if condition == renvoConditionSignedLessEqual {
			return 0x9e
		}
		if condition == renvoConditionSignedGreater {
			return 0x9f
		}
		if condition == renvoConditionUnsignedLess {
			return 0x92
		}
		if condition == renvoConditionUnsignedGreaterEqual {
			return 0x93
		}
		if condition == renvoConditionUnsignedLessEqual {
			return 0x96
		}
		if condition == renvoConditionUnsignedGreater {
			return 0x97
		}
		return 0
	}
}

go compiler {
	func renvoAmd64CompilerCompareSet(a *renvoAsm, condition int) {
		renvoAmd64CompilerCmpTertiaryPrimarySet(a, renvoAmd64CompilerLegacyCondition(condition))
	}
}

go compiler {
	func renvoAmd64CompilerCompareJump(a *renvoAsm, condition int, label int) {
		renvoAmd64CompilerCmpTertiaryPrimaryJump(a, renvoAmd64CompilerLegacyCondition(condition), label)
	}
}

go compiler {
	func renvoAmd64CompilerCompareStackStackJump(a *renvoAsm, left int, right int, label int, condition int) {
		renvoAmd64CompilerJcmpStackStack(a, left, right, label, renvoAmd64CompilerLegacyCondition(condition))
	}
}

go compiler {
	func renvoAmd64CompilerCompareStackImmediateJump(a *renvoAsm, offset int, value int, label int, condition int) {
		renvoAmd64CompilerJcmpStackImm(a, offset, value, label, renvoAmd64CompilerLegacyCondition(condition))
	}
}

go compiler {
	func renvoAmd64CompilerConditionBranch(a *renvoAsm, condition int, label int) {
		cond := renvoAmd64CompilerLegacyCondition(condition) - 0x10
		renvoAsmEmit2(a, 0x0f, cond)
		at := len(a.code)
		renvoAsmEmit32(a, 0)
		renvoAsmAddReloc(a, at, label)
	}
}

go compiler {
	func renvoAmd64CompilerCompactCValueHelpers(c *renvoCompileContext) bool {
		return false
	}
}

go compiler {
	func renvoAmd64CompilerStaticCallPolicy(c *renvoCompileContext) int {
		if targetIsKernelModule(c) || c.renvoTargetOS == renvoOSWindows {
			return renvoStaticCallWords
		}
		return renvoStaticCallUnavailable
	}
}

go compiler {
	func renvoAmd64CompilerFinishStaticCallShape(a *renvoAsm, integerCount int, floatCount int, allInteger bool, resultRegister int, resultKind int) bool {
		return false
	}
}

go compiler {
	func renvoAmd64CompilerLinkedStaticImport(a *renvoAsm, libraryStart int, libraryEnd int, nameStart int, nameEnd int, src []byte) int {
		if targetIsKernelModule(a.c) {
			return renvoAsmAddKernelImport(a, src, nameStart, nameEnd)
		}
		if a.c.renvoTargetOS != renvoOSWindows {
			return -1
		}
		return renvoAsmAddWinStaticImport(a, libraryStart, libraryEnd, nameStart, nameEnd, src)
	}
}

go compiler {
	func renvoAmd64CompilerStaticCallBinding(c *renvoCompileContext, src []byte, libraryStart int, libraryEnd int) int {
		if targetIsKernelModule(c) {
			if renvoBytesEqualText(src, libraryStart, libraryEnd, "kernel") {
				return 1
			}
			return 0
		}
		if c.renvoTargetOS == renvoOSWindows && libraryStart < libraryEnd && renvo_runtime_UnsafeByteAt(src, libraryStart) != '/' {
			return 1
		}
		return -1
	}
}

go compiler {
	func renvoAmd64CompilerFileOffsetSentinel(c *renvoCompileContext) bool {
		return c.renvoTargetOS == renvoOSWindows
	}
}

go compiler {
	func renvoAmd64CompilerOpenFlag(c *renvoCompileContext, flag int) int {
		if flag == renvoOpenReadOnly {
			return 0
		}
		if flag == renvoOpenWriteOnly {
			return 1
		}
		if flag == renvoOpenReadWrite {
			return 2
		}
		if targetIsDarwin(c.renvoTargetOS) || targetIsBSD(c.renvoTargetOS) {
			if flag == renvoOpenCreate {
				return 512
			}
			if flag == renvoOpenTruncate {
				return 1024
			}
		}
		if flag == renvoOpenCreate {
			return 64
		}
		if flag == renvoOpenTruncate {
			return 512
		}
		return -1
	}
}

go compiler {
	func renvoAmd64CompilerJITCallSupported(c *renvoCompileContext) bool {
		return true
	}
}

go compiler {
	func renvoAmd64CompilerSyscallArgumentPolicy(c *renvoCompileContext) int {
		if targetIsDarwin(c.renvoTargetOS) {
			return 3
		}
		if c.renvoTargetOS == renvoOSOpenBSD {
			return 2
		}
		return 1
	}
}

go compiler {
	func renvoAmd64CompilerProfileFloatModel(c *renvoCompileContext) int {
		return renvoFloatIEEEHardware
	}
}

go compiler {
	func renvoAmd64CompilerReplGlobalsSupported(c *renvoCompileContext) bool {
		return true
	}
}
