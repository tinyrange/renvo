		renvoAsmPushStringRegs(a)
		renvoAsmLoadPrimarySecondaryStack(a, right, rightLength)
		renvoAsmCopySecondaryToTertiary(a)
		renvoAsmCopyPrimaryToSecondary(a)
		renvoAsmPopCallWord0(a)
		renvoAsmPopCallWord1(a)
	}
}

