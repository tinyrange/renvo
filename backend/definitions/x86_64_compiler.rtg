go compiler {
	func renvoAmd64CompilerLocalWordCompareJump(g *renvoLinearGen, left int, right int, c0 byte, c1 byte, label int, jumpIfTrue bool, unsigned bool, leftKind int, rightKind int, leftSize int, rightSize int) bool {
		if leftKind != renvoTypeInt || rightKind != renvoTypeInt {
			return false
		}
		renvoAsmLoadPrimaryStack(&g.asm, right)
		renvoAsmStackMem(&g.asm, left, 0x3948, 0x45, 0x85)
		renvoEmitCompareJumpOp(&g.asm, c0, c1, label, jumpIfTrue, unsigned)
		return true
	}
}

