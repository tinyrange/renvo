@import "x86_64.rtg"

go backend {
	func elfObjectUntil(out []byte, size int) []byte {
		for len(out) < size {
			out = append(out, 0)
		}
		return out
	}

	func elfObjectString(out []byte, value string) []byte {
		for i := 0; i < len(value); i++ {
			out = append(out, value[i])
		}
		return append(out, 0)
	}

	func elfObjectImage(emitter *RTGEmitter) []byte {
		return emitter.ObjectImage()
		/* The code below is retained as the bootstrap-readable specification of
		   the original minimal layout. ObjectImage implements its generalized
		   Kbuild-compatible successor. */
		/*
			emitter.Patch()
			code := emitter.Code()
			data := emitter.Data()
			exportCount := emitter.SymbolCount()
			importCount := emitter.ExternalImportCount()
			relocationCount := emitter.AbsoluteRelocationCount()

			stringSize := 1
			for i := 0; i < exportCount; i++ {
				stringSize += emitter.SymbolNameLength(i)+1
			}
			for i := 0; i < importCount; i++ {
				stringSize += len(emitter.ExternalImportName(i))+1
			}
			sectionNames := []byte("\x00.text\x00.rela.text\x00.data\x00.bss\x00.symtab\x00.strtab\x00.shstrtab\x00.note.GNU-stack\x00")
			textOffset := 64
			relocationOffset := RTGAlignValue(textOffset+len(code), 8)
			dataOffset := RTGAlignValue(relocationOffset+relocationCount*24, 8)
			bssOffset := dataOffset+len(data)
			symbolOffset := RTGAlignValue(bssOffset, 8)
			symbolSize := (4+exportCount+importCount)*24
			stringOffset := symbolOffset+symbolSize
			sectionStringOffset := stringOffset+stringSize
			sectionOffset := RTGAlignValue(sectionStringOffset+len(sectionNames), 8)

			image := make([]byte, 64)
			image = elfObjectUntil(image, textOffset)
			image = append(image, code...)
			image = elfObjectUntil(image, relocationOffset)
			for i := 0; i < relocationCount; i++ {
				at := emitter.AbsoluteRelocationOffset(i)
				addend := emitter.AbsoluteRelocationAddend(i)
				kind := emitter.AbsoluteRelocationKind(i)
				symbol := 2
				if kind == RTGRelocationAbsoluteBSS {
					symbol = 3
				} else if kind == RTGRelocationAbsoluteBSSEnd {
					symbol = 3
					alignment := addend
					if alignment <= 0 {
						alignment = 1
					}
					addend = RTGAlignValue(emitter.BSSSize(), alignment)
				} else if kind == RTGRelocationImport {
					if addend < 0 || addend >= importCount {
						return nil
					}
					symbol = 4+exportCount+addend
					image = elf_amd64_primitives.kernelAppendRelocation(
						image, at, symbol, 4, -4)
					continue
				} else if kind != RTGRelocationAbsoluteData {
					return nil
				}
				image = elf_amd64_primitives.kernelAppendRelocation(
					image, at, symbol, 2, addend-4)
			}
			image = elfObjectUntil(image, dataOffset)
			image = append(image, data...)
			image = elfObjectUntil(image, symbolOffset)
			image = elf_amd64_primitives.kernelAppendSymbol(image, 0, 0, 0, 0, 0)
			image = elf_amd64_primitives.kernelAppendSymbol(image, 0, 3, 1, 0, 0)
			image = elf_amd64_primitives.kernelAppendSymbol(image, 0, 3, 3, 0, 0)
			image = elf_amd64_primitives.kernelAppendSymbol(image, 0, 3, 4, 0, 0)
			nameOffset := 1
			for i := 0; i < exportCount; i++ {
				position := emitter.SymbolPC(i)
				if position < 0 {
					return nil
				}
				image = elf_amd64_primitives.kernelAppendSymbol(
					image, nameOffset, 18, 1, position, 0)
				nameOffset += emitter.SymbolNameLength(i)+1
			}
			for i := 0; i < importCount; i++ {
				image = elf_amd64_primitives.kernelAppendSymbol(
					image, nameOffset, 16, 0, 0, 0)
				nameOffset += len(emitter.ExternalImportName(i))+1
			}
			image = append(image, 0)
			for i := 0; i < exportCount; i++ {
				for j := 0; j < emitter.SymbolNameLength(i); j++ {
					image = append(image, emitter.SymbolNameByte(i, j))
				}
				image = append(image, 0)
			}
			for i := 0; i < importCount; i++ {
				image = elfObjectString(image, emitter.ExternalImportName(i))
			}
			image = append(image, sectionNames...)
			image = elfObjectUntil(image, sectionOffset)
			image = elf_amd64_primitives.kernelAppendSection(image, 0, 0, 0, 0, 0, 0, 0, 0, 0)
			image = elf_amd64_primitives.kernelAppendSection(
				image, 1, 1, 6, textOffset, len(code), 0, 0, 16, 0)
			image = elf_amd64_primitives.kernelAppendSection(
				image, 7, 4, 64, relocationOffset, relocationCount*24, 5, 1, 8, 24)
			image = elf_amd64_primitives.kernelAppendSection(
				image, 18, 1, 3, dataOffset, len(data), 0, 0, 8, 0)
			image = elf_amd64_primitives.kernelAppendSection(
				image, 24, 8, 3, bssOffset, emitter.BSSSize(), 0, 0, 8, 0)
			image = elf_amd64_primitives.kernelAppendSection(
				image, 29, 2, 0, symbolOffset, symbolSize, 6, 4, 8, 24)
			image = elf_amd64_primitives.kernelAppendSection(
				image, 37, 3, 0, stringOffset, stringSize, 0, 0, 1, 0)
			image = elf_amd64_primitives.kernelAppendSection(
				image, 45, 3, 0, sectionStringOffset, len(sectionNames), 0, 0, 1, 0)
			image = elf_amd64_primitives.kernelAppendSection(
				image, 55, 1, 0, bssOffset, 0, 0, 0, 1, 0)
			header := elf_amd64_primitives.kernelAppendELFHeader(
				[]byte{}, sectionOffset, 9, 7)
			for i := 0; i < len(header); i++ {
				image[i] = header[i]
			}
			return image */
	}
}

format elf64_x86_64 {
	kind = elf
	code_offset = 176
	image = elf_executable
	production_image = elf_executable_symbols
	patch_absolute = relative32_le
	patch_pc_bias = 4
	byte_order = little
	address_bits = 64
	file_alignment = 0x1000
	machine = 62
	flags = 0

	header elf {
		magic = [0x7f, 0x45, 0x4c, 0x46]
		class = 2
		data = 1
		version = 1
		osabi = 0
		type = 3
		machine = 62
		entry = address(text.start)
		program_header_offset = sizeof(elf_header)
		section_header_offset = stripped ? 0 : sections.offset
		flags = 0
		elf_header_size = 64
		program_header_size = 56
		program_header_count = 2
		section_header_size = stripped ? 0 : 64
		section_header_count = stripped ? 0 : sections.count
		section_name_index = stripped ? 0 : sections.names
	}

	segment text {
		type = load
		flags = read | execute
		file = [headers.start, data.file_start)
		emitMemoryOperand = [headers.start, data.memory_start)
		alignment = 0x1000
	}

	segment data {
		type = load
		flags = read | write
		file = [data.file_start, data.file_end)
		emitMemoryOperand = [data.memory_start, bss.end)
		alignment = 0x1000
	}

	sections when !stripped {
		text progbits alloc | execute align = 16
		data progbits alloc | write align = 8
		bss nobits alloc | write align = 8
		symtab symtab entry_size = 24 link = strtab
		strtab strtab
		shstrtab strtab
	}

	relocation {
		label = rel32
		data = rel32
		bss = rel32
	}
}

format elf64_object_x86_64 {
	kind = "elf-relocatable"
	image = go elfObjectImage
	kernel_image = linux_module_elf
	byte_order = little
	address_bits = 64
	machine = 62
	type = relocatable
	append64 = sequence elf_amd64_primitives.nativeAppend64
	append_header = sequence elf_amd64_primitives.kernelAppendELFHeader
	append_relocation = sequence elf_amd64_primitives.kernelAppendRelocation
	append_section = sequence elf_amd64_primitives.kernelAppendSection
	append_symbol = sequence elf_amd64_primitives.kernelAppendSymbol

	sections {
		text progbits alloc | execute align = 16
		rela_text rela entry_size = 24 link = symtab info = text
		data progbits alloc | write align = 8
		bss nobits alloc | write align = 8
		symtab symtab entry_size = 24 link = strtab
		strtab strtab
		shstrtab strtab
	}

	relocation label {
		number = 2
		kind = pc_relative
		width = 32
		addend = -4
	}
	relocation data {
		number = 2
		kind = pc_relative
		width = 32
		addend = -4
	}
	relocation bss {
		number = 2
		kind = pc_relative
		width = 32
		addend = -4
	}
	relocation abs64 {
		number = 1
		kind = absolute
		width = 64
		addend = 0
	}
}
