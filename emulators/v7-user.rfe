	case 48:
		sig := int(a[0])
		if sig <= 0 || sig >= len(p.signals) || sig == 9 {
			p.error(22)
		} else {
			old := p.signals[sig]
			p.signals[sig] = a[1]
			p.posted &^= 1 << uint(sig-1)
			p.result(old)
		}
	case 60:
		old := p.mask
		p.mask = a[0] & 0o777
		p.result(old)
	default:
		p.error(22)
	}
}

// InstallExecutable adds a guest entrypoint without exposing a host path.
func (k *Kernel) InstallExecutable(name string, image []byte) error {
	name = path.Clean("/" + name)
	return k.FS.Add(name, image, 0o100755)
}

-- signals.go --
package v7

import "encoding/binary"

// Virtual time is independent of host speed. Idle waits jump to the next alarm;
// executable blocks are bounded by the next timer deadline.
const TicksPerSecond uint64 = 1_000_000

// PostSignal is called on the kernel's scheduler thread. Cross-thread terminal
// signals enter through Kernel.Signals. V7 coalesces each pending signal bit.
func (k *Kernel) PostSignal(p *Process, sig int) {
	if sig > 0 && sig < len(p.signals) && !p.Exited {
		p.posted |= 1 << uint(sig-1)
	}
}
func (k *Kernel) terminalSignal(p *Process, sig int) {
	for _, q := range k.Processes {
		if q.Group == p.Group {
			k.PostSignal(q, sig)
		}
	}
}
func (k *Kernel) pollSignals(p *Process) {
	for _, q := range k.Processes {
		if !q.Exited && q.alarm != 0 && q.alarm <= k.Ticks {
			q.alarm = 0
			k.PostSignal(q, 14)
		}
	}
	for k.Signals != nil {
		select {
		case sig, ok := <-k.Signals:
			if !ok {
				k.Signals = nil
				return
			}
			k.terminalSignal(p, sig)
		default:
			return
		}
	}
}
func (k *Kernel) nextAlarm() uint64 {
	var next uint64
	for _, q := range k.Processes {
		if !q.Exited && q.alarm > k.Ticks && (next == 0 || q.alarm < next) {
			next = q.alarm
		}
	}
	return next
}
func (k *Kernel) deliver(p *Process) {
	for sig := 1; sig < len(p.signals); sig++ {
		bit := uint32(1) << uint(sig-1)
		if p.posted&bit == 0 {
			continue
		}
		p.posted &^= bit
		handler := p.signals[sig]
		if handler&1 != 0 && sig != 9 {
			continue
		}
		if handler == 0 || sig == 9 {
			// Wait status contains the terminating signal. No core file is emitted,
			// so the core-dumped bit must remain clear.
			k.exit(p, uint16(sig))
			return
		}
		if p.waiting || p.pending != nil || p.paused {
			p.waiting, p.paused, p.pending = false, false, nil
			p.error(4) // EINTR is saved in the return context, before handler entry.
		}
		sp := int(p.CPU.R[6]) - 4
		if sp < p.Memory.Break+64 || sp&1 != 0 || sp < 0 {
			k.exit(p, 11)
			return
		}
		if sp < p.Memory.Stack {
			p.Memory.Stack = sp &^ 63
		}
		b, ok := p.Memory.bytes(uint16(sp), 4, true)
		if !ok {
			k.exit(p, 11)
			return
		}
		binary.LittleEndian.PutUint16(b, p.CPU.R[7])
		binary.LittleEndian.PutUint16(b[2:], p.CPU.PSW)
		p.CPU.R[6], p.CPU.R[7] = uint16(sp), handler
		p.CPU.PSW &^= 0o20
		p.CPU.Trap, p.CPU.Fault = 0, 0
		if sig != 4 && sig != 5 {
			p.signals[sig] = 0
		}
		return
	}
}

type inputResult struct {
	data []byte
	err  error
}

// A host read never pins the guest scheduler. The descriptor owns the pending
// read across fork, dup and EINTR, so an interrupted read cannot steal input
// from its successor. The reader owns no pointers into guest memory.
func (k *Kernel) readInput(d *descriptor, dst []byte) (int, bool) {
	if d.readResult != nil {
		select {
		case result := <-d.readResult:
			d.readData, d.readError, d.readResult = result.data, result.err, nil
		default:
			return 0, false
		}
	}
	if len(d.readData) != 0 {
		n := copy(dst, d.readData)
		d.readData = d.readData[n:]
		return n, true
	}
	if d.readError != nil {
		return 0, true
	}
	d.readResult = make(chan inputResult, 1)
	reader, result, wake := d.input, d.readResult, k.wake
	size := len(dst)
	go func() {
		data := make([]byte, size)
		n, err := reader.Read(data)
		result <- inputResult{data[:n], err}
		select {
		case wake <- struct{}{}:
		default:
		}
	}()
	return 0, false
}
func (k *Kernel) hasInput() bool {
	for _, p := range k.Processes {
		if !p.Exited && p.pending != nil && p.pending.number == 3 {
			if d := p.fd(p.pending.args[0]); d != nil && d.readResult != nil {
				return true
			}
		}
	}
	return false
}

-- signals_test.go --
package v7

import (
	"bytes"
	"encoding/binary"
	"io"
	"renvo.dev/emulators/pdp11"
	"testing"
	"time"
)

func signalProcess(t *testing.T) (*Kernel, *Process) {
	t.Helper()
	k := New(NewFS(), bytes.NewReader(nil), io.Discard, io.Discard)
	p, err := k.Start(aout(0o407, []uint16{0o005000, 0o104401}, make([]byte, 512)), []string{"test"}, nil)
	if err != nil {
		t.Fatal(err)
	}
	return k, p
}
func TestSignalFrameAndDispositions(t *testing.T) {
	for _, sig := range []int{2, 4, 5, 14} {
		k, p := signalProcess(t)
		p.CPU.R[7] = 0o100
		p.CPU.PSW |= 0o20 | pdp11.N
		p.signals[sig] = 0o200
		binary.LittleEndian.PutUint16(p.Memory.Data[0o200:], 2) // RTI trampoline
		pc, psw, sp := p.CPU.R[7], p.CPU.PSW, p.CPU.R[6]
		k.PostSignal(p, sig)
		k.PostSignal(p, sig)
		k.deliver(p)
		if p.Exited || p.CPU.R[6] != sp-4 || p.CPU.R[7] != 0o200 || p.CPU.PSW&0o20 != 0 || p.posted != 0 {
			t.Fatal("signal frame entry")
		}
		gotPC, _ := p.Memory.word(sp-4, true)
		gotPSW, _ := p.Memory.word(sp-2, true)
		if gotPC != pc || gotPSW != psw {
			t.Fatal("saved PC/PSW")
		}
		if (p.signals[sig] == 0) != (sig != 4 && sig != 5) {
			t.Fatal("V7 disposition reset")
		}
		p.CPU.Step()
		if p.CPU.R[7] != pc || p.CPU.R[6] != sp || p.CPU.PSW != psw || p.CPU.Trap != 0 {
			t.Fatal("RTI signal return")
		}
	}
	k, p := signalProcess(t)
	p.signals[2] = 1
	k.PostSignal(p, 2)
	k.deliver(p)
	if p.Exited || p.CPU.R[7] != 0 {
		t.Fatal("ignored signal")
	}
	k.PostSignal(p, 9)
	k.deliver(p)
	if !p.Exited || p.Status != 9 {
		t.Fatal("SIGKILL wait status")
	}
	k, p = signalProcess(t)
	p.CPU.R[6] = uint16(p.Memory.Break)
	p.signals[2] = 0o200
	k.PostSignal(p, 2)
	k.deliver(p)
	if !p.Exited || p.Status != 11 {
		t.Fatal("bad handler stack")
	}
}

func TestAlarmPauseAcrossEngines(t *testing.T) {
	for _, mode := range []string{"interpreter", "ir", "native"} {
		code := []uint16{0o104460, 14, 0, 0o012700, 1, 0o104433, 0o104435, 0o010002, 0o005000, 0o104401}
		code[2] = uint16(len(code) * 2)
		code = append(code, 0o005201, 2) // increment R1 and RTI
		k := New(NewFS(), bytes.NewReader(nil), io.Discard, io.Discard)
		e, err := pdp11.NewEngine(mode)
		if err != nil {
			t.Fatal(err)
		}
		k.Execute = e.Step
		p, err := k.Start(aout(0o407, code, nil), []string{"alarm"}, nil)
		if err != nil {
			t.Fatal(err)
		}
		status, err := k.Run(p)
		e.Close()
		if err != nil || status != 0 || p.CPU.R[1] != 1 || p.CPU.R[2] != 4 || k.Ticks < TicksPerSecond {
			t.Fatalf("%s alarm: status %d err %v R=%v ticks=%d", mode, status, err, p.CPU.R, k.Ticks)
		}
	}
}

func TestInterruptedWaitPipeAndHostRead(t *testing.T) {
	for _, kind := range []string{"wait", "pipe-read", "pipe-write", "host-read"} {
		k, p := signalProcess(t)
		var writer *io.PipeWriter
		switch kind {
		case "wait":
			k.syscall(p, call{number: 2})
			k.syscall(p, call{number: 7})
		case "pipe-read", "pipe-write":
			k.syscall(p, call{number: 42})
			r, w := p.CPU.R[0], p.CPU.R[1]
			if kind == "pipe-read" {
				k.syscall(p, call{number: 3, args: [4]uint16{r, 0o300, 1}})
			} else {
				p.fd(w).pipe.data = make([]byte, 4096)
				k.syscall(p, call{number: 4, args: [4]uint16{w, 0o300, 1}})
			}
		case "host-read":
			reader, w := io.Pipe()
			writer = w
			defer reader.Close()
			defer writer.Close()
			p.files[0].input = reader
			k.syscall(p, call{number: 3, args: [4]uint16{0, 0o300, 1}})
		}
		if !p.waiting && p.pending == nil {
			t.Fatal(kind, "did not block")
		}
		p.signals[2] = 0o200
		p.CPU.R[7] = 0o100
		k.PostSignal(p, 2)
		k.deliver(p)
		if p.waiting || p.pending != nil || p.CPU.R[0] != 4 || p.CPU.PSW&pdp11.C == 0 {
			t.Fatal(kind, "missing EINTR")
		}
		if writer != nil {
			go func() { writer.Write([]byte("X")) }()
			deadline := time.After(time.Second)
			for {
				k.syscall(p, call{number: 3, args: [4]uint16{0, 0o300, 1}})
				if p.pending == nil {
					break
				}
				p.pending = nil
				select {
				case <-k.wake:
				case <-deadline:
					t.Fatal("interrupted host read lost input")
				}
			}
			if p.Memory.Data[0o300] != 'X' || p.CPU.R[0] != 1 {
				t.Fatal("pending descriptor read was not retained")
			}
		}
	}
}

func TestSignalsForkKillAlarmAndPipe(t *testing.T) {
	k, p := signalProcess(t)
	p.signals[2] = 0o200
	k.syscall(p, call{number: 27, args: [4]uint16{3}})
	k.Ticks = TicksPerSecond + 1
	k.syscall(p, call{number: 27})
	if p.CPU.R[0] != 2 || p.alarm != 0 {
		t.Fatal("alarm cancellation/remaining seconds")
	}
	p.alarm = k.Ticks + TicksPerSecond
	p.posted = 1 << 4
	k.syscall(p, call{number: 2})
	child := k.Processes[1]
	if child.alarm != 0 || child.posted != 0 || child.signals[2] != 0o200 || child.Group != p.Group {
		t.Fatal("fork signal inheritance")
	}
	p.posted = 0
	k.syscall(p, call{number: 37, args: [4]uint16{child.PID, 9}})
	k.deliver(child)
	k.wait(p)
	if p.CPU.R[1] != 9 || p.CPU.R[0] != child.PID {
		t.Fatal("kill/wait signal status")
	}
	k.syscall(p, call{number: 37, args: [4]uint16{32000, 0}})
	if p.CPU.R[0] != 3 || p.CPU.PSW&pdp11.C == 0 {
		t.Fatal("kill ESRCH")
	}
	p.signals[13] = 1
	k.syscall(p, call{number: 42})
	r, w := p.CPU.R[0], p.CPU.R[1]
	p.close(r)
	k.syscall(p, call{number: 4, args: [4]uint16{w, 0o300, 1}})
	if p.CPU.R[0] != 32 {
		t.Fatal("EPIPE")
	}
	k.deliver(p)
	if p.Exited {
		t.Fatal("ignored SIGPIPE")
	}
	p.signals[13] = 0
	k.syscall(p, call{number: 4, args: [4]uint16{w, 0o300, 1}})
	k.deliver(p)
	if !p.Exited || p.Status != 13 {
		t.Fatal("SIGPIPE default action")
	}
}

func TestTrapSignalsAndFloatingHandler(t *testing.T) {
	for _, v := range []struct {
		code []uint16
		sig  uint16
	}{
		{[]uint16{0o000007}, 4}, {[]uint16{3}, 5}, {[]uint16{4}, 6}, {[]uint16{0o104000}, 7},
		{[]uint16{0o013700, 1}, 10}, {[]uint16{0o013700, 0o10000}, 11},
		{[]uint16{0o170011, 0o172427, 0x4080, 0o174401}, 8},
	} {
		k := New(NewFS(), bytes.NewReader(nil), io.Discard, io.Discard)
		p, err := k.Start(aout(0o407, v.code, nil), []string{"trap"}, nil)
		if err != nil {
			t.Fatal(err)
		}
		status, err := k.Run(p)
		if err != nil || p.Status != v.sig || status != 128+int(v.sig) {
			t.Fatalf("trap code %o: status %d signal %d err %v", v.code, status, p.Status, err)
		}
	}
	// A real FP exception returns through a guest RTI handler to the next opcode.
	code := []uint16{0o104460, 8, 0, 0o170011, 0o172427, 0x4080, 0o174401, 0o005000, 0o104401}
	code[2] = uint16(len(code) * 2)
	code = append(code, 0o005202, 2)
	k := New(NewFS(), bytes.NewReader(nil), io.Discard, io.Discard)
	p, err := k.Start(aout(0o407, code, nil), []string{"fpe"}, nil)
	if err != nil {
		t.Fatal(err)
	}
	status, err := k.Run(p)
	if err != nil || status != 0 || p.CPU.R[2] != 1 || p.CPU.FEC != 4 {
		t.Fatalf("FP signal handler: %d %v %+v", status, err, p.CPU)
	}
}

func TestSignalExecAndTerminalInput(t *testing.T) {
	k, p := signalProcess(t)
	p.signals[2], p.signals[3] = 0o200, 1
	p.alarm = TicksPerSecond
	p.CPU.FR[0] = 123
	if err := k.InstallExecutable("/next", aout(0o407, []uint16{0o005000, 0o104401}, nil)); err != nil {
		t.Fatal(err)
	}
	copy(p.Memory.Data[0o300:], "/next\x00")
	binary.LittleEndian.PutUint16(p.Memory.Data[0o320:], 0o300)
	binary.LittleEndian.PutUint16(p.Memory.Data[0o322:], 0)
	k.syscall(p, call{number: 11, args: [4]uint16{0o300, 0o320}})
	if p.CPU.PSW&pdp11.C != 0 || p.signals[2] != 0 || p.signals[3] != 1 || p.alarm != TicksPerSecond || p.CPU.FR[0] != 0 {
		t.Fatal("exec signal and FP state")
	}
	// Terminal delivery must wake a blocked scheduler without host input arriving.
	k, p = signalProcess(t)
	reader, writer := io.Pipe()
	defer reader.Close()
	defer writer.Close()
	p.files[0].input = reader
	k.syscall(p, call{number: 3, args: [4]uint16{0, 0o300, 1}})
	signals := make(chan int, 1)
	k.Signals = signals
	signals <- 15
	status, err := k.Run(p)
	if err != nil || status != 143 || p.Status != 15 {
		t.Fatalf("terminal signal during input: %d %v", status, err)
	}
}

-- v7_test.go --
package v7

import (
	"bytes"
	"encoding/binary"
	"io"
	"os"
	"renvo.dev/emulators/pdp11"
	"strings"
	"testing"
)

func aout(magic uint16, code []uint16, data []byte) []byte {
	b := make([]byte, 16+2*len(code)+len(data))
	binary.LittleEndian.PutUint16(b, magic)
	binary.LittleEndian.PutUint16(b[2:], uint16(2*len(code)))
	binary.LittleEndian.PutUint16(b[4:], uint16(len(data)))
	binary.LittleEndian.PutUint16(b[14:], 1)
	for i, w := range code {
		binary.LittleEndian.PutUint16(b[16+i*2:], w)
	}
	copy(b[16+len(code)*2:], data)
	return b
}
func TestAOutAndSyscalls(t *testing.T) {
	for _, magic := range []uint16{0o407, 0o410, 0o411} {
		for _, indirect := range []bool{false, true} {
			pointer := uint16(14)
			if magic == 0o410 {
				pointer = 8192
			}
			if magic == 0o411 {
				pointer = 0
			}
			code := []uint16{0o012700, 1, 0o104404, pointer, 5, 0o005000, 0o104401}
			data := []byte("PASS\n")
			if indirect {
				code = []uint16{0o012700, 1, 0o104400, pointer + 6, 0o005000, 0o104401}
				if magic == 0o407 {
					pointer = 12
					code[3] = pointer + 6
				}
				data = append(data, 0, 0, 0, 0, 0, 0, 0)
				binary.LittleEndian.PutUint16(data[6:], 0o104404)
				binary.LittleEndian.PutUint16(data[8:], pointer)
				binary.LittleEndian.PutUint16(data[10:], 5)
			}
			var out bytes.Buffer
			k := New(NewFS(), strings.NewReader(""), &out, &out)
			p, err := k.Start(aout(magic, code, data), []string{"odd-length-name", "x"}, []string{"X=Y"})
			if err != nil {
				t.Fatal(err)
			}
			status, err := k.Run(p)
			if err != nil || status != 0 || out.String() != "PASS\n" {
				t.Fatalf("magic=%o indirect=%v: status=%d err=%v output=%q", magic, indirect, status, err, out.String())
			}
		}
	}
}
func TestArgumentAlignmentAndSeparateData(t *testing.T) {
	for _, args := range [][]string{{"a"}, {"ab"}, {"abc", "d"}} {
		m, c, err := Load(aout(0o411, []uint16{0o016600, 2, 0o005060, 0o177776, 0o005000, 0o104401}, []byte{42, 43}), args, []string{"X=Y"})
		if err != nil {
			t.Fatal(err)
		}
		p, ok := m.word(c.R[6]+2, true)
		if !ok || p&1 != 0 {
			t.Fatal("unaligned argv[0]")
		}
		s, ok := m.str(p)
		if !ok || s != args[0] {
			t.Fatal("corrupt argument", s)
		}
		if m.Text[0] == m.Data[0] {
			t.Fatal("I/D aliased")
		}
		for i := 0; i < 3; i++ {
			c.Step()
		}
		if c.Trap != 0 {
			t.Fatal("crt0 argument alignment trap")
		}
	}
}
func TestMalformedAOutAndPointers(t *testing.T) {
	for _, b := range [][]byte{nil, make([]byte, 15), aout(0o405, []uint16{0}, nil), aout(0o407, []uint16{0}, nil)[:17]} {
		if _, _, err := Load(b, nil, nil); err == nil {
			t.Fatal("accepted invalid a.out")
		}
	}
	k := New(NewFS(), strings.NewReader("unchanged"), io.Discard, io.Discard)
	p, err := k.Start(aout(0o410, []uint16{0}, nil), []string{"a"}, nil)
	if err != nil {
		t.Fatal(err)
	}
	k.syscall(p, call{number: 3, args: [4]uint16{0, 0, 1}})
	if p.CPU.R[0] != 14 || p.CPU.PSW&pdp11.C == 0 {
		t.Fatal("read into protected text accepted")
	}
	k.syscall(p, call{number: 4, args: [4]uint16{1, 65535, 2}})
	if p.CPU.R[0] != 14 {
		t.Fatal("wrapped buffer accepted")
	}
	k.syscall(p, call{number: 63})
	if p.CPU.R[0] != 22 {
		t.Fatal("unknown syscall pretended to succeed")
	}
}
func TestForkPipeAndWait(t *testing.T) {
	k := New(NewFS(), strings.NewReader(""), io.Discard, io.Discard)
	p, err := k.Start(aout(0o407, []uint16{0}, make([]byte, 64)), []string{"a"}, nil)
	if err != nil {
		t.Fatal(err)
	}
	k.syscall(p, call{number: 42})
	readFD, writeFD := p.CPU.R[0], p.CPU.R[1]
	pc := p.CPU.R[7]
	k.syscall(p, call{number: 2})
	child := k.Processes[1]
	if p.CPU.R[7] != pc+2 || child.CPU.R[7] != pc || child.CPU.R[0] != p.PID {
		t.Fatal("fork return ABI")
	}
	child.Memory.Data[32] = 42
	if p.Memory.Data[32] != 0 {
		t.Fatal("fork memory aliased")
	}
	p.close(writeFD)
	child.close(readFD)
	k.syscall(p, call{number: 3, args: [4]uint16{readFD, 40, 1}})
	if p.pending == nil {
		t.Fatal("empty pipe did not block")
	}
	k.syscall(child, call{number: 4, args: [4]uint16{writeFD, 32, 1}})
	c := *p.pending
	p.pending = nil
	k.syscall(p, c)
	if p.Memory.Data[40] != 42 || p.CPU.R[0] != 1 {
		t.Fatal("pipe read")
	}
	k.exit(child, 7<<8)
	k.wait(p)
	if p.CPU.R[0] != child.PID || p.CPU.R[1] != 7<<8 || child.Memory != nil {
		t.Fatal("wait status or process reclamation")
	}
	k.syscall(p, call{number: 3, args: [4]uint16{readFD, 40, 1}})
	if p.CPU.R[0] != 0 || p.pending != nil {
		t.Fatal("pipe EOF")
	}
}
func TestHistoricalFloatingAndSignals(t *testing.T) {
	image := os.Getenv("RENVO_PDP11_V7_IMAGE")
	if image == "" {
		t.Skip("set RENVO_PDP11_V7_IMAGE for historical FP and signal tests")
	}
	disk, err := os.ReadFile(image)
	if err != nil {
		t.Fatal(err)
	}
	for _, mode := range []string{"interpreter", "ir", "native"} {
		fs := NewFS()
		if err = fs.ImportDisk(disk); err != nil {
			t.Fatal(err)
		}
		e, err := pdp11.NewEngine(mode)
		if err != nil {
			t.Fatal(err)
		}
		var out bytes.Buffer
		k := New(fs, strings.NewReader(""), &out, &out)
		k.Execute = e.Step
		command := `trap 'echo SIGNAL_OK' 2; kill -2 $$; echo AFTER_SIGNAL; sleep 1; echo ALARM_OK; awk 'BEGIN { print 1.5+2.25; print 1.5*2.25; print 2.25/1.5; print sqrt(2); print exp(1); print log(2); exit }'`
		p, err := k.Start(fs.Nodes["/bin/sh"].Data, []string{"sh", "-c", command}, []string{"PATH=/bin:/usr/bin"})
		if err != nil {
			e.Close()
			t.Fatal(err)
		}
		status, err := k.Run(p)
		e.Close()
		want := "SIGNAL_OK\nAFTER_SIGNAL\nALARM_OK\n3.75\n3.375\n1.5\n1.41421\n2.71828\n.693147\n"
		if err != nil || status != 0 || out.String() != want {
			t.Fatalf("%s historical FP/signals: %d %v output %q", mode, status, err, out.String())
		}
	}
}

func TestHistoricalV7Commands(t *testing.T) {
	image := os.Getenv("RENVO_PDP11_V7_IMAGE")
	if image == "" {
		t.Skip("set RENVO_PDP11_V7_IMAGE for historical executable tests")
	}
	disk, err := os.ReadFile(image)
	if err != nil {
		t.Fatal(err)
	}
	for _, mode := range []string{"interpreter", "native"} {
		fs := NewFS()
		if err = fs.ImportDisk(disk); err != nil {
			t.Fatal(err)
		}
		engine, err := pdp11.NewEngine(mode)
		if err != nil {
			t.Fatal(err)
		}
		var out bytes.Buffer
		k := New(fs, strings.NewReader(""), &out, &out)
		k.Execute = engine.Step
		p, err := k.Start(fs.Nodes["/bin/sh"].Data, []string{"sh", "-c", "echo RFE_SHELL_OK; echo pipe | /bin/cat; echo file > /RFE; /bin/cat /RFE; /bin/rm /RFE"}, []string{"PATH=/bin:/usr/bin"})
		if err != nil {
			engine.Close()
			t.Fatal(err)
		}
		status, err := k.Run(p)
		engine.Close()
		if err != nil || status != 0 || out.String() != "RFE_SHELL_OK\npipe\nfile\n" {
			t.Fatalf("%s: status %d err %v output %q", mode, status, err, out.String())
		}
		if fs.Nodes["/RFE"] != nil {
			t.Fatal("guest unlink failed")
		}
		if mode == "native" && engine.Stats.NativeInstructions == 0 {
			t.Fatal("no native guest execution")
		}
	}
}
