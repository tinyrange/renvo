-- disk.go --
package v7

import (
	"encoding/binary"
	"fmt"
	"strings"
)

// ImportDisk reads a V7 filesystem from an RK05 image. Block and inode sizes,
// PDP word-swapped longs, and packed 24-bit addresses are decoded explicitly.
// No disk bytes are modified. Device nodes become virtual personality nodes.
func (f *FS) ImportDisk(disk []byte) error {
	word := func(b []byte) uint32 { return uint32(binary.LittleEndian.Uint16(b)) }
	long := func(b []byte) uint32 { return word(b)<<16 | word(b[2:]) }
	if len(disk) < 1536 || len(disk)%512 != 0 {
		return fmt.Errorf("invalid V7 filesystem image")
	}
	isize := int(word(disk[512:]))
	if isize < 3 || isize*512 > len(disk) {
		return fmt.Errorf("invalid V7 inode area")
	}
	block := func(n uint32) ([]byte, error) {
		if n < uint32(isize) || uint64(n)*512+512 > uint64(len(disk)) {
			return nil, fmt.Errorf("V7 block %d outside image", n)
		}
		return disk[int(n)*512 : int(n)*512+512], nil
	}
	readInode := func(ino uint16) (*Node, error) {
		if ino == 0 || int(ino) > (isize-2)*8 {
			return nil, fmt.Errorf("V7 inode out of range")
		}
		at := 1024 + (int(ino)-1)*64
		b := disk[at : at+64]
		n := &Node{Mode: uint16(word(b)), Links: uint16(word(b[2:])), UID: uint16(word(b[4:])), GID: uint16(word(b[6:])), Inode: ino}
		size := long(b[8:])
		kind := n.Mode & 0o170000
		if kind != 0o100000 && kind != 0o40000 {
			return n, nil
		}
		if uint64(size) > uint64(f.Limit-f.Bytes) {
			return nil, fmt.Errorf("V7 filesystem memory limit")
		}
		addresses := make([]uint32, 13)
		for i := range addresses {
			p := b[12+3*i:]
			addresses[i] = uint32(p[0])<<16 | uint32(p[1]) | uint32(p[2])<<8
		}
		var indirect func(uint32, int, int) (uint32, error)
		indirect = func(root uint32, level, index int) (uint32, error) {
			if root == 0 {
				return 0, nil
			}
			data, err := block(root)
			if err != nil {
				return 0, err
			}
			stride := 1
			for i := 1; i < level; i++ {
				stride *= 128
			}
			slot := index / stride
			if slot >= 128 {
				return 0, fmt.Errorf("V7 indirect index overflow")
			}
			v := long(data[slot*4:])
			if level == 1 {
				return v, nil
			}
			return indirect(v, level-1, index%stride)
		}
		n.Data = make([]byte, int(size))
		for i := 0; i < (int(size)+511)/512; i++ {
			var address uint32
			var err error
			if i < 10 {
				address = addresses[i]
			} else if i < 138 {
				address, err = indirect(addresses[10], 1, i-10)
			} else if i < 16522 {
				address, err = indirect(addresses[11], 2, i-138)
			} else {
				address, err = indirect(addresses[12], 3, i-16522)
			}
			if err != nil {
				return nil, err
			}
			if address != 0 {
				data, err := block(address)
				if err != nil {
					return nil, err
				}
				copy(n.Data[i*512:], data)
			}
		}
		f.Bytes += len(n.Data)
		return n, nil
	}
	seen := map[uint16]*Node{}
	directories := map[uint16]bool{}
	var walk func(uint16, string, int) error
	walk = func(ino uint16, name string, depth int) error {
		if depth > 64 || len(f.Nodes) > 65535 {
			return fmt.Errorf("V7 directory limit")
		}
		n := seen[ino]
		if n == nil {
			var err error
			n, err = readInode(ino)
			if err != nil {
				return err
			}
			seen[ino] = n
		}
		f.Nodes[name] = n
		if ino > f.next {
			f.next = ino
		}
		if n.Mode&0o170000 != 0o40000 {
			return nil
		}
		if directories[ino] {
			return fmt.Errorf("V7 directory cycle")
		}
		directories[ino] = true
		defer delete(directories, ino)
		if len(n.Data)%16 != 0 {
			return fmt.Errorf("invalid V7 directory length")
		}
		for i := 0; i < len(n.Data); i += 16 {
			child := uint16(word(n.Data[i:]))
			if child == 0 {
				continue
			}
			entry := string(n.Data[i+2 : i+16])
			if at := strings.IndexByte(entry, 0); at >= 0 {
				entry = entry[:at]
			}
			if entry == "." || entry == ".." {
				continue
			}
			if entry == "" || strings.Contains(entry, "/") {
				return fmt.Errorf("invalid V7 directory name")
			}
			prefix := name
			if prefix != "/" {
				prefix += "/"
			}
			if err := walk(child, prefix+entry, depth+1); err != nil {
				return err
			}
		}
		return nil
	}
	return walk(2, "/", 0)
}

-- fs.go --
package v7

import (
	"encoding/binary"
	"fmt"
	"path"
	"sort"
	"strings"
)

// FS is a private in-memory Unix namespace. Guest mutations never implicitly
// modify the host files or disk image from which it was populated.
type Node struct {
	Data                         []byte
	Mode, Inode, Links, UID, GID uint16
}
type FS struct {
	Nodes map[string]*Node
	next  uint16
	Bytes int
	Limit int
}

func NewFS() *FS {
	f := &FS{Nodes: map[string]*Node{}, Limit: 64 << 20}
	f.Add("/", nil, 0o40755)
	f.Add("/dev", nil, 0o40755)
	f.Add("/dev/null", nil, 0o20666)
	f.Add("/dev/tty", nil, 0o20666)
	return f
}
func (f *FS) Add(name string, data []byte, mode uint16) error {
	name = path.Clean("/" + name)
	old := f.Nodes[name]
	size := 0
	if old != nil {
		size = len(old.Data)
	}
	if len(data) > f.Limit-f.Bytes+size || f.next == 65535 {
		return fmt.Errorf("V7 filesystem limit exceeded")
	}
	f.next++
	f.Nodes[name] = &Node{Data: append([]byte{}, data...), Mode: mode, Inode: f.next, Links: 1}
	f.Bytes += len(data) - size
	return nil
}
func (f *FS) directory(name string) []byte {
	names := []string{".", ".."}
	prefix := name
	if prefix != "/" {
		prefix += "/"
	}
	for p := range f.Nodes {
		if strings.HasPrefix(p, prefix) && p != name {
			tail := strings.TrimPrefix(p, prefix)
			if tail != "" && !strings.Contains(tail, "/") {
				names = append(names, tail)
			}
		}
	}
	sort.Strings(names[2:])
	out := make([]byte, len(names)*16)
	for i, n := range names {
		node := f.Nodes[path.Clean(prefix+n)]
		if node != nil {
			binary.LittleEndian.PutUint16(out[i*16:], node.Inode)
		}
		copy(out[i*16+2:i*16+16], n)
	}
	return out
}
func (f *FS) resolve(cwd, name string) string {
	if !strings.HasPrefix(name, "/") {
		name = path.Join(cwd, name)
	}
	return path.Clean("/" + name)
}
func (f *FS) validParent(name string) bool {
	n := f.Nodes[path.Dir(name)]
	return n != nil && n.Mode&0o170000 == 0o40000 && len(path.Base(name)) <= 14
}

-- main.go --
package v7

import (
	"flag"
	"fmt"
	"os"
	"os/signal"
	"path/filepath"
	"renvo.dev/emulators/pdp11"
	"syscall"
)

func Main(args []string) int {
	f := flag.NewFlagSet("v7-user", flag.ContinueOnError)
	disk := f.String("disk", "", "V7 filesystem image, copied into memory")
	root := f.String("root", "", "host directory to import into the private guest filesystem")
	limit := f.Uint64("steps", 100000000, "instruction budget")
	trace := f.Bool("trace", false, "trace guest syscalls")
	mode := f.String("engine", "native", "native, ir, or interpreter")
	stats := f.Bool("stats", false, "print execution statistics")
	if err := f.Parse(args); err != nil {
		return 2
	}
	if f.NArg() == 0 {
		fmt.Fprintln(os.Stderr, "usage: v7-user [-disk image | -root directory] executable [arguments]")
		return 2
	}
	fs := NewFS()
	fail := func(err error) int { fmt.Fprintln(os.Stderr, "v7-user:", err); return 1 }
	if *disk != "" && *root != "" {
		return fail(fmt.Errorf("choose a disk image or host directory"))
	}
	if *disk != "" {
		b, err := os.ReadFile(*disk)
		if err != nil {
			return fail(err)
		}
		if err = fs.ImportDisk(b); err != nil {
			return fail(err)
		}
	}
	if *root != "" {
		err := filepath.WalkDir(*root, func(p string, d os.DirEntry, e error) error {
			if e != nil {
				return e
			}
			rel, e := filepath.Rel(*root, p)
			if e != nil {
				return e
			}
			if rel == "." {
				return nil
			}
			name := "/" + filepath.ToSlash(rel)
			if d.IsDir() {
				return fs.Add(name, nil, 0o40755)
			}
			if !d.Type().IsRegular() {
				return nil
			}
			info, e := d.Info()
			if e != nil {
				return e
			}
			if info.Size() > int64(fs.Limit-fs.Bytes) {
				return fmt.Errorf("guest filesystem limit")
			}
			b, e := os.ReadFile(p)
			if e != nil {
				return e
			}
			return fs.Add(name, b, 0o100000|uint16(info.Mode().Perm()))
		})
		if err != nil {
			return fail(err)
		}
	}
	var image []byte
	if *disk != "" || *root != "" {
		node := fs.Nodes[fs.resolve("/", f.Arg(0))]
		if node == nil {
			return fail(fmt.Errorf("guest executable not found: %s", f.Arg(0)))
		}
		image = node.Data
	} else {
		var err error
		image, err = os.ReadFile(f.Arg(0))
		if err != nil {
			return fail(err)
		}
	}
	engine, err := pdp11.NewEngine(*mode)
	if err != nil {
		return fail(err)
	}
	defer engine.Close()
	k := New(fs, os.Stdin, os.Stdout, os.Stderr)
	hostSignals := make(chan os.Signal, 1)
	signal.Notify(hostSignals, os.Interrupt, syscall.SIGTERM, syscall.SIGQUIT)
	defer signal.Stop(hostSignals)
	guestSignals := make(chan int, 1)
	done := make(chan struct{})
	defer close(done)
	k.Signals = guestSignals
	go func() {
		for {
			select {
			case <-done:
				return
			case s := <-hostSignals:
				n := 2
				if s == syscall.SIGTERM {
					n = 15
				} else if s == syscall.SIGQUIT {
					n = 3
				}
				select {
				case guestSignals <- n:
				case <-done:
					return
				}
			}
		}
	}()
	k.Execute = engine.Step
	k.Limit = *limit
	if *trace {
		k.Trace = os.Stderr
	}
	p, err := k.Start(image, f.Args(), []string{"PATH=/bin:/usr/bin", "HOME=/"})
	if err != nil {
		return fail(err)
	}
	status, err := k.Run(p)
	if *stats {
		fmt.Fprintf(os.Stderr, "%+v\n", engine.Stats)
	}
	if err != nil {
		return fail(err)
	}
	return status
}

-- memory.go --
// Package v7 implements a PDP-11 Unix Seventh Edition user personality.
package v7

import (
	"encoding/binary"
	"fmt"
	"renvo.dev/emulators/pdp11"
	emu "renvo.dev/internal/rfe/runtime"
	"strings"
)

type Memory struct {
	Text, Data                       []byte
	Separate                         bool
	TextEnd, DataStart, Break, Stack int
}

func (m *Memory) region(a uint64, w int, access emu.Access) ([]byte, int, *emu.Fault) {
	fail := func(k emu.FaultKind) ([]byte, int, *emu.Fault) {
		return nil, 0, &emu.Fault{Kind: k, Access: access, Address: a, Width: w}
	}
	if w != 1 && w != 2 {
		return fail(emu.DeviceFault)
	}
	if w == 2 && a&1 != 0 {
		return fail(emu.Misaligned)
	}
	if a >= 1<<17 || int(a&65535)+w > 65536 {
		return fail(emu.Boundary)
	}
	off := int(a & 65535)
	data := a&65536 != 0
	if m.Separate && !data {
		if access == emu.Write || off+w > m.TextEnd {
			return fail(emu.Permission)
		}
		return m.Text, off, nil
	}
	if access == emu.Write && off < m.DataStart {
		return fail(emu.Permission)
	}
	if off+w > m.Break && off < m.Stack {
		return fail(emu.Unmapped)
	}
	return m.Data, off, nil
}
func (m *Memory) Load(a uint64, w int, k emu.Access, t uint64) (uint64, *emu.Fault) {
	b, i, f := m.region(a, w, k)
	if f != nil {
		return 0, f
	}
	v := uint64(b[i])
	if w == 2 {
		v |= uint64(b[i+1]) << 8
	}
	return v, nil
}
func (m *Memory) Store(a uint64, w int, v uint64, t uint64) *emu.Fault {
	b, i, f := m.region(a, w, emu.Write)
	if f != nil {
		return f
	}
	b[i] = byte(v)
	if w == 2 {
		b[i+1] = byte(v >> 8)
	}
	return nil
}
func (m *Memory) Peek(a uint64, w int) (uint64, bool) {
	v, f := m.Load(a, w, emu.Execute, 0)
	return v, f == nil
}
func (m *Memory) bytes(a uint16, n int, write bool) ([]byte, bool) {
	if n < 0 || int(a)+n > 65536 {
		return nil, false
	}
	if n == 0 {
		return m.Data[int(a):int(a)], true
	}
	access := emu.Read
	if write {
		access = emu.Write
	}
	for i := 0; i < n; i++ {
		if _, _, f := m.region(65536+uint64(a)+uint64(i), 1, access); f != nil {
			return nil, false
		}
	}
	return m.Data[int(a) : int(a)+n], true
}
func (m *Memory) word(a uint16, data bool) (uint16, bool) {
	addr := uint64(a)
	if data {
		addr += 65536
	}
	v, f := m.Load(addr, 2, emu.Read, 0)
	return uint16(v), f == nil
}
func (m *Memory) str(a uint16) (string, bool) {
	var b []byte
	for i := int(a); i < 65536 && len(b) < 4096; i++ {
		s, ok := m.bytes(uint16(i), 1, false)
		if !ok {
			return "", false
		}
		if s[0] == 0 {
			return string(b), true
		}
		b = append(b, s[0])
	}
	return "", false
}
func (m *Memory) vector(a uint16) ([]string, bool) {
	var out []string
	if a == 0 {
		return out, true
	}
	for i := int(a); i+2 <= 65536 && len(out) < 512; i += 2 {
		p, ok := m.word(uint16(i), true)
		if !ok {
			return nil, false
		}
		if p == 0 {
			return out, true
		}
		s, ok := m.str(p)
		if !ok {
			return nil, false
		}
		out = append(out, s)
	}
	return nil, false
}

// Load accepts V7 0407, 0410, and 0411 a.out files. PDP-11 longs are word
// swapped relative to little-endian uint32; a.out's header is eight words.
func Load(image []byte, args, env []string) (*Memory, pdp11.CPU, error) {
	var cpu pdp11.CPU
	if len(image) < 16 {
		return nil, cpu, fmt.Errorf("truncated V7 a.out header")
	}
	word := func(i int) int { return int(binary.LittleEndian.Uint16(image[i:])) }
	magic, text, data, bss, entry := word(0), word(2), word(4), word(6), word(10)
	if magic != 0o407 && magic != 0o410 && magic != 0o411 {
		return nil, cpu, fmt.Errorf("unsupported V7 a.out magic %#o", magic)
	}
	if text&1 != 0 || entry&1 != 0 || len(image) < 16+text+data {
		return nil, cpu, fmt.Errorf("invalid V7 a.out segments")
	}
	m := &Memory{Data: make([]byte, 65536), Stack: 65536 - 8192, TextEnd: text, Separate: magic == 0o411}
	if m.Separate {
		m.Text = make([]byte, 65536)
		copy(m.Text, image[16:16+text])
		copy(m.Data, image[16+text:16+text+data])
		m.Break = data + bss
	} else {
		m.Text = m.Data
		copy(m.Data, image[16:16+text])
		start := text
		if magic == 0o410 {
			start = (text + 8191) &^ 8191
			m.DataStart = start
		}
		if start+data+bss > m.Stack {
			return nil, cpu, fmt.Errorf("V7 a.out data overlaps stack")
		}
		copy(m.Data[start:], image[16+text:16+text+data])
		m.Break = start + data + bss
	}
	if m.Break > m.Stack || entry >= text {
		return nil, cpu, fmt.Errorf("V7 a.out address space overflow or invalid entry")
	}
	m.Break = (m.Break + 63) &^ 63
	sp := 65534
	values := append(append([]string{}, args...), env...)
	ptrs := make([]uint16, len(values))
	total := 0
	for i := len(values) - 1; i >= 0; i-- {
		s := values[i]
		total += len(s) + 1
		if strings.IndexByte(s, 0) >= 0 || total > 5120 {
			return nil, cpu, fmt.Errorf("V7 argument list too large or contains NUL")
		}
		sp -= len(s) + 1
		if sp < m.Stack {
			return nil, cpu, fmt.Errorf("V7 argument stack overflow")
		}
		copy(m.Data[sp:], s)
		ptrs[i] = uint16(sp)
	}
	// V7 rounds the total string area to words before copying argv strings.
	// crt0 relies on argv[0] being aligned when it clears the word before it.
	if sp&1 != 0 {
		if sp-1 < m.Stack {
			return nil, cpu, fmt.Errorf("V7 argument stack overflow")
		}
		copy(m.Data[sp-1:65533], m.Data[sp:65534])
		m.Data[65533] = 0
		for i := range ptrs {
			ptrs[i]--
		}
		sp--
	}
	sp -= 2 * (len(values) + 3)
	if sp < m.Stack {
		return nil, cpu, fmt.Errorf("V7 argument vector overflow")
	}
	at := sp
	put := func(v uint16) { binary.LittleEndian.PutUint16(m.Data[at:], v); at += 2 }
	put(uint16(len(args)))
	for i := 0; i < len(args); i++ {
		put(ptrs[i])
	}
	put(0)
	for i := len(args); i < len(values); i++ {
		put(ptrs[i])
	}
	put(0)
	cpu = pdp11.CPU{Bus: m, User: true, PSW: 0o140000}
	cpu.R[6] = uint16(sp)
	cpu.R[7] = uint16(entry)
	return m, cpu, nil
}
func putLong(b []byte, v uint32) {
	binary.LittleEndian.PutUint16(b, uint16(v>>16))
	binary.LittleEndian.PutUint16(b[2:], uint16(v))
}

-- process.go --
package v7

import (
	"encoding/binary"
	"fmt"
	"io"
	"path"
	"renvo.dev/emulators/pdp11"
)

type descriptor struct {
	node       *Node
	name       string
	offset     int
	mode       int
	input      io.Reader
	output     io.Writer
	refs       int
	pipe       *pipe
	readResult chan inputResult
	readData   []byte
	readError  error
}
type pipe struct {
	data             []byte
	readers, writers int
}
type Process struct {
	CPU         pdp11.CPU
	Memory      *Memory
	PID, Parent uint16
	CWD         string
	files       [20]*descriptor
	signals     [20]uint16
	mask        uint16
	Exited      bool
	Status      uint16
	waiting     bool
	pending     *call
	posted      uint32
	alarm       uint64
	paused      bool
	Group       uint16
}
type call struct {
	number uint16
	args   [4]uint16
}
type Kernel struct {
	FS            *FS
	Processes     []*Process
	Input         io.Reader
	Output, Error io.Writer
	nextPID       uint16
	Ticks         uint64
	Limit         uint64
	Trace         io.Writer
	Execute       func(*pdp11.CPU, int) int
	// Signals delivers terminal signals to the foreground guest process group.
	Signals <-chan int
	wake    chan struct{}
}

func New(fs *FS, in io.Reader, out, errout io.Writer) *Kernel {
	return &Kernel{FS: fs, Input: in, Output: out, Error: errout, Limit: 100_000_000, wake: make(chan struct{}, 1)}
}
func (k *Kernel) Start(image []byte, args, env []string) (*Process, error) {
	mem, cpu, err := Load(image, args, env)
	if err != nil {
		return nil, err
	}
	k.nextPID++
	p := &Process{CPU: cpu, Memory: mem, PID: k.nextPID, Group: k.nextPID, CWD: "/"}
	p.files[0] = &descriptor{input: k.Input, mode: 0, refs: 1, name: "/dev/tty"}
	p.files[1] = &descriptor{output: k.Output, mode: 1, refs: 1, name: "/dev/tty"}
	p.files[2] = &descriptor{output: k.Error, mode: 1, refs: 1, name: "/dev/tty"}
	k.Processes = append(k.Processes, p)
	return p, nil
}
func (k *Kernel) Run(p *Process) (int, error) {
	for !p.Exited {
		k.pollSignals(p)
		progress := false
		for _, q := range k.Processes {
			if q.Exited {
				continue
			}
			if q.posted != 0 {
				progress = true
			}
			k.deliver(q)
			if q.Exited || q.paused {
				continue
			}
			if q.waiting {
				k.wait(q)
				if q.waiting {
					continue
				}
			}
			if q.pending != nil {
				c := *q.pending
				q.pending = nil
				k.syscall(q, c)
				if q.pending != nil {
					continue
				}
			}
			for i := 0; i < 1024 && !q.Exited && !q.waiting && !q.paused && q.pending == nil; i++ {
				k.pollSignals(p)
				k.deliver(q)
				if q.Exited {
					break
				}
				if k.Ticks >= k.Limit {
					return 0, fmt.Errorf("V7 instruction budget exhausted at pid %d pc %06o", q.PID, q.CPU.R[7])
				}
