-- adapter.go --
package power64

import (
	"renvo.dev/internal/rfe/engine"
	rt "renvo.dev/internal/rfe/runtime"
)

type EngineConfig = engine.EngineConfig
type Engine = engine.Engine
type Stats = engine.Stats
type NativeMemory = engine.NativeMemory

const (
	StatePC    = 32
	StateLR    = 33
	StateCTR   = 34
	StateMSR   = 35
	StateXER   = 36
	StateCR    = 37
	StateWords = 38
)

// TierCPU owns a stable, portable state array, not an unsafe view of CPU fields.
// Import before an engine invocation and Sync afterward. Machine adapters may
// override slow execution to retain interrupt and attempted-instruction accounting.
type TierCPU struct {
	CPU    *CPU
	State  [StateWords]uint64
	Memory engine.Memory
}

func NewTierCPU(cpu *CPU, memory engine.Memory) *TierCPU {
	if memory == nil {
		memory = cpu
	}
	c := &TierCPU{CPU: cpu, Memory: memory}
	c.Import()
	return c
}
func (c *TierCPU) Import() {
	copy(c.State[:32], c.CPU.GPR[:])
	c.State[StatePC], c.State[StateLR], c.State[StateCTR] = c.CPU.PC, c.CPU.LR, c.CPU.CTR
	c.State[StateMSR], c.State[StateXER], c.State[StateCR] = c.CPU.MSR, c.CPU.XER, uint64(c.CPU.CR)
}
func (c *TierCPU) Sync() {
	copy(c.CPU.GPR[:], c.State[:32])
	c.CPU.PC, c.CPU.LR, c.CPU.CTR = c.State[StatePC], c.State[StateLR], c.State[StateCTR]
	c.CPU.MSR, c.CPU.XER, c.CPU.CR = c.State[StateMSR], c.State[StateXER], uint32(c.State[StateCR])
}
func (c *TierCPU) Registers() []uint64      { return c.State[:] }
func (c *TierCPU) Retirement() *uint64      { return &c.CPU.Tick }
func (c *TierCPU) MemoryBus() engine.Memory { return c.Memory }
func (c *TierCPU) Step() error {
	c.Sync()
	err := c.CPU.Step()
	c.Import()
	return err
}
func (c *TierCPU) ExecuteInstruction(ins engine.Instruction) error {
	c.Sync()
	err := c.CPU.Execute(uint32(ins.Bits))
	c.Import()
	return err
}
func (c *CPU) Read(a uint64, n int, execute bool) (uint64, error) {
	access := rt.Read
	if execute {
		access = rt.Execute
	}
	return c.read(a, n, access)
}
func (c *CPU) Write(a uint64, n int, v uint64) error { return c.write(a, n, v) }
func DefaultEngineConfig() engine.EngineConfig       { return engine.DefaultEngineConfig() }
func NewEngine(config engine.EngineConfig) (*engine.Engine, error) {
	return engine.New(config, Architecture())
}

-- cpu.go --
// POWER Book III-S integer interpreter. No host byte order is assumed.
package power64

import (
	"fmt"
	"math/bits"
	rt "renvo.dev/internal/rfe/runtime"
)

const (
	MSRSF uint64 = 1 << 63
	MSREE uint64 = 1 << 15
	MSRPR uint64 = 1 << 14
	MSRIR uint64 = 1 << 5
	MSRDR uint64 = 1 << 4
	MSRLE uint64 = 1
	XERSO uint64 = 1 << 31
	XEROV uint64 = 1 << 30
	XERCA uint64 = 1 << 29
)

type SLB struct{ ESID, VSID uint64 }
type CPU struct {
	GPR                   [32]uint64
	PC, LR, CTR, MSR, XER uint64
	CR                    uint32
	SPR                   [1024]uint64
	SLB                   [64]SLB
	SLBVersion            uint64
	Bus                   rt.Bus
	Tick                  uint64
	InterruptLE           bool
	Hypercall             func(*CPU) error
	Translate             func(*CPU, uint64, rt.Access) (uint64, error)
	SPRRead               func(uint32) (uint64, bool)
	SPRWrite              func(uint32, uint64) bool
	Reservation           uint64
	Reserved              bool
}
type exception struct {
	vector          uint64
	address, status uint64
}

func (e *exception) Error() string { return fmt.Sprintf("exception %#x at %#x", e.vector, e.address) }
func (c *CPU) Exception(vector, savedPC, status uint64) {
	c.SPR[26], c.SPR[27] = savedPC, c.MSR|status
	c.MSR = c.MSR & (MSRSF | 1<<12)
	if c.InterruptLE {
		c.MSR |= MSRLE
	}
	c.PC = vector
	c.Reserved = false
}
func (c *CPU) physical(a uint64, access rt.Access) (uint64, error) {
	if c.Translate != nil {
		return c.Translate(c, a, access)
	}
	return a, nil
}
func swap(v uint64, w int) uint64 {
	switch w {
	case 2:
		return uint64(bits.ReverseBytes16(uint16(v)))
	case 4:
		return uint64(bits.ReverseBytes32(uint32(v)))
	case 8:
		return bits.ReverseBytes64(v)
	}
	return v
}
func (c *CPU) read(a uint64, w int, access rt.Access) (uint64, error) {
	if a&4095+uint64(w) > 4096 {
		var v uint64
		for i := 0; i < w; i++ {
			x, e := c.read(a+uint64(i), 1, access)
			if e != nil {
				return 0, e
			}
			v |= x << uint(i*8)
		}
		if c.MSR&MSRLE == 0 {
			v = swap(v, w)
		}
		return v, nil
	}
	p, e := c.physical(a, access)
	if e != nil {
		return 0, e
	}
	v, f := c.Bus.Load(p, w, access, c.Tick)
	if f != nil {
		return 0, f
	}
	if c.MSR&MSRLE == 0 {
		v = swap(v, w)
	}
	return v, nil
}
func (c *CPU) write(a uint64, w int, v uint64) error {
	if a&4095+uint64(w) > 4096 {
		var physical [8]uint64
		for i := 0; i < w; i++ {
			p, e := c.physical(a+uint64(i), rt.Write)
			if e != nil {
				return e
			}
			physical[i] = p
		}
		if c.MSR&MSRLE == 0 {
			v = swap(v, w)
		}
		for i := 0; i < w; i++ {
			if f := c.Bus.Store(physical[i], 1, v>>uint(i*8), c.Tick); f != nil {
				return f
			}
		}
		c.Reserved = false
		return nil
	}
	p, e := c.physical(a, rt.Write)
	if e != nil {
		return e
	}
	if c.MSR&MSRLE == 0 {
		v = swap(v, w)
	}
	if f := c.Bus.Store(p, w, v, c.Tick); f != nil {
		return f
	}
	c.Reserved = false
	return nil
}

// TranslationMiss is an architectural exception, not an emulator stop.
func TranslationMiss(a uint64, access rt.Access, segment bool, protection bool) error {
	v := uint64(0x300)
	s := uint64(1 << 30)
	if protection {
		s = 1 << 27
	}
	if access == rt.Write {
		s |= 1 << 25
	}
	if access == rt.Execute {
		v = 0x400
	}
	if segment {
		v = 0x380
		if access == rt.Execute {
			v = 0x480
		}
	}
	return &exception{v, a, s}
}
func (c *CPU) crfield(field int, value uint32) {
	shift := uint(28 - field*4)
	c.CR = (c.CR &^ (15 << shift)) | ((value & 15) << shift)
}
func (c *CPU) record(v uint64) {
	r := uint32(2)
	if int64(v) < 0 {
		r = 8
	} else if v > 0 {
		r = 4
	}
	if c.XER&XERSO != 0 {
		r |= 1
	}
	c.crfield(0, r)
}
func (c *CPU) carry(on bool) {
	c.XER &^= XERCA
	if on {
		c.XER |= XERCA
	}
}
func (c *CPU) overflow(on bool) {
	c.XER &^= XEROV
	if on {
		c.XER |= XEROV | XERSO
	}
}
func (c *CPU) base(r uint32) uint64 {
	if r == 0 {
		return 0
	}
	return c.GPR[r]
}
func sext(v uint64, n uint) uint64 { return uint64(int64(v<<(64-n)) >> (64 - n)) }
func mask(mb, me uint, width uint) uint64 {
	// POWER numbers mask bits from the most significant end. Two edge masks
	// also cover a wrapping interval, without a loop over every bit.
	all := ^uint64(0) >> (64 - width)
	left, right := all>>mb, all<<(width-1-me)&all
	if mb <= me {
		return left & right
	}
	return left | right
}
func (c *CPU) branch(bo, bi uint32, decrement bool) bool {
	countOK := true
	if decrement && bo&4 == 0 {
		c.CTR--
		countOK = (c.CTR != 0) != (bo&2 != 0)
	}
	conditionOK := bo&16 != 0 || ((c.CR>>(31-bi))&1 != 0) == (bo&8 != 0)
	return countOK && conditionOK
}
func sprnum(op uint32) uint32 { return (op >> 16 & 31) | (op >> 6 & 0x3e0) }
func (c *CPU) readSPR(s uint32) uint64 {
	switch s {
	case 1:
		return c.XER
	case 8:
		return c.LR
	case 9:
		return c.CTR
	}
	if c.SPRRead != nil {
		if v, ok := c.SPRRead(s); ok {
			return v
		}
	}
	return c.SPR[s]
}
func (c *CPU) writeSPR(s uint32, v uint64) {
	switch s {
	case 1:
		c.XER = v
		return
	case 8:
		c.LR = v
		return
	case 9:
		c.CTR = v
		return
	}
	if c.SPRWrite != nil && c.SPRWrite(s, v) {
		return
	}
	c.SPR[s] = v
}
func (c *CPU) Step() error {
	oldPC := c.PC
	op, e := c.read(c.PC, 4, rt.Execute)
	if e == nil {
		return c.Execute(uint32(op))
	}
	return c.finish(uint32(op), oldPC, e)
}

// Execute runs an already execute-checked instruction, with exactly Step's
// exception, PC and retirement semantics. Fetch authority remains with the bus.
func (c *CPU) Execute(op uint32) error {
	oldPC := c.PC
	c.PC += 4
	return c.finish(op, oldPC, c.execute(op, oldPC))
}
func (c *CPU) finish(op uint32, oldPC uint64, e error) error {
	if x, ok := e.(*exception); ok {
		if x.vector == 0x300 || x.vector == 0x380 {
			c.SPR[19], c.SPR[18] = x.address, x.status
			c.Exception(x.vector, oldPC, 0)
		} else {
			c.Exception(x.vector, oldPC, x.status)
		}
		return nil
	}
	if e != nil {
		return fmt.Errorf("pc=%#x op=%08x msr=%#x: %w", oldPC, op, c.MSR, e)
	}
	c.Tick++
	return nil
}
func (c *CPU) execute(op uint32, pc uint64) error {
	if c.MSR&MSRPR != 0 && op>>26 == 19 {
		xo := op >> 1 & 1023
		if xo == 18 || xo == 50 {
			return &exception{vector: 0x700, status: 1 << 18}
		}
	}
	rtreg, ra, rb := op>>21&31, op>>16&31, op>>11&31
	imm := sext(uint64(op&65535), 16)
	a, b := c.GPR[ra], c.GPR[rb]
	var result uint64
	writeRT, writeRA, record := false, false, false
	primary := op >> 26
	switch primary {
	case 2, 3: // tdi/twi
		lhs, rhs := a, imm
		if primary == 3 {
			lhs, rhs = sext(uint64(uint32(a)), 32), sext(uint64(uint32(imm)), 32)
		}
		to := rtreg
		if to&16 != 0 && int64(lhs) < int64(rhs) || to&8 != 0 && int64(lhs) > int64(rhs) || to&4 != 0 && lhs == rhs || to&2 != 0 && lhs < rhs || to&1 != 0 && lhs > rhs {
			return &exception{vector: 0x700, status: 1 << 17}
		}
	case 7:
		result = uint64(int64(a) * int64(imm))
		writeRT = true
	case 8:
		result = imm - a
		c.carry(imm >= a)
		writeRT = true
	case 10, 11:
		lhs, rhs := a, imm
		if primary == 10 {
			rhs = uint64(op & 65535)
		}
		if op&(1<<21) == 0 {
			if primary == 11 {
				lhs, rhs = sext(uint64(uint32(lhs)), 32), sext(uint64(uint32(rhs)), 32)
			} else {
				lhs, rhs = uint64(uint32(lhs)), uint64(uint32(rhs))
			}
		}
		r := uint32(2)
		if primary == 11 {
			if int64(lhs) < int64(rhs) {
				r = 8
			} else if int64(lhs) > int64(rhs) {
				r = 4
			}
		} else {
			if lhs < rhs {
				r = 8
			} else if lhs > rhs {
				r = 4
			}
		}
		if c.XER&XERSO != 0 {
			r |= 1
		}
		c.crfield(int(op>>23&7), r)
	case 12, 13:
		result = a + imm
		c.carry(result < a)
		writeRT = true
		record = primary == 13
	case 14:
		result = c.base(ra) + imm
		writeRT = true
	case 15:
		result = c.base(ra) + (imm << 16)
		writeRT = true
	case 16:
		if c.branch(rtreg, ra, true) {
			target := pc + sext(uint64(op&0xfffc), 16)
			if op&2 != 0 {
				target = sext(uint64(op&0xfffc), 16)
			}
			c.PC = target
		}
		if op&1 != 0 {
			c.LR = pc + 4
		}
	case 17:
		if op>>5&127 == 1 {
			if c.MSR&MSRPR != 0 {
				return &exception{vector: 0x700, status: 1 << 18}
			}
			if c.Hypercall != nil {
				return c.Hypercall(c)
			}
			return fmt.Errorf("hypercall without partition")
		}
		c.Exception(0xc00, pc+4, 0)
	case 18:
		target := sext(uint64(op&0x3fffffc), 26)
		if op&2 == 0 {
			target += pc
		}
		c.PC = target
		if op&1 != 0 {
			c.LR = pc + 4
		}
	case 19:
		xo := op >> 1 & 1023
		switch xo {
		case 16, 528:
			target := c.LR
			if xo == 528 {
				target = c.CTR
			}
			if c.branch(rtreg, ra, xo == 16) {
				c.PC = target &^ 3
			}
			if op&1 != 0 {
				c.LR = pc + 4
			}
		case 18, 50:
			c.PC = c.SPR[26] &^ 3
			c.MSR = c.SPR[27]
		case 150: // isync
		case 0:
			c.crfield(int(op>>23&7), (c.CR>>uint(28-int(op>>18&7)*4))&15)
		case 33, 129, 193, 225, 257, 289, 417, 449:
			x, y := (c.CR>>(31-ra))&1, (c.CR>>(31-rb))&1
			var v uint32
			switch xo {
			case 33:
				v = ^(x | y)
			case 129:
				v = x &^ y
			case 193:
				v = x ^ y
			case 225:
				v = ^(x & y)
			case 257:
				v = x & y
			case 289:
				v = ^(x ^ y)
			case 417:
				v = x | ^y
			case 449:
				v = x | y
			}
			bit := uint(31 - rtreg)
			c.CR = c.CR&^(1<<bit) | ((v & 1) << bit)
		default:
			return fmt.Errorf("unsupported XL opcode %d", xo)
		}
	case 20, 21, 23:
		sh := rb
		if primary == 23 {
			sh = uint32(b) & 31
		}
		rot := uint64(bits.RotateLeft32(uint32(c.GPR[rtreg]), int(sh)))
		m := mask(uint(op>>6&31), uint(op>>1&31), 32)
		result = rot & m
		if primary == 20 {
			result |= a &^ m
		}
		writeRA = true
		record = op&1 != 0
	case 24, 25, 26, 27, 28, 29:
		v := uint64(op & 65535)
		if primary&1 != 0 {
			v <<= 16
		}
		s := c.GPR[rtreg]
		switch primary {
		case 24, 25:
			result = s | v
		case 26, 27:
			result = s ^ v
		case 28, 29:
			result = s & v
			record = true
		}
		writeRA = true
	case 30:
		sh := uint(rb) | (uint(op>>1&1) << 5)
		mb := uint(op>>6&31) | (uint(op & 32))
		xo := op >> 2 & 7
		s := c.GPR[rtreg]
		r := bits.RotateLeft64(s, int(sh))
		m := uint64(0)
		switch xo {
		case 0:
			m = mask(mb, 63, 64)
		case 1:
			m = mask(0, mb, 64)
		case 2, 3:
			m = mask(mb, 63-sh, 64)
		default:
			sh = uint(b & 63)
			r = bits.RotateLeft64(s, int(sh))
			if op>>1&15 == 8 {
				m = mask(mb, 63, 64)
			} else if op>>1&15 == 9 {
				m = mask(0, mb, 64)
			} else {
				return fmt.Errorf("unsupported MD opcode")
			}
		}
		result = r & m
		if xo == 3 {
			result |= a &^ m
		}
		writeRA = true
		record = op&1 != 0
	case 31:
		return c.extended(op, pc)
	case 32, 33, 34, 35, 40, 41, 42, 43, 58:
		address := c.base(ra) + imm
		width := 4
		update := primary&1 != 0
		signed := primary == 42 || primary == 43
		switch primary {
		case 34, 35:
			width = 1
		case 40, 41, 42, 43:
			width = 2
		case 58:
			address = c.base(ra) + sext(uint64(op&0xfffc), 16)
			width = 8
			update = op&3 == 1
			signed = op&3 == 2
			if signed {
				width = 4
			}
			if op&3 == 3 {
				return fmt.Errorf("reserved DS load")
			}
		}
		v, e := c.read(address, width, rt.Read)
		if e != nil {
			return e
		}
		if signed {
			v = sext(v, uint(width*8))
		}
		c.GPR[rtreg] = v
		if update {
			c.GPR[ra] = address
		}
	case 36, 37, 38, 39, 44, 45, 62:
		address := c.base(ra) + imm
		width := 4
		update := primary&1 != 0
		switch primary {
		case 38, 39:
			width = 1
		case 44, 45:
			width = 2
		case 62:
			address = c.base(ra) + sext(uint64(op&0xfffc), 16)
			width = 8
			update = op&3 == 1
			if op&3 > 1 {
				return fmt.Errorf("reserved DS store")
			}
		}
		if e := c.write(address, width, c.GPR[rtreg]); e != nil {
			return e
		}
		if update {
			c.GPR[ra] = address
		}
	case 46, 47:
		address := c.base(ra) + imm
		for r := rtreg; r < 32; r++ {
			if primary == 46 {
				v, e := c.read(address, 4, rt.Read)
				if e != nil {
					return e
				}
				c.GPR[r] = v
			} else {
				if e := c.write(address, 4, c.GPR[r]); e != nil {
					return e
				}
			}
			address += 4
		}
	default:
		return fmt.Errorf("unsupported primary opcode %d", primary)
	}
	if writeRT {
		c.GPR[rtreg] = result
	}
	if writeRA {
		c.GPR[ra] = result
	}
	if record {
		c.record(result)
	}
	return nil
}

-- cpu_test.go --
package power64

import (
	"encoding/binary"
	rt "renvo.dev/internal/rfe/runtime"
	"testing"
)

type memoryBus []byte

func (m memoryBus) Load(a uint64, w int, access rt.Access, tick uint64) (uint64, *rt.Fault) {
	if a > uint64(len(m)) || w < 1 || w > 8 || uint64(w) > uint64(len(m))-a {
		return 0, &rt.Fault{Kind: rt.Boundary, Address: a, Width: w}
	}
	var v uint64
	for i := 0; i < w; i++ {
		v |= uint64(m[a+uint64(i)]) << uint(i*8)
	}
	return v, nil
}
func (m memoryBus) Store(a uint64, w int, v uint64, tick uint64) *rt.Fault {
	if a > uint64(len(m)) || w < 1 || w > 8 || uint64(w) > uint64(len(m))-a {
		return &rt.Fault{Kind: rt.Boundary, Address: a, Width: w}
	}
	for i := 0; i < w; i++ {
		m[a+uint64(i)] = byte(v >> uint(i*8))
	}
	return nil
}
func (m memoryBus) Peek(a uint64, w int) (uint64, bool) {
	v, f := m.Load(a, w, rt.Execute, 0)
	return v, f == nil
}
func TestEndianLoadStore(t *testing.T) {
	for _, le := range []bool{false, true} {
		m := memoryBus(make([]byte, 256))
		c := CPU{Bus: m, MSR: MSRSF}
		var order binary.ByteOrder = binary.BigEndian
		if le {
			c.MSR |= MSRLE
			order = binary.LittleEndian
		}
		order.PutUint32(m, 0x80600080)
		order.PutUint32(m[4:], 0x90600088)
		copy(m[128:], []byte{0x12, 0x34, 0x56, 0x78})
		if e := c.Step(); e != nil {
			t.Fatal(e)
		}
		expected := uint64(order.Uint32(m[128:]))
		if c.GPR[3] != expected {
			t.Fatalf("LE=%t: load=%x want=%x", le, c.GPR[3], expected)
		}
		if e := c.Step(); e != nil {
			t.Fatal(e)
		}
		if order.Uint32(m[136:]) != uint32(expected) {
			t.Fatal("store byte order")
		}
	}
}
func TestCarryOverflowAndRecord(t *testing.T) {
	c := CPU{}
	c.GPR[4] = ^uint64(0)
	c.GPR[5] = 1
	op := uint32(31<<26 | 3<<21 | 4<<16 | 5<<11 | 10<<1 | 1)
	if e := c.execute(op, 0); e != nil {
		t.Fatal(e)
	}
	if c.GPR[3] != 0 || c.XER&XERCA == 0 || c.CR>>28 != 2 {
		t.Fatalf("addc: %#v", c)
	}
	c.GPR[4] = 0x7fffffffffffffff
	c.GPR[5] = 1
	op = 31<<26 | 3<<21 | 4<<16 | 5<<11 | 778<<1 | 1
	if e := c.execute(op, 0); e != nil {
		t.Fatal(e)
	}
	if c.XER&(XEROV|XERSO) != (XEROV|XERSO) || c.CR>>28 != 9 {
		t.Fatal("addo record/overflow")
	}
}
func TestBranchUsesOldLR(t *testing.T) {
	c := CPU{LR: 0x80}
	if e := c.execute(0x4e800021, 0x40); e != nil {
		t.Fatal(e)
	}
	if c.PC != 0x80 || c.LR != 0x44 {
		t.Fatal("bclrl target/link ordering")
	}
	c.CTR = 1
	c.PC = 0x44
	if e := c.execute(0x4200fff8, 0x44); e != nil {
		t.Fatal(e)
	}
	if c.CTR != 0 || c.PC != 0x44 {
		t.Fatal("bdnz")
	}
}
func TestExceptionRoundTrip(t *testing.T) {
	c := CPU{MSR: MSRSF | MSREE | MSRIR | MSRDR | MSRLE, InterruptLE: true}
	saved := c.MSR
	c.Exception(0x900, 0x1234, 0)
	if c.PC != 0x900 || c.MSR&MSREE != 0 || c.SPR[26] != 0x1234 {
		t.Fatal("exception entry")
	}
	if e := c.execute(0x4c000024, 0x900); e != nil {
		t.Fatal(e)
	}
	if c.PC != 0x1234 || c.MSR != saved {
		t.Fatal("rfid")
	}
}
func TestReservationInvalidatedByStore(t *testing.T) {
	m := memoryBus(make([]byte, 256))
	c := CPU{Bus: m, MSR: MSRLE}
	c.GPR[4] = 128
	c.GPR[5] = 0
	c.GPR[3] = 42
	if e := c.execute(31<<26|6<<21|4<<16|5<<11|20<<1, 0); e != nil {
		t.Fatal(e)
	}
	if !c.Reserved {
		t.Fatal("lwarx")
	}
	if e := c.write(132, 4, 1); e != nil {
		t.Fatal(e)
	}
	if e := c.execute(31<<26|3<<21|4<<16|5<<11|150<<1|1, 4); e != nil {
		t.Fatal(e)
	}
	if c.CR>>28&2 != 0 {
		t.Fatal("stwcx succeeded after intervening store")
	}
}

