package amd64

import "renvo.dev/internal/rfe/engine"

func configureDecodedArchitecture(arch *engine.Architecture) {}
func DecodedInstruction(ins engine.Instruction) Instruction  { return ins.Decoded.(Instruction) }

-- direct_call_region_test.go --
package amd64

import (
	"renvo.dev/internal/rfe/engine"
	"renvo.dev/internal/rfe/linuxuser"
	"testing"
)

func TestNativeDirectCallRegionBudgetsAndStackFault(t *testing.T) {
	// CALL callee; JMP call; callee: INC RAX; RET.
	code := []byte{0xe8, 2, 0, 0, 0, 0xeb, 0xf9, 0x48, 0xff, 0xc0, 0xc3}
	for _, budget := range []uint64{1, 2, 3, 4, 5, 63, 65, 257} {
		expected, actual := testCPU(t, code), testCPU(t, code)
		for _, c := range []*CPU{expected, actual} {
			if err := c.Memory.(*linuxuser.Memory).Map(0x3000, 4096, 3); err != nil {
				t.Fatal(err)
			}
			c.R[RSP] = 0x3800
		}
		ins, err := fetch(actual.Memory, actual.PC)
		if err != nil || !ins.Terminal || !ins.Flow.Known || ins.Flow.Next != 0x1007 {
			t.Fatal("direct call flow", ins, err)
		}
		cfg := engine.DefaultEngineConfig()
		cfg.IRThreshold, cfg.NativeThreshold = 1, 1
		e, err := engine.New(cfg, Architecture())
		if err != nil {
			t.Fatal(err)
		}
		adapter := NewAdapter(actual)
		// Discover and compile the call and its callee before testing small slices.
		for actual.Retired < 128 {
			if err = e.RunQuanta(adapter, 128-actual.Retired); err != nil {
				t.Fatal(err)
			}
		}
		adapter.Export()
		actual.R, actual.PC, actual.Flags, actual.Retired = expected.R, expected.PC, expected.Flags, 0
		adapter.Import()
		for expected.Retired < budget {
			step(t, expected)
		}
		for actual.Retired < budget {
			if err = e.RunQuanta(adapter, budget-actual.Retired); err != nil {
				t.Fatal(err)
			}
		}
		adapter.Export()
		got, ge := actual.Memory.Read(0x37f8, 8, false)
		want, we := expected.Memory.Read(0x37f8, 8, false)
		if actual.R != expected.R || actual.PC != expected.PC || actual.Flags != expected.Flags || actual.Retired != budget || got != want || ge != nil || we != nil {
			t.Fatal("direct-call slice mismatch", budget, actual, expected, got, want, ge, we)
		}
		if e.NativeAvailable() && (e.Stats.Native == 0 || e.Stats.Regions == 0) {
			t.Fatal("call path did not run native regions", e.Stats)
		}
		actual.PC, actual.R[RSP] = 0x1000, 0x3800
		if err = actual.Memory.(*linuxuser.Memory).Protect(0x3000, 4096, 1); err != nil {
			t.Fatal(err)
		}
		before := *actual
		adapter.Import()
		err = e.RunQuanta(adapter, 64)
		adapter.Export()
		afterWord, readErr := actual.Memory.Read(0x37f8, 8, false)
		if err == nil || actual.R != before.R || actual.PC != before.PC || actual.Flags != before.Flags || actual.Retired != before.Retired || readErr != nil || afterWord != got {
			t.Fatal("call stack fault committed state", err, actual, before, afterWord, got)
		}
		if err = e.Close(); err != nil {
			t.Fatal(err)
		}
	}
}

-- extra.go --
package amd64

import (
	"fmt"
	"math/bits"
)

func (d *decoder) extra(i *Instruction, op byte, operand16 bool) {
	w := i.Width
	switch op {
	case 0xf4:
		i.Op = "hlt"
	case 0xfa:
		i.Op = "cli"
	case 0xfb:
		i.Op = "sti"
	case 0xfc:
		i.Op = "cld"
	case 0xfd:
		i.Op = "std"
	case 0xf8:
		i.Op = "clc"
	case 0xf9:
		i.Op = "stc"
	case 0xf5:
		i.Op = "cmc"
	case 0x9c:
		i.Op = "pushf"
		i.Width = 8
		if operand16 {
			i.Width = 2
		}
	case 0x9d:
		i.Op = "popf"
		i.Width = 8
		if operand16 {
			i.Width = 2
		}
	case 0x9e:
		i.Op = "sahf"
	case 0x9f:
		i.Op = "lahf"
	case 0xcb:
		i.Op = "lret"
		i.Width = 8
	case 0xca:
		i.Op = "lret"
		i.Width = 8
		i.Src = immediate(d.immediate(2, false))
	case 0xcf:
		i.Op = "iret"
		i.Width = 8
	case 0xcc:
		i.Op = "int"
		i.Src = immediate(3)
	case 0xcd:
		i.Op = "int"
		i.Src = immediate(d.immediate(1, false))
	case 0x8c, 0x8e:
		rm, _, g := d.modrm(2)
		i.Op = "movseg"
		i.Dst = rm
		i.Width = 2
		i.CC = g
		if op == 0x8c {
			i.Op = "readseg"
		}
	case 0x86, 0x87:
		if op == 0x86 {
			i.Width = 1
		}
		rm, r, _ := d.modrm(i.Width)
		i.Op = "xchg"
		i.Dst, i.Src = rm, r
	case 0x90, 0x91, 0x92, 0x93, 0x94, 0x95, 0x96, 0x97:
		i.Op = "xchg"
		i.Dst = d.reg(0, w)
		i.Src = d.reg(op-0x90+(d.rex&1)*8, w)
	case 0xa4, 0xa5, 0xa6, 0xa7, 0xaa, 0xab, 0xac, 0xad, 0xae, 0xaf:
		if op&1 == 0 {
			i.Width = 1
		}
		switch op & 0xfe {
		case 0xa4:
			i.Op = "movs"
		case 0xa6:
			i.Op = "cmps"
		case 0xaa:
			i.Op = "stos"
		case 0xac:
			i.Op = "lods"
		case 0xae:
			i.Op = "scas"
		}
	case 0xe4, 0xe5, 0xe6, 0xe7, 0xec, 0xed, 0xee, 0xef:
		i.Width = 4
		if op&1 == 0 {
			i.Width = 1
		} else if operand16 {
			i.Width = 2
		}
		i.Op = "in"
		if op&2 != 0 {
			i.Op = "out"
		}
		i.Src = d.reg(RDX, 2)
		if op < 0xe8 {
			i.Src = immediate(d.immediate(1, false))
		}
	case 0xe0, 0xe1, 0xe2, 0xe3:
		i.Op = "loop"
		i.CC = op & 3
		i.Src = immediate(d.immediate(1, true))
		i.Src.Imm += d.pc
	case 0xd7:
		i.Op = "xlat"
	case 0x0f:
		switch d.second {
		case 0x01:
			if b, e := d.memory.Read(d.pc, 1, true); e == nil && b == 0xf8 {
				d.byte()
				i.Op = "swapgs"
				break
			}
			if b, e := d.memory.Read(d.pc, 1, true); e == nil && b == 0xf9 {
				d.byte()
				i.Op = "rdtscp"
				break
			}
			rm, _, g := d.modrm(8)
			i.Dst = rm
			i.CC = g
			switch g {
			case 0:
				i.Op = "sgdt"
			case 1:
				i.Op = "sidt"
			case 2:
				i.Op = "lgdt"
			case 3:
				i.Op = "lidt"
			case 4:
				i.Op = "smsw"
				i.Width = 2
			case 6:
				i.Op = "lmsw"
				i.Width = 2
			case 7:
				i.Op = "invlpg"
			}
		case 0x00:
			rm, _, g := d.modrm(2)
			i.Dst = rm
			i.CC = g
			i.Width = 2
			switch g {
			case 0:
				i.Op = "sldt"
			case 1:
				i.Op = "str"
			case 2:
				i.Op = "lldt"
			case 3:
				i.Op = "ltr"
			case 4:
				i.Op = "verr"
			case 5:
				i.Op = "verw"
			}
		case 0x20, 0x21, 0x22, 0x23:
			rm, r, _ := d.modrm(8)
			i.Dst = rm
			i.CC = uint8(r.Reg)
			i.Width = 8
			i.Op = "readcr"
			if d.second&1 != 0 {
				i.Op = "readdr"
			}
			if d.second&2 != 0 {
				if d.second&1 != 0 {
					i.Op = "writedr"
				} else {
					i.Op = "writecr"
				}
			}
		case 0x30:
			i.Op = "wrmsr"
		case 0x32:
			i.Op = "rdmsr"
		case 0x31:
			i.Op = "rdtsc"
		case 0xa2:
			i.Op = "cpuid"
		case 0x06:
			i.Op = "clts"
		case 0x08, 0x09:
			i.Op = "cacheflush"
		case 0x07:
			i.Op = "sysret"
		case 0x0b:
			i.Op = "ud2"
		case 0x1e:
			b := d.byte()
			if d.repeat == 0xf3 && (b == 0xfa || b == 0xfb) {
				i.Op = "nop"
			}
		case 0x18:
			d.modrm(1)
			i.Op = "nop"
		case 0xa3, 0xab, 0xb3, 0xbb, 0xba:
			rm, r, g := d.modrm(w)
			i.Dst, i.Src = rm, r
			i.Op = "bt"
			switch d.second {
			case 0xab:
				i.Op = "bts"
			case 0xb3:
				i.Op = "btr"
			case 0xbb:
				i.Op = "btc"
			case 0xba:
				i.Src = immediate(d.immediate(1, false))
				switch g {
				case 4:
					i.Op = "bt"
				case 5:
					i.Op = "bts"
				case 6:
					i.Op = "btr"
				case 7:
					i.Op = "btc"
				default:
					i.Op = ""
				}
			}
		case 0xbc, 0xbd:
			rm, r, _ := d.modrm(w)
			i.Dst, i.Src = r, rm
			i.Op = "bsf"
			if d.second == 0xbd {
				i.Op = "bsr"
			}
		case 0xc8, 0xc9, 0xca, 0xcb, 0xcc, 0xcd, 0xce, 0xcf:
			i.Dst = d.reg(d.second-0xc8+(d.rex&1)*8, w)
			i.Op = "bswap"
		case 0xb0, 0xb1, 0xc0, 0xc1:
			if d.second&1 == 0 {
				i.Width = 1
			}
			rm, r, _ := d.modrm(i.Width)
			i.Dst, i.Src = rm, r
			i.Op = "cmpxchg"
			if d.second >= 0xc0 {
				i.Op = "xadd"
			}
		case 0xa4, 0xa5, 0xac, 0xad:
			rm, r, _ := d.modrm(w)
			i.Dst, i.Src = rm, r
			i.Op = "shld"
			if d.second&8 != 0 {
				i.Op = "shrd"
			}
			i.CC = 255
			if d.second&1 == 0 {
				i.CC = d.byte()
			}
		case 0xae:
			rm, _, g := d.modrm(8)
			i.Dst = rm
			i.CC = g
			i.Op = "fx"
			if rm.Kind == regOperand {
				i.Op = "nop"
			}
		case 0xc7:
			rm, _, g := d.modrm(w)
			if g == 1 {
				i.Op = "cmpxchg8b"
				i.Dst = rm
			}
		}
	}
}

// These synchronous helpers borrow CPU state; they do not create escaping
// callback environments on the arena-based browser runtime.
func (c *CPU) privExtra(op string) error {
	if c.System == nil {
		return fmt.Errorf("system instruction %s in user personality", op)
	}
	if c.System.CPL != 0 {
		return gp()
	}
	return nil
}
func (c *CPU) writeExtra(o Operand, n uint8, v, next uint64) error { return c.write(o, n, next, v) }
func (c *CPU) pushExtra(w uint8, v uint64) error {
	if e := c.Memory.Write(c.R[RSP]-uint64(w), int(w), v); e != nil {
		return e
	}
	c.R[RSP] -= uint64(w)
	return nil
}
func (c *CPU) popExtra(w uint8) (uint64, error) {
	v, e := c.Memory.Read(c.R[RSP], int(w), false)
	if e == nil {
		c.R[RSP] += uint64(w)
	}
	return v, e
}
func (c *CPU) executeExtra(i Instruction) (bool, error) {
	if handled, e := c.vectorExecute(i); handled {
		return true, e
	}
	s := c.System
	next, w := i.Next, i.Width
	var e error
	switch i.Op {
	case "cli", "sti", "hlt", "clts", "cacheflush", "swapgs":
		if e = c.privExtra(i.Op); e != nil {
			break
		}
		switch i.Op {
		case "cli":
			c.Flags &^= FlagIF
		case "sti":
			c.Flags |= FlagIF
			s.IRQShadow = 2
		case "hlt":
			s.Halted = true
		case "clts":
			s.CR[0] &^= 8
		case "swapgs":
			s.GSBase, s.KernelGSBase = s.KernelGSBase, s.GSBase
		}
	case "cld":
		c.Flags &^= FlagDF
	case "std":
		c.Flags |= FlagDF
	case "clc":
		c.Flags &^= CF
	case "stc":
		c.Flags |= CF
	case "cmc":
		c.Flags ^= CF
	case "pushf":
		e = c.pushExtra(w, c.Flags|2)
	case "popf":
		var v uint64
		v, e = c.popExtra(w)
		if e == nil {
			mask := uint64(0x3f7fd7)
			if s != nil && s.CPL != 0 {
				mask &^= FlagIF | 0x3000
			}
			c.Flags = c.Flags&^mask | v&mask | 2
		}
	case "sahf":
		c.Flags = c.Flags&^0xd5 | (c.R[RAX]>>8)&0xd5
	case "lahf":
		c.R[RAX] = c.R[RAX]&^0xff00 | (c.Flags&0xd5|2)<<8
	case "cpuid":
		if s == nil {
			s = &System{}
		}
		a, b, d, f := s.cpuid(uint32(c.R[RAX]), uint32(c.R[RCX]))
		c.R[RAX], c.R[RBX], c.R[RCX], c.R[RDX] = uint64(a), uint64(b), uint64(d), uint64(f)
	case "rdtsc", "rdtscp":
		if s == nil {
			return true, fmt.Errorf("no system clock")
		}
		c.R[RAX], c.R[RDX] = uint64(uint32(s.TSC)), s.TSC>>32
		if i.Op == "rdtscp" {
			c.R[RCX] = 0
		}
	case "rdmsr", "wrmsr":
		if e = c.privExtra(i.Op); e != nil {
			break
		}
		if i.Op == "wrmsr" {
			e = s.writeMSR(uint32(c.R[RCX]), uint64(uint32(c.R[RAX]))|c.R[RDX]<<32)
		} else {
			var v uint64
			v, e = s.readMSR(uint32(c.R[RCX]))
			if e == nil {
				c.R[RAX], c.R[RDX] = uint64(uint32(v)), v>>32
			}
		}
	case "readcr", "writecr", "readdr", "writedr":
		if e = c.privExtra(i.Op); e != nil {
			break
		}
		if int(i.CC) >= len(s.CR) {
			e = gp()
			break
		}
		switch i.Op {
		case "readcr":
			e = c.writeExtra(i.Dst, 8, s.CR[i.CC], next)
		case "readdr":
			if i.CC >= 8 {
				e = gp()
			} else {
				e = c.writeExtra(i.Dst, 8, s.DR[i.CC], next)
			}
		case "writedr":
			if i.CC >= 8 {
				e = gp()
			} else {
				s.DR[i.CC], e = c.read(i.Dst, 8, next)
			}
		case "writecr":
			v, err := c.read(i.Dst, 8, next)
			e = err
			if e == nil {
				s.CR[i.CC] = v
				if i.CC == 0 && v&(1<<31) != 0 && s.EFER&(1<<8) != 0 {
					s.EFER |= 1 << 10
				}
				if i.CC == 3 {
					s.switchAddressSpace()
				} else {
					s.Flush()
				}
			}
		}
	case "lgdt", "lidt", "sgdt", "sidt":
		if e = c.privExtra(i.Op); e != nil {
			break
		}
		a := c.address(i.Dst, next)
		if i.Op == "lgdt" || i.Op == "lidt" {
			var lim, base uint64
			lim, e = c.Memory.Read(a, 2, false)
			if e == nil {
				base, e = c.Memory.Read(a+2, 8, false)
			}
			if e == nil {
				t := Table{Base: base, Limit: uint16(lim)}
				if i.Op == "lgdt" {
					s.GDTR = t
				} else {
					s.IDTR = t
				}
			}
		} else {
			t := s.GDTR
			if i.Op == "sidt" {
				t = s.IDTR
			}
			e = c.Memory.Write(a, 2, uint64(t.Limit))
			if e == nil {
				e = c.Memory.Write(a+2, 8, t.Base)
			}
		}
	case "movseg", "readseg":
		if s == nil {
			e = fmt.Errorf("segment operation needs system context")
			break
		}
		if i.CC >= 6 {
			e = gp()
			break
		}
		if i.Op == "movseg" {
			v, err := c.read(i.Dst, 2, next)
			e = err
			if e == nil {
				e = s.segment(i.CC, uint16(v))
			}
		} else {
			e = c.writeExtra(i.Dst, 2, uint64(s.Segments[i.CC].Selector), next)
		}
	case "ltr", "lldt", "str", "sldt":
		if e = c.privExtra(i.Op); e != nil {
			break
		}
		if i.Op == "str" {
			e = c.writeExtra(i.Dst, 2, uint64(s.TR.Selector), next)
		} else if i.Op == "sldt" {
			e = c.writeExtra(i.Dst, 2, uint64(s.LDTR.Selector), next)
		} else {
			v, err := c.read(i.Dst, 2, next)
			e = err
			if e == nil {
				var d Segment
				if v&^3 != 0 {
					d, e = s.descriptor(uint16(v))
				}
				if e == nil {
					if i.Op == "ltr" {
						s.TR = d
					} else {
						s.LDTR = d
					}
				}
			}
		}
	case "verr", "verw":
		if s == nil {
			e = fmt.Errorf("selector verification needs system context")
			break
		}
		var selector uint64
		selector, e = c.read(i.Dst, 2, next)
		if e == nil {
			var allowed bool
			allowed, e = s.verifySelector(uint16(selector), i.Op == "verw")
			if e == nil {
				c.Flags &^= ZF
				if allowed {
					c.Flags |= ZF
				}
			}
		}
	case "smsw", "lmsw":
		if s == nil {
			e = gp()
			break
		}
		if i.Op == "smsw" {
			e = c.writeExtra(i.Dst, w, s.CR[0], next)
		} else if e = c.privExtra(i.Op); e == nil {
			v, err := c.read(i.Dst, 2, next)
			e = err
			if e == nil {
				s.CR[0] = (s.CR[0] &^ 15) | (v & 15) | (s.CR[0] & 1)
				s.Flush()
			}
		}
	case "invlpg":
		if e = c.privExtra(i.Op); e == nil {
			s.invalidatePage(c.address(i.Dst, next))
		}
	case "lret":
		if s == nil {
			e = gp()
			break
		}
		var pc, sel uint64
		pc, e = c.popExtra(w)
		if e == nil {
			sel, e = c.popExtra(w)
		}
		if e == nil {
			e = s.segment(1, uint16(sel))
			next = pc
			c.R[RSP] += i.Src.Imm
		}
	case "iret":
		if s == nil {
			e = gp()
			break
		}
		sp := c.R[RSP]
		var v [5]uint64
		for j := range v {
			v[j], e = c.Memory.Read(sp+uint64(j*8), 8, false)
			if e != nil {
				break
			}
		}
		if e == nil {
			e = s.segment(1, uint16(v[1]))
			if e == nil {
				next, c.Flags, c.R[RSP] = v[0], v[2]|2, v[3]
				s.Segments[2].Selector = uint16(v[4])
			}
		}
	case "syscall":
		if s == nil {
			return false, nil
		}
		if s.EFER&1 == 0 {
			e = &Exception{Vector: 6}
			break
		}
		c.R[RCX], c.R[11] = next, c.Flags
		c.Flags &^= s.SFMASK
		next = s.LSTAR
		s.CPL = 0
		s.Segments[1].Selector = uint16(s.STAR>>32) &^ 3
		s.Segments[2].Selector = s.Segments[1].Selector + 8
	case "sysret":
		if e = c.privExtra(i.Op); e != nil {
			break
		}
		s.CPL = 3
		s.Segments[1].Selector = uint16(s.STAR>>48) + 16 | 3
		s.Segments[2].Selector = uint16(s.STAR>>48) + 8 | 3
		next = c.R[RCX]
		c.Flags = c.R[11] | 2
	case "int":
		if s == nil {
			e = fmt.Errorf("software interrupt without system context")
		} else {
			c.PC = next
			e = s.Interrupt(uint8(i.Src.Imm), 0, false)
			next = c.PC
		}
	case "ud2":
		e = &Exception{Vector: 6}
	case "in", "out":
		if e = c.privExtra(i.Op); e != nil {
			break
		}
		port, err := c.read(i.Src, 2, next)
		e = err
		if e != nil {
			break
		}
		if s.Ports == nil {
			e = fmt.Errorf("no port bus")
			break
		}
		if i.Op == "in" {
			e = c.writeExtra(Operand{Kind: regOperand, Reg: RAX}, w, uint64(s.Ports.In(uint16(port), int(w))), next)
		} else {
			s.Ports.Out(uint16(port), int(w), uint32(c.R[RAX]))
		}
	case "movs", "cmps", "stos", "lods", "scas":
		count := uint64(1)
		if i.Repeat != 0 {
			count = c.R[RCX]
		}
		if count == 0 {
			break
		}
		src, dst := c.R[RSI], c.R[RDI]
		if s != nil {
			if i.Segment == 0x64 {
				src += s.FSBase
			}
			if i.Segment == 0x65 {
				src += s.GSBase
			}
		}
		var a, b uint64
		switch i.Op {
		case "movs", "cmps", "lods":
			a, e = c.Memory.Read(src, int(w), false)
		case "stos", "scas":
			a = c.R[RAX] & mask(w)
		}
		if e != nil {
			break
		}
		if i.Op == "cmps" || i.Op == "scas" {
			b, e = c.Memory.Read(dst, int(w), false)
			if e == nil {
				_, f := arithmetic(a, b, 0, w, true)
				c.Flags = c.Flags&^arithmeticFlags | f
			}
		}
		if i.Op == "movs" || i.Op == "stos" {
			e = c.Memory.Write(dst, int(w), a)
		}
		if i.Op == "lods" {
			e = c.writeExtra(Operand{Kind: regOperand, Reg: RAX}, w, a, next)
		}
		if e != nil {
			break
		}
		delta := uint64(w)
		if c.Flags&FlagDF != 0 {
			delta = -delta
		}
		if i.Op == "movs" || i.Op == "cmps" || i.Op == "lods" {
			c.R[RSI] += delta
		}
		if i.Op != "lods" {
			c.R[RDI] += delta
		}
		if i.Repeat != 0 {
			c.R[RCX]--
			again := c.R[RCX] != 0
			if i.Op == "cmps" || i.Op == "scas" {
				again = again && ((c.Flags&ZF != 0) == (i.Repeat == 0xf3))
			}
			if again {
				next = i.PC
			}
		}
	case "xchg", "xadd", "cmpxchg":
		a, err := c.read(i.Dst, w, next)
		e = err
		if e != nil {
			break
		}
		b, err := c.read(i.Src, w, next)
		e = err
		if e != nil {
			break
		}
		switch i.Op {
		case "xchg":
			e = c.writeExtra(i.Dst, w, b, next)
			if e == nil {
				e = c.writeExtra(i.Src, w, a, next)
			}
		case "xadd":
			v, f := arithmetic(a, b, 0, w, false)
			e = c.writeExtra(i.Dst, w, v, next)
			if e == nil {
				e = c.writeExtra(i.Src, w, a, next)
				c.Flags = c.Flags&^arithmeticFlags | f
			}
		case "cmpxchg":
			_, f := arithmetic(c.R[RAX], a, 0, w, true)
			if f&ZF != 0 {
				e = c.writeExtra(i.Dst, w, b, next)
			} else {
				e = c.writeExtra(Operand{Kind: regOperand, Reg: RAX}, w, a, next)
			}
			if e == nil {
				c.Flags = c.Flags&^arithmeticFlags | f
			}
		}
	case "bt", "bts", "btr", "btc":
		bit, err := c.read(i.Src, w, next)
		e = err
		if e != nil {
			break
		}
		dst := i.Dst
		if dst.Kind == memOperand && i.Src.Kind != immOperand {
			dst.Disp += (signed(bit, w) >> 3) &^ (int64(w) - 1)
		}
		bit &= uint64(w*8 - 1)
		v, err := c.read(dst, w, next)
		e = err
		if e != nil {
			break
		}
		c.Flags = c.Flags&^CF | (v>>bit)&1
		if i.Op != "bt" {
			switch i.Op {
			case "bts":
				v |= 1 << bit
			case "btr":
				v &^= 1 << bit
			case "btc":
				v ^= 1 << bit
			}
			e = c.writeExtra(dst, w, v, next)
		}
	case "bsf", "bsr":
		v, err := c.read(i.Src, w, next)
		e = err
		if e != nil {
			break
		}
		if v == 0 {
			c.Flags |= ZF
		} else {
			c.Flags &^= ZF
			n := bits.TrailingZeros64(v)
			if i.Op == "bsr" {
				n = 63 - bits.LeadingZeros64(v)
			}
			e = c.writeExtra(i.Dst, w, uint64(n), next)
		}
	case "bswap":
		v, err := c.read(i.Dst, w, next)
		e = err
		if e == nil {
			if w == 8 {
				v = bits.ReverseBytes64(v)
			} else {
				v = uint64(bits.ReverseBytes32(uint32(v)))
			}
			e = c.writeExtra(i.Dst, w, v, next)
		}
	case "shld", "shrd":
		a, err := c.read(i.Dst, w, next)
		e = err
		if e != nil {
			break
		}
		b, err := c.read(i.Src, w, next)
		e = err
		if e != nil {
			break
		}
		n := uint64(i.CC)
		if i.CC == 255 {
			n = c.R[RCX]
		}
		n &= 31
		if w == 8 {
			n = uint64(i.CC) & 63
			if i.CC == 255 {
				n = c.R[RCX] & 63
			}
		}
		if n == 0 {
			break
		}
		width := uint64(w) * 8
		var v, carry uint64
		if i.Op == "shld" {
			v = (a << n) | (b >> (width - n))
			carry = a >> (width - n) & 1
		} else {
			v = (a >> n) | (b << (width - n))
			carry = a >> (n - 1) & 1
		}
		e = c.writeExtra(i.Dst, w, v, next)
		if e == nil {
			f := szp(v, w) | carry
			if n == 1 && (a^v)>>(width-1)&1 != 0 {
				f |= OF
			}
			c.Flags = c.Flags&^arithmeticFlags | f
		}
	case "loop":
		take := false
		if i.CC == 3 {
			take = c.R[RCX] == 0
		} else {
			c.R[RCX]--
			take = c.R[RCX] != 0
			if i.CC == 0 {
				take = take && c.Flags&ZF == 0
			}
			if i.CC == 1 {
				take = take && c.Flags&ZF != 0
			}
		}
		if take {
			next = i.Src.Imm
		}
	case "xlat":
		v, err := c.Memory.Read(c.R[RBX]+(c.R[RAX]&255), 1, false)
		e = err
		if e == nil {
			e = c.writeExtra(Operand{Kind: regOperand, Reg: RAX}, 1, v, next)
		}
	default:
		return false, nil
	}
	if e != nil {
		return true, e
	}
	c.PC = next
	c.Retired++
	return true, nil
}

-- flags_multiply_native_test.go --
package amd64

import (
	"renvo.dev/internal/rfe/engine"
	"renvo.dev/internal/rfe/linuxuser"
	"testing"
)

func TestNativeSingleOperandMultiplyAndFlagControls(t *testing.T) {
	codes := [][]byte{{0xfc}, {0xfd}, {0xf8}, {0xf9}, {0xf5},
		{0xf6, 0xe3}, {0xf6, 0xeb}, {0xf6, 0xe4}, {0xf6, 0xec},
		{0x66, 0xf7, 0xe3}, {0x66, 0xf7, 0xeb}, {0xf7, 0xe3}, {0xf7, 0xeb},
		{0x48, 0xf7, 0xe3}, {0x48, 0xf7, 0xeb}, {0x48, 0xf7, 0xe0}, {0x48, 0xf7, 0xea}}
	values := []uint64{0, 1, 2, 0x7f, 0x80, 0xff, 0x7fff, 0x8000, 0xffff, 0x7fffffff, 0x80000000, 0xffffffff, 0x7fffffffffffffff, 0x8000000000000000, ^uint64(0)}
	for _, mode := range []string{"ir", "native"} {
		for _, code := range codes {
			base := testCPU(t, code)
			cfg := engine.DefaultEngineConfig()
			cfg.Mode, cfg.IRThreshold, cfg.NativeThreshold, cfg.MaxInstructions, cfg.MaxRegionInstructions = mode, 1, 1, 1, 1
			e, err := engine.New(cfg, Architecture())
			if err != nil {
				t.Fatal(err)
			}
			for _, a := range values {
				for _, rhs := range values {
					expected := *base
					expected.R[RAX], expected.R[RBX], expected.R[RDX] = a, rhs, 0xdeadbeef01234567
					expected.Flags = 2 | FlagIF | FlagDF | arithmeticFlags
					actual := expected
					adapter := NewAdapter(&actual)
					if err := expected.Step(); err != nil {
						t.Fatal(err)
					}
					if err := e.Step(adapter, 1); err != nil {
						t.Fatal(err)
					}
					adapter.Export()
					if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != expected.Retired {
						t.Fatalf("%s %x a=%x rhs=%x: registers=%x/%x flags=%x/%x", mode, code, a, rhs, actual.R, expected.R, actual.Flags, expected.Flags)
					}
				}
			}
			if mode == "native" && e.NativeAvailable() && e.Stats.Native < uint64(len(values)*len(values)-1) {
				t.Fatal("new operation stayed interpreted", code, e.Stats)
			}
			if err := e.Close(); err != nil {
				t.Fatal(err)
			}
		}
	}
}

func TestNativePushFlagsPreciseProtectedStack(t *testing.T) {
	for _, push := range [][]byte{{0x9c}, {0x66, 0x9c}} {
		code := append([]byte{0xfc}, push...)
		code = append(code, 0xeb, byte(256-len(code)-2))
		expected, actual := testCPU(t, code), testCPU(t, code)
		for _, c := range []*CPU{expected, actual} {
			if err := c.Memory.(*linuxuser.Memory).Map(0x4000, 8192, 3); err != nil {
				t.Fatal(err)
			}
			c.R[RSP] = 0x5800
			c.Flags = 2 | FlagDF | FlagIF | arithmeticFlags
		}
		cfg := engine.DefaultEngineConfig()
		cfg.IRThreshold, cfg.NativeThreshold = 1, 1
		e, err := engine.New(cfg, Architecture())
		if err != nil {
			t.Fatal(err)
		}
		adapter := NewAdapter(actual)
		for n := 0; n < 192; n++ {
			if err := expected.Step(); err != nil {
				t.Fatal(err)
			}
			if err := e.Step(adapter, 1); err != nil {
				t.Fatal(err)
			}
			adapter.Export()
		}
		if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != expected.Retired {
			t.Fatal("warmed flags stack differs")
		}
		for a := uint64(0x4000); a < 0x6000; a += 8 {
			x, _ := expected.Memory.Read(a, 8, false)
			y, _ := actual.Memory.Read(a, 8, false)
			if x != y {
				t.Fatalf("PUSHF stack differs at %x", a)
			}
		}
		if e.NativeAvailable() && e.Stats.Native == 0 {
			t.Fatal("PUSHF never native")
		}
		for _, c := range []*CPU{expected, actual} {
			c.PC = 0x1000
			c.Flags |= FlagDF
			if err := c.Memory.(*linuxuser.Memory).Protect(0x4000, 8192, 1); err != nil {
				t.Fatal(err)
			}
		}
		adapter.Import()
		if err := expected.Step(); err != nil {
			t.Fatal(err)
		}
		if err := expected.Step(); err == nil {
			t.Fatal("expected protected PUSHF fault")
		}
		if err := e.RunQuanta(adapter, 64); err == nil {
			t.Fatal("native PUSHF bypassed protection")
		}
		adapter.Export()
		if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != expected.Retired {
			t.Fatal("PUSHF fault lost preceding CLD or changed SP")
		}
		if err := e.Close(); err != nil {
			t.Fatal(err)
		}
	}
}

-- fwait_test.go --
package amd64

import (
	"errors"
	"testing"
)

func TestFWAITExceptionsAndRetirement(t *testing.T) {
	for _, tc := range []struct {
		name            string
		cr0             uint64
		control, status uint16
		vector          uint8
	}{
		{"clear", 0x22, 0x37f, 0, 0},
		{"masked", 0x22, 0x37f, 0x3f, 0},
		{"ts_only", 0x28, 0x37f, 0, 0},
		{"mp_only", 0x22, 0x37f, 0, 0},
		{"em_only", 0x24, 0x37f, 0, 0},
		{"mp_ts", 0x2a, 0x37f, 0, 7},
		{"unmasked", 0x22, 0x37e, 1, 16},
		{"precision", 0x22, 0x35f, 0x20, 16},
		{"nm_before_mf", 0x2a, 0x37e, 1, 7},
	} {
		t.Run(tc.name, func(t *testing.T) {
			m := newSystemRAM()
			m.data[0x1000] = 0x9b
			c := &CPU{PC: 0x1000, Flags: 0xa43, FPControl: tc.control, FPStatus: tc.status}
			s := NewSystem(c, m, nil)
			s.CR[0] = tc.cr0
			c.R[RAX] = 0x12345678
			i, err := Decode(c.Memory, c.PC)
			if err != nil || i.Op != "fwait" || i.Next != 0x1001 {
				t.Fatalf("decode: %+v %v", i, err)
			}
			err = c.Execute(i)
			if tc.vector != 0 {
				var ex *Exception
				if !errors.As(err, &ex) || ex.Vector != tc.vector || ex.HasCode {
					t.Fatalf("expected exception %d, got %v", tc.vector, err)
				}
				if c.PC != 0x1000 || c.Retired != 0 {
					t.Fatalf("fault retired or advanced PC: %#x %d", c.PC, c.Retired)
				}
			} else if err != nil || c.PC != 0x1001 || c.Retired != 1 {
				t.Fatalf("retirement: %#x %d %v", c.PC, c.Retired, err)
			}
			if c.Flags != 0xa43 || c.R[RAX] != 0x12345678 || c.FPControl != tc.control || c.FPStatus != tc.status {
				t.Fatal("WAIT modified architectural data")
			}
		})
	}
}

func TestFWAITPrefixesAndFINITBoundary(t *testing.T) {
	c := testCPU(t, []byte{0x66, 0x9b, 0xdb, 0xe3})
	c.FPControl, c.FPStatus = 0x37f, 0x3f
	step(t, c)
	if c.PC != 0x1002 || c.Retired != 1 || c.FPStatus != 0x3f {
		t.Fatal("WAIT consumed following FNINIT or altered status")
	}
	step(t, c)
	if c.PC != 0x1004 || c.Retired != 2 || c.FPControl != 0x37f || c.FPStatus != 0 {
		t.Fatal("FNINIT did not execute separately")
	}
	c = testCPU(t, []byte{0xf0, 0x9b})
	var ex *Exception
	if _, err := Decode(c.Memory, c.PC); !errors.As(err, &ex) || ex.Vector != 6 {
		t.Fatalf("LOCK WAIT must raise #UD: %v", err)
	}
}

-- half_test.go --
package amd64

import (
	"encoding/binary"
	"testing"
)

func TestSSEHalfMoves(t *testing.T) {
	for _, test := range []struct {
		code   []byte
		lo, hi uint64
	}{
		{[]byte{0x0f, 0x16, 0xc1}, 1, 3},       // MOVLHPS
		{[]byte{0x0f, 0x12, 0xc1}, 4, 2},       // MOVHLPS
		{[]byte{0x0f, 0x16, 0xc0}, 1, 1},       // aliased MOVLHPS
		{[]byte{0x0f, 0x12, 0xc0}, 2, 2},       // aliased MOVHLPS
		{[]byte{0x0f, 0x16, 0x00}, 1, 5},       // MOVHPS memory
		{[]byte{0x66, 0x0f, 0x12, 0x00}, 5, 2}, // MOVLPD memory
	} {
		c := testCPU(t, test.code)
		c.R[RAX] = 0x1800
		c.Memory.Write(0x1800, 8, 5)
		binary.LittleEndian.PutUint64(c.XMM[0][:], 1)
		binary.LittleEndian.PutUint64(c.XMM[0][8:], 2)
		binary.LittleEndian.PutUint64(c.XMM[1][:], 3)
		binary.LittleEndian.PutUint64(c.XMM[1][8:], 4)
		step(t, c)
		if binary.LittleEndian.Uint64(c.XMM[0][:]) != test.lo || binary.LittleEndian.Uint64(c.XMM[0][8:]) != test.hi {
			t.Fatalf("%x: %x", test.code, c.XMM[0])
		}
	}
	c := testCPU(t, []byte{0x0f, 0x17, 0x00}) // MOVHPS [RAX],XMM0
	c.R[RAX] = 0x1800
	binary.LittleEndian.PutUint64(c.XMM[0][8:], 0x1122334455667788)
	c.Memory.Write(0x1808, 8, 99)
	step(t, c)
	if got, _ := c.Memory.Read(0x1800, 8, false); got != 0x1122334455667788 {
		t.Fatal("high-half store", got)
	}
	if got, _ := c.Memory.Read(0x1808, 8, false); got != 99 {
		t.Fatal("half store overwrote adjacent memory", got)
	}
}

-- instruction_window_fault_test.go --
package amd64

import "testing"

// Wrapping only Memory deliberately hides the optional capability, providing
// the original demand-by-byte reference without changing the decoder.
type scalarInstructionMemory struct{ Memory }

func TestInstructionWindowSystemNXFaultMatchesScalar(t *testing.T) {
	for _, cached := range []bool{false, true} {
		physical := &instructionWindowProbe{data: make([]byte, 16384), denied: ^uint64(0)}
		code := []byte{0x48, 0xb8, 1, 2, 3, 4, 5, 6, 7, 8}
		copy(physical.data[8190:], code)
		c := &CPU{PC: 8190}
		s := NewSystem(c, physical, nil)
		s.CR[0], s.EFER = 1<<31, 1<<10|1<<11
		// The two bytes on the first page are valid; the immediate on the next
		// page must deliver exactly one execute protection fault, never prefetch.
		s.tlb[1] = pageEntry{physical: 4096, user: true}
		s.tlb[2] = pageEntry{physical: 8192, user: true, nx: true}
		var memory Memory = s
		if !cached {
			memory = scalarInstructionMemory{s}
		}
		_, err := Decode(memory, 8190)
		fault, ok := err.(*Exception)
		if !ok || fault.Vector != 14 || fault.Address != 8192 || fault.Code != 17 || s.CR[2] != 8192 || s.FaultCount != 1 || c.PC != 8190 || c.Retired != 0 {
			t.Fatal("execute fault differs", cached, err, s.CR[2], s.FaultCount, c.PC, c.Retired)
		}
	}
}
func TestInstructionWindowSystemInvalidationAndDemandOnly(t *testing.T) {
	physical := &instructionWindowProbe{data: make([]byte, 16384), denied: ^uint64(0)}
	c := &CPU{PC: 8191}
	s := NewSystem(c, physical, nil)
	s.CR[0], s.EFER = 1<<31, 1<<10|1<<11
	physical.data[8191] = 0x90
	s.tlb[1] = pageEntry{physical: 4096, user: true}
	if _, err := Decode(s, 8191); err != nil || s.FaultCount != 0 {
		t.Fatal("unused next page fetched", err, s.FaultCount)
	}
	entry := s.tlb[1]
	s.fastTLB[systemFastPageSlot(1)] = systemFastPage{number: 1, generation: s.tlbGeneration, valid: true, entry: entry}
	s.invalidatePage(4096)
	if s.InstructionBytes(8191) != nil || s.FaultCount != 0 {
		t.Fatal("revoked execute translation reused")
	}
}

-- instruction_window_test.go --
package amd64

import (
	"errors"
	"testing"
)

type instructionWindowProbe struct {
	data    []byte
	reads   []uint64
	windows []uint64
	denied  uint64
}

func (m *instructionWindowProbe) Read(a uint64, n int, x bool) (uint64, error) {
	m.reads = append(m.reads, a)
	if n != 1 || a >= uint64(len(m.data)) || a>>12 == m.denied {
		return 0, errors.New("execute fault")
	}
	return uint64(m.data[a]), nil
}
func (m *instructionWindowProbe) Write(uint64, int, uint64) error {
	return errors.New("unexpected write")
}
func (m *instructionWindowProbe) InstructionBytes(a uint64) []byte {
	m.windows = append(m.windows, a)
	if a >= uint64(len(m.data)) || a>>12 == m.denied {
		return nil
	}
	// Intentionally expose beyond the page to verify decoder-side clamping.
	return m.data[a:]
}
func TestInstructionWindowDemandFaultsLifetimeAndLimit(t *testing.T) {
	code := []byte{0x48, 0xb8, 1, 2, 3, 4, 5, 6, 7, 8}
	m := &instructionWindowProbe{data: make([]byte, 12288), denied: ^uint64(0)}
	copy(m.data[4090:], code)
	got, err := Decode(m, 4090)
	if err != nil || got.Next != 4100 || got.Src.Imm != 0x0807060504030201 || len(m.reads) != 0 || len(m.windows) != 2 {
		t.Fatal("cross-page demand fetch", got, err, m.reads, m.windows)
	}
	m.reads, m.windows = nil, nil
	m.denied = 1
	if _, err = Decode(m, 4090); err == nil || len(m.reads) != 1 || m.reads[0] != 4096 || len(m.windows) != 2 {
		t.Fatal("late execute fault hidden", err, m.reads, m.windows)
	}
	// No read or permission query of an unused page after a one-byte instruction.
	m.reads, m.windows = nil, nil
	m.data[4095] = 0x90
	if ins, err := Decode(m, 4095); err != nil || ins.Next != 4096 || len(m.reads) != 0 || len(m.windows) != 1 {
		t.Fatal("overfetched next page", ins, err, m.reads, m.windows)
	}
	// CPU scratch must discard both borrowed RAM and capability after a decode.
	m.denied = ^uint64(0)
	c := &CPU{}
	copy(m.data[100:], code)
	if _, err := c.decodeInstruction(m, 100); err != nil {
		t.Fatal(err)
	}
	if c.decodeScratch.window != nil || c.decodeScratch.windowSource != nil || c.decodeScratch.memory != nil {
		t.Fatal("borrow survived decode")
	}
	m.data[102] = 77
	ins, err := c.decodeInstruction(m, 100)
	if err != nil || ins.Src.Imm&255 != 77 {
		t.Fatal("stale decode", ins, err)
	}
	m.denied = 0
	m.windows = nil
	if _, err := Decode(m, 100); err == nil || len(m.windows) != 1 {
		t.Fatal("denied cached execute query did not take demand fault", err, m.windows)
	}
	m.denied = ^uint64(0)
	for i := 0; i < 16; i++ {
		m.data[100+i] = 0x66
	}
	m.data[116] = 0x90
	if _, err := Decode(m, 100); err == nil {
		t.Fatal("15-byte limit bypassed")
	}
}
func TestInstructionWindowCachedExecutePermissionAndFullTag(t *testing.T) {
	m := &instructionWindowProbe{data: make([]byte, 32768), denied: ^uint64(0)}
	s := &System{Physical: m, tlb: make(map[uint64]pageEntry)}
	s.CR[0], s.EFER = 1<<31, 1<<10
	s.CR[2], s.FaultCount = 91, 7
	if s.InstructionBytes(4096) != nil || len(m.reads) != 0 || len(m.windows) != 0 {
		t.Fatal("uncached window walked")
	}
	e := pageEntry{physical: 8192, user: true}
	s.tlb[1] = e
	if w := s.InstructionBytes(4100); len(w) != 4092 || len(m.windows) != 1 || m.windows[0] != 8196 {
		t.Fatal("wrong physical range", len(w), m.windows)
	}
	e.nx = true
	s.tlb[1] = e
	if s.InstructionBytes(4100) != nil {
		t.Fatal("NX window")
	}
	e.nx = false
	e.user = false
	s.tlb[1] = e
	s.CPL = 3
	if s.InstructionBytes(4100) != nil {
		t.Fatal("kernel window in user mode")
	}
	s.CPL = 0
	if s.InstructionBytes(0x0000800000001004) != nil {
		t.Fatal("noncanonical window")
	}
	high := uint64(0xffff800000001)
	s.fastTLB[systemFastPageSlot(high)] = systemFastPage{number: 1, generation: s.tlbGeneration, valid: true, entry: e}
	if s.InstructionBytes(high<<12|4) != nil {
		t.Fatal("truncated cache tag")
	}
	if s.CR[2] != 91 || s.FaultCount != 7 || len(m.reads) != 0 {
		t.Fatal("query delivered a fault or read ahead")
	}
}

-- irq.go --
package amd64

func (s *System) Interruptible() bool { return s.CPU.Flags&FlagIF != 0 && s.IRQShadow == 0 }

-- native_test.go --
package amd64

import (
	"renvo.dev/internal/rfe/engine"
	"renvo.dev/internal/rfe/linuxuser"
	"testing"
)

func TestNativeAndIRInstructionDifferential(t *testing.T) {
	codes := [][]byte{
		{0x48, 0x01, 0xd8}, {0x01, 0xd8}, {0x66, 0x01, 0xd8}, {0x00, 0xd8},
		{0x48, 0x29, 0xd8}, {0x29, 0xd8}, {0x66, 0x29, 0xd8}, {0x28, 0xd8},
		{0x48, 0x39, 0xd8}, {0x48, 0x21, 0xd8}, {0x48, 0x09, 0xd8}, {0x48, 0x31, 0xd8},
		{0x48, 0xff, 0xc0}, {0x48, 0xff, 0xc8}, {0x48, 0xf7, 0xd8}, {0x48, 0xf7, 0xd0},
		{0x48, 0x0f, 0xaf, 0xc3}, {0x0f, 0xaf, 0xc3}, {0x66, 0x0f, 0xaf, 0xc3},
		{0x48, 0x6b, 0xc3, 0xfd}, {0x0f, 0xb6, 0xc4}, {0x48, 0x0f, 0xbe, 0xc4},
		{0x48, 0x0f, 0xbf, 0xc3}, {0x48, 0x63, 0xc3}, {0x48, 0x8d, 0x44, 0xcb, 0xf0},
		{0x48, 0xb8, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88},
		{0x48, 0xd3, 0xe0}, {0x48, 0xd3, 0xe8}, {0x48, 0xd3, 0xf8},
		{0xd3, 0xe0}, {0xd3, 0xe8}, {0xd3, 0xf8},
		{0x66, 0xc1, 0xe0, 3}, {0x66, 0xc1, 0xe8, 3}, {0x66, 0xc1, 0xf8, 3},
		{0xc0, 0xe0, 3}, {0xc0, 0xe8, 3}, {0xc0, 0xf8, 3},
		{0x66, 0xc1, 0xc0, 8}, {0xc0, 0xc0, 4}, {0x66, 0xc1, 0xc8, 8}, {0xc0, 0xc8, 4},
	}
	for cc := byte(0); cc < 16; cc++ {
		codes = append(codes, []byte{0x0f, 0x40 + cc, 0xc3}, []byte{0x0f, 0x90 + cc, 0xc0}, []byte{0x70 + cc, 0x10})
	}
	values := []uint64{0, 1, 0x7f, 0x80, 0x7fff, 0x8000, 0x7fffffff, 0x80000000, 0xffffffff, 0x7fffffffffffffff, 0x8000000000000000, ^uint64(0)}
	for _, mode := range []string{"ir", "native"} {
		for _, code := range codes {
			base := testCPU(t, code)
			config := engine.DefaultEngineConfig()
			config.Mode = mode
			config.IRThreshold = 1
			config.NativeThreshold = 1
			config.MaxInstructions = 1
			config.MaxRegionInstructions = 1
			e, err := engine.New(config, Architecture())
			if err != nil {
				t.Fatal(err)
			}
			for index, v := range values {
				expected := *base
				expected.R[0] = v
				expected.R[RBX] = values[len(values)-1-index]
				expected.R[RCX] = uint64(index * 7)
				expected.Flags = uint64(index)*0x111 | 2
				actual := expected
				adapter := NewAdapter(&actual)
				if err = expected.Step(); err != nil {
					t.Fatal(err)
				}
				if err = e.Step(adapter, 1); err != nil {
					t.Fatalf("%s %x: %v", mode, code, err)
				}
				adapter.Export()
				if actual.R != expected.R || actual.PC != expected.PC || actual.Flags != expected.Flags || actual.Retired != expected.Retired {
					t.Fatalf("%s code=%x value=%#x: R=%x flags=%x pc=%x; want R=%x flags=%x pc=%x", mode, code, v, actual.R, actual.Flags, actual.PC, expected.R, expected.Flags, expected.PC)
				}
			}
			if e.Stats.IR+e.Stats.Native == 0 {
				t.Fatalf("%s %x never compiled", mode, code)
			}
			if mode == "native" && e.NativeAvailable() && e.Stats.Native == 0 {
				t.Fatalf("%x never executed native", code)
			}
			if err = e.Close(); err != nil {
				t.Fatal(err)
			}
		}
	}
}
func TestNativeMemoryFaultsAndBudgets(t *testing.T) {
	// INC RAX; ADD dword [RBX],1; JMP back. The first instruction is permitted
	// to retire before a protected-memory fault; flags after it must survive.
	code := []byte{0x48, 0xff, 0xc0, 0x83, 0x03, 1, 0xeb, 0xf8}
	for _, budget := range []uint64{1, 2, 3, 5, 63, 65, 257} {
		expected := testCPU(t, code)
		actual := testCPU(t, code)
		expected.Memory.(*linuxuser.Memory).Map(0x3000, 4096, 3)
		actual.Memory.(*linuxuser.Memory).Map(0x3000, 4096, 3)
		expected.R[RBX] = 0x3000
		actual.R[RBX] = 0x3000
		config := engine.DefaultEngineConfig()
		config.IRThreshold = 1
		config.NativeThreshold = 1
		e, err := engine.New(config, Architecture())
		if err != nil {
			t.Fatal(err)
		}
		adapter := NewAdapter(actual)
		for expected.Retired < budget {
			step(t, expected)
		}
		for actual.Retired < budget {
			if err = e.RunQuanta(adapter, budget-actual.Retired); err != nil {
				t.Fatal(err)
			}
		}
		adapter.Export()
		if actual.R != expected.R || actual.PC != expected.PC || actual.Flags != expected.Flags || actual.Retired != budget {
			t.Fatal("budget mismatch", budget, actual, expected)
		}
		got, _ := actual.Memory.Read(0x3000, 4, false)
		want, _ := expected.Memory.Read(0x3000, 4, false)
		if got != want {
			t.Fatal("memory", got, want)
		}
		actual.PC = 0x1000
		adapter.Import()
		m := actual.Memory.(*linuxuser.Memory)
		if budget == 257 && e.NativeAvailable() && e.Stats.NativeMemory == 0 {
			t.Fatal("memory never ran native", e.Stats)
		}
		m.Protect(0x3000, 4096, 1)
		before := actual.Retired
		old := actual.R[0]
		for actual.Retired-before < 1 {
			if err = e.RunQuanta(adapter, 3); err != nil {
				break
			}
		}
		if err == nil {
			err = e.RunQuanta(adapter, 3)
		}
		adapter.Export()
		if err == nil || actual.PC != 0x1003 || actual.R[0] != old+1 || actual.Retired != before+1 {
			t.Fatal("precise native fault", err, actual)
		}
		if err = e.Close(); err != nil {
			t.Fatal(err)
		}
	}
}

-- page_metadata.go --
package amd64

func (s *System) setPageTableBits(address, bits uint64) error {
	if memory, ok := s.Physical.(interface{ SetPageTableBits(uint64, uint64) error }); ok {
		return memory.SetPageTableBits(address, bits)
	}
	value, err := s.Physical.Read(address, 8, false)
	if err != nil {
		return err
	}
	return s.Physical.Write(address, 8, value|bits)
}

-- selector_test.go --
package amd64

import (
	"errors"
	"testing"
)

func TestSelectorVerification(t *testing.T) {
	m := newSystemRAM()
	c := &CPU{Flags: 0x202 | CF | ZF}
	s := NewSystem(c, m, nil)
	s.CR[0] = 1
	s.GDTR = Table{Base: 0x1000, Limit: 15}
	for _, test := range []struct {
		name           string
		access         byte
		selector       uint16
		cpl            uint8
		write, allowed bool
	}{
		{"kernel data", 0x92, 8, 0, true, true},
		{"not present still writable", 0x12, 8, 0, true, true},
		{"user data", 0xf2, 11, 3, true, true},
		{"RPL restriction", 0x92, 11, 0, true, false},
		{"CPL restriction", 0x92, 8, 3, true, false},
		{"read-only data", 0x90, 8, 0, true, false},
		{"read-only readable", 0x90, 8, 0, false, true},
		{"code not writable", 0x9a, 8, 0, true, false},
		{"execute-only not readable", 0x98, 8, 0, false, false},
		{"readable code", 0x9a, 8, 0, false, true},
		{"nonconforming code privilege", 0x9a, 11, 3, false, false},
		{"conforming readable code", 0x9e, 11, 3, false, true},
		{"system descriptor", 0x89, 8, 0, false, false},
		{"null", 0x92, 3, 0, true, false},
		{"out of bounds", 0x92, 16, 0, true, false},
		{"missing LDT", 0xf2, 12, 3, true, false},
	} {
		t.Run(test.name, func(t *testing.T) {
			m.Write(0x1008, 8, uint64(test.access)<<40)
			s.CPL = test.cpl
			c.R[RAX] = uint64(test.selector)
			c.Flags = 0x202 | CF | ZF
			m.data[0], m.data[1], m.data[2] = 0x0f, 0x00, 0xe8
			if !test.write {
				m.data[2] = 0xe0
			}
			i, err := Decode(s, 0)
			if err != nil {
				t.Fatal(err)
			}
			if err = c.Execute(i); err != nil {
				t.Fatal(err)
			}
			if (c.Flags&ZF != 0) != test.allowed || c.Flags&^ZF != (0x202|CF) || c.R[RAX] != uint64(test.selector) || c.PC != 3 {
				t.Fatalf("flags=%#x selector=%#x pc=%#x", c.Flags, c.R[RAX], c.PC)
			}
		})
	}
	s.CPL = 3
	s.LDTR = Segment{Selector: 16, Base: 0x2000, Limit: 7}
	m.Write(0x2000, 8, uint64(0xf2)<<40)
	if allowed, err := s.verifySelector(7, true); !allowed || err != nil {
		t.Fatal("LDT index zero", allowed, err)
	}
	s.GDTR.Base = uint64(len(m.data))
	_, err := s.verifySelector(8, true)
	var fault *Exception
	if !errors.As(err, &fault) || fault.Vector != 14 || s.supervisor {
		t.Fatal("descriptor memory fault/supervisor restore", err)
	}
}

-- shuffle_test.go --
package amd64

import (
	"encoding/binary"
	"testing"
)

func TestSSEShuffleLaneSelection(t *testing.T) {
	for _, test := range []struct {
		code []byte
		want [4]uint32
	}{
		{[]byte{0x0f, 0xc6, 0xc1, 0x1b}, [4]uint32{4, 3, 11, 10}},
		{[]byte{0x0f, 0xc6, 0xc0, 0x1b}, [4]uint32{4, 3, 2, 1}},
		{[]byte{0x66, 0x0f, 0xc6, 0xc1, 0xfd}, [4]uint32{3, 4, 10, 11}},
	} {
		c := testCPU(t, test.code)
		for j := 0; j < 4; j++ {
			binary.LittleEndian.PutUint32(c.XMM[0][j*4:], uint32(j+1))
			binary.LittleEndian.PutUint32(c.XMM[1][j*4:], uint32(j+10))
		}
		c.Flags = 0x202 | CF | ZF
		step(t, c)
		for j, want := range test.want {
			if got := binary.LittleEndian.Uint32(c.XMM[0][j*4:]); got != want {
				t.Fatalf("code %x lane %d=%d want %d", test.code, j, got, want)
			}
		}
		if c.PC != 0x1000+uint64(len(test.code)) || c.Flags != 0x202|CF|ZF {
			t.Fatalf("length/flags pc=%d flags=%#x", c.PC, c.Flags)
		}
	}
	c := testCPU(t, []byte{0x0f, 0xc6, 0x00, 0xe4}) // SHUFPS XMM0,[RAX],0xe4
	c.R[RAX] = 0x1800
	c.Memory.Write(0x1808, 8, 0x8877665544332211)
	step(t, c)
	if binary.LittleEndian.Uint64(c.XMM[0][8:]) != 0x8877665544332211 {
		t.Fatal("memory shuffle", c.XMM[0])
	}
}

func TestREXAccumulatorExchange(t *testing.T) {
	for _, test := range []struct {
		code   []byte
		ax, r8 uint64
	}{
		{[]byte{0x41, 0x90}, 0x44332211, 0x88776655},
		{[]byte{0x49, 0x90}, 0xaabbccdd44332211, 0x1122334488776655},
		{[]byte{0x66, 0x41, 0x90}, 0x1122334488772211, 0xaabbccdd44336655},
	} {
		c := testCPU(t, test.code)
		c.R[RAX], c.R[8] = 0x1122334488776655, 0xaabbccdd44332211
		c.Flags = 0x202 | CF | ZF
		step(t, c)
		if c.R[RAX] != test.ax || c.R[8] != test.r8 || c.Flags != 0x202|CF|ZF {
			t.Fatalf("%x: ax=%#x r8=%#x flags=%#x", test.code, c.R[RAX], c.R[8], c.Flags)
		}
	}
	c := testCPU(t, []byte{0x90})
	c.R[RAX] = ^uint64(0)
	step(t, c)
	if c.R[RAX] != ^uint64(0) {
		t.Fatal("NOP must not zero extend EAX")
	}
}

-- signed_memory_test.go --
package amd64

import (
	"renvo.dev/internal/rfe/engine"
	"renvo.dev/internal/rfe/linuxuser"
	"testing"
)

func TestNativeSignedMemoryResultsAndFault(t *testing.T) {
	for _, code := range [][]byte{{0x0f, 0xbe, 3}, {0x0f, 0xbf, 3}, {0x48, 0x0f, 0xbe, 3}, {0x48, 0x0f, 0xbf, 3}, {0x48, 0x63, 3}} {
		base := testCPU(t, code)
		m := base.Memory.(*linuxuser.Memory)
		if err := m.Map(0x3000, 4096, 3); err != nil {
			t.Fatal(err)
		}
		cfg := engine.DefaultEngineConfig()
		cfg.IRThreshold = 1
		cfg.NativeThreshold = 1
		cfg.MaxInstructions = 1
		cfg.MaxRegionInstructions = 1
		e, err := engine.New(cfg, Architecture())
		if err != nil {
			t.Fatal(err)
		}
		for _, value := range []uint64{0, 0x7f, 0x80, 0xff, 0x7fff, 0x8000, 0xffff, 0x7fffffff, 0x80000000, 0xffffffff} {
			if err = m.Write(0x3000, 8, value); err != nil {
				t.Fatal(err)
			}
			expected := *base
			expected.R[RBX] = 0x3000
			expected.R[RAX] = ^uint64(0)
			actual := expected
			adapter := NewAdapter(&actual)
			step(t, &expected)
			if err = e.Step(adapter, 1); err != nil {
				t.Fatal(err)
			}
			adapter.Export()
			if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC {
				t.Fatalf("code=%x value=%x actual=%x expected=%x", code, value, actual.R, expected.R)
			}
		}
		if e.NativeAvailable() && e.Stats.NativeMemory == 0 {
			t.Fatal("signed load never ran natively", e.Stats)
		}
		actual := *base
		actual.R[RBX] = 0x3000
		adapter := NewAdapter(&actual)
		if err = m.Protect(0x3000, 4096, 0); err != nil {
			t.Fatal(err)
		}
		before := actual.R
		if err = e.Step(adapter, 1); err == nil {
			t.Fatal("protected signed load succeeded")
		}
		adapter.Export()
		if actual.R != before || actual.PC != base.PC || actual.Retired != 0 {
			t.Fatal("fault committed state")
		}
		if err = e.Close(); err != nil {
			t.Fatal(err)
		}
	}
}

-- string_compiled_probe.go --
package amd64

import (
	"fmt"
	emu "renvo.dev/internal/rfe/runtime"
)

type stringProbeMemory struct {
	data [4096]byte
	code []byte
}

func (m *stringProbeMemory) Read(a uint64, n int, x bool) (uint64, error) {
	if x {
		if a < 0x10000 || a-0x10000 >= uint64(len(m.code)) || uint64(n) > uint64(len(m.code))-(a-0x10000) {
			return 0, fmt.Errorf("probe fetch range")
		}
		return uint64(m.code[a-0x10000]), nil
	}
	if a > 4096 || uint64(n) > 4096-a {
		return 0, fmt.Errorf("probe read range")
	}
	var v uint64
	for j := 0; j < n; j++ {
		v |= uint64(m.data[a+uint64(j)]) << uint(j*8)
	}
	return v, nil
}
func (m *stringProbeMemory) Write(a uint64, n int, v uint64) error {
	if a > 4096 || uint64(n) > 4096-a {
		return fmt.Errorf("probe write range")
	}
	for j := 0; j < n; j++ {
		m.data[a+uint64(j)] = byte(v >> uint(j*8))
	}
	return nil
}

// ProbeCompiledStrings compares the real generated backend with architectural
// semantics, including zero-count no-access, DF, comparison stopping, and exits
// that must commit neither pointers nor flags. Browsers execute the same probe.
func ProbeCompiledStrings() error {
	n, err := emu.NewNative(1 << 20)
	if err != nil {
		return err
	}
	defer n.Close()
	arch := Architecture()
	var page [4096]byte
	clock, epoch := uint64(1), uint64(1)
	m := &emu.MemoryContext{}
	m.Clock = &clock
	for _, opcode := range [5]byte{0xa4, 0xaa, 0xac, 0xa6, 0xae} {
		for _, width := range [4]int{1, 2, 4, 8} {
			for _, repeat := range [3]byte{0, 0xf2, 0xf3} {
				ref := &stringProbeMemory{}
				if repeat != 0 {
					ref.code = append(ref.code, repeat)
				}
				if width == 2 {
					ref.code = append(ref.code, 0x66)
				}
				if width == 8 {
					ref.code = append(ref.code, 0x48)
				}
				op := opcode
				if width != 1 {
					op++
				}
				ref.code = append(ref.code, op)
				ins, e := arch.Fetch(ref, 0x10000)
				if e != nil {
					return e
				}
				decoded := DecodedInstruction(ins)
				var b emu.Builder
				b.Reset(true)
				if !arch.Lower(&b, ins, 0) {
					return fmt.Errorf("string lowering rejected")
				}
				b.Checkpoint(stateWords, 1)
				entry, e := n.CompileMemory(b.FinishMemory(stateWords), stateWords)
				if arch.Release != nil {
					arch.Release(ins)
				}
				if e != nil {
					return e
				}
				for _, address := range [4]uint64{64, 4095, 1 << 48, 1 << 60} {
					for _, count := range [3]uint64{0, 1, 4} {
						for _, df := range [2]uint64{0, FlagDF} {
							for j := range ref.data {
								ref.data[j] = byte(j*37 + 11)
							}
							page = ref.data
							clock, epoch = 1, 1
							m.Fill(0, &page, 3, &epoch)
							c := CPU{Memory: ref, PC: 0x10000, Flags: 2 | FlagIF | arithmeticFlags | df}
							c.R[RAX], c.R[RCX], c.R[RSI], c.R[RDI] = 0xa5a55a5a12345678, count, address, address
							a := NewAdapter(&c)
							original := a.state
							if e = n.CallMemory(entry, a.Registers(), m); e != nil {
								return e
							}
							if m.Status == 0 {
								if address == 64 && (repeat == 0 || count != 0) && m.Retired != 1 {
									return fmt.Errorf("string retirement mismatch")
								}
								if e = c.Execute(decoded); e != nil {
									return e
								}
								expected := NewAdapter(&c)
								for j := 0; j < stateWords; j++ {
									if a.state[j] != expected.state[j] {
										return fmt.Errorf("string state mismatch opcode=%d width=%d repeat=%d slot=%d got=%d want=%d", opcode, width, repeat, j, a.state[j], expected.state[j])
									}
								}
								if page != ref.data {
									return fmt.Errorf("string memory mismatch")
								}
							} else {
								if a.state != original || m.Retired != 0 || page != ref.data || clock != 1 || epoch != 1 {
									return fmt.Errorf("string exit committed partial state")
								}
								if address == 64 && (repeat == 0 || count != 0) {
									return fmt.Errorf("valid string iteration exited")
								}
							}
						}
					}
				}
			}
		}
	}
	return nil
}

-- string_compiled_test.go --
package amd64

import "testing"

func TestCompiledStringsFlagsPointersAndPreciseExits(t *testing.T) {
	if err := ProbeCompiledStrings(); err != nil {
		t.Fatal(err)
	}
}

-- system.go --
package amd64

import (
	"errors"
	"fmt"
)

// PortBus belongs to the machine, outside architectural CPU state.
type PortBus interface {
	In(uint16, int) uint32
	Out(uint16, int, uint32)
}
type Table struct {
	Base  uint64
	Limit uint16
}
type Segment struct {
	Selector uint16
	Base     uint64
	Limit    uint32
	Flags    uint16
}
type pageEntry struct {
	physical                  uint64
	writable, user, nx, dirty bool
	pte                       uint64
}

// System holds privileged x86 architectural state. Its memory bus is physical;
// CPU.Memory exposes checked linear access through this state.
type System struct {
	// Bounded fault history for full-system bringup diagnostics.
	FaultCount     uint64
	InterruptEpoch uint64       // host scheduling boundary, including same-CPL software traps
	FaultTrace     [8][3]uint64 // PC, linear address, page-fault error code
	decoded        map[uint64]systemDecode

	IRQShadow uint8

	CPU                                *CPU
	Physical                           Memory
	Ports                              PortBus
	CR                                 [9]uint64
	DR                                 [8]uint64
	EFER, FSBase, GSBase, KernelGSBase uint64
	STAR, LSTAR, CSTAR, SFMASK         uint64
	SYSENTERCS, SYSENTERSP, SYSENTERIP uint64
	GDTR, IDTR                         Table
	Segments                           [6]Segment // ES, CS, SS, DS, FS, GS
	TR, LDTR                           Segment
	CPL                                uint8
	Halted                             bool
	TSC                                uint64
	ExternalClock                      bool // machine owns TSC; retirement does not advance it
	TSCWrites                          uint64
	TSCAdjust                          uint64
	TSCCrystalHz                       uint32
	TSCNumerator, TSCDenominator       uint32
	InvariantTSC                       bool
	MSR                                map[uint32]uint64
	tlb                                map[uint64]pageEntry
	fastTLB                            [1024]systemFastPage
	tlbGeneration                      uint64
	supervisor                         bool
}

const FlagIF uint64 = 1 << 9
const FlagDF uint64 = 1 << 10

type Exception struct {
	Vector  uint8
	Code    uint32
	Address uint64
	HasCode bool
}

func (e *Exception) Error() string {
	return fmt.Sprintf("x86 exception #%d code=%#x address=%#x", e.Vector, e.Code, e.Address)
}
func gp() error { return &Exception{Vector: 13, HasCode: true} }
func NewSystem(c *CPU, physical Memory, ports PortBus) *System {
	s := &System{CPU: c, Physical: physical, Ports: ports, MSR: make(map[uint32]uint64), tlb: make(map[uint64]pageEntry)}
	c.System = s
	c.Memory = s
	return s
}

// Switching roots flushes the architectural translation cache. A physical bus
// may preserve root-tagged native proofs ONLY if it tracks every observed table
// write and all permission/TLBI changes separately. Other buses fully invalidate.
func (s *System) switchAddressSpace() {
	s.clearFastTLB()
	clear(s.tlb)
	s.CPU.cache = nil
	if memory, ok := s.Physical.(interface{ SwitchAddressSpace() }); ok {
		memory.SwitchAddressSpace()
	} else if memory, ok := s.Physical.(interface{ InvalidateMappings() }); ok {
		memory.InvalidateMappings()
	}
}

// A single-page architectural invalidation also revokes native proofs that
// may have been revalidated through the old TLB after a page-table write.
// Its bus hook MUST preserve table watches for all surviving TLB entries.
func (s *System) invalidatePage(address uint64) {
	if memory, ok := s.Physical.(interface{ InvalidatePage(uint64) }); ok {
		key := address >> 12
		fast := &s.fastTLB[systemFastPageSlot(key)]
		if fast.number == key {
			fast.valid = false
		}
		delete(s.tlb, key)
		memory.InvalidatePage(address)
	} else {
		// A bus with only the full-flush contract may release table watches.
		// Evict every architectural entry before invoking that contract.
		s.Flush()
	}
}
func (s *System) Flush() {
	s.clearFastTLB()
	clear(s.tlb)
	// Decoded entries are not mapping grants: decode rechecks execute access,
	// physical identities and page epochs (including the final page) on reuse.
	// Preserve this bounded cache across CR3/TLBI changes instead of repeatedly
	// allocating identical instructions during kernel address-space switches.
	s.CPU.cache = nil
	if memory, ok := s.Physical.(interface{ InvalidateMappings() }); ok {
		memory.InvalidateMappings()
	}
}
func (s *System) Fault(address uint64, write, execute, present bool) error {
	code := uint32(0)
	if present {
		code |= 1
	}
	if write {
		code |= 2
	}
	if s.CPL == 3 && !s.supervisor {
		code |= 4
	}
	if execute {
		code |= 16
	}
	s.FaultTrace[s.FaultCount%uint64(len(s.FaultTrace))] = [3]uint64{s.CPU.PC, address, uint64(code)}
	s.FaultCount++
	s.CR[2] = address
	return &Exception{Vector: 14, Code: code, Address: address, HasCode: true}
}
func (s *System) translateSlow(address uint64, write, execute bool) (uint64, error) {
	if s.CR[0]&(1<<31) == 0 {
		return address, nil
	}
	// Long mode requires canonical linear addresses even before permission checks.
	if s.EFER&(1<<10) != 0 && uint64(int64(address<<16)>>16) != address {
		return 0, gp()
	}
	key := address >> 12
	e, ok := s.tlb[key]
	if !ok {
		// Eviction can expose page-table changes just like explicit TLBI. Do
		// this before walking, so the full-flush bus may release old watches
		// and the new translation then records its dependencies afresh.
		if len(s.tlb) >= 65536 {
			s.Flush()
		}
		if s.CR[4]&(1<<5) == 0 || s.EFER&(1<<10) == 0 {
			return 0, fmt.Errorf("unsupported paging mode cr0=%#x cr4=%#x efer=%#x", s.CR[0], s.CR[4], s.EFER)
		}
		base := s.CR[3] & 0x000ffffffffff000
		e.writable, e.user = true, true
		for level := 3; level >= 0; level-- {
			pteAddress := base + ((address>>uint(12+9*level))&511)*8
			if memory, ok := s.Physical.(interface{ MarkPageTableEntry(uint64) }); ok {
				memory.MarkPageTableEntry(pteAddress)
			} else if memory, ok := s.Physical.(interface{ MarkPageTable(uint64) }); ok {
				memory.MarkPageTable(pteAddress)
			}
			pte, err := s.Physical.Read(pteAddress, 8, false)
			if err != nil {
				return 0, s.Fault(address, write, execute, false)
			}
			if pte&1 == 0 {
				return 0, s.Fault(address, write, execute, false)
			}
			e.writable = e.writable && pte&2 != 0
			e.user = e.user && pte&4 != 0
			e.nx = e.nx || (s.EFER&(1<<11) != 0 && pte>>63 != 0)
			if pte&(1<<5) == 0 {
				if err := s.setPageTableBits(pteAddress, 1<<5); err != nil {
					return 0, err
				}
			}
			if level == 0 || (level == 1 || level == 2) && pte&(1<<7) != 0 {
				shift := uint(12 + 9*level)
				low := uint64(1)<<shift - 1
				e.physical = (pte & 0x000ffffffffff000 &^ low) | (address & low &^ 4095)
				e.dirty = pte&(1<<6) != 0
				e.pte = pteAddress
				break
			}
			base = pte & 0x000ffffffffff000
		}
		s.tlb[key] = e
	}
	user := s.CPL == 3 && !s.supervisor
	if user && !e.user || write && !e.writable && (user || s.CR[0]&(1<<16) != 0) || execute && e.nx {
		// A protection fault must not pin stale permissions across the guest's
		// fault handler. Hardware may evict TLB entries at any time, and Linux
		// can lazily upgrade permissions after a spurious protection fault.
		s.invalidatePage(address)
		return 0, s.Fault(address, write, execute, true)
	}
	if write && !e.dirty {
		if err := s.setPageTableBits(e.pte, 1<<6); err != nil {
			return 0, err
		}
		e.dirty = true
		s.tlb[key] = e
	}
	return e.physical | (address & 4095), nil
}
func (s *System) Read(a uint64, n int, x bool) (uint64, error) {
	if n < 1 || n > 8 || a+uint64(n-1) < a {
		return 0, gp()
	}
	p, e := s.translate(a, false, x)
	if e != nil {
		return 0, e
	}
	if a&4095+uint64(n) <= 4096 {
		return s.Physical.Read(p, n, false)
	}
	var v uint64
	for j := 0; j < n; j++ {
		p, e = s.translate(a+uint64(j), false, x)
		if e != nil {
			return 0, e
		}
		b, e := s.Physical.Read(p, 1, false)
		if e != nil {
			return 0, e
		}
		v |= b << uint(8*j)
	}
	return v, nil
}
func (s *System) Write(a uint64, n int, v uint64) error {
	if n < 1 || n > 8 || a+uint64(n-1) < a {
		return gp()
	}
	p, e := s.translate(a, true, false)
	if e != nil {
		return e
	}
	if a&4095+uint64(n) <= 4096 {
		return s.Physical.Write(p, n, v)
	}
	var addresses [8]uint64
	for j := 0; j < n; j++ {
		addresses[j], e = s.translate(a+uint64(j), true, false)
		if e != nil {
			return e
		}
	}
	for j := 0; j < n; j++ {
		if e = s.Physical.Write(addresses[j], 1, v>>uint(8*j)); e != nil {
			return e
		}
	}
	return nil
}

// VERR/VERW report accessibility in ZF rather than faulting for an invalid
// selector. Descriptor presence is not part of these access-rights queries.
func (s *System) verifySelector(sel uint16, write bool) (bool, error) {
	if s.CR[0]&1 == 0 {
		return false, &Exception{Vector: 6}
	}
	if sel&^3 == 0 {
		return false, nil
	}
	base, limit := s.GDTR.Base, uint64(s.GDTR.Limit)
	if sel&4 != 0 {
		if s.LDTR.Selector&^3 == 0 {
			return false, nil
		}
		base, limit = s.LDTR.Base, uint64(s.LDTR.Limit)
	}
	offset := uint64(sel &^ 7)
	if offset+7 > limit {
		return false, nil
	}
	old := s.supervisor
	s.supervisor = true
	defer func() { s.supervisor = old }()
	descriptor, err := s.Read(base+offset, 8, false)
	if err != nil {
		return false, err
	}
	access := uint8(descriptor >> 40)
	if access&0x10 == 0 { // System descriptors are never readable/writable segments.
		return false, nil
	}
	code := access&8 != 0
	if write {
		if code || access&2 == 0 {
			return false, nil
		}
	} else if code && access&2 == 0 {
		return false, nil
	}
	if !code || access&4 == 0 { // Conforming readable code ignores CPL/RPL.
		dpl := access >> 5 & 3
		if s.CPL > dpl || uint8(sel&3) > dpl {
			return false, nil
		}
	}
	return true, nil
}

func (s *System) descriptor(sel uint16) (Segment, error) {
	table := s.GDTR
	if sel&4 != 0 {
		table = Table{Base: s.LDTR.Base, Limit: uint16(s.LDTR.Limit)}
	}
	off := uint64(sel &^ 7)
	if off+7 > uint64(table.Limit) {
		return Segment{}, gp()
	}
	old := s.supervisor
	s.supervisor = true
	defer func() { s.supervisor = old }()
	v, e := s.Read(table.Base+off, 8, false)
	if e != nil {
		return Segment{}, e
	}
	d := Segment{Selector: sel, Base: (v>>16)&0xffffff | (v>>56)<<24, Limit: uint32(v&65535 | (v>>48&15)<<16), Flags: uint16(v >> 40)}
	if v&(1<<55) != 0 {
		d.Limit = d.Limit<<12 | 4095
	}
	if d.Flags&0x10 == 0 {
		hi, e := s.Read(table.Base+off+8, 8, false)
		if e != nil {
			return d, e
		}
		d.Base |= hi << 32
	}
	return d, nil
}
func (s *System) segment(index uint8, sel uint16) error {
	if index >= 6 {
		return gp()
	}
	if sel&^3 == 0 {
		s.Segments[index] = Segment{Selector: sel}
		return nil
	}
	d, e := s.descriptor(sel)
	if e != nil {
		return e
	}
	if d.Flags&0x80 == 0 {
		return &Exception{Vector: 11, Code: uint32(sel &^ 3), HasCode: true}
	}
	s.Segments[index] = d
	if index == 1 {
		s.CPL = uint8(sel & 3)
	}
	if index == 4 {
		s.FSBase = d.Base
	}
	if index == 5 {
		s.GSBase = d.Base
	}
	return nil
}

// Interrupt enters an IDT interrupt/trap gate, including TSS stack switching.
func (s *System) Interrupt(vector uint8, code uint32, hasCode bool) error {
	s.InterruptEpoch++
	old := s.supervisor
	s.supervisor = true
	defer func() { s.supervisor = old }()
	off := uint64(vector) * 16
	if off+15 > uint64(s.IDTR.Limit) {
		return fmt.Errorf("IDT vector %d outside limit %#x at pc=%#x", vector, s.IDTR.Limit, s.CPU.PC)
	}
	lo, e := s.Read(s.IDTR.Base+off, 8, false)
	if e != nil {
		return e
	}
	hi, e := s.Read(s.IDTR.Base+off+8, 8, false)
	if e != nil {
		return e
	}
	if lo&(1<<47) == 0 {
		return fmt.Errorf("IDT vector %d not present at pc=%#x", vector, s.CPU.PC)
	}
	selector := uint16(lo >> 16)
	d, e := s.descriptor(selector)
	if e != nil {
		return e
	}
	target := (lo & 65535) | ((lo >> 48) << 16) | (hi&0xffffffff)<<32
	c := s.CPU
	oldSP, oldSS := c.R[RSP], s.Segments[2].Selector
	newCPL := uint8(d.Flags >> 5 & 3)
	sp := oldSP
	ist := uint8(lo>>32) & 7
	if ist != 0 || newCPL < s.CPL {
		off := uint64(4 + 8*newCPL)
		if ist != 0 {
			off = 36 + 8*uint64(ist-1)
		}
		sp, e = s.Read(s.TR.Base+off, 8, false)
		if e != nil {
			return e
		}
	}
	sp &^= 15
	values := []uint64{uint64(oldSS), oldSP, c.Flags, uint64(s.Segments[1].Selector), c.PC}
	if hasCode {
		values = append(values, uint64(code))
	}
	for _, v := range values {
		sp -= 8
		if e = s.Write(sp, 8, v); e != nil {
			return e
		}
	}
	c.R[RSP] = sp
	c.PC = target
	c.Flags &^= (1 << 8) | (1 << 14) | (1 << 16) | (1 << 17)
	if lo>>40&15 == 14 {
		c.Flags &^= FlagIF
	}
	s.Segments[1] = d
	s.CPL = newCPL
	if newCPL < uint8(oldSS&3) {
		s.Segments[2] = Segment{Selector: uint16(newCPL)}
	}
	s.Halted = false
	return nil
}
func (s *System) step() error {
	if s.Halted {
		return nil
	}
	i, e := s.decode()
	return s.executeDecoded(i, e)
}

// executeDecoded shares every architectural boundary with step. A cached
// caller must already have validated ALL instruction bytes for execution.
func (s *System) executeDecoded(i Instruction, e error) error {
	if s.Halted {
		return nil
	}
	c := s.CPU
	if e == nil {
		e = c.Execute(i)
	}
	if !s.ExternalClock {
		s.TSC += TSCTicksPerInstruction
	}
	if s.IRQShadow > 0 {
		s.IRQShadow--
	}
	var ex *Exception
	if errors.As(e, &ex) {
		return s.Interrupt(ex.Vector, ex.Code, ex.HasCode)
	}
	if e != nil {
		return fmt.Errorf("pc=%#x %s: %w", c.PC, i.Op, e)
	}
	return nil
}
func (s *System) cpuid(leaf, sub uint32) (a, b, c, d uint32) {
	switch leaf {
	case 0:
		maximum := uint32(1)
		if s.TSCCrystalHz != 0 && s.TSCNumerator != 0 && s.TSCDenominator != 0 {
			maximum = 0x15
		}
		return maximum, 0x756e6547, 0x6c65746e, 0x49656e69 // GenuineIntel
	case 1:
		return 0x00000663, 1 << 16, 0, (1 << 0) | (1 << 3) | (1 << 4) | (1 << 5) | (1 << 6) | (1 << 8) | (1 << 11) | (1 << 13) | (1 << 15) | (1 << 16) | (1 << 23) | (1 << 24) | (1 << 25) | (1 << 26)
	case 7:
		if sub == 0 && s.InvariantTSC {
			return 0, 1 << 1, 0, 0 // Architectural IA32_TSC_ADJUST, implemented below.
		}
	case 0x15:
		return s.TSCDenominator, s.TSCNumerator, s.TSCCrystalHz, 0
	case 0x80000000:
		return 0x80000008, 0, 0, 0
	case 0x80000001:
		return 0, 0, 0, (1 << 11) | (1 << 20) | (1 << 29)
	case 0x80000007:
		if s.InvariantTSC {
			return 0, 0, 0, 1 << 8 // Constant-rate TSC across the modeled idle state.
		}
	case 0x80000008:
		return 0x3028, 0, 0, 0
	}
	return
}
func (s *System) readMSR(n uint32) (uint64, error) {
	switch n {
	case 0xc0000080:
		return s.EFER, nil
	case 0xc0000081:
		return s.STAR, nil
	case 0xc0000082:
		return s.LSTAR, nil
	case 0xc0000083:
		return s.CSTAR, nil
	case 0xc0000084:
		return s.SFMASK, nil
	case 0xc0000100:
		return s.FSBase, nil
	case 0xc0000101:
		return s.GSBase, nil
	case 0xc0000102:
		return s.KernelGSBase, nil
	case 0x10:
		return s.TSC, nil
	case 0x3b:
		if !s.InvariantTSC {
			return 0, gp()
		}
		return s.TSCAdjust, nil
	case 0x1b:
		return 0xfee00000 | 256, nil
	case 0xfe, 0x17:
		return 0, nil
	case 0x174:
		return s.SYSENTERCS, nil
	case 0x175:
		return s.SYSENTERSP, nil
	case 0x176:
		return s.SYSENTERIP, nil
	}
	if v, ok := s.MSR[n]; ok {
		return v, nil
	}
	return 0, gp()
}
func (s *System) writeMSR(n uint32, v uint64) error {
	switch n {
	case 0xc0000080:
		s.EFER = v
		s.Flush()
	case 0xc0000081:
		s.STAR = v
	case 0xc0000082:
		s.LSTAR = v
	case 0xc0000083:
		s.CSTAR = v
	case 0xc0000084:
		s.SFMASK = v
	case 0xc0000100:
		s.FSBase = v
	case 0xc0000101:
		s.GSBase = v
	case 0xc0000102:
		s.KernelGSBase = v
	case 0x10:
		s.TSCWrites++
		if s.InvariantTSC {
			s.TSCAdjust += v - s.TSC
		}
		s.TSC = v
	case 0x3b:
		if !s.InvariantTSC {
			return gp()
		}
		s.TSCWrites++
		s.TSC += v - s.TSCAdjust
		s.TSCAdjust = v
	case 0x174:
		s.SYSENTERCS = v
	case 0x175:
		s.SYSENTERSP = v
	case 0x176:
		s.SYSENTERIP = v
	case 0x277, 0x2ff, 0x1a0, 0x8b, 0x1b:
		s.MSR[n] = v
	default:
		return gp()
	}
	return nil
}

-- system_cache.go --
package amd64

// PhysicalCodeMemory versions every physical byte write, including aliases.
// Buses without this optional contract continue decoding from checked memory.
type PhysicalCodeMemory interface{ CodeEpoch(uint64) uint64 }
type systemDecode struct {
	instruction                        Instruction
	first, last, firstEpoch, lastEpoch uint64
}

func (s *System) decode() (Instruction, error) {
	versioned, ok := s.Physical.(PhysicalCodeMemory)
	if !ok {
		return s.CPU.decodeInstruction(s, s.CPU.PC)
	}
	pc := s.CPU.PC
	first, e := s.translate(pc, false, true)
	if e != nil {
		return Instruction{}, e
	}
	if cached, found := s.decoded[pc]; found && cached.first == first && cached.firstEpoch == versioned.CodeEpoch(first) {
		if pc>>12 == (cached.instruction.Next-1)>>12 {
			return cached.instruction, nil
		}
		last, e := s.translate(cached.instruction.Next-1, false, true)
		if e != nil {
			return Instruction{}, e
		}
		if last == cached.last && cached.lastEpoch == versioned.CodeEpoch(last) {
			return cached.instruction, nil
		}
	}
	i, e := s.CPU.decodeInstruction(s, pc)
	if e != nil {
		return i, e
	}
	last, e := s.translate(i.Next-1, false, true)
	if e != nil {
		return i, e
	}
	if s.decoded == nil {
		s.decoded = make(map[uint64]systemDecode)
	}
	if len(s.decoded) >= 65536 {
		clear(s.decoded)
	}
	s.decoded[pc] = systemDecode{instruction: i, first: first, last: last, firstEpoch: versioned.CodeEpoch(first), lastEpoch: versioned.CodeEpoch(last)}
	return i, nil
}

-- system_cached_mapping_test.go --
package amd64

import "testing"

func TestNativeCachedMappingNeverWalksOrSetsDirtyOrFaults(t *testing.T) {
	s := &System{CPL: 0, tlb: make(map[uint64]pageEntry)}
	s.CR[0] = 1<<31 | 1<<16
	s.CR[4] = 1 << 5
	s.EFER = 1 << 10
	s.CR[2], s.FaultCount = 123, 7
	// Physical is intentionally nil: any accidental walk would fail this test.
	for _, write := range []bool{false, true} {
		if _, _, ok := s.NativeCachedMapping(0x4008, write); ok {
			t.Fatal("uncached page admitted")
		}
	}
	s.tlb[4] = pageEntry{physical: 0x9000, writable: true, user: true}
	if p, w, ok := s.NativeCachedMapping(0x4008, false); !ok || w || p != 0x9008 {
		t.Fatal("clean cached read differs", p, w, ok)
	}
	if _, _, ok := s.NativeCachedMapping(0x4008, true); ok {
		t.Fatal("clean PTE upgraded without architectural write")
	}
	e := s.tlb[4]
	e.dirty = true
	s.tlb[4] = e
	if p, w, ok := s.NativeCachedMapping(0x4008, true); !ok || !w || p != 0x9008 {
		t.Fatal("dirty cached write rejected", p, w, ok)
	}
	e.user = false
	s.tlb[4] = e
	s.CPL = 3
	if _, _, ok := s.NativeCachedMapping(0x4008, false); ok {
		t.Fatal("user read inherited kernel cache")
	}
	s.CPL = 0
	e.writable = false
	s.tlb[4] = e
	if _, _, ok := s.NativeCachedMapping(0x4008, true); ok {
		t.Fatal("WP ignored")
	}
	s.CR[0] &^= 1 << 16
	if _, w, ok := s.NativeCachedMapping(0x4008, true); !ok || !w {
		t.Fatal("kernel WP=0 cache differs")
	}
	if _, _, ok := s.NativeCachedMapping(0x0000800000004008, false); ok {
		t.Fatal("noncanonical address admitted")
	}
	s.supervisor = true
	if _, _, ok := s.NativeCachedMapping(0x4008, false); ok {
		t.Fatal("temporary supervisor mapping admitted")
	}
	if s.CR[2] != 123 || s.FaultCount != 7 || len(s.tlb) != 1 || s.tlb[4] != e {
		t.Fatal("cached query mutated architectural state")
	}
}

-- system_fast_tlb.go --
package amd64

// This is only a bounded lookaside for the architectural TLB, not another
// translation authority. All permission/control checks remain per access; every
// architectural invalidation revokes its exact page or the whole generation.
type systemFastPage struct {
	number, generation uint64
	valid              bool
	entry              pageEntry
}

func systemFastPageSlot(page uint64) uint64 { return (page ^ page>>10) & 1023 }
func (s *System) clearFastTLB() {
	s.tlbGeneration++
	if s.tlbGeneration == 0 {
		clear(s.fastTLB[:])
	}
}
func (s *System) translate(address uint64, write, execute bool) (uint64, error) {
	if s.CR[0]&(1<<31) == 0 {
		return address, nil
	}
	if s.EFER&(1<<10) != 0 && uint64(int64(address<<16)>>16) != address {
		return 0, gp()
	}
	key := address >> 12
	fast := &s.fastTLB[systemFastPageSlot(key)]
	if fast.valid && fast.generation == s.tlbGeneration && fast.number == key {
		e := &fast.entry
		user := s.CPL == 3 && !s.supervisor
		if (!user || e.user) && (!execute || !e.nx) && (!write || e.dirty && (e.writable || !user && s.CR[0]&(1<<16) == 0)) {
			return e.physical | address&4095, nil
		}
	}
	return s.translateFill(address, write, execute)
}

// Cold walking, fault delivery and the first architectural dirty-bit store use
// exactly the original path. Keep its large walker frame off a hot TLB hit.
func (s *System) translateFill(address uint64, write, execute bool) (uint64, error) {
	physical, err := s.translateSlow(address, write, execute)
	if err != nil {
		return 0, err
	}
	key := address >> 12
	if entry, ok := s.tlb[key]; ok {
		fast := &s.fastTLB[systemFastPageSlot(key)]
		*fast = systemFastPage{number: key, generation: s.tlbGeneration, valid: true, entry: entry}
	}
	return physical, nil
}

-- system_fast_tlb_test.go --
package amd64

import "testing"

type fastInvalidationBus struct{ *systemRAM }

func (m *fastInvalidationBus) InvalidatePage(uint64) {}
func (m *fastInvalidationBus) SwitchAddressSpace()   {}
func (m *fastInvalidationBus) InvalidateMappings()   {}

func TestSystemFastTLBRevocationAndFullTags(t *testing.T) {
	m := &fastInvalidationBus{newSystemRAM()}
	s := NewSystem(&CPU{}, m, nil)
	s.CR[0], s.CR[3], s.CR[4], s.EFER = 1<<31|1<<16|1, 0x1000, 1<<5, 1<<10|1<<11
	for a, v := range map[uint64]uint64{0x1000: 0x2027, 0x2000: 0x3027, 0x3000: 0x4027, 0x4040: 0x10067} {
		m.Write(a, 8, v)
	}
	check := func(want uint64) {
		t.Helper()
		for i := 0; i < 2; i++ {
			if p, e := s.translate(0x8001, false, true); e != nil || p != want {
				t.Fatal("translation", p, e, want)
			}
		}
	}
	check(0x10001)
	// No implicit refresh: an ordinary PTE write retains the architectural TLB.
	m.Write(0x4040, 8, 0x11067)
	check(0x10001)
	s.invalidatePage(0x8000)
	check(0x11001)
	m.Write(0x4040, 8, 0x12067)
	s.switchAddressSpace()
	check(0x12001)
	m.Write(0x4040, 8, 0x13067)
	s.Flush()
	check(0x13001)
	// A populated shortcut cannot accept either a noncanonical address or a
	// different full page key with the same bounded cache index.
	if _, e := s.translate(0x0000800000008001, false, false); e == nil {
		t.Fatal("noncanonical fast hit")
	}
	highKey := uint64(0xffff800000008)
	slot := systemFastPageSlot(highKey)
	s.fastTLB[slot] = systemFastPage{number: 8, generation: s.tlbGeneration, valid: true, entry: pageEntry{physical: 0x13000, user: true, dirty: true, writable: true}}
	if _, e := s.translate(highKey<<12|1, false, false); e == nil {
		t.Fatal("full key lost")
	}
	// Wrap must not resurrect a generation-zero entry from a distant past.
	s.fastTLB[systemFastPageSlot(8)] = systemFastPage{number: 8, generation: 0, valid: true, entry: pageEntry{physical: 0xdead000}}
	s.tlbGeneration = ^uint64(0)
	s.Flush()
	check(0x13001)
}
func TestSystemFastTLBPermissionsAndDirtyUpgrade(t *testing.T) {
	m := newSystemRAM()
	s := NewSystem(&CPU{}, m, nil)
	s.CR[0], s.CR[3], s.CR[4], s.EFER = 1<<31|1<<16|1, 0x1000, 1<<5, 1<<10|1<<11
	for a, v := range map[uint64]uint64{0x1000: 0x2027, 0x2000: 0x3027, 0x3000: 0x4027, 0x4040: 0x10023} {
		m.Write(a, 8, v)
	}
	// Read only populates a clean kernel-only mapping. A write must still set D.
	if _, e := s.translate(0x8001, false, false); e != nil {
		t.Fatal(e)
	}
	if e := s.Write(0x8001, 1, 42); e != nil {
		t.Fatal(e)
	}
	pte, _ := m.Read(0x4040, 8, false)
	if pte&(1<<6) == 0 || !s.tlb[8].dirty {
		t.Fatal("cached write skipped dirty-bit update")
	}
	s.CPL = 3
	if _, e := s.translate(0x8001, false, false); e == nil {
		t.Fatal("cached kernel mapping admitted user")
	}
	s.CPL = 0
	// Read-only PTE: kernel WP=0 may write, but changing WP rechecks permissions.
	m.Write(0x4040, 8, 0x10061)
	s.Flush()
	s.CR[0] &^= 1 << 16
	if _, e := s.translate(0x8001, true, false); e != nil {
		t.Fatal(e)
	}
	s.CR[0] |= 1 << 16
	if _, e := s.translate(0x8001, true, false); e == nil {
		t.Fatal("cached write ignored WP")
	}
	m.Write(0x4040, 8, uint64(1)<<63|0x10067)
	s.Flush()
	if _, e := s.translate(0x8001, false, false); e != nil {
		t.Fatal(e)
	}
	if _, e := s.translate(0x8001, false, true); e == nil {
		t.Fatal("cached read granted NX execute")
	}
}

-- system_instruction_window.go --
package amd64

// This is only a query of an already-populated architectural TLB. In
// particular it neither walks nor delivers speculative faults/sets A/D bits.
// Missing/protected mappings return nil; only the exact demand Read faults.
func (s *System) InstructionBytes(address uint64) []byte {
	physical := address
	if s.CR[0]&(1<<31) != 0 {
		if s.EFER&(1<<10) == 0 || uint64(int64(address<<16)>>16) != address {
			return nil
		}
		key := address >> 12
		fast := &s.fastTLB[systemFastPageSlot(key)]
		var entry pageEntry
		if fast.valid && fast.generation == s.tlbGeneration && fast.number == key {
			entry = fast.entry
		} else {
			var present bool
			entry, present = s.tlb[key]
			if !present {
				return nil
			}
		}
		if s.CPL == 3 && !s.supervisor && !entry.user || entry.nx {
			return nil
		}
		physical = entry.physical | address&4095
	}
	if memory, ok := s.Physical.(instructionWindowMemory); ok {
		window := memory.InstructionBytes(physical)
		if limit := int(4096 - address&4095); len(window) > limit {
			window = window[:limit]
		}
		return window
	}
	return nil
}

-- system_native.go --
package amd64

import "fmt"

// NativeMapping is a speculative MMU query, never architectural fault delivery.
// Write descriptors require a dirty PTE: the first write therefore takes the
// architectural path that sets D before subsequent native writes are admitted.
func (s *System) NativeMapping(address uint64, execute bool) (uint64, bool, error) {
	cr2, count, trace := s.CR[2], s.FaultCount, s.FaultTrace
	p, err := s.translate(address, false, execute)
	s.CR[2], s.FaultCount, s.FaultTrace = cr2, count, trace
	if err != nil {
		return 0, false, err
	}
	if (s.CPL != 0 && s.CPL != 3) || s.supervisor {
		return 0, false, fmt.Errorf("native mapping inactive")
	}
	if s.CR[0]&(1<<31) == 0 {
		return p, true, nil
	}
	entry := s.tlb[address>>12]
	user := s.CPL == 3
	writable := entry.writable || !user && s.CR[0]&(1<<16) == 0
	return p, writable && entry.dirty && (!user || entry.user), nil
}

// NativeCachedMapping never walks, changes A/D bits or delivers a fault.
// Only cached ordinary read/write access can be retried inside native code.
func (s *System) NativeCachedMapping(address uint64, write bool) (uint64, bool, bool) {
	if (s.CPL != 0 && s.CPL != 3) || s.supervisor {
		return 0, false, false
	}
	if s.CR[0]&(1<<31) == 0 {
		return address, true, true
	}
	if s.EFER&(1<<10) == 0 || uint64(int64(address<<16)>>16) != address {
		return 0, false, false
	}
	e, ok := s.tlb[address>>12]
	user := s.CPL == 3
	if !ok || user && !e.user {
		return 0, false, false
	}
	writable := e.dirty && (e.writable || !user && s.CR[0]&(1<<16) == 0)
	if write && !writable {
		return 0, false, false
	}
	return e.physical | address&4095, writable, true
}

// NativeRead protects CR2/diagnostic state when a speculative block fetch
// crosses an inaccessible page. The eventual CPU.Step delivers the real fault.
func (s *System) NativeRead(a uint64, n int, execute bool) (uint64, error) {
	cr2, count, trace := s.CR[2], s.FaultCount, s.FaultTrace
	v, err := s.Read(a, n, execute)
	s.CR[2], s.FaultCount, s.FaultTrace = cr2, count, trace
	return v, err
}

-- system_segments_test.go --
package amd64

import "testing"

func TestSystemSegmentsDoNotAdmitUserPersonality(t *testing.T) {
	c := testCPU(t, []byte{0x65, 0x48, 0x8b, 0x03})
	ins, err := Architecture().Fetch(c.Memory, c.PC)
	if err != nil || !ins.InterpretOnly {
		t.Fatal("ordinary user admitted GS", err, ins)
	}
	if err := c.Step(); err == nil || c.Retired != 0 || c.PC != 0x1000 {
		t.Fatal("user segment fault changed", err)
	}
	c.System = &System{GSBase: 0x1800, FSBase: 0x1900}
	ins, err = SystemArchitecture().Fetch(c.Memory, c.PC)
	if err != nil || ins.InterpretOnly {
		t.Fatal("system did not admit GS", err, ins)
	}
	a := NewSystemAdapter(c)
	if a.Registers()[fsBaseSlot] != 0x1900 || a.Registers()[gsBaseSlot] != 0x1800 {
		t.Fatal("segment state import")
	}
	// Export never writes segment state back over an architectural transition.
	c.System.GSBase = 0x1a00
	a.Export()
	if c.System.GSBase != 0x1a00 {
		t.Fatal("export overwrote architectural base")
	}
	a.Import()
	if a.Registers()[gsBaseSlot] != 0x1a00 {
		t.Fatal("base update not imported")
	}
}

-- system_test.go --
package amd64

import (
	"encoding/binary"
	"errors"
	"testing"
)

type systemRAM struct {
	data     []byte
	versions []uint64
}

func newSystemRAM() *systemRAM {
	return &systemRAM{data: make([]byte, 2<<20), versions: make([]uint64, 512)}
}
func (m *systemRAM) Read(a uint64, n int, x bool) (uint64, error) {
	var v uint64
	if a+uint64(n) > uint64(len(m.data)) {
		return 0, &Exception{Vector: 14}
	}
	for j := 0; j < n; j++ {
		v |= uint64(m.data[a+uint64(j)]) << uint(8*j)
	}
	return v, nil
}
func (m *systemRAM) Write(a uint64, n int, v uint64) error {
	if a+uint64(n) > uint64(len(m.data)) {
		return &Exception{Vector: 14}
	}
	for j := 0; j < n; j++ {
		m.data[a+uint64(j)] = byte(v >> uint(8*j))
		m.versions[(a+uint64(j))>>12]++
	}
	return nil
}
func (m *systemRAM) CodeEpoch(a uint64) uint64 { return m.versions[a>>12] }
func TestSystemPagingPermissionsAndAtomicCrossPageWrite(t *testing.T) {
	m := newSystemRAM()
	c := &CPU{}
	s := NewSystem(c, m, nil)
	s.CR[0] = 1<<31 | 1<<16
	s.CR[3] = 0x1000
	s.CR[4] = 1 << 5
	s.EFER = 1<<10 | 1<<11
	s.CPL = 3
	for a, v := range map[uint64]uint64{0x1000: 0x2007, 0x2000: 0x3007, 0x3000: 0x4007, 0x4040: 0x10007} {
		m.Write(a, 8, v)
	}
	if e := s.Write(0x8000, 8, 0x123456789abcdef0); e != nil {
		t.Fatal(e)
	}
	if v, _ := m.Read(0x10000, 8, false); v != 0x123456789abcdef0 {
		t.Fatalf("translation %#x", v)
	}
	pte, _ := m.Read(0x4040, 8, false)
	if pte&0x60 != 0x60 {
		t.Fatalf("accessed/dirty %#x", pte)
	}
	m.data[0x10ffe], m.data[0x10fff] = 0xa5, 0x5a
	e := s.Write(0x8ffe, 4, 0x12345678)
	var fault *Exception
	if !errors.As(e, &fault) || fault.Vector != 14 || fault.Address != 0x9000 || fault.Code != 6 {
		t.Fatalf("cross-page fault %v", e)
	}
	if m.data[0x10ffe] != 0xa5 || m.data[0x10fff] != 0x5a {
		t.Fatal("partial faulting store")
	}
	m.Write(0x4040, 8, 0x10005)
	s.Flush()
	e = s.Write(0x8000, 1, 1)
	if !errors.As(e, &fault) || fault.Code != 7 {
		t.Fatalf("read-only fault %v", e)
	}
	m.Write(0x4040, 8, 0x8000000000010007)
	s.Flush()
	_, e = s.Read(0x8000, 1, true)
	if !errors.As(e, &fault) || fault.Code != 21 {
		t.Fatalf("NX fault %v", e)
	}
}
func TestSystemInterruptStackAndIRETRoundTrip(t *testing.T) {
	m := newSystemRAM()
	c := &CPU{PC: 0x5000, Flags: 0x202}
	c.R[RSP] = 0x7000
	s := NewSystem(c, m, nil)
	s.CPL = 3
	s.GDTR = Table{Base: 0x1000, Limit: 39}
	s.IDTR = Table{Base: 0x2000, Limit: 4095}
	s.TR = Segment{Base: 0x3000, Limit: 103}
	s.Segments[1].Selector = 0x1b
	s.Segments[2].Selector = 0x23
	for a, v := range map[uint64]uint64{0x1008: 0x00af9a000000ffff, 0x1010: 0x00cf92000000ffff, 0x1018: 0x00affa000000ffff, 0x1020: 0x00cff2000000ffff, 0x3004: 0x9000, 0x2200: 0x00008e0000084000} {
		m.Write(a, 8, v)
	}
	if e := s.Interrupt(32, 0, false); e != nil {
		t.Fatal(e)
	}
	if c.PC != 0x4000 || c.R[RSP] != 0x8fd8 || s.CPL != 0 || c.Flags&FlagIF != 0 {
		t.Fatalf("interrupt state pc=%x sp=%x cpl=%d flags=%x", c.PC, c.R[RSP], s.CPL, c.Flags)
	}
	if e := c.Execute(Instruction{Op: "iret", Width: 8}); e != nil {
		t.Fatal(e)
	}
	if c.PC != 0x5000 || c.R[RSP] != 0x7000 || c.Flags != 0x202 || s.CPL != 3 || s.Segments[2].Selector != 0x23 {
		t.Fatal("IRET failed to restore frame")
	}
}
func TestSystemCodeCachePhysicalAliasInvalidation(t *testing.T) {
	m := newSystemRAM()
	c := &CPU{PC: 0x1000}
	s := NewSystem(c, m, nil)
	copy(m.data[0x1000:], []byte{0xb8, 7, 0, 0, 0})
	if e := c.Step(); e != nil {
		t.Fatal(e)
	}
	if c.R[RAX] != 7 {
		t.Fatal(c.R[RAX])
	}
	m.Write(0x1001, 4, 11)
	c.PC = 0x1000
	if e := c.Step(); e != nil {
		t.Fatal(e)
	}
	if c.R[RAX] != 11 {
		t.Fatal("stale cached instruction")
	}
	_ = s
}
func TestSignedWideDivisionAndSIMDStore(t *testing.T) {
	m := newSystemRAM()
	c := &CPU{Memory: m}
	c.R[RAX] = ^uint64(99)
	c.R[RDX] = ^uint64(0)
	c.R[RCX] = 7
	i := Instruction{Op: "idiv", Width: 8, Dst: Operand{Kind: regOperand, Reg: RCX}, Next: 1}
	if e := c.Execute(i); e != nil {
		t.Fatal(e)
	}
	if int64(c.R[RAX]) != -14 || int64(c.R[RDX]) != -2 {
		t.Fatalf("quotient/remainder %d %d", int64(c.R[RAX]), int64(c.R[RDX]))
	}
	binary.LittleEndian.PutUint64(c.XMM[0][:], 0x12345678)
	binary.LittleEndian.PutUint64(c.XMM[0][8:], 0xabcdef09)
	i = Instruction{Op: "vector", CC: 0x7f, Width: 16, Repeat: 0xf3, Dst: Operand{Kind: memOperand, Base: -1, Index: -1, Disp: 0x1000}, Src: Operand{Kind: regOperand, Reg: 0}, Next: 2}
	if e := c.Execute(i); e != nil {
		t.Fatal(e)
	}
	if v, _ := m.Read(0x1008, 8, false); v != 0xabcdef09 {
		t.Fatalf("SIMD store %#x", v)
	}
}

-- timed_adapter.go --
package amd64

import (
	"renvo.dev/internal/rfe/engine"
	emu "renvo.dev/internal/rfe/runtime"
)

// TimedSystemArchitecture requires a caller that imports a synchronized TSC
// base before every native boundary and accounts retired instructions at 100
// TSC ticks each. Ordinary SystemArchitecture does not consume the time slot.
func TimedSystemArchitecture() engine.Architecture { return clockedSystemArchitecture(true) }

// SampledSystemArchitecture uses the machine's oscillator snapshot at native
// entry. It never invents elapsed time from an instruction prefix. The caller
// refreshes that snapshot at every bounded native and architectural boundary.
func SampledSystemArchitecture() engine.Architecture { return clockedSystemArchitecture(false) }

func clockedSystemArchitecture(deterministic bool) engine.Architecture {
	arch := SystemArchitecture()
	arch.StateWords = timedStateWords
	fetch, lower := arch.Fetch, arch.Lower
	arch.Fetch = func(m engine.Memory, pc uint64) (engine.Instruction, error) {
		ins, err := fetch(m, pc)
		if err == nil {
			op := DecodedInstruction(ins).Op
			if op == "rdtsc" || op == "rdtscp" {
				ins.InterpretOnly = false
				ins.Memory = true
				ins.ScheduleBoundary = !deterministic
			}
		}
		return ins, err
	}
	arch.Lower = func(b *emu.Builder, ins engine.Instruction, completed int) bool {
		i := DecodedInstruction(ins)
		if i.Op != "rdtsc" && i.Op != "rdtscp" {
			return lower(b, ins, completed)
		}
		b.Store(pcSlot, b.Constant(i.PC))
		b.Checkpoint(systemStateWords, completed)
		value := b.Load(timeBaseSlot)
		if deterministic {
			value = b.Elapsed(value, TSCTicksPerInstruction, completed)
		}
		b.Store(RAX, b.Binary(emu.And, value, b.Constant(0xffffffff)))
		b.Store(RDX, b.Shift(emu.Shr, value, 32))
		if i.Op == "rdtscp" {
			b.Store(RCX, b.Constant(0))
		}
		b.Store(pcSlot, b.Constant(i.Next))
		return true
	}
	return arch
}

-- tlb_eviction_test.go --
package amd64

import "testing"

type evictionBus struct {
	*systemRAM
	flushes int
	watched map[uint64]bool
}

func (m *evictionBus) InvalidateMappings()         { m.flushes++; clear(m.watched) }
func (m *evictionBus) MarkPageTableEntry(a uint64) { m.watched[a] = true }
func TestBoundedTLBEvictionRevokesBeforeWatchingNewWalk(t *testing.T) {
	m := &evictionBus{systemRAM: newSystemRAM(), watched: make(map[uint64]bool)}
	c := &CPU{}
	s := NewSystem(c, m, nil)
	s.CR[0], s.CR[3], s.CR[4], s.EFER = 1<<31|1<<16|1, 0x1000, 1<<5, 1<<10|1<<11
	for a, v := range map[uint64]uint64{0x1000: 0x2027, 0x2000: 0x3027, 0x3000: 0x4027, 0x4040: 0x10067} {
		if err := m.Write(a, 8, v); err != nil {
			t.Fatal(err)
		}
	}
	for j := uint64(0); j < 65536; j++ {
		s.tlb[0x10000+j] = pageEntry{}
	}
	m.watched[0xdead] = true
	if off, err := s.translate(0x8000, false, true); err != nil || off != 0x10000 {
		t.Fatal("new walk", off, err)
	}
	if m.flushes != 1 || len(s.tlb) != 1 || m.watched[0xdead] {
		t.Fatal("bounded eviction did not revoke old translations", m.flushes, len(s.tlb))
	}
	for _, a := range []uint64{0x1000, 0x2000, 0x3000, 0x4040} {
		if !m.watched[a] {
			t.Fatal("new translation lost its table watch", a)
		}
	}
}

-- tlb_fault_test.go --
package amd64

import (
	"errors"
	"testing"
)

func TestProtectionFaultDoesNotPinStaleTLBPermissions(t *testing.T) {
	m := newSystemRAM()
	c := &CPU{}
	s := NewSystem(c, m, nil)
	s.CR[0], s.CR[3], s.CR[4], s.EFER = 1<<31|1<<16|1, 0x1000, 1<<5, 1<<10|1<<11
	s.CPL = 3
	for a, v := range map[uint64]uint64{0x1000: 0x2007, 0x2000: 0x3007, 0x3000: 0x4007, 0x4040: 0x10005} {
		m.Write(a, 8, v)
	}
	if _, err := s.Read(0x8000, 1, false); err != nil {
		t.Fatal(err)
	}
	// Upgrading a PTE does not retroactively change a cached RO translation.
	m.Write(0x4040, 8, 0x10007)
	err := s.Write(0x8000, 1, 42)
	var fault *Exception
	if !errors.As(err, &fault) || fault.Code != 7 {
		t.Fatal("expected stale RO fault", err)
	}
	// Retrying after the fault must walk the upgraded PTE, not fault forever.
	if err = s.Write(0x8000, 1, 42); err != nil {
		t.Fatal("stale permissions survived protection fault", err)
	}
	if got, _ := m.Read(0x10000, 1, false); got != 42 {
		t.Fatal("retry did not write mapped physical memory", got)
	}
	// Eviction cannot turn a genuinely readonly mapping into a writable one.
	m.Write(0x4040, 8, 0x10005)
	s.Flush()
	for j := 0; j < 2; j++ {
		if err = s.Write(0x8000, 1, 99); !errors.As(err, &fault) || fault.Code != 7 {
			t.Fatal("readonly retry bypassed permission checks", err)
		}
	}
}

-- tsc_clock_test.go --
package amd64

import "testing"

func TestSystemTSCClockMetadataAndAdjustment(t *testing.T) {
	memory := newSystemRAM()
	c := &CPU{PC: 0x5000}
	s := NewSystem(c, memory, nil)
	maximum, _, _, _ := s.cpuid(0, 0)
	_, features, _, _ := s.cpuid(7, 0)
	_, _, _, invariant := s.cpuid(0x80000007, 0)
	if maximum != 1 || features != 0 || invariant != 0 {
		t.Fatal("generic system invented clock capabilities")
	}
	if _, err := s.readMSR(0x3b); err == nil {
		t.Fatal("unadvertised TSC_ADJUST accepted")
	}
	s.TSCCrystalHz, s.TSCNumerator, s.TSCDenominator, s.InvariantTSC = 1193182, 10000, 1, true
	maximum, _, _, _ = s.cpuid(0, 0)
	den, num, hz, _ := s.cpuid(0x15, 0)
	_, features, _, _ = s.cpuid(7, 0)
	_, _, _, invariant = s.cpuid(0x80000007, 0)
	if maximum != 0x15 || den != 1 || num != 10000 || hz != 1193182 || features != 2 || invariant != 1<<8 {
		t.Fatal("clock capabilities do not describe the oscillator")
	}
	if _, f, _, _ := s.cpuid(7, 1); f != 0 {
		t.Fatal("unsupported CPUID subleaf fabricated")
	}
	s.TSC = 1000
	if err := s.writeMSR(0x10, 2000); err != nil {
		t.Fatal(err)
	}
	if value, err := s.readMSR(0x3b); err != nil || value != 1000 {
		t.Fatal("TSC write not accumulated in ADJUST", value, err)
	}
	if err := s.writeMSR(0x3b, 400); err != nil {
		t.Fatal(err)
	}
	if s.TSC != 1400 || s.TSCAdjust != 400 {
		t.Fatal("ADJUST write did not shift counter")
	}
	copy(memory.data[0x5000:], []byte{0x90, 0x90, 0x90, 0x90})
	for i := 0; i < 4; i++ {
		if err := c.Step(); err != nil {
			t.Fatal(err)
		}
	}
	if s.TSC != 1800 || s.TSCAdjust != 400 {
		t.Fatal("normal time modified adjustment")
	}
	if err := s.writeMSR(0x10, ^uint64(0)-20); err != nil {
		t.Fatal(err)
	}
	if s.TSC-s.TSCAdjust != 1400 {
		t.Fatal("modular TSC adjustment lost oscillator base")
	}
	if err := s.writeMSR(0x3b, 0); err != nil {
		t.Fatal(err)
	}
	if s.TSC != 1400 || s.TSCAdjust != 0 || c.Retired != 4 {
		t.Fatal("undoing ADJUST changed time/retirement")
	}
}

-- vector.go --
package amd64

import (
	"encoding/binary"
	"fmt"
)

func (d *decoder) vectorDecode(i *Instruction, op byte, operand16 bool) {
	if op == 0x9b {
		i.Op = "fwait"
		if d.lock {
			d.err = &Exception{Vector: 6}
		}
		return
	}
	if op == 0xdb {
		b := d.byte()
		if b == 0xe3 {
			i.Op = "fninit"
		}
		return
	}
	if op == 0xdf {
		b := d.byte()
		if b == 0xe0 {
			i.Op = "fnstswax"
		}
		return
	}
	if op == 0xd9 || op == 0xdd {
		rm, _, g := d.modrm(2)
		i.Dst = rm
		i.Width = 2
		if op == 0xd9 && g == 7 {
			i.Op = "fnstcw"
		}
		if op == 0xd9 && g == 5 {
			i.Op = "fldcw"
		}
		if op == 0xdd && g == 7 {
			i.Op = "fnstsw"
		}
		return
	}
	if op != 0x0f {
		return
	}
	second := d.second
	if (second == 0x12 || second == 0x13 || second == 0x16 || second == 0x17) && d.repeat == 0 {
		rm, r, _ := d.modrm(8)
		if (second&1 != 0 || operand16) && rm.Kind != memOperand {
			return
		}
		i.Op, i.CC, i.Width = "movhalf", second, 16
		i.Dst, i.Src = r, rm
		if second&1 != 0 {
			i.Dst, i.Src = rm, r
		}
		return
	}
	switch second {
	case 0xc6, 0x10, 0x11, 0x28, 0x29, 0x6f, 0x7f, 0x6e, 0x7e, 0xd6, 0x54, 0x55, 0x56, 0x57, 0xdb, 0xdf, 0xeb, 0xef, 0x74, 0x75, 0x76, 0xd7, 0x70, 0x60, 0x61, 0x62, 0x68, 0x69, 0x6a, 0x6c, 0x6d, 0xfc, 0xfd, 0xfe, 0xd4, 0xf8, 0xf9, 0xfa, 0xfb, 0x73, 0x71, 0x72:
		rm, r, g := d.modrm(8)
		i.Op = "vector"
		i.CC = second
		i.Dst, i.Src = r, rm
		i.Width = 16
		i.SourceWidth = 16
		switch second {
		case 0x11, 0x29, 0x7f, 0xd6:
			i.Dst, i.Src = rm, r
		}
		if second == 0x10 || second == 0x11 {
			if d.repeat == 0xf3 {
				i.Width = 4
			}
			if d.repeat == 0xf2 {
				i.Width = 8
			}
		}
		if second == 0x6e || second == 0x7e {
			i.Width = 4
			if d.rex&8 != 0 {
				i.Width = 8
			}
			if second == 0x7e {
				if d.repeat == 0xf3 {
					i.Width = 8
				} else {
					i.Dst, i.Src = rm, r
				}
			}
		}
		if second == 0xd6 {
			i.Width = 8
		}
		if second == 0x70 || second == 0xc6 {
			i.SourceWidth = d.byte()
		}
		if second == 0xc6 && operand16 {
			i.Op = "shufpd"
		}
		if second == 0x73 || second == 0x71 || second == 0x72 {
			i.Dst = rm
			i.Src = immediate(d.immediate(1, false))
			i.SourceWidth = g
		}
	}
}
func (c *CPU) vectorRead(o Operand, w uint8, next uint64) ([16]byte, error) {
	var v [16]byte
	if o.Kind == regOperand {
		return c.XMM[o.Reg], nil
	}
	a := c.address(o, next)
	for j := 0; j < int(w); j++ {
		b, err := c.Memory.Read(a+uint64(j), 1, false)
		if err != nil {
			return v, err
		}
		v[j] = byte(b)
	}
	return v, nil
}
func (c *CPU) vectorStore(o Operand, w uint8, v [16]byte, next uint64) error {
	if o.Kind == regOperand {
		copy(c.XMM[o.Reg][:w], v[:w])
		return nil
	}
	a := c.address(o, next)
	for j := 0; j < int(w); j++ {
		if err := c.Memory.Write(a+uint64(j), 1, uint64(v[j])); err != nil {
			return err
		}
	}
	return nil
}
func (c *CPU) vectorExecute(i Instruction) (bool, error) {
	var e error
	next := i.Next
	switch i.Op {
	case "fwait":
		// Execution is synchronous, so only pending exceptions need checking.
		// Unlike other x87 operations, WAIT requires both CR0.MP and TS for #NM.
		if c.System != nil && c.System.CR[0]&0xa == 0xa {
			return true, &Exception{Vector: 7}
		}
		if c.FPStatus & ^c.FPControl & 0x3f != 0 {
			return true, &Exception{Vector: 16}
		}
	case "fninit":
		c.FPControl = 0x37f
		c.FPStatus = 0
		c.FPTag = 0
	case "fnstswax":
		c.R[RAX] = c.R[RAX]&^65535 | uint64(c.FPStatus)
	case "fnstsw":
		e = c.write(i.Dst, 2, next, uint64(c.FPStatus))
	case "fnstcw":
		e = c.write(i.Dst, 2, next, uint64(c.FPControl))
	case "fldcw":
		v, err := c.read(i.Dst, 2, next)
		e = err
		if e == nil {
			c.FPControl = uint16(v)
		}
	case "fx":
		address := c.address(i.Dst, next)
		switch i.CC {
		case 0:
			if address&15 != 0 {
				return true, gp()
			}
			var data [512]byte
			binary.LittleEndian.PutUint16(data[:], c.FPControl)
			binary.LittleEndian.PutUint16(data[2:], c.FPStatus)
			data[4] = c.FPTag
			binary.LittleEndian.PutUint32(data[24:], c.MXCSR)
			binary.LittleEndian.PutUint32(data[28:], 0xffff)
			for j := range c.XMM {
				copy(data[160+j*16:], c.XMM[j][:])
			}
			for j := 0; j < 512; j += 8 {
				e = c.Memory.Write(address+uint64(j), 8, binary.LittleEndian.Uint64(data[j:]))
				if e != nil {
					break
				}
			}
		case 1:
			if address&15 != 0 {
				return true, gp()
			}
			var data [512]byte
			for j := 0; j < 512; j += 8 {
				var v uint64
				v, e = c.Memory.Read(address+uint64(j), 8, false)
				if e != nil {
					break
				}
				binary.LittleEndian.PutUint64(data[j:], v)
			}
			if e == nil {
				c.FPControl = binary.LittleEndian.Uint16(data[:])
				c.FPStatus = binary.LittleEndian.Uint16(data[2:])
				c.FPTag = data[4]
				c.MXCSR = binary.LittleEndian.Uint32(data[24:])
				for j := range c.XMM {
					copy(c.XMM[j][:], data[160+j*16:])
				}
			}
		case 2:
			v, err := c.Memory.Read(address, 4, false)
			e = err
			if e == nil {
				if v&^65535 != 0 {
					e = gp()
				} else {
					c.MXCSR = uint32(v)
				}
			}
		case 3:
			e = c.Memory.Write(address, 4, uint64(c.MXCSR))
		case 7: // CLFLUSH has no observable cache state in this interpreter.
			_, e = c.Memory.Read(address, 1, false)
		default:
			e = fmt.Errorf("unsupported FPU state operation /%d", i.CC)
		}
	case "vector", "shufpd", "movhalf":
		if i.Op == "movhalf" {
			if i.CC&1 != 0 {
				value := c.XMM[i.Src.Reg]
				if i.CC == 0x17 {
					copy(value[:8], value[8:])
				}
				e = c.vectorStore(i.Dst, 8, value, next)
			} else {
				width := uint8(8)
				if i.Src.Kind == regOperand {
					width = 16
				}
				var source [16]byte
				source, e = c.vectorRead(i.Src, width, next)
				if e == nil {
					value := c.XMM[i.Dst.Reg]
					if i.CC == 0x16 {
						copy(value[8:], source[:8])
					} else if i.Src.Kind == regOperand {
						copy(value[:8], source[8:])
					} else {
						copy(value[:8], source[:8])
					}
					c.XMM[i.Dst.Reg] = value
				}
			}
			break
		}
		if (i.CC == 0x28 || i.CC == 0x29 || (i.CC == 0x6f || i.CC == 0x7f) && i.Repeat != 0xf3) && ((i.Dst.Kind == memOperand && c.address(i.Dst, next)&15 != 0) || (i.Src.Kind == memOperand && c.address(i.Src, next)&15 != 0)) {
			return true, gp()
		}
		if i.CC == 0x6e {
			v, err := c.read(i.Src, i.Width, next)
			e = err
			if e == nil {
				var data [16]byte
				binary.LittleEndian.PutUint64(data[:], v)
				c.XMM[i.Dst.Reg] = data
			}
			break
		}
		if i.CC == 0x7e && i.Repeat != 0xf3 {
			v := binary.LittleEndian.Uint64(c.XMM[i.Src.Reg][:])
			e = c.write(i.Dst, i.Width, next, v)
			break
		}
		if i.CC == 0xd7 {
			v, err := c.vectorRead(i.Src, 16, next)
			e = err
			if e == nil {
				var mask uint64
				for j, b := range v {
					mask |= uint64(b>>7) << j
				}
				e = c.write(i.Dst, 4, next, mask)
			}
			break
		}
		if i.CC == 0x73 || i.CC == 0x71 || i.CC == 0x72 {
			v := c.XMM[i.Dst.Reg]
			var result [16]byte
			n := i.Src.Imm
			if i.CC == 0x73 && (i.SourceWidth == 3 || i.SourceWidth == 7) {
				if n < 16 {
					if i.SourceWidth == 3 {
						copy(result[:], v[n:])
					} else {
						copy(result[n:], v[:])
					}
				}
			} else {
				width := 2
				if i.CC == 0x72 {
					width = 4
				}
				if i.CC == 0x73 {
					width = 8
				}
				for j := 0; j < 16; j += width {
					var a uint64
					for k := 0; k < width; k++ {
						a |= uint64(v[j+k]) << uint(k*8)
					}
					switch i.SourceWidth {
					case 2:
						a >>= n
					case 6:
						a <<= n
					case 4:
						a = uint64(signed(a, uint8(width)) >> n)
					default:
						return true, fmt.Errorf("vector shift /%d", i.SourceWidth)
					}
					for k := 0; k < width; k++ {
						result[j+k] = byte(a >> uint(k*8))
					}
				}
			}
			c.XMM[i.Dst.Reg] = result
			break
		}
		b, err := c.vectorRead(i.Src, i.Width, next)
		e = err
		if e != nil {
			break
		}
		a := c.XMM[i.Dst.Reg&15]
		v := b
		switch i.CC {
		case 0x10, 0x11, 0x28, 0x29, 0x6f, 0x7f, 0x7e, 0xd6:
			if i.Dst.Kind == regOperand && i.Src.Kind == memOperand && i.Width < 16 {
				c.XMM[i.Dst.Reg] = [16]byte{}
			}
		case 0x54, 0xdb:
			for j := range v {
				v[j] = a[j] & b[j]
			}
		case 0x55, 0xdf:
			for j := range v {
				v[j] = ^a[j] & b[j]
			}
		case 0x56, 0xeb:
			for j := range v {
				v[j] = a[j] | b[j]
			}
		case 0x57, 0xef:
			for j := range v {
				v[j] = a[j] ^ b[j]
			}
		case 0x74, 0x75, 0x76:
			width := 1 << uint(i.CC-0x74)
			for j := 0; j < 16; j += width {
				equal := true
				for k := 0; k < width; k++ {
					equal = equal && a[j+k] == b[j+k]
				}
				for k := 0; k < width; k++ {
					v[j+k] = 0
					if equal {
						v[j+k] = 255
					}
				}
			}
		case 0xc6: // SHUFPS/SHUFPD select from the old destination and source.
			if i.Op == "shufpd" {
				lo := int(i.SourceWidth&1) * 8
				hi := int(i.SourceWidth>>1&1) * 8
				copy(v[:8], a[lo:lo+8])
				copy(v[8:], b[hi:hi+8])
			} else {
				for j := 0; j < 4; j++ {
					from := a
					if j >= 2 {
						from = b
					}
					o := int(i.SourceWidth>>uint(j*2)&3) * 4
					copy(v[j*4:], from[o:o+4])
				}
			}
		case 0x70:
			for j := 0; j < 4; j++ {
				o := int(i.SourceWidth>>uint(j*2)&3) * 4
				copy(v[j*4:], b[o:o+4])
			}
		case 0x60, 0x61, 0x62, 0x68, 0x69, 0x6a, 0x6c, 0x6d:
			width := 1 << uint(i.CC&3)
			if i.CC >= 0x6c {
				width = 8
			}
			offset := 0
			if i.CC >= 0x68 && i.CC <= 0x6a || i.CC == 0x6d {
				offset = 8
			}
			for j := 0; j < 8/width; j++ {
				copy(v[j*2*width:], a[offset+j*width:offset+(j+1)*width])
				copy(v[(j*2+1)*width:], b[offset+j*width:offset+(j+1)*width])
			}
		case 0xfc, 0xfd, 0xfe, 0xd4, 0xf8, 0xf9, 0xfa, 0xfb:
			width := 1 << uint(i.CC&3)
			if i.CC == 0xd4 {
				width = 8
			}
			for j := 0; j < 16; j += width {
				var av, bv uint64
				for k := 0; k < width; k++ {
					av |= uint64(a[j+k]) << uint(k*8)
					bv |= uint64(b[j+k]) << uint(k*8)
				}
				if i.CC >= 0xf8 && i.CC <= 0xfb {
					av -= bv
				} else {
					av += bv
				}
				for k := 0; k < width; k++ {
					v[j+k] = byte(av >> uint(k*8))
				}
			}
		default:
			return true, fmt.Errorf("unsupported vector opcode %#x", i.CC)
		}
		e = c.vectorStore(i.Dst, i.Width, v, next)
	default:
		return false, nil
	}
	if e != nil {
		return true, e
	}
	c.PC = next
	c.Retired++
	return true, nil
}

-- xadd_native_test.go --
package amd64

import (
	"renvo.dev/internal/rfe/engine"
	"renvo.dev/internal/rfe/linuxuser"
	"testing"
)

func TestNativeExchangeAddAndExchangeMemoryFaults(t *testing.T) {
	for _, add := range []bool{true, false} {
		for _, width := range []uint8{1, 2, 4, 8} {
			code := []byte{}
			if add {
				code = append(code, 0xf0)
			} // LOCK XADD
			if width == 2 {
				code = append(code, 0x66)
			}
			if width == 8 {
				code = append(code, 0x48)
			}
			op := byte(0x87)
			if add {
				code = append(code, 0x0f)
				op = 0xc1
			}
			if width == 1 {
				op--
			}
			code = append(code, op, 0x0b) // [RBX], RCX
			code = append(code, 0xeb, byte(256-len(code)-2))
			want, got := testCPU(t, code), testCPU(t, code)
			for _, c := range []*CPU{want, got} {
				if err := c.Memory.(*linuxuser.Memory).Map(0x3000, 4096, 3); err != nil {
					t.Fatal(err)
				}
				if err := c.Memory.Write(0x3000, int(width), 0x7fffffffffffffff); err != nil {
					t.Fatal(err)
				}
				c.R[RBX], c.R[RCX], c.Flags = 0x3000, 0xfedcba9876543211, 0x646
			}
			cfg := engine.DefaultEngineConfig()
			cfg.IRThreshold, cfg.NativeThreshold = 1, 1
			e, err := engine.New(cfg, Architecture())
			if err != nil {
				t.Fatal(err)
			}
			adapter := NewAdapter(got)
			for _, count := range []uint64{4096, 1, 2, 3, 63, 65} {
				end := got.Retired + count
				for want.Retired < end {
					if err := want.Step(); err != nil {
						t.Fatal(err)
					}
				}
				for got.Retired < end {
					if err := e.RunQuanta(adapter, end-got.Retired); err != nil {
						t.Fatal(err)
					}
					adapter.Export()
				}
				a, _ := want.Memory.Read(0x3000, int(width), false)
				b, _ := got.Memory.Read(0x3000, int(width), false)
				if want.R != got.R || want.Flags != got.Flags || want.PC != got.PC || a != b {
					t.Fatal("XADD/XCHG state", add, width, count, want.R, got.R)
				}
			}
			if e.NativeAvailable() && e.Stats.NativeMemory == 0 {
				t.Fatal("exchange never native", add, width)
			}
			for _, c := range []*CPU{want, got} {
				if err := c.Memory.(*linuxuser.Memory).Protect(0x3000, 4096, 1); err != nil {
					t.Fatal(err)
				}
				c.PC = 0x1000
			}
			adapter.Import()
			retired := got.Retired
			a, errA := got.Memory.Read(0x3000, int(width), false)
			errWant, errGot := want.Step(), e.RunQuanta(adapter, 64)
			adapter.Export()
			b, errB := got.Memory.Read(0x3000, int(width), false)
			if errWant == nil || errGot == nil || errA != nil || errB != nil || a != b || want.R != got.R || want.Flags != got.Flags || want.PC != got.PC || got.Retired != retired {
				t.Fatal("failed exchange committed register/flags/memory", add, width, errWant, errGot)
			}
			e.Close()
		}
	}
}
