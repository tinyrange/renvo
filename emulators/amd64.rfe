RFE 1

-- rfe.json --
{
  "format": 1,
  "name": "amd64",
  "import": "renvo.dev/emulators/amd64"
}

-- adapter.go --
package amd64

import (
	"renvo.dev/internal/rfe/engine"
	emu "renvo.dev/internal/rfe/runtime"
)

const (
	pcSlot           = 16
	flagsSlot        = 17
	stateWords       = 18
	fsBaseSlot       = 18
	gsBaseSlot       = 19
	systemStateWords = 23
	timeBaseSlot     = 20
	selectorLoSlot   = 21
	selectorHiSlot   = 22 // FS, GS, and CPL; snapshot only, never exported
	timedStateWords  = 23
)

// Adapter keeps the shared native ABI contiguous without forcing clients to
// use its representation. Sync at interpreter transitions and schedule edges.
type Adapter struct {
	CPU   *CPU
	state [timedStateWords]uint64
}

func NewAdapter(c *CPU) *Adapter { a := &Adapter{CPU: c}; a.Import(); return a }
func (a *Adapter) Import() {
	copy(a.state[:16], a.CPU.R[:])
	a.state[pcSlot] = a.CPU.PC
	a.state[flagsSlot] = a.CPU.Flags
	a.state[fsBaseSlot], a.state[gsBaseSlot], a.state[timeBaseSlot] = 0, 0, 0
	a.state[selectorLoSlot], a.state[selectorHiSlot] = 0, 0
	if a.CPU.System != nil {
		a.state[fsBaseSlot], a.state[gsBaseSlot], a.state[timeBaseSlot] = a.CPU.System.FSBase, a.CPU.System.GSBase, a.CPU.System.TSC
		s := a.CPU.System
		a.state[selectorLoSlot] = uint64(s.Segments[0].Selector) | uint64(s.Segments[1].Selector)<<16 | uint64(s.Segments[2].Selector)<<32 | uint64(s.Segments[3].Selector)<<48
		a.state[selectorHiSlot] = uint64(s.Segments[4].Selector) | uint64(s.Segments[5].Selector)<<16 | uint64(s.CPL)<<32
	}
}
func (a *Adapter) Export() {
	copy(a.CPU.R[:], a.state[:16])
	a.CPU.PC = a.state[pcSlot]
	a.CPU.Flags = a.state[flagsSlot]
}
func (a *Adapter) Registers() []uint64      { return a.state[:stateWords] }
func (a *Adapter) MemoryBus() engine.Memory { return a.CPU.Memory }
func (a *Adapter) Retirement() *uint64      { return &a.CPU.Retired }
func (a *Adapter) Step() error              { a.Export(); err := a.CPU.Step(); a.Import(); return err }
func (a *Adapter) ExecuteInstruction(i engine.Instruction) error {
	a.Export()
	err := a.CPU.Execute(DecodedInstruction(i))
	a.Import()
	return err
}
func Architecture() engine.Architecture {
	arch := engine.Architecture{Name: "x86_64", StateWords: stateWords, PC: pcSlot, Alignment: 1, Fetch: fetch, Lower: lower}
	configureDecodedArchitecture(&arch)
	return arch
}

// SystemAdapter adds read-only segment, privilege, and clock snapshots to the native state. Every
// interpreter and scheduling transition imports them again; SWAPGS/WRMSR and
// segment loads remain interpreted. Ordinary Linux-user adapters stay 18 words.
type SystemAdapter struct{ *Adapter }

func NewSystemAdapter(c *CPU) *SystemAdapter {
	if c.System == nil {
		panic("system adapter requires architectural segment state")
	}
	return &SystemAdapter{NewAdapter(c)}
}
func (a *SystemAdapter) Registers() []uint64      { return a.state[:systemStateWords] }
func (a *SystemAdapter) TimedRegisters() []uint64 { return a.state[:] }

// NativeInterruptible observes imported/native-authoritative flags rather than
// possibly stale CPU flags. The shadow remains architectural CPU state.
func (a *SystemAdapter) NativeInterruptible() bool {
	return a.state[flagsSlot]&FlagIF != 0 && a.CPU.System.IRQShadow == 0
}

func (a *SystemAdapter) RefreshTime() { a.state[timeBaseSlot] = a.CPU.System.TSC }

func SystemArchitecture() engine.Architecture {
	arch := Architecture()
	arch.StateWords = systemStateWords
	baseFetch := arch.Fetch
	arch.Fetch = func(m engine.Memory, pc uint64) (engine.Instruction, error) {
		ins, err := baseFetch(m, pc)
		if err == nil {
			ins.InterpretOnly = !supportedSystem(DecodedInstruction(ins))
			// POPF may enable delivery. Never include it in a region or a
			// linked session: the machine must inspect live flags afterwards.
			ins.ScheduleBoundary = DecodedInstruction(ins).Op == "popf"
		}
		return ins, err
	}
	arch.Lower = func(b *emu.Builder, ins engine.Instruction, completed int) bool {
		return lowerInstruction(b, ins, completed, true)
	}
	return arch
}
func supportedSystem(i Instruction) bool {
	if (i.Dst.Segment != 0 && i.Dst.Segment != 0x64 && i.Dst.Segment != 0x65) ||
		(i.Src.Segment != 0 && i.Src.Segment != 0x64 && i.Src.Segment != 0x65) {
		return false
	}
	i.Dst.Segment, i.Src.Segment = 0, 0
	switch i.Op {
	case "readseg":
		return i.CC < 6 && (i.Dst.Kind == regOperand || i.Dst.Kind == memOperand)
	case "cli":
		return true // dynamic CPL guard precedes every effect
	case "popf":
		return i.Width == 2 || i.Width == 8
	}
	return supported(i)
}
func supported(i Instruction) bool {
	if i.Dst.Segment != 0 || i.Src.Segment != 0 {
		return false
	}
	switch i.Op {
	case "mov", "movsx", "movzx", "lea", "nop", "jmp", "jcc", "call", "callind", "jmpind", "ret", "leave", "push", "pop", "setcc", "cmov", "add", "adc", "sub", "sbb", "cmp", "inc", "dec", "neg", "and", "or", "xor", "test", "not", "imul", "imul3", "mul", "imul1", "cld", "std", "clc", "stc", "cmc", "pushf", "cmpxchg", "bt", "bts", "btr", "btc":
		return true
	case "xchg", "xadd":
		// Register/register overlap retains the existing interpreter path.
		// These forms have exactly one checked atomic RAM write boundary.
		return i.Dst.Kind == memOperand && i.Src.Kind == regOperand
	case "movs", "stos", "lods", "cmps", "scas":
		return i.Segment == 0 && (i.Width == 1 || i.Width == 2 || i.Width == 4 || i.Width == 8)
	case "bsf", "bsr":
		return true
	case "bswap":
		return i.Width == 4 || i.Width == 8
	case "shld", "shrd":
		// Dynamic 16-bit counts above width remain on the interpreter's path.
		// A memory zero-count must not write, even on a readonly mapping.
		if i.CC != 255 && uint64(i.CC)&31 == 0 && i.Dst.Kind == memOperand {
			return false
		}
		return i.Width >= 4 || i.CC != 255 && uint64(i.CC)&31 <= 16
	case "shl", "shr", "sar":
		return i.Width >= 4 || i.Src.Kind == immOperand && i.Src.Imm&31 > 0 && i.Src.Imm&31 < uint64(i.Width)*8
	case "rol", "ror":
		return i.Src.Kind == immOperand && i.Src.Imm > 0 && i.Src.Imm < uint64(i.Width)*8
	}
	return false
}

// ProfileOpcode exposes only the decoder's diagnostic classification. It never
// participates in instruction validation or native admission.
func (i Instruction) ProfileOpcode() string { return i.Op }

func fetch(m engine.Memory, pc uint64) (engine.Instruction, error) {
	i, err := Decode(m, pc)
	if err != nil {
		return engine.Instruction{}, err
	}
	return describeInstruction(i, i), nil
}
func describeInstruction(i Instruction, decoded any) engine.Instruction {
	pc := i.PC
	memory := i.Dst.Kind == memOperand || i.Src.Kind == memOperand
	switch i.Op {
	case "call", "callind", "push", "pushf", "pop", "ret", "leave", "movs", "stos", "lods", "cmps", "scas":
		memory = true
	case "lea", "nop":
		memory = false
	case "cli", "popf":
		// CLI needs the precise guard/fallback protocol, even without RAM.
		memory = true
	}
	ins := engine.Instruction{PC: pc, Length: uint8(i.Next - pc), Decoded: decoded, Memory: memory, InterpretOnly: !supported(i), Flow: engine.Successors{Known: true, Next: i.Next}}
	switch i.Op {
	case "movs", "stos", "lods", "cmps", "scas":
		// One string iteration is one architectural scheduling unit, exactly as
		// Step accounts it. REP loops can chain while retaining every fault edge.
		ins.Terminal = true
		if i.Repeat != 0 {
			ins.Flow.Next, ins.Flow.Alternate, ins.Flow.Conditional = i.PC, i.Next, true
		}
	case "jmp":
		ins.Terminal = true
		ins.Flow.Next = i.Src.Imm
	case "jcc":
		ins.Terminal = true
		ins.Flow.Next = i.Src.Imm
		ins.Flow.Alternate = i.Next
		ins.Flow.Conditional = true
	case "call":
		ins.Terminal = true
		ins.Flow.Next = i.Src.Imm
	case "callind", "jmpind", "ret", "syscall":
		ins.Terminal = true
		ins.Flow.Known = false
	}
	return ins
}
func lower(b *emu.Builder, ins engine.Instruction, completed int) bool {
	return lowerInstruction(b, ins, completed, false)
}
func lowerInstruction(b *emu.Builder, ins engine.Instruction, completed int, system bool) bool {
	i := DecodedInstruction(ins)
	if (!system && !supported(i)) || (system && !supportedSystem(i)) {
		return false
	}
	l := lowerer{b: b, i: i}
	w := i.Width
	if ins.Memory {
		b.Store(pcSlot, b.Constant(i.PC))
		words := stateWords
		if system {
			words = systemStateWords
		}
		b.Checkpoint(words, completed)
	}
	next := b.Constant(i.Next)
	if (i.Op == "shl" || i.Op == "shr" || i.Op == "sar") && w < 4 || i.Op == "rol" || i.Op == "ror" {
		a := l.read(i.Dst, w)
		n := i.Src.Imm & 31
		if w == 8 {
			n = i.Src.Imm & 63
		}
		width := uint64(w) * 8
		var v, carry, overflow emu.Value
		switch i.Op {
		case "shl":
			v = l.narrow(b.Shift(emu.Shl, a, n), w)
			carry = l.and(b.Shift(emu.Shr, a, width-n), 1)
			overflow = l.bin(emu.Xor, carry, b.Shift(emu.Shr, v, width-1))
		case "shr":
			v = b.Shift(emu.Shr, a, n)
			carry = l.and(b.Shift(emu.Shr, a, n-1), 1)
			overflow = b.Shift(emu.Shr, a, width-1)
		case "sar":
			v = l.narrow(b.VariableShift(emu.ArithmeticShr, l.sign(a, w), b.Constant(n), 64), w)
			carry = l.and(b.Shift(emu.Shr, a, n-1), 1)
			overflow = b.Constant(0)
		case "rol":
			v = l.narrow(l.bin(emu.Or, b.Shift(emu.Shl, a, n), b.Shift(emu.Shr, a, width-n)), w)
			carry = l.and(v, 1)
			overflow = l.bin(emu.Xor, carry, b.Shift(emu.Shr, v, width-1))
		case "ror":
			v = l.narrow(l.bin(emu.Or, b.Shift(emu.Shr, a, n), b.Shift(emu.Shl, a, width-n)), w)
			carry = b.Shift(emu.Shr, v, width-1)
			overflow = l.bin(emu.Xor, carry, l.and(b.Shift(emu.Shr, v, width-2), 1))
		}
		f := carry
		if n == 1 {
			f = l.bin(emu.Or, f, b.Shift(emu.Shl, overflow, 11))
		}
		changed := uint64(arithmeticFlags)
		if i.Op == "rol" || i.Op == "ror" {
			changed = CF | OF
		} else {
			f = l.bin(emu.Or, f, l.szp(v, w))
		}
		b.Store(flagsSlot, l.bin(emu.Or, l.and(b.Load(flagsSlot), ^changed), f))
		l.write(i.Dst, w, v)
		b.Store(pcSlot, next)
		return true
	}
	switch i.Op {
	case "movs", "stos", "lods", "cmps", "scas":
		count := b.Load(RCX)
		if i.Repeat != 0 {
			// A zero-count REP does not access either address. Exit to Step before
			// any access, with its unchanged checkpoint and zero completed work.
			b.Guard(l.not(l.bin(emu.Equal, count, b.Constant(0))))
		}
		src, dst := b.Load(RSI), b.Load(RDI)
		value := l.narrow(b.Load(RAX), w)
		if i.Op == "movs" || i.Op == "cmps" || i.Op == "lods" {
			value = b.MemoryLoad(src, int(w))
		}
		if i.Op == "cmps" || i.Op == "scas" {
			rhs := b.MemoryLoad(dst, int(w))
			result := l.narrow(l.bin(emu.Sub, value, rhs), w)
			flags := l.bin(emu.Or, l.and(b.Load(flagsSlot), ^arithmeticFlags), l.arithmetic(value, rhs, result, w, true))
			b.Store(flagsSlot, flags)
		} else if i.Op == "lods" {
			l.write(Operand{Kind: regOperand, Reg: RAX}, w, value)
		} else {
			b.MemoryStore(dst, value, int(w))
		}
		delta := b.Choose(l.and(b.Load(flagsSlot), FlagDF), b.Constant(0-uint64(w)), b.Constant(uint64(w)))
		if i.Op == "movs" || i.Op == "cmps" || i.Op == "lods" {
			b.Store(RSI, l.bin(emu.Add, src, delta))
		}
		if i.Op != "lods" {
			b.Store(RDI, l.bin(emu.Add, dst, delta))
		}
		if i.Repeat != 0 {
			count = l.bin(emu.Sub, count, b.Constant(1))
			b.Store(RCX, count)
			again := l.not(l.bin(emu.Equal, count, b.Constant(0)))
			if i.Op == "cmps" || i.Op == "scas" {
				equal := l.not(l.bin(emu.Equal, l.and(b.Load(flagsSlot), ZF), b.Constant(0)))
				if i.Repeat != 0xf3 {
					equal = l.not(equal)
				}
				again = l.bin(emu.And, again, equal)
			}
			next = b.Choose(again, b.Constant(i.PC), next)
		}
		b.Store(pcSlot, next)
	case "readseg":
		slot, shift := selectorLoSlot, uint64(i.CC)*16
		if i.CC >= 4 {
			slot, shift = selectorHiSlot, uint64(i.CC-4)*16
		}
		l.write(i.Dst, 2, b.Shift(emu.Shr, b.Load(slot), shift))
	case "cli":
		b.Guard(l.bin(emu.Equal, b.Shift(emu.Shr, b.Load(selectorHiSlot), 32), b.Constant(0)))
		b.Store(flagsSlot, l.and(b.Load(flagsSlot), ^FlagIF))
	case "popf":
		sp := b.Load(RSP)
		v := b.MemoryLoad(sp, int(w))
		kernel := l.bin(emu.Equal, b.Shift(emu.Shr, b.Load(selectorHiSlot), 32), b.Constant(0))
		mask := b.Choose(kernel, b.Constant(0x3f7fd7), b.Constant(0x3f7fd7 & ^uint64(FlagIF|0x3000)))
		flags := l.bin(emu.Or, l.bin(emu.And, b.Load(flagsSlot), l.bin(emu.Xor, mask, b.Constant(^uint64(0)))), l.bin(emu.And, v, mask))
		b.Store(RSP, l.bin(emu.Add, sp, b.Constant(uint64(w))))
		b.Store(flagsSlot, l.bin(emu.Or, flags, b.Constant(2)))
	case "bsf", "bsr":
		value := l.read(i.Src, w)
		nonzero := l.not(l.bin(emu.Equal, value, b.Constant(0)))
		isolated := value
		if i.Op == "bsf" {
			isolated = l.bin(emu.And, value, l.bin(emu.Sub, b.Constant(0), value))
		}
		index := l.bin(emu.Sub, b.Constant(63), b.RichUnary(emu.LeadingZeros, isolated, 64, 0))
		// Zero is architecturally undefined for the destination; our existing
		// interpreter leaves it unchanged, including a dword's upper half.
		if w == 4 {
			b.Store(i.Dst.Reg, b.Choose(nonzero, index, b.Load(i.Dst.Reg)))
		} else {
			l.write(i.Dst, w, b.Choose(nonzero, index, l.read(i.Dst, w)))
		}
		b.Store(flagsSlot, l.bin(emu.Or, l.and(b.Load(flagsSlot), ^ZF), b.Choose(nonzero, b.Constant(0), b.Constant(ZF))))
	case "bswap":
		l.write(i.Dst, w, b.RichUnary(emu.ReverseBytes, l.read(i.Dst, w), int(w)*8, int(w)*8))
	case "shld", "shrd":
		count := b.Constant(uint64(i.CC))
		if i.CC == 255 {
			count = b.Load(RCX)
		}
		countMask := uint64(31)
		if w == 8 {
			countMask = 63
		}
		count = l.and(count, countMask)
		zero := l.bin(emu.Equal, count, b.Constant(0))
		if i.Dst.Kind == memOperand {
			// Checkpoint above restores the original PC/flags and exact prefix
			// before a zero-count instruction replays its read-only path.
			b.Guard(l.not(zero))
		}
		a, rhs := l.read(i.Dst, w), l.read(i.Src, w)
		width := uint64(w) * 8
		complement := l.bin(emu.Sub, b.Constant(width), count)
		var result, carry emu.Value
		if i.Op == "shld" {
			result = l.bin(emu.Or, b.VariableShift(emu.VariableShl, a, count, 64), b.VariableShift(emu.VariableShr, rhs, complement, 64))
			carry = l.and(b.VariableShift(emu.VariableShr, a, complement, 64), 1)
		} else {
			result = l.bin(emu.Or, b.VariableShift(emu.VariableShr, a, count, 64), b.VariableShift(emu.VariableShl, rhs, complement, 64))
			carry = l.and(b.VariableShift(emu.VariableShr, a, l.bin(emu.Sub, count, b.Constant(1)), 64), 1)
		}
		result = l.narrow(result, w)
		if i.Dst.Kind == regOperand && w == 4 {
			b.Store(i.Dst.Reg, b.Choose(zero, b.Load(i.Dst.Reg), result))
		} else {
			l.write(i.Dst, w, b.Choose(zero, a, result))
		}
		overflow := l.and(b.Shift(emu.Shr, l.bin(emu.Xor, a, result), width-1), 1)
		overflow = b.Choose(l.bin(emu.Equal, count, b.Constant(1)), b.Shift(emu.Shl, overflow, 11), b.Constant(0))
		flags := l.bin(emu.Or, l.and(b.Load(flagsSlot), ^arithmeticFlags), l.bin(emu.Or, l.szp(result, w), l.bin(emu.Or, carry, overflow)))
		b.Store(flagsSlot, b.Choose(zero, b.Load(flagsSlot), flags))
	case "cld", "std", "clc", "stc", "cmc":
		flags := b.Load(flagsSlot)
		switch i.Op {
		case "cld":
			flags = l.and(flags, ^FlagDF)
		case "std":
			flags = l.bin(emu.Or, flags, b.Constant(FlagDF))
		case "clc":
			flags = l.and(flags, ^CF)
		case "stc":
			flags = l.bin(emu.Or, flags, b.Constant(CF))
		case "cmc":
			flags = l.bin(emu.Xor, flags, b.Constant(CF))
		}
		b.Store(flagsSlot, flags)
	case "mul", "imul1":
		// Read the source before changing RAX/RDX, including AH and aliases.
		x, y := l.narrow(b.Load(RAX), w), l.read(i.Dst, w)
		signed := i.Op == "imul1"
		if signed {
			x, y = l.sign(x, w), l.sign(y, w)
		}
		product := l.bin(emu.Mul, x, y)
		low := l.narrow(product, w)
		high := l.narrow(b.Shift(emu.Shr, product, uint64(w)*8), w)
		if w == 8 {
			high = b.MultiplyHigh(x, y, signed)
		}
		expected := b.Constant(0)
		if signed {
			expected = l.narrow(b.VariableShift(emu.ArithmeticShr, l.sign(low, w), b.Constant(63), 64), w)
		}
		overflow := l.not(l.bin(emu.Equal, high, expected))
		if w == 1 {
			l.write(Operand{Kind: regOperand, Reg: RAX}, 2, product)
		} else {
			l.write(Operand{Kind: regOperand, Reg: RAX}, w, low)
			l.write(Operand{Kind: regOperand, Reg: RDX}, w, high)
		}
		b.Store(flagsSlot, l.bin(emu.Or, l.and(b.Load(flagsSlot), ^(CF|OF)), l.bin(emu.Mul, overflow, b.Constant(CF|OF))))
	case "nop":
	case "lea":
		o := i.Src
		o.Segment = 0 // LEA ignores segment bases, unlike memory accesses.
		l.write(i.Dst, w, l.address(o))
	case "mov", "movsx", "movzx", "cmov":
		sw := w
		if i.SourceWidth != 0 {
			sw = i.SourceWidth
		}
		v := l.read(i.Src, sw)
		if i.Op == "movsx" {
			v = l.sign(v, sw)
		}
		if i.Op == "cmov" {
			v = b.Choose(l.condition(i.CC), v, l.read(i.Dst, w))
		}
		l.write(i.Dst, w, v)
	case "jmp":
		next = b.Constant(i.Src.Imm)
	case "jcc":
		next = b.Choose(l.condition(i.CC), b.Constant(i.Src.Imm), next)
	case "jmpind":
		next = l.read(i.Dst, 8)
	case "call", "callind":
		target := b.Constant(i.Src.Imm)
		if i.Op == "callind" {
			target = l.read(i.Dst, 8)
		}
		sp := l.bin(emu.Sub, b.Load(RSP), b.Constant(8))
		b.MemoryStore(sp, next, 8)
		b.Store(RSP, sp)
		next = target
	case "push", "pushf":
		v := b.Load(flagsSlot)
		if i.Op == "pushf" {
			v = l.bin(emu.Or, v, b.Constant(2))
		} else {
			v = l.read(i.Dst, w)
		}
		sp := l.bin(emu.Sub, b.Load(RSP), b.Constant(uint64(w)))
		b.MemoryStore(sp, v, int(w))
		b.Store(RSP, sp)
	case "leave":
		// The stack load must succeed before either RSP or RBP is committed.
		// Its checkpoint still exposes the original stack and frame pointers.
		sp := b.Load(RBP)
		value := b.MemoryLoad(sp, int(w))
		b.Store(RSP, l.bin(emu.Add, sp, b.Constant(uint64(w))))
		b.Store(RBP, value)
	case "pop", "ret":
		sp := b.Load(RSP)
		v := b.MemoryLoad(sp, int(w))
		sp = l.bin(emu.Add, sp, b.Constant(uint64(w)))
		if i.Op == "ret" {
			next = v
			sp = l.bin(emu.Add, sp, b.Constant(i.Src.Imm))
			b.Store(RSP, sp)
		} else {
			// POP computes its memory destination using the post-increment SP, but
			// must not commit SP if that destination faults.
			dst := i.Dst
			if dst.Kind == memOperand && dst.Base == RSP {
				dst.Disp += int64(w)
			}
			if dst.Kind == memOperand {
				l.write(dst, w, v)
				b.Store(RSP, sp)
			} else {
				b.Store(RSP, sp)
				l.write(dst, w, v)
			}
		}
	case "bt", "bts", "btr", "btc":
		bit := l.read(i.Src, w)
		var address, value emu.Value
		if i.Dst.Kind == memOperand {
			operand := i.Dst
			segment := operand.Segment
			operand.Segment = 0
			address = l.address(operand)
			if i.Src.Kind != immOperand {
				offset := b.VariableShift(emu.ArithmeticShr, l.sign(bit, w), b.Constant(3), 64)
				offset = l.and(offset, ^uint64(w-1))
				address = l.bin(emu.Add, address, offset)
				if operand.Addr32 {
					address = l.and(address, 0xffffffff)
				}
			}
			if segment == 0x64 {
				address = l.bin(emu.Add, address, b.Load(fsBaseSlot))
			}
			if segment == 0x65 {
				address = l.bin(emu.Add, address, b.Load(gsBaseSlot))
			}
			value = b.MemoryLoad(address, int(w))
		} else {
			value = l.read(i.Dst, w)
		}
		bit = l.and(bit, uint64(w)*8-1)
		carry := l.and(b.VariableShift(emu.VariableShr, value, bit, 64), CF)
		if i.Op != "bt" {
			maskBit := b.VariableShift(emu.VariableShl, b.Constant(1), bit, 64)
			changed := value
			switch i.Op {
			case "bts":
				changed = l.bin(emu.Or, value, maskBit)
			case "btr":
				changed = l.bin(emu.And, value, l.bin(emu.Xor, maskBit, b.Constant(mask(w))))
			case "btc":
				changed = l.bin(emu.Xor, value, maskBit)
			}
			if i.Dst.Kind == memOperand {
				b.MemoryStore(address, changed, int(w))
			} else {
				l.write(i.Dst, w, changed)
			}
		}
		b.Store(flagsSlot, l.bin(emu.Or, l.and(b.Load(flagsSlot), ^CF), carry))
	case "xchg", "xadd":
		a, source := l.read(i.Dst, w), l.read(i.Src, w)
		value := source
		if i.Op == "xadd" {
			value = l.narrow(l.bin(emu.Add, a, source), w)
		}
		// No register/flag mutation before the checked memory store. Native
		// execution is serialized with this single CPU, including LOCK forms.
		l.write(i.Dst, w, value)
		l.write(i.Src, w, a)
		if i.Op == "xadd" {
			flags := l.arithmetic(a, source, value, w, false)
			b.Store(flagsSlot, l.bin(emu.Or, l.and(b.Load(flagsSlot), ^arithmeticFlags), flags))
		}
	case "cmpxchg":
		a, rhs := l.read(i.Dst, w), l.read(i.Src, w)
		acc := l.narrow(b.Load(RAX), w)
		equal := l.bin(emu.Equal, acc, a)
		if i.Dst.Kind == memOperand {
			// Only the write-success arm is native. A compare failure exits at
			// the checkpoint and replays exactly this instruction, preserving
			// its read-only architectural path even on a read-only mapping.
			b.Guard(equal)
			l.write(i.Dst, w, rhs)
		} else {
			if w == 4 && i.Dst.Reg < 16 {
				// Compare failure does not write EDX/EBX/etc. It must preserve
				// that destination's upper half, unlike an actual dword write.
				b.Store(i.Dst.Reg, b.Choose(equal, rhs, b.Load(i.Dst.Reg)))
			} else {
				l.write(i.Dst, w, b.Choose(equal, rhs, a))
			}
			// Successful comparison does not write EAX or zero-extend RAX.
			// Use the state AFTER destination writing so AH/AL/RAX overlap is
			// preserved. Only the compare-failure arm replaces accumulator.
			current := b.Load(RAX)
			replacement := a
			if w < 4 {
				replacement = l.bin(emu.Or, l.and(current, ^mask(w)), a)
			}
			b.Store(RAX, b.Choose(equal, current, replacement))
		}
		f := l.arithmetic(acc, a, l.narrow(l.bin(emu.Sub, acc, a), w), w, true)
		b.Store(flagsSlot, l.bin(emu.Or, l.and(b.Load(flagsSlot), ^arithmeticFlags), f))
	case "setcc":
		l.write(i.Dst, 1, l.condition(i.CC))
	default:
		a := l.read(i.Dst, w)
		var rhs emu.Value
		if i.Src.Kind != 0 {
			rhs = l.read(i.Src, w)
		} else {
			rhs = b.Constant(0)
		}
		var v, f emu.Value
		setFlags := true
		write := true
		switch i.Op {
		case "adc", "sbb":
			carry := l.and(b.Load(flagsSlot), CF)
			k := emu.Add
			sub := i.Op == "sbb"
			if sub {
				k = emu.Sub
			}
			v = l.narrow(l.bin(k, l.bin(k, a, rhs), carry), w)
			var carryOut, overflow emu.Value
			if sub {
				carryOut = l.bin(emu.Or, l.bin(emu.Less, a, rhs), l.bin(emu.And, carry, l.bin(emu.Equal, a, rhs)))
				overflow = l.bin(emu.And, l.bin(emu.Xor, a, rhs), l.bin(emu.Xor, a, v))
			} else {
				carryOut = l.bin(emu.Or, l.bin(emu.Less, v, a), l.bin(emu.And, carry, l.bin(emu.Equal, v, a)))
				overflow = l.bin(emu.And, l.bin(emu.Xor, l.bin(emu.Xor, a, rhs), b.Constant(mask(w))), l.bin(emu.Xor, a, v))
			}
			overflow = b.Shift(emu.Shl, l.and(b.Shift(emu.Shr, overflow, uint64(w)*8-1), 1), 11)
			aux := l.and(l.bin(emu.Xor, l.bin(emu.Xor, a, rhs), v), AF)
			f = l.bin(emu.Or, l.szp(v, w), l.bin(emu.Or, carryOut, l.bin(emu.Or, aux, overflow)))
		case "add", "sub", "cmp", "inc", "dec", "neg":
			sub := i.Op == "sub" || i.Op == "cmp" || i.Op == "dec" || i.Op == "neg"
			if i.Op == "inc" || i.Op == "dec" {
				rhs = b.Constant(1)
			}
			if i.Op == "neg" {
				rhs = a
				a = b.Constant(0)
			}
			k := emu.Add
			if sub {
				k = emu.Sub
			}
			v = l.narrow(l.bin(k, a, rhs), w)
			f = l.arithmetic(a, rhs, v, w, sub)
			if i.Op == "inc" || i.Op == "dec" {
				f = l.bin(emu.Or, l.and(f, ^CF), l.and(b.Load(flagsSlot), CF))
			}
			write = i.Op != "cmp"
		case "and", "or", "xor", "test":
			k := emu.And
			if i.Op == "or" {
				k = emu.Or
			}
			if i.Op == "xor" {
				k = emu.Xor
			}
			v = l.bin(k, a, rhs)
			f = l.szp(v, w)
			write = i.Op != "test"
		case "not":
			v = l.bin(emu.Xor, a, b.Constant(mask(w)))
			setFlags = false
		case "imul", "imul3":
			if i.Op == "imul3" {
				a = rhs
				rhs = b.Constant(i.Dst.Imm & mask(w))
			}
			x, y := l.sign(a, w), l.sign(rhs, w)
			full := l.bin(emu.Mul, x, y)
			v = l.narrow(full, w)
			var overflow emu.Value
			if w == 8 {
				hi := b.MultiplyHigh(x, y, true)
				sign := b.VariableShift(emu.ArithmeticShr, v, b.Constant(63), 64)
				overflow = l.not(l.bin(emu.Equal, hi, sign))
			} else {
				overflow = l.not(l.bin(emu.Equal, full, l.sign(v, w)))
			}
			f = l.bin(emu.Or, l.and(b.Load(flagsSlot), ^(CF|OF)), l.bin(emu.Mul, overflow, b.Constant(CF|OF)))
		case "shl", "shr", "sar":
			width := int(w) * 8
			count := l.and(rhs, uint64(width-1))
			kind := emu.VariableShl
			if i.Op == "shr" {
				kind = emu.VariableShr
			}
			if i.Op == "sar" {
				kind = emu.ArithmeticShr
			}
			v = b.VariableShift(kind, a, count, width)
			var carry, overflow emu.Value
			if i.Op == "shl" {
				carry = l.and(b.VariableShift(emu.VariableShr, a, l.bin(emu.Sub, b.Constant(uint64(width)), count), width), 1)
				overflow = l.bin(emu.Xor, carry, b.Shift(emu.Shr, v, uint64(width-1)))
			} else {
				carry = l.and(b.VariableShift(emu.VariableShr, a, l.bin(emu.Sub, count, b.Constant(1)), width), 1)
				overflow = b.Constant(0)
				if i.Op == "shr" {
					overflow = b.Shift(emu.Shr, a, uint64(width-1))
				}
			}
			overflow = b.Choose(l.bin(emu.Equal, count, b.Constant(1)), b.Shift(emu.Shl, overflow, 11), b.Constant(0))
			f = l.bin(emu.Or, l.szp(v, w), l.bin(emu.Or, carry, overflow))
			f = l.bin(emu.Or, l.and(b.Load(flagsSlot), ^arithmeticFlags), f)
			f = b.Choose(l.bin(emu.Equal, count, b.Constant(0)), b.Load(flagsSlot), f)
			// A zero count preserves all destination bits, including a 32-bit
			// register's upper half. Avoid the unconditional zero-extension write.
			if i.Dst.Kind == regOperand && w == 4 {
				b.Store(i.Dst.Reg, b.Choose(l.bin(emu.Equal, count, b.Constant(0)), b.Load(i.Dst.Reg), v))
				write = false
			}
		}
		if setFlags {
			if i.Op != "imul" && i.Op != "imul3" && i.Op != "shl" && i.Op != "shr" && i.Op != "sar" {
				f = l.bin(emu.Or, l.and(b.Load(flagsSlot), ^arithmeticFlags), f)
			}
			b.Store(flagsSlot, f)
		}
		if write {
			l.write(i.Dst, w, v)
		}
	}
	b.Store(pcSlot, next)
	return true
}

type lowerer struct {
	b *emu.Builder
	i Instruction
}

func (l lowerer) bin(k int, a, b emu.Value) emu.Value { return l.b.Binary(k, a, b) }
func (l lowerer) and(v emu.Value, m uint64) emu.Value { return l.bin(emu.And, v, l.b.Constant(m)) }
func (l lowerer) not(v emu.Value) emu.Value           { return l.bin(emu.Xor, v, l.b.Constant(1)) }
func (l lowerer) narrow(v emu.Value, w uint8) emu.Value {
	if w == 8 {
		return v
	}
	return l.and(v, mask(w))
}
func (l lowerer) sign(v emu.Value, w uint8) emu.Value {
	if w == 8 {
		return v
	}
	// Use the canonical sign-extension expression recognized by the shared
	// emitter, including signed-load fusion. Narrow first: callers may pass
	// a full register rather than an already truncated memory value.
	sign := l.b.Constant(uint64(1) << (8*w - 1))
	return l.bin(emu.Sub, l.bin(emu.Xor, l.narrow(v, w), sign), sign)
}
func (l lowerer) address(o Operand) emu.Value {
	a := l.b.Constant(uint64(o.Disp))
	if o.RIP {
		a = l.bin(emu.Add, a, l.b.Constant(l.i.Next))
	}
	if o.Base >= 0 {
		a = l.bin(emu.Add, a, l.b.Load(o.Base))
	}
	if o.Index >= 0 {
		a = l.bin(emu.Add, a, l.b.Shift(emu.Shl, l.b.Load(o.Index), uint64(o.Scale)))
	}
	if o.Addr32 {
		a = l.and(a, 0xffffffff)
	}
	// Address-size truncation precedes segment-base addition. The machine's
	// memory transform still checks canonicality, permissions and aliases.
	if o.Segment == 0x64 {
		a = l.bin(emu.Add, a, l.b.Load(fsBaseSlot))
	}
	if o.Segment == 0x65 {
		a = l.bin(emu.Add, a, l.b.Load(gsBaseSlot))
	}
	return a
}
func (l lowerer) read(o Operand, w uint8) emu.Value {
	if o.Kind == immOperand {
		return l.b.Constant(o.Imm & mask(w))
	}
	if o.Kind == memOperand {
		return l.b.MemoryLoad(l.address(o), int(w))
	}
	if o.Reg >= 16 {
		return l.and(l.b.Shift(emu.Shr, l.b.Load(o.Reg-16), 8), 255)
	}
	return l.narrow(l.b.Load(o.Reg), w)
}
func (l lowerer) write(o Operand, w uint8, v emu.Value) {
	if o.Kind == memOperand {
		l.b.MemoryStore(l.address(o), v, int(w))
		return
	}
	v = l.narrow(v, w)
	if o.Reg >= 16 {
		r := o.Reg - 16
		l.b.Store(r, l.bin(emu.Or, l.and(l.b.Load(r), ^uint64(0xff00)), l.b.Shift(emu.Shl, v, 8)))
		return
	}
	if w < 4 {
		v = l.bin(emu.Or, l.and(l.b.Load(o.Reg), ^mask(w)), v)
	}
	l.b.Store(o.Reg, v)
}
func (l lowerer) szp(v emu.Value, w uint8) emu.Value {
	return l.b.StatusBits(v, int(w)*8)
}
func (l lowerer) arithmetic(a, b, v emu.Value, w uint8, sub bool) emu.Value {
	return l.b.ArithmeticStatus(a, b, int(w)*8, sub)
}
func (l lowerer) condition(cc uint8) emu.Value {
	f := l.b.Load(flagsSlot)
	bit := func(n uint64) emu.Value { return l.and(l.b.Shift(emu.Shr, f, n), 1) }
	var v emu.Value
	switch cc >> 1 {
	case 0:
		v = bit(11)
	case 1:
		v = bit(0)
	case 2:
		v = bit(6)
	case 3:
		v = l.bin(emu.Or, bit(0), bit(6))
	case 4:
		v = bit(7)
	case 5:
		v = bit(2)
	case 6:
		v = l.bin(emu.Xor, bit(7), bit(11))
	case 7:
		v = l.bin(emu.Or, bit(6), l.bin(emu.Xor, bit(7), bit(11)))
	}
	if cc&1 != 0 {
		v = l.not(v)
	}
	return v
}

-- bit_memory_native_test.go --
package amd64

import (
	"renvo.dev/internal/rfe/engine"
	"renvo.dev/internal/rfe/linuxuser"
	"testing"
)

func TestNativeBitMemorySignedIndexAndWriteFault(t *testing.T) {
	for _, op := range []byte{0xa3, 0xab, 0xb3, 0xbb} {
		code := []byte{0x48, 0x0f, op, 0x0b}
		expected, actual := testCPU(t, code), testCPU(t, code)
		for _, c := range []*CPU{expected, actual} {
			if err := c.Memory.(*linuxuser.Memory).Map(0x3000, 3*4096, 3); err != nil {
				t.Fatal(err)
			}
		}
		cfg := engine.DefaultEngineConfig()
		cfg.NativeThreshold, cfg.IRThreshold, cfg.MaxInstructions, cfg.MaxRegionInstructions = 1, 1, 1, 1
		e, err := engine.New(cfg, Architecture())
		if err != nil {
			t.Fatal(err)
		}
		adapter := NewAdapter(actual)
		for _, index := range []int64{-65, -64, -63, -1, 0, 1, 63, 64, 65} {
			for attempt := 0; attempt < 2; attempt++ {
				address := uint64(int64(0x4000) + (index>>3)&^7)
				for _, c := range []*CPU{expected, actual} {
					if err := c.Memory.Write(address, 8, 0xa5a5a5a5a5a5a5a5); err != nil {
						t.Fatal(err)
					}
					c.PC, c.Flags, c.R[RBX], c.R[RCX] = 0x1000, 0x6d6, 0x4000, uint64(index)
				}
				adapter.Import()
				if err := expected.Step(); err != nil {
					t.Fatal(err)
				}
				if err := e.Step(adapter, 1); err != nil {
					t.Fatal(err)
				}
				adapter.Export()
				a, _ := actual.Memory.Read(address, 8, false)
				b, _ := expected.Memory.Read(address, 8, false)
				if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != expected.Retired || a != b {
					t.Fatal("signed bit memory differs", op, index, a, b)
				}
			}
		}
		if e.Stats.NativeMemory == 0 {
			t.Fatal("bit memory never native")
		}
		if op != 0xa3 {
			for _, c := range []*CPU{expected, actual} {
				c.PC, c.Flags, c.R[RBX], c.R[RCX] = 0x1000, 0x602, 0x4000, 0
				if err := c.Memory.(*linuxuser.Memory).Protect(0x4000, 4096, 1); err != nil {
					t.Fatal(err)
				}
			}
			adapter.Import()
			before := actual.Retired
			if expected.Step() == nil || e.Step(adapter, 1) == nil {
				t.Fatal("missing bit store fault")
			}
			adapter.Export()
			if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != before || expected.Retired != before {
				t.Fatal("bit store fault changed architectural progress/flags")
			}
		}
		if err := e.Close(); err != nil {
			t.Fatal(err)
		}
	}
}
func TestNativeBitAddress32Wrap(t *testing.T) {
	code := []byte{0x67, 0x48, 0x0f, 0xab, 0x0b}
	expected, actual := testCPU(t, code), testCPU(t, code)
	cfg := engine.DefaultEngineConfig()
	cfg.NativeThreshold, cfg.IRThreshold, cfg.MaxInstructions, cfg.MaxRegionInstructions = 1, 1, 1, 1
	e, err := engine.New(cfg, Architecture())
	if err != nil {
		t.Fatal(err)
	}
	defer e.Close()
	adapter := NewAdapter(actual)
	for _, c := range []*CPU{expected, actual} {
		if err := c.Memory.(*linuxuser.Memory).Map(0, 4096, 3); err != nil {
			t.Fatal(err)
		}
	}
	for attempt := 0; attempt < 3; attempt++ {
		for _, c := range []*CPU{expected, actual} {
			c.PC, c.R[RBX], c.R[RCX] = 0x1000, 0xfffffff8, 64
		}
		adapter.Import()
		if err := expected.Step(); err != nil {
			t.Fatal(err)
		}
		if err := e.Step(adapter, 1); err != nil {
			t.Fatal(err)
		}
		adapter.Export()
		a, _ := actual.Memory.Read(0, 8, false)
		b, _ := expected.Memory.Read(0, 8, false)
		if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || a != b || a != 1 {
			t.Fatal("address32 bit displacement did not wrap", a, b)
		}
	}
	if e.Stats.NativeMemory == 0 {
		t.Fatal("address32 bit memory never native")
	}
}

-- bitops_native_test.go --
package amd64

import (
	"renvo.dev/internal/rfe/engine"
	"renvo.dev/internal/rfe/linuxuser"
	"testing"
)

func TestNativeBitScanSwapAndDoubleShift(t *testing.T) {
	var codes [][]byte
	for _, prefix := range [][]byte{nil, {0x66}, {0x48}} {
		for _, opcode := range []byte{0xbc, 0xbd} {
			for _, modrm := range []byte{0xc3, 0xc0, 0xcb} {
				code := append(append([]byte{}, prefix...), 0x0f, opcode, modrm)
				codes = append(codes, code)
			}
		}
		for _, opcode := range []byte{0xa4, 0xac} {
			for _, count := range []byte{0, 1, 15, 16, 31, 32, 63, 64, 255} {
				codes = append(codes, append(append([]byte{}, prefix...), 0x0f, opcode, 0xd8, count))
			}
		}
		for _, opcode := range []byte{0xa5, 0xad} {
			for _, modrm := range []byte{0xd8, 0xc0, 0xc8, 0xd9} {
				codes = append(codes, append(append([]byte{}, prefix...), 0x0f, opcode, modrm))
			}
		}
	}
	codes = append(codes, []byte{0x0f, 0xc8}, []byte{0x48, 0x0f, 0xc8}, []byte{0x49, 0x0f, 0xc9})
	values := []uint64{0, 1, 2, 0x7fff, 0x8000, 0xffff, 0x7fffffff, 0x80000000, 0xffffffff, 0x7fffffffffffffff, 0x8000000000000000, 0x0123456789abcdef, ^uint64(0)}
	counts := []uint64{0, 1, 15, 16, 31, 32, 63, 64, 127, ^uint64(0)}
	for _, mode := range []string{"ir", "native"} {
		for _, code := range codes {
			base := testCPU(t, code)
			ins, err := Decode(base.Memory, base.PC)
			if err != nil {
				t.Fatal(err)
			}
			cfg := engine.DefaultEngineConfig()
			cfg.Mode, cfg.IRThreshold, cfg.NativeThreshold, cfg.MaxInstructions, cfg.MaxRegionInstructions = mode, 1, 1, 1, 1
			e, err := engine.New(cfg, Architecture())
			if err != nil {
				t.Fatal(err)
			}
			for index, value := range values {
				for _, count := range counts {
					expected := *base
					expected.R[RAX], expected.R[RBX], expected.R[RCX], expected.R[9] = value, values[len(values)-1-index], count, value
					expected.Flags = 2 | FlagIF | FlagDF | arithmeticFlags
					actual := expected
					adapter := NewAdapter(&actual)
					if err := expected.Step(); err != nil {
						t.Fatal(err)
					}
					if err := e.Step(adapter, 1); err != nil {
						t.Fatal(err)
					}
					adapter.Export()
					if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != expected.Retired {
						t.Fatalf("%s %x value=%x count=%x R=%x/%x flags=%x/%x PC=%x/%x", mode, code, value, count, actual.R, expected.R, actual.Flags, expected.Flags, actual.PC, expected.PC)
					}
				}
			}
			if supported(ins) && mode == "native" && e.NativeAvailable() && e.Stats.Native == 0 {
				t.Fatal("supported bit operation never native", code, e.Stats)
			}
			if err := e.Close(); err != nil {
				t.Fatal(err)
			}
		}
	}
}

func TestNativeDoubleShiftAndScanPreciseMemory(t *testing.T) {
	for _, op := range []byte{0xa5, 0xad, 0xbc, 0xbd} {
		modrm := byte(0x13) // SHLD/SHRD [RBX],RDX,CL
		if op == 0xbc || op == 0xbd {
			modrm = 0x03
		} // BSF/BSR RAX,[RBX]
		code := []byte{0x48, 0xff, 0xc7, 0x48, 0x0f, op, modrm, 0xeb, 0xf7}
		expected, actual := testCPU(t, code), testCPU(t, code)
		for _, c := range []*CPU{expected, actual} {
			if err := c.Memory.(*linuxuser.Memory).Map(0x4000, 8192, 3); err != nil {
				t.Fatal(err)
			}
			if err := c.Memory.Write(0x4800, 8, 0x123456789abcdef0); err != nil {
				t.Fatal(err)
			}
			c.R[RBX], c.R[RCX], c.R[RDX] = 0x4800, 3, 0xfedcba9876543210
			c.Flags = 2 | FlagIF | FlagDF | arithmeticFlags
		}
		cfg := engine.DefaultEngineConfig()
		cfg.IRThreshold, cfg.NativeThreshold = 1, 1
		e, err := engine.New(cfg, Architecture())
		if err != nil {
			t.Fatal(err)
		}
		adapter := NewAdapter(actual)
		for n := 0; n < 192; n++ {
			if err := expected.Step(); err != nil {
				t.Fatal(err)
			}
		}
		for actual.Retired < 192 {
			if err := e.RunQuanta(adapter, 192-actual.Retired); err != nil {
				t.Fatal(err)
			}
			adapter.Export()
		}
		if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != expected.Retired {
			t.Fatal("warmed native bit memory state differs")
		}
		if e.NativeAvailable() && e.Stats.NativeMemory == 0 {
			t.Fatal("bit memory operation never native", e.Stats)
		}
		for _, count := range []uint64{0, 1, 63, 64} {
			for _, c := range []*CPU{expected, actual} {
				c.PC, c.R[RCX] = 0x1000, count
				if err := c.Memory.(*linuxuser.Memory).Protect(0x4000, 8192, 1); err != nil {
					t.Fatal(err)
				}
			}
			adapter.Import()
			if err := expected.Step(); err != nil {
				t.Fatal(err)
			}
			expectedErr := expected.Step()
			var actualErr error
			goal := actual.Retired + 2
			for actual.Retired < goal {
				actualErr = e.RunQuanta(adapter, goal-actual.Retired)
				adapter.Export()
				if actualErr != nil {
					break
				}
			}
			if (expectedErr != nil) != (actualErr != nil) || actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != expected.Retired {
				t.Fatalf("op=%x count=%d protection differs errors=%v/%v R=%x/%x flags=%x/%x PC=%x/%x retired=%d/%d", op, count, actualErr, expectedErr, actual.R, expected.R, actual.Flags, expected.Flags, actual.PC, expected.PC, actual.Retired, expected.Retired)
			}
			got, _ := actual.Memory.Read(0x4800, 8, false)
			want, _ := expected.Memory.Read(0x4800, 8, false)
			if got != want {
				t.Fatal("protected value changed", got, want)
			}
		}
		// Scan loads on a permissionless mapping must also stop precisely
		// after the preceding INC, without committing ZF or destination.
		if op == 0xbc || op == 0xbd {
			for _, c := range []*CPU{expected, actual} {
				c.PC = 0x1000
				if err := c.Memory.(*linuxuser.Memory).Protect(0x4000, 8192, 0); err != nil {
					t.Fatal(err)
				}
			}
			adapter.Import()
			if err := expected.Step(); err != nil {
				t.Fatal(err)
			}
			if err := expected.Step(); err == nil {
				t.Fatal("scan should fault")
			}
			goal := actual.Retired + 2
			var fault error
			for actual.Retired < goal {
				fault = e.RunQuanta(adapter, goal-actual.Retired)
				adapter.Export()
				if fault != nil {
					break
				}
			}
			if fault == nil {
				t.Fatal("native scan bypassed permission")
			}
			if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != expected.Retired {
				t.Fatal("scan lost precise checkpoint")
			}
		}
		if err := e.Close(); err != nil {
			t.Fatal(err)
		}
	}
}

-- cached_system_boundary_test.go --
package amd64

import (
	"bytes"
	"testing"
)

func TestCheckedCachedSystemInstructionBoundaryMatchesStep(t *testing.T) {
	cases := []struct {
		code     []byte
		cpl      uint8
		rcx, rbx uint64
		halted   bool
	}{
		{[]byte{0xfa}, 0, 0, 1, false}, {[]byte{0xfb}, 0, 0, 1, false},
		{[]byte{0xfa}, 3, 0, 1, false}, {[]byte{0xf4}, 3, 0, 1, false},
		{[]byte{0x0f, 0x32}, 0, 0xc0000101, 1, false}, {[]byte{0x0f, 0x32}, 0, 0xfeed, 1, false},
		{[]byte{0x0f, 0x01, 0xf8}, 0, 0, 1, false}, {[]byte{0x0f, 0x01, 0xf8}, 3, 0, 1, false},
		{[]byte{0x48, 0xf7, 0xf3}, 0, 0, 0, false}, {[]byte{0x48, 0x8b, 0x03}, 0, 0, 0x300000, false},
		{[]byte{0x90}, 0, 0, 1, true},
	}
	for _, item := range cases {
		var cpus [2]*CPU
		var memories [2]*systemRAM
		for n := range cpus {
			m := newSystemRAM()
			c := &CPU{PC: 0x5000, Flags: 0x202}
			c.R[RSP], c.R[RAX], c.R[RDX], c.R[RCX], c.R[RBX] = 0x7000, 123, 0, item.rcx, item.rbx
			s := NewSystem(c, m, nil)
			s.EFER = 1 << 10
			s.CPL, s.IRQShadow, s.Halted, s.TSC = item.cpl, 2, item.halted, ^uint64(0)-40
			s.GDTR = Table{Base: 0x1000, Limit: 39}
			s.IDTR = Table{Base: 0x2000, Limit: 4095}
			s.TR = Segment{Base: 0x3000, Limit: 103}
			s.Segments[1].Selector, s.Segments[2].Selector = 0x1b, 0x23
			s.GSBase, s.KernelGSBase = 0x12345678, 0x87654321
			for a, value := range map[uint64]uint64{0x1008: 0x00af9a000000ffff, 0x1010: 0x00cf92000000ffff, 0x1018: 0x00affa000000ffff, 0x1020: 0x00cff2000000ffff, 0x3004: 0x9000, 0x2000: 0x00008e0000084000, 0x20d0: 0x00008e0000084000, 0x20e0: 0x00008e0000084000} {
				if err := m.Write(a, 8, value); err != nil {
					t.Fatal(err)
				}
			}
			copy(m.data[0x5000:], item.code)
			cpus[n], memories[n] = c, m
		}
		ins, err := Decode(cpus[1].Memory, cpus[1].PC)
		if err != nil {
			t.Fatal(err)
		}
		expectedErr := cpus[0].Step()
		actualErr := cpus[1].ExecuteCachedInstruction(ins)
		a, b := cpus[0], cpus[1]
		x, y := a.System, b.System
		if (expectedErr != nil) != (actualErr != nil) || a.R != b.R || a.Flags != b.Flags || a.PC != b.PC || a.Retired != b.Retired || x.TSC != y.TSC || x.IRQShadow != y.IRQShadow || x.CPL != y.CPL || x.Halted != y.Halted || x.GSBase != y.GSBase || x.KernelGSBase != y.KernelGSBase || x.CR != y.CR || x.Segments != y.Segments || !bytes.Equal(memories[0].data, memories[1].data) {
			t.Fatalf("cached system boundary differs code=%x cpl=%d errors=%v/%v PC=%x/%x TSC=%x/%x shadow=%d/%d", item.code, item.cpl, expectedErr, actualErr, a.PC, b.PC, x.TSC, y.TSC, x.IRQShadow, y.IRQShadow)
		}
	}
}

-- carry_native_test.go --
package amd64

import (
	"renvo.dev/internal/rfe/engine"
	"renvo.dev/internal/rfe/linuxuser"
	"testing"
)

func TestCarryCompareExchangeAndBitsNativeAndIRAllWidthsFlags(t *testing.T) {
	codes := [][]byte{{0x10, 0xd8}, {0x18, 0xd8}, {0x66, 0x11, 0xd8}, {0x66, 0x19, 0xd8},
		{0x11, 0xd8}, {0x19, 0xd8}, {0x48, 0x11, 0xd8}, {0x48, 0x19, 0xd8},
		{0x10, 0xdc}, {0x18, 0xdc}, {0x83, 0xd0, 0xff}, {0x48, 0x83, 0xd8, 0xff},
		{0x0f, 0xb0, 0xcb}, {0x66, 0x0f, 0xb1, 0xcb}, {0x0f, 0xb1, 0xcb}, {0x48, 0x0f, 0xb1, 0xcb},
		{0x0f, 0xb0, 0xdc}, {0x0f, 0xb0, 0xd8}, {0x0f, 0xb1, 0xd8}, {0x48, 0x0f, 0xb1, 0xd8}}
	for _, prefix := range [][]byte{nil, {0x66}, {0x48}} {
		for _, op := range []byte{0xa3, 0xab, 0xb3, 0xbb} {
			codes = append(codes, append(append([]byte{}, prefix...), 0x0f, op, 0xd8))
		}
	}
	values := []uint64{0, 1, 15, 16, 0x7f, 0x80, 0xff, 0x7fff, 0x8000, 0xffff, 0x7fffffff, 0x80000000, 0xffffffff, 0x7fffffffffffffff, 0x8000000000000000, ^uint64(0)}
	for _, mode := range []string{"ir", "native"} {
		for _, code := range codes {
			base := testCPU(t, code)
			cfg := engine.DefaultEngineConfig()
			cfg.Mode, cfg.IRThreshold, cfg.NativeThreshold, cfg.MaxInstructions = mode, 1, 1, 1
			cfg.MaxRegionInstructions = 1
			e, err := engine.New(cfg, Architecture())
			if err != nil {
				t.Fatal(err)
			}
			for _, a := range values {
				for _, rhs := range values {
					for carry := uint64(0); carry < 2; carry++ {
						expected := *base
						expected.R[RAX], expected.R[RBX], expected.R[RCX] = a, rhs, 0x8877665544332211
						expected.Flags = 2 | 0x200 | 0x400 | arithmeticFlags&^CF | carry
						actual := expected
						adapter := NewAdapter(&actual)
						if err := expected.Step(); err != nil {
							t.Fatal(err)
						}
						if err := e.Step(adapter, 1); err != nil {
							t.Fatal(err)
						}
						adapter.Export()
						if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != expected.Retired {
							t.Fatalf("%s code=%x a=%x b=%x carry=%d R=%x/%x flags=%x/%x", mode, code, a, rhs, carry, actual.R, expected.R, actual.Flags, expected.Flags)
						}
					}
				}
			}
			if e.Stats.Native+e.Stats.IR < 512 {
				t.Fatal("carry arithmetic fell back to interpreter")
			}
			if err := e.Close(); err != nil {
				t.Fatal(err)
			}
		}
	}
}
func TestCarryNativeMemoryPreciseWriteFault(t *testing.T) {
	for _, op := range []byte{0x11, 0x19} {
		code := []byte{0x48, op, 0x03, 0xeb, 0xfb}
		expected, actual := testCPU(t, code), testCPU(t, code)
		for _, c := range []*CPU{expected, actual} {
			mem := c.Memory.(*linuxuser.Memory)
			if err := mem.Map(0x3000, 4096, 3); err != nil {
				t.Fatal(err)
			}
			if err := mem.Write(0x3000, 8, ^uint64(0)); err != nil {
				t.Fatal(err)
			}
			c.R[RBX], c.R[RAX], c.Flags = 0x3000, 0x7fffffffffffffff, 3
		}
		cfg := engine.DefaultEngineConfig()
		cfg.NativeThreshold, cfg.IRThreshold = 1, 1
		e, err := engine.New(cfg, Architecture())
		if err != nil {
			t.Fatal(err)
		}
		adapter := NewAdapter(actual)
		for _, budget := range []uint64{4096, 1, 2, 3, 63, 65} {
			end := actual.Retired + budget
			for expected.Retired < end {
				if err := expected.Step(); err != nil {
					t.Fatal(err)
				}
			}
			for actual.Retired < end {
				if err := e.RunQuanta(adapter, end-actual.Retired); err != nil {
					t.Fatal(err)
				}
				adapter.Export()
			}
			a, _ := actual.Memory.Read(0x3000, 8, false)
			b, _ := expected.Memory.Read(0x3000, 8, false)
			if actual.R != expected.R || actual.PC != expected.PC || actual.Flags != expected.Flags || a != b {
				t.Fatal("carry memory/budget differs")
			}
		}
		if e.Stats.NativeMemory == 0 {
			t.Fatal("carry RMW never native")
		}
		// Revoke write while leaving read permitted, after warming native RMW.
		for _, c := range []*CPU{expected, actual} {
			if err := c.Memory.(*linuxuser.Memory).Protect(0x3000, 4096, 1); err != nil {
				t.Fatal(err)
			}
			c.PC = 0x1000
		}
		adapter.Import()
		before := actual.Retired
		if expected.Step() == nil || e.RunQuanta(adapter, 64) == nil {
			t.Fatal("missing carry store fault")
		}
		adapter.Export()
		if actual.R != expected.R || actual.PC != expected.PC || actual.Flags != expected.Flags || actual.Retired != before || expected.Retired != before {
			t.Fatal("carry fault committed partial flags or progress")
		}
		if err := e.Close(); err != nil {
			t.Fatal(err)
		}
	}
}

-- cmpxchg_memory_native_test.go --
package amd64

import (
	"renvo.dev/internal/rfe/engine"
	"renvo.dev/internal/rfe/linuxuser"
	"testing"
)

func TestCompareExchangeNativeMemoryMatchMismatchAndWritePermission(t *testing.T) {
	for _, width := range []uint8{1, 2, 4, 8} {
		code := []byte{}
		if width == 2 {
			code = append(code, 0x66)
		}
		if width == 8 {
			code = append(code, 0x48)
		}
		opcode := byte(0xb1)
		if width == 1 {
			opcode = 0xb0
		}
		code = append(code, 0x0f, opcode, 0x0b)
		code = append(code, 0xeb, byte(256-len(code)-2))
		expected, actual := testCPU(t, code), testCPU(t, code)
		for _, c := range []*CPU{expected, actual} {
			mem := c.Memory.(*linuxuser.Memory)
			if err := mem.Map(0x3000, 4096, 3); err != nil {
				t.Fatal(err)
			}
			if err := mem.Write(0x3000, int(width), 0x7f); err != nil {
				t.Fatal(err)
			}
			c.R[RBX], c.R[RCX], c.R[RAX], c.Flags = 0x3000, 0x8877665544332211, 0x7f, 0x602
		}
		cfg := engine.DefaultEngineConfig()
		cfg.NativeThreshold, cfg.IRThreshold = 1, 1
		e, err := engine.New(cfg, Architecture())
		if err != nil {
			t.Fatal(err)
		}
		adapter := NewAdapter(actual)
		for _, budget := range []uint64{4096, 1, 2, 3, 63, 65} {
			end := actual.Retired + budget
			for expected.Retired < end {
				if err := expected.Step(); err != nil {
					t.Fatal(err)
				}
			}
			for actual.Retired < end {
				if err := e.RunQuanta(adapter, end-actual.Retired); err != nil {
					t.Fatal(err)
				}
				adapter.Export()
			}
			a, _ := actual.Memory.Read(0x3000, int(width), false)
			b, _ := expected.Memory.Read(0x3000, int(width), false)
			if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || a != b || actual.Retired != expected.Retired {
				t.Fatalf("CMPXCHG width%d budget%d differs", width, budget)
			}
		}
		if e.Stats.NativeMemory == 0 {
			t.Fatal("CMPXCHG success arm never native")
		}
		for _, match := range []bool{true, false} {
			for _, c := range []*CPU{expected, actual} {
				if err := c.Memory.(*linuxuser.Memory).Protect(0x3000, 4096, 1); err != nil {
					t.Fatal(err)
				}
				value, _ := c.Memory.Read(0x3000, int(width), false)
				c.PC = 0x1000
				c.R[RAX] = value
				if !match {
					c.R[RAX] ^= 1
				}
			}
			adapter.Import()
			before := actual.Retired
			refErr := expected.Step()
			nativeErr := e.RunQuanta(adapter, 64)
			adapter.Export()
			if (refErr != nil) != match || (nativeErr != nil) != match {
				t.Fatal("compare mismatch invented a write fault, or match missed it", width, match, refErr, nativeErr)
			}
			if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != expected.Retired {
				t.Fatal("compare-exchange read-only path changed state", width, match)
			}
			if match && actual.Retired != before {
				t.Fatal("failed compare-exchange store retired")
			}
		}
		if err := e.Close(); err != nil {
			t.Fatal(err)
		}
	}
}

-- cpu.go --
package amd64

import (
	"fmt"
	"math/bits"
	"renvo.dev/internal/rfe/engine"
)

type Memory = engine.Memory

const (
	RAX = 0
	RCX = 1
	RDX = 2
	RBX = 3
	RSP = 4
	RBP = 5
	RSI = 6
	RDI = 7
)
const (
	CF uint64 = 1
	PF uint64 = 4
	AF uint64 = 16
	ZF uint64 = 64
	SF uint64 = 128
	OF uint64 = 2048
)
const arithmeticFlags = CF | PF | AF | ZF | SF | OF

// TSCTicksPerInstruction defines the shared deterministic system clock scale.
const TSCTicksPerInstruction = 100

var Syscall = fmt.Errorf("x86-64 syscall")

type CPU struct {
	R                   [16]uint64
	PC, Flags, Retired  uint64
	Memory              Memory
	System              *System
	XMM                 [16][16]byte
	FPControl, FPStatus uint16
	FPTag               uint8
	MXCSR               uint32
	cache               map[uint64]Instruction
	stamp               engine.CodeStamp
	decodeScratch       decoder // single-threaded borrowed decode work; never retained by an instruction
}

func mask(w uint8) uint64 {
	if w == 8 {
		return ^uint64(0)
	}
	return (uint64(1) << (8 * w)) - 1
}
func signed(v uint64, w uint8) int64 { return int64(v<<(64-8*w)) >> (64 - 8*w) }
func (c *CPU) address(o Operand, next uint64) uint64 {
	a := uint64(o.Disp)
	if o.RIP {
		a += next
	}
	if o.Base >= 0 {
		a += c.R[o.Base]
	}
	if o.Index >= 0 {
		a += c.R[o.Index] << o.Scale
	}
	if o.Addr32 {
		a = uint64(uint32(a))
	}
	if c.System != nil {
		if o.Segment == 0x64 {
			a += c.System.FSBase
		}
		if o.Segment == 0x65 {
			a += c.System.GSBase
		}
	}
	return a
}
func (c *CPU) read(o Operand, w uint8, next uint64) (uint64, error) {
	switch o.Kind {
	case immOperand:
		return o.Imm & mask(w), nil
	case regOperand:
		if o.Reg >= 16 {
			return (c.R[o.Reg-16] >> 8) & 255, nil
		}
		return c.R[o.Reg] & mask(w), nil
	case memOperand:
		if o.Segment != 0 && c.System == nil {
			return 0, fmt.Errorf("segment base unavailable in user personality")
		}
		return c.Memory.Read(c.address(o, next), int(w), false)
	}
	return 0, fmt.Errorf("invalid operand")
}
func (c *CPU) write(o Operand, w uint8, next, v uint64) error {
	v &= mask(w)
	if o.Kind == memOperand {
		if o.Segment != 0 && c.System == nil {
			return fmt.Errorf("segment base unavailable in user personality")
		}
		return c.Memory.Write(c.address(o, next), int(w), v)
	}
	if o.Kind != regOperand {
		return fmt.Errorf("invalid destination")
	}
	if o.Reg >= 16 {
		r := o.Reg - 16
		c.R[r] = c.R[r]&^uint64(0xff00) | (v << 8)
		return nil
	}
	if w == 4 || w == 8 {
		c.R[o.Reg] = v
	} else {
		c.R[o.Reg] = c.R[o.Reg]&^mask(w) | v
	}
	return nil
}
func szp(v uint64, w uint8) uint64 {
	v &= mask(w)
	f := uint64(0)
	if v == 0 {
		f |= ZF
	}
	if v&(uint64(1)<<(8*w-1)) != 0 {
		f |= SF
	}
	if bits.OnesCount8(uint8(v))&1 == 0 {
		f |= PF
	}
	return f
}
func arithmetic(a, b, carry uint64, w uint8, sub bool) (uint64, uint64) {
	m := mask(w)
	a &= m
	b &= m
	var v, f uint64
	if sub {
		v = (a - b - carry) & m
		if a < b || carry != 0 && a == b {
			f |= CF
		}
		if ((a^b)&(a^v))&(uint64(1)<<(8*w-1)) != 0 {
			f |= OF
		}
	} else {
		v = (a + b + carry) & m
		if v < a || carry != 0 && v == a {
			f |= CF
		}
		if (^(a^b)&(a^v))&(uint64(1)<<(8*w-1)) != 0 {
			f |= OF
		}
	}
	if (a^b^v)&16 != 0 {
		f |= AF
	}
	return v, f | szp(v, w)
}
func condition(flags uint64, cc uint8) bool {
	c, z, s, o, p := flags&CF != 0, flags&ZF != 0, flags&SF != 0, flags&OF != 0, flags&PF != 0
	v := false
	switch cc >> 1 {
	case 0:
		v = o
	case 1:
		v = c
	case 2:
		v = z
	case 3:
		v = c || z
	case 4:
		v = s
	case 5:
		v = p
	case 6:
		v = s != o
	case 7:
		v = z || s != o
	}
	if cc&1 != 0 {
		return !v
	}
	return v
}

// Step caches decoding only when the memory supplies executable mutation epochs.
// Unknown buses are fetched each time; guest data is never treated as host code.
func (c *CPU) Step() error {
	if c.System != nil {
		return c.System.step()
	}
	var i Instruction
	var ok bool
	if m, versioned := c.Memory.(engine.CodeContextMemory); versioned {
		stamp := m.CodeContext()
		if c.cache == nil || stamp != c.stamp {
			c.cache = make(map[uint64]Instruction)
			c.stamp = stamp
		}
		i, ok = c.cache[c.PC]
	}
	if !ok {
		var err error
		i, err = c.decodeInstruction(c.Memory, c.PC)
		if err != nil {
			return err
		}
		if c.cache != nil {
			if len(c.cache) >= 65536 {
				c.cache = make(map[uint64]Instruction)
			}
			c.cache[c.PC] = i
		}
	}
	if err := c.Execute(i); err != nil && err != Syscall {
		return fmt.Errorf("pc=%#x %s: %w", i.PC, i.Op, err)
	} else {
		return err
	}
}

// ExecuteCachedInstruction skips fetching only. The caller must validate the
// exact immutable instruction at the current PC, including execute permission
// on straddling pages, code epochs and architectural address-space identity.
// Exception delivery, interrupt shadow and TSC match CPU.Step exactly.
func (c *CPU) ExecuteCachedInstruction(i Instruction) error {
	if c.System != nil {
		return c.System.executeDecoded(i, nil)
	}
	if err := c.Execute(i); err != nil && err != Syscall {
		return fmt.Errorf("pc=%#x %s: %w", i.PC, i.Op, err)
	} else {
		return err
	}
}

func (c *CPU) Execute(i Instruction) error {
	if handled, err := c.executeExtra(i); handled {
		return err
	}
	w := i.Width
	next := i.Next
	flags := c.Flags
	var a, b, v uint64
	var err error
	// Reads are performed only for actual input operands. LEA and NOP do not
	// access memory, and MOV must not read a write-only destination.
	switch i.Op {
	case "mov", "movsx", "movzx", "cmov":
		sw := w
		if i.SourceWidth != 0 {
			sw = i.SourceWidth
		}
		v, err = c.read(i.Src, sw, next)
		if err != nil {
			return err
		}
		if i.Op == "movsx" {
			v = uint64(signed(v, sw))
		}
		if i.Op != "cmov" || condition(flags, i.CC) {
			err = c.write(i.Dst, w, next, v)
		}
		// A 32-bit CMOV zero-extends even when its condition is false.
		if i.Op == "cmov" && w == 4 && !condition(flags, i.CC) {
			err = c.write(i.Dst, w, next, c.R[i.Dst.Reg])
		}
	case "lea":
		operand := i.Src
		operand.Segment = 0
		err = c.write(i.Dst, w, next, c.address(operand, next))
	case "nop":
	case "syscall":
		c.R[RCX], c.R[11] = next, flags|2
		c.PC = next
		c.Retired++
		return Syscall
	case "jmp", "jcc":
		if i.Op == "jmp" || condition(flags, i.CC) {
			next = i.Src.Imm
		}
	case "jmpind", "callind", "call":
		target := i.Src.Imm
		if i.Op != "call" {
			target, err = c.read(i.Dst, 8, next)
			if err != nil {
				return err
			}
		}
		if i.Op != "jmpind" {
			err = c.Memory.Write(c.R[RSP]-8, 8, next)
			if err != nil {
				return err
			}
			c.R[RSP] -= 8
		}
		next = target
	case "push":
		v, err = c.read(i.Dst, w, next)
		if err != nil {
			return err
		}
		err = c.Memory.Write(c.R[RSP]-uint64(w), int(w), v)
		if err == nil {
			c.R[RSP] -= uint64(w)
		}
	case "pop", "ret", "leave":
		sp := c.R[RSP]
		if i.Op == "leave" {
			sp = c.R[RBP]
		}
		v, err = c.Memory.Read(sp, int(w), false)
		if err != nil {
			return err
		}
		oldSP := c.R[RSP]
		c.R[RSP] = sp + uint64(w)
		if i.Op == "ret" {
			next = v
			c.R[RSP] += i.Src.Imm
		} else if i.Op == "leave" {
			c.R[RBP] = v
		} else {
			err = c.write(i.Dst, w, next, v)
			if err != nil {
				c.R[RSP] = oldSP
			}
		}
	case "setcc":
		if condition(flags, i.CC) {
			v = 1
		}
		err = c.write(i.Dst, 1, next, v)
	case "signpair":
		v = uint64(signed(c.R[RAX], w) >> 63)
		err = c.write(Operand{Kind: regOperand, Reg: RDX}, w, next, v)
	default:
		a, err = c.read(i.Dst, w, next)
		if err != nil {
			return err
		}
		if i.Src.Kind != 0 {
			b, err = c.read(i.Src, w, next)
			if err != nil {
				return err
			}
		}
		write := true
		switch i.Op {
		case "add", "adc", "sub", "sbb", "cmp", "inc", "dec", "neg":
			carry := uint64(0)
			if i.Op == "adc" || i.Op == "sbb" {
				carry = flags & CF
			}
			sub := i.Op == "sub" || i.Op == "sbb" || i.Op == "cmp" || i.Op == "dec" || i.Op == "neg"
			if i.Op == "inc" || i.Op == "dec" {
				b = 1
			}
			if i.Op == "neg" {
				b = a
				a = 0
			}
			var f uint64
			v, f = arithmetic(a, b, carry, w, sub)
			if i.Op == "inc" || i.Op == "dec" {
				f = f&^CF | flags&CF
			}
			flags = flags&^arithmeticFlags | f
			write = i.Op != "cmp"
		case "and", "or", "xor", "test":
			switch i.Op {
			case "and", "test":
				v = a & b
			case "or":
				v = a | b
			case "xor":
				v = a ^ b
			}
			flags = flags&^arithmeticFlags | szp(v, w)
			write = i.Op != "test"
		case "not":
			v = ^a
		case "shl", "shr", "sar", "rol", "ror":
			count := b & 31
			if w == 8 {
				count = b & 63
			}
			v = a
			if count == 0 {
				write = false
				break
			}
			width := uint64(w) * 8
			f := uint64(0)
			switch i.Op {
			case "shl":
				v = a << count
				if count <= width {
					f = (a >> (width - count)) & 1
				}
				if count == 1 && ((v>>(width-1))&1) != f {
					f |= OF
				}
			case "shr":
				v = a >> count
				f = (a >> (count - 1)) & 1
				if count == 1 && a>>(width-1) != 0 {
					f |= OF
				}
			case "sar":
				v = uint64(signed(a, w) >> count)
				if count >= width {
					f = a >> (width - 1)
				} else {
					f = (a >> (count - 1)) & 1
				}
			case "rol":
				n := count % width
				v = (a << n) | (a >> (width - n))
				f = v & 1
				if count == 1 && ((v>>(width-1))&1) != f {
					f |= OF
				}
			case "ror":
				n := count % width
				v = (a >> n) | (a << (width - n))
				f = (v >> (width - 1)) & 1
				if count == 1 && ((v>>(width-2))&1) != f {
					f |= OF
				}
			}
			if i.Op == "rol" || i.Op == "ror" {
				flags = flags&^(CF|OF) | f
			} else {
				flags = flags&^arithmeticFlags | f | szp(v, w)
			}
		case "imul", "imul3":
			if i.Op == "imul3" {
				a = b
				b = i.Dst.Imm
			}
			v = a * b
			hi, lo := bits.Mul64(uint64(signed(a, w)), uint64(signed(b, w)))
			if signed(a, w) < 0 {
				hi -= uint64(signed(b, w))
			}
			if signed(b, w) < 0 {
				hi -= uint64(signed(a, w))
			}
			overflow := false
			if w == 8 {
				expected := uint64(0)
				if int64(lo) < 0 {
					expected = ^uint64(0)
				}
				overflow = hi != expected
			} else {
				overflow = int64(lo) != signed(v, w)
			}
			flags &^= CF | OF
			if overflow {
				flags |= CF | OF
			}
		case "mul", "imul1":
			if w == 1 {
				product := uint16(uint8(c.R[RAX])) * uint16(uint8(a))
				overflow := product > 255
				if i.Op == "imul1" {
					product = uint16(int16(int8(c.R[RAX])) * int16(int8(a)))
					overflow = int16(product) != int16(int8(product))
				}
				c.R[RAX] = c.R[RAX]&^65535 | uint64(product)
				flags &^= CF | OF
				if overflow {
					flags |= CF | OF
				}
				write = false
				break
			}
			x := c.R[RAX] & mask(w)
			hi, lo := bits.Mul64(x, a)
			if i.Op == "imul1" {
				hi, lo = bits.Mul64(uint64(signed(x, w)), uint64(signed(a, w)))
				if signed(x, w) < 0 {
					hi -= uint64(signed(a, w))
				}
				if signed(a, w) < 0 {
					hi -= uint64(signed(x, w))
				}
			}
			if w < 8 {
				hi = lo >> (8 * w) & mask(w)
			}
			overflow := hi != 0
			if i.Op == "imul1" {
				expected := uint64(0)
				if signed(lo, w) < 0 {
					expected = mask(w)
				}
				overflow = hi != expected
			}
			c.write(Operand{Kind: regOperand, Reg: RAX}, w, next, lo)
			c.write(Operand{Kind: regOperand, Reg: RDX}, w, next, hi)
			flags &^= CF | OF
			if overflow {
				flags |= CF | OF
			}
			write = false
		case "div":
			if w == 1 {
				n := c.R[RAX] & 65535
				if a == 0 || n/a > 255 {
					if c.System != nil {
						return &Exception{Vector: 0}
					}
					return fmt.Errorf("divide error")
				}
				c.R[RAX] = c.R[RAX]&^65535 | (n / a) | ((n % a) << 8)
				write = false
				break
			}
			hi, lo := c.R[RDX]&mask(w), c.R[RAX]&mask(w)
			if a == 0 || hi >= a {
				if c.System != nil {
					return &Exception{Vector: 0}
				}
				return fmt.Errorf("divide error")
			}
			var q, r uint64
			if w == 8 {
				q, r = bits.Div64(hi, lo, a)
			} else {
				n := hi<<(8*w) | lo
				q, r = n/a, n%a
			}
			if q > mask(w) {
				if c.System != nil {
					return &Exception{Vector: 0}
				}
				return fmt.Errorf("divide overflow")
			}
			c.write(Operand{Kind: regOperand, Reg: RAX}, w, next, q)
			c.write(Operand{Kind: regOperand, Reg: RDX}, w, next, r)
			write = false
		case "idiv":
			hi, lo := c.R[RDX]&mask(w), c.R[RAX]&mask(w)
			den := signed(a, w)
			if den == 0 {
				if c.System != nil {
					return &Exception{Vector: 0}
				}
				return fmt.Errorf("divide error")
			}
			var q, r uint64
			if w == 8 {
				negative := int64(hi) < 0
				divisor := uint64(den)
				if den < 0 {
					divisor = -divisor
				}
				if negative {
					var carry uint64
					lo, carry = bits.Add64(^lo, 1, 0)
					hi, _ = bits.Add64(^hi, 0, carry)
				}
				if hi >= divisor {
					if c.System != nil {
						return &Exception{Vector: 0}
					}
					return fmt.Errorf("divide overflow")
				}
				q, r = bits.Div64(hi, lo, divisor)
				negativeQ := negative != (den < 0)
				limit := uint64(1) << 63
				if !negativeQ {
					limit--
				}
				if q > limit {
					if c.System != nil {
						return &Exception{Vector: 0}
					}
					return fmt.Errorf("divide overflow")
				}
				if negativeQ {
					q = -q
				}
				if negative {
					r = -r
				}
			} else {
				var n int64
				if w == 1 {
					n = int64(int16(c.R[RAX]))
				} else {
					n = signed((hi<<(8*w))|lo, w*2)
				}
				quotient, remainder := n/den, n%den
				limit := int64(1) << (w*8 - 1)
				if quotient < -limit || quotient >= limit {
					if c.System != nil {
						return &Exception{Vector: 0}
					}
					return fmt.Errorf("divide overflow")
				}
				q, r = uint64(quotient), uint64(remainder)
			}
			if w == 1 {
				c.R[RAX] = c.R[RAX]&^65535 | (q & 255) | (r&255)<<8
			} else {
				c.write(Operand{Kind: regOperand, Reg: RAX}, w, next, q)
				c.write(Operand{Kind: regOperand, Reg: RDX}, w, next, r)
			}
			write = false
		default:
			return fmt.Errorf("unimplemented operation %s", i.Op)
		}
		if write {
			err = c.write(i.Dst, w, next, v)
		}
	}
	if err != nil {
		return err
	}
	c.Flags = flags
	c.PC = next
	c.Retired++
	return nil
}

-- cpu_test.go --
package amd64

import (
	"bytes"
	"renvo.dev/internal/rfe/linuxuser"
	"testing"
)

func testCPU(t *testing.T, code []byte) *CPU {
	t.Helper()
	m := linuxuser.NewMemory()
	if err := m.Map(0x1000, 4096, 7); err != nil {
		t.Fatal(err)
	}
	if err := m.WriteBytes(0x1000, code); err != nil {
		t.Fatal(err)
	}
	return &CPU{Memory: m, PC: 0x1000, Flags: 2}
}
func step(t *testing.T, c *CPU) {
	t.Helper()
	if err := c.Step(); err != nil {
		t.Fatal(err)
	}
}
func TestRegisterWidthsAndPrefixes(t *testing.T) {
	c := testCPU(t, []byte{0xb4, 0x12, 0x40, 0xb4, 0x34, 0x66, 0xb8, 0x78, 0x56, 0xb8, 0x44, 0x33, 0x22, 0x11})
	c.R[RAX] = ^uint64(0)
	c.R[RSP] = 0x123456789abcde00
	step(t, c)
	if c.R[RAX] != 0xffffffffffff12ff {
		t.Fatal("AH", c.R[RAX])
	}
	step(t, c)
	if c.R[RSP] != 0x123456789abcde34 {
		t.Fatal("REX SPL", c.R[RSP])
	}
	step(t, c)
	if c.R[RAX] != 0xffffffffffff5678 {
		t.Fatal("AX merge", c.R[RAX])
	}
	step(t, c)
	if c.R[RAX] != 0x11223344 {
		t.Fatal("EAX zero extension", c.R[RAX])
	}
	// A legacy prefix following REX cancels that REX.
	c = testCPU(t, []byte{0x48, 0x66, 0xb8, 0x34, 0x12})
	c.R[0] = ^uint64(0)
	step(t, c)
	if c.R[0] != 0xffffffffffff1234 || c.PC != 0x1005 {
		t.Fatal("prefix order", c)
	}
}
func TestAddressingAndFetchBoundary(t *testing.T) {
	c := testCPU(t, []byte{0x48, 0x8d, 0x44, 0xcb, 0xf0, 0x48, 0x8d, 0x05, 0x10, 0, 0, 0})
	c.R[RBX] = 100
	c.R[RCX] = 3
	step(t, c)
	if c.R[0] != 108 {
		t.Fatal("SIB", c.R[0])
	}
	step(t, c)
	if c.R[0] != 0x101c {
		t.Fatal("RIP", c.R[0])
	}
	c = testCPU(t, []byte{0x67, 0x48, 0x8d, 0x03})
	c.R[RBX] = 0x100000012
	step(t, c)
	if c.R[0] != 18 {
		t.Fatal("address size wrap", c.R[0])
	}
	m := c.Memory.(*linuxuser.Memory)
	if err := m.Write(0x1fff, 1, 0x90); err != nil {
		t.Fatal(err)
	}
	c.PC = 0x1fff
	step(t, c) // Must not fetch an unused byte on the unmapped next page.
	c.PC = 0x1fff
	m.Write(0x1fff, 1, 0x48)
	before := c.Retired
	if err := c.Step(); err == nil || c.Retired != before || c.PC != 0x1fff {
		t.Fatal("truncated fetch retired")
	}
	for _, n := range []int{14, 15} {
		code := append(bytes.Repeat([]byte{0x66}, n), 0x90)
		c = testCPU(t, code)
		err := c.Step()
		if (err == nil) != (n == 14) {
			t.Fatal("15-byte maximum", n, err)
		}
	}
}
func TestArithmeticFlagsExhaustiveByte(t *testing.T) {
	for _, sub := range []bool{false, true} {
		for a := 0; a < 256; a++ {
			for b := 0; b < 256; b++ {
				for carry := 0; carry < 2; carry++ {
					result, f := arithmetic(uint64(a), uint64(b), uint64(carry), 1, sub)
					wide := a + b + carry
					low := (a & 15) + (b & 15) + carry
					sa, sb := int(int8(a)), int(int8(b))
					ss := sa + sb + carry
					if sub {
						wide = a - b - carry
						low = (a & 15) - (b & 15) - carry
						ss = sa - sb - carry
					}
					want := uint64(uint8(wide))
					wf := uint64(0)
					if wide < 0 || wide > 255 {
						wf |= CF
					}
					if low < 0 || low > 15 {
						wf |= AF
					}
					if ss < -128 || ss > 127 {
						wf |= OF
					}
					if want == 0 {
						wf |= ZF
					}
					if want >= 128 {
						wf |= SF
					}
					parity := 0
					for bit := 0; bit < 8; bit++ {
						parity += int(want >> bit & 1)
					}
					if parity%2 == 0 {
						wf |= PF
					}
					if result != want || f != wf {
						t.Fatalf("a=%d b=%d carry=%d sub=%v: %#x/%#x want %#x/%#x", a, b, carry, sub, result, f, want, wf)
					}
				}
			}
		}
	}
}
func TestFaultCommitAndCodeInvalidation(t *testing.T) {
	// ADD dword [RBX],1: the full operand straddles an unmapped page.
	c := testCPU(t, []byte{0x83, 0x03, 0x01})
	c.R[RBX] = 0x1ffe
	before, flags := c.R, c.Flags
	if err := c.Step(); err == nil || c.R != before || c.Flags != flags || c.Retired != 0 || c.PC != 0x1000 {
		t.Fatal("imprecise memory fault", err)
	}
	m := c.Memory.(*linuxuser.Memory)
	c.R[RBX] = 0x1800
	m.Write(0x1800, 4, 0x7fffffff)
	m.Protect(0x1000, 4096, 5)
	if err := c.Step(); err == nil || c.Flags != flags || c.Retired != 0 {
		t.Fatal("read-only RMW committed", err)
	}
	m.Protect(0x1000, 4096, 7)
	m.WriteBytes(0x1000, []byte{0xb8, 1, 0, 0, 0})
	step(t, c)
	c.PC = 0x1000
	m.Write(0x1001, 1, 2)
	step(t, c)
	if c.R[0] != 2 {
		t.Fatal("stale decoded instruction")
	}
	m.Protect(0x1000, 4096, 3)
	c.PC = 0x1000
	retired := c.Retired
	if err := c.Step(); err == nil || c.Retired != retired {
		t.Fatal("revoked code executed")
	}
}
func TestCallStackAndSyscall(t *testing.T) {
	c := testCPU(t, []byte{0xe8, 1, 0, 0, 0, 0x90, 0xc3})
	c.R[RSP] = 0x1800
	step(t, c)
	if c.PC != 0x1006 || c.R[RSP] != 0x17f8 {
		t.Fatal("call", c)
	}
	step(t, c)
	if c.PC != 0x1005 || c.R[RSP] != 0x1800 {
		t.Fatal("ret", c)
	}
	c = testCPU(t, []byte{0x0f, 0x05})
	c.Flags = CF | ZF | 2
	if err := c.Step(); err != Syscall || c.R[RCX] != 0x1002 || c.R[11] != CF|ZF|2 || c.Retired != 1 {
		t.Fatal("syscall", err, c)
	}
}
func TestConditionalMoveAndDivideFault(t *testing.T) {
	c := testCPU(t, []byte{0x0f, 0x44, 0xc1})
	c.R[0] = ^uint64(0)
	c.R[1] = 7
	step(t, c)
	if c.R[0] != 0xffffffff {
		t.Fatal("false 32-bit CMOV extension")
	}
	c = testCPU(t, []byte{0xf7, 0xf1})
	c.R[RDX] = 1
	c.R[RCX] = 1
	c.R[RAX] = 123
	before := c.R
	if err := c.Step(); err == nil || c.R != before || c.Retired != 0 {
		t.Fatal("divide overflow committed")
	}
}

-- decode.go --
package amd64

import "fmt"

// Operand is a decoded register, immediate, or base/index/displacement address.
// Register numbers 16..19 represent AH..BH, not extended general registers.
type Operand struct {
	Kind             uint8
	Reg, Base, Index int
	Scale            uint8
	Disp             int64
	Imm              uint64
	RIP, Addr32      bool
	Segment          uint8
}

const (
	regOperand = 1
	memOperand = 2
	immOperand = 3
)

type Instruction struct {
	PC, Next           uint64
	Op                 string
	Dst, Src           Operand
	Width, SourceWidth uint8
	CC                 uint8
	Repeat, Segment    uint8
}

// Instruction windows borrow stable ordinary RAM only for one synchronous
// decode. Providers must validate execute access without walks or faults and
// expose only ordinary, preowned RAM. Windows cannot cross a page,
// trigger I/O, change mappings, or survive a decode/execution boundary.
type instructionWindowMemory interface{ InstructionBytes(uint64) []byte }

type decoder struct {
	window                  []byte
	windowPC                uint64
	windowSource            instructionWindowMemory
	memory                  Memory
	pc, start               uint64
	rex, width              uint8
	addr32                  bool
	lock                    bool
	segment, repeat, second uint8
	err                     error
}

func (d *decoder) byte() byte {
	if d.err != nil {
		return 0
	}
	if d.pc-d.start >= 15 {
		d.err = fmt.Errorf("instruction exceeds 15 bytes at %#x", d.start)
		return 0
	}
	if d.pc-d.windowPC >= uint64(len(d.window)) && d.windowSource != nil {
		// The optional capability validates an EXISTING execute mapping and
		// ordinary RAM without walks, faults or I/O. Absence is not cached:
		// a demand Read below may populate the TLB for the next byte.
		d.window, d.windowPC = d.windowSource.InstructionBytes(d.pc), d.pc
		if limit := int(4096 - d.pc&4095); len(d.window) > limit {
			d.window = d.window[:limit]
		}
	}
	if offset := d.pc - d.windowPC; offset < uint64(len(d.window)) {
		v := d.window[offset]
		d.pc++
		return v
	}
	v, e := d.memory.Read(d.pc, 1, true)
	if e != nil {
		d.err = e
		return 0
	}
	d.pc++
	return byte(v)
}
func (d *decoder) immediate(n uint8, signed bool) uint64 {
	var v uint64
	for i := uint8(0); i < n; i++ {
		v |= uint64(d.byte()) << (8 * i)
	}
	if signed && n < 8 {
		return uint64(int64(v<<(64-8*n)) >> (64 - 8*n))
	}
	return v
}
func immediate(v uint64) Operand { return Operand{Kind: immOperand, Imm: v} }
func (d *decoder) reg(n uint8, w uint8) Operand {
	if w == 1 && d.rex == 0 && n >= 4 && n < 8 {
		return Operand{Kind: regOperand, Reg: int(n) + 12}
	}
	return Operand{Kind: regOperand, Reg: int(n)}
}
func (d *decoder) modrm(w uint8) (Operand, Operand, uint8) {
	b := d.byte()
	mode, group, rm := b>>6, (b>>3)&7, b&7
	r := d.reg(group+((d.rex>>2)&1)*8, w)
	if mode == 3 {
		return d.reg(rm+(d.rex&1)*8, w), r, group
	}
	m := Operand{Kind: memOperand, Base: -1, Index: -1, Addr32: d.addr32, Segment: d.segment}
	if rm == 4 {
		sib := d.byte()
		base, index := sib&7, (sib>>3)&7
		m.Scale = sib >> 6
		if index != 4 || d.rex&2 != 0 {
			m.Index = int(index + ((d.rex>>1)&1)*8)
		}
		if base == 5 && mode == 0 {
			m.Disp = int64(d.immediate(4, true))
		} else {
			m.Base = int(base + (d.rex&1)*8)
		}
	} else if rm == 5 && mode == 0 {
		m.Disp = int64(d.immediate(4, true))
		m.RIP = true
	} else {
		m.Base = int(rm + (d.rex&1)*8)
	}
	if mode == 1 {
		m.Disp += int64(d.immediate(1, true))
	}
	if mode == 2 {
		m.Disp += int64(d.immediate(4, true))
	}
	return m, r, group
}
func (c *CPU) decodeInstruction(m Memory, pc uint64) (Instruction, error) {
	i, err := decodeInto(&c.decodeScratch, m, pc)
	c.decodeScratch.memory = nil
	c.decodeScratch.window, c.decodeScratch.windowSource = nil, nil
	return i, err
}
func Decode(m Memory, pc uint64) (Instruction, error) {
	d := decoder{}
	return decodeInto(&d, m, pc)
}
func decodeInto(d *decoder, m Memory, pc uint64) (Instruction, error) {
	source, _ := m.(instructionWindowMemory)
	*d = decoder{memory: m, pc: pc, start: pc, width: 4, windowSource: source}
	i := Instruction{PC: pc}
	var op byte
	operand16 := false
	for {
		op = d.byte()
		if d.err != nil {
			return i, d.err
		}
		if op >= 0x40 && op <= 0x4f {
			d.rex = op
			continue
		}
		if op == 0x66 {
			operand16 = true
			d.rex = 0
			continue
		}
		if op == 0x67 {
			d.addr32 = true
			d.rex = 0
			continue
		}
		if op == 0x64 || op == 0x65 {
			d.segment = op
			d.rex = 0
			continue
		}
		if op == 0xf2 || op == 0xf3 {
			d.repeat = op
			d.rex = 0
			continue
		}
		if op == 0xf0 {
			d.lock = true
			d.rex = 0
			continue
		}
		if op == 0x2e || op == 0x3e || op == 0x26 || op == 0x36 {
			d.rex = 0
			continue
		}
		break
	}
	if operand16 {
		d.width = 2
	}
	if d.rex&8 != 0 {
		d.width = 8
	}
	i.Width = d.width
	w := d.width
	immWidth := w
	if immWidth == 8 {
		immWidth = 4
	}
	alu := [8]string{"add", "or", "adc", "sbb", "and", "sub", "xor", "cmp"}
	switch {
	case op < 0x40 && op&7 <= 5:
		i.Op = alu[op>>3]
		if op&1 == 0 {
			i.Width = 1
		}
		if op&7 < 4 {
			rm, r, _ := d.modrm(i.Width)
			i.Dst, i.Src = rm, r
			if op&2 != 0 {
				i.Dst, i.Src = r, rm
			}
		} else {
			i.Dst = d.reg(0, i.Width)
			n := immWidth
			if i.Width == 1 {
				n = 1
			}
			i.Src = immediate(d.immediate(n, w == 8))
		}
	case op >= 0x50 && op <= 0x5f:
		i.Width = 8
		if operand16 {
			i.Width = 2
		}
		i.Dst = d.reg((op&7)+(d.rex&1)*8, i.Width)
		i.Op = "push"
		if op&8 != 0 {
			i.Op = "pop"
		}
	case op == 0x68 || op == 0x6a:
		i.Op = "push"
		i.Width = 8
		n := uint8(4)
		if operand16 {
			i.Width = 2
			n = 2
		}
		if op == 0x6a {
			n = 1
		}
		i.Dst = immediate(d.immediate(n, true))
	case op == 0x69 || op == 0x6b:
		rm, r, _ := d.modrm(w)
		i.Op = "imul3"
		i.Dst, i.Src = r, rm
		n := immWidth
		if op == 0x6b {
			n = 1
		}
		i.Dst.Imm = d.immediate(n, true)
	case op >= 0x70 && op <= 0x7f:
		i.Op = "jcc"
		i.CC = op & 15
		i.Src = immediate(d.immediate(1, true))
	case op == 0x80 || op == 0x81 || op == 0x83:
		if op == 0x80 {
			i.Width = 1
		}
		rm, _, g := d.modrm(i.Width)
		i.Op = alu[g]
		i.Dst = rm
		n := immWidth
		if op != 0x81 {
			n = 1
		}
		i.Src = immediate(d.immediate(n, op == 0x83 || w == 8))
	case op == 0x84 || op == 0x85 || op == 0x88 || op == 0x89 || op == 0x8a || op == 0x8b || op == 0x8d:
		if op&1 == 0 {
			i.Width = 1
		}
		rm, r, _ := d.modrm(i.Width)
		i.Dst, i.Src = rm, r
		i.Op = "mov"
		if op == 0x84 || op == 0x85 {
			i.Op = "test"
		}
		if op == 0x8a || op == 0x8b || op == 0x8d {
			i.Dst, i.Src = r, rm
		}
		if op == 0x8d {
			i.Op = "lea"
			if rm.Kind != memOperand {
				i.Op = ""
			}
		}
	case op == 0x90:
		if d.rex&1 == 0 {
			i.Op = "nop"
		}
	case op == 0x98:
		i.Op = "movsx"
		i.Dst = d.reg(0, w)
		i.Src = d.reg(0, w/2)
		i.SourceWidth = w / 2
	case op == 0x99:
		i.Op = "signpair"
	case op == 0x63:
		if w == 8 {
			rm, r, _ := d.modrm(4)
			i.Op = "movsx"
			i.Dst, i.Src = r, rm
			i.SourceWidth = 4
		}
	case op >= 0xb0 && op <= 0xbf:
		if op < 0xb8 {
			i.Width = 1
		}
		i.Op = "mov"
		i.Dst = d.reg((op&7)+(d.rex&1)*8, i.Width)
		i.Src = immediate(d.immediate(i.Width, false))
	case op == 0xa8 || op == 0xa9:
		if op == 0xa8 {
			i.Width = 1
			immWidth = 1
		}
		i.Op = "test"
		i.Dst = d.reg(0, i.Width)
		i.Src = immediate(d.immediate(immWidth, w == 8))
	case op == 0xc0 || op == 0xc1 || op == 0xd0 || op == 0xd1 || op == 0xd2 || op == 0xd3:
		if op&1 == 0 {
			i.Width = 1
		}
		rm, _, g := d.modrm(i.Width)
		i.Dst = rm
		shifts := []string{"rol", "ror", "", "", "shl", "shr", "shl", "sar"}
		i.Op = shifts[g]
		if op == 0xc0 || op == 0xc1 {
			i.Src = immediate(d.immediate(1, false))
		} else if op == 0xd0 || op == 0xd1 {
			i.Src = immediate(1)
		} else {
			i.Src = d.reg(1, 1)
		}
	case op == 0xc2 || op == 0xc3:
		i.Op = "ret"
		i.Width = 8
		if op == 0xc2 {
			i.Src = immediate(d.immediate(2, false))
		}
	case op == 0xc6 || op == 0xc7:
		if op == 0xc6 {
			i.Width = 1
			immWidth = 1
		}
		rm, _, g := d.modrm(i.Width)
		if g == 0 {
			i.Op = "mov"
		}
		i.Dst = rm
		i.Src = immediate(d.immediate(immWidth, w == 8))
	case op == 0xc9:
		i.Op = "leave"
		i.Width = 8
		if operand16 {
			i.Op = ""
		}
	case op == 0xe8 || op == 0xe9 || op == 0xeb:
		i.Op = "jmp"
		if op == 0xe8 {
			i.Op = "call"
		}
		n := uint8(4)
		if op == 0xeb {
			n = 1
		}
		i.Src = immediate(d.immediate(n, true))
	case op == 0xf6 || op == 0xf7:
		if op == 0xf6 {
			i.Width = 1
			immWidth = 1
		}
		rm, _, g := d.modrm(i.Width)
		i.Dst = rm
		names := []string{"test", "", "not", "neg", "mul", "imul1", "div", "idiv"}
		i.Op = names[g]
		if g == 0 {
			i.Src = immediate(d.immediate(immWidth, w == 8))
		}
	case op == 0xfe || op == 0xff:
		if op == 0xfe {
			i.Width = 1
		}
		rm, _, g := d.modrm(i.Width)
		i.Dst = rm
		if g == 0 {
			i.Op = "inc"
		}
		if g == 1 {
			i.Op = "dec"
		}
		if op == 0xff && (g == 2 || g == 4 || g == 6) {
			i.Width = 8
			if g == 2 {
				i.Op = "callind"
			}
			if g == 4 {
				i.Op = "jmpind"
			}
			if g == 6 {
				i.Op = "push"
				if operand16 {
					i.Width = 2
				}
			}
		}
	case op == 0x0f:
		second := d.byte()
		d.second = second
		switch {
		case second == 0x05:
			i.Op = "syscall"
		case second == 0x1f:
			_, _, g := d.modrm(w)
			if g == 0 {
				i.Op = "nop"
			}
		case second >= 0x80 && second <= 0x8f:
			i.Op = "jcc"
			i.CC = second & 15
			i.Src = immediate(d.immediate(4, true))
		case second >= 0x90 && second <= 0x9f:
			rm, _, _ := d.modrm(1)
			i.Op = "setcc"
			i.CC = second & 15
			i.Dst = rm
			i.Width = 1
		case second >= 0x40 && second <= 0x4f:
			rm, r, _ := d.modrm(w)
			i.Op = "cmov"
			i.CC = second & 15
			i.Dst, i.Src = r, rm
		case second == 0xaf:
			rm, r, _ := d.modrm(w)
			i.Op = "imul"
			i.Dst, i.Src = r, rm
		case second == 0xb6 || second == 0xb7 || second == 0xbe || second == 0xbf:
			sw := uint8(1)
			if second&1 != 0 {
				sw = 2
			}
			rm, r, _ := d.modrm(sw)
			// ModRM.reg is a full destination register, never AH..BH.
			if r.Reg >= 16 {
				r.Reg -= 12
			}
			i.Op = "movzx"
			if second >= 0xbe {
				i.Op = "movsx"
			}
			i.Dst, i.Src, i.SourceWidth = r, rm, sw
		}
	}
	if i.Op == "" {
		d.extra(&i, op, operand16)
		if i.Op == "" {
			d.vectorDecode(&i, op, operand16)
		}
	}
	i.Repeat, i.Segment = d.repeat, d.segment
	if d.err != nil {
		return i, d.err
	}
	if i.Op == "" {
		var raw []byte
		for at := pc; at < d.pc; at++ {
			v, err := m.Read(at, 1, true)
			if err != nil {
				break
			}
			raw = append(raw, byte(v))
		}
		return i, fmt.Errorf("unsupported instruction at %#x (bytes %x)", pc, raw)
	}
	i.Next = d.pc
	if i.Op == "jmp" || i.Op == "call" || i.Op == "jcc" {
		i.Src.Imm += i.Next
	}
	return i, nil
}

-- decoded_browser.go --
//go:build browser

package amd64

import "renvo.dev/internal/rfe/engine"

// Each live instruction has one owned descriptor. A descriptor can be reused
// only after its engine block has been unpublished; no raw guest address or
// code epoch alone authorizes reuse. The pool grows only to peak live demand.
type ownedDecoded struct {
	value Instruction
	next  *ownedDecoded
}
type decodedPool struct {
	free    *ownedDecoded
	scratch decoder
}

func (p *decodedPool) fetch(m engine.Memory, pc uint64) (engine.Instruction, error) {
	i, err := decodeInto(&p.scratch, m, pc)
	p.scratch.memory = nil
	p.scratch.window, p.scratch.windowSource = nil, nil
	if err != nil {
		return engine.Instruction{}, err
	}
	cell := p.free
	if cell == nil {
		cell = &ownedDecoded{}
	} else {
		p.free = cell.next
	}
	*cell = ownedDecoded{value: i}
	return describeInstruction(i, cell), nil
}
func (p *decodedPool) release(ins engine.Instruction) {
	if ins.Decoded == nil {
		return
	}
	cell := ins.Decoded.(*ownedDecoded)
	cell.value = Instruction{}
	cell.next = p.free
	p.free = cell
}
func equalDecoded(a, b any) bool {
	if a == nil || b == nil {
		return a == b
	}
	return a.(*ownedDecoded).value == b.(*ownedDecoded).value
}
func configureDecodedArchitecture(arch *engine.Architecture) {
	p := &decodedPool{}
	arch.Fetch = p.fetch
	arch.Release = p.release
	arch.EqualDecoded = equalDecoded
}
func DecodedInstruction(ins engine.Instruction) Instruction { return ins.Decoded.(*ownedDecoded).value }

