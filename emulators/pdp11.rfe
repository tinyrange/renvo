func xor(opcode uint64) {
	guard(opcode&7 != 7 && opcode>>6&7 != 7)
	r := state[opcode&7] ^ state[opcode>>6&7]
	state[opcode&7] = r
	state[8] = (state[8] &^ 14) | ((r>>15)&1)<<3 | choose(r == 0, 4, 0)
}

