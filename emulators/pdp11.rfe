func add(opcode uint64) {
	guard(opcode&7 != 7 && opcode>>6&7 != 7)
	s := state[opcode>>6&7]
	d := state[opcode&7]
	w := s + d
	r := u16(w)
	state[opcode&7] = r
	state[8] = (state[8] &^ 15) | ((r>>15)&1)<<3 | choose(r == 0, 4, 0) | choose((^(s^d))&(d^r)&32768 != 0, 2, 0) | choose(w > 65535, 1, 0)
}

