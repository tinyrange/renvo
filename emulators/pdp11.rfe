	state[opcode&7] = r
	state[8] = (state[8] &^ 15) | ((r>>15)&1)<<3 | choose(r == 0, 4, 0) | choose((d^s)&(d^r)&32768 != 0, 2, 0) | choose(d < s, 1, 0)
}

