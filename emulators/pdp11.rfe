-- cpu.go --
// Package pdp11 implements the PDP-11/45 CPU, FP11, and KT11 address translation.
// Adapted from Renvo's examples/pdp11/cpu.c. Architectural reference: Paul
// Nankervis, pdp11-js, revision 605cc23eada3d831be54e537fe94307f1b80a85b.
// Paul Nankervis permits use with acknowledgement in modified sources.
package pdp11

import emu "renvo.dev/internal/rfe/runtime"

const (
	C uint16 = 1
	V uint16 = 2
	Z uint16 = 4
	N uint16 = 8
)
const (
	dataSpace     uint32 = 1 << 16
	registerSpace uint32 = 1 << 17
)

// System supplies external interrupts and the RESET instruction. CPU-internal
// MMU and PSW registers are handled by the CPU before reaching the device bus.
type System interface {
	Interrupt(priority int) uint16
	Reset()
}
type CPU struct {
	R                                       [8]uint16
	PSW                                     uint16
	Bus                                     emu.Bus
	System                                  System
	User                                    bool
	Halted                                  bool
	Waiting                                 bool
	Fault                                   uint16
	Trap                                    uint16
	Instruction                             uint16
	InstructionPC                           uint16
	Ticks                                   uint64
	Alternate                               [6]uint16
	Stacks                                  [4]uint16
	PAR                                     [64]uint16
	PDR                                     [64]uint16
	MMR0, MMR1, MMR2, MMR3, PIR, StackLimit uint16
	trapping                                bool
	FR                                      [6]uint64
	FPS, FEC, FEA                           uint16
	fpPending                               bool
}

func (c *CPU) mode() int { return int(c.PSW>>14) & 3 }
func (c *CPU) fail(vector uint16) {
	if c.Fault == 0 {
		c.Fault = vector
	}
}
func (c *CPU) flag(flag uint16, yes bool) {
	if yes {
		c.PSW |= flag
	} else {
		c.PSW &^= flag
	}
}
func (c *CPU) nz(v uint16, byteOp bool) {
	mask, sign := uint16(65535), uint16(32768)
	if byteOp {
		mask, sign = 255, 128
	}
	c.flag(N, v&sign != 0)
	c.flag(Z, v&mask == 0)
}
func (c *CPU) SetPSW(v uint16) {
	old, newMode := c.mode(), int(v>>14)&3
	if (c.PSW^v)&0o4000 != 0 {
		for i := 0; i < 6; i++ {
			c.R[i], c.Alternate[i] = c.Alternate[i], c.R[i]
		}
	}
	if old != newMode {
		c.Stacks[old] = c.R[6]
		c.R[6] = c.Stacks[newMode]
	}
	c.PSW = v
}
func (c *CPU) addReg(r int, delta int) {
	c.R[r] += uint16(delta)
	if c.MMR0&0o160000 == 0 && r != 7 {
		c.MMR1 = c.MMR1<<8 | uint16((delta&31)<<3|r)
	}
}
func (c *CPU) translate(a uint16, data, write bool, mode int) uint32 {
	if c.User {
		if data {
			return uint32(a) | dataSpace
		}
		return uint32(a)
	}
	if c.MMR0&1 == 0 {
		if a >= 0o160000 {
			return 0o17760000 | uint32(a)
		}
		return uint32(a)
	}
	bit := uint16(1)
	if mode == 0 {
		bit = 4
	} else if mode == 1 {
		bit = 2
	}
	if c.MMR3&bit == 0 {
		data = false
	}
	page := mode*16 + int(a>>13)
	if data {
		page += 8
	}
	d := c.PDR[page]
	access := d & 7
	err := uint16(0)
	if access == 0 || access == 3 || access == 7 {
		err |= 0o100000
	}
	if write && (access == 1 || access == 2) {
		err |= 0o20000
	}
	block := int(a>>6) & 127
	limit := int(d>>8) & 127
	if (d&8 != 0 && block < limit) || (d&8 == 0 && block > limit) {
		err |= 0o40000
	}
	if err != 0 {
		if c.MMR0&0o160000 == 0 {
			c.MMR0 |= err | uint16(page<<1)
		}
		c.fail(0o250)
		return 0
	}
	c.PDR[page] |= 0o200
	if write {
		c.PDR[page] |= 0o100
	}
	p := (uint32(c.PAR[page])*64 + uint32(a&8191)) & 0o777777
	if p >= 0o760000 {
		p |= 0o17000000
	}
	return p
}
func mmuIndex(a uint16) int {
	base, index := uint16(0), 0
	if a >= 0o172200 && a < 0o172300 {
		base, index = 0o172200, 16
	} else if a >= 0o172300 && a < 0o172400 {
		base = 0o172300
	} else if a >= 0o177600 && a < 0o177700 {
		base, index = 0o177600, 48
	} else {
		return -1
	}
	index += int((a-base)&0o37) / 2
	if a&0o40 != 0 {
		index += 64
	}
	return index
}
func (c *CPU) internalRead(a uint16) (uint16, bool) {
	i := mmuIndex(a)
	if i >= 64 {
		return c.PAR[i-64], true
	}
	if i >= 0 {
		return c.PDR[i], true
	}
	switch a {
	case 0o177572:
		return c.MMR0, true
	case 0o177574:
		return c.MMR1, true
	case 0o177576:
		return c.MMR2, true
	case 0o172516:
		return c.MMR3, true
	case 0o177772:
		return c.PIR, true
	case 0o177774:
		return c.StackLimit, true
	case 0o177776:
		return c.PSW, true
	}
	return 0, false
}
func (c *CPU) internalWrite(a, v uint16) bool {
	i := mmuIndex(a)
	if i >= 64 {
		c.PAR[i-64] = v
		c.PDR[i-64] &^= 0o300
		return true
	}
	if i >= 0 {
		c.PDR[i] = v & 0o77417
		return true
	}
	switch a {
	case 0o177572:
		c.MMR0 = v
	case 0o177574:
	case 0o177576:
		c.MMR2 = v
	case 0o172516:
		c.MMR3 = v & 7
	case 0o177772:
		c.PIR = v
	case 0o177774:
		c.StackLimit = v & 0o177400
	case 0o177776:
		c.SetPSW(v)
	default:
		return false
	}
	return true
}
func (c *CPU) read(a uint16, data, byteOp bool, mode int) uint16 {
	if c.Fault != 0 {
		return 0
	}
	if !byteOp && a&1 != 0 {
		c.fail(4)
		return 0
	}
	p := c.translate(a, data, false, mode)
	if c.Fault != 0 {
		return 0
	}
	if !c.User && p >= 0o17760000 {
		if v, ok := c.internalRead(uint16(p) & 0o177776); ok {
			if byteOp {
				return v >> ((a & 1) * 8) & 255
			}
			return v
		}
	}
	width := 2
	if byteOp {
		width = 1
	}
	access := emu.Read
	if !data {
		access = emu.Execute
	}
	v, f := c.Bus.Load(uint64(p), width, access, c.Ticks)
	if f != nil {
		if c.User && (f.Kind == emu.Unmapped || f.Kind == emu.Boundary || f.Kind == emu.Permission) {
			c.fail(0o250)
		} else {
			c.fail(4)
		}
	}
	return uint16(v)
}
func (c *CPU) write(a, v uint16, data, byteOp bool, mode int) {
	if c.Fault != 0 {
		return
	}
	if !byteOp && a&1 != 0 {
		c.fail(4)
		return
	}
	p := c.translate(a, data, true, mode)
	if c.Fault != 0 {
		return
	}
	if !c.User && p >= 0o17760000 {
		addr := uint16(p) & 0o177776
		if old, ok := c.internalRead(addr); ok {
			if byteOp {
				if a&1 != 0 {
					v = old&255 | v<<8
				} else {
					v = old&0xff00 | v&255
				}
			}
			c.internalWrite(addr, v)
			return
		}
	}
	width := 2
	if byteOp {
		width = 1
	}
	if f := c.Bus.Store(uint64(p), width, uint64(v), c.Ticks); f != nil {
		if c.User && (f.Kind == emu.Unmapped || f.Kind == emu.Boundary || f.Kind == emu.Permission) {
			c.fail(0o250)
		} else {
			c.fail(4)
		}
	}
}
func (c *CPU) fetch() uint16 {
	a := c.R[7]
	v := c.read(a, false, false, c.mode())
	if c.Fault == 0 {
		c.R[7] += 2
	}
	return v
}
func (c *CPU) push(v uint16) { c.addReg(6, -2); c.write(c.R[6], v, true, false, c.mode()) }
func (c *CPU) pop() uint16 {
	v := c.read(c.R[6], true, false, c.mode())
	if c.Fault == 0 {
		c.addReg(6, 2)
	}
	return v
}
func (c *CPU) TakeTrap(vector uint16) {
	if c.User {
		c.Trap = vector
		c.Fault = 0
		return
	}
	if c.trapping {
		c.Halted = true
		return
	}
	c.trapping = true
	c.Fault = 0
	c.Waiting = false
	pc, psw := c.R[7], c.PSW
	newPC := c.read(vector, true, false, 0)
	newPSW := c.read(vector+2, true, false, 0)
	newPSW = newPSW&^0o30000 | (psw>>2)&0o30000
	if c.Fault == 0 {
		c.SetPSW(newPSW)
		c.push(psw)
		c.push(pc)
		c.R[7] = newPC
	}
	if c.Fault != 0 {
		c.Halted = true
	}
	c.trapping = false
}
func (c *CPU) operand(spec uint16, byteOp bool) uint32 {
	r, kind := int(spec&7), int(spec>>3)&7
	data := dataSpace
	if r == 7 {
		data = 0
	}
	delta := 2
	if byteOp && r < 6 {
		delta = 1
	}
	switch kind {
	case 0:
		return registerSpace | uint32(r)
	case 1:
		return data | uint32(c.R[r])
	case 2:
		a := c.R[r]
		c.addReg(r, delta)
		return data | uint32(a)
	case 3:
		a := c.read(c.R[r], data != 0, false, c.mode())
		if c.Fault == 0 {
			c.addReg(r, 2)
		}
		return dataSpace | uint32(a)
	case 4:
		c.addReg(r, -delta)
		return data | uint32(c.R[r])
	case 5:
		c.addReg(r, -2)
		return dataSpace | uint32(c.read(c.R[r], data != 0, false, c.mode()))
	}
	displacement := c.fetch()
	a := c.R[r] + displacement
	if kind == 7 {
		a = c.read(a, true, false, c.mode())
	}
	return dataSpace | uint32(a)
}
func (c *CPU) get(a uint32, byteOp bool, mode int) uint16 {
	if a&registerSpace != 0 {
		v := c.R[a&7]
		if byteOp {
			v &= 255
		}
		return v
	}
	return c.read(uint16(a), a&dataSpace != 0, byteOp, mode)
}
func (c *CPU) put(a uint32, v uint16, byteOp, extend bool, mode int) {
	if c.Fault != 0 {
		return
	}
	if a&registerSpace != 0 {
		if byteOp {
			if extend {
				v = uint16(int16(int8(v)))
			} else {
				v = c.R[a&7]&0xff00 | v&255
			}
		}
		c.R[a&7] = v
		return
	}
	c.write(uint16(a), v, a&dataSpace != 0, byteOp, mode)
}

// Step executes one architectural action, including interrupt entry or a WAIT
// slot. The machine may advance deterministic devices after each action.
func (c *CPU) Step() {
	if c.Halted || c.Trap != 0 {
		return
	}
	c.Ticks++
	if !c.User && c.System != nil {
		if v := c.System.Interrupt(int(c.PSW>>5) & 7); v != 0 {
			c.TakeTrap(v)
			return
		}
	}
	if c.Waiting {
		return
	}
	c.Fault = 0
	c.InstructionPC = c.R[7]
	oldPSW := c.PSW
	if c.MMR0&0o160000 == 0 {
		c.MMR1 = 0
		c.MMR2 = c.InstructionPC
	}
	c.Instruction = c.fetch()
	if c.Fault == 0 {
		c.execute(c.Instruction)
	}
	if c.Fault != 0 {
		c.TakeTrap(c.Fault)
		c.fpPending = false
	} else if c.fpPending {
		c.fpPending = false
		c.TakeTrap(0o244)
	} else if oldPSW&0o20 != 0 && c.Instruction != 2 && c.Instruction != 6 {
		c.TakeTrap(0o14)
	}
}

// Addressing stays architectural; the generated ALU owns arithmetic and flags.
func (c *CPU) alu(opcode, src, dst uint16) uint16 {
	state := [9]uint64{0: uint64(src), 1: uint64(dst), 8: uint64(c.PSW)}
	if !Execute(uint64(opcode|1), &state) {
		c.fail(0o10)
		return 0
	}
	c.PSW = uint16(state[8])
	return uint16(state[1])
}
func (c *CPU) execute(ins uint16) {
	if ins&0o170000 == 0o170000 {
		c.floating(ins)
		return
	}
	top := ins >> 12
	byteOp := top >= 9 && top <= 13
	if (top >= 1 && top <= 6) || (top >= 9 && top <= 14) {
		sa := c.operand(ins>>6&63, byteOp)
		src := c.get(sa, byteOp, c.mode())
		if c.Fault != 0 {
			return
		}
		da := c.operand(ins&63, byteOp)
		if c.Fault != 0 {
			return
		}
		op := top & 7
		dst := uint16(0)
		if op != 1 {
			dst = c.get(da, byteOp, c.mode())
		}
		if c.Fault != 0 {
			return
		}
		result := c.alu(ins&0xf000, src, dst)
		if op != 2 && op != 3 {
			c.put(da, result, byteOp, op == 1, c.mode())
		}
		return
	}
	branch, condition := true, false
	n, z, v, carry := c.PSW&N != 0, c.PSW&Z != 0, c.PSW&V != 0, c.PSW&C != 0
	switch ins & 0o177400 {
	case 0o000400:
		condition = true
	case 0o001000:
		condition = !z
	case 0o001400:
		condition = z
	case 0o002000:
		condition = n == v
	case 0o002400:
		condition = n != v
	case 0o003000:
		condition = !z && n == v
	case 0o003400:
		condition = z || n != v
	case 0o100000:
		condition = !n
	case 0o100400:
		condition = n
	case 0o101000:
		condition = !carry && !z
	case 0o101400:
		condition = carry || z
	case 0o102000:
		condition = !v
	case 0o102400:
		condition = v
	case 0o103000:
		condition = !carry
	case 0o103400:
		condition = carry
	default:
		branch = false
	}
	if branch {
		if condition {
			c.R[7] += uint16(int16(int8(ins)) * 2)
		}
		return
	}
	reg := int(ins>>6) & 7
	switch ins & 0o177000 {
	case 0o004000:
		da := c.operand(ins&63, false)
		if da&registerSpace != 0 {
			c.fail(4)
		} else if c.Fault == 0 {
			c.push(c.R[reg])
			if c.Fault == 0 {
				c.R[reg] = c.R[7]
				c.R[7] = uint16(da)
			}
		}
		return
	case 0o077000:
		c.R[reg]--
		if c.R[reg] != 0 {
			c.R[7] -= 2 * (ins & 63)
		}
		return
	case 0o074000:
		da := c.operand(ins&63, false)
		dst := c.get(da, false, c.mode())
		if c.Fault != 0 {
			return
		}
		result := c.alu(0o074000, c.R[reg], dst)
		c.put(da, result, false, false, c.mode())
		return
	}
	if ins&0o174000 == 0o070000 {
		c.eis(ins)
		return
	}
	if ins&0o177770 == 0o000200 {
		reg = int(ins & 7)
		src := c.R[reg]
		result := c.pop()
		if c.Fault == 0 {
			c.R[7] = src
			c.R[reg] = result
		}
		return
	}
	if ins&0o177700 == 0o000100 {
		da := c.operand(ins&63, false)
		if da&registerSpace != 0 {
			c.fail(4)
		} else if c.Fault == 0 {
			c.R[7] = uint16(da)
		}
		return
	}
	if ins&0o177700 == 0o000300 {
		da := c.operand(ins&63, false)
		dst := c.get(da, false, c.mode())
		if c.Fault != 0 {
			return
		}
		result := dst<<8 | dst>>8
		c.put(da, result, false, false, c.mode())
		c.nz(result, true)
		c.PSW &^= V | C
		return
	}
	if ins&0o177740 == 0o000240 {
		if ins&0o20 != 0 {
			c.PSW |= ins & 15
		} else {
			c.PSW &^= ins & 15
		}
		return
	}
	if ins&0o177770 == 0o000230 {
		if c.mode() == 0 {
			c.PSW = c.PSW&^0o340 | (ins&7)<<5
		}
		return
	}
	if ins&0o177400 == 0o104000 {
		c.fail(0o30)
		return
	}
	if ins&0o177400 == 0o104400 {
		c.fail(0o34)
		return
	}
	if ins&0o177700 == 0o006400 {
		c.R[6] = c.R[7] + 2*(ins&63)
		c.R[7] = c.R[5]
		c.R[5] = c.pop()
		return
	}
	op := ins & 0o177700
	if op == 0o006500 || op == 0o106500 || op == 0o006600 || op == 0o106600 {
		previous := int(c.PSW>>12) & 3
		da := c.operand(ins&63, false)
		if da&registerSpace == 0 {
			da &= 65535
			if ins&0o100000 != 0 {
				da |= dataSpace
			}
		}
		var src uint16
		if ins&0o7700 == 0o6500 {
			if da == registerSpace|6 && previous != c.mode() {
				src = c.Stacks[previous]
			} else {
				src = c.get(da, false, previous)
			}
			if c.Fault == 0 {
				c.push(src)
			}
		} else {
			src = c.pop()
			if c.Fault == 0 {
				if da == registerSpace|6 && previous != c.mode() {
					c.Stacks[previous] = src
				} else {
					c.put(da, src, false, false, previous)
				}
			}
		}
		if c.Fault == 0 {
			c.nz(src, false)
			c.PSW &^= V
		}
		return
	}
	if op >= 0o005000 && op <= 0o006300 || op >= 0o105000 && op <= 0o106300 || op == 0o006700 || op == 0o106700 || op == 0o106400 {
		c.single(ins)
		return
	}
	switch ins {
	case 0:
		if c.mode() != 0 {
			c.fail(4)
		} else {
			c.Halted = true
		}
	case 1:
		c.Waiting = true
	case 2, 6:
		pc := c.pop()
		psw := c.pop()
		if c.Fault == 0 {
			if c.mode() != 0 {
				psw = psw&0o37 | c.PSW&0o177740
			}
			c.SetPSW(psw)
			c.R[7] = pc
		}
	case 3:
		c.fail(0o14)
	case 4:
		c.fail(0o20)
	case 5:
		if c.mode() == 0 {
			c.MMR0, c.MMR3 = 0, 0
			if c.System != nil {
				c.System.Reset()
			}
		}
	default:
		c.fail(0o10)
	}
}
func (c *CPU) eis(ins uint16) {
	reg := int(ins>>6) & 7
	da := c.operand(ins&63, false)
	src := c.get(da, false, c.mode())
	if c.Fault != 0 {
		return
	}
	op := ins >> 9 & 7
	s := int32(int16(src))
	d := int32(int16(c.R[reg]))
	switch op {
	case 0:
		w := d * s
		c.R[reg] = uint16(uint32(w) >> 16)
		c.R[reg|1] = uint16(w)
		c.flag(N, w < 0)
		c.flag(Z, w == 0)
		c.PSW &^= V
		c.flag(C, w < -32768 || w > 32767)
	case 1:
		w := int32(uint32(c.R[reg])<<16 | uint32(c.R[reg|1]))
		c.PSW &^= N | Z | V | C
		if s == 0 {
			c.PSW |= V | C
		} else if w == -2147483648 && s == -1 {
			c.PSW |= V
		} else {
			q := w / s
			if q < -32768 || q > 32767 {
				c.PSW |= V
			} else {
				c.R[reg] = uint16(q)
				c.R[reg|1] = uint16(w % s)
				c.nz(c.R[reg], false)
			}
		}
	case 2, 3:
		count := int(src & 63)
		if count&32 != 0 {
			count -= 64
		}
		w := uint32(c.R[reg])
		mask, sign := uint32(65535), uint32(32768)
		if op == 3 {
			w = w<<16 | uint32(c.R[reg|1])
			mask, sign = 0xffffffff, 0x80000000
		}
		carry := c.PSW&C != 0
		overflow := false
		for count > 0 {
			carry = w&sign != 0
			w = w << 1 & mask
			overflow = overflow || (carry != (w&sign != 0))
			count--
		}
		for count < 0 {
			carry = w&1 != 0
			w = w>>1 | w&sign
			count++
		}
		if op == 2 {
			c.R[reg] = uint16(w)
		} else {
			c.R[reg] = uint16(w >> 16)
			c.R[reg|1] = uint16(w)
		}
		c.flag(N, w&sign != 0)
		c.flag(Z, w == 0)
		c.flag(V, overflow)
		c.flag(C, carry)
	default:
		c.fail(0o10)
	}
}
func (c *CPU) single(ins uint16) {
	byteOp := ins&0o100000 != 0
	da := c.operand(ins&63, byteOp)
	dst := c.get(da, byteOp, c.mode())
	if c.Fault != 0 {
		return
	}
	op := ins >> 6 & 0o77
	if op >= 0o50 && op <= 0o63 {
		result := c.alu(ins&0o177700, 0, dst)
		if op != 0o57 {
			c.put(da, result, byteOp, false, c.mode())
		}
		return
	}
	result := dst
	switch op {
	case 0o64:
		if c.mode() == 0 {
			c.PSW = c.PSW&0o177400 | dst&0o357
		} else {
			c.PSW = c.PSW&^15 | dst&15
		}
		return
	case 0o67:
		if byteOp {
			result = c.PSW & 255
			c.nz(result, true)
			c.PSW &^= V
		} else {
			result = 0
			if c.PSW&N != 0 {
				result = 65535
			}
			c.flag(Z, result == 0)
			c.PSW &^= V
		}
	default:
		c.fail(0o10)
		return
	}
	c.put(da, result, byteOp, op == 0o67, c.mode())
}

-- cpu_test.go --
package pdp11

import (
	"math/rand"
	emu "renvo.dev/internal/rfe/runtime"
	"testing"
)

type testBus struct{ data [65536]byte }

func (m *testBus) Load(a uint64, w int, k emu.Access, t uint64) (uint64, *emu.Fault) {
	v, _ := m.Peek(a, w)
	return v, nil
}
func (m *testBus) Store(a uint64, w int, v uint64, t uint64) *emu.Fault {
	m.data[a&65535] = byte(v)
	if w == 2 {
		m.data[(a+1)&65535] = byte(v >> 8)
	}
	return nil
}
func (m *testBus) Peek(a uint64, w int) (uint64, bool) {
	v := uint64(m.data[a&65535])
	if w == 2 {
		v |= uint64(m.data[(a+1)&65535]) << 8
	}
	return v, true
}
func (m *testBus) words(a int, words ...uint16) {
	for _, w := range words {
		m.data[a] = byte(w)
		m.data[a+1] = byte(w >> 8)
		a += 2
	}
}

func TestALUVectors(t *testing.T) {
	for _, v := range []struct{ op, src, dst, flags, result, wantFlags uint16 }{
		{0o010000, 0x8000, 0, C, 0x8000, N | C},
		{0o110000, 0x80, 0, C, 0xff80, N | C},
		{0o060000, 1, 0xffff, 0, 0, Z | C},
		{0o060000, 1, 0x7fff, 0, 0x8000, N | V},
		{0o160000, 1, 0, 0, 0xffff, N | C},
		{0o020000, 0x8000, 1, 0, 1, V},
		{0o120000, 0, 255, 0, 255, C},
		{0o140000, 0xf0, 0xabcd, C, 0xab0d, C},
		{0o150000, 0x80, 0xab00, C, 0xab80, N | C},
		{0o105100, 0, 0xab00, 0, 0xabff, N | C},
		{0o105200, 0, 0xab7f, C, 0xab80, N | V | C},
		{0o105300, 0, 0xab80, C, 0xab7f, V | C},
		{0o005400, 0, 0x8000, 0, 0x8000, N | V | C},
		{0o005500, 0, 0xffff, C, 0, Z | C},
		{0o005600, 0, 0, C, 0xffff, N | C},
		{0o006000, 0, 1, 0, 0, Z | V | C},
		{0o006100, 0, 0x8000, 0, 0, Z | V | C},
		{0o006200, 0, 0x8001, 0, 0xc000, N | C},
		{0o006300, 0, 0x4000, 0, 0x8000, N | V},
		{0o005000, 0, 0xffff, C, 0, Z},
		{0o105700, 0, 0xab00, C, 0xab00, Z},
		{0o074000, 0x8000, 1, C, 0x8001, N | C},
	} {
		c := CPU{PSW: 0o140000 | v.flags}
		result := c.alu(v.op, v.src, v.dst)
		if result != v.result || c.PSW != 0o140000|v.wantFlags {
			t.Fatalf("op %06o: result %06o flags %06o, want %06o %06o", v.op, result, c.PSW, v.result, 0o140000|v.wantFlags)
		}
	}
}

func TestIntegerAndAddressing(t *testing.T) {
	m := &testBus{}
	c := CPU{Bus: m, User: true, PSW: 0o140000}
	m.words(0, 0o012700, 0xffff, 0o010001, 0o105201, 0o112702, 0o200, 0o062700, 1)
	for i := 0; i < 5; i++ {
		c.Step()
	}
	if c.Trap != 0 || c.R[0] != 0 || c.R[1] != 0o177400 || c.R[2] != 0o177600 || c.PSW&15 != Z|C {
		t.Fatalf("integer flags: %+v", c)
	}
	c = CPU{Bus: m, User: true}
	m.words(0, 0o012021)
	m.words(0o100, 0o12345)
	c.R[0], c.R[1] = 0o100, 0o200
	c.Step()
	v, _ := m.Peek(0o200, 2)
	if c.Trap != 0 || v != 0o12345 || c.R[0] != 0o102 || c.R[1] != 0o202 {
		t.Fatal("autoincrement addressing")
	}
	c = CPU{Bus: m, User: true}
	c.R[7] = 1
	c.Step()
	if c.Trap != 4 || c.R[7] != 1 {
		t.Fatal("odd instruction fetch")
	}
}

func TestLoweringMatchesArchitecture(t *testing.T) {
	native, err := emu.NewNative(8 << 20)
	if err != nil {
		t.Fatal(err)
	}
	defer native.Close()
	random := rand.New(rand.NewSource(473))
	m := &testBus{}
	// Exhaust the decoder space; compare architectural state with portable IR
	// and actual native execution, including carry/overflow edge values.
	for instruction := 0; instruction < 65536; instruction++ {
		var b emu.Builder
		accepted := Lower(uint64(instruction), &b)
		if accepted != Decodable(uint64(instruction)) {
			t.Fatalf("decode disagreement %06o", instruction)
		}
		if !accepted {
			continue
		}
		ops := b.Finish(9)
		entry, err := native.Compile(ops, 9)
		if err != nil {
			t.Fatal(err)
		}
		for sample := 0; sample < 16; sample++ {
			c := CPU{Bus: m, User: true, PSW: 0o140000 | uint16(sample)}
			state := make([]uint64, 9)
			for i := 0; i < 7; i++ {
				c.R[i] = uint16(random.Uint32())
				if sample < 5 {
					c.R[i] = []uint16{0, 1, 0x7fff, 0x8000, 0xffff}[(sample+i)%5]
				}
				state[i] = uint64(c.R[i])
			}
			state[8] = uint64(c.PSW)
			m.words(0, uint16(instruction))
			c.Step()
			if c.Trap != 0 {
				t.Fatalf("unexpected trap %06o", instruction)
			}
			for _, mode := range []string{"ir", "native"} {
				got := append([]uint64{}, state...)
				if mode == "ir" {
					err = emu.Interpret(ops, got)
				} else {
					err = native.Call(entry, got)
				}
				if err != nil {
					t.Fatal(err)
				}
				for i := 0; i < 7; i++ {
					if got[i] != uint64(c.R[i]) {
						t.Fatalf("%s %06o sample %d r%d: got %06o want %06o", mode, instruction, sample, i, got[i], c.R[i])
					}
				}
				if got[8] != uint64(c.PSW) {
					t.Fatalf("%s %06o sample %d flags: got %06o want %06o", mode, instruction, sample, got[8], c.PSW)
				}
			}
		}
	}
}

func TestEngineInvalidationAndBudget(t *testing.T) {
	e, err := NewEngine("native")
	if err != nil {
		t.Fatal(err)
	}
	defer e.Close()
	m := &testBus{}
	m.words(0, 0o005200, 0o005201, 0)
	c := CPU{Bus: m, User: true}
	for i := 0; i < 12; i++ {
		c.R[7] = 0
		e.Step(&c, 2)
	}
	if e.Stats.NativeInstructions == 0 {
		t.Fatal("native code never executed")
	}
	c.R[7] = 0
	before := c.R[0]
	m.words(0, 0o005300)
	e.Step(&c, 2)
	if c.R[0] != before-1 || e.Stats.Invalidations == 0 {
		t.Fatal("stale code after guest write")
	}
	for i := 0; i < 12; i++ {
		c.R[7] = 0
		e.Step(&c, 2)
	}
	c.R[7] = 0
	ticks := c.Ticks
	r1 := c.R[1]
	e.Step(&c, 1)
	if c.Ticks != ticks+1 || c.R[1] != r1 {
		t.Fatal("block crossed instruction budget")
	}
	c.R[7] = 0
	c.PSW |= 0o20
	e.Step(&c, 2)
	if c.Trap != 0o14 {
		t.Fatal("trace boundary skipped")
	}
}

func BenchmarkRegisterBlock(b *testing.B) {
	for _, mode := range []string{"interpreter", "ir", "native"} {
		b.Run(mode, func(b *testing.B) {
			e, err := NewEngine(mode)
			if err != nil {
				b.Fatal(err)
			}
			defer e.Close()
			m := &testBus{}
			for i := 0; i < 16; i++ {
				m.words(i*2, 0o005200+uint16(i%6))
			}
			m.words(32, 0)
			c := CPU{Bus: m, User: true}
			for i := 0; i < 16; i++ {
				c.R[7] = 0
				e.Step(&c, 16)
			}
			b.ResetTimer()
			for i := 0; i < b.N; i++ {
				c.R[7] = 0
				for left := 16; left > 0; {
					left -= e.Step(&c, left)
				}
			}
			b.StopTimer()
			b.ReportMetric(float64(e.Stats.CodeBytes), "code-bytes")
		})
	}
}

-- engine.go --
package pdp11

import (
	"fmt"
	emu "renvo.dev/internal/rfe/runtime"
)

type block struct {
	words  []uint16
	ops    []emu.Op
	entry  int
	native bool
	hits   int
}
type Stats struct {
	Compiled, NativeInstructions, IRInstructions, InterpreterInstructions, Invalidations uint64
	CodeBytes                                                                            int
}

// Engine caches only pure blocks. Every dispatch rechecks code through Peek;
// MMIO is never speculatively read. Guest writes, DMA, changed images and MMU
// mappings therefore cannot execute stale translated bytes.
type Engine struct {
	Mode   string
	Stats  Stats
	blocks map[uint16]*block
	native *emu.Native
	full   bool
}

func NewEngine(mode string) (*Engine, error) {
	if mode != "native" && mode != "ir" && mode != "interpreter" {
		return nil, fmt.Errorf("engine must be native, ir, or interpreter")
	}
	e := &Engine{Mode: mode, blocks: map[uint16]*block{}}
	if mode == "native" {
		var err error
		e.native, err = emu.NewNative(8 << 20)
		if err != nil {
			return nil, err
		}
	}
	return e, nil
}
func (e *Engine) Close() error {
	if e.native != nil {
		return e.native.Close()
	}
	return nil
}
func (c *CPU) peekInstruction(pc uint16) (uint16, bool) {
	if pc&1 != 0 {
		return 0, false
	}
	p := uint64(pc)
	if !c.User {
		if c.MMR0&1 != 0 {
			page := c.mode()*16 + int(pc>>13)
			d := c.PDR[page]
			access := d & 7
			block, limit := int(pc>>6)&127, int(d>>8)&127
			if access == 0 || access == 3 || access == 7 || d&8 != 0 && block < limit || d&8 == 0 && block > limit {
				return 0, false
			}
			p = (uint64(c.PAR[page])*64 + uint64(pc&8191)) & 0o777777
			if p >= 0o760000 {
				return 0, false
			}
		} else if pc >= 0o160000 {
			return 0, false
		}
	}
	v, ok := c.Bus.Peek(p, 2)
	return uint16(v), ok
}
func (e *Engine) Step(c *CPU, budget int) int {
	if budget <= 0 || c.Halted || c.Trap != 0 {
		return 0
	}
	fallback := func() int { c.Step(); e.Stats.InterpreterInstructions++; return 1 }
	if e.Mode == "interpreter" || c.Waiting || c.PSW&0o20 != 0 {
		return fallback()
	}
	if word, ok := c.peekInstruction(c.R[7]); !ok || !Decodable(uint64(word)) {
		return fallback()
	}
	// Device state cannot change inside a pure block. Check pending interrupts
	// at the entry boundary before evaluating any guest instructions.
	if !c.User && c.System != nil {
		if v := c.System.Interrupt(int(c.PSW>>5) & 7); v != 0 {
			c.Ticks++
			c.TakeTrap(v)
			e.Stats.InterpreterInstructions++
			return 1
		}
	}
	pc := c.R[7]
	cached := e.blocks[pc]
	if cached != nil {
		for i, word := range cached.words {
			v, ok := c.peekInstruction(pc + uint16(2*i))
			if !ok || v != word {
				delete(e.blocks, pc)
				cached = nil
				e.Stats.Invalidations++
				break
			}
		}
	}
	if cached == nil {
		if len(e.blocks) >= 4096 {
			return fallback()
		}
		b := &emu.Builder{}
		var words []uint16
		for i := 0; i < 32; i++ {
			word, ok := c.peekInstruction(pc + uint16(i*2))
			if !ok || !Lower(uint64(word), b) {
				break
			}
			words = append(words, word)
		}
		if len(words) == 0 {
			return fallback()
		}
		b.Store(7, b.Binary(emu.And, b.Binary(emu.Add, b.Load(7), b.Constant(uint64(len(words)*2))), b.Constant(65535)))
		ops := b.Finish(LoweringStateWords)
		if emu.Validate(ops, LoweringStateWords) != nil {
			return fallback()
		}
		cached = &block{words: words, ops: ops}
		e.blocks[pc] = cached
	}
	if len(cached.words) > budget {
		return fallback()
	}
	cached.hits++
	if e.Mode == "native" && !cached.native && !e.full && cached.hits == 8 {
		entry, err := e.native.Compile(cached.ops, LoweringStateWords)
		if err == nil {
			cached.entry, cached.native = entry, true
			e.Stats.Compiled++
			e.Stats.CodeBytes = e.native.Bytes
		} else {
			e.full = true
		}
	}
	if e.Mode == "native" && !cached.native {
		return fallback()
	}
	state := make([]uint64, 9)
	for i := 0; i < 8; i++ {
		state[i] = uint64(c.R[i])
	}
	state[8] = uint64(c.PSW)
	var err error
	if cached.native {
		err = e.native.Call(cached.entry, state)
	} else {
		err = emu.Interpret(cached.ops, state)
	}
	if err != nil {
		return fallback()
	}
	count := len(cached.words)
	c.InstructionPC = pc + uint16((count-1)*2)
	c.Instruction = cached.words[count-1]
	c.Fault = 0
	if !c.User && c.MMR0&1 != 0 {
		for i := 0; i < count; i++ {
			c.PDR[c.mode()*16+int((pc+uint16(i*2))>>13)] |= 0o200
		}
	}
	if c.MMR0&0o160000 == 0 {
		c.MMR1 = 0
		c.MMR2 = c.InstructionPC
	}
	for i := 0; i < 8; i++ {
		c.R[i] = uint16(state[i])
	}
	c.PSW = uint16(state[8])
	c.Ticks += uint64(count)
	if cached.native {
		e.Stats.NativeInstructions += uint64(count)
	} else {
		e.Stats.IRInstructions += uint64(count)
	}
	return count
}

-- floating.go --
package pdp11

import "math/big"

// FP11 F/D format: sign, biased 8-bit exponent, and 23/55 fraction bits.
// Raw words retain DEC word order; no IEEE conversion can discard D's low bits.
// Instruction semantics follow DEC's PDP-11 Architecture Handbook, chapter 6.
const (
	fpSign            uint64 = 1 << 63
	fpFraction        uint64 = (1 << 55) - 1
	fpTruncate        uint16 = 1 << 5
	fpLong            uint16 = 1 << 6
	fpDouble          uint16 = 1 << 7
	fpConvertEnable   uint16 = 1 << 8
	fpOverflowEnable  uint16 = 1 << 9
	fpUnderflowEnable uint16 = 1 << 10
	fpUndefinedEnable uint16 = 1 << 11
	fpDisable         uint16 = 1 << 14
	fpError           uint16 = 1 << 15
	fpStatusMask      uint16 = 0o147757
)

func fpExponent(raw uint64) int { return int(raw>>55) & 255 }
func fpScaled(n *big.Int, shift int) *big.Rat {
	n = new(big.Int).Set(n)
	d := big.NewInt(1)
	if shift >= 0 {
		n.Lsh(n, uint(shift))
	} else {
		d.Lsh(d, uint(-shift))
	}
	return new(big.Rat).SetFrac(n, d)
}
func fpNumber(raw uint64) *big.Rat {
	if fpExponent(raw) == 0 {
		return new(big.Rat)
	}
	n := new(big.Int).SetUint64(raw&fpFraction | 1<<55)
	if raw&fpSign != 0 {
		n.Neg(n)
	}
	return fpScaled(n, fpExponent(raw)-128-56)
}
func (c *CPU) fpException(code uint16) bool {
	enable := uint16(0)
	switch code {
	case 6:
		enable = fpConvertEnable
	case 8:
		enable = fpOverflowEnable
	case 10:
		enable = fpUnderflowEnable
	case 12:
		enable = fpUndefinedEnable
	}
	if enable != 0 && c.FPS&enable == 0 {
		return false
	}
	c.FPS |= fpError
	c.FEC, c.FEA = code, c.InstructionPC
	if c.FPS&fpDisable == 0 {
		c.fpPending = true
	}
	return true
}
func (c *CPU) fpFlags(raw uint64, overflow bool) {
	c.FPS &^= 15
	if fpExponent(raw) == 0 {
		c.FPS |= Z
	}
	if raw&fpSign != 0 {
		c.FPS |= N
	}
	if overflow {
		c.FPS |= V
	}
}
func (c *CPU) fpLength() int {
	if c.FPS&fpDouble != 0 {
		return 8
	}
	return 4
}
func (c *CPU) fpStoreReg(r int, raw uint64, size int) {
	if c.Fault != 0 {
		return
	}
	if size == 4 {
		raw = raw&0xffffffff00000000 | c.FR[r]&0xffffffff
	}
	c.FR[r] = raw
}
func (c *CPU) fpReg(r, size int) uint64 {
	if size == 4 {
		return c.FR[r] & 0xffffffff00000000
	}
	return c.FR[r]
}
func (c *CPU) fpAddress(spec uint16, size int) uint32 {
	r, kind := int(spec&7), spec>>3
	data := dataSpace
	if r == 7 {
		data = 0
	}
	if kind == 2 {
		at := c.R[r]
		if r == 7 {
			size = 2
		}
		c.addReg(r, size)
		return data | uint32(at)
	}
	if kind == 4 {
		c.addReg(r, -size)
		return data | uint32(c.R[r])
	}
	return c.operand(spec, false)
}
func (c *CPU) fpRead(spec uint16, at uint32, size int) (uint64, bool) {
	if c.Fault != 0 {
		return 0, false
	}
	if spec < 8 {
		if spec >= 6 {
			c.fpException(2)
			return 0, false
		}
		return c.fpReg(int(spec), size), true
	}
	if spec == 0o27 {
		size = 2
	}
	var raw uint64
	for i := 0; i < size; i += 2 {
		raw |= uint64(c.read(uint16(at)+uint16(i), at&dataSpace != 0, false, c.mode())) << uint(48-i*8)
	}
	if c.Fault != 0 {
		return 0, false
	}
	if fpExponent(raw) == 0 && raw&fpSign != 0 && c.fpException(12) {
		return 0, false
	}
	return raw, true
}
func (c *CPU) fpWrite(spec uint16, at uint32, size int, raw uint64) {
	if c.Fault != 0 {
		return
	}
	if spec < 8 {
		if spec >= 6 {
			c.fpException(2)
			return
		}
		c.fpStoreReg(int(spec), raw, size)
		return
	}
	if spec == 0o27 {
		size = 2
	}
	for i := 0; i < size; i += 2 {
		c.write(uint16(at)+uint16(i), uint16(raw>>uint(48-i*8)), at&dataSpace != 0, false, c.mode())
	}
}

// Quantize with DEC's magnitude round-half-up or truncate rule. big integers
// keep all 56 D bits and intermediate products; host float64 is never used.
func (c *CPU) fpPack(value *big.Rat, size int, truncate bool) (uint64, bool) {
	if value.Sign() == 0 {
		return 0, false
	}
	n := new(big.Int).Abs(value.Num())
	d := new(big.Int).Set(value.Denom())
	e := n.BitLen() - d.BitLen()
	if e >= 0 {
		if n.Cmp(new(big.Int).Lsh(new(big.Int).Set(d), uint(e))) >= 0 {
			e++
		}
	} else if new(big.Int).Lsh(new(big.Int).Set(n), uint(-e)).Cmp(d) >= 0 {
		e++
	}
	precision := 56
	if size == 4 {
		precision = 24
	}
	shift := precision - e
	if shift >= 0 {
		n.Lsh(n, uint(shift))
	} else {
		d.Lsh(d, uint(-shift))
	}
	q, rem := new(big.Int), new(big.Int)
	q.QuoRem(n, d, rem)
	if !truncate && rem.Lsh(rem, 1).Cmp(d) >= 0 {
		q.Add(q, big.NewInt(1))
	}
	if q.BitLen() > precision {
		q.Rsh(q, 1)
		e++
	}
	exp := e + 128
	raw := uint64(exp&255)<<55 | (q.Uint64()<<uint(56-precision))&fpFraction
	if value.Sign() < 0 {
		raw |= fpSign
	}
	if exp > 255 {
		if !c.fpException(8) {
			raw = 0
		}
		return raw, true
	}
	if exp <= 0 && !c.fpException(10) {
		raw = 0
	}
	return raw, false
}

// FP11 addition aligns operands with three guard bits before signed addition.
func fpAdd(a, b uint64, size int) *big.Rat {
	if fpExponent(a) == 0 {
		return fpNumber(b)
	}
	if fpExponent(b) == 0 {
		return fpNumber(a)
	}
	precision := 56
	if size == 4 {
		precision = 24
	}
	e := fpExponent(a)
	if fpExponent(b) > e {
		e = fpExponent(b)
	}
	align := func(raw uint64) *big.Int {
		n := new(big.Int).SetUint64((raw&fpFraction | 1<<55) >> uint(56-precision))
		n.Lsh(n, 3)
		n.Rsh(n, uint(e-fpExponent(raw)))
		if raw&fpSign != 0 {
			n.Neg(n)
		}
		return n
	}
	return fpScaled(new(big.Int).Add(align(a), align(b)), e-128-precision-3)
}

func (c *CPU) floating(ins uint16) {
	op, ac, spec := ins>>8&15, int(ins>>6&3), ins&63
	size := c.fpLength()
	trunc := c.FPS&fpTruncate != 0
	if op == 0 {
		switch ac {
		case 0:
			switch ins {
			case 0o170000:
				c.PSW = c.PSW&^15 | c.FPS&15
			case 0o170001:
				c.FPS &^= fpDouble
			case 0o170002:
				c.FPS &^= fpLong
			case 0o170011:
				c.FPS |= fpDouble
			case 0o170012:
				c.FPS |= fpLong
			default:
				c.fpException(2)
			}
		case 1:
			v := c.get(c.fpAddress(spec, 2), false, c.mode())
			if c.Fault == 0 {
				c.FPS = v & fpStatusMask
			}
		case 2:
			c.put(c.fpAddress(spec, 2), c.FPS&fpStatusMask, false, false, c.mode())
		case 3:
			if spec < 8 {
				c.R[spec] = c.FEC
			} else {
				at := c.fpAddress(spec, 4)
				c.write(uint16(at), c.FEC, at&dataSpace != 0, false, c.mode())
				if spec != 0o27 {
					c.write(uint16(at)+2, c.FEA, at&dataSpace != 0, false, c.mode())
				}
			}
		}
		return
	}
	if op == 10 || op == 13 { // STEXP / LDEXP, ordinary word operand
		at := c.fpAddress(spec, 2)
		if op == 10 {
			v := uint16(fpExponent(c.FR[ac]) - 128)
			c.put(at, v, false, false, c.mode())
			if c.Fault != 0 {
				return
			}
			c.PSW &^= 15
			c.nz(v, false)
			c.FPS = c.FPS&^15 | c.PSW&15
		} else {
			exp := int(int16(c.get(at, false, c.mode()))) + 128
			if c.Fault != 0 {
				return
			}
			raw := c.fpReg(ac, size)&^(uint64(255)<<55) | uint64(exp&255)<<55
			if exp > 255 && !c.fpException(8) || exp <= 0 && !c.fpException(10) {
				raw = 0
			}
			c.fpStoreReg(ac, raw, size)
			c.fpFlags(raw, exp > 255)
		}
		return
	}
	if op == 11 || op == 14 { // STCFI / LDCIF (word or long integer)
		width := 2
		if c.FPS&fpLong != 0 {
			width = 4
		}
		at := c.fpAddress(spec, width)
		if op == 14 {
			v := uint32(c.get(at, false, c.mode())) << 16
			if width == 4 && spec >= 8 && spec != 0o27 {
				v |= uint32(c.read(uint16(at)+2, at&dataSpace != 0, false, c.mode()))
			}
			if c.Fault != 0 {
				return
			}
			integer := int64(int32(v))
			if width == 2 {
				integer >>= 16
			}
			raw, ov := c.fpPack(new(big.Rat).SetInt64(integer), size, trunc)
			c.fpStoreReg(ac, raw, size)
			c.fpFlags(raw, ov)
		} else {
			value := fpNumber(c.fpReg(ac, size))
			i := new(big.Int).Quo(value.Num(), value.Denom())
			limit := int64(1) << uint(width*8-1)
			bad := !i.IsInt64() || i.Int64() < -limit || i.Int64() >= limit
			v := int64(0)
			if !bad {
				v = i.Int64()
			}
			word := uint16(v)
			if width == 4 {
				word = uint16(v >> 16)
			}
			c.put(at, word, false, false, c.mode())
			if width == 4 && spec >= 8 && spec != 0o27 {
				c.write(uint16(at)+2, uint16(v), at&dataSpace != 0, false, c.mode())
			}
			if c.Fault != 0 {
				return
			}
			c.PSW &^= 15
			c.flag(N, v < 0)
			c.flag(Z, v == 0)
			c.flag(C, bad)
			c.FPS = c.FPS&^15 | c.PSW&15
			if bad {
				c.fpException(6)
			}
		}
		return
	}
	operandSize := size
	if op == 12 || op == 15 {
		operandSize = 12 - size
	}
	if spec < 8 && spec >= 6 {
		c.fpException(2)
		return
	}
	at := c.fpAddress(spec, operandSize)
	if c.Fault != 0 {
		return
	}
	if op == 8 {
		c.fpWrite(spec, at, size, c.fpReg(ac, size))
		return
	}
	if op == 12 {
		raw, ov := c.fpPack(fpNumber(c.fpReg(ac, size)), operandSize, trunc)
		c.fpWrite(spec, at, operandSize, raw)
		if c.Fault == 0 {
			c.fpFlags(raw, ov)
		}
		return
	}
	if op == 1 && ac == 0 {
		c.fpWrite(spec, at, size, 0)
		if c.Fault == 0 {
			c.fpFlags(0, false)
		}
		return
	}
	src, ok := c.fpRead(spec, at, operandSize)
	if !ok {
		return
	}
	if op == 1 {
		if ac == 2 || ac == 3 {
			if fpExponent(src) == 0 {
				src = 0
			} else if ac == 2 {
				src &^= fpSign
			} else {
				src ^= fpSign
			}
			c.fpWrite(spec, at, size, src)
		}
		if c.Fault == 0 {
			c.fpFlags(src, false)
		}
		return
	}
	if op == 5 {
		c.fpStoreReg(ac, src, size)
		c.fpFlags(src, false)
		return
	}
	if op == 15 {
		raw, ov := c.fpPack(fpNumber(src), size, trunc)
		c.fpStoreReg(ac, raw, size)
		c.fpFlags(raw, ov)
		return
	}
	dst := c.fpReg(ac, size)
	a, b := fpNumber(dst), fpNumber(src)
	if op == 7 {
		cmp := b.Cmp(a)
		c.FPS &^= 15
		if cmp == 0 {
			c.FPS |= Z
			if a.Sign() == 0 {
				c.fpStoreReg(ac, 0, size)
			}
		}
		if cmp < 0 {
			c.FPS |= N
		}
		return
	}
	var value *big.Rat
	switch op {
	case 2, 3:
		value = new(big.Rat).Mul(a, b)
	case 4:
		value = fpAdd(dst, src, size)
	case 6:
		if fpExponent(src) != 0 {
			src ^= fpSign
		}
		value = fpAdd(dst, src, size)
	case 9:
		if b.Sign() == 0 {
			c.fpException(4)
			return
		}
		value = new(big.Rat).Quo(a, b)
	}
	if op == 3 {
		// The FP11 develops 59 product bits before normalization. Single
		// precision's 48-bit product is exact; D mode discards the low bits.
		if size == 8 && value.Sign() != 0 {
			e := fpExponent(dst) + fpExponent(src) - 256
			magnitude := new(big.Int).Mul(new(big.Int).SetUint64(dst&fpFraction|1<<55), new(big.Int).SetUint64(src&fpFraction|1<<55))
			magnitude.Rsh(magnitude, 53)
			if value.Sign() < 0 {
				magnitude.Neg(magnitude)
			}
			value = fpScaled(magnitude, e-59)
		}
		integer := new(big.Int).Quo(value.Num(), value.Denom())
		whole := new(big.Rat).SetInt(integer)
		fraction := new(big.Rat).Sub(value, whole)
		precision := uint(56)
		if size == 4 {
			precision = 24
		}
		if new(big.Int).Abs(integer).BitLen() > int(precision) {
			fraction = new(big.Rat)
		}
		integerRaw, ov := c.fpPack(whole, size, true)
		fractionRaw, fv := c.fpPack(fraction, size, trunc)
		if ac&1 == 0 {
			c.fpStoreReg(ac+1, integerRaw, size)
		}
		c.fpStoreReg(ac, fractionRaw, size)
		c.fpFlags(fractionRaw, ov || fv)
		return
	}
	raw, ov := c.fpPack(value, size, trunc)
	c.fpStoreReg(ac, raw, size)
	c.fpFlags(raw, ov)
}

-- floating_test.go --
package pdp11

import (
	"fmt"
	emu "renvo.dev/internal/rfe/runtime"
	"testing"
)

const fpOne uint64 = 0x4080000000000000

func fpTestStep(c *CPU, m *testBus, opcode uint16) {
	m.words(0, opcode)
	c.R[7], c.Trap, c.Fault = 0, 0, 0
	c.Step()
}

func BenchmarkFloating(b *testing.B) {
	for _, size := range []int{4, 8} {
		for _, op := range []uint16{0xf401, 0xf201, 0xf901} {
			b.Run(fmt.Sprintf("size%d-op%o", size, op), func(b *testing.B) {
				m := &testBus{}
				m.words(0, op)
				c := CPU{Bus: m, User: true}
				if size == 8 {
					c.FPS = fpDouble
				}
				b.ReportAllocs()
				for i := 0; i < b.N; i++ {
					c.R[7] = 0
					c.FR[0] = fpOne + 1
					c.FR[1] = 0x40c0000000000000
					c.Step()
				}
			})
		}
	}
}

func TestFPArithmeticAndPrecision(t *testing.T) {
	for _, mode := range []string{"interpreter", "ir", "native"} {
		e, err := NewEngine(mode)
		if err != nil {
			t.Fatal(err)
		}
		m := &testBus{}
		c := CPU{Bus: m, User: true, FPS: fpDouble}
		for _, v := range []struct {
			op         uint16
			a, b, want uint64
		}{
			{4, 0x40c0000000000000, 0x4110000000000000, 0x4170000000000000}, // 1.5+2.25
			{6, 0x4110000000000000, 0x40c0000000000000, 0x4040000000000000}, // 2.25-1.5
			{2, 0x40c0000000000000, 0x4110000000000000, 0x4158000000000000}, // 1.5*2.25
			{9, 0x4110000000000000, 0x40c0000000000000, 0x40c0000000000000},
			{4, fpOne, uint64(74) << 55, fpOne + 1}, // D's 56th significand bit
			{6, fpOne + 1, fpOne, uint64(74) << 55},
			{4, fpOne, fpOne | fpSign, 0},
		} {
			c.FR[0], c.FR[1] = v.a, v.b
			m.words(0, 0xf000|v.op<<8|1)
			c.R[7] = 0
			e.Step(&c, 1)
			if c.Trap != 0 || c.FR[0] != v.want {
				t.Fatalf("%s op %d: %016x want %016x trap %o", mode, v.op, c.FR[0], v.want, c.Trap)
			}
		}
		e.Close()
	}
	for _, size := range []int{4, 8} {
		for _, trunc := range []bool{false, true} {
			m := &testBus{}
			c := CPU{Bus: m, User: true}
			precision := 24
			if size == 8 {
				c.FPS = fpDouble
				precision = 56
			}
			if trunc {
				c.FPS |= fpTruncate
			}
			c.FR[0], c.FR[1] = fpOne, uint64(129-precision)<<55
			fpTestStep(&c, m, 0xf401)
			want := fpOne
			if !trunc {
				want += uint64(1) << uint(56-precision)
			}
			if c.FR[0] != want {
				t.Fatalf("round size %d trunc %v: %x want %x", size, trunc, c.FR[0], want)
			}
		}
	}
}

func TestFPOperandsConversionsAndStatus(t *testing.T) {
	m := &testBus{}
	c := CPU{Bus: m, User: true, FPS: fpDouble}
	c.R[0] = 0o200
	m.words(0o200, 0x4080, 0, 0, 1)
	fpTestStep(&c, m, 0xf510) // LDD (R0)+,AC0
	if c.FR[0] != fpOne+1 || c.R[0] != 0o210 {
		t.Fatalf("double load/address: %+v", c)
	}
	c.R[0] = 0o220
	fpTestStep(&c, m, 0xf820)
	if c.R[0] != 0o210 {
		t.Fatal("double predecrement")
	}
	for i, w := range []uint16{0x4080, 0, 0, 1} {
		got, _ := m.Peek(uint64(0o210+i*2), 2)
		if got != uint64(w) {
			t.Fatal("DEC word order")
		}
	}
	m.words(2, 0x40c0)
	fpTestStep(&c, m, 0xf517)
	if c.FR[0] != 0x40c0000000000000 || c.R[7] != 4 {
		t.Fatal("immediate is one high word")
	}
	c.FR[4] = fpOne + 7
	fpTestStep(&c, m, 0xf504)
	if c.FR[0] != fpOne+7 {
		t.Fatal("six floating accumulators")
	}
	fpTestStep(&c, m, 0xf506)
	if c.Trap != 0o244 || c.FEC != 2 {
		t.Fatal("illegal floating register")
	}
	c.FPS = 0
	c.FR[0] = fpOne | 0x12345678
	c.FR[1] = fpOne
	fpTestStep(&c, m, 0xf401)
	if c.FR[0] != 0x4100000012345678 {
		t.Fatal("F mode preserves low accumulator half")
	}
	c.FPS = fpDouble
	c.R[0] = 0xfffd
	fpTestStep(&c, m, 0xfe00)
	if c.FR[0] != 0xc140000000000000 {
		t.Fatal("integer to D")
	}
	fpTestStep(&c, m, 0xfb01)
	if c.R[1] != 0xfffd || c.PSW&15 != N || c.FPS&15 != N {
		t.Fatal("D to integer flags")
	}
	c.FPS |= fpLong
	c.R[0] = 0o200
	m.words(0o200, 0x7fff, 0xffff)
	fpTestStep(&c, m, 0xfe10)
	c.R[1] = 0o220
	fpTestStep(&c, m, 0xfb11)
	hi, _ := m.Peek(0o220, 2)
	lo, _ := m.Peek(0o222, 2)
	if hi != 0x7fff || lo != 0xffff || c.R[1] != 0o224 {
		t.Fatal("long integer conversion")
	}
	c.FR[0] = fpOne + uint64(1)<<31 // halfway to next F number
	fpTestStep(&c, m, 0xfc01)       // STCDF AC0,AC1
	if c.FR[1]>>32 != 0x40800001 {
		t.Fatalf("D to F rounding: %x", c.FR[1])
	}
	c.FPS = 0
	fpTestStep(&c, m, 0xff01) // LDCDF AC1,AC0
	if c.FR[0]>>32 != 0x40800001 {
		t.Fatal("opposite precision load")
	}
	c.FPS = fpDouble
	c.FR[0] = fpOne
	c.R[0] = 3
	fpTestStep(&c, m, 0xfd00)
	if c.FR[0] != 0x4180000000000000 {
		t.Fatal("LDEXP")
	}
	fpTestStep(&c, m, 0xfa01)
	if c.R[1] != 3 || c.PSW&15 != 0 {
		t.Fatal("STEXP")
	}
	c.FPS |= N | C
	fpTestStep(&c, m, 0o170000)
	if c.PSW&15 != N|C {
		t.Fatal("CFCC")
	}
	for _, v := range []struct {
		ins  uint16
		mask uint16
		set  bool
	}{{0o170001, fpDouble, false}, {0o170011, fpDouble, true}, {0o170012, fpLong, true}, {0o170002, fpLong, false}} {
		fpTestStep(&c, m, v.ins)
		if (c.FPS&v.mask != 0) != v.set {
			t.Fatal("FP mode control")
		}
	}
}

func TestFPExceptionsAndModulo(t *testing.T) {
	m := &testBus{}
	c := CPU{Bus: m, User: true, FPS: fpDouble}
	c.FR[0], c.FR[1] = fpOne, 0
	fpTestStep(&c, m, 0xf901)
	if c.Trap != 0o244 || c.FR[0] != fpOne || c.FEC != 4 || c.FEA != 0 || c.FPS&fpError == 0 {
		t.Fatal("divide zero trap")
	}
	c.R[0] = 0o200
	fpTestStep(&c, m, 0o170320) // STST (R0)+
	code, _ := m.Peek(0o200, 2)
	addr, _ := m.Peek(0o202, 2)
	if code != 4 || addr != 0 || c.R[0] != 0o204 {
		t.Fatal("STST")
	}
	c.FPS = fpDouble | fpDisable
	fpTestStep(&c, m, 0xf901)
	if c.Trap != 0 || c.FEC != 4 || c.FPS&fpError == 0 {
		t.Fatal("interrupt disable")
	}
	for _, enabled := range []bool{false, true} {
		c.FPS = fpDouble
		if enabled {
			c.FPS |= fpOverflowEnable | fpUnderflowEnable | fpConvertEnable | fpUndefinedEnable
		}
		c.FR[0], c.FR[1] = uint64(255)<<55, 0x4100000000000000
		fpTestStep(&c, m, 0xf201)
		if (c.Trap == 0o244) != enabled || c.FPS&V == 0 || !enabled && c.FR[0] != 0 {
			t.Fatal("overflow")
		}
		c.FR[0], c.FR[1] = uint64(1)<<55, 0x4000000000000000
		fpTestStep(&c, m, 0xf201)
		if (c.Trap == 0o244) != enabled || enabled && c.FEC != 10 {
			t.Fatal("underflow")
		}
		c.FR[0] = uint64(145) << 55 // +65536 cannot fit a word
		fpTestStep(&c, m, 0xfb00)
		if (c.Trap == 0o244) != enabled || c.R[0] != 0 || c.PSW&15 != Z|C {
			t.Fatal("conversion exception")
		}
		m.words(0o200, 0x8000, 0, 0, 0)
		c.R[0] = 0o200
		c.FR[0] = fpOne
		fpTestStep(&c, m, 0xf508)
		if (c.Trap == 0o244) != enabled || enabled && c.FR[0] != fpOne {
			t.Fatal("undefined memory operand")
		}
		c.FR[1] = fpSign
		fpTestStep(&c, m, 0xf501)
		if c.Trap != 0 {
			t.Fatal("undefined accumulator must not trap")
		}
	}
	c.FPS = fpDouble
	c.FR[0], c.FR[1] = 0x40c0000000000000, 0x40c0000000000000
	fpTestStep(&c, m, 0xf301)
	if c.FR[0] != 0x3f80000000000000 || c.FR[1] != 0x4100000000000000 {
		t.Fatal("MOD 1.5*1.5")
	}
	c.FR[0], c.FR[1] = fpOne+1, fpOne+1
	fpTestStep(&c, m, 0xf301)
	if c.FR[0] != uint64(75)<<55 || c.FR[1] != fpOne {
		t.Fatalf("MOD 59-bit product: %x %x", c.FR[0], c.FR[1])
	}
}

type fpFaultBus struct{ testBus }

func (m *fpFaultBus) Load(a uint64, w int, k emu.Access, t uint64) (uint64, *emu.Fault) {
	if a&65535 == 0o204 {
		return 0, &emu.Fault{Kind: emu.Permission}
	}
	return m.testBus.Load(a, w, k, t)
}
func TestFPPartialReadFault(t *testing.T) {
	m := &fpFaultBus{}
	m.words(0, 0xf510)
	m.words(0o200, 0x4080, 0)
	c := CPU{Bus: m, User: true, FPS: fpDouble}
	c.R[0] = 0o200
	c.FR[0] = 7
	c.Step()
	if c.Trap != 0o250 || c.FR[0] != 7 || c.R[0] != 0o210 {
		t.Fatal("fault must retain accumulator and address side effects")
	}
}

func TestFPSystemTrap(t *testing.T) {
	m := &testBus{}
	m.words(0, 0xf901)
	m.words(0o244, 0o400, 0)
	m.words(0o400, 2)
	c := CPU{Bus: m, FPS: fpDouble}
	c.R[6] = 0o1000
	c.FR[0] = fpOne
	c.Step()
	pc, _ := m.Peek(0o774, 2)
	if c.Halted || c.R[7] != 0o400 || c.R[6] != 0o774 || pc != 2 || c.FEC != 4 {
		t.Fatal("full-system floating trap vector/frame")
	}
	c.Step()
	if c.R[7] != 2 || c.R[6] != 0o1000 {
		t.Fatal("full-system FP trap return")
	}
}

func TestFPUnaryCompareAndFPS(t *testing.T) {
	m := &testBus{}
	c := CPU{Bus: m, User: true, FPS: fpDouble}
	for _, v := range []struct {
		ins         uint16
		start, want uint64
		flags       uint16
	}{
		{0xf180, fpOne | fpSign, fpOne, 0},          // ABS
		{0xf1c0, fpOne, fpOne | fpSign, N},          // NEG
		{0xf140, fpOne | fpSign, fpOne | fpSign, N}, // TST
		{0xf100, fpOne, 0, Z},                       // CLR
		{0xf1c0, fpSign, 0, Z},                      // normalize undefined zero
	} {
		c.FR[0] = v.start
		fpTestStep(&c, m, v.ins)
		if c.Trap != 0 || c.FR[0] != v.want || c.FPS&15 != v.flags {
			t.Fatalf("unary %o: %x flags %o", v.ins, c.FR[0], c.FPS&15)
		}
	}
	for _, v := range []struct {
		a, b  uint64
		flags uint16
	}{
		{fpOne, fpOne, Z}, {fpOne, 0, N}, {0, fpOne, 0}, {fpOne | fpSign, 0, 0}, {0, fpOne | fpSign, N}, {fpSign, 0, Z},
	} {
		c.FR[0], c.FR[1] = v.a, v.b
		fpTestStep(&c, m, 0xf701)
		if c.FPS&15 != v.flags {
			t.Fatalf("CMP %x,%x flags %o", v.b, v.a, c.FPS&15)
		}
	}
	c.R[0] = 0xffff
	fpTestStep(&c, m, 0o170100)
	if c.FPS != fpStatusMask {
		t.Fatal("LDFPS reserved bits")
	}
	fpTestStep(&c, m, 0o170201)
	if c.R[1] != fpStatusMask {
		t.Fatal("STFPS")
	}
}

-- instructions.lower --
package pdp11

//rfe:word 16
//rfe:state 9
// These ALU rules generate both Go execution and native IR. The CPU supplies
// operands after architectural addressing; pure register blocks use them directly.
// Slots 0..7 are registers, slot 8 is PSW; Engine advances PC.

//rfe:instruction 0077070 0010000
func mov(opcode uint64) {
	guard(opcode&7 != 7 && opcode>>6&7 != 7)
	mask := choose(opcode&0100000 != 0, 255, 65535)
	sign := (mask + 1) >> 1
	s := state[opcode>>6&7] & mask
	d := state[opcode&7] & mask
	r := s
	state[opcode&7] = choose(mask == 255 && r&128 != 0, r|65280, r)
	state[8] = (state[8] &^ 14) | ((r>>choose(mask == 255, 7, 15))&1)<<3 | choose(r == 0, 4, 0)
}

//rfe:instruction 0077070 0020000
func cmp(opcode uint64) {
	guard(opcode&7 != 7 && opcode>>6&7 != 7)
	mask := choose(opcode&0100000 != 0, 255, 65535)
	sign := (mask + 1) >> 1
	s := state[opcode>>6&7] & mask
	d := state[opcode&7] & mask
	r := (s - d) & mask
	state[8] = (state[8] &^ 15) | ((r>>choose(mask == 255, 7, 15))&1)<<3 | choose(r == 0, 4, 0) | choose((s^d)&(s^r)&sign != 0, 2, 0) | choose(s < d, 1, 0)
}

