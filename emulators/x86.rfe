package x86

import (
	"errors"
	"testing"
)

func TestRealModeLimitFaultAndUnrealSegmentCache(t *testing.T) {
	c, s, m := legacyCPU(t, []byte{0x67, 0x66, 0xa1, 0, 0, 0x11, 0}) // MOV EAX,[00110000h]
	m.Write(13*4, 4, 0x10000200)
	c.R[RSP] = 0x800
	c.Flags = 0x202
	if err := c.Step(); err != nil {
		t.Fatal(err)
	}
	if c.PC != 0x200 || c.R[RSP] != 0x7fa || s.Segments[1].Base != 0x10000 {
		t.Fatalf("real #GP frame pc=%#x sp=%#x", c.PC, c.R[RSP])
	}
	ip, _ := m.Read(0x7fa, 2, false)
	if ip != 0x1000 {
		t.Fatalf("fault restart IP %#x", ip)
	}
	s.Segments[3] = Segment{Selector: 0x10, Limit: 0xffffffff, Flags: 0xcf93}
	if err := s.segment(3, 0x1234); err != nil {
		t.Fatal(err)
	}
	if s.Segments[3].Base != 0x12340 || s.Segments[3].Limit != 0xffffffff || s.Segments[3].Flags != 0xcf93 {
		t.Fatal("real load destroyed unreal data cache")
	}
	if _, err := s.segmentAddress(3, 0x110000, 4, false, false); err != nil {
		t.Fatal(err)
	}
}
func TestRepStringChecksCachedLimitsBeforeMemoryOrIndexEffects(t *testing.T) {
	for _, opcode := range []byte{0xa4, 0xa6, 0xaa, 0xac, 0xae} {
		c, s, m := legacyCPU(t, []byte{0xf3, 0x67, opcode})
		m.Write(13*4, 4, 0x10000200)
		c.R[RSP] = 0x800
		c.R[RSI], c.R[RDI], c.R[RCX] = 0x10000, 0x10000, 2
		if err := c.Step(); err != nil {
			t.Fatal(err)
		}
		if c.PC != 0x200 || c.R[RSI] != 0x10000 || c.R[RDI] != 0x10000 || c.R[RCX] != 2 || s.Segments[1].Base != 0x10000 {
			t.Fatalf("string %#x did not restart atomically", opcode)
		}
	}
}
func TestLegacyUnusableAndExpandDownSegments(t *testing.T) {
	_, s := protectedTestCPU(t)
	s.Segments[3] = Segment{}
	if _, err := s.segmentAddress(3, 0, 1, false, false); err == nil {
		t.Fatal("unusable DS accepted")
	}
	s.Segments[3] = Segment{Selector: 16, Limit: 0x7fff, Flags: 0x97}
	if _, err := s.segmentAddress(3, 0x8000, 2, true, false); err != nil {
		t.Fatal(err)
	}
	for _, span := range [][2]uint64{{0x7fff, 1}, {0xffff, 2}} {
		if _, err := s.segmentAddress(3, span[0], int(span[1]), false, false); err == nil {
			t.Fatal("expand-down limit ignored", span)
		}
	}
	s.Segments[2] = Segment{Selector: 16, Limit: 0x100, Flags: 0x93}
	_, err := s.segmentAddress(2, 0x100, 2, true, false)
	var ex *Exception
	if !errors.As(err, &ex) || ex.Vector != 12 {
		t.Fatalf("expected #SS: %v", err)
	}
}
func TestLegacyIRETPreservesHighESPWith16BitOuterStack(t *testing.T) {
	c, s := protectedTestCPU(t)
	m := s.Physical
	s.GDTR.Limit = 39
	m.Write(0x518, 8, 0x0000fa000000ffff)
	m.Write(0x520, 8, 0x0000f2000000ffff)
	s.CR[0] |= 1 << 31
	s.CR[3] = 0x4000
	m.Write(0x4000, 4, 0x6007)
	m.Write(0x6000, 4, 7)
	m.Write(0x6004, 4, 0x1007)
	m.Write(0x4800, 4, 0x5007)
	m.Write(0x5024, 4, 0x9007)
	c.R[RSP] = 0x80009000
	for j, v := range []uint64{0x100, 0x1b, 0x202, 0x1fa, 0x23} {
		m.Write(0x9000+uint64(j)*4, 4, v)
	}
	step(t, c)
	if c.R[RSP] != 0x800001fa || c.PC != 0x100 || s.CPL != 3 || s.Segments[2].Selector != 0x23 {
		t.Fatalf("outer IRET: SP%x PC%x CPL%d SS%x", c.R[RSP], c.PC, s.CPL, s.Segments[2].Selector)
	}
}

-- selector_test.go --
package x86

import (
	"errors"
	"testing"
)

func TestSelectorVerification(t *testing.T) {
	m := newSystemRAM()
	c := &CPU{Flags: 0x202 | CF | ZF}
	s := NewSystem(c, m, nil)
	s.CR[0] = 1
	s.GDTR = Table{Base: 0x1000, Limit: 15}
	for _, test := range []struct {
		name           string
		access         byte
		selector       uint16
		cpl            uint8
		write, allowed bool
	}{
		{"kernel data", 0x92, 8, 0, true, true},
		{"not present still writable", 0x12, 8, 0, true, true},
		{"user data", 0xf2, 11, 3, true, true},
		{"RPL restriction", 0x92, 11, 0, true, false},
		{"CPL restriction", 0x92, 8, 3, true, false},
		{"read-only data", 0x90, 8, 0, true, false},
		{"read-only readable", 0x90, 8, 0, false, true},
		{"code not writable", 0x9a, 8, 0, true, false},
		{"execute-only not readable", 0x98, 8, 0, false, false},
		{"readable code", 0x9a, 8, 0, false, true},
		{"nonconforming code privilege", 0x9a, 11, 3, false, false},
		{"conforming readable code", 0x9e, 11, 3, false, true},
		{"system descriptor", 0x89, 8, 0, false, false},
		{"null", 0x92, 3, 0, true, false},
		{"out of bounds", 0x92, 16, 0, true, false},
		{"missing LDT", 0xf2, 12, 3, true, false},
	} {
		t.Run(test.name, func(t *testing.T) {
			m.Write(0x1008, 8, uint64(test.access)<<40)
			s.CPL = test.cpl
			c.R[RAX] = uint64(test.selector)
			c.Flags = 0x202 | CF | ZF
			m.data[0], m.data[1], m.data[2] = 0x0f, 0x00, 0xe8
			if !test.write {
				m.data[2] = 0xe0
			}
			i, err := Decode(s, 0)
			if err != nil {
				t.Fatal(err)
			}
			if err = c.Execute(i); err != nil {
				t.Fatal(err)
			}
			if (c.Flags&ZF != 0) != test.allowed || c.Flags&^ZF != (0x202|CF) || c.R[RAX] != uint64(test.selector) || c.PC != 3 {
				t.Fatalf("flags=%#x selector=%#x pc=%#x", c.Flags, c.R[RAX], c.PC)
			}
		})
	}
	s.CPL = 3
	s.LDTR = Segment{Selector: 16, Base: 0x2000, Limit: 7}
	m.Write(0x2000, 8, uint64(0xf2)<<40)
	if allowed, err := s.verifySelector(7, true); !allowed || err != nil {
		t.Fatal("LDT index zero", allowed, err)
	}
	s.GDTR.Base = uint64(len(m.data))
	_, err := s.verifySelector(8, true)
	var fault *Exception
	if !errors.As(err, &fault) || fault.Vector != 14 || s.supervisor {
		t.Fatal("descriptor memory fault/supervisor restore", err)
	}
}

-- shuffle_test.go --
package x86

import (
	"encoding/binary"
	"testing"
)

func TestSSEShuffleLaneSelection(t *testing.T) {
	for _, test := range []struct {
		code []byte
		want [4]uint32
	}{
		{[]byte{0x0f, 0xc6, 0xc1, 0x1b}, [4]uint32{4, 3, 11, 10}},
		{[]byte{0x0f, 0xc6, 0xc0, 0x1b}, [4]uint32{4, 3, 2, 1}},
		{[]byte{0x66, 0x0f, 0xc6, 0xc1, 0xfd}, [4]uint32{3, 4, 10, 11}},
	} {
		c := testCPU(t, test.code)
		for j := 0; j < 4; j++ {
			binary.LittleEndian.PutUint32(c.XMM[0][j*4:], uint32(j+1))
			binary.LittleEndian.PutUint32(c.XMM[1][j*4:], uint32(j+10))
		}
		c.Flags = 0x202 | CF | ZF
		step(t, c)
		for j, want := range test.want {
			if got := binary.LittleEndian.Uint32(c.XMM[0][j*4:]); got != want {
				t.Fatalf("code %x lane %d=%d want %d", test.code, j, got, want)
			}
		}
		if c.PC != 0x1000+uint64(len(test.code)) || c.Flags != 0x202|CF|ZF {
			t.Fatalf("length/flags pc=%d flags=%#x", c.PC, c.Flags)
		}
	}
	c := testCPU(t, []byte{0x0f, 0xc6, 0x00, 0xe4}) // SHUFPS XMM0,[RAX],0xe4
	c.R[RAX] = 0x1800
	c.Memory.Write(0x1808, 8, 0x8877665544332211)
	step(t, c)
	if binary.LittleEndian.Uint64(c.XMM[0][8:]) != 0x8877665544332211 {
		t.Fatal("memory shuffle", c.XMM[0])
	}
}

func TestREXAccumulatorExchange(t *testing.T) {
	for _, test := range []struct {
		code   []byte
		ax, r8 uint64
	}{
		{[]byte{0x41, 0x90}, 0x44332211, 0x88776655},
		{[]byte{0x49, 0x90}, 0xaabbccdd44332211, 0x1122334488776655},
		{[]byte{0x66, 0x41, 0x90}, 0x1122334488772211, 0xaabbccdd44336655},
	} {
		c := testCPU(t, test.code)
		c.R[RAX], c.R[8] = 0x1122334488776655, 0xaabbccdd44332211
		c.Flags = 0x202 | CF | ZF
		step(t, c)
		if c.R[RAX] != test.ax || c.R[8] != test.r8 || c.Flags != 0x202|CF|ZF {
			t.Fatalf("%x: ax=%#x r8=%#x flags=%#x", test.code, c.R[RAX], c.R[8], c.Flags)
		}
	}
	c := testCPU(t, []byte{0x90})
	c.R[RAX] = ^uint64(0)
	step(t, c)
	if c.R[RAX] != ^uint64(0) {
		t.Fatal("NOP must not zero extend EAX")
	}
}

-- signed_memory_test.go --
package x86

import (
	"renvo.dev/internal/rfe/engine"
	"renvo.dev/internal/rfe/linuxuser"
	"testing"
)

func TestNativeSignedMemoryResultsAndFault(t *testing.T) {
	for _, code := range [][]byte{{0x0f, 0xbe, 3}, {0x0f, 0xbf, 3}, {0x48, 0x0f, 0xbe, 3}, {0x48, 0x0f, 0xbf, 3}, {0x48, 0x63, 3}} {
		base := testCPU(t, code)
		m := base.Memory.(*linuxuser.Memory)
		if err := m.Map(0x3000, 4096, 3); err != nil {
			t.Fatal(err)
		}
		cfg := engine.DefaultEngineConfig()
		cfg.IRThreshold = 1
		cfg.NativeThreshold = 1
		cfg.MaxInstructions = 1
		cfg.MaxRegionInstructions = 1
		e, err := engine.New(cfg, Architecture())
		if err != nil {
			t.Fatal(err)
		}
		for _, value := range []uint64{0, 0x7f, 0x80, 0xff, 0x7fff, 0x8000, 0xffff, 0x7fffffff, 0x80000000, 0xffffffff} {
			if err = m.Write(0x3000, 8, value); err != nil {
				t.Fatal(err)
			}
			expected := *base
			expected.R[RBX] = 0x3000
			expected.R[RAX] = ^uint64(0)
			actual := expected
			adapter := NewAdapter(&actual)
			step(t, &expected)
			if err = e.Step(adapter, 1); err != nil {
				t.Fatal(err)
			}
			adapter.Export()
			if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC {
				t.Fatalf("code=%x value=%x actual=%x expected=%x", code, value, actual.R, expected.R)
			}
		}
		if e.NativeAvailable() && e.Stats.NativeMemory == 0 {
			t.Fatal("signed load never ran natively", e.Stats)
		}
		actual := *base
		actual.R[RBX] = 0x3000
		adapter := NewAdapter(&actual)
		if err = m.Protect(0x3000, 4096, 0); err != nil {
			t.Fatal(err)
		}
		before := actual.R
		if err = e.Step(adapter, 1); err == nil {
			t.Fatal("protected signed load succeeded")
		}
		adapter.Export()
		if actual.R != before || actual.PC != base.PC || actual.Retired != 0 {
			t.Fatal("fault committed state")
		}
		if err = e.Close(); err != nil {
			t.Fatal(err)
		}
	}
}

-- system.go --
package x86

import (
	"errors"
	"fmt"
)

// PortBus belongs to the machine, outside architectural CPU state.
type PortBus interface {
	In(uint16, int) uint32
	Out(uint16, int, uint32)
}
type Table struct {
	Base  uint64
	Limit uint16
}
type Segment struct {
	Selector uint16
	Base     uint64
	Limit    uint32
	Flags    uint16
}
type pageEntry struct {
	refs                      pageTableRefs
	pageShift                 uint8
	physical                  uint64
	writable, user, nx, dirty bool
	pte                       uint64
	legacyLarge               bool
}

// System holds privileged x86 architectural state. Its memory bus is physical;
// CPU.Memory exposes checked linear access through this state.
type System struct {
	// Bounded fault history for full-system bringup diagnostics.
	FaultCount        uint64
	InterruptCounts   *[256]uint64
	InterruptTrace    [8][4]uint64 // linear PC, vector, error code, CR0
	InterruptSequence uint64
	FaultTrace        [8][3]uint64 // PC, linear address, page-fault error code
	decoded           map[uint64]systemDecode

	IRQShadow uint8

	MultiMode                          bool // enabled by NewPCSystem; the original long-mode API is unchanged
	CPU                                *CPU
	Physical                           Memory
	Ports                              PortBus
	CR                                 [9]uint64
	DR                                 [8]uint64
	EFER, FSBase, GSBase, KernelGSBase uint64
	STAR, LSTAR, CSTAR, SFMASK         uint64
	SYSENTERCS, SYSENTERSP, SYSENTERIP uint64
	GDTR, IDTR                         Table
	Segments                           [6]Segment // ES, CS, SS, DS, FS, GS
	TR, LDTR                           Segment
	CPL                                uint8
	Halted                             bool
	TSC                                uint64
	ExternalClock                      bool // machine owns TSC; retirement does not advance it
	TSCWrites                          uint64
	TSCAdjust                          uint64
	TSCCrystalHz                       uint32
	TSCNumerator, TSCDenominator       uint32
	InvariantTSC                       bool
	MSR                                map[uint32]uint64
	CPUID                              func(uint32, uint32) (uint32, uint32, uint32, uint32)
	tlb                                map[uint64]pageEntry
	lastLegacy                         pageEntry
	mappingRefs                        map[mappingKey]pageTableRefs
	tableUsers                         map[uint64]map[mappingKey]struct{}
	supervisor                         bool
}

const FlagIF uint64 = 1 << 9
const FlagDF uint64 = 1 << 10

type Exception struct {
	Vector  uint8
	Code    uint32
	Address uint64
	HasCode bool
}

func (e *Exception) Error() string {
	return fmt.Sprintf("x86 exception #%d code=%#x address=%#x", e.Vector, e.Code, e.Address)
}
func gp() error { return &Exception{Vector: 13, HasCode: true} }
func NewSystem(c *CPU, physical Memory, ports PortBus) *System {
	s := &System{InterruptCounts: new([256]uint64), CPU: c, Physical: physical, Ports: ports, MSR: make(map[uint32]uint64), tlb: make(map[uint64]pageEntry)}
	c.System = s
	c.Memory = s
	return s
}

// Switching roots flushes the architectural translation cache. A physical bus
// may preserve root-tagged native proofs ONLY if it tracks every observed table
// write and all permission/TLBI changes separately. Other buses fully invalidate.
func (s *System) switchAddressSpace() {
	s.CPU.cache = nil
	if memory, ok := s.Physical.(interface{ SwitchAddressSpace() }); ok {
		clear(s.tlb) // reverse dependencies for inactive native roots survive
		memory.SwitchAddressSpace()
	} else {
		s.clearTranslations()
		if memory, ok := s.Physical.(interface{ InvalidateMappings() }); ok {
			memory.InvalidateMappings()
		}
	}
}

// invalidatePage revokes native descriptors/code proofs even if they were
// republished from the old architectural TLB after a guest PTE store. The
// narrow machine callback retains table watches for surviving TLB entries.
func (s *System) invalidatePage(address uint64) {
	space := s.mappingSpace()
	shift := uint8(12)
	// The addressed 4 KiB slice need not itself be cached. Any surviving slice
	// proves the architectural large-page extent which INVLPG must invalidate.
	for key, refs := range s.mappingRefs {
		if key.space == space && refs.shift > shift && key.page>>(refs.shift-12) == address>>refs.shift {
			shift = refs.shift
		}
	}
	base, size := address&^(uint64(1)<<shift-1), uint64(1)<<shift
	for page := range s.tlb {
		if page >= base>>12 && page-(base>>12) < size>>12 {
			delete(s.tlb, page)
		}
	}
	for key := range s.mappingRefs {
		if key.space == space && key.page >= base>>12 && key.page-(base>>12) < size>>12 {
			s.forgetMappingRefs(key)
		}
	}
	if memory, ok := s.Physical.(interface{ InvalidateNativeRange(uint64, uint64) }); ok {
		memory.InvalidateNativeRange(base, size)
	} else if memory, ok := s.Physical.(interface{ InvalidateNativeMappings() }); ok {
		memory.InvalidateNativeMappings()
	} else {
		s.Flush()
	}
}
func (s *System) Flush() {
	s.clearTranslations()
	// Decoded entries are not mapping grants: decode rechecks execute access,
	// physical identities and page epochs (including the final page) on reuse.
	// Preserve this bounded cache across CR3/TLBI changes instead of repeatedly
	// allocating identical instructions during kernel address-space switches.
	s.CPU.cache = nil
	if memory, ok := s.Physical.(interface{ InvalidateMappings() }); ok {
		memory.InvalidateMappings()
	}
}
func (s *System) Fault(address uint64, write, execute, present bool) error {
	code := uint32(0)
	if present {
		code |= 1
	}
	if write {
		code |= 2
	}
	if s.CPL == 3 && !s.supervisor {
		code |= 4
	}
	if execute && (!s.MultiMode || s.EFER&(1<<11) != 0) {
		code |= 16
	}
	s.FaultTrace[s.FaultCount%uint64(len(s.FaultTrace))] = [3]uint64{s.CPU.PC, address, uint64(code)}
	s.FaultCount++
	s.CR[2] = address
	return &Exception{Vector: 14, Code: code, Address: address, HasCode: true}
}
func (s *System) translate(address uint64, write, execute bool) (uint64, error) {
	if s.CR[0]&(1<<31) == 0 {
		return address, nil
	}
	if s.MultiMode && s.EFER&(1<<10) == 0 {
		return s.translateLegacy(address, write, execute)
	}
	// Long mode requires canonical linear addresses even before permission checks.
	if s.EFER&(1<<10) != 0 && uint64(int64(address<<16)>>16) != address {
		return 0, gp()
	}
	key := address >> 12
	e, ok := s.tlb[key]
	if !ok {
		if s.CR[4]&(1<<5) == 0 || s.EFER&(1<<10) == 0 {
			return 0, fmt.Errorf("unsupported paging mode cr0=%#x cr4=%#x efer=%#x", s.CR[0], s.CR[4], s.EFER)
		}
		base := s.CR[3] & 0x000ffffffffff000
		e.writable, e.user = true, true
		for level := 3; level >= 0; level-- {
			pteAddress := base + ((address>>uint(12+9*level))&511)*8
			if memory, ok := s.Physical.(interface{ MarkPageTable(uint64) }); ok {
				memory.MarkPageTable(pteAddress)
			}
			s.addTableRef(&e.refs, pteAddress, 8)
			pte, err := s.Physical.Read(pteAddress, 8, false)
			if err != nil {
				return 0, s.Fault(address, write, execute, false)
			}
			if pte&1 == 0 {
				return 0, s.Fault(address, write, execute, false)
			}
			e.writable = e.writable && pte&2 != 0
			e.user = e.user && pte&4 != 0
			e.nx = e.nx || (s.EFER&(1<<11) != 0 && pte>>63 != 0)
			if pte&(1<<5) == 0 {
				if err := s.setPageTableBits(pteAddress, 1<<5); err != nil {
					return 0, err
				}
			}
			if level == 0 || (level == 1 || level == 2) && pte&(1<<7) != 0 {
				shift := uint(12 + 9*level)
				e.pageShift = uint8(shift)
				low := uint64(1)<<shift - 1
				e.physical = (pte & 0x000ffffffffff000 &^ low) | (address & low &^ 4095)
				e.dirty = pte&(1<<6) != 0
				e.pte = pteAddress
				break
			}
			base = pte & 0x000ffffffffff000
		}
		s.cacheMapping(key, e)
	}
	user := s.CPL == 3 && !s.supervisor
	if user && !e.user || write && !e.writable && (user || s.CR[0]&(1<<16) != 0) || execute && e.nx {
		// A protection fault must not pin stale permissions across the guest's
		// fault handler. Hardware may evict TLB entries at any time, and Linux
		// can lazily upgrade permissions after a spurious protection fault.
		delete(s.tlb, key)
		return 0, s.Fault(address, write, execute, true)
	}
	if write && !e.dirty {
		if err := s.setPageTableBits(e.pte, 1<<6); err != nil {
			return 0, err
		}
		e.dirty = true
		s.tlb[key] = e
	}
	return e.physical | (address & 4095), nil
}
func (s *System) Read(a uint64, n int, x bool) (uint64, error) {
	if n < 1 || n > 8 || a+uint64(n-1) < a {
		return 0, gp()
	}
	p, e := s.translate(a, false, x)
	if e != nil {
		return 0, e
	}
	if a&4095+uint64(n) <= 4096 {
		return s.Physical.Read(p, n, false)
	}
	var v uint64
	for j := 0; j < n; j++ {
		p, e = s.translate(a+uint64(j), false, x)
		if e != nil {
			return 0, e
		}
		b, e := s.Physical.Read(p, 1, false)
		if e != nil {
			return 0, e
		}
		v |= b << uint(8*j)
	}
	return v, nil
}
func (s *System) Write(a uint64, n int, v uint64) error {
	if n < 1 || n > 8 || a+uint64(n-1) < a {
		return gp()
	}
	p, e := s.translate(a, true, false)
	if e != nil {
		return e
	}
	if a&4095+uint64(n) <= 4096 {
		return s.Physical.Write(p, n, v)
	}
	var addresses [8]uint64
	for j := 0; j < n; j++ {
		addresses[j], e = s.translate(a+uint64(j), true, false)
		if e != nil {
			return e
		}
	}
	for j := 0; j < n; j++ {
		if e = s.Physical.Write(addresses[j], 1, v>>uint(8*j)); e != nil {
			return e
		}
	}
	return nil
}

// VERR/VERW report accessibility in ZF rather than faulting for an invalid
// selector. Descriptor presence is not part of these access-rights queries.
func (s *System) verifySelector(sel uint16, write bool) (bool, error) {
	if s.CR[0]&1 == 0 {
		return false, &Exception{Vector: 6}
	}
	if sel&^3 == 0 {
		return false, nil
	}
	base, limit := s.GDTR.Base, uint64(s.GDTR.Limit)
	if sel&4 != 0 {
		if s.LDTR.Selector&^3 == 0 {
			return false, nil
		}
		base, limit = s.LDTR.Base, uint64(s.LDTR.Limit)
	}
	offset := uint64(sel &^ 7)
	if offset+7 > limit {
		return false, nil
	}
	old := s.supervisor
	s.supervisor = true
	defer func() { s.supervisor = old }()
	descriptor, err := s.Read(base+offset, 8, false)
	if err != nil {
		return false, err
	}
	access := uint8(descriptor >> 40)
	if access&0x10 == 0 { // System descriptors are never readable/writable segments.
		return false, nil
	}
	code := access&8 != 0
	if write {
		if code || access&2 == 0 {
			return false, nil
		}
	} else if code && access&2 == 0 {
		return false, nil
	}
	if !code || access&4 == 0 { // Conforming readable code ignores CPL/RPL.
		dpl := access >> 5 & 3
		if s.CPL > dpl || uint8(sel&3) > dpl {
			return false, nil
		}
	}
	return true, nil
}

func (s *System) descriptor(sel uint16) (Segment, error) {
	table := s.GDTR
	if sel&4 != 0 {
		table = Table{Base: s.LDTR.Base, Limit: uint16(s.LDTR.Limit)}
	}
	off := uint64(sel &^ 7)
	if off+7 > uint64(table.Limit) {
		return Segment{}, gp()
	}
	old := s.supervisor
	s.supervisor = true
	defer func() { s.supervisor = old }()
	v, e := s.Read(table.Base+off, 8, false)
	if e != nil {
		return Segment{}, e
	}
	d := Segment{Selector: sel, Base: (v>>16)&0xffffff | (v>>56)<<24, Limit: uint32(v&65535 | (v>>48&15)<<16), Flags: uint16(v >> 40)}
	if v&(1<<55) != 0 {
		d.Limit = d.Limit<<12 | 4095
	}
	if d.Flags&0x10 == 0 && !s.legacy() {
		hi, e := s.Read(table.Base+off+8, 8, false)
		if e != nil {
			return d, e
		}
		d.Base |= hi << 32
	}
	return d, nil
}
func (s *System) segment(index uint8, sel uint16) error {
	if s.MultiMode && (s.CR[0]&1 == 0 || s.CPU.Flags&(1<<17) != 0) {
		if index >= 6 {
			return gp()
		}
		if s.CR[0]&1 == 0 && index != 1 {
			// A real-mode data-segment load changes selector/base, not the
			// hidden limit/attributes established by protected mode.
			s.Segments[index].Selector = sel
			s.Segments[index].Base = uint64(sel) << 4
			return nil
		}
		flags := uint16(0x93)
		if index == 1 {
			flags = 0x9b
		}
		if s.CPU.Flags&(1<<17) != 0 {
			flags = 0xf3
		}
		s.Segments[index] = Segment{Selector: sel, Base: uint64(sel) << 4, Limit: 65535, Flags: flags}
		if index == 1 {
			s.CPL = 0
			if s.CPU.Flags&(1<<17) != 0 {
				s.CPL = 3
			}
		}
		return nil
	}
	if index >= 6 {
		return gp()
	}
	if sel&^3 == 0 {
		if s.MultiMode && (index == 1 || index == 2) {
			return gp()
		}
		s.Segments[index] = Segment{Selector: sel}
		return nil
	}
	d, e := s.descriptor(sel)
	if e != nil {
		return e
	}
	if s.MultiMode && s.legacy() {
		typ := d.Flags & 15
		code := typ&8 != 0
		dpl := uint8(d.Flags >> 5 & 3)
		rpl := uint8(sel & 3)
		invalid := d.Flags&16 == 0
		switch index {
		case 1:
			invalid = invalid || !code
		case 2:
			invalid = invalid || code || typ&2 == 0 || dpl != s.CPL || rpl != s.CPL
		default:
			invalid = invalid || code && typ&2 == 0 || (!code || typ&4 == 0) && (s.CPL > dpl || rpl > dpl)
		}
		if invalid {
			return &Exception{Vector: 13, Code: uint32(sel &^ 3), HasCode: true}
		}
	}
	if d.Flags&0x80 == 0 {
		if index == 2 && s.MultiMode {
			return &Exception{Vector: 12, Code: uint32(sel &^ 3), HasCode: true}
		}
		return &Exception{Vector: 11, Code: uint32(sel &^ 3), HasCode: true}
	}
	if s.MultiMode && d.Flags&0x11 == 0x10 {
		if e = s.setDescriptorAccess(sel, uint8(d.Flags)|1); e != nil {
			return e
		}
		d.Flags |= 1
	}
	s.Segments[index] = d
	if index == 1 {
		s.CPL = uint8(sel & 3)
	}
	if index == 4 {
		s.FSBase = d.Base
	}
	if index == 5 {
		s.GSBase = d.Base
	}
	return nil
}

// Interrupt enters an IDT interrupt/trap gate, including TSS stack switching.
func (s *System) Interrupt(vector uint8, code uint32, hasCode bool) error {
	if s.InterruptCounts == nil {
		s.InterruptCounts = new([256]uint64)
	}
	s.InterruptCounts[vector]++
	s.InterruptTrace[s.InterruptSequence%8] = [4]uint64{s.Segments[1].Base + s.CPU.PC, uint64(vector), uint64(code), s.CR[0]}
	s.InterruptSequence++
	if s.legacy() {
		return s.legacyInterrupt(vector, code, hasCode)
	}
	old := s.supervisor
	s.supervisor = true
	defer func() { s.supervisor = old }()
	off := uint64(vector) * 16
	if off+15 > uint64(s.IDTR.Limit) {
		return fmt.Errorf("IDT vector %d outside limit %#x at pc=%#x", vector, s.IDTR.Limit, s.CPU.PC)
	}
	lo, e := s.Read(s.IDTR.Base+off, 8, false)
	if e != nil {
		return e
	}
	hi, e := s.Read(s.IDTR.Base+off+8, 8, false)
	if e != nil {
		return e
	}
	if lo&(1<<47) == 0 {
		return fmt.Errorf("IDT vector %d not present at pc=%#x", vector, s.CPU.PC)
	}
	selector := uint16(lo >> 16)
	d, e := s.descriptor(selector)
	if e != nil {
		return e
	}
	target := (lo & 65535) | ((lo >> 48) << 16) | (hi&0xffffffff)<<32
	c := s.CPU
	oldSP, oldSS := c.R[RSP], s.Segments[2].Selector
	newCPL := uint8(d.Flags >> 5 & 3)
	sp := oldSP
	ist := uint8(lo>>32) & 7
	if ist != 0 || newCPL < s.CPL {
		off := uint64(4 + 8*newCPL)
		if ist != 0 {
			off = 36 + 8*uint64(ist-1)
		}
		sp, e = s.Read(s.TR.Base+off, 8, false)
		if e != nil {
			return e
		}
	}
	sp &^= 15
	values := []uint64{uint64(oldSS), oldSP, c.Flags, uint64(s.Segments[1].Selector), c.PC}
	if hasCode {
		values = append(values, uint64(code))
	}
	for _, v := range values {
		sp -= 8
		if e = s.Write(sp, 8, v); e != nil {
			return e
		}
	}
	c.R[RSP] = sp
	c.PC = target
	c.Flags &^= (1 << 8) | (1 << 14) | (1 << 16) | (1 << 17)
	if lo>>40&15 == 14 {
		c.Flags &^= FlagIF
	}
	s.Segments[1] = d
	s.CPL = newCPL
	if newCPL < uint8(oldSS&3) {
		s.Segments[2] = Segment{Selector: uint16(newCPL)}
	}
	s.Halted = false
	return nil
}
func (s *System) step() error {
	if s.legacy() {
		return s.legacyStep()
	}
	if s.Halted {
		return nil
	}
	i, e := s.decode()
	return s.executeDecoded(i, e)
}

// executeDecoded shares every architectural boundary with step. A cached
// caller must already have validated ALL instruction bytes for execution.
func (s *System) executeDecoded(i Instruction, e error) error {
	if s.Halted {
		return nil
	}
	c := s.CPU
	if e == nil {
		e = c.Execute(i)
	}
	if !s.ExternalClock {
		s.TSC += TSCTicksPerInstruction
	}
	if s.IRQShadow > 0 {
		s.IRQShadow--
	}
	var ex *Exception
	if errors.As(e, &ex) {
		c.Flags |= 1 << 16 // Fault frames set RF, unlike software INT and external IRQ frames.
		return s.Interrupt(ex.Vector, ex.Code, ex.HasCode)
	}
	if e != nil {
		return fmt.Errorf("pc=%#x %s: %w", c.PC, i.Op, e)
	}
	return nil
}
func (s *System) cpuid(leaf, sub uint32) (a, b, c, d uint32) {
	if s.CPUID != nil {
		return s.CPUID(leaf, sub)
	}
	switch leaf {
	case 0:
		maximum := uint32(1)
		if s.TSCCrystalHz != 0 && s.TSCNumerator != 0 && s.TSCDenominator != 0 {
			maximum = 0x15
		}
		return maximum, 0x756e6547, 0x6c65746e, 0x49656e69 // GenuineIntel
	case 1:
		return 0x00000663, 1 << 16, 0, (1 << 0) | (1 << 3) | (1 << 4) | (1 << 5) | (1 << 6) | (1 << 8) | (1 << 11) | (1 << 13) | (1 << 15) | (1 << 16) | (1 << 23) | (1 << 24) | (1 << 25) | (1 << 26)
	case 7:
		if sub == 0 && s.InvariantTSC {
			return 0, 1 << 1, 0, 0 // Architectural IA32_TSC_ADJUST, implemented below.
		}
	case 0x15:
		return s.TSCDenominator, s.TSCNumerator, s.TSCCrystalHz, 0
	case 0x80000000:
		return 0x80000008, 0, 0, 0
	case 0x80000001:
		return 0, 0, 0, (1 << 11) | (1 << 20) | (1 << 29)
	case 0x80000007:
		if s.InvariantTSC {
			return 0, 0, 0, 1 << 8 // Constant-rate TSC across the modeled idle state.
		}
	case 0x80000008:
		return 0x3028, 0, 0, 0
	}
	return
}
func (s *System) readMSR(n uint32) (uint64, error) {
	switch n {
	case 0xc0000080:
		return s.EFER, nil
	case 0xc0000081:
		return s.STAR, nil
	case 0xc0000082:
		return s.LSTAR, nil
	case 0xc0000083:
		return s.CSTAR, nil
	case 0xc0000084:
		return s.SFMASK, nil
	case 0xc0000100:
		return s.FSBase, nil
	case 0xc0000101:
		return s.GSBase, nil
	case 0xc0000102:
		return s.KernelGSBase, nil
	case 0x10:
		return s.TSC, nil
	case 0x3b:
		if !s.InvariantTSC {
			return 0, gp()
		}
		return s.TSCAdjust, nil
	case 0x1b:
		return 0xfee00000 | 256, nil
	case 0xfe, 0x17:
		return 0, nil
	case 0x174:
		return s.SYSENTERCS, nil
	case 0x175:
		return s.SYSENTERSP, nil
	case 0x176:
		return s.SYSENTERIP, nil
	}
	if v, ok := s.MSR[n]; ok {
		return v, nil
	}
	return 0, gp()
}
func (s *System) writeMSR(n uint32, v uint64) error {
	switch n {
	case 0xc0000080:
		s.EFER = v
		s.Flush()
	case 0xc0000081:
		s.STAR = v
	case 0xc0000082:
		s.LSTAR = v
	case 0xc0000083:
		s.CSTAR = v
	case 0xc0000084:
		s.SFMASK = v
	case 0xc0000100:
		s.FSBase = v
	case 0xc0000101:
		s.GSBase = v
	case 0xc0000102:
		s.KernelGSBase = v
	case 0x10:
		s.TSCWrites++
		if s.InvariantTSC {
			s.TSCAdjust += v - s.TSC
		}
		s.TSC = v
	case 0x3b:
		if !s.InvariantTSC {
			return gp()
		}
		s.TSCWrites++
		s.TSC += v - s.TSCAdjust
		s.TSCAdjust = v
	case 0x174:
		s.SYSENTERCS = v
	case 0x175:
		s.SYSENTERSP = v
	case 0x176:
		s.SYSENTERIP = v
	case 0x277, 0x2ff, 0x1a0, 0x8b, 0x1b:
		s.MSR[n] = v
	default:
		return gp()
	}
	return nil
}

-- system_cache.go --
package x86

// PhysicalCodeMemory versions every physical byte write, including aliases.
// Buses without this optional contract continue decoding from checked memory.
type PhysicalCodeMemory interface{ CodeEpoch(uint64) uint64 }
type systemDecode struct {
	instruction                        Instruction
	first, last, firstEpoch, lastEpoch uint64
}

func (s *System) decode() (Instruction, error) {
	versioned, ok := s.Physical.(PhysicalCodeMemory)
	if !ok {
		return Decode(s, s.CPU.PC)
	}
	pc := s.CPU.PC
	first, e := s.translate(pc, false, true)
	if e != nil {
		return Instruction{}, e
	}
	if cached, found := s.decoded[pc]; found && cached.first == first && cached.firstEpoch == versioned.CodeEpoch(first) {
		if pc>>12 == (cached.instruction.Next-1)>>12 {
			return cached.instruction, nil
		}
		last, e := s.translate(cached.instruction.Next-1, false, true)
		if e != nil {
			return Instruction{}, e
		}
		if last == cached.last && cached.lastEpoch == versioned.CodeEpoch(last) {
			return cached.instruction, nil
		}
	}
	i, e := Decode(s, pc)
	if e != nil {
		return i, e
	}
	last, e := s.translate(i.Next-1, false, true)
	if e != nil {
		return i, e
	}
	if s.decoded == nil {
		s.decoded = make(map[uint64]systemDecode)
	}
	s.decoded[pc] = systemDecode{instruction: i, first: first, last: last, firstEpoch: versioned.CodeEpoch(first), lastEpoch: versioned.CodeEpoch(last)}
	return i, nil
}

-- system_native.go --
package x86

import "fmt"

// NativeMapping is a speculative MMU query, never architectural fault delivery.
// Write descriptors require a dirty PTE: the first write therefore takes the
// architectural path that sets D before subsequent native writes are admitted.
func (s *System) NativeMapping(address uint64, execute bool) (uint64, bool, error) {
	cr2, count, trace := s.CR[2], s.FaultCount, s.FaultTrace
	p, err := s.translate(address, false, execute)
	s.CR[2], s.FaultCount, s.FaultTrace = cr2, count, trace
	if err != nil {
		return 0, false, err
	}
	if s.supervisor {
		return 0, false, fmt.Errorf("native mapping inactive")
	}
	if s.CR[0]&(1<<31) == 0 {
		return p, true, nil
	}
	entry := s.tlb[address>>12]
	if s.MultiMode && s.EFER&(1<<10) == 0 {
		entry = s.lastLegacy
	}
	user := s.CPL == 3
	writable := entry.writable || !user && s.CR[0]&(1<<16) == 0
	return p, writable && entry.dirty && (!user || entry.user), nil
}

// NativeRead protects CR2/diagnostic state when a speculative block fetch
// crosses an inaccessible page. The eventual CPU.Step delivers the real fault.
func (s *System) NativeRead(a uint64, n int, execute bool) (uint64, error) {
	cr2, count, trace := s.CR[2], s.FaultCount, s.FaultTrace
	v, err := s.Read(a, n, execute)
	s.CR[2], s.FaultCount, s.FaultTrace = cr2, count, trace
	return v, err
}

-- system_segments_test.go --
package x86

import "testing"

func TestSystemSegmentsDoNotAdmitUserPersonality(t *testing.T) {
	c := testCPU(t, []byte{0x65, 0x48, 0x8b, 0x03})
	ins, err := Architecture().Fetch(c.Memory, c.PC)
	if err != nil || !ins.InterpretOnly {
		t.Fatal("ordinary user admitted GS", err, ins)
	}
	if err := c.Step(); err == nil || c.Retired != 0 || c.PC != 0x1000 {
		t.Fatal("user segment fault changed", err)
	}
	c.System = &System{GSBase: 0x1800, FSBase: 0x1900}
	ins, err = SystemArchitecture().Fetch(c.Memory, c.PC)
	if err != nil || ins.InterpretOnly {
		t.Fatal("system did not admit GS", err, ins)
	}
	a := NewSystemAdapter(c)
	if a.Registers()[fsBaseSlot] != 0x1900 || a.Registers()[gsBaseSlot] != 0x1800 {
		t.Fatal("segment state import")
	}
	// Export never writes segment state back over an architectural transition.
	c.System.GSBase = 0x1a00
	a.Export()
	if c.System.GSBase != 0x1a00 {
		t.Fatal("export overwrote architectural base")
	}
	a.Import()
	if a.Registers()[gsBaseSlot] != 0x1a00 {
		t.Fatal("base update not imported")
	}
}

-- system_test.go --
package x86

import (
	"encoding/binary"
	"errors"
	"testing"
)

type systemRAM struct {
	data     []byte
	versions []uint64
}

func newSystemRAM() *systemRAM {
	return &systemRAM{data: make([]byte, 2<<20), versions: make([]uint64, 512)}
}
func (m *systemRAM) Read(a uint64, n int, x bool) (uint64, error) {
	var v uint64
	if a+uint64(n) > uint64(len(m.data)) {
		return 0, &Exception{Vector: 14}
	}
	for j := 0; j < n; j++ {
		v |= uint64(m.data[a+uint64(j)]) << uint(8*j)
	}
	return v, nil
}
func (m *systemRAM) Write(a uint64, n int, v uint64) error {
	if a+uint64(n) > uint64(len(m.data)) {
		return &Exception{Vector: 14}
	}
	for j := 0; j < n; j++ {
		m.data[a+uint64(j)] = byte(v >> uint(8*j))
		m.versions[(a+uint64(j))>>12]++
	}
	return nil
}
func (m *systemRAM) CodeEpoch(a uint64) uint64 { return m.versions[a>>12] }
func TestSystemPagingPermissionsAndAtomicCrossPageWrite(t *testing.T) {
	m := newSystemRAM()
	c := &CPU{}
	s := NewSystem(c, m, nil)
	s.CR[0] = 1<<31 | 1<<16
	s.CR[3] = 0x1000
	s.CR[4] = 1 << 5
	s.EFER = 1<<10 | 1<<11
	s.CPL = 3
	for a, v := range map[uint64]uint64{0x1000: 0x2007, 0x2000: 0x3007, 0x3000: 0x4007, 0x4040: 0x10007} {
		m.Write(a, 8, v)
	}
	if e := s.Write(0x8000, 8, 0x123456789abcdef0); e != nil {
		t.Fatal(e)
	}
	if v, _ := m.Read(0x10000, 8, false); v != 0x123456789abcdef0 {
		t.Fatalf("translation %#x", v)
	}
	pte, _ := m.Read(0x4040, 8, false)
	if pte&0x60 != 0x60 {
		t.Fatalf("accessed/dirty %#x", pte)
	}
	m.data[0x10ffe], m.data[0x10fff] = 0xa5, 0x5a
	e := s.Write(0x8ffe, 4, 0x12345678)
	var fault *Exception
	if !errors.As(e, &fault) || fault.Vector != 14 || fault.Address != 0x9000 || fault.Code != 6 {
		t.Fatalf("cross-page fault %v", e)
	}
	if m.data[0x10ffe] != 0xa5 || m.data[0x10fff] != 0x5a {
		t.Fatal("partial faulting store")
	}
	m.Write(0x4040, 8, 0x10005)
	s.Flush()
	e = s.Write(0x8000, 1, 1)
	if !errors.As(e, &fault) || fault.Code != 7 {
		t.Fatalf("read-only fault %v", e)
	}
	m.Write(0x4040, 8, 0x8000000000010007)
	s.Flush()
	_, e = s.Read(0x8000, 1, true)
	if !errors.As(e, &fault) || fault.Code != 21 {
		t.Fatalf("NX fault %v", e)
	}
}
func TestSystemInterruptStackAndIRETRoundTrip(t *testing.T) {
	m := newSystemRAM()
	c := &CPU{PC: 0x5000, Flags: 0x202}
	c.R[RSP] = 0x7000
	s := NewSystem(c, m, nil)
	s.CPL = 3
	s.GDTR = Table{Base: 0x1000, Limit: 39}
	s.IDTR = Table{Base: 0x2000, Limit: 4095}
	s.TR = Segment{Base: 0x3000, Limit: 103}
	s.Segments[1].Selector = 0x1b
	s.Segments[2].Selector = 0x23
	for a, v := range map[uint64]uint64{0x1008: 0x00af9a000000ffff, 0x1010: 0x00cf92000000ffff, 0x1018: 0x00affa000000ffff, 0x1020: 0x00cff2000000ffff, 0x3004: 0x9000, 0x2200: 0x00008e0000084000} {
		m.Write(a, 8, v)
	}
	if e := s.Interrupt(32, 0, false); e != nil {
		t.Fatal(e)
	}
	if c.PC != 0x4000 || c.R[RSP] != 0x8fd8 || s.CPL != 0 || c.Flags&FlagIF != 0 {
		t.Fatalf("interrupt state pc=%x sp=%x cpl=%d flags=%x", c.PC, c.R[RSP], s.CPL, c.Flags)
	}
	if e := c.Execute(Instruction{Op: "iret", Width: 8}); e != nil {
		t.Fatal(e)
	}
	if c.PC != 0x5000 || c.R[RSP] != 0x7000 || c.Flags != 0x202 || s.CPL != 3 || s.Segments[2].Selector != 0x23 {
		t.Fatal("IRET failed to restore frame")
	}
}
func TestSystemCodeCachePhysicalAliasInvalidation(t *testing.T) {
	m := newSystemRAM()
	c := &CPU{PC: 0x1000}
	s := NewSystem(c, m, nil)
	copy(m.data[0x1000:], []byte{0xb8, 7, 0, 0, 0})
	if e := c.Step(); e != nil {
		t.Fatal(e)
	}
	if c.R[RAX] != 7 {
		t.Fatal(c.R[RAX])
	}
	m.Write(0x1001, 4, 11)
	c.PC = 0x1000
	if e := c.Step(); e != nil {
		t.Fatal(e)
	}
	if c.R[RAX] != 11 {
		t.Fatal("stale cached instruction")
	}
	_ = s
}
func TestSignedWideDivisionAndSIMDStore(t *testing.T) {
	m := newSystemRAM()
	c := &CPU{Memory: m}
	c.R[RAX] = ^uint64(99)
	c.R[RDX] = ^uint64(0)
	c.R[RCX] = 7
	i := Instruction{Op: "idiv", Width: 8, Dst: Operand{Kind: regOperand, Reg: RCX}, Next: 1}
	if e := c.Execute(i); e != nil {
		t.Fatal(e)
	}
	if int64(c.R[RAX]) != -14 || int64(c.R[RDX]) != -2 {
		t.Fatalf("quotient/remainder %d %d", int64(c.R[RAX]), int64(c.R[RDX]))
	}
	binary.LittleEndian.PutUint64(c.XMM[0][:], 0x12345678)
	binary.LittleEndian.PutUint64(c.XMM[0][8:], 0xabcdef09)
	i = Instruction{Op: "vector", CC: 0x7f, Width: 16, Repeat: 0xf3, Dst: Operand{Kind: memOperand, Base: -1, Index: -1, Disp: 0x1000}, Src: Operand{Kind: regOperand, Reg: 0}, Next: 2}
	if e := c.Execute(i); e != nil {
		t.Fatal(e)
	}
	if v, _ := m.Read(0x1008, 8, false); v != 0xabcdef09 {
		t.Fatalf("SIMD store %#x", v)
	}
}

-- timed_adapter.go --
package x86

import (
	"renvo.dev/internal/rfe/engine"
	emu "renvo.dev/internal/rfe/runtime"
)

// TimedSystemArchitecture requires a caller that imports a synchronized TSC
// base before every native boundary and accounts retired instructions at 100
// TSC ticks each. Ordinary SystemArchitecture/Adapter keep their original ABI.
func TimedSystemArchitecture() engine.Architecture { return clockedSystemArchitecture(true) }

// SampledSystemArchitecture uses the machine's oscillator snapshot at native
// entry. It never invents elapsed time from an instruction prefix. The caller
// refreshes that snapshot at every bounded native and architectural boundary.
func SampledSystemArchitecture() engine.Architecture { return clockedSystemArchitecture(false) }

func clockedSystemArchitecture(deterministic bool) engine.Architecture {
	arch := SystemArchitecture()
	arch.StateWords = timedStateWords
	fetch, lower := arch.Fetch, arch.Lower
	arch.Fetch = func(m engine.Memory, pc uint64) (engine.Instruction, error) {
		ins, err := fetch(m, pc)
		if err == nil {
			op := ins.Decoded.(Instruction).Op
			if op == "rdtsc" || op == "rdtscp" {
				ins.InterpretOnly = false
				ins.Memory = true
				ins.ScheduleBoundary = !deterministic
			}
		}
		return ins, err
	}
	arch.Lower = func(b *emu.Builder, ins engine.Instruction, completed int) bool {
		i := ins.Decoded.(Instruction)
		if i.Op != "rdtsc" && i.Op != "rdtscp" {
			return lower(b, ins, completed)
		}
		b.Store(pcSlot, b.Constant(i.PC))
		b.Checkpoint(systemStateWords, completed)
		value := b.Load(timeBaseSlot)
		if deterministic {
			value = b.Elapsed(value, TSCTicksPerInstruction, completed)
		}
		b.Store(RAX, b.Binary(emu.And, value, b.Constant(0xffffffff)))
		b.Store(RDX, b.Shift(emu.Shr, value, 32))
		if i.Op == "rdtscp" {
			b.Store(RCX, b.Constant(0))
		}
		b.Store(pcSlot, b.Constant(i.Next))
		return true
	}
	return arch
}

-- tlb_fault_test.go --
package x86

import (
	"errors"
	"testing"
)

func TestProtectionFaultDoesNotPinStaleTLBPermissions(t *testing.T) {
	m := newSystemRAM()
	c := &CPU{}
	s := NewSystem(c, m, nil)
	s.CR[0], s.CR[3], s.CR[4], s.EFER = 1<<31|1<<16|1, 0x1000, 1<<5, 1<<10|1<<11
	s.CPL = 3
	for a, v := range map[uint64]uint64{0x1000: 0x2007, 0x2000: 0x3007, 0x3000: 0x4007, 0x4040: 0x10005} {
		m.Write(a, 8, v)
	}
	if _, err := s.Read(0x8000, 1, false); err != nil {
		t.Fatal(err)
	}
	// Upgrading a PTE does not retroactively change a cached RO translation.
	m.Write(0x4040, 8, 0x10007)
	err := s.Write(0x8000, 1, 42)
	var fault *Exception
	if !errors.As(err, &fault) || fault.Code != 7 {
		t.Fatal("expected stale RO fault", err)
	}
	// Retrying after the fault must walk the upgraded PTE, not fault forever.
	if err = s.Write(0x8000, 1, 42); err != nil {
		t.Fatal("stale permissions survived protection fault", err)
	}
	if got, _ := m.Read(0x10000, 1, false); got != 42 {
		t.Fatal("retry did not write mapped physical memory", got)
	}
	// Eviction cannot turn a genuinely readonly mapping into a writable one.
	m.Write(0x4040, 8, 0x10005)
	s.Flush()
	for j := 0; j < 2; j++ {
		if err = s.Write(0x8000, 1, 99); !errors.As(err, &fault) || fault.Code != 7 {
			t.Fatal("readonly retry bypassed permission checks", err)
		}
	}
}

-- tsc_clock_test.go --
package x86

import "testing"

func TestSystemTSCClockMetadataAndAdjustment(t *testing.T) {
	memory := newSystemRAM()
	c := &CPU{PC: 0x5000}
	s := NewSystem(c, memory, nil)
	maximum, _, _, _ := s.cpuid(0, 0)
	_, features, _, _ := s.cpuid(7, 0)
	_, _, _, invariant := s.cpuid(0x80000007, 0)
	if maximum != 1 || features != 0 || invariant != 0 {
		t.Fatal("generic system invented clock capabilities")
	}
	if _, err := s.readMSR(0x3b); err == nil {
		t.Fatal("unadvertised TSC_ADJUST accepted")
	}
	s.TSCCrystalHz, s.TSCNumerator, s.TSCDenominator, s.InvariantTSC = 1193182, 10000, 1, true
	maximum, _, _, _ = s.cpuid(0, 0)
	den, num, hz, _ := s.cpuid(0x15, 0)
	_, features, _, _ = s.cpuid(7, 0)
	_, _, _, invariant = s.cpuid(0x80000007, 0)
	if maximum != 0x15 || den != 1 || num != 10000 || hz != 1193182 || features != 2 || invariant != 1<<8 {
		t.Fatal("clock capabilities do not describe the oscillator")
	}
	if _, f, _, _ := s.cpuid(7, 1); f != 0 {
		t.Fatal("unsupported CPUID subleaf fabricated")
	}
	s.TSC = 1000
	if err := s.writeMSR(0x10, 2000); err != nil {
		t.Fatal(err)
	}
	if value, err := s.readMSR(0x3b); err != nil || value != 1000 {
		t.Fatal("TSC write not accumulated in ADJUST", value, err)
	}
	if err := s.writeMSR(0x3b, 400); err != nil {
		t.Fatal(err)
	}
	if s.TSC != 1400 || s.TSCAdjust != 400 {
		t.Fatal("ADJUST write did not shift counter")
	}
	copy(memory.data[0x5000:], []byte{0x90, 0x90, 0x90, 0x90})
	for i := 0; i < 4; i++ {
		if err := c.Step(); err != nil {
			t.Fatal(err)
		}
	}
	if s.TSC != 1800 || s.TSCAdjust != 400 {
		t.Fatal("normal time modified adjustment")
	}
	if err := s.writeMSR(0x10, ^uint64(0)-20); err != nil {
		t.Fatal(err)
	}
	if s.TSC-s.TSCAdjust != 1400 {
		t.Fatal("modular TSC adjustment lost oscillator base")
	}
	if err := s.writeMSR(0x3b, 0); err != nil {
		t.Fatal(err)
	}
	if s.TSC != 1400 || s.TSCAdjust != 0 || c.Retired != 4 {
		t.Fatal("undoing ADJUST changed time/retirement")
	}
}

-- vector.go --
package x86

import (
	"encoding/binary"
	"fmt"
)

func (d *decoder) vectorDecode(i *Instruction, op byte, operand16 bool) {
	if op >= 0xd8 && op <= 0xdf {
		d.decodeX87(i, op)
		return
	}
	if op == 0x9b {
		i.Op = "fwait"
		if d.lock {
			d.err = &Exception{Vector: 6}
		}
		return
	}
	if op == 0xdb {
		b := d.byte()
		if b == 0xe3 {
			i.Op = "fninit"
		}
		return
	}
	if op == 0xdf {
		b := d.byte()
		if b == 0xe0 {
			i.Op = "fnstswax"
		}
		return
	}
	if op == 0xd9 || op == 0xdd {
		rm, _, g := d.modrm(2)
		i.Dst = rm
		i.Width = 2
		if op == 0xd9 && g == 7 {
			i.Op = "fnstcw"
		}
		if op == 0xd9 && g == 5 {
			i.Op = "fldcw"
		}
		if op == 0xdd && g == 7 {
			i.Op = "fnstsw"
		}
		return
	}
	if op != 0x0f {
		return
	}
	second := d.second
	if (second == 0x12 || second == 0x13 || second == 0x16 || second == 0x17) && d.repeat == 0 {
		rm, r, _ := d.modrm(8)
		if (second&1 != 0 || operand16) && rm.Kind != memOperand {
			return
		}
		i.Op, i.CC, i.Width = "movhalf", second, 16
		i.Dst, i.Src = r, rm
		if second&1 != 0 {
			i.Dst, i.Src = rm, r
		}
		return
	}
	switch second {
	case 0xc6, 0x10, 0x11, 0x28, 0x29, 0x6f, 0x7f, 0x6e, 0x7e, 0xd6, 0x54, 0x55, 0x56, 0x57, 0xdb, 0xdf, 0xeb, 0xef, 0x74, 0x75, 0x76, 0xd7, 0x70, 0x60, 0x61, 0x62, 0x68, 0x69, 0x6a, 0x6c, 0x6d, 0xfc, 0xfd, 0xfe, 0xd4, 0xf8, 0xf9, 0xfa, 0xfb, 0x73, 0x71, 0x72:
		rm, r, g := d.modrm(8)
		i.Op = "vector"
		i.CC = second
		i.Dst, i.Src = r, rm
		i.Width = 16
		i.SourceWidth = 16
		switch second {
		case 0x11, 0x29, 0x7f, 0xd6:
			i.Dst, i.Src = rm, r
		}
		if second == 0x10 || second == 0x11 {
			if d.repeat == 0xf3 {
				i.Width = 4
			}
			if d.repeat == 0xf2 {
				i.Width = 8
			}
		}
		if second == 0x6e || second == 0x7e {
			i.Width = 4
			if d.rex&8 != 0 {
				i.Width = 8
			}
			if second == 0x7e {
				if d.repeat == 0xf3 {
					i.Width = 8
				} else {
					i.Dst, i.Src = rm, r
				}
			}
		}
		if second == 0xd6 {
			i.Width = 8
		}
		if second == 0x70 || second == 0xc6 {
			i.SourceWidth = d.byte()
		}
		if second == 0xc6 && operand16 {
			i.Op = "shufpd"
		}
		if second == 0x73 || second == 0x71 || second == 0x72 {
			i.Dst = rm
			i.Src = immediate(d.immediate(1, false))
			i.SourceWidth = g
		}
	}
}
func (c *CPU) vectorExecute(i Instruction) (bool, error) {
	if i.Op == "x87" || i.Op == "fninit" || i.Op == "fnstswax" || i.Op == "fnstsw" || i.Op == "fnstcw" || i.Op == "fldcw" {
		if c.System != nil && c.System.CR[0]&12 != 0 {
			return true, &Exception{Vector: 7}
		}
	}
	if i.Op == "x87" {
		err := c.executeX87(i)
		if err == nil {
			c.PC = i.Next
			c.Retired++
		}
		return true, err
	}
	var e error
	next := i.Next
	switch i.Op {
	case "fwait":
		// Execution is synchronous, so only pending exceptions need checking.
		// Unlike other x87 operations, WAIT requires both CR0.MP and TS for #NM.
		if c.System != nil && c.System.CR[0]&0xa == 0xa {
			return true, &Exception{Vector: 7}
		}
		if c.FPStatus & ^c.FPControl & 0x3f != 0 {
			return true, &Exception{Vector: 16}
		}
	case "fninit":
		c.FPControl = 0x37f
		c.FPStatus = 0
		c.FPTag = 0
		c.FP = [8]Extended{}
		c.FPIP, c.FPDP, c.FPCS, c.FPDS, c.FPOpcode = 0, 0, 0, 0, 0
	case "fnstswax":
		c.R[RAX] = c.R[RAX]&^65535 | uint64(c.FPStatus)
	case "fnstsw":
		e = c.write(i.Dst, 2, next, uint64(c.FPStatus))
	case "fnstcw":
		e = c.write(i.Dst, 2, next, uint64(c.FPControl))
	case "fldcw":
		v, err := c.read(i.Dst, 2, next)
		e = err
		if e == nil {
			c.FPControl = uint16(v)
		}
	case "fx":
		address := c.address(i.Dst, next)
		switch i.CC {
		case 0:
			if address&15 != 0 {
				return true, gp()
			}
			var data [512]byte
			binary.LittleEndian.PutUint16(data[:], c.FPControl)
			binary.LittleEndian.PutUint16(data[2:], c.FPStatus)
			data[4] = c.FPTag
			binary.LittleEndian.PutUint32(data[24:], c.MXCSR)
			binary.LittleEndian.PutUint32(data[28:], 0xffff)
			for j := range c.XMM {
				copy(data[160+j*16:], c.XMM[j][:])
			}
			for j := 0; j < 512; j += 8 {
				e = c.Memory.Write(address+uint64(j), 8, binary.LittleEndian.Uint64(data[j:]))
				if e != nil {
					break
				}
			}
		case 1:
			if address&15 != 0 {
				return true, gp()
			}
			var data [512]byte
			for j := 0; j < 512; j += 8 {
				var v uint64
				v, e = c.Memory.Read(address+uint64(j), 8, false)
				if e != nil {
					break
				}
				binary.LittleEndian.PutUint64(data[j:], v)
			}
			if e == nil {
				c.FPControl = binary.LittleEndian.Uint16(data[:])
				c.FPStatus = binary.LittleEndian.Uint16(data[2:])
				c.FPTag = data[4]
				c.MXCSR = binary.LittleEndian.Uint32(data[24:])
				for j := range c.XMM {
					copy(c.XMM[j][:], data[160+j*16:])
				}
			}
		case 2:
			v, err := c.Memory.Read(address, 4, false)
			e = err
			if e == nil {
				if v&^65535 != 0 {
					e = gp()
				} else {
					c.MXCSR = uint32(v)
				}
			}
		case 3:
			e = c.Memory.Write(address, 4, uint64(c.MXCSR))
		case 7: // CLFLUSH has no observable cache state in this interpreter.
			_, e = c.Memory.Read(address, 1, false)
		default:
			e = fmt.Errorf("unsupported FPU state operation /%d", i.CC)
		}
	case "vector", "shufpd", "movhalf":
		read := func(o Operand, w uint8) ([16]byte, error) {
			var v [16]byte
			if o.Kind == regOperand {
				return c.XMM[o.Reg], nil
			}
			a := c.address(o, next)
			for j := 0; j < int(w); j++ {
				b, err := c.Memory.Read(a+uint64(j), 1, false)
				if err != nil {
					return v, err
				}
				v[j] = byte(b)
			}
			return v, nil
		}
		store := func(o Operand, w uint8, v [16]byte) error {
			if o.Kind == regOperand {
				copy(c.XMM[o.Reg][:w], v[:w])
				return nil
			}
			a := c.address(o, next)
			for j := 0; j < int(w); j++ {
				if err := c.Memory.Write(a+uint64(j), 1, uint64(v[j])); err != nil {
					return err
				}
			}
			return nil
		}
		if i.Op == "movhalf" {
			if i.CC&1 != 0 {
				value := c.XMM[i.Src.Reg]
				if i.CC == 0x17 {
					copy(value[:8], value[8:])
				}
				e = store(i.Dst, 8, value)
			} else {
				width := uint8(8)
				if i.Src.Kind == regOperand {
					width = 16
				}
				var source [16]byte
				source, e = read(i.Src, width)
				if e == nil {
					value := c.XMM[i.Dst.Reg]
					if i.CC == 0x16 {
						copy(value[8:], source[:8])
					} else if i.Src.Kind == regOperand {
						copy(value[:8], source[8:])
					} else {
						copy(value[:8], source[:8])
					}
					c.XMM[i.Dst.Reg] = value
				}
			}
			break
		}
		if (i.CC == 0x28 || i.CC == 0x29 || (i.CC == 0x6f || i.CC == 0x7f) && i.Repeat != 0xf3) && ((i.Dst.Kind == memOperand && c.address(i.Dst, next)&15 != 0) || (i.Src.Kind == memOperand && c.address(i.Src, next)&15 != 0)) {
			return true, gp()
		}
		if i.CC == 0x6e {
			v, err := c.read(i.Src, i.Width, next)
			e = err
			if e == nil {
				var data [16]byte
				binary.LittleEndian.PutUint64(data[:], v)
				c.XMM[i.Dst.Reg] = data
			}
			break
		}
		if i.CC == 0x7e && i.Repeat != 0xf3 {
			v := binary.LittleEndian.Uint64(c.XMM[i.Src.Reg][:])
			e = c.write(i.Dst, i.Width, next, v)
			break
		}
		if i.CC == 0xd7 {
			v, err := read(i.Src, 16)
			e = err
			if e == nil {
				var mask uint64
				for j, b := range v {
					mask |= uint64(b>>7) << j
				}
				e = c.write(i.Dst, 4, next, mask)
			}
			break
		}
		if i.CC == 0x73 || i.CC == 0x71 || i.CC == 0x72 {
			v := c.XMM[i.Dst.Reg]
			var result [16]byte
			n := i.Src.Imm
			if i.CC == 0x73 && (i.SourceWidth == 3 || i.SourceWidth == 7) {
				if n < 16 {
					if i.SourceWidth == 3 {
						copy(result[:], v[n:])
					} else {
						copy(result[n:], v[:])
					}
				}
			} else {
				width := 2
				if i.CC == 0x72 {
					width = 4
				}
				if i.CC == 0x73 {
					width = 8
				}
				for j := 0; j < 16; j += width {
					var a uint64
					for k := 0; k < width; k++ {
						a |= uint64(v[j+k]) << uint(k*8)
					}
					switch i.SourceWidth {
					case 2:
						a >>= n
					case 6:
						a <<= n
					case 4:
						a = uint64(signed(a, uint8(width)) >> n)
					default:
						return true, fmt.Errorf("vector shift /%d", i.SourceWidth)
					}
					for k := 0; k < width; k++ {
						result[j+k] = byte(a >> uint(k*8))
					}
				}
			}
			c.XMM[i.Dst.Reg] = result
			break
		}
		b, err := read(i.Src, i.Width)
		e = err
		if e != nil {
			break
		}
		a := c.XMM[i.Dst.Reg&15]
		v := b
		switch i.CC {
		case 0x10, 0x11, 0x28, 0x29, 0x6f, 0x7f, 0x7e, 0xd6:
			if i.Dst.Kind == regOperand && i.Src.Kind == memOperand && i.Width < 16 {
				c.XMM[i.Dst.Reg] = [16]byte{}
			}
		case 0x54, 0xdb:
			for j := range v {
				v[j] = a[j] & b[j]
			}
		case 0x55, 0xdf:
			for j := range v {
				v[j] = ^a[j] & b[j]
			}
		case 0x56, 0xeb:
			for j := range v {
				v[j] = a[j] | b[j]
			}
		case 0x57, 0xef:
			for j := range v {
				v[j] = a[j] ^ b[j]
			}
		case 0x74, 0x75, 0x76:
			width := 1 << uint(i.CC-0x74)
			for j := 0; j < 16; j += width {
				equal := true
				for k := 0; k < width; k++ {
					equal = equal && a[j+k] == b[j+k]
				}
				for k := 0; k < width; k++ {
					v[j+k] = 0
					if equal {
						v[j+k] = 255
					}
				}
			}
		case 0xc6: // SHUFPS/SHUFPD select from the old destination and source.
			if i.Op == "shufpd" {
				lo := int(i.SourceWidth&1) * 8
				hi := int(i.SourceWidth>>1&1) * 8
				copy(v[:8], a[lo:lo+8])
				copy(v[8:], b[hi:hi+8])
			} else {
				for j := 0; j < 4; j++ {
					from := a
					if j >= 2 {
						from = b
					}
					o := int(i.SourceWidth>>uint(j*2)&3) * 4
					copy(v[j*4:], from[o:o+4])
				}
			}
		case 0x70:
			for j := 0; j < 4; j++ {
				o := int(i.SourceWidth>>uint(j*2)&3) * 4
				copy(v[j*4:], b[o:o+4])
			}
		case 0x60, 0x61, 0x62, 0x68, 0x69, 0x6a, 0x6c, 0x6d:
			width := 1 << uint(i.CC&3)
			if i.CC >= 0x6c {
				width = 8
			}
			offset := 0
			if i.CC >= 0x68 && i.CC <= 0x6a || i.CC == 0x6d {
				offset = 8
			}
			for j := 0; j < 8/width; j++ {
				copy(v[j*2*width:], a[offset+j*width:offset+(j+1)*width])
				copy(v[(j*2+1)*width:], b[offset+j*width:offset+(j+1)*width])
			}
		case 0xfc, 0xfd, 0xfe, 0xd4, 0xf8, 0xf9, 0xfa, 0xfb:
			width := 1 << uint(i.CC&3)
			if i.CC == 0xd4 {
				width = 8
			}
			for j := 0; j < 16; j += width {
				var av, bv uint64
				for k := 0; k < width; k++ {
					av |= uint64(a[j+k]) << uint(k*8)
					bv |= uint64(b[j+k]) << uint(k*8)
				}
				if i.CC >= 0xf8 && i.CC <= 0xfb {
					av -= bv
				} else {
					av += bv
				}
				for k := 0; k < width; k++ {
					v[j+k] = byte(av >> uint(k*8))
				}
			}
		default:
			return true, fmt.Errorf("unsupported vector opcode %#x", i.CC)
		}
		e = store(i.Dst, i.Width, v)
	default:
		return false, nil
	}
	if e != nil {
		return true, e
	}
	c.PC = next
	c.Retired++
	return true, nil
}

-- x87.go --
package x86

import (
	"fmt"
	"math/big"
)

// Extended is the x87's explicit-integer-bit 80-bit storage format. Arithmetic
// uses Go's arbitrary-precision binary floating point, not host float64; all
// 64 significand bits and the extended exponent range survive register ops.
type Extended struct {
	Significand  uint64
	SignExponent uint16
}

func (x Extended) sign() bool { return x.SignExponent&0x8000 != 0 }
func (x Extended) nan() bool  { return x.SignExponent&0x7fff == 0x7fff && x.Significand != 1<<63 }
func (x Extended) inf() bool  { return x.SignExponent&0x7fff == 0x7fff && x.Significand == 1<<63 }
func (x Extended) zero() bool { return x.Significand == 0 && x.SignExponent&0x7fff == 0 }
func indefinite() Extended    { return Extended{0xc000000000000000, 0xffff} }
func (x Extended) number() *big.Float {
	v := new(big.Float).SetPrec(64)
	if x.inf() {
		return v.SetInf(x.sign())
	}
	v.SetUint64(x.Significand)
	exp := int(x.SignExponent & 0x7fff)
	if exp == 0 {
		exp = 1
	}
	v.SetMantExp(v, exp-16383-63)
	if x.sign() {
		v.Neg(v)
	}
	return v
}
func roundMagnitude(v *big.Float, mode uint16, negative bool) (*big.Int, bool) {
	n, _ := v.Int(nil)
	back := new(big.Float).SetPrec(256).SetInt(n)
	fraction := new(big.Float).SetPrec(256).Sub(v, back)
	if fraction.Sign() == 0 {
		return n, false
	}
	up := false
	switch mode {
	case 0:
		cmp := fraction.Cmp(new(big.Float).SetFloat64(0.5))
		up = cmp > 0 || cmp == 0 && n.Bit(0) != 0
	case 1:
		up = negative
	case 2:
		up = !negative
	}
	if up {
		n.Add(n, big.NewInt(1))
	}
	return n, true
}
func (c *CPU) fpRoundMode() big.RoundingMode {
	switch c.FPControl >> 10 & 3 {
	case 1:
		return big.ToNegativeInf
	case 2:
		return big.ToPositiveInf
	case 3:
		return big.ToZero
	}
	return big.ToNearestEven
}
func (c *CPU) fpPrecision() uint {
	switch c.FPControl >> 8 & 3 {
	case 0:
		return 24
	case 2:
		return 53
	}
	return 64
}
func (c *CPU) encodeFP(v *big.Float, p uint, bias int, expBits uint, explicit bool) (uint64, uint16, uint16) {
	negative := v.Signbit()
	sign := uint16(0)
	if negative {
		sign = 0x8000
	}
	maxExp := (1 << expBits) - 1
	if v.IsInf() {
		return 1 << p, uint16(maxExp) | sign, 0
	}
	if v.Sign() == 0 {
		return 0, sign, 0
	}
	a := new(big.Float).SetPrec(256).Abs(v)
	e := a.MantExp(nil) - 1
	minNormal := 1 - bias
	maxNormal := maxExp - 1 - bias
	status := uint16(0)
	if e > maxNormal {
		status = 8 | 32
		inf := c.FPControl>>10&3 == 0 || c.FPControl>>10&3 == 1 && negative || c.FPControl>>10&3 == 2 && !negative
		if inf {
			return 1 << p, uint16(maxExp) | sign, status
		}
		return ^uint64(0) >> (63 - p), uint16(maxExp-1) | sign, status
	}
	sub := e < minNormal
	if sub {
		e = minNormal
	}
	scaled := new(big.Float).SetPrec(256).SetMantExp(a, int(p)-e)
	n, inexact := roundMagnitude(scaled, c.FPControl>>10&3, negative)
	if inexact {
		status |= 32
		if sub {
			status |= 16
		}
	}
	if n.BitLen() > int(p)+1 {
		n.Rsh(n, 1)
		e++
	}
	exponent := e + bias
	if sub && n.BitLen() <= int(p) {
		exponent = 0
	}
	if exponent >= maxExp {
		return 1 << p, uint16(maxExp) | sign, status | 8 | 32
	}
	mant := n.Uint64()
	if !explicit && exponent != 0 {
		mant &^= 1 << p
	}
	return mant, uint16(exponent) | sign, status
}
func (c *CPU) extended(v *big.Float) (Extended, uint16) {
	m, e, status := c.encodeFP(v, 63, 16383, 15, true)
	return Extended{m, e}, status
}
func (c *CPU) fpRaise(bits uint16) bool {
	c.FPStatus |= bits
	if bits&^c.FPControl&0x3f != 0 {
		c.FPStatus |= 0x8080
		return false
	}
	return true
}
func (c *CPU) fpTop() int       { return int(c.FPStatus >> 11 & 7) }
func (c *CPU) fpSetTop(top int) { c.FPStatus = c.FPStatus&^0x3800 | uint16(top&7)<<11 }
func (c *CPU) fpGet(index int) (Extended, bool) {
	at := (c.fpTop() + index) & 7
	if c.FPTag&(1<<at) == 0 {
		c.FPStatus &^= 0x200
		return indefinite(), c.fpRaise(1 | 0x40)
	}
	return c.FP[at], true
}
func (c *CPU) fpPut(index int, v Extended) {
	at := (c.fpTop() + index) & 7
	c.FP[at] = v
	c.FPTag |= 1 << at
}
func (c *CPU) fpPush(v Extended) bool {
	at := (c.fpTop() + 7) & 7
	if c.FPTag&(1<<at) != 0 {
		c.FPStatus |= 0x200
		if !c.fpRaise(1 | 0x40) {
			return false
		}
		v = indefinite()
	} else {
		c.FPStatus &^= 0x200
	}
	c.fpSetTop(at)
	c.fpPut(0, v)
	return true
}
func (c *CPU) fpPop() { c.FPTag &^= 1 << c.fpTop(); c.fpSetTop(c.fpTop() + 1) }
func (d *decoder) decodeX87(i *Instruction, op byte) {
	b := d.byte()
	i.Op = "x87"
	i.CC = op
	i.SourceWidth = b
	if b < 0xc0 {
		d.pc--
		rm, _, _ := d.modrm(2)
		i.Dst = rm
	}
	// Retain the established public decode classifications for control operations.
	if op == 0xdb && b == 0xe3 {
		i.Op = "fninit"
	}
	if op == 0xdf && b == 0xe0 {
		i.Op = "fnstswax"
	}
	if b < 0xc0 {
		g := b >> 3 & 7
		if op == 0xd9 && g == 5 {
			i.Op = "fldcw"
		}
		if op == 0xd9 && g == 7 {
			i.Op = "fnstcw"
		}
		if op == 0xdd && g == 7 {
			i.Op = "fnstsw"
		}
	}
}
func (c *CPU) fpLoad(a uint64, n int, integer bool) (Extended, error) {
	if n == 10 {
		lo, err := c.Memory.Read(a, 8, false)
		if err != nil {
			return Extended{}, err
		}
		hi, err := c.Memory.Read(a+8, 2, false)
		return Extended{lo, uint16(hi)}, err
	}
	v, err := c.Memory.Read(a, n, false)
	if err != nil {
		return Extended{}, err
	}
	if integer {
		value := new(big.Float).SetPrec(64).SetInt64(signed(v, uint8(n)))
		out, _ := c.extended(value)
		return out, nil
	}
	var exponent, mant, sign uint64
	var bias, p int
	if n == 4 {
		exponent = v >> 23 & 255
		mant = v & 0x7fffff
		sign = v >> 31
		bias, p = 127, 23
	} else {
		exponent = v >> 52 & 2047
		mant = v & 0xfffffffffffff
		sign = v >> 63
		bias, p = 1023, 52
	}
	maxExp := uint64(255)
	if n == 8 {
		maxExp = 2047
	}
	se := uint16(sign) << 15
	if exponent == maxExp {
		return Extended{1<<63 | mant<<uint(63-p), se | 0x7fff}, nil
	}
	if exponent == 0 {
		if mant == 0 {
			return Extended{0, se}, nil
		}
		exponent = 1
	} else {
		mant |= 1 << uint(p)
	}
	value := new(big.Float).SetPrec(64).SetUint64(mant)
	value.SetMantExp(value, int(exponent)-bias-p)
	if sign != 0 {
		value.Neg(value)
	}
	out, _ := c.extended(value)
	return out, nil
}
func (c *CPU) fpStore(a uint64, n int, x Extended, integer, trunc bool) (bool, error) {
	if integer {
		value := uint64(1) << uint(n*8-1)
		invalid := x.nan() || x.inf()
		var inexact bool
		if !invalid {
			f := x.number()
			negative := f.Signbit()
			f.Abs(f)
			mode := c.FPControl >> 10 & 3
			if trunc {
				mode = 3
			}
			num, ix := roundMagnitude(f, mode, negative)
			inexact = ix
			if negative {
				num.Neg(num)
			}
			min := new(big.Int).Neg(new(big.Int).Lsh(big.NewInt(1), uint(n*8-1)))
			max := new(big.Int).Sub(new(big.Int).Lsh(big.NewInt(1), uint(n*8-1)), big.NewInt(1))
			invalid = num.Cmp(min) < 0 || num.Cmp(max) > 0
			if !invalid {
				value = uint64(num.Int64())
			}
		}
		if invalid && !c.fpRaise(1) || !invalid && inexact && !c.fpRaise(32) {
			return false, nil
		}
		return true, c.Memory.Write(a, n, value)
	}
	if n == 10 {
		if err := c.Memory.Write(a, 8, x.Significand); err != nil {
			return false, err
		}
		return true, c.Memory.Write(a+8, 2, uint64(x.SignExponent))
	}
	p, bias, expBits := uint(23), 127, uint(8)
	if n == 8 {
		p, bias, expBits = 52, 1023, 11
	}
	var mant uint64
	var e, st uint16
	if x.nan() {
		mant = 1 << (p - 1)
		e = uint16((1 << expBits) - 1)
		if x.sign() {
			e |= 0x8000
		}
	} else {
		mant, e, st = c.encodeFP(x.number(), p, bias, expBits, false)
	}
	if st != 0 && !c.fpRaise(st) {
		return false, nil
	}
	value := mant&((1<<p)-1) | uint64(e&0x7fff)<<p
	if e&0x8000 != 0 {
		value |= 1 << uint(n*8-1)
	}
	return true, c.Memory.Write(a, n, value)
}
func (c *CPU) fpCompare(a, b Extended, quiet, flags bool) bool {
	code := uint16(0)
	if a.nan() || b.nan() {
		code = 0x4500
		if !quiet && !c.fpRaise(1) {
			return false
		}
	} else {
		cmp := a.number().Cmp(b.number())
		if cmp < 0 {
			code = 0x100
		} else if cmp == 0 {
			code = 0x4000
		}
	}
	if flags {
		c.Flags &^= CF | PF | ZF | OF | SF | AF
		if code&0x100 != 0 {
			c.Flags |= CF
		}
		if code&0x400 != 0 {
			c.Flags |= PF
		}
		if code&0x4000 != 0 {
			c.Flags |= ZF
		}
	} else {
		c.FPStatus = c.FPStatus&^0x4700 | code
	}
	return true
}
func (c *CPU) fpArithmetic(a, b Extended, op int) (Extended, bool) {
	if a.nan() || b.nan() {
		return indefinite(), c.fpRaise(1)
	}
	reverse := op == 5 || op == 7
	if reverse {
		a, b = b, a
	}
	invalid := false
	if op == 0 {
		invalid = a.inf() && b.inf() && a.sign() != b.sign()
	}
	if op == 4 || op == 5 {
		invalid = a.inf() && b.inf() && a.sign() == b.sign()
	}
	if op == 1 {
		invalid = a.zero() && b.inf() || b.zero() && a.inf()
	}
	if op == 6 || op == 7 {
		invalid = a.zero() && b.zero() || a.inf() && b.inf()
		if !invalid && b.zero() {
			if !c.fpRaise(4) {
				return Extended{}, false
			}
			sign := uint16(0x7fff)
			if a.sign() != b.sign() {
				sign |= 0x8000
			}
			return Extended{1 << 63, sign}, true
		}
	}
	if invalid {
		return indefinite(), c.fpRaise(1)
	}
	x, y := a.number(), b.number()
	z := new(big.Float).SetPrec(c.fpPrecision()).SetMode(c.fpRoundMode())
	switch op {
	case 0:
		z.Add(x, y)
	case 1:
		z.Mul(x, y)
	case 4, 5:
		z.Sub(x, y)
	case 6, 7:
		z.Quo(x, y)
	}
	status := uint16(0)
	c.FPStatus &^= 0x200
	if z.Acc() != big.Exact {
		status |= 32
		if z.Acc() == big.Above && !z.Signbit() || z.Acc() == big.Below && z.Signbit() {
			c.FPStatus |= 0x200
		}
	}
	out, st := c.extended(z)
	status |= st
	if status != 0 && !c.fpRaise(status) {
		return Extended{}, false
	}
	return out, true
}
func (c *CPU) fpTagWord() uint16 {
	var tag uint16
	for j, x := range c.FP {
		kind := uint16(3)
		if c.FPTag&(1<<j) != 0 {
			kind = 0
			if x.zero() {
				kind = 1
			} else if x.nan() || x.inf() || x.SignExponent&0x7fff == 0 {
				kind = 2
			}
		}
		tag |= kind << uint(j*2)
	}
	return tag
}
func (c *CPU) fpEnvironment(a uint64, w uint8, load, registers bool) error {
	size := 14
	if w != 2 {
		size = 28
	}
	total := size
	if registers {
		total += 80
	}
	data := make([]byte, total)
	read16 := func(off int) uint16 { return uint16(data[off]) | uint16(data[off+1])<<8 }
	put16 := func(off int, v uint16) { data[off], data[off+1] = byte(v), byte(v>>8) }
	read32 := func(off int) uint32 { return uint32(read16(off)) | uint32(read16(off+2))<<16 }
	put32 := func(off int, v uint32) { put16(off, uint16(v)); put16(off+2, uint16(v>>16)) }
	if load {
		for j := range data {
			v, e := c.Memory.Read(a+uint64(j), 1, false)
			if e != nil {
				return e
			}
			data[j] = byte(v)
		}
		if size == 14 {
			c.FPControl, c.FPStatus = read16(0), read16(2)
			c.FPIP, c.FPDP = uint64(read16(6)), uint64(read16(10))
			c.FPCS, c.FPDS = read16(8), read16(12)
		} else {
			c.FPControl, c.FPStatus = read16(0), read16(4)
			c.FPIP, c.FPDP = uint64(read32(12)), uint64(read32(20))
			c.FPCS, c.FPDS, c.FPOpcode = read16(16), read16(24), read16(18)&0x7ff
		}
		tag := read16(4)
		if size == 28 {
			tag = read16(8)
		}
		c.FPTag = 0
		for j := 0; j < 8; j++ {
			if tag>>uint(j*2)&3 != 3 {
				c.FPTag |= 1 << j
			}
		}
		if registers {
			for j := 0; j < 8; j++ {
				at := size + j*10
				lo := uint64(read32(at)) | uint64(read32(at+4))<<32
				c.FP[(c.fpTop()+j)&7] = Extended{lo, read16(at + 8)}
			}
		}
		return nil
	}
	if size == 14 {
		put16(0, c.FPControl)
		put16(2, c.FPStatus)
		put16(4, c.fpTagWord())
		put16(6, uint16(c.FPIP))
		put16(8, c.FPCS)
		put16(10, uint16(c.FPDP))
		put16(12, c.FPDS)
	} else {
		for j := range data[:size] {
			data[j] = 0xff
		}
		put16(0, c.FPControl)
		put16(4, c.FPStatus)
		put16(8, c.fpTagWord())
		put32(12, uint32(c.FPIP))
		put16(16, c.FPCS)
		put16(18, c.FPOpcode)
		put32(20, uint32(c.FPDP))
		put16(24, c.FPDS)
	}
	if registers {
		for j := 0; j < 8; j++ {
			x := c.FP[(c.fpTop()+j)&7]
			at := size + j*10
			put32(at, uint32(x.Significand))
			put32(at+4, uint32(x.Significand>>32))
			put16(at+8, x.SignExponent)
		}
	}
	// Preflight every page before changing a save image or the live FPU state.
	if c.System != nil {
		for j := range data {
			if _, err := c.System.translate(a+uint64(j), true, false); err != nil {
				return err
			}
		}
	}
	for j, v := range data {
		if err := c.Memory.Write(a+uint64(j), 1, uint64(v)); err != nil {
			return err
		}
	}
	if registers {
		c.FPControl, c.FPStatus, c.FPTag = 0x37f, 0, 0
	} else {
		c.FPControl |= 0x3f
	}
	return nil
}
func (c *CPU) executeX87(i Instruction) error {
	op, b := i.CC, i.SourceWidth
	group, reg := int(b>>3&7), int(b&7)
	noWait := op == 0xdb && (b == 0xe2 || b == 0xe3 || b == 0xe0 || b == 0xe1 || b == 0xe4) || b < 0xc0 && (op == 0xdd && group == 6 || op == 0xd9 && group == 6)
	if !noWait && c.FPStatus&^c.FPControl&0x3f != 0 {
		return &Exception{Vector: 16}
	}
	if b < 0xc0 {
		a, err := c.memoryAddress(i.Dst, i.Next, 1, false)
		if err != nil {
			return err
		}
		arithmetic := op == 0xd8 || op == 0xdc || op == 0xda || op == 0xde
		if arithmetic {
			n := 4
			if op == 0xdc {
				n = 8
			}
			if op == 0xde {
				n = 2
			}
			value, err := c.fpLoad(a, n, op == 0xda || op == 0xde)
			if err != nil {
				return err
			}
			top, ok := c.fpGet(0)
			if !ok {
				return nil
			}
			if group == 2 || group == 3 {
				if c.fpCompare(top, value, false, false) && group == 3 {
					c.fpPop()
				}
			} else if result, ok := c.fpArithmetic(top, value, group); ok {
				c.fpPut(0, result)
			}
			return nil
		}
		if op == 0xd9 && (group == 4 || group == 6) || op == 0xdd && (group == 4 || group == 6) {
			return c.fpEnvironment(a, i.Width, group == 4, op == 0xdd)
		}
		integer, n, load, pop, trunc := false, 4, false, false, false
		switch op {
		case 0xd9:
			load = group == 0
			pop = group == 3
		case 0xdd:
			n = 8
			load = group == 0
			pop = group == 3
			integer = group == 1
			trunc = integer
		case 0xdb:
			integer = true
			load = group == 0
			pop = group == 1 || group == 3
			trunc = group == 1
			if group == 5 || group == 7 {
				integer = false
				n = 10
				load = group == 5
				pop = group == 7
			}
		case 0xdf:
			integer = true
			n = 2
			load = group == 0
			pop = group == 1 || group == 3
			trunc = group == 1
			if group == 5 || group == 7 {
				n = 8
				load = group == 5
				pop = group == 7
			}
		}
		if load {
			value, err := c.fpLoad(a, n, integer)
			if err == nil {
				c.fpPush(value)
			}
			return err
		}
		if group != 1 && group != 2 && group != 3 && !(op == 0xdb && group == 7) && !(op == 0xdf && group == 7) {
			return fmt.Errorf("unsupported x87 memory %02x /%d", op, group)
		}
		value, ok := c.fpGet(0)
		if !ok {
			return nil
		}
		committed, err := c.fpStore(a, n, value, integer, trunc)
		if err == nil && committed && pop {
			c.fpPop()
		}
		return err
	}
	if op == 0xdb && b >= 0xe0 && b <= 0xe4 {
		if b == 0xe2 {
			c.FPStatus &^= 0x80ff
		}
		return nil
	}
	if op == 0xd9 {
		switch {
		case b >= 0xc0 && b <= 0xc7:
			v, ok := c.fpGet(reg)
			if ok {
				c.fpPush(v)
			}
			return nil
		case b >= 0xc8 && b <= 0xcf:
			a, ok := c.fpGet(0)
			if !ok {
				return nil
			}
			v, ok := c.fpGet(reg)
			if ok {
				c.fpPut(0, v)
				c.fpPut(reg, a)
			}
			return nil
		case b == 0xd0:
			return nil
		case b == 0xe0 || b == 0xe1:
			v, ok := c.fpGet(0)
			if ok {
				if b == 0xe0 {
					v.SignExponent ^= 0x8000
				} else {
					v.SignExponent &^= 0x8000
				}
				c.fpPut(0, v)
			}
			return nil
		case b == 0xe4:
			v, ok := c.fpGet(0)
			if ok {
				c.fpCompare(v, Extended{}, false, false)
			}
			return nil
		case b == 0xe5:
			v := c.FP[c.fpTop()]
			code := uint16(0)
			if c.FPTag&(1<<c.fpTop()) == 0 {
				code = 0x4100
			} else if v.zero() {
				code = 0x4000
			} else if v.nan() {
				code = 0x100
			} else if v.inf() {
				code = 0x500
			} else if v.SignExponent&0x7fff == 0 {
				code = 0x4400
			} else {
				code = 0x400
			}
			if v.sign() {
				code |= 0x200
			}
			c.FPStatus = c.FPStatus&^0x4700 | code
			return nil
		case b >= 0xe8 && b <= 0xee:
			constants := [7]Extended{{0x8000000000000000, 0x3fff}, {0xd49a784bcd1b8afe, 0x4000}, {0xb8aa3b295c17f0bc, 0x3fff}, {0xc90fdaa22168c235, 0x4000}, {0x9a209a84fbcff799, 0x3ffd}, {0xb17217f7d1cf79ac, 0x3ffe}, {0, 0}}
			c.fpPush(constants[b-0xe8])
			return nil
		case b == 0xf6:
			c.fpSetTop(c.fpTop() + 7)
			c.FPStatus &^= 0x200
			return nil
		case b == 0xf7:
			c.fpSetTop(c.fpTop() + 1)
			c.FPStatus &^= 0x200
			return nil
		case b == 0xfa:
			v, ok := c.fpGet(0)
			if !ok {
				return nil
			}
			if v.nan() || v.sign() && !v.zero() {
				if c.fpRaise(1) {
					c.fpPut(0, indefinite())
				}
				return nil
			}
			z := new(big.Float).SetPrec(c.fpPrecision()).SetMode(c.fpRoundMode()).Sqrt(v.number())
			out, st := c.extended(z)
			if z.Acc() != big.Exact {
				st |= 32
			}
			if st == 0 || c.fpRaise(st) {
				c.fpPut(0, out)
			}
			return nil
		case b == 0xfc:
			v, ok := c.fpGet(0)
			if !ok || v.nan() || v.inf() {
				return nil
			}
			x := v.number()
			negative := x.Signbit()
			x.Abs(x)
			n, inexact := roundMagnitude(x, c.FPControl>>10&3, negative)
			if negative {
				n.Neg(n)
			}
			if inexact && !c.fpRaise(32) {
				return nil
			}
			out, _ := c.extended(new(big.Float).SetPrec(64).SetInt(n))
			c.fpPut(0, out)
			return nil
		case b == 0xfd:
			a, ok := c.fpGet(0)
			if !ok {
				return nil
			}
			v, ok := c.fpGet(1)
			if !ok {
				return nil
			}
			if a.nan() || v.nan() || v.inf() {
				return fmt.Errorf("unsupported nonfinite FSCALE")
			}
			n, _ := v.number().Int64()
			if n > 32768 {
				n = 32768
			}
			if n < -32768 {
				n = -32768
			}
			z := new(big.Float).SetPrec(64).SetMantExp(a.number(), int(n))
			out, st := c.extended(z)
			if st == 0 || c.fpRaise(st) {
				c.fpPut(0, out)
			}
			return nil
		}
	}
	if op == 0xdd {
		switch group {
		case 0:
			c.FPTag &^= 1 << ((c.fpTop() + reg) & 7)
			return nil
		case 2, 3:
			v, ok := c.fpGet(0)
			if ok {
				c.fpPut(reg, v)
				if group == 3 {
					c.fpPop()
				}
			}
			return nil
		case 4, 5:
			a, ok := c.fpGet(0)
			if !ok {
				return nil
			}
			v, ok := c.fpGet(reg)
			if ok && c.fpCompare(a, v, true, false) && group == 5 {
				c.fpPop()
			}
			return nil
		}
	}
	if op == 0xda && b == 0xe9 || op == 0xde && b == 0xd9 {
		a, ok := c.fpGet(0)
		if !ok {
			return nil
		}
		v, ok := c.fpGet(1)
		if ok && c.fpCompare(a, v, op == 0xda, false) {
			c.fpPop()
			c.fpPop()
		}
		return nil
	}
	if (op == 0xdb || op == 0xdf) && (group == 5 || group == 6) {
		a, ok := c.fpGet(0)
		if !ok {
			return nil
		}
		v, ok := c.fpGet(reg)
		if ok && c.fpCompare(a, v, group == 5, true) && op == 0xdf {
			c.fpPop()
		}
		return nil
	}
	if (op == 0xda || op == 0xdb) && group <= 3 {
		take := false
		switch group {
		case 0:
			take = c.Flags&CF != 0
		case 1:
			take = c.Flags&ZF != 0
		case 2:
			take = c.Flags&(CF|ZF) != 0
		case 3:
			take = c.Flags&PF != 0
		}
		if op == 0xdb {
			take = !take
		}
		if take {
			v, ok := c.fpGet(reg)
			if ok {
				c.fpPut(0, v)
			}
		}
		return nil
	}
	if op == 0xdf && group == 0 {
		c.FPTag &^= 1 << ((c.fpTop() + reg) & 7)
		c.fpPop()
		return nil
	}
	if op == 0xd8 || op == 0xdc || op == 0xde {
		a, ok := c.fpGet(0)
		if !ok {
			return nil
		}
		v, ok := c.fpGet(reg)
		if !ok {
			return nil
		}
		if group == 2 || group == 3 {
			if c.fpCompare(a, v, false, false) && group == 3 {
				c.fpPop()
			}
			return nil
		}
		dest := 0
		if op != 0xd8 {
			dest = reg
			a, v = v, a
			if group >= 4 {
				group ^= 1
			}
		}
		if out, ok := c.fpArithmetic(a, v, group); ok {
			c.fpPut(dest, out)
			if op == 0xde {
				c.fpPop()
			}
		}
		return nil
	}
	return fmt.Errorf("unsupported x87 register %02x %02x", op, b)
}

-- x87_rounding_test.go --
package x86

import "testing"

func TestX87C1ReportsRoundedMagnitudeAndClearsForExactResult(t *testing.T) {
	for _, negative := range []bool{false, true} {
		c := &CPU{FPControl: 0x37f}
		a := Extended{0x8000000000000001, 0x3fff}
		if negative {
			a.SignExponent |= 0x8000
		}
		b := Extended{0xc000000000000000, 0x3fff}
		out, ok := c.fpArithmetic(a, b, 1)
		if !ok || out.Significand != 0xc000000000000002 || c.FPStatus&0x220 != 0x220 {
			t.Fatalf("rounded result %+v status%x", out, c.FPStatus)
		}
		_, ok = c.fpArithmetic(Extended{1 << 63, 0x3fff}, Extended{1 << 63, 0x3fff}, 1)
		if !ok || c.FPStatus&0x200 != 0 {
			t.Fatal("exact multiply retained rounding-up C1")
		}
	}
}

-- x87_test.go --
package x86

import (
	"math"
	"testing"
)

func TestX87ExtendedLowBitSurvivesArithmetic(t *testing.T) {
	c, s, m := legacyCPU(t, []byte{0xdb, 0x2e, 0, 0x40, 0xd9, 0xe8, 0xde, 0xe9, 0xdb, 0x3e, 0x10, 0x40})
	_ = s
	m.Write(0x4000, 8, 0x8000000000000001)
	m.Write(0x4008, 2, 0x3fff)
	for j := 0; j < 4; j++ {
		step(t, c)
	}
	lo, _ := m.Read(0x4010, 8, false)
	exp, _ := m.Read(0x4018, 2, false)
	if lo != 1<<63 || exp != 0x3fc0 || c.FPTag != 0 {
		t.Fatalf("1+2^-63 - 1 lost precision: %016x:%04x tags=%x", lo, exp, c.FPTag)
	}
}
func TestX87SaveRestoreRealArithmeticAndIntegerRounding(t *testing.T) {
	c, _, m := legacyCPU(t, []byte{0xdd, 0x06, 0, 0x40, 0xdc, 0x0e, 8, 0x40, 0xdd, 0x36, 0, 0x50, 0xdd, 0x26, 0, 0x50, 0xdf, 0x1e, 0, 0x60})
	m.Write(0x4000, 8, math.Float64bits(1.5))
	m.Write(0x4008, 8, math.Float64bits(3))
	step(t, c)
	step(t, c)
	step(t, c)
	if c.FPTag != 0 || c.FPControl != 0x37f {
		t.Fatal("FNSAVE did not reset FPU")
	}
	step(t, c)
	step(t, c)
	v, _ := m.Read(0x6000, 2, false)
	if v != 4 || c.FPTag != 0 || c.FPStatus&32 == 0 {
		t.Fatalf("restored 4.5 nearest-even FISTP: %x tag%x sw%x", v, c.FPTag, c.FPStatus)
	}
}
func TestX87PrecisionControlAndDirectedStore(t *testing.T) {
	c, _, m := legacyCPU(t, []byte{0xdb, 0x06, 0, 0x40, 0xd9, 0xe8, 0xde, 0xc1, 0xdb, 0x1e, 0, 0x50})
	c.FPControl = 0x007f
	m.Write(0x4000, 4, 16777216)
	for j := 0; j < 4; j++ {
		step(t, c)
	}
	v, _ := m.Read(0x5000, 4, false)
	if v != 16777216 || c.FPStatus&32 == 0 {
		t.Fatalf("24-bit arithmetic precision %d sw%x", v, c.FPStatus)
	}
	for _, tc := range []struct {
		control uint16
		want    uint64
	}{{0x37f, 2}, {0x77f, 1}, {0xb7f, 2}, {0xf7f, 1}} {
		c, _, m := legacyCPU(t, []byte{0xdd, 0x06, 0, 0x40, 0xdb, 0x1e, 0, 0x50})
		c.FPControl = tc.control
		m.Write(0x4000, 8, math.Float64bits(1.5))
		step(t, c)
		step(t, c)
		v, _ := m.Read(0x5000, 4, false)
		if v != tc.want {
			t.Fatalf("rounding control%x got%d want%d", tc.control, v, tc.want)
		}
	}
}
func TestX87MaskedDivideZeroAndPendingException(t *testing.T) {
	c, _, _ := legacyCPU(t, []byte{0xd9, 0xe8, 0xd9, 0xee, 0xde, 0xf9, 0xdb, 0xe2})
	step(t, c)
	step(t, c)
	step(t, c)
	v, ok := c.fpGet(0)
	if !ok || !v.inf() || c.FPStatus&4 == 0 {
		t.Fatal("masked divide by zero", v, c.FPStatus)
	}
	step(t, c)
	if c.FPStatus&0xff != 0 {
		t.Fatal("FNCLEX", c.FPStatus)
	}
}
