RFE 1

-- rfe.json --
{
  "format": 1,
  "name": "x86",
  "import": "renvo.dev/rfe/x86"
}

-- adapter.go --
package x86

import (
	"renvo.dev/internal/rfe/engine"
	emu "renvo.dev/internal/rfe/runtime"
)

const (
	pcSlot           = 16
	flagsSlot        = 17
	stateWords       = 18
	fsBaseSlot       = 18
	gsBaseSlot       = 19
	systemStateWords = 20
	timeBaseSlot     = 20
	timedStateWords  = 21
)

// Adapter keeps the shared native ABI contiguous without forcing clients to
// use its representation. Sync at interpreter transitions and schedule edges.
type Adapter struct {
	CPU   *CPU
	state [timedStateWords]uint64
}

func NewAdapter(c *CPU) *Adapter { a := &Adapter{CPU: c}; a.Import(); return a }
func (a *Adapter) Import() {
	copy(a.state[:16], a.CPU.R[:])
	a.state[pcSlot] = a.CPU.PC
	a.state[flagsSlot] = a.CPU.Flags
	a.state[fsBaseSlot], a.state[gsBaseSlot], a.state[timeBaseSlot] = 0, 0, 0
	if a.CPU.System != nil {
		a.state[fsBaseSlot], a.state[gsBaseSlot], a.state[timeBaseSlot] = a.CPU.System.FSBase, a.CPU.System.GSBase, a.CPU.System.TSC
	}
}
func (a *Adapter) Export() {
	copy(a.CPU.R[:], a.state[:16])
	a.CPU.PC = a.state[pcSlot]
	a.CPU.Flags = a.state[flagsSlot]
}
func (a *Adapter) Registers() []uint64      { return a.state[:stateWords] }
func (a *Adapter) MemoryBus() engine.Memory { return a.CPU.Memory }
func (a *Adapter) Retirement() *uint64      { return &a.CPU.Retired }
func (a *Adapter) Step() error              { a.Export(); err := a.CPU.Step(); a.Import(); return err }
func (a *Adapter) ExecuteInstruction(i engine.Instruction) error {
	a.Export()
	err := a.CPU.Execute(i.Decoded.(Instruction))
	a.Import()
	return err
}
func Architecture() engine.Architecture {
	return engine.Architecture{Name: "x86_64", StateWords: stateWords, PC: pcSlot, Alignment: 1, Fetch: fetch, Lower: lower}
}

// SystemAdapter adds read-only FS/GS base values to the native state. Every
// interpreter and scheduling transition imports them again; SWAPGS/WRMSR and
// segment loads remain interpreted. Ordinary Linux-user adapters stay 18 words.
type SystemAdapter struct{ *Adapter }

func NewSystemAdapter(c *CPU) *SystemAdapter {
	if c.System == nil {
		panic("system adapter requires architectural segment state")
	}
	return &SystemAdapter{NewAdapter(c)}
}
func (a *SystemAdapter) Registers() []uint64      { return a.state[:systemStateWords] }
func (a *SystemAdapter) TimedRegisters() []uint64 { return a.state[:] }

func SystemArchitecture() engine.Architecture {
	arch := Architecture()
	arch.StateWords = systemStateWords
	arch.Fetch = func(m engine.Memory, pc uint64) (engine.Instruction, error) {
		ins, err := fetch(m, pc)
		if err == nil {
			ins.InterpretOnly = !supportedSystem(ins.Decoded.(Instruction))
		}
		return ins, err
	}
	arch.Lower = func(b *emu.Builder, ins engine.Instruction, completed int) bool {
		return lowerInstruction(b, ins, completed, true)
	}
	return arch
}
func supportedSystem(i Instruction) bool {
	if legacyString(i.Op) {
		return true
	}
	if (i.Dst.Segment != 0 && i.Dst.Segment != 0x64 && i.Dst.Segment != 0x65) ||
		(i.Src.Segment != 0 && i.Src.Segment != 0x64 && i.Src.Segment != 0x65) {
		return false
	}
	i.Dst.Segment, i.Src.Segment = 0, 0
	return supported(i)
}
func supported(i Instruction) bool {
	if legacyString(i.Op) {
		return i.Segment != 0x64 && i.Segment != 0x65
	}
	if i.Dst.Segment != 0 || i.Src.Segment != 0 {
		return false
	}
	switch i.Op {
	case "mov", "movsx", "movzx", "lea", "nop", "jmp", "jcc", "call", "callind", "jmpind", "ret", "push", "pop", "setcc", "cmov", "add", "adc", "sub", "sbb", "cmp", "inc", "dec", "neg", "and", "or", "xor", "test", "not", "imul", "imul3", "mul", "imul1", "xchg", "loop", "leave", "signpair", "cld", "std", "clc", "stc", "cmc", "pushf", "cmpxchg", "bt", "bts", "btr", "btc":
		return true
	case "bsf", "bsr":
		return true
	case "bswap":
		return i.Width == 4 || i.Width == 8
	case "shld", "shrd":
		// Dynamic 16-bit counts above width remain on the interpreter's path.
		// A memory zero-count must not write, even on a readonly mapping.
		if i.CC != 255 && uint64(i.CC)&31 == 0 && i.Dst.Kind == memOperand {
			return false
		}
		return i.Width >= 4 || i.CC != 255 && uint64(i.CC)&31 <= 16
	case "shl", "shr", "sar":
		return i.Width >= 4 || i.Src.Kind == immOperand && i.Src.Imm&31 > 0 && i.Src.Imm&31 < uint64(i.Width)*8
	case "rol", "ror":
		return i.Src.Kind == immOperand && i.Src.Imm > 0 && i.Src.Imm < uint64(i.Width)*8
	}
	return false
}

// ProfileOpcode exposes only the decoder's diagnostic classification. It never
// participates in instruction validation or native admission.
func (i Instruction) ProfileOpcode() string { return i.Op }

func fetch(m engine.Memory, pc uint64) (engine.Instruction, error) {
	i, err := Decode(m, pc)
	if err != nil {
		return engine.Instruction{}, err
	}
	memory := i.Dst.Kind == memOperand || i.Src.Kind == memOperand
	switch i.Op {
	case "call", "callind", "push", "pushf", "pop", "ret", "movs", "cmps", "stos", "lods", "scas", "leave":
		memory = true
	case "lea", "nop":
		memory = false
	}
	ins := engine.Instruction{PC: pc, Length: uint8(i.Next - pc), Decoded: i, Memory: memory, InterpretOnly: !supported(i), Flow: engine.Successors{Known: true, Next: i.Next}}
	switch i.Op {
	case "jmp":
		ins.Terminal = true
		ins.Flow.Next = i.Src.Imm
	case "jcc", "loop":
		ins.Terminal = true
		ins.Flow.Next = i.Src.Imm
		ins.Flow.Alternate = i.Next
		ins.Flow.Conditional = true
	case "call":
		ins.Terminal = true
		ins.Flow.Next = i.Src.Imm
	case "callind", "jmpind", "ret", "syscall":
		ins.Terminal = true
		ins.Flow.Known = false
	}
	if legacyString(i.Op) {
		ins.Terminal = true
		if i.Repeat != 0 {
			ins.Flow = engine.Successors{Known: true, Conditional: true, Next: pc, Alternate: i.Next}
		}
	}
	return ins, nil
}
func lower(b *emu.Builder, ins engine.Instruction, completed int) bool {
	return lowerInstruction(b, ins, completed, false)
}
func lowerInstruction(b *emu.Builder, ins engine.Instruction, completed int, system bool, contexts ...*System) bool {
	var pc *System
	if len(contexts) > 0 {
		pc = contexts[0]
	}
	i := ins.Decoded.(Instruction)
	if pc == nil && ((!system && !supported(i)) || (system && !supportedSystem(i))) {
		return false
	}
	l := lowerer{b: b, i: i, pc: pc}
	w := i.Width
	if ins.Memory {
		checkpointPC := i.PC
		if pc != nil {
			checkpointPC += pc.Segments[1].Base
		}
		b.Store(pcSlot, b.Constant(checkpointPC))
		words := stateWords
		if system {
			words = systemStateWords
		}
		if pc != nil {
			words = pcStateWords
		}
		b.Checkpoint(words, completed)
	}
	next := b.Constant(i.Next)
	if (i.Op == "shl" || i.Op == "shr" || i.Op == "sar") && w < 4 || i.Op == "rol" || i.Op == "ror" {
		a := l.read(i.Dst, w)
		n := i.Src.Imm & 31
		if w == 8 {
			n = i.Src.Imm & 63
		}
		width := uint64(w) * 8
		var v, carry, overflow emu.Value
		switch i.Op {
		case "shl":
			v = l.narrow(b.Shift(emu.Shl, a, n), w)
			carry = l.and(b.Shift(emu.Shr, a, width-n), 1)
			overflow = l.bin(emu.Xor, carry, b.Shift(emu.Shr, v, width-1))
		case "shr":
			v = b.Shift(emu.Shr, a, n)
			carry = l.and(b.Shift(emu.Shr, a, n-1), 1)
			overflow = b.Shift(emu.Shr, a, width-1)
		case "sar":
			v = l.narrow(b.VariableShift(emu.ArithmeticShr, l.sign(a, w), b.Constant(n), 64), w)
			carry = l.and(b.Shift(emu.Shr, a, n-1), 1)
			overflow = b.Constant(0)
		case "rol":
			v = l.narrow(l.bin(emu.Or, b.Shift(emu.Shl, a, n), b.Shift(emu.Shr, a, width-n)), w)
			carry = l.and(v, 1)
			overflow = l.bin(emu.Xor, carry, b.Shift(emu.Shr, v, width-1))
		case "ror":
			v = l.narrow(l.bin(emu.Or, b.Shift(emu.Shr, a, n), b.Shift(emu.Shl, a, width-n)), w)
			carry = b.Shift(emu.Shr, v, width-1)
			overflow = l.bin(emu.Xor, carry, l.and(b.Shift(emu.Shr, v, width-2), 1))
		}
		f := carry
		if n == 1 {
			f = l.bin(emu.Or, f, b.Shift(emu.Shl, overflow, 11))
		}
		changed := uint64(arithmeticFlags)
		if i.Op == "rol" || i.Op == "ror" {
			changed = CF | OF
		} else {
			f = l.bin(emu.Or, f, l.szp(v, w))
		}
		b.Store(flagsSlot, l.bin(emu.Or, l.and(b.Load(flagsSlot), ^changed), f))
		l.write(i.Dst, w, v)
		l.storePC(next)
		return true
	}
	switch i.Op {
	case "xchg":
		a, rhs := l.read(i.Dst, w), l.read(i.Src, w)
		l.write(i.Dst, w, rhs)
		l.write(i.Src, w, a)
	case "loop":
		count := l.and(b.Load(RCX), mask(i.AddressWidth))
		take := l.bin(emu.Equal, count, b.Constant(0))
		if i.CC != 3 {
			count = l.and(l.bin(emu.Sub, count, b.Constant(1)), mask(i.AddressWidth))
			if pc != nil {
				b.Store(RCX, l.bin(emu.Or, l.and(b.Load(RCX), ^mask(i.AddressWidth)), count))
			} else {
				b.Store(RCX, count)
			}
			take = l.not(l.bin(emu.Equal, count, b.Constant(0)))
			if i.CC < 2 {
				equal := l.not(l.bin(emu.Equal, l.and(b.Load(flagsSlot), ZF), b.Constant(0)))
				if i.CC == 0 {
					equal = l.not(equal)
				}
				take = l.bin(emu.And, take, equal)
			}
		}
		next = b.Choose(take, b.Constant(i.Src.Imm), next)
	case "leave":
		sp := l.stackPointer(b.Load(RBP))
		value := b.MemoryLoad(l.stackAddress(sp, w, false), int(w))
		l.write(Operand{Kind: regOperand, Reg: RBP}, w, value)
		l.storeSP(l.bin(emu.Add, sp, b.Constant(uint64(w))))
	case "signpair":
		negative := b.Shift(emu.Shr, l.narrow(b.Load(RAX), w), uint64(w)*8-1)
		l.write(Operand{Kind: regOperand, Reg: RDX}, w, b.Choose(negative, b.Constant(mask(w)), b.Constant(0)))
	case "pushseg", "readseg":
		if pc == nil || i.CC >= 6 {
			return false
		}
		value := b.Load(pcSelectorSlot + int(i.CC))
		if i.Op == "readseg" {
			l.write(i.Dst, w, value)
		} else {
			sp := l.stackPointer(l.bin(emu.Sub, b.Load(RSP), b.Constant(uint64(w))))
			b.MemoryStore(l.stackAddress(sp, w, true), value, int(w))
			l.storeSP(sp)
		}
	case "pusha", "popa":
		if pc == nil {
			return false
		}
		l.allRegisters()
	case "movs", "cmps", "stos", "lods", "scas":
		next = l.legacyString(next)
	case "bsf", "bsr":
		value := l.read(i.Src, w)
		nonzero := l.not(l.bin(emu.Equal, value, b.Constant(0)))
		isolated := value
		if i.Op == "bsf" {
			isolated = l.bin(emu.And, value, l.bin(emu.Sub, b.Constant(0), value))
		}
		index := l.bin(emu.Sub, b.Constant(63), b.RichUnary(emu.LeadingZeros, isolated, 64, 0))
		// Zero is architecturally undefined for the destination; our existing
		// interpreter leaves it unchanged, including a dword's upper half.
		if w == 4 {
			b.Store(i.Dst.Reg, b.Choose(nonzero, index, b.Load(i.Dst.Reg)))
		} else {
			l.write(i.Dst, w, b.Choose(nonzero, index, l.read(i.Dst, w)))
		}
		b.Store(flagsSlot, l.bin(emu.Or, l.and(b.Load(flagsSlot), ^ZF), b.Choose(nonzero, b.Constant(0), b.Constant(ZF))))
	case "bswap":
		l.write(i.Dst, w, b.RichUnary(emu.ReverseBytes, l.read(i.Dst, w), int(w)*8, int(w)*8))
	case "shld", "shrd":
		count := b.Constant(uint64(i.CC))
		if i.CC == 255 {
			count = b.Load(RCX)
		}
		countMask := uint64(31)
		if w == 8 {
			countMask = 63
		}
		count = l.and(count, countMask)
		zero := l.bin(emu.Equal, count, b.Constant(0))
		if i.Dst.Kind == memOperand {
			// Checkpoint above restores the original PC/flags and exact prefix
			// before a zero-count instruction replays its read-only path.
			b.Guard(l.not(zero))
		}
		a, rhs := l.read(i.Dst, w), l.read(i.Src, w)
		width := uint64(w) * 8
		complement := l.bin(emu.Sub, b.Constant(width), count)
		var result, carry emu.Value
		if i.Op == "shld" {
			result = l.bin(emu.Or, b.VariableShift(emu.VariableShl, a, count, 64), b.VariableShift(emu.VariableShr, rhs, complement, 64))
			carry = l.and(b.VariableShift(emu.VariableShr, a, complement, 64), 1)
		} else {
			result = l.bin(emu.Or, b.VariableShift(emu.VariableShr, a, count, 64), b.VariableShift(emu.VariableShl, rhs, complement, 64))
			carry = l.and(b.VariableShift(emu.VariableShr, a, l.bin(emu.Sub, count, b.Constant(1)), 64), 1)
		}
		result = l.narrow(result, w)
		if i.Dst.Kind == regOperand && w == 4 {
			b.Store(i.Dst.Reg, b.Choose(zero, b.Load(i.Dst.Reg), result))
		} else {
			l.write(i.Dst, w, b.Choose(zero, a, result))
		}
		overflow := l.and(b.Shift(emu.Shr, l.bin(emu.Xor, a, result), width-1), 1)
		overflow = b.Choose(l.bin(emu.Equal, count, b.Constant(1)), b.Shift(emu.Shl, overflow, 11), b.Constant(0))
		flags := l.bin(emu.Or, l.and(b.Load(flagsSlot), ^arithmeticFlags), l.bin(emu.Or, l.szp(result, w), l.bin(emu.Or, carry, overflow)))
		b.Store(flagsSlot, b.Choose(zero, b.Load(flagsSlot), flags))
	case "cld", "std", "clc", "stc", "cmc":
		flags := b.Load(flagsSlot)
		switch i.Op {
		case "cld":
			flags = l.and(flags, ^FlagDF)
		case "std":
			flags = l.bin(emu.Or, flags, b.Constant(FlagDF))
		case "clc":
			flags = l.and(flags, ^CF)
		case "stc":
			flags = l.bin(emu.Or, flags, b.Constant(CF))
		case "cmc":
			flags = l.bin(emu.Xor, flags, b.Constant(CF))
		}
		b.Store(flagsSlot, flags)
	case "mul", "imul1":
		// Read the source before changing RAX/RDX, including AH and aliases.
		x, y := l.narrow(b.Load(RAX), w), l.read(i.Dst, w)
		signed := i.Op == "imul1"
		if signed {
			x, y = l.sign(x, w), l.sign(y, w)
		}
		product := l.bin(emu.Mul, x, y)
		low := l.narrow(product, w)
		high := l.narrow(b.Shift(emu.Shr, product, uint64(w)*8), w)
		if w == 8 {
			high = b.MultiplyHigh(x, y, signed)
		}
		expected := b.Constant(0)
		if signed {
			expected = l.narrow(b.VariableShift(emu.ArithmeticShr, l.sign(low, w), b.Constant(63), 64), w)
		}
		overflow := l.not(l.bin(emu.Equal, high, expected))
		if w == 1 {
			l.write(Operand{Kind: regOperand, Reg: RAX}, 2, product)
		} else {
			l.write(Operand{Kind: regOperand, Reg: RAX}, w, low)
			l.write(Operand{Kind: regOperand, Reg: RDX}, w, high)
		}
		b.Store(flagsSlot, l.bin(emu.Or, l.and(b.Load(flagsSlot), ^(CF|OF)), l.bin(emu.Mul, overflow, b.Constant(CF|OF))))
	case "nop":
	case "lea":
		o := i.Src
		o.Segment = 0 // LEA ignores segment bases, unlike memory accesses.
		l.write(i.Dst, w, l.address(o))
	case "mov", "movsx", "movzx", "cmov":
		sw := w
		if i.SourceWidth != 0 {
			sw = i.SourceWidth
		}
		v := l.read(i.Src, sw)
		if i.Op == "movsx" {
			v = l.sign(v, sw)
		}
		if i.Op == "cmov" {
			v = b.Choose(l.condition(i.CC), v, l.read(i.Dst, w))
		}
		l.write(i.Dst, w, v)
	case "jmp":
		next = b.Constant(i.Src.Imm)
	case "jcc":
		next = b.Choose(l.condition(i.CC), b.Constant(i.Src.Imm), next)
	case "jmpind":
		next = l.read(i.Dst, l.controlWidth())
	case "call", "callind":
		target := b.Constant(i.Src.Imm)
		if i.Op == "callind" {
			target = l.read(i.Dst, l.controlWidth())
		}
		cw := l.controlWidth()
		sp := l.stackPointer(l.bin(emu.Sub, b.Load(RSP), b.Constant(uint64(cw))))
		b.MemoryStore(l.stackAddress(sp, cw, true), next, int(cw))
		l.storeSP(sp)
		next = target
	case "push", "pushf":
		v := b.Load(flagsSlot)
		if i.Op == "pushf" {
			v = l.bin(emu.Or, v, b.Constant(2))
		} else {
			v = l.read(i.Dst, w)
		}
		sp := l.stackPointer(l.bin(emu.Sub, b.Load(RSP), b.Constant(uint64(w))))
		b.MemoryStore(l.stackAddress(sp, w, true), v, int(w))
		l.storeSP(sp)
	case "pop", "ret":
		sp := l.stackPointer(b.Load(RSP))
		v := b.MemoryLoad(l.stackAddress(sp, w, false), int(w))
		sp = l.bin(emu.Add, sp, b.Constant(uint64(w)))
		if i.Op == "ret" {
			next = v
			sp = l.bin(emu.Add, sp, b.Constant(i.Src.Imm))
			l.storeSP(sp)
		} else {
			// POP computes its memory destination using the post-increment SP, but
			// must not commit SP if that destination faults.
			dst := i.Dst
			if dst.Kind == memOperand && dst.Base == RSP {
				dst.Disp += int64(w)
			}
			if dst.Kind == memOperand {
				l.write(dst, w, v)
				l.storeSP(sp)
			} else {
				l.storeSP(sp)
				l.write(dst, w, v)
			}
		}
	case "bt", "bts", "btr", "btc":
		bit := l.read(i.Src, w)
		var address, value emu.Value
		if i.Dst.Kind == memOperand {
			operand := i.Dst
			segment := operand.Segment
			operand.Segment = 0
			address = l.address(operand)
			if i.Src.Kind != immOperand {
				offset := b.VariableShift(emu.ArithmeticShr, l.sign(bit, w), b.Constant(3), 64)
				offset = l.and(offset, ^uint64(w-1))
				address = l.bin(emu.Add, address, offset)
				if operand.Addr32 {
					address = l.and(address, 0xffffffff)
				}
			}
			if segment == 0x64 {
				address = l.bin(emu.Add, address, b.Load(fsBaseSlot))
			}
			if segment == 0x65 {
				address = l.bin(emu.Add, address, b.Load(gsBaseSlot))
			}
			value = b.MemoryLoad(address, int(w))
		} else {
			value = l.read(i.Dst, w)
		}
		bit = l.and(bit, uint64(w)*8-1)
		carry := l.and(b.VariableShift(emu.VariableShr, value, bit, 64), CF)
		if i.Op != "bt" {
			maskBit := b.VariableShift(emu.VariableShl, b.Constant(1), bit, 64)
			changed := value
			switch i.Op {
			case "bts":
				changed = l.bin(emu.Or, value, maskBit)
			case "btr":
				changed = l.bin(emu.And, value, l.bin(emu.Xor, maskBit, b.Constant(mask(w))))
			case "btc":
				changed = l.bin(emu.Xor, value, maskBit)
			}
			if i.Dst.Kind == memOperand {
				b.MemoryStore(address, changed, int(w))
			} else {
				l.write(i.Dst, w, changed)
			}
		}
		b.Store(flagsSlot, l.bin(emu.Or, l.and(b.Load(flagsSlot), ^CF), carry))
	case "cmpxchg":
		a, rhs := l.read(i.Dst, w), l.read(i.Src, w)
		acc := l.narrow(b.Load(RAX), w)
		equal := l.bin(emu.Equal, acc, a)
		if i.Dst.Kind == memOperand {
			// Only the write-success arm is native. A compare failure exits at
			// the checkpoint and replays exactly this instruction, preserving
			// its read-only architectural path even on a read-only mapping.
			b.Guard(equal)
			l.write(i.Dst, w, rhs)
		} else {
			if w == 4 && i.Dst.Reg < 16 {
				// Compare failure does not write EDX/EBX/etc. It must preserve
				// that destination's upper half, unlike an actual dword write.
				b.Store(i.Dst.Reg, b.Choose(equal, rhs, b.Load(i.Dst.Reg)))
			} else {
				l.write(i.Dst, w, b.Choose(equal, rhs, a))
			}
			// Successful comparison does not write EAX or zero-extend RAX.
			// Use the state AFTER destination writing so AH/AL/RAX overlap is
			// preserved. Only the compare-failure arm replaces accumulator.
			current := b.Load(RAX)
			replacement := a
			if w < 4 {
				replacement = l.bin(emu.Or, l.and(current, ^mask(w)), a)
			}
			b.Store(RAX, b.Choose(equal, current, replacement))
		}
		f := l.arithmetic(acc, a, l.narrow(l.bin(emu.Sub, acc, a), w), w, true)
		b.Store(flagsSlot, l.bin(emu.Or, l.and(b.Load(flagsSlot), ^arithmeticFlags), f))
	case "setcc":
		l.write(i.Dst, 1, l.condition(i.CC))
	default:
		a := l.read(i.Dst, w)
		var rhs emu.Value
		if i.Src.Kind != 0 {
			rhs = l.read(i.Src, w)
		} else {
			rhs = b.Constant(0)
		}
		var v, f emu.Value
		setFlags := true
		write := true
		switch i.Op {
		case "adc", "sbb":
			carry := l.and(b.Load(flagsSlot), CF)
			k := emu.Add
			sub := i.Op == "sbb"
			if sub {
				k = emu.Sub
			}
			v = l.narrow(l.bin(k, l.bin(k, a, rhs), carry), w)
			var carryOut, overflow emu.Value
			if sub {
				carryOut = l.bin(emu.Or, l.bin(emu.Less, a, rhs), l.bin(emu.And, carry, l.bin(emu.Equal, a, rhs)))
				overflow = l.bin(emu.And, l.bin(emu.Xor, a, rhs), l.bin(emu.Xor, a, v))
			} else {
				carryOut = l.bin(emu.Or, l.bin(emu.Less, v, a), l.bin(emu.And, carry, l.bin(emu.Equal, v, a)))
				overflow = l.bin(emu.And, l.bin(emu.Xor, l.bin(emu.Xor, a, rhs), b.Constant(mask(w))), l.bin(emu.Xor, a, v))
			}
			overflow = b.Shift(emu.Shl, l.and(b.Shift(emu.Shr, overflow, uint64(w)*8-1), 1), 11)
			aux := l.and(l.bin(emu.Xor, l.bin(emu.Xor, a, rhs), v), AF)
			f = l.bin(emu.Or, l.szp(v, w), l.bin(emu.Or, carryOut, l.bin(emu.Or, aux, overflow)))
		case "add", "sub", "cmp", "inc", "dec", "neg":
			sub := i.Op == "sub" || i.Op == "cmp" || i.Op == "dec" || i.Op == "neg"
			if i.Op == "inc" || i.Op == "dec" {
				rhs = b.Constant(1)
			}
			if i.Op == "neg" {
				rhs = a
				a = b.Constant(0)
			}
			k := emu.Add
			if sub {
				k = emu.Sub
			}
			v = l.narrow(l.bin(k, a, rhs), w)
			f = l.arithmetic(a, rhs, v, w, sub)
			if i.Op == "inc" || i.Op == "dec" {
				f = l.bin(emu.Or, l.and(f, ^CF), l.and(b.Load(flagsSlot), CF))
			}
			write = i.Op != "cmp"
		case "and", "or", "xor", "test":
			k := emu.And
			if i.Op == "or" {
				k = emu.Or
			}
			if i.Op == "xor" {
				k = emu.Xor
			}
			v = l.bin(k, a, rhs)
			f = l.szp(v, w)
			write = i.Op != "test"
		case "not":
			v = l.bin(emu.Xor, a, b.Constant(mask(w)))
			setFlags = false
		case "imul", "imul3":
			if i.Op == "imul3" {
				a = rhs
				rhs = b.Constant(i.Dst.Imm & mask(w))
			}
			x, y := l.sign(a, w), l.sign(rhs, w)
			full := l.bin(emu.Mul, x, y)
			v = l.narrow(full, w)
			var overflow emu.Value
			if w == 8 {
				hi := b.MultiplyHigh(x, y, true)
				sign := b.VariableShift(emu.ArithmeticShr, v, b.Constant(63), 64)
				overflow = l.not(l.bin(emu.Equal, hi, sign))
			} else {
				overflow = l.not(l.bin(emu.Equal, full, l.sign(v, w)))
			}
			f = l.bin(emu.Or, l.and(b.Load(flagsSlot), ^(CF|OF)), l.bin(emu.Mul, overflow, b.Constant(CF|OF)))
		case "shl", "shr", "sar":
			width := int(w) * 8
			count := l.and(rhs, uint64(width-1))
			kind := emu.VariableShl
			if i.Op == "shr" {
				kind = emu.VariableShr
			}
			if i.Op == "sar" {
				kind = emu.ArithmeticShr
			}
			v = b.VariableShift(kind, a, count, width)
			var carry, overflow emu.Value
			if i.Op == "shl" {
				carry = l.and(b.VariableShift(emu.VariableShr, a, l.bin(emu.Sub, b.Constant(uint64(width)), count), width), 1)
				overflow = l.bin(emu.Xor, carry, b.Shift(emu.Shr, v, uint64(width-1)))
			} else {
				carry = l.and(b.VariableShift(emu.VariableShr, a, l.bin(emu.Sub, count, b.Constant(1)), width), 1)
				overflow = b.Constant(0)
				if i.Op == "shr" {
					overflow = b.Shift(emu.Shr, a, uint64(width-1))
				}
			}
			overflow = b.Choose(l.bin(emu.Equal, count, b.Constant(1)), b.Shift(emu.Shl, overflow, 11), b.Constant(0))
			f = l.bin(emu.Or, l.szp(v, w), l.bin(emu.Or, carry, overflow))
			f = l.bin(emu.Or, l.and(b.Load(flagsSlot), ^arithmeticFlags), f)
			f = b.Choose(l.bin(emu.Equal, count, b.Constant(0)), b.Load(flagsSlot), f)
			// A zero count preserves all destination bits, including a 32-bit
			// register's upper half. Avoid the unconditional zero-extension write.
			if i.Dst.Kind == regOperand && w == 4 {
				b.Store(i.Dst.Reg, b.Choose(l.bin(emu.Equal, count, b.Constant(0)), b.Load(i.Dst.Reg), v))
				write = false
			}
		}
		if setFlags {
			if i.Op != "imul" && i.Op != "imul3" && i.Op != "shl" && i.Op != "shr" && i.Op != "sar" {
				f = l.bin(emu.Or, l.and(b.Load(flagsSlot), ^arithmeticFlags), f)
			}
			b.Store(flagsSlot, f)
		}
		if write {
			l.write(i.Dst, w, v)
		}
	}
	l.storePC(next)

	return true
}

type lowerer struct {
	b  *emu.Builder
	i  Instruction
	pc *System
}

func (l lowerer) bin(k int, a, b emu.Value) emu.Value { return l.b.Binary(k, a, b) }
func (l lowerer) and(v emu.Value, m uint64) emu.Value { return l.bin(emu.And, v, l.b.Constant(m)) }
func (l lowerer) not(v emu.Value) emu.Value           { return l.bin(emu.Xor, v, l.b.Constant(1)) }
func (l lowerer) narrow(v emu.Value, w uint8) emu.Value {
	if w == 8 {
		return v
	}
	return l.and(v, mask(w))
}
func (l lowerer) sign(v emu.Value, w uint8) emu.Value {
	if w == 8 {
		return v
	}
	// Use the canonical sign-extension expression recognized by the shared
	// emitter, including signed-load fusion. Narrow first: callers may pass
	// a full register rather than an already truncated memory value.
	sign := l.b.Constant(uint64(1) << (8*w - 1))
	return l.bin(emu.Sub, l.bin(emu.Xor, l.narrow(v, w), sign), sign)
}
func (l lowerer) address(o Operand) emu.Value {
	a := l.b.Constant(uint64(o.Disp))
	if o.RIP {
		a = l.bin(emu.Add, a, l.b.Constant(l.i.Next))
	}
	if o.Base >= 0 {
		a = l.bin(emu.Add, a, l.b.Load(o.Base))
	}
	if o.Index >= 0 {
		a = l.bin(emu.Add, a, l.b.Shift(emu.Shl, l.b.Load(o.Index), uint64(o.Scale)))
	}
	if o.Addr32 {
		a = l.and(a, 0xffffffff)
	}
	if o.Addr16 {
		a = l.and(a, 65535)
	}
	// Address-size truncation precedes segment-base addition. The machine's
	// memory transform still checks canonicality, permissions and aliases.
	if o.Segment == 0x64 {
		a = l.bin(emu.Add, a, l.b.Load(fsBaseSlot))
	}
	if o.Segment == 0x65 {
		a = l.bin(emu.Add, a, l.b.Load(gsBaseSlot))
	}
	return a
}
func (l lowerer) read(o Operand, w uint8) emu.Value {
	if o.Kind == immOperand {
		return l.b.Constant(o.Imm & mask(w))
	}
	if o.Kind == memOperand {
		return l.b.MemoryLoad(l.memoryAddress(o, w, false), int(w))
	}
	if o.Reg >= 16 {
		return l.and(l.b.Shift(emu.Shr, l.b.Load(o.Reg-16), 8), 255)
	}
	return l.narrow(l.b.Load(o.Reg), w)
}
func (l lowerer) write(o Operand, w uint8, v emu.Value) {
	if o.Kind == memOperand {
		l.b.MemoryStore(l.memoryAddress(o, w, true), v, int(w))
		return
	}
	v = l.narrow(v, w)
	if o.Reg >= 16 {
		r := o.Reg - 16
		l.b.Store(r, l.bin(emu.Or, l.and(l.b.Load(r), ^uint64(0xff00)), l.b.Shift(emu.Shl, v, 8)))
		return
	}
	if w < 4 {
		v = l.bin(emu.Or, l.and(l.b.Load(o.Reg), ^mask(w)), v)
	}
	l.b.Store(o.Reg, v)
}
func (l lowerer) szp(v emu.Value, w uint8) emu.Value {
	return l.b.StatusBits(v, int(w)*8)
}
func (l lowerer) arithmetic(a, b, v emu.Value, w uint8, sub bool) emu.Value {
	return l.b.ArithmeticStatus(a, b, int(w)*8, sub)
}
func (l lowerer) condition(cc uint8) emu.Value {
	f := l.b.Load(flagsSlot)
	bit := func(n uint64) emu.Value { return l.and(l.b.Shift(emu.Shr, f, n), 1) }
	var v emu.Value
	switch cc >> 1 {
	case 0:
		v = bit(11)
	case 1:
		v = bit(0)
	case 2:
		v = bit(6)
	case 3:
		v = l.bin(emu.Or, bit(0), bit(6))
	case 4:
		v = bit(7)
	case 5:
		v = bit(2)
	case 6:
		v = l.bin(emu.Xor, bit(7), bit(11))
	case 7:
		v = l.bin(emu.Or, bit(6), l.bin(emu.Xor, bit(7), bit(11)))
	}
	if cc&1 != 0 {
		v = l.not(v)
	}
	return v
}

-- bit_memory_native_test.go --
package x86

import (
	"renvo.dev/internal/rfe/engine"
	"renvo.dev/internal/rfe/linuxuser"
	"testing"
)

func TestNativeBitMemorySignedIndexAndWriteFault(t *testing.T) {
	for _, op := range []byte{0xa3, 0xab, 0xb3, 0xbb} {
		code := []byte{0x48, 0x0f, op, 0x0b}
		expected, actual := testCPU(t, code), testCPU(t, code)
		for _, c := range []*CPU{expected, actual} {
			if err := c.Memory.(*linuxuser.Memory).Map(0x3000, 3*4096, 3); err != nil {
				t.Fatal(err)
			}
		}
		cfg := engine.DefaultEngineConfig()
		cfg.NativeThreshold, cfg.IRThreshold, cfg.MaxInstructions, cfg.MaxRegionInstructions = 1, 1, 1, 1
		e, err := engine.New(cfg, Architecture())
		if err != nil {
			t.Fatal(err)
		}
		adapter := NewAdapter(actual)
		for _, index := range []int64{-65, -64, -63, -1, 0, 1, 63, 64, 65} {
			for attempt := 0; attempt < 2; attempt++ {
				address := uint64(int64(0x4000) + (index>>3)&^7)
				for _, c := range []*CPU{expected, actual} {
					if err := c.Memory.Write(address, 8, 0xa5a5a5a5a5a5a5a5); err != nil {
						t.Fatal(err)
					}
					c.PC, c.Flags, c.R[RBX], c.R[RCX] = 0x1000, 0x6d6, 0x4000, uint64(index)
				}
				adapter.Import()
				if err := expected.Step(); err != nil {
					t.Fatal(err)
				}
				if err := e.Step(adapter, 1); err != nil {
					t.Fatal(err)
				}
				adapter.Export()
				a, _ := actual.Memory.Read(address, 8, false)
				b, _ := expected.Memory.Read(address, 8, false)
				if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != expected.Retired || a != b {
					t.Fatal("signed bit memory differs", op, index, a, b)
				}
			}
		}
		if e.Stats.NativeMemory == 0 {
			t.Fatal("bit memory never native")
		}
		if op != 0xa3 {
			for _, c := range []*CPU{expected, actual} {
				c.PC, c.Flags, c.R[RBX], c.R[RCX] = 0x1000, 0x602, 0x4000, 0
				if err := c.Memory.(*linuxuser.Memory).Protect(0x4000, 4096, 1); err != nil {
					t.Fatal(err)
				}
			}
			adapter.Import()
			before := actual.Retired
			if expected.Step() == nil || e.Step(adapter, 1) == nil {
				t.Fatal("missing bit store fault")
			}
			adapter.Export()
			if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != before || expected.Retired != before {
				t.Fatal("bit store fault changed architectural progress/flags")
			}
		}
		if err := e.Close(); err != nil {
			t.Fatal(err)
		}
	}
}
func TestNativeBitAddress32Wrap(t *testing.T) {
	code := []byte{0x67, 0x48, 0x0f, 0xab, 0x0b}
	expected, actual := testCPU(t, code), testCPU(t, code)
	cfg := engine.DefaultEngineConfig()
	cfg.NativeThreshold, cfg.IRThreshold, cfg.MaxInstructions, cfg.MaxRegionInstructions = 1, 1, 1, 1
	e, err := engine.New(cfg, Architecture())
	if err != nil {
		t.Fatal(err)
	}
	defer e.Close()
	adapter := NewAdapter(actual)
	for _, c := range []*CPU{expected, actual} {
		if err := c.Memory.(*linuxuser.Memory).Map(0, 4096, 3); err != nil {
			t.Fatal(err)
		}
	}
	for attempt := 0; attempt < 3; attempt++ {
		for _, c := range []*CPU{expected, actual} {
			c.PC, c.R[RBX], c.R[RCX] = 0x1000, 0xfffffff8, 64
		}
		adapter.Import()
		if err := expected.Step(); err != nil {
			t.Fatal(err)
		}
		if err := e.Step(adapter, 1); err != nil {
			t.Fatal(err)
		}
		adapter.Export()
		a, _ := actual.Memory.Read(0, 8, false)
		b, _ := expected.Memory.Read(0, 8, false)
		if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || a != b || a != 1 {
			t.Fatal("address32 bit displacement did not wrap", a, b)
		}
	}
	if e.Stats.NativeMemory == 0 {
		t.Fatal("address32 bit memory never native")
	}
}

-- bitops_native_test.go --
package x86

import (
	"renvo.dev/internal/rfe/engine"
	"renvo.dev/internal/rfe/linuxuser"
	"testing"
)

func TestNativeBitScanSwapAndDoubleShift(t *testing.T) {
	var codes [][]byte
	for _, prefix := range [][]byte{nil, {0x66}, {0x48}} {
		for _, opcode := range []byte{0xbc, 0xbd} {
			for _, modrm := range []byte{0xc3, 0xc0, 0xcb} {
				code := append(append([]byte{}, prefix...), 0x0f, opcode, modrm)
				codes = append(codes, code)
			}
		}
		for _, opcode := range []byte{0xa4, 0xac} {
			for _, count := range []byte{0, 1, 15, 16, 31, 32, 63, 64, 255} {
				codes = append(codes, append(append([]byte{}, prefix...), 0x0f, opcode, 0xd8, count))
			}
		}
		for _, opcode := range []byte{0xa5, 0xad} {
			for _, modrm := range []byte{0xd8, 0xc0, 0xc8, 0xd9} {
				codes = append(codes, append(append([]byte{}, prefix...), 0x0f, opcode, modrm))
			}
		}
	}
	codes = append(codes, []byte{0x0f, 0xc8}, []byte{0x48, 0x0f, 0xc8}, []byte{0x49, 0x0f, 0xc9})
	values := []uint64{0, 1, 2, 0x7fff, 0x8000, 0xffff, 0x7fffffff, 0x80000000, 0xffffffff, 0x7fffffffffffffff, 0x8000000000000000, 0x0123456789abcdef, ^uint64(0)}
	counts := []uint64{0, 1, 15, 16, 31, 32, 63, 64, 127, ^uint64(0)}
	for _, mode := range []string{"ir", "native"} {
		for _, code := range codes {
			base := testCPU(t, code)
			ins, err := Decode(base.Memory, base.PC)
			if err != nil {
				t.Fatal(err)
			}
			cfg := engine.DefaultEngineConfig()
			cfg.Mode, cfg.IRThreshold, cfg.NativeThreshold, cfg.MaxInstructions, cfg.MaxRegionInstructions = mode, 1, 1, 1, 1
			e, err := engine.New(cfg, Architecture())
			if err != nil {
				t.Fatal(err)
			}
			for index, value := range values {
				for _, count := range counts {
					expected := *base
					expected.R[RAX], expected.R[RBX], expected.R[RCX], expected.R[9] = value, values[len(values)-1-index], count, value
					expected.Flags = 2 | FlagIF | FlagDF | arithmeticFlags
					actual := expected
					adapter := NewAdapter(&actual)
					if err := expected.Step(); err != nil {
						t.Fatal(err)
					}
					if err := e.Step(adapter, 1); err != nil {
						t.Fatal(err)
					}
					adapter.Export()
					if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != expected.Retired {
						t.Fatalf("%s %x value=%x count=%x R=%x/%x flags=%x/%x PC=%x/%x", mode, code, value, count, actual.R, expected.R, actual.Flags, expected.Flags, actual.PC, expected.PC)
					}
				}
			}
			if supported(ins) && mode == "native" && e.NativeAvailable() && e.Stats.Native == 0 {
				t.Fatal("supported bit operation never native", code, e.Stats)
			}
			if err := e.Close(); err != nil {
				t.Fatal(err)
			}
		}
	}
}

func TestNativeDoubleShiftAndScanPreciseMemory(t *testing.T) {
	for _, op := range []byte{0xa5, 0xad, 0xbc, 0xbd} {
		modrm := byte(0x13) // SHLD/SHRD [RBX],RDX,CL
		if op == 0xbc || op == 0xbd {
			modrm = 0x03
		} // BSF/BSR RAX,[RBX]
		code := []byte{0x48, 0xff, 0xc7, 0x48, 0x0f, op, modrm, 0xeb, 0xf7}
		expected, actual := testCPU(t, code), testCPU(t, code)
		for _, c := range []*CPU{expected, actual} {
			if err := c.Memory.(*linuxuser.Memory).Map(0x4000, 8192, 3); err != nil {
				t.Fatal(err)
			}
			if err := c.Memory.Write(0x4800, 8, 0x123456789abcdef0); err != nil {
				t.Fatal(err)
			}
			c.R[RBX], c.R[RCX], c.R[RDX] = 0x4800, 3, 0xfedcba9876543210
			c.Flags = 2 | FlagIF | FlagDF | arithmeticFlags
		}
		cfg := engine.DefaultEngineConfig()
		cfg.IRThreshold, cfg.NativeThreshold = 1, 1
		e, err := engine.New(cfg, Architecture())
		if err != nil {
			t.Fatal(err)
		}
		adapter := NewAdapter(actual)
		for n := 0; n < 192; n++ {
			if err := expected.Step(); err != nil {
				t.Fatal(err)
			}
		}
		for actual.Retired < 192 {
			if err := e.RunQuanta(adapter, 192-actual.Retired); err != nil {
				t.Fatal(err)
			}
			adapter.Export()
		}
		if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != expected.Retired {
			t.Fatal("warmed native bit memory state differs")
		}
		if e.NativeAvailable() && e.Stats.NativeMemory == 0 {
			t.Fatal("bit memory operation never native", e.Stats)
		}
		for _, count := range []uint64{0, 1, 63, 64} {
			for _, c := range []*CPU{expected, actual} {
				c.PC, c.R[RCX] = 0x1000, count
				if err := c.Memory.(*linuxuser.Memory).Protect(0x4000, 8192, 1); err != nil {
					t.Fatal(err)
				}
			}
			adapter.Import()
			if err := expected.Step(); err != nil {
				t.Fatal(err)
			}
			expectedErr := expected.Step()
			var actualErr error
			goal := actual.Retired + 2
			for actual.Retired < goal {
				actualErr = e.RunQuanta(adapter, goal-actual.Retired)
				adapter.Export()
				if actualErr != nil {
					break
				}
			}
			if (expectedErr != nil) != (actualErr != nil) || actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != expected.Retired {
				t.Fatalf("op=%x count=%d protection differs errors=%v/%v R=%x/%x flags=%x/%x PC=%x/%x retired=%d/%d", op, count, actualErr, expectedErr, actual.R, expected.R, actual.Flags, expected.Flags, actual.PC, expected.PC, actual.Retired, expected.Retired)
			}
			got, _ := actual.Memory.Read(0x4800, 8, false)
			want, _ := expected.Memory.Read(0x4800, 8, false)
			if got != want {
				t.Fatal("protected value changed", got, want)
			}
		}
		// Scan loads on a permissionless mapping must also stop precisely
		// after the preceding INC, without committing ZF or destination.
		if op == 0xbc || op == 0xbd {
			for _, c := range []*CPU{expected, actual} {
				c.PC = 0x1000
				if err := c.Memory.(*linuxuser.Memory).Protect(0x4000, 8192, 0); err != nil {
					t.Fatal(err)
				}
			}
			adapter.Import()
			if err := expected.Step(); err != nil {
				t.Fatal(err)
			}
			if err := expected.Step(); err == nil {
				t.Fatal("scan should fault")
			}
			goal := actual.Retired + 2
			var fault error
			for actual.Retired < goal {
				fault = e.RunQuanta(adapter, goal-actual.Retired)
				adapter.Export()
				if fault != nil {
					break
				}
			}
			if fault == nil {
				t.Fatal("native scan bypassed permission")
			}
			if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != expected.Retired {
				t.Fatal("scan lost precise checkpoint")
			}
		}
		if err := e.Close(); err != nil {
			t.Fatal(err)
		}
	}
}

-- cached_system_boundary_test.go --
package x86

import (
	"bytes"
	"testing"
)

func TestCheckedCachedSystemInstructionBoundaryMatchesStep(t *testing.T) {
	cases := []struct {
		code     []byte
		cpl      uint8
		rcx, rbx uint64
		halted   bool
	}{
		{[]byte{0xfa}, 0, 0, 1, false}, {[]byte{0xfb}, 0, 0, 1, false},
		{[]byte{0xfa}, 3, 0, 1, false}, {[]byte{0xf4}, 3, 0, 1, false},
		{[]byte{0x0f, 0x32}, 0, 0xc0000101, 1, false}, {[]byte{0x0f, 0x32}, 0, 0xfeed, 1, false},
		{[]byte{0x0f, 0x01, 0xf8}, 0, 0, 1, false}, {[]byte{0x0f, 0x01, 0xf8}, 3, 0, 1, false},
		{[]byte{0x48, 0xf7, 0xf3}, 0, 0, 0, false}, {[]byte{0x48, 0x8b, 0x03}, 0, 0, 0x300000, false},
		{[]byte{0x90}, 0, 0, 1, true},
	}
	for _, item := range cases {
		var cpus [2]*CPU
		var memories [2]*systemRAM
		for n := range cpus {
			m := newSystemRAM()
			c := &CPU{PC: 0x5000, Flags: 0x202}
			c.R[RSP], c.R[RAX], c.R[RDX], c.R[RCX], c.R[RBX] = 0x7000, 123, 0, item.rcx, item.rbx
			s := NewSystem(c, m, nil)
			s.EFER = 1 << 10
			s.CPL, s.IRQShadow, s.Halted, s.TSC = item.cpl, 2, item.halted, ^uint64(0)-40
			s.GDTR = Table{Base: 0x1000, Limit: 39}
			s.IDTR = Table{Base: 0x2000, Limit: 4095}
			s.TR = Segment{Base: 0x3000, Limit: 103}
			s.Segments[1].Selector, s.Segments[2].Selector = 0x1b, 0x23
			s.GSBase, s.KernelGSBase = 0x12345678, 0x87654321
			for a, value := range map[uint64]uint64{0x1008: 0x00af9a000000ffff, 0x1010: 0x00cf92000000ffff, 0x1018: 0x00affa000000ffff, 0x1020: 0x00cff2000000ffff, 0x3004: 0x9000, 0x2000: 0x00008e0000084000, 0x20d0: 0x00008e0000084000, 0x20e0: 0x00008e0000084000} {
				if err := m.Write(a, 8, value); err != nil {
					t.Fatal(err)
				}
			}
			copy(m.data[0x5000:], item.code)
			cpus[n], memories[n] = c, m
		}
		ins, err := Decode(cpus[1].Memory, cpus[1].PC)
		if err != nil {
			t.Fatal(err)
		}
		expectedErr := cpus[0].Step()
		actualErr := cpus[1].ExecuteCachedInstruction(ins)
		a, b := cpus[0], cpus[1]
		x, y := a.System, b.System
		if (expectedErr != nil) != (actualErr != nil) || a.R != b.R || a.Flags != b.Flags || a.PC != b.PC || a.Retired != b.Retired || x.TSC != y.TSC || x.IRQShadow != y.IRQShadow || x.CPL != y.CPL || x.Halted != y.Halted || x.GSBase != y.GSBase || x.KernelGSBase != y.KernelGSBase || x.CR != y.CR || x.Segments != y.Segments || !bytes.Equal(memories[0].data, memories[1].data) {
			t.Fatalf("cached system boundary differs code=%x cpl=%d errors=%v/%v PC=%x/%x TSC=%x/%x shadow=%d/%d", item.code, item.cpl, expectedErr, actualErr, a.PC, b.PC, x.TSC, y.TSC, x.IRQShadow, y.IRQShadow)
		}
	}
}

-- carry_native_test.go --
package x86

import (
	"renvo.dev/internal/rfe/engine"
	"renvo.dev/internal/rfe/linuxuser"
	"testing"
)

func TestCarryCompareExchangeAndBitsNativeAndIRAllWidthsFlags(t *testing.T) {
	codes := [][]byte{{0x10, 0xd8}, {0x18, 0xd8}, {0x66, 0x11, 0xd8}, {0x66, 0x19, 0xd8},
		{0x11, 0xd8}, {0x19, 0xd8}, {0x48, 0x11, 0xd8}, {0x48, 0x19, 0xd8},
		{0x10, 0xdc}, {0x18, 0xdc}, {0x83, 0xd0, 0xff}, {0x48, 0x83, 0xd8, 0xff},
		{0x0f, 0xb0, 0xcb}, {0x66, 0x0f, 0xb1, 0xcb}, {0x0f, 0xb1, 0xcb}, {0x48, 0x0f, 0xb1, 0xcb},
		{0x0f, 0xb0, 0xdc}, {0x0f, 0xb0, 0xd8}, {0x0f, 0xb1, 0xd8}, {0x48, 0x0f, 0xb1, 0xd8}}
	for _, prefix := range [][]byte{nil, {0x66}, {0x48}} {
		for _, op := range []byte{0xa3, 0xab, 0xb3, 0xbb} {
			codes = append(codes, append(append([]byte{}, prefix...), 0x0f, op, 0xd8))
		}
	}
	values := []uint64{0, 1, 15, 16, 0x7f, 0x80, 0xff, 0x7fff, 0x8000, 0xffff, 0x7fffffff, 0x80000000, 0xffffffff, 0x7fffffffffffffff, 0x8000000000000000, ^uint64(0)}
	for _, mode := range []string{"ir", "native"} {
		for _, code := range codes {
			base := testCPU(t, code)
			cfg := engine.DefaultEngineConfig()
			cfg.Mode, cfg.IRThreshold, cfg.NativeThreshold, cfg.MaxInstructions = mode, 1, 1, 1
			cfg.MaxRegionInstructions = 1
			e, err := engine.New(cfg, Architecture())
			if err != nil {
				t.Fatal(err)
			}
			for _, a := range values {
				for _, rhs := range values {
					for carry := uint64(0); carry < 2; carry++ {
						expected := *base
						expected.R[RAX], expected.R[RBX], expected.R[RCX] = a, rhs, 0x8877665544332211
						expected.Flags = 2 | 0x200 | 0x400 | arithmeticFlags&^CF | carry
						actual := expected
						adapter := NewAdapter(&actual)
						if err := expected.Step(); err != nil {
							t.Fatal(err)
						}
						if err := e.Step(adapter, 1); err != nil {
							t.Fatal(err)
						}
						adapter.Export()
						if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != expected.Retired {
							t.Fatalf("%s code=%x a=%x b=%x carry=%d R=%x/%x flags=%x/%x", mode, code, a, rhs, carry, actual.R, expected.R, actual.Flags, expected.Flags)
						}
					}
				}
			}
			if e.Stats.Native+e.Stats.IR < 512 {
				t.Fatal("carry arithmetic fell back to interpreter")
			}
			if err := e.Close(); err != nil {
				t.Fatal(err)
			}
		}
	}
}
func TestCarryNativeMemoryPreciseWriteFault(t *testing.T) {
	for _, op := range []byte{0x11, 0x19} {
		code := []byte{0x48, op, 0x03, 0xeb, 0xfb}
		expected, actual := testCPU(t, code), testCPU(t, code)
		for _, c := range []*CPU{expected, actual} {
			mem := c.Memory.(*linuxuser.Memory)
			if err := mem.Map(0x3000, 4096, 3); err != nil {
				t.Fatal(err)
			}
			if err := mem.Write(0x3000, 8, ^uint64(0)); err != nil {
				t.Fatal(err)
			}
			c.R[RBX], c.R[RAX], c.Flags = 0x3000, 0x7fffffffffffffff, 3
		}
		cfg := engine.DefaultEngineConfig()
		cfg.NativeThreshold, cfg.IRThreshold = 1, 1
		e, err := engine.New(cfg, Architecture())
		if err != nil {
			t.Fatal(err)
		}
		adapter := NewAdapter(actual)
		for _, budget := range []uint64{4096, 1, 2, 3, 63, 65} {
			end := actual.Retired + budget
			for expected.Retired < end {
				if err := expected.Step(); err != nil {
					t.Fatal(err)
				}
			}
			for actual.Retired < end {
				if err := e.RunQuanta(adapter, end-actual.Retired); err != nil {
					t.Fatal(err)
				}
				adapter.Export()
			}
			a, _ := actual.Memory.Read(0x3000, 8, false)
			b, _ := expected.Memory.Read(0x3000, 8, false)
			if actual.R != expected.R || actual.PC != expected.PC || actual.Flags != expected.Flags || a != b {
				t.Fatal("carry memory/budget differs")
			}
		}
		if e.Stats.NativeMemory == 0 {
			t.Fatal("carry RMW never native")
		}
		// Revoke write while leaving read permitted, after warming native RMW.
		for _, c := range []*CPU{expected, actual} {
			if err := c.Memory.(*linuxuser.Memory).Protect(0x3000, 4096, 1); err != nil {
				t.Fatal(err)
			}
			c.PC = 0x1000
		}
		adapter.Import()
		before := actual.Retired
		if expected.Step() == nil || e.RunQuanta(adapter, 64) == nil {
			t.Fatal("missing carry store fault")
		}
		adapter.Export()
		if actual.R != expected.R || actual.PC != expected.PC || actual.Flags != expected.Flags || actual.Retired != before || expected.Retired != before {
			t.Fatal("carry fault committed partial flags or progress")
		}
		if err := e.Close(); err != nil {
			t.Fatal(err)
		}
	}
}

-- cmpxchg_memory_native_test.go --
package x86

import (
	"renvo.dev/internal/rfe/engine"
	"renvo.dev/internal/rfe/linuxuser"
	"testing"
)

func TestCompareExchangeNativeMemoryMatchMismatchAndWritePermission(t *testing.T) {
	for _, width := range []uint8{1, 2, 4, 8} {
		code := []byte{}
		if width == 2 {
			code = append(code, 0x66)
		}
		if width == 8 {
			code = append(code, 0x48)
		}
		opcode := byte(0xb1)
		if width == 1 {
			opcode = 0xb0
		}
		code = append(code, 0x0f, opcode, 0x0b)
		code = append(code, 0xeb, byte(256-len(code)-2))
		expected, actual := testCPU(t, code), testCPU(t, code)
		for _, c := range []*CPU{expected, actual} {
			mem := c.Memory.(*linuxuser.Memory)
			if err := mem.Map(0x3000, 4096, 3); err != nil {
				t.Fatal(err)
			}
			if err := mem.Write(0x3000, int(width), 0x7f); err != nil {
				t.Fatal(err)
			}
			c.R[RBX], c.R[RCX], c.R[RAX], c.Flags = 0x3000, 0x8877665544332211, 0x7f, 0x602
		}
		cfg := engine.DefaultEngineConfig()
		cfg.NativeThreshold, cfg.IRThreshold = 1, 1
		e, err := engine.New(cfg, Architecture())
		if err != nil {
			t.Fatal(err)
		}
		adapter := NewAdapter(actual)
		for _, budget := range []uint64{4096, 1, 2, 3, 63, 65} {
			end := actual.Retired + budget
			for expected.Retired < end {
				if err := expected.Step(); err != nil {
					t.Fatal(err)
				}
			}
			for actual.Retired < end {
				if err := e.RunQuanta(adapter, end-actual.Retired); err != nil {
					t.Fatal(err)
				}
				adapter.Export()
			}
			a, _ := actual.Memory.Read(0x3000, int(width), false)
			b, _ := expected.Memory.Read(0x3000, int(width), false)
			if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || a != b || actual.Retired != expected.Retired {
				t.Fatalf("CMPXCHG width%d budget%d differs", width, budget)
			}
		}
		if e.Stats.NativeMemory == 0 {
			t.Fatal("CMPXCHG success arm never native")
		}
		for _, match := range []bool{true, false} {
			for _, c := range []*CPU{expected, actual} {
				if err := c.Memory.(*linuxuser.Memory).Protect(0x3000, 4096, 1); err != nil {
					t.Fatal(err)
				}
				value, _ := c.Memory.Read(0x3000, int(width), false)
				c.PC = 0x1000
				c.R[RAX] = value
				if !match {
					c.R[RAX] ^= 1
				}
			}
			adapter.Import()
			before := actual.Retired
			refErr := expected.Step()
			nativeErr := e.RunQuanta(adapter, 64)
			adapter.Export()
			if (refErr != nil) != match || (nativeErr != nil) != match {
				t.Fatal("compare mismatch invented a write fault, or match missed it", width, match, refErr, nativeErr)
			}
			if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != expected.Retired {
				t.Fatal("compare-exchange read-only path changed state", width, match)
			}
			if match && actual.Retired != before {
				t.Fatal("failed compare-exchange store retired")
			}
		}
		if err := e.Close(); err != nil {
			t.Fatal(err)
		}
	}
}

-- control_mapping_test.go --
package x86

import "testing"

type controlFlushRAM struct {
	*pcFetchRAM
	flushes, switches int
}

func (m *controlFlushRAM) InvalidateMappings() { m.flushes++ }
func (m *controlFlushRAM) SwitchAddressSpace() { m.switches++ }
func TestControlRegisterOnlyMappingChangesFlushTranslations(t *testing.T) {
	m := &controlFlushRAM{pcFetchRAM: &pcFetchRAM{data: make([]byte, 1<<20)}}
	c := &CPU{PC: 0x1000, Flags: 2}
	s := NewPCSystem(c, m, nil)
	s.CR[0] = 0x11
	write := func(index byte, value uint64) {
		copy(m.data[0x1000:], []byte{0x0f, 0x22, 0xc0 | index<<3})
		c.PC = 0x1000
		i, e := DecodeMode(m, 0x1000, 16)
		if e != nil {
			t.Fatal(e)
		}
		c.R[RAX] = value
		if e = c.ExecuteCachedInstruction(i); e != nil {
			t.Fatal(e)
		}
	}
	for _, value := range []uint64{0x19, 0x11, 0x15, 0x13, 0x11} {
		write(0, value)
	}
	write(2, 0xdead)
	if m.flushes != 0 {
		t.Fatal("FPU task state or CR2 discarded translations", m.flushes)
	}
	write(0, 0x10011)
	write(0, 0x10010)
	write(4, 16)
	if m.flushes != 3 {
		t.Fatal("mapping/permission control change retained stale translations", m.flushes)
	}
	write(3, 0x3000)
	write(3, 0x3000)
	if m.switches != 2 {
		t.Fatal("architectural CR3 writes were treated as no-ops", m.switches)
	}
}

-- cpu.go --
package x86

import (
	"fmt"
	"math/bits"
	"renvo.dev/internal/rfe/engine"
)

type Memory = engine.Memory

const (
	RAX = 0
	RCX = 1
	RDX = 2
	RBX = 3
	RSP = 4
	RBP = 5
	RSI = 6
	RDI = 7
)
const (
	CF uint64 = 1
	PF uint64 = 4
	AF uint64 = 16
	ZF uint64 = 64
	SF uint64 = 128
	OF uint64 = 2048
)
const arithmeticFlags = CF | PF | AF | ZF | SF | OF

// TSCTicksPerInstruction defines the shared deterministic system clock scale.
const TSCTicksPerInstruction = 100

var Syscall = fmt.Errorf("x86-64 syscall")

type CPU struct {
	R                    [16]uint64
	PC, Flags, Retired   uint64
	Memory               Memory
	System               *System
	XMM                  [16][16]byte
	FPControl, FPStatus  uint16
	FPTag                uint8
	MXCSR                uint32
	FP                   [8]Extended
	FPIP, FPDP           uint64
	FPCS, FPDS, FPOpcode uint16
	cache                map[uint64]Instruction
	stamp                engine.CodeStamp
}

func mask(w uint8) uint64 {
	if w == 8 {
		return ^uint64(0)
	}
	return (uint64(1) << (8 * w)) - 1
}
func signed(v uint64, w uint8) int64 { return int64(v<<(64-8*w)) >> (64 - 8*w) }
func (c *CPU) address(o Operand, next uint64) uint64 {
	a := uint64(o.Disp)
	if o.RIP {
		a += next
	}
	if o.Base >= 0 {
		a += c.R[o.Base]
	}
	if o.Index >= 0 {
		a += c.R[o.Index] << o.Scale
	}
	if o.Addr32 {
		a = uint64(uint32(a))
	}
	if o.Addr16 {
		a = uint64(uint16(a))
	}
	if c.System != nil && c.System.legacy() && o.Segment != 0 {
		return a + c.System.Segments[segmentIndex(o.Segment)].Base
	}
	if c.System != nil {
		if o.Segment == 0x64 {
			a += c.System.FSBase
		}
		if o.Segment == 0x65 {
			a += c.System.GSBase
		}
	}
	return a
}
func (c *CPU) read(o Operand, w uint8, next uint64) (uint64, error) {
	switch o.Kind {
	case immOperand:
		return o.Imm & mask(w), nil
	case regOperand:
		if o.Reg >= 16 {
			return (c.R[o.Reg-16] >> 8) & 255, nil
		}
		return c.R[o.Reg] & mask(w), nil
	case memOperand:
		if o.Segment != 0 && c.System == nil {
			return 0, fmt.Errorf("segment base unavailable in user personality")
		}
		a, err := c.memoryAddress(o, next, int(w), false)
		if err != nil {
			return 0, err
		}
		return c.Memory.Read(a, int(w), false)
	}
	return 0, fmt.Errorf("invalid operand")
}
func (c *CPU) write(o Operand, w uint8, next, v uint64) error {
	v &= mask(w)
	if o.Kind == memOperand {
		if o.Segment != 0 && c.System == nil {
			return fmt.Errorf("segment base unavailable in user personality")
		}
		a, err := c.memoryAddress(o, next, int(w), true)
		if err != nil {
			return err
		}
		return c.Memory.Write(a, int(w), v)
	}
	if o.Kind != regOperand {
		return fmt.Errorf("invalid destination")
	}
	if o.Reg >= 16 {
		r := o.Reg - 16
		c.R[r] = c.R[r]&^uint64(0xff00) | (v << 8)
		return nil
	}
	if w == 4 || w == 8 {
		c.R[o.Reg] = v
	} else {
		c.R[o.Reg] = c.R[o.Reg]&^mask(w) | v
	}
	return nil
}
func szp(v uint64, w uint8) uint64 {
	v &= mask(w)
	f := uint64(0)
	if v == 0 {
		f |= ZF
	}
	if v&(uint64(1)<<(8*w-1)) != 0 {
		f |= SF
	}
	if bits.OnesCount8(uint8(v))&1 == 0 {
		f |= PF
	}
	return f
}
func arithmetic(a, b, carry uint64, w uint8, sub bool) (uint64, uint64) {
	m := mask(w)
	a &= m
	b &= m
	var v, f uint64
	if sub {
		v = (a - b - carry) & m
		if a < b || carry != 0 && a == b {
			f |= CF
		}
		if ((a^b)&(a^v))&(uint64(1)<<(8*w-1)) != 0 {
			f |= OF
		}
	} else {
		v = (a + b + carry) & m
		if v < a || carry != 0 && v == a {
			f |= CF
		}
		if (^(a^b)&(a^v))&(uint64(1)<<(8*w-1)) != 0 {
			f |= OF
		}
	}
	if (a^b^v)&16 != 0 {
		f |= AF
	}
	return v, f | szp(v, w)
}
func condition(flags uint64, cc uint8) bool {
	c, z, s, o, p := flags&CF != 0, flags&ZF != 0, flags&SF != 0, flags&OF != 0, flags&PF != 0
	v := false
	switch cc >> 1 {
	case 0:
		v = o
	case 1:
		v = c
	case 2:
		v = z
	case 3:
		v = c || z
	case 4:
		v = s
	case 5:
		v = p
	case 6:
		v = s != o
	case 7:
		v = z || s != o
	}
	if cc&1 != 0 {
		return !v
	}
	return v
}

// Step caches decoding only when the memory supplies executable mutation epochs.
// Unknown buses are fetched each time; guest data is never treated as host code.
func (c *CPU) Step() error {
	if c.System != nil {
		return c.System.step()
	}
	var i Instruction
	var ok bool
	if m, versioned := c.Memory.(engine.CodeContextMemory); versioned {
		stamp := m.CodeContext()
		if c.cache == nil || stamp != c.stamp {
			c.cache = make(map[uint64]Instruction)
			c.stamp = stamp
		}
		i, ok = c.cache[c.PC]
	}
	if !ok {
		var err error
		i, err = Decode(c.Memory, c.PC)
		if err != nil {
			return err
		}
		if c.cache != nil {
			c.cache[c.PC] = i
		}
	}
	if err := c.Execute(i); err != nil && err != Syscall {
		return fmt.Errorf("pc=%#x %s: %w", i.PC, i.Op, err)
	} else {
		return err
	}
}

// ExecuteCachedInstruction skips fetching only. The caller must validate the
// exact immutable instruction at the current PC, including execute permission
// on straddling pages, code epochs and architectural address-space identity.
// Exception delivery, interrupt shadow and TSC match CPU.Step exactly.
func (c *CPU) ExecuteCachedInstruction(i Instruction) error {
	if c.System != nil {
		if c.System.legacy() {
			return c.System.executeLegacyDecoded(i, nil)
		}
		return c.System.executeDecoded(i, nil)
	}
	if err := c.Execute(i); err != nil && err != Syscall {
		return fmt.Errorf("pc=%#x %s: %w", i.PC, i.Op, err)
	} else {
		return err
	}
}

func (c *CPU) Execute(i Instruction) error {
	if c.System != nil && c.System.legacy() {
		if handled, err := c.executeLegacy(i); handled {
			return err
		}
	}
	if handled, err := c.executeExtra(i); handled {
		return err
	}
	w := i.Width
	next := i.Next
	flags := c.Flags
	var a, b, v uint64
	var err error
	// Reads are performed only for actual input operands. LEA and NOP do not
	// access memory, and MOV must not read a write-only destination.
	switch i.Op {
	case "mov", "movsx", "movzx", "cmov":
		sw := w
		if i.SourceWidth != 0 {
			sw = i.SourceWidth
		}
		v, err = c.read(i.Src, sw, next)
		if err != nil {
			return err
		}
		if i.Op == "movsx" {
			v = uint64(signed(v, sw))
		}
		if i.Op != "cmov" || condition(flags, i.CC) {
			err = c.write(i.Dst, w, next, v)
		}
		// A 32-bit CMOV zero-extends even when its condition is false.
		if i.Op == "cmov" && w == 4 && !condition(flags, i.CC) {
			err = c.write(i.Dst, w, next, c.R[i.Dst.Reg])
		}
	case "lea":
		operand := i.Src
		operand.Segment = 0
		err = c.write(i.Dst, w, next, c.address(operand, next))
	case "nop":
	case "syscall":
		c.R[RCX], c.R[11] = next, flags|2
		c.PC = next
		c.Retired++
		return Syscall
	case "jmp", "jcc":
		if i.Op == "jmp" || condition(flags, i.CC) {
			next = i.Src.Imm
		}
	case "jmpind", "callind", "call":
		target := i.Src.Imm
		if i.Op != "call" {
			target, err = c.read(i.Dst, 8, next)
			if err != nil {
				return err
			}
		}
		if i.Op != "jmpind" {
			err = c.Memory.Write(c.R[RSP]-8, 8, next)
			if err != nil {
				return err
			}
			c.R[RSP] -= 8
		}
		next = target
	case "push":
		v, err = c.read(i.Dst, w, next)
		if err != nil {
			return err
		}
		err = c.Memory.Write(c.R[RSP]-uint64(w), int(w), v)
		if err == nil {
			c.R[RSP] -= uint64(w)
		}
	case "pop", "ret", "leave":
		sp := c.R[RSP]
		if i.Op == "leave" {
			sp = c.R[RBP]
		}
		v, err = c.Memory.Read(sp, int(w), false)
		if err != nil {
			return err
		}
		oldSP := c.R[RSP]
		c.R[RSP] = sp + uint64(w)
		if i.Op == "ret" {
			next = v
			c.R[RSP] += i.Src.Imm
		} else if i.Op == "leave" {
			c.R[RBP] = v
		} else {
			err = c.write(i.Dst, w, next, v)
			if err != nil {
				c.R[RSP] = oldSP
			}
		}
	case "setcc":
		if condition(flags, i.CC) {
			v = 1
		}
		err = c.write(i.Dst, 1, next, v)
	case "signpair":
		v = uint64(signed(c.R[RAX], w) >> 63)
		err = c.write(Operand{Kind: regOperand, Reg: RDX}, w, next, v)
	default:
		a, err = c.read(i.Dst, w, next)
		if err != nil {
			return err
		}
		if i.Src.Kind != 0 {
			b, err = c.read(i.Src, w, next)
			if err != nil {
				return err
			}
		}
		write := true
		switch i.Op {
		case "add", "adc", "sub", "sbb", "cmp", "inc", "dec", "neg":
			carry := uint64(0)
			if i.Op == "adc" || i.Op == "sbb" {
				carry = flags & CF
			}
			sub := i.Op == "sub" || i.Op == "sbb" || i.Op == "cmp" || i.Op == "dec" || i.Op == "neg"
			if i.Op == "inc" || i.Op == "dec" {
				b = 1
			}
			if i.Op == "neg" {
				b = a
				a = 0
			}
			var f uint64
			v, f = arithmetic(a, b, carry, w, sub)
			if i.Op == "inc" || i.Op == "dec" {
				f = f&^CF | flags&CF
			}
			flags = flags&^arithmeticFlags | f
			write = i.Op != "cmp"
		case "and", "or", "xor", "test":
			switch i.Op {
			case "and", "test":
				v = a & b
			case "or":
				v = a | b
			case "xor":
				v = a ^ b
			}
			flags = flags&^arithmeticFlags | szp(v, w)
			write = i.Op != "test"
		case "not":
			v = ^a
		case "shl", "shr", "sar", "rol", "ror":
			count := b & 31
			if w == 8 {
				count = b & 63
			}
			v = a
			if count == 0 {
				write = false
				break
			}
			width := uint64(w) * 8
			f := uint64(0)
			switch i.Op {
			case "shl":
				v = a << count
				if count <= width {
					f = (a >> (width - count)) & 1
				}
				if count == 1 && ((v>>(width-1))&1) != f {
					f |= OF
				}
			case "shr":
				v = a >> count
				f = (a >> (count - 1)) & 1
				if count == 1 && a>>(width-1) != 0 {
					f |= OF
				}
			case "sar":
				v = uint64(signed(a, w) >> count)
				if count >= width {
					f = a >> (width - 1)
				} else {
					f = (a >> (count - 1)) & 1
				}
			case "rol":
				n := count % width
				v = (a << n) | (a >> (width - n))
				f = v & 1
				if count == 1 && ((v>>(width-1))&1) != f {
					f |= OF
				}
			case "ror":
				n := count % width
				v = (a >> n) | (a << (width - n))
				f = (v >> (width - 1)) & 1
				if count == 1 && ((v>>(width-2))&1) != f {
					f |= OF
				}
			}
			if i.Op == "rol" || i.Op == "ror" {
				flags = flags&^(CF|OF) | f
			} else {
				flags = flags&^arithmeticFlags | f | szp(v, w)
			}
		case "imul", "imul3":
			if i.Op == "imul3" {
				a = b
				b = i.Dst.Imm
			}
			v = a * b
			hi, lo := bits.Mul64(uint64(signed(a, w)), uint64(signed(b, w)))
			if signed(a, w) < 0 {
				hi -= uint64(signed(b, w))
			}
			if signed(b, w) < 0 {
				hi -= uint64(signed(a, w))
			}
			overflow := false
			if w == 8 {
				expected := uint64(0)
				if int64(lo) < 0 {
					expected = ^uint64(0)
				}
				overflow = hi != expected
			} else {
				overflow = int64(lo) != signed(v, w)
			}
			flags &^= CF | OF
			if overflow {
				flags |= CF | OF
			}
		case "mul", "imul1":
			if w == 1 {
				product := uint16(uint8(c.R[RAX])) * uint16(uint8(a))
				overflow := product > 255
				if i.Op == "imul1" {
					product = uint16(int16(int8(c.R[RAX])) * int16(int8(a)))
					overflow = int16(product) != int16(int8(product))
				}
				c.R[RAX] = c.R[RAX]&^65535 | uint64(product)
				flags &^= CF | OF
				if overflow {
					flags |= CF | OF
				}
				write = false
				break
			}
			x := c.R[RAX] & mask(w)
			hi, lo := bits.Mul64(x, a)
			if i.Op == "imul1" {
				hi, lo = bits.Mul64(uint64(signed(x, w)), uint64(signed(a, w)))
				if signed(x, w) < 0 {
					hi -= uint64(signed(a, w))
				}
				if signed(a, w) < 0 {
					hi -= uint64(signed(x, w))
				}
			}
			if w < 8 {
				hi = lo >> (8 * w) & mask(w)
			}
			overflow := hi != 0
			if i.Op == "imul1" {
				expected := uint64(0)
				if signed(lo, w) < 0 {
					expected = mask(w)
				}
				overflow = hi != expected
			}
			c.write(Operand{Kind: regOperand, Reg: RAX}, w, next, lo)
			c.write(Operand{Kind: regOperand, Reg: RDX}, w, next, hi)
			flags &^= CF | OF
			if overflow {
				flags |= CF | OF
			}
			write = false
		case "div":
			if w == 1 {
				n := c.R[RAX] & 65535
				if a == 0 || n/a > 255 {
					if c.System != nil {
						return &Exception{Vector: 0}
					}
					return fmt.Errorf("divide error")
				}
				c.R[RAX] = c.R[RAX]&^65535 | (n / a) | ((n % a) << 8)
				write = false
				break
			}
			hi, lo := c.R[RDX]&mask(w), c.R[RAX]&mask(w)
			if a == 0 || hi >= a {
				if c.System != nil {
					return &Exception{Vector: 0}
				}
				return fmt.Errorf("divide error")
			}
			var q, r uint64
			if w == 8 {
				q, r = bits.Div64(hi, lo, a)
			} else {
				n := hi<<(8*w) | lo
				q, r = n/a, n%a
			}
			if q > mask(w) {
				if c.System != nil {
					return &Exception{Vector: 0}
				}
				return fmt.Errorf("divide overflow")
			}
			c.write(Operand{Kind: regOperand, Reg: RAX}, w, next, q)
			c.write(Operand{Kind: regOperand, Reg: RDX}, w, next, r)
			write = false
		case "idiv":
			hi, lo := c.R[RDX]&mask(w), c.R[RAX]&mask(w)
			den := signed(a, w)
			if den == 0 {
				if c.System != nil {
					return &Exception{Vector: 0}
				}
				return fmt.Errorf("divide error")
			}
			var q, r uint64
			if w == 8 {
				negative := int64(hi) < 0
				divisor := uint64(den)
				if den < 0 {
					divisor = -divisor
				}
				if negative {
					var carry uint64
					lo, carry = bits.Add64(^lo, 1, 0)
					hi, _ = bits.Add64(^hi, 0, carry)
				}
				if hi >= divisor {
					if c.System != nil {
						return &Exception{Vector: 0}
					}
					return fmt.Errorf("divide overflow")
				}
				q, r = bits.Div64(hi, lo, divisor)
				negativeQ := negative != (den < 0)
				limit := uint64(1) << 63
				if !negativeQ {
					limit--
				}
				if q > limit {
					if c.System != nil {
						return &Exception{Vector: 0}
					}
					return fmt.Errorf("divide overflow")
				}
				if negativeQ {
					q = -q
				}
				if negative {
					r = -r
				}
			} else {
				var n int64
				if w == 1 {
					n = int64(int16(c.R[RAX]))
				} else {
					n = signed((hi<<(8*w))|lo, w*2)
				}
				quotient, remainder := n/den, n%den
				limit := int64(1) << (w*8 - 1)
				if quotient < -limit || quotient >= limit {
					if c.System != nil {
						return &Exception{Vector: 0}
					}
					return fmt.Errorf("divide overflow")
				}
				q, r = uint64(quotient), uint64(remainder)
			}
			if w == 1 {
				c.R[RAX] = c.R[RAX]&^65535 | (q & 255) | (r&255)<<8
			} else {
				c.write(Operand{Kind: regOperand, Reg: RAX}, w, next, q)
				c.write(Operand{Kind: regOperand, Reg: RDX}, w, next, r)
			}
			write = false
		default:
			return fmt.Errorf("unimplemented operation %s", i.Op)
		}
		if write {
			err = c.write(i.Dst, w, next, v)
		}
	}
	if err != nil {
		return err
	}
	c.Flags = flags
	c.PC = next
	c.Retired++
	return nil
}

-- cpu_test.go --
package x86

import (
	"bytes"
	"renvo.dev/internal/rfe/linuxuser"
	"testing"
)

func testCPU(t *testing.T, code []byte) *CPU {
	t.Helper()
	m := linuxuser.NewMemory()
	if err := m.Map(0x1000, 4096, 7); err != nil {
		t.Fatal(err)
	}
	if err := m.WriteBytes(0x1000, code); err != nil {
		t.Fatal(err)
	}
	return &CPU{Memory: m, PC: 0x1000, Flags: 2}
}
func step(t *testing.T, c *CPU) {
	t.Helper()
	if err := c.Step(); err != nil {
		t.Fatal(err)
	}
}
func TestRegisterWidthsAndPrefixes(t *testing.T) {
	c := testCPU(t, []byte{0xb4, 0x12, 0x40, 0xb4, 0x34, 0x66, 0xb8, 0x78, 0x56, 0xb8, 0x44, 0x33, 0x22, 0x11})
	c.R[RAX] = ^uint64(0)
	c.R[RSP] = 0x123456789abcde00
	step(t, c)
	if c.R[RAX] != 0xffffffffffff12ff {
		t.Fatal("AH", c.R[RAX])
	}
	step(t, c)
	if c.R[RSP] != 0x123456789abcde34 {
		t.Fatal("REX SPL", c.R[RSP])
	}
	step(t, c)
	if c.R[RAX] != 0xffffffffffff5678 {
		t.Fatal("AX merge", c.R[RAX])
	}
	step(t, c)
	if c.R[RAX] != 0x11223344 {
		t.Fatal("EAX zero extension", c.R[RAX])
	}
	// A legacy prefix following REX cancels that REX.
	c = testCPU(t, []byte{0x48, 0x66, 0xb8, 0x34, 0x12})
	c.R[0] = ^uint64(0)
	step(t, c)
	if c.R[0] != 0xffffffffffff1234 || c.PC != 0x1005 {
		t.Fatal("prefix order", c)
	}
}
func TestAddressingAndFetchBoundary(t *testing.T) {
	c := testCPU(t, []byte{0x48, 0x8d, 0x44, 0xcb, 0xf0, 0x48, 0x8d, 0x05, 0x10, 0, 0, 0})
	c.R[RBX] = 100
	c.R[RCX] = 3
	step(t, c)
	if c.R[0] != 108 {
		t.Fatal("SIB", c.R[0])
	}
	step(t, c)
	if c.R[0] != 0x101c {
		t.Fatal("RIP", c.R[0])
	}
	c = testCPU(t, []byte{0x67, 0x48, 0x8d, 0x03})
	c.R[RBX] = 0x100000012
	step(t, c)
	if c.R[0] != 18 {
		t.Fatal("address size wrap", c.R[0])
	}
	m := c.Memory.(*linuxuser.Memory)
	if err := m.Write(0x1fff, 1, 0x90); err != nil {
		t.Fatal(err)
	}
	c.PC = 0x1fff
	step(t, c) // Must not fetch an unused byte on the unmapped next page.
	c.PC = 0x1fff
	m.Write(0x1fff, 1, 0x48)
	before := c.Retired
	if err := c.Step(); err == nil || c.Retired != before || c.PC != 0x1fff {
		t.Fatal("truncated fetch retired")
	}
	for _, n := range []int{14, 15} {
		code := append(bytes.Repeat([]byte{0x66}, n), 0x90)
		c = testCPU(t, code)
		err := c.Step()
		if (err == nil) != (n == 14) {
			t.Fatal("15-byte maximum", n, err)
		}
	}
}
func TestArithmeticFlagsExhaustiveByte(t *testing.T) {
	for _, sub := range []bool{false, true} {
		for a := 0; a < 256; a++ {
			for b := 0; b < 256; b++ {
				for carry := 0; carry < 2; carry++ {
					result, f := arithmetic(uint64(a), uint64(b), uint64(carry), 1, sub)
					wide := a + b + carry
					low := (a & 15) + (b & 15) + carry
					sa, sb := int(int8(a)), int(int8(b))
					ss := sa + sb + carry
					if sub {
						wide = a - b - carry
						low = (a & 15) - (b & 15) - carry
						ss = sa - sb - carry
					}
					want := uint64(uint8(wide))
					wf := uint64(0)
					if wide < 0 || wide > 255 {
						wf |= CF
					}
					if low < 0 || low > 15 {
						wf |= AF
					}
					if ss < -128 || ss > 127 {
						wf |= OF
					}
					if want == 0 {
						wf |= ZF
					}
					if want >= 128 {
						wf |= SF
					}
					parity := 0
					for bit := 0; bit < 8; bit++ {
						parity += int(want >> bit & 1)
					}
					if parity%2 == 0 {
						wf |= PF
					}
					if result != want || f != wf {
						t.Fatalf("a=%d b=%d carry=%d sub=%v: %#x/%#x want %#x/%#x", a, b, carry, sub, result, f, want, wf)
					}
				}
			}
		}
	}
}
func TestFaultCommitAndCodeInvalidation(t *testing.T) {
	// ADD dword [RBX],1: the full operand straddles an unmapped page.
	c := testCPU(t, []byte{0x83, 0x03, 0x01})
	c.R[RBX] = 0x1ffe
	before, flags := c.R, c.Flags
	if err := c.Step(); err == nil || c.R != before || c.Flags != flags || c.Retired != 0 || c.PC != 0x1000 {
		t.Fatal("imprecise memory fault", err)
	}
	m := c.Memory.(*linuxuser.Memory)
	c.R[RBX] = 0x1800
	m.Write(0x1800, 4, 0x7fffffff)
	m.Protect(0x1000, 4096, 5)
	if err := c.Step(); err == nil || c.Flags != flags || c.Retired != 0 {
		t.Fatal("read-only RMW committed", err)
	}
	m.Protect(0x1000, 4096, 7)
	m.WriteBytes(0x1000, []byte{0xb8, 1, 0, 0, 0})
	step(t, c)
	c.PC = 0x1000
	m.Write(0x1001, 1, 2)
	step(t, c)
	if c.R[0] != 2 {
		t.Fatal("stale decoded instruction")
	}
	m.Protect(0x1000, 4096, 3)
	c.PC = 0x1000
	retired := c.Retired
	if err := c.Step(); err == nil || c.Retired != retired {
		t.Fatal("revoked code executed")
	}
}
func TestCallStackAndSyscall(t *testing.T) {
	c := testCPU(t, []byte{0xe8, 1, 0, 0, 0, 0x90, 0xc3})
	c.R[RSP] = 0x1800
	step(t, c)
	if c.PC != 0x1006 || c.R[RSP] != 0x17f8 {
		t.Fatal("call", c)
	}
	step(t, c)
	if c.PC != 0x1005 || c.R[RSP] != 0x1800 {
		t.Fatal("ret", c)
	}
	c = testCPU(t, []byte{0x0f, 0x05})
	c.Flags = CF | ZF | 2
	if err := c.Step(); err != Syscall || c.R[RCX] != 0x1002 || c.R[11] != CF|ZF|2 || c.Retired != 1 {
		t.Fatal("syscall", err, c)
	}
}
func TestConditionalMoveAndDivideFault(t *testing.T) {
	c := testCPU(t, []byte{0x0f, 0x44, 0xc1})
	c.R[0] = ^uint64(0)
	c.R[1] = 7
	step(t, c)
	if c.R[0] != 0xffffffff {
		t.Fatal("false 32-bit CMOV extension")
	}
	c = testCPU(t, []byte{0xf7, 0xf1})
	c.R[RDX] = 1
	c.R[RCX] = 1
	c.R[RAX] = 123
	before := c.R
	if err := c.Step(); err == nil || c.R != before || c.Retired != 0 {
		t.Fatal("divide overflow committed")
	}
}

-- decode.go --
package x86

import "fmt"

// Operand is a decoded register, immediate, or base/index/displacement address.
// Register numbers 16..19 represent AH..BH, not extended general registers.
type Operand struct {
	Kind                uint8
	Reg, Base, Index    int
	Scale               uint8
	Disp                int64
	Imm                 uint64
	RIP, Addr32, Addr16 bool
	Segment             uint8
}

const (
	regOperand = 1
	memOperand = 2
	immOperand = 3
)

type Instruction struct {
	PC, Next           uint64
	Op                 string
	Dst, Src           Operand
	Width, SourceWidth uint8
	CC                 uint8
	Repeat, Segment    uint8
	AddressWidth       uint8
}
type decoder struct {
	memory                  Memory
	pc, start               uint64
	rex, width              uint8
	addr32, addr16          bool
	mode                    int
	lock                    bool
	segment, repeat, second uint8
	err                     error
}

func (d *decoder) byte() byte {
	if d.err != nil {
		return 0
	}
	if d.pc-d.start >= 15 {
		d.err = fmt.Errorf("instruction exceeds 15 bytes at %#x", d.start)
		return 0
	}
	v, e := d.memory.Read(d.pc, 1, true)
	if e != nil {
		d.err = e
		return 0
	}
	d.pc++
	return byte(v)
}
func (d *decoder) immediate(n uint8, signed bool) uint64 {
	var v uint64
	for i := uint8(0); i < n; i++ {
		v |= uint64(d.byte()) << (8 * i)
	}
	if signed && n < 8 {
		return uint64(int64(v<<(64-8*n)) >> (64 - 8*n))
	}
	return v
}
func immediate(v uint64) Operand { return Operand{Kind: immOperand, Imm: v} }
func (d *decoder) reg(n uint8, w uint8) Operand {
	if w == 1 && d.rex == 0 && n >= 4 && n < 8 {
		return Operand{Kind: regOperand, Reg: int(n) + 12}
	}
	return Operand{Kind: regOperand, Reg: int(n)}
}
func (d *decoder) modrm(w uint8) (Operand, Operand, uint8) {
	b := d.byte()
	mode, group, rm := b>>6, (b>>3)&7, b&7
	r := d.reg(group+((d.rex>>2)&1)*8, w)
	if mode == 3 {
		return d.reg(rm+(d.rex&1)*8, w), r, group
	}
	m := Operand{Kind: memOperand, Base: -1, Index: -1, Addr32: d.addr32, Addr16: d.addr16, Segment: d.segment}
	if d.addr16 {
		bases := [8]int{RBX, RBX, RBP, RBP, RSI, RDI, RBP, RBX}
		indices := [8]int{RSI, RDI, RSI, RDI, -1, -1, -1, -1}
		m.Base, m.Index = bases[rm], indices[rm]
		if mode == 0 && rm == 6 {
			m.Base = -1
			m.Disp = int64(d.immediate(2, false))
		}
		if mode == 1 {
			m.Disp += int64(d.immediate(1, true))
		}
		if mode == 2 {
			m.Disp += int64(d.immediate(2, true))
		}
		if m.Segment == 0 {
			m.Segment = 0x3e
			if m.Base == RBP {
				m.Segment = 0x36
			}
		}
		return m, r, group
	}
	if rm == 4 {
		sib := d.byte()
		base, index := sib&7, (sib>>3)&7
		m.Scale = sib >> 6
		if index != 4 || d.rex&2 != 0 {
			m.Index = int(index + ((d.rex>>1)&1)*8)
		}
		if base == 5 && mode == 0 {
			m.Disp = int64(d.immediate(4, true))
		} else {
			m.Base = int(base + (d.rex&1)*8)
		}
	} else if rm == 5 && mode == 0 {
		m.Disp = int64(d.immediate(4, true))
		m.RIP = d.mode == 64
	} else {
		m.Base = int(rm + (d.rex&1)*8)
	}
	if mode == 1 {
		m.Disp += int64(d.immediate(1, true))
	}
	if mode == 2 {
		m.Disp += int64(d.immediate(4, true))
	}
	if d.mode != 64 && m.Segment == 0 {
		m.Segment = 0x3e
		if m.Base == RBP || m.Base == RSP {
			m.Segment = 0x36
		}
	}
	return m, r, group
}
func Decode(m Memory, pc uint64) (Instruction, error) { return DecodeMode(m, pc, 64) }

// DecodeMode uses the code segment's default size, not the host architecture.
func DecodeMode(m Memory, pc uint64, mode int) (Instruction, error) {
	if mode != 16 && mode != 32 && mode != 64 {
		return Instruction{}, fmt.Errorf("invalid x86 code size %d", mode)
	}
	d := decoder{memory: m, pc: pc, start: pc, width: 4, mode: mode, addr16: mode == 16, addr32: mode == 32}
	i := Instruction{PC: pc}
	var op byte
	operand16 := false
	for {
		op = d.byte()
		if d.err != nil {
			return i, d.err
		}
		if mode == 64 && op >= 0x40 && op <= 0x4f {
			d.rex = op
			continue
		}
		if op == 0x66 {
			operand16 = true
			d.rex = 0
			continue
		}
		if op == 0x67 {
			d.addr16, d.addr32 = mode == 32, mode != 32
			d.rex = 0
			continue
		}
		if op == 0x64 || op == 0x65 {
			d.segment = op
			d.rex = 0
			continue
		}
		if op == 0xf2 || op == 0xf3 {
			d.repeat = op
			d.rex = 0
			continue
		}
		if op == 0xf0 {
			d.lock = true
			d.rex = 0
			continue
		}
		if op == 0x2e || op == 0x3e || op == 0x26 || op == 0x36 {
			d.segment = op
			d.rex = 0
			continue
		}
		break
	}
	if (mode == 16) != operand16 {
		d.width = 2
	}
	if d.rex&8 != 0 {
		d.width = 8
	}
	i.Width = d.width
	w := d.width
	immWidth := w
	if immWidth == 8 {
		immWidth = 4
	}
	alu := []string{"add", "or", "adc", "sbb", "and", "sub", "xor", "cmp"}
	switch {
	case op == 0xc8:
		i.Op = "enter"
		i.Dst = immediate(d.immediate(2, false))
		i.Src = immediate(d.immediate(1, false))
		if mode == 64 {
			i.Width = 8
		}
	case mode != 64 && op == 0x62:
		rm, r, _ := d.modrm(w)
		i.Op = "bound"
		i.Dst, i.Src = r, rm
		if rm.Kind != memOperand {
			i.Op = "ud2"
		}
	case op >= 0x6c && op <= 0x6f:
		i.Op = "ins"
		if op&2 != 0 {
			i.Op = "outs"
		}
		i.Width = w
		if op&1 == 0 {
			i.Width = 1
		}
		if i.Width == 8 {
			i.Width = 4
		}
	case mode != 64 && (op == 0xd4 || op == 0xd5):
		i.Op = "aam"
		if op == 0xd5 {
			i.Op = "aad"
		}
		i.Src = immediate(d.immediate(1, false))
	case mode != 64 && (op == 0x27 || op == 0x2f || op == 0x37 || op == 0x3f):
		switch op {
		case 0x27:
			i.Op = "daa"
		case 0x2f:
			i.Op = "das"
		case 0x37:
			i.Op = "aaa"
		case 0x3f:
			i.Op = "aas"
		}
	case mode != 64 && (op == 0xc4 || op == 0xc5):
		rm, r, _ := d.modrm(w)
		i.Op = "loadfar"
		i.Dst, i.Src = r, rm
		i.CC = 0
		if op == 0xc5 {
			i.CC = 3
		}
		if rm.Kind != memOperand {
			i.Op = ""
		}
	case mode != 64 && (op == 0x60 || op == 0x61):
		i.Op = "pusha"
		if op == 0x61 {
			i.Op = "popa"
		}
	case op == 0x8f:
		rm, _, g := d.modrm(w)
		if g == 0 {
			i.Op = "pop"
			i.Dst = rm
			i.Width = w
			if mode == 64 {
				i.Width = 8
				if operand16 {
					i.Width = 2
				}
			}
		}
	case mode != 64 && op >= 0x40 && op <= 0x4f:
		i.Op = "inc"
		if op&8 != 0 {
			i.Op = "dec"
		}
		i.Dst = d.reg(op&7, w)
	case mode != 64 && (op == 0xea || op == 0x9a):
		i.Op = "farjmp"
		if op == 0x9a {
			i.Op = "farcall"
		}
		i.Src = immediate(d.immediate(w, false))
		i.Dst = immediate(d.immediate(2, false))
	case mode != 64 && (op == 0xa0 || op == 0xa1 || op == 0xa2 || op == 0xa3):
		if op&1 == 0 {
			i.Width = 1
		}
		n := uint8(4)
		if d.addr16 {
			n = 2
		}
		seg := d.segment
		if seg == 0 {
			seg = 0x3e
		}
		i.Op = "mov"
		i.Dst = d.reg(0, i.Width)
		i.Src = Operand{Kind: memOperand, Base: -1, Index: -1, Addr16: d.addr16, Addr32: d.addr32, Segment: seg, Disp: int64(d.immediate(n, false))}
		if op&2 != 0 {
			i.Dst, i.Src = i.Src, i.Dst
		}
	case mode != 64 && (op == 0x06 || op == 0x0e || op == 0x16 || op == 0x1e || op == 0x07 || op == 0x17 || op == 0x1f):
		i.Op = "pushseg"
		if op&1 != 0 {
			i.Op = "popseg"
		}
		i.CC = op >> 3
	case op < 0x40 && op&7 <= 5:
		i.Op = alu[op>>3]
		if op&1 == 0 {
			i.Width = 1
		}
		if op&7 < 4 {
			rm, r, _ := d.modrm(i.Width)
			i.Dst, i.Src = rm, r
			if op&2 != 0 {
				i.Dst, i.Src = r, rm
			}
		} else {
			i.Dst = d.reg(0, i.Width)
			n := immWidth
			if i.Width == 1 {
				n = 1
			}
			i.Src = immediate(d.immediate(n, w == 8))
		}
	case op >= 0x50 && op <= 0x5f:
		i.Width = 8
		if operand16 {
			i.Width = 2
		}
		i.Dst = d.reg((op&7)+(d.rex&1)*8, i.Width)
		i.Op = "push"
		if op&8 != 0 {
			i.Op = "pop"
		}
	case op == 0x68 || op == 0x6a:
		i.Op = "push"
		i.Width = 8
		n := uint8(4)
		if w == 2 {
			i.Width = 2
			n = 2
		}
		if op == 0x6a {
			n = 1
		}
		i.Dst = immediate(d.immediate(n, true))
	case op == 0x69 || op == 0x6b:
		rm, r, _ := d.modrm(w)
		i.Op = "imul3"
		i.Dst, i.Src = r, rm
		n := immWidth
		if op == 0x6b {
			n = 1
		}
		i.Dst.Imm = d.immediate(n, true)
	case op >= 0x70 && op <= 0x7f:
		i.Op = "jcc"
		i.CC = op & 15
		i.Src = immediate(d.immediate(1, true))
	case op == 0x80 || op == 0x81 || op == 0x83:
		if op == 0x80 {
			i.Width = 1
		}
		rm, _, g := d.modrm(i.Width)
		i.Op = alu[g]
		i.Dst = rm
		n := immWidth
		if op != 0x81 {
			n = 1
		}
		i.Src = immediate(d.immediate(n, op == 0x83 || w == 8))
	case op == 0x84 || op == 0x85 || op == 0x88 || op == 0x89 || op == 0x8a || op == 0x8b || op == 0x8d:
		if op&1 == 0 {
			i.Width = 1
		}
		rm, r, _ := d.modrm(i.Width)
		i.Dst, i.Src = rm, r
		i.Op = "mov"
		if op == 0x84 || op == 0x85 {
			i.Op = "test"
		}
		if op == 0x8a || op == 0x8b || op == 0x8d {
			i.Dst, i.Src = r, rm
		}
		if op == 0x8d {
			i.Op = "lea"
			if rm.Kind != memOperand {
				i.Op = ""
			}
		}
	case op == 0x90:
		if d.rex&1 == 0 {
			i.Op = "nop"
		}
	case op == 0x98:
		i.Op = "movsx"
		i.Dst = d.reg(0, w)
		i.Src = d.reg(0, w/2)
		i.SourceWidth = w / 2
	case op == 0x99:
		i.Op = "signpair"
	case op == 0x63:
		if mode != 64 {
			rm, r, _ := d.modrm(2)
			i.Op = "arpl"
			i.Dst, i.Src = rm, r
			i.Width = 2
		}
		if mode == 64 && w == 8 {
			rm, r, _ := d.modrm(4)
			i.Op = "movsx"
			i.Dst, i.Src = r, rm
			i.SourceWidth = 4
		}
	case op >= 0xb0 && op <= 0xbf:
		if op < 0xb8 {
			i.Width = 1
		}
		i.Op = "mov"
		i.Dst = d.reg((op&7)+(d.rex&1)*8, i.Width)
		i.Src = immediate(d.immediate(i.Width, false))
	case op == 0xa8 || op == 0xa9:
		if op == 0xa8 {
			i.Width = 1
			immWidth = 1
		}
		i.Op = "test"
		i.Dst = d.reg(0, i.Width)
		i.Src = immediate(d.immediate(immWidth, w == 8))
	case op == 0xc0 || op == 0xc1 || op == 0xd0 || op == 0xd1 || op == 0xd2 || op == 0xd3:
		if op&1 == 0 {
			i.Width = 1
		}
		rm, _, g := d.modrm(i.Width)
		i.Dst = rm
		shifts := []string{"rol", "ror", "rcl", "rcr", "shl", "shr", "shl", "sar"}
		i.Op = shifts[g]
		if op == 0xc0 || op == 0xc1 {
			i.Src = immediate(d.immediate(1, false))
		} else if op == 0xd0 || op == 0xd1 {
			i.Src = immediate(1)
		} else {
			i.Src = d.reg(1, 1)
		}
	case op == 0xc2 || op == 0xc3:
		i.Op = "ret"
		i.Width = 8
		if op == 0xc2 {
			i.Src = immediate(d.immediate(2, false))
		}
	case op == 0xc6 || op == 0xc7:
		if op == 0xc6 {
			i.Width = 1
			immWidth = 1
		}
		rm, _, g := d.modrm(i.Width)
		if g == 0 {
			i.Op = "mov"
		}
		i.Dst = rm
		i.Src = immediate(d.immediate(immWidth, w == 8))
	case op == 0xc9:
		i.Op = "leave"
		i.Width = 8
		if d.mode == 64 && operand16 {
			i.Op = ""
		}
	case op == 0xe8 || op == 0xe9 || op == 0xeb:
		i.Op = "jmp"
		if op == 0xe8 {
			i.Op = "call"
		}
		n := uint8(4)
		if mode != 64 {
			n = w
		}
		if op == 0xeb {
			n = 1
		}
		i.Src = immediate(d.immediate(n, true))
	case op == 0xf6 || op == 0xf7:
		if op == 0xf6 {
			i.Width = 1
			immWidth = 1
		}
		rm, _, g := d.modrm(i.Width)
		i.Dst = rm
		names := []string{"test", "", "not", "neg", "mul", "imul1", "div", "idiv"}
		i.Op = names[g]
		if g == 0 {
			i.Src = immediate(d.immediate(immWidth, w == 8))
		}
	case op == 0xfe || op == 0xff:
		if op == 0xfe {
			i.Width = 1
		}
		rm, _, g := d.modrm(i.Width)
		i.Dst = rm
		if g == 0 {
			i.Op = "inc"
		}
		if g == 1 {
			i.Op = "dec"
		}
		if mode != 64 && op == 0xff && (g == 3 || g == 5) && rm.Kind == memOperand {
			i.Op = "farcallind"
			if g == 5 {
				i.Op = "farjmpind"
			}
		}
		if op == 0xff && (g == 2 || g == 4 || g == 6) {
			i.Width = 8
			if g == 2 {
				i.Op = "callind"
			}
			if g == 4 {
				i.Op = "jmpind"
			}
			if g == 6 {
				i.Op = "push"
				if operand16 {
					i.Width = 2
				}
			}
		}
	case op == 0x0f:
		second := d.byte()
		d.second = second
		switch {
		case second == 0x02 || second == 0x03:
			rm, r, _ := d.modrm(2)
			i.Op = "lar"
			if second == 3 {
				i.Op = "lsl"
			}
			i.Dst, i.Src = r, rm
		case second == 0xa0 || second == 0xa1 || second == 0xa8 || second == 0xa9:
			i.Op = "pushseg"
			if second&1 != 0 {
				i.Op = "popseg"
			}
			i.CC = 4
			if second&8 != 0 {
				i.CC = 5
			}
			if mode == 64 {
				i.Width = 8
			}
		case mode != 64 && (second == 0xb2 || second == 0xb4 || second == 0xb5):
			rm, r, _ := d.modrm(w)
			i.Op = "loadfar"
			i.Dst, i.Src = r, rm
			switch second {
			case 0xb2:
				i.CC = 2
			case 0xb4:
				i.CC = 4
			case 0xb5:
				i.CC = 5
			}
			if rm.Kind != memOperand {
				i.Op = ""
			}
		case second == 0x05:
			i.Op = "syscall"
		case second == 0x1f:
			_, _, g := d.modrm(w)
			if g == 0 {
				i.Op = "nop"
			}
		case second >= 0x80 && second <= 0x8f:
			i.Op = "jcc"
			i.CC = second & 15
			n := uint8(4)
			if mode != 64 {
				n = w
			}
			i.Src = immediate(d.immediate(n, true))
		case second >= 0x90 && second <= 0x9f:
			rm, _, _ := d.modrm(1)
			i.Op = "setcc"
			i.CC = second & 15
			i.Dst = rm
			i.Width = 1
		case second >= 0x40 && second <= 0x4f:
			rm, r, _ := d.modrm(w)
			i.Op = "cmov"
			i.CC = second & 15
			i.Dst, i.Src = r, rm
		case second == 0xaf:
			rm, r, _ := d.modrm(w)
			i.Op = "imul"
			i.Dst, i.Src = r, rm
		case second == 0xb6 || second == 0xb7 || second == 0xbe || second == 0xbf:
			sw := uint8(1)
			if second&1 != 0 {
				sw = 2
			}
			rm, r, _ := d.modrm(sw)
			// ModRM.reg is a full destination register, never AH..BH.
			if r.Reg >= 16 {
				r.Reg -= 12
			}
			i.Op = "movzx"
			if second >= 0xbe {
				i.Op = "movsx"
			}
			i.Dst, i.Src, i.SourceWidth = r, rm, sw
		}
	}
	if i.Op == "" {
		d.extra(&i, op, operand16)
		if i.Op == "" {
			d.vectorDecode(&i, op, operand16)
		}
	}
	if mode != 64 {
		switch i.Op {
		case "push", "pop", "ret", "leave", "pushf", "popf", "lret", "iret", "callind", "jmpind":
			i.Width = w
		case "in", "out":
			if i.Width != 1 {
				i.Width = w
			}
		}
	}
	i.AddressWidth = 8
	if d.addr32 {
		i.AddressWidth = 4
	}
	if d.addr16 {
		i.AddressWidth = 2
	}
	i.Repeat, i.Segment = d.repeat, d.segment
	if d.err != nil {
		return i, d.err
	}
	if i.Op == "" {
		var raw []byte
		for at := pc; at < d.pc; at++ {
			v, err := m.Read(at, 1, true)
			if err != nil {
				break
			}
			raw = append(raw, byte(v))
		}
		return i, fmt.Errorf("unsupported instruction at %#x (bytes %x)", pc, raw)
	}
	i.Next = d.pc
	if i.Op == "jmp" || i.Op == "call" || i.Op == "jcc" {
		i.Src.Imm += i.Next
		if mode != 64 {
			i.Src.Imm &= mask(w)
		}
	}
	return i, nil
}

-- decode_coherence_native_test.go --
package x86

import (
	emu "renvo.dev/internal/rfe/runtime"
	"testing"
)

func TestNativeDecodedOnlyStoreInvalidatesArchitecturalDecodeCache(t *testing.T) {
	m := newSystemRAM()
	copy(m.data[0x1000:], []byte{0x48, 0xff, 0xc0})
	c := &CPU{PC: 0x1000, Flags: 2}
	s := NewPCSystem(c, m, nil)
	s.CR[0] |= 1
	s.EFER = 1 << 10
	s.Segments[1].Flags |= 1 << 13
	j, err := NewPCJIT(c, m.data, func(a uint64, n int) (uint64, bool) {
		return a, a < uint64(len(m.data)) && uint64(n) <= uint64(len(m.data))-a
	})
	if err != nil {
		t.Fatal(err)
	}
	defer j.Close()
	if _, err = j.Read(0x1000, 3, true); err != nil {
		t.Fatal(err)
	}
	if err = c.Step(); err != nil || c.R[RAX] != 1 || len(s.decoded) != 1 {
		t.Fatal("prime architectural decoder", err, c.R)
	}
	context := j.NativeContext()
	context.Memory.SetDecodeEpochs(m.versions)
	context.Memory.Fill(1, 4096, 7)
	n, err := emu.NewNative(1 << 20)
	if err != nil {
		t.Fatal(err)
	}
	defer n.Close()
	var b emu.Builder
	b.MemoryStore(b.Constant(0x1002), b.Constant(0xc3), 1)
	b.Checkpoint(1, 1)
	entry, err := n.CompileMemory(b.FinishMemory(1), 1)
	if err != nil {
		t.Fatal(err)
	}
	old := m.versions[1]
	if err = n.CallMemory(entry, []uint64{0}, context); err != nil || context.Status != 0 || context.Retired != 1 || m.versions[1] == old {
		t.Fatal("decoded-only store did not stay native/coherent", err, context.Status, m.versions[1])
	}
	c.PC = 0x1000
	c.R[RAX] = 0
	if err = c.Step(); err != nil || c.R[RAX] != 0 || c.R[RBX] != 1 {
		t.Fatal("native write reused stale Go-decoded opcode", err, c.R)
	}
}

-- descriptor_access.go --
package x86

func (s *System) setDescriptorAccess(sel uint16, access uint8) error {
	table := s.GDTR
	if sel&4 != 0 {
		table = Table{Base: s.LDTR.Base, Limit: uint16(s.LDTR.Limit)}
	}
	old := s.supervisor
	s.supervisor = true
	defer func() { s.supervisor = old }()
	return s.Write(table.Base+uint64(sel&^7)+5, 1, uint64(access))
}

-- descriptor_access_test.go --
package x86

import "testing"

func TestLegacySegmentLoadMarksDescriptorAccessed(t *testing.T) {
	c, s := protectedTestCPU(t)
	if err := s.segment(3, 16); err != nil {
		t.Fatal(err)
	}
	d, _ := s.Physical.Read(0x510, 8, false)
	if d&(1<<40) == 0 || s.Segments[3].Flags&1 == 0 {
		t.Fatalf("descriptor A bit not set: %x %+v", d, s.Segments[3])
	}
	// Already-accessed descriptors do not require another descriptor-table write.
	c.PC = 0x1000
}

-- direct_call_region_test.go --
package x86

import (
	"renvo.dev/internal/rfe/engine"
	"renvo.dev/internal/rfe/linuxuser"
	"testing"
)

func TestNativeDirectCallRegionBudgetsAndStackFault(t *testing.T) {
	// CALL callee; JMP call; callee: INC RAX; RET.
	code := []byte{0xe8, 2, 0, 0, 0, 0xeb, 0xf9, 0x48, 0xff, 0xc0, 0xc3}
	for _, budget := range []uint64{1, 2, 3, 4, 5, 63, 65, 257} {
		expected, actual := testCPU(t, code), testCPU(t, code)
		for _, c := range []*CPU{expected, actual} {
			if err := c.Memory.(*linuxuser.Memory).Map(0x3000, 4096, 3); err != nil {
				t.Fatal(err)
			}
			c.R[RSP] = 0x3800
		}
		ins, err := fetch(actual.Memory, actual.PC)
		if err != nil || !ins.Terminal || !ins.Flow.Known || ins.Flow.Next != 0x1007 {
			t.Fatal("direct call flow", ins, err)
		}
		cfg := engine.DefaultEngineConfig()
		cfg.IRThreshold, cfg.NativeThreshold = 1, 1
		e, err := engine.New(cfg, Architecture())
		if err != nil {
			t.Fatal(err)
		}
		adapter := NewAdapter(actual)
		// Discover and compile the call and its callee before testing small slices.
		for actual.Retired < 128 {
			if err = e.RunQuanta(adapter, 128-actual.Retired); err != nil {
				t.Fatal(err)
			}
		}
		adapter.Export()
		actual.R, actual.PC, actual.Flags, actual.Retired = expected.R, expected.PC, expected.Flags, 0
		adapter.Import()
		for expected.Retired < budget {
			step(t, expected)
		}
		for actual.Retired < budget {
			if err = e.RunQuanta(adapter, budget-actual.Retired); err != nil {
				t.Fatal(err)
			}
		}
		adapter.Export()
		got, ge := actual.Memory.Read(0x37f8, 8, false)
		want, we := expected.Memory.Read(0x37f8, 8, false)
		if actual.R != expected.R || actual.PC != expected.PC || actual.Flags != expected.Flags || actual.Retired != budget || got != want || ge != nil || we != nil {
			t.Fatal("direct-call slice mismatch", budget, actual, expected, got, want, ge, we)
		}
		if e.NativeAvailable() && (e.Stats.Native == 0 || e.Stats.Regions == 0) {
			t.Fatal("call path did not run native regions", e.Stats)
		}
		actual.PC, actual.R[RSP] = 0x1000, 0x3800
		if err = actual.Memory.(*linuxuser.Memory).Protect(0x3000, 4096, 1); err != nil {
			t.Fatal(err)
		}
		before := *actual
		adapter.Import()
		err = e.RunQuanta(adapter, 64)
		adapter.Export()
		afterWord, readErr := actual.Memory.Read(0x37f8, 8, false)
		if err == nil || actual.R != before.R || actual.PC != before.PC || actual.Flags != before.Flags || actual.Retired != before.Retired || readErr != nil || afterWord != got {
			t.Fatal("call stack fault committed state", err, actual, before, afterWord, got)
		}
		if err = e.Close(); err != nil {
			t.Fatal(err)
		}
	}
}

-- extra.go --
package x86

import (
	"fmt"
	"math/bits"
)

func (d *decoder) extra(i *Instruction, op byte, operand16 bool) {
	w := i.Width
	switch op {
	case 0xf4:
		i.Op = "hlt"
	case 0xfa:
		i.Op = "cli"
	case 0xfb:
		i.Op = "sti"
	case 0xfc:
		i.Op = "cld"
	case 0xfd:
		i.Op = "std"
	case 0xf8:
		i.Op = "clc"
	case 0xf9:
		i.Op = "stc"
	case 0xf5:
		i.Op = "cmc"
	case 0x9c:
		i.Op = "pushf"
		i.Width = 8
		if operand16 {
			i.Width = 2
		}
	case 0x9d:
		i.Op = "popf"
		i.Width = 8
		if operand16 {
			i.Width = 2
		}
	case 0x9e:
		i.Op = "sahf"
	case 0x9f:
		i.Op = "lahf"
	case 0xcb:
		i.Op = "lret"
		i.Width = 8
	case 0xca:
		i.Op = "lret"
		i.Width = 8
		i.Src = immediate(d.immediate(2, false))
	case 0xcf:
		i.Op = "iret"
		i.Width = 8
	case 0xcc:
		i.Op = "int"
		i.Src = immediate(3)
	case 0xcd:
		i.Op = "int"
		i.Src = immediate(d.immediate(1, false))
	case 0x8c, 0x8e:
		rm, _, g := d.modrm(2)
		i.Op = "movseg"
		i.Dst = rm
		i.Width = 2
		i.CC = g
		if op == 0x8c {
			i.Op = "readseg"
			if rm.Kind == regOperand {
				i.Width = w
			}
		}
	case 0x86, 0x87:
		if op == 0x86 {
			i.Width = 1
		}
		rm, r, _ := d.modrm(i.Width)
		i.Op = "xchg"
		i.Dst, i.Src = rm, r
	case 0x90, 0x91, 0x92, 0x93, 0x94, 0x95, 0x96, 0x97:
		i.Op = "xchg"
		i.Dst = d.reg(0, w)
		i.Src = d.reg(op-0x90+(d.rex&1)*8, w)
	case 0xa4, 0xa5, 0xa6, 0xa7, 0xaa, 0xab, 0xac, 0xad, 0xae, 0xaf:
		if op&1 == 0 {
			i.Width = 1
		}
		switch op & 0xfe {
		case 0xa4:
			i.Op = "movs"
		case 0xa6:
			i.Op = "cmps"
		case 0xaa:
			i.Op = "stos"
		case 0xac:
			i.Op = "lods"
		case 0xae:
			i.Op = "scas"
		}
	case 0xe4, 0xe5, 0xe6, 0xe7, 0xec, 0xed, 0xee, 0xef:
		i.Width = 4
		if op&1 == 0 {
			i.Width = 1
		} else if operand16 {
			i.Width = 2
		}
		i.Op = "in"
		if op&2 != 0 {
			i.Op = "out"
		}
		i.Src = d.reg(RDX, 2)
		if op < 0xe8 {
			i.Src = immediate(d.immediate(1, false))
		}
	case 0xe0, 0xe1, 0xe2, 0xe3:
		i.Op = "loop"
		i.CC = op & 3
		i.Src = immediate(d.immediate(1, true))
		i.Src.Imm += d.pc
	case 0xd7:
		i.Op = "xlat"
	case 0x0f:
		switch d.second {
		case 0x01:
			if b, e := d.memory.Read(d.pc, 1, true); e == nil && b == 0xf8 {
				d.byte()
				i.Op = "swapgs"
				break
			}
			if b, e := d.memory.Read(d.pc, 1, true); e == nil && b == 0xf9 {
				d.byte()
				i.Op = "rdtscp"
				break
			}
			rm, _, g := d.modrm(8)
			i.Dst = rm
			i.CC = g
			switch g {
			case 0:
				i.Op = "sgdt"
			case 1:
				i.Op = "sidt"
			case 2:
				i.Op = "lgdt"
			case 3:
				i.Op = "lidt"
			case 4:
				i.Op = "smsw"
				i.Width = 2
			case 6:
				i.Op = "lmsw"
				i.Width = 2
			case 7:
				i.Op = "invlpg"
			}
		case 0x00:
			rm, _, g := d.modrm(2)
			i.Dst = rm
			i.CC = g
			i.Width = 2
			switch g {
			case 0:
				i.Op = "sldt"
			case 1:
				i.Op = "str"
			case 2:
				i.Op = "lldt"
			case 3:
				i.Op = "ltr"
			case 4:
				i.Op = "verr"
			case 5:
				i.Op = "verw"
			}
		case 0x20, 0x21, 0x22, 0x23:
			rm, r, _ := d.modrm(8)
			i.Dst = rm
			i.CC = uint8(r.Reg)
			i.Width = 8
			i.Op = "readcr"
			if d.second&1 != 0 {
				i.Op = "readdr"
			}
			if d.second&2 != 0 {
				if d.second&1 != 0 {
					i.Op = "writedr"
				} else {
					i.Op = "writecr"
				}
			}
		case 0x30:
			i.Op = "wrmsr"
		case 0x32:
			i.Op = "rdmsr"
		case 0x31:
			i.Op = "rdtsc"
		case 0xa2:
			i.Op = "cpuid"
		case 0x06:
			i.Op = "clts"
		case 0x08, 0x09:
			i.Op = "cacheflush"
		case 0x07:
			i.Op = "sysret"
		case 0x0b, 0xff: // UD2 and UD0 always raise #UD, including Windows DPMI probes.
			i.Op = "ud2"
		case 0x1e:
			b := d.byte()
			if d.repeat == 0xf3 && (b == 0xfa || b == 0xfb) {
				i.Op = "nop"
			}
		case 0x18:
			d.modrm(1)
			i.Op = "nop"
		case 0xa3, 0xab, 0xb3, 0xbb, 0xba:
			rm, r, g := d.modrm(w)
			i.Dst, i.Src = rm, r
			i.Op = "bt"
			switch d.second {
			case 0xab:
				i.Op = "bts"
			case 0xb3:
				i.Op = "btr"
			case 0xbb:
				i.Op = "btc"
			case 0xba:
				i.Src = immediate(d.immediate(1, false))
				switch g {
				case 4:
					i.Op = "bt"
				case 5:
					i.Op = "bts"
				case 6:
					i.Op = "btr"
				case 7:
					i.Op = "btc"
				default:
					i.Op = ""
				}
			}
		case 0xbc, 0xbd:
			rm, r, _ := d.modrm(w)
			i.Dst, i.Src = r, rm
			i.Op = "bsf"
			if d.second == 0xbd {
				i.Op = "bsr"
			}
		case 0xc8, 0xc9, 0xca, 0xcb, 0xcc, 0xcd, 0xce, 0xcf:
			i.Dst = d.reg(d.second-0xc8+(d.rex&1)*8, w)
			i.Op = "bswap"
		case 0xb0, 0xb1, 0xc0, 0xc1:
			if d.second&1 == 0 {
				i.Width = 1
			}
			rm, r, _ := d.modrm(i.Width)
			i.Dst, i.Src = rm, r
			i.Op = "cmpxchg"
			if d.second >= 0xc0 {
				i.Op = "xadd"
			}
		case 0xa4, 0xa5, 0xac, 0xad:
			rm, r, _ := d.modrm(w)
			i.Dst, i.Src = rm, r
			i.Op = "shld"
			if d.second&8 != 0 {
				i.Op = "shrd"
			}
			i.CC = 255
			if d.second&1 == 0 {
				i.CC = d.byte()
			}
		case 0xae:
			rm, _, g := d.modrm(8)
			i.Dst = rm
			i.CC = g
			i.Op = "fx"
			if rm.Kind == regOperand {
				i.Op = "nop"
			}
		case 0xc7:
			rm, _, g := d.modrm(w)
			if g == 1 {
				i.Op = "cmpxchg8b"
				i.Dst = rm
			}
		}
	}
}
func (c *CPU) executeExtra(i Instruction) (bool, error) {
	if handled, e := c.vectorExecute(i); handled {
		return true, e
	}
	s := c.System
	next, w := i.Next, i.Width
	var e error
	priv := func() error {
		if s == nil {
			return fmt.Errorf("system instruction %s in user personality", i.Op)
		}
		if s.CPL != 0 {
			if (i.Op == "in" || i.Op == "out" || i.Op == "cli" || i.Op == "sti") && s.CPL <= uint8(c.Flags>>12&3) {
				return nil
			}
			return gp()
		}
		return nil
	}
	read := func(o Operand, n uint8) (uint64, error) { return c.read(o, n, next) }
	write := func(o Operand, n uint8, v uint64) error { return c.write(o, n, next, v) }
	push := func(v uint64) error {
		if e := c.Memory.Write(c.R[RSP]-uint64(w), int(w), v); e != nil {
			return e
		}
		c.R[RSP] -= uint64(w)
		return nil
	}
	pop := func() (uint64, error) {
		v, e := c.Memory.Read(c.R[RSP], int(w), false)
		if e == nil {
			c.R[RSP] += uint64(w)
		}
		return v, e
	}
	switch i.Op {
	case "cli", "sti", "hlt", "clts", "cacheflush", "swapgs":
		if e = priv(); e != nil {
			break
		}
		switch i.Op {
		case "cli":
			c.Flags &^= FlagIF
		case "sti":
			c.Flags |= FlagIF
			s.IRQShadow = 2
		case "hlt":
			s.Halted = true
		case "clts":
			s.CR[0] &^= 8
		case "swapgs":
			s.GSBase, s.KernelGSBase = s.KernelGSBase, s.GSBase
		}
	case "cld":
		c.Flags &^= FlagDF
	case "std":
		c.Flags |= FlagDF
	case "clc":
		c.Flags &^= CF
	case "stc":
		c.Flags |= CF
	case "cmc":
		c.Flags ^= CF
	case "pushf":
		e = push(c.Flags | 2)
	case "popf":
		var v uint64
		v, e = pop()
		if e == nil {
			mask := uint64(0x3f7fd7)
			if s != nil && s.CPL != 0 {
				mask &^= FlagIF | 0x3000
			}
			c.Flags = c.Flags&^mask | v&mask | 2
		}
	case "sahf":
		c.Flags = c.Flags&^0xd5 | (c.R[RAX]>>8)&0xd5
	case "lahf":
		c.R[RAX] = c.R[RAX]&^0xff00 | (c.Flags&0xd5|2)<<8
	case "cpuid":
		if s == nil {
			s = &System{}
		}
		a, b, d, f := s.cpuid(uint32(c.R[RAX]), uint32(c.R[RCX]))
		c.R[RAX], c.R[RBX], c.R[RCX], c.R[RDX] = uint64(a), uint64(b), uint64(d), uint64(f)
	case "rdtsc", "rdtscp":
		if s == nil {
			return true, fmt.Errorf("no system clock")
		}
		c.R[RAX], c.R[RDX] = uint64(uint32(s.TSC)), s.TSC>>32
		if i.Op == "rdtscp" {
			c.R[RCX] = 0
		}
	case "rdmsr", "wrmsr":
		if e = priv(); e != nil {
			break
		}
		if i.Op == "wrmsr" {
			e = s.writeMSR(uint32(c.R[RCX]), uint64(uint32(c.R[RAX]))|c.R[RDX]<<32)
		} else {
			var v uint64
			v, e = s.readMSR(uint32(c.R[RCX]))
			if e == nil {
				c.R[RAX], c.R[RDX] = uint64(uint32(v)), v>>32
			}
		}
	case "readcr", "writecr", "readdr", "writedr":
		if e = priv(); e != nil {
			break
		}
		if int(i.CC) >= len(s.CR) {
			e = gp()
			break
		}
		switch i.Op {
		case "readcr":
			e = write(i.Dst, 8, s.CR[i.CC])
		case "readdr":
			if i.CC >= 8 {
				e = gp()
			} else {
				v := s.DR[i.CC]
				if i.CC == 6 {
					v = v&0xe00f | 0xffff0ff0
				}
				if i.CC == 7 {
					v = v&0xffff23ff | 0x400
				}
				e = write(i.Dst, 8, v)
			}
		case "writedr":
			if i.CC >= 8 {
				e = gp()
			} else {
				s.DR[i.CC], e = read(i.Dst, 8)
			}
		case "writecr":
			v, err := read(i.Dst, 8)
			e = err
			if e == nil {
				old, oldEFER := s.CR[i.CC], s.EFER
				s.CR[i.CC] = v
				if i.CC == 0 && v&(1<<31) != 0 && s.EFER&(1<<8) != 0 {
					s.EFER |= 1 << 10
				}
				if i.CC == 3 {
					s.switchAddressSpace()
				} else if i.CC != 2 && (i.CC != 0 || (old^v)&(1|1<<16|1<<31) != 0 || oldEFER != s.EFER) {
					s.Flush()
				}
			}
		}
	case "lgdt", "lidt", "sgdt", "sidt":
		if e = priv(); e != nil {
			break
		}
		a := c.address(i.Dst, next)
		if i.Op == "lgdt" || i.Op == "lidt" {
			var lim, base uint64
			lim, e = c.Memory.Read(a, 2, false)
			if e == nil {
				n := 8
				if s.legacy() {
					n = 4
				}
				base, e = c.Memory.Read(a+2, n, false)
				if s.legacy() && w == 2 {
					base &= 0xffffff
				}
			}
			if e == nil {
				t := Table{Base: base, Limit: uint16(lim)}
				if i.Op == "lgdt" {
					s.GDTR = t
				} else {
					s.IDTR = t
				}
			}
		} else {
			t := s.GDTR
			if i.Op == "sidt" {
				t = s.IDTR
			}
			e = c.Memory.Write(a, 2, uint64(t.Limit))
			if e == nil {
				n := 8
				if s.legacy() {
					n = 4
				}
				e = c.Memory.Write(a+2, n, t.Base)
			}
		}
	case "movseg", "readseg":
		if s == nil {
			e = fmt.Errorf("segment operation needs system context")
			break
		}
		if i.CC >= 6 {
			e = gp()
			break
		}
		if i.Op == "movseg" {
			v, err := read(i.Dst, 2)
			e = err
			if e == nil {
				e = s.segment(i.CC, uint16(v))
				if e == nil && i.CC == 2 {
					s.IRQShadow = 2
				}
			}
		} else {
			e = write(i.Dst, w, uint64(s.Segments[i.CC].Selector))
		}
	case "ltr", "lldt", "str", "sldt":
		if e = priv(); e != nil {
			break
		}
		if i.Op == "str" {
			e = write(i.Dst, 2, uint64(s.TR.Selector))
		} else if i.Op == "sldt" {
			e = write(i.Dst, 2, uint64(s.LDTR.Selector))
		} else {
			v, err := read(i.Dst, 2)
			e = err
			if e == nil {
				var d Segment
				if v&^3 != 0 {
					d, e = s.descriptor(uint16(v))
				}
				if e == nil {
					if i.Op == "ltr" {
						if s.MultiMode {
							if e = s.setDescriptorAccess(uint16(v), uint8(d.Flags)|2); e != nil {
								break
							}
							d.Flags |= 2
						}
						s.TR = d
					} else {
						s.LDTR = d
					}
				}
			}
		}
	case "verr", "verw":
		if s == nil {
			e = fmt.Errorf("selector verification needs system context")
			break
		}
		var selector uint64
		selector, e = read(i.Dst, 2)
		if e == nil {
			var allowed bool
			allowed, e = s.verifySelector(uint16(selector), i.Op == "verw")
			if e == nil {
				c.Flags &^= ZF
				if allowed {
					c.Flags |= ZF
				}
			}
		}
	case "smsw", "lmsw":
		if s == nil {
			e = gp()
			break
		}
		if i.Op == "smsw" {
			e = write(i.Dst, w, s.CR[0])
		} else if e = priv(); e == nil {
			v, err := read(i.Dst, 2)
			e = err
			if e == nil {
				s.CR[0] = (s.CR[0] &^ 15) | (v & 15) | (s.CR[0] & 1)
				s.Flush()
			}
		}
	case "invlpg":
		if e = priv(); e == nil {
			s.invalidatePage(c.address(i.Dst, next))
		}
	case "lret":
		if s == nil {
			e = gp()
			break
		}
		var pc, sel uint64
		pc, e = pop()
		if e == nil {
			sel, e = pop()
		}
		if e == nil {
			e = s.segment(1, uint16(sel))
			next = pc
			c.R[RSP] += i.Src.Imm
		}
	case "iret":
		if s == nil {
			e = gp()
			break
		}
		sp := c.R[RSP]
		var v [5]uint64
		for j := range v {
			v[j], e = c.Memory.Read(sp+uint64(j*8), 8, false)
			if e != nil {
				break
			}
		}
		if e == nil {
			e = s.segment(1, uint16(v[1]))
			if e == nil {
				next, c.Flags, c.R[RSP] = v[0], v[2]|2, v[3]
				s.Segments[2].Selector = uint16(v[4])
			}
		}
	case "syscall":
		if s == nil {
			return false, nil
		}
		if s.EFER&1 == 0 {
			e = &Exception{Vector: 6}
			break
		}
		c.R[RCX], c.R[11] = next, c.Flags
		c.Flags &^= s.SFMASK
		next = s.LSTAR
		s.CPL = 0
		s.Segments[1].Selector = uint16(s.STAR>>32) &^ 3
		s.Segments[2].Selector = s.Segments[1].Selector + 8
	case "sysret":
		if e = priv(); e != nil {
			break
		}
		s.CPL = 3
		s.Segments[1].Selector = uint16(s.STAR>>48) + 16 | 3
		s.Segments[2].Selector = uint16(s.STAR>>48) + 8 | 3
		next = c.R[RCX]
		c.Flags = c.R[11] | 2
	case "int":
		if s == nil {
			e = fmt.Errorf("software interrupt without system context")
		} else {
			vector := uint8(i.Src.Imm)
			if s.MultiMode && s.CR[0]&1 != 0 {
				if c.Flags&(1<<17) != 0 && c.Flags>>12&3 < 3 {
					e = gp()
					break
				}
				width := uint64(8)
				if s.CodeBits() == 64 {
					width = 16
				}
				offset := uint64(vector) * width
				if offset+width-1 > uint64(s.IDTR.Limit) {
					e = &Exception{Vector: 13, Code: uint32(vector)*8 + 2, HasCode: true}
					break
				}
				oldSupervisor := s.supervisor
				s.supervisor = true
				gate, err := s.Read(s.IDTR.Base+offset, 8, false)
				s.supervisor = oldSupervisor
				if err != nil {
					e = err
					break
				}
				if s.CPL > uint8(gate>>45&3) {
					e = &Exception{Vector: 13, Code: uint32(vector)*8 + 2, HasCode: true}
					break
				}
			}
			c.PC = next
			e = s.Interrupt(vector, 0, false)
			next = c.PC
		}
	case "ud2":
		e = &Exception{Vector: 6}
	case "in", "out":
		port, err := read(i.Src, 2)
		e = err
		if e != nil {
			break
		}
		if e = s.allowIO(uint16(port), int(w)); e != nil {
			break
		}
		if s.Ports == nil {
			e = fmt.Errorf("no port bus")
			break
		}
		if i.Op == "in" {
			var value uint32
			value = s.Ports.In(uint16(port), int(w))
			if e == nil {
				e = write(Operand{Kind: regOperand, Reg: RAX}, w, uint64(value))
			}
		} else {
			s.Ports.Out(uint16(port), int(w), uint32(c.R[RAX]))
		}
	case "movs", "cmps", "stos", "lods", "scas":
		m := mask(i.AddressWidth)
		count := uint64(1)
		if i.Repeat != 0 {
			count = c.R[RCX] & m
		}
		if count == 0 {
			break
		}
		src, dst := c.R[RSI]&m, c.R[RDI]&m
		if s != nil {
			if i.Segment == 0x64 {
				src += s.FSBase
			}
			if i.Segment == 0x65 {
				src += s.GSBase
			}
		}
		var a, b uint64
		switch i.Op {
		case "movs", "cmps", "lods":
			a, e = c.Memory.Read(src, int(w), false)
		case "stos", "scas":
			a = c.R[RAX] & mask(w)
		}
		if e != nil {
			break
		}
		if i.Op == "cmps" || i.Op == "scas" {
			b, e = c.Memory.Read(dst, int(w), false)
			if e == nil {
				_, f := arithmetic(a, b, 0, w, true)
				c.Flags = c.Flags&^arithmeticFlags | f
			}
		}
		if i.Op == "movs" || i.Op == "stos" {
			e = c.Memory.Write(dst, int(w), a)
		}
		if i.Op == "lods" {
			e = write(Operand{Kind: regOperand, Reg: RAX}, w, a)
		}
		if e != nil {
			break
		}
		delta := uint64(w)
		if c.Flags&FlagDF != 0 {
			delta = -delta
		}
		if i.Op == "movs" || i.Op == "cmps" || i.Op == "lods" {
			c.R[RSI] = (c.R[RSI] + delta) & m
		}
		if i.Op != "lods" {
			c.R[RDI] = (c.R[RDI] + delta) & m
		}
		if i.Repeat != 0 {
			c.R[RCX] = (count - 1) & m
			again := c.R[RCX] != 0
			if i.Op == "cmps" || i.Op == "scas" {
				again = again && ((c.Flags&ZF != 0) == (i.Repeat == 0xf3))
			}
			if again {
				next = i.PC
			}
		}
	case "xchg", "xadd", "cmpxchg":
		a, err := read(i.Dst, w)
		e = err
		if e != nil {
			break
		}
		b, err := read(i.Src, w)
		e = err
		if e != nil {
			break
		}
		switch i.Op {
		case "xchg":
			e = write(i.Dst, w, b)
			if e == nil {
				e = write(i.Src, w, a)
			}
		case "xadd":
			v, f := arithmetic(a, b, 0, w, false)
			e = write(i.Dst, w, v)
			if e == nil {
				e = write(i.Src, w, a)
				c.Flags = c.Flags&^arithmeticFlags | f
			}
		case "cmpxchg":
			_, f := arithmetic(c.R[RAX], a, 0, w, true)
			if f&ZF != 0 {
				e = write(i.Dst, w, b)
			} else {
				e = write(Operand{Kind: regOperand, Reg: RAX}, w, a)
			}
			if e == nil {
				c.Flags = c.Flags&^arithmeticFlags | f
			}
		}
	case "bt", "bts", "btr", "btc":
		bit, err := read(i.Src, w)
		e = err
		if e != nil {
			break
		}
		dst := i.Dst
		if dst.Kind == memOperand && i.Src.Kind != immOperand {
			dst.Disp += (signed(bit, w) >> 3) &^ (int64(w) - 1)
		}
		bit &= uint64(w*8 - 1)
		v, err := read(dst, w)
		e = err
		if e != nil {
			break
		}
		c.Flags = c.Flags&^CF | (v>>bit)&1
		if i.Op != "bt" {
			switch i.Op {
			case "bts":
				v |= 1 << bit
			case "btr":
				v &^= 1 << bit
			case "btc":
				v ^= 1 << bit
			}
			e = write(dst, w, v)
		}
	case "bsf", "bsr":
		v, err := read(i.Src, w)
		e = err
		if e != nil {
			break
		}
		if v == 0 {
			c.Flags |= ZF
		} else {
			c.Flags &^= ZF
			n := bits.TrailingZeros64(v)
			if i.Op == "bsr" {
				n = 63 - bits.LeadingZeros64(v)
			}
			e = write(i.Dst, w, uint64(n))
		}
	case "bswap":
		v, err := read(i.Dst, w)
		e = err
		if e == nil {
			if w == 8 {
				v = bits.ReverseBytes64(v)
			} else {
				v = uint64(bits.ReverseBytes32(uint32(v)))
			}
			e = write(i.Dst, w, v)
		}
	case "shld", "shrd":
		a, err := read(i.Dst, w)
		e = err
		if e != nil {
			break
		}
		b, err := read(i.Src, w)
		e = err
		if e != nil {
			break
		}
		n := uint64(i.CC)
		if i.CC == 255 {
			n = c.R[RCX]
		}
		n &= 31
		if w == 8 {
			n = uint64(i.CC) & 63
			if i.CC == 255 {
				n = c.R[RCX] & 63
			}
		}
		if n == 0 {
			break
		}
		width := uint64(w) * 8
		var v, carry uint64
		if i.Op == "shld" {
			v = (a << n) | (b >> (width - n))
			carry = a >> (width - n) & 1
		} else {
			v = (a >> n) | (b << (width - n))
			carry = a >> (n - 1) & 1
		}
		e = write(i.Dst, w, v)
		if e == nil {
			f := szp(v, w) | carry
			if n == 1 && (a^v)>>(width-1)&1 != 0 {
				f |= OF
			}
			c.Flags = c.Flags&^arithmeticFlags | f
		}
	case "loop":
		take := false
		if i.CC == 3 {
			take = c.R[RCX]&mask(i.AddressWidth) == 0
		} else {
			c.R[RCX] = (c.R[RCX] - 1) & mask(i.AddressWidth)
			take = c.R[RCX] != 0
			if i.CC == 0 {
				take = take && c.Flags&ZF == 0
			}
			if i.CC == 1 {
				take = take && c.Flags&ZF != 0
			}
		}
		if take {
			next = i.Src.Imm
		}
	case "xlat":
		v, err := c.Memory.Read(c.R[RBX]+(c.R[RAX]&255), 1, false)
		e = err
		if e == nil {
			e = write(Operand{Kind: regOperand, Reg: RAX}, 1, v)
		}
	default:
		return false, nil
	}
	if e != nil {
		return true, e
	}
	c.PC = next
	c.Retired++
	return true, nil
}

-- flags_multiply_native_test.go --
package x86

import (
	"renvo.dev/internal/rfe/engine"
	"renvo.dev/internal/rfe/linuxuser"
	"testing"
)

func TestNativeSingleOperandMultiplyAndFlagControls(t *testing.T) {
	codes := [][]byte{{0xfc}, {0xfd}, {0xf8}, {0xf9}, {0xf5},
		{0xf6, 0xe3}, {0xf6, 0xeb}, {0xf6, 0xe4}, {0xf6, 0xec},
		{0x66, 0xf7, 0xe3}, {0x66, 0xf7, 0xeb}, {0xf7, 0xe3}, {0xf7, 0xeb},
		{0x48, 0xf7, 0xe3}, {0x48, 0xf7, 0xeb}, {0x48, 0xf7, 0xe0}, {0x48, 0xf7, 0xea}}
	values := []uint64{0, 1, 2, 0x7f, 0x80, 0xff, 0x7fff, 0x8000, 0xffff, 0x7fffffff, 0x80000000, 0xffffffff, 0x7fffffffffffffff, 0x8000000000000000, ^uint64(0)}
	for _, mode := range []string{"ir", "native"} {
		for _, code := range codes {
			base := testCPU(t, code)
			cfg := engine.DefaultEngineConfig()
			cfg.Mode, cfg.IRThreshold, cfg.NativeThreshold, cfg.MaxInstructions, cfg.MaxRegionInstructions = mode, 1, 1, 1, 1
			e, err := engine.New(cfg, Architecture())
			if err != nil {
				t.Fatal(err)
			}
			for _, a := range values {
				for _, rhs := range values {
					expected := *base
					expected.R[RAX], expected.R[RBX], expected.R[RDX] = a, rhs, 0xdeadbeef01234567
					expected.Flags = 2 | FlagIF | FlagDF | arithmeticFlags
					actual := expected
					adapter := NewAdapter(&actual)
					if err := expected.Step(); err != nil {
						t.Fatal(err)
					}
					if err := e.Step(adapter, 1); err != nil {
						t.Fatal(err)
					}
					adapter.Export()
					if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != expected.Retired {
						t.Fatalf("%s %x a=%x rhs=%x: registers=%x/%x flags=%x/%x", mode, code, a, rhs, actual.R, expected.R, actual.Flags, expected.Flags)
					}
				}
			}
			if mode == "native" && e.NativeAvailable() && e.Stats.Native < uint64(len(values)*len(values)-1) {
				t.Fatal("new operation stayed interpreted", code, e.Stats)
			}
			if err := e.Close(); err != nil {
				t.Fatal(err)
			}
		}
	}
}

func TestNativePushFlagsPreciseProtectedStack(t *testing.T) {
	for _, push := range [][]byte{{0x9c}, {0x66, 0x9c}} {
		code := append([]byte{0xfc}, push...)
		code = append(code, 0xeb, byte(256-len(code)-2))
		expected, actual := testCPU(t, code), testCPU(t, code)
		for _, c := range []*CPU{expected, actual} {
			if err := c.Memory.(*linuxuser.Memory).Map(0x4000, 8192, 3); err != nil {
				t.Fatal(err)
			}
			c.R[RSP] = 0x5800
			c.Flags = 2 | FlagDF | FlagIF | arithmeticFlags
		}
		cfg := engine.DefaultEngineConfig()
		cfg.IRThreshold, cfg.NativeThreshold = 1, 1
		e, err := engine.New(cfg, Architecture())
		if err != nil {
			t.Fatal(err)
		}
		adapter := NewAdapter(actual)
		for n := 0; n < 192; n++ {
			if err := expected.Step(); err != nil {
				t.Fatal(err)
			}
			if err := e.Step(adapter, 1); err != nil {
				t.Fatal(err)
			}
			adapter.Export()
		}
		if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != expected.Retired {
			t.Fatal("warmed flags stack differs")
		}
		for a := uint64(0x4000); a < 0x6000; a += 8 {
			x, _ := expected.Memory.Read(a, 8, false)
			y, _ := actual.Memory.Read(a, 8, false)
			if x != y {
				t.Fatalf("PUSHF stack differs at %x", a)
			}
		}
		if e.NativeAvailable() && e.Stats.Native == 0 {
			t.Fatal("PUSHF never native")
		}
		for _, c := range []*CPU{expected, actual} {
			c.PC = 0x1000
			c.Flags |= FlagDF
			if err := c.Memory.(*linuxuser.Memory).Protect(0x4000, 8192, 1); err != nil {
				t.Fatal(err)
			}
		}
		adapter.Import()
		if err := expected.Step(); err != nil {
			t.Fatal(err)
		}
		if err := expected.Step(); err == nil {
			t.Fatal("expected protected PUSHF fault")
		}
		if err := e.RunQuanta(adapter, 64); err == nil {
			t.Fatal("native PUSHF bypassed protection")
		}
		adapter.Export()
		if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != expected.Retired {
			t.Fatal("PUSHF fault lost preceding CLD or changed SP")
		}
		if err := e.Close(); err != nil {
			t.Fatal(err)
		}
	}
}

-- fwait_test.go --
package x86

import (
	"errors"
	"testing"
)

func TestFWAITExceptionsAndRetirement(t *testing.T) {
	for _, tc := range []struct {
		name            string
		cr0             uint64
		control, status uint16
		vector          uint8
	}{
		{"clear", 0x22, 0x37f, 0, 0},
		{"masked", 0x22, 0x37f, 0x3f, 0},
		{"ts_only", 0x28, 0x37f, 0, 0},
		{"mp_only", 0x22, 0x37f, 0, 0},
		{"em_only", 0x24, 0x37f, 0, 0},
		{"mp_ts", 0x2a, 0x37f, 0, 7},
		{"unmasked", 0x22, 0x37e, 1, 16},
		{"precision", 0x22, 0x35f, 0x20, 16},
		{"nm_before_mf", 0x2a, 0x37e, 1, 7},
	} {
		t.Run(tc.name, func(t *testing.T) {
			m := newSystemRAM()
			m.data[0x1000] = 0x9b
			c := &CPU{PC: 0x1000, Flags: 0xa43, FPControl: tc.control, FPStatus: tc.status}
			s := NewSystem(c, m, nil)
			s.CR[0] = tc.cr0
			c.R[RAX] = 0x12345678
			i, err := Decode(c.Memory, c.PC)
			if err != nil || i.Op != "fwait" || i.Next != 0x1001 {
				t.Fatalf("decode: %+v %v", i, err)
			}
			err = c.Execute(i)
			if tc.vector != 0 {
				var ex *Exception
				if !errors.As(err, &ex) || ex.Vector != tc.vector || ex.HasCode {
					t.Fatalf("expected exception %d, got %v", tc.vector, err)
				}
				if c.PC != 0x1000 || c.Retired != 0 {
					t.Fatalf("fault retired or advanced PC: %#x %d", c.PC, c.Retired)
				}
			} else if err != nil || c.PC != 0x1001 || c.Retired != 1 {
				t.Fatalf("retirement: %#x %d %v", c.PC, c.Retired, err)
			}
			if c.Flags != 0xa43 || c.R[RAX] != 0x12345678 || c.FPControl != tc.control || c.FPStatus != tc.status {
				t.Fatal("WAIT modified architectural data")
			}
		})
	}
}

func TestFWAITPrefixesAndFINITBoundary(t *testing.T) {
	c := testCPU(t, []byte{0x66, 0x9b, 0xdb, 0xe3})
	c.FPControl, c.FPStatus = 0x37f, 0x3f
	step(t, c)
	if c.PC != 0x1002 || c.Retired != 1 || c.FPStatus != 0x3f {
		t.Fatal("WAIT consumed following FNINIT or altered status")
	}
	step(t, c)
	if c.PC != 0x1004 || c.Retired != 2 || c.FPControl != 0x37f || c.FPStatus != 0 {
		t.Fatal("FNINIT did not execute separately")
	}
	c = testCPU(t, []byte{0xf0, 0x9b})
	var ex *Exception
	if _, err := Decode(c.Memory, c.PC); !errors.As(err, &ex) || ex.Vector != 6 {
		t.Fatalf("LOCK WAIT must raise #UD: %v", err)
	}
}

-- gates.go --
package x86

func (s *System) returnCode(sel uint16, target uint64) error {
	rpl := uint8(sel & 3)
	bad := func() error { return &Exception{Vector: 13, Code: uint32(sel &^ 3), HasCode: true} }
	if sel&^3 == 0 || rpl < s.CPL {
		return bad()
	}
	d, err := s.descriptor(sel)
	if err != nil {
		return err
	}
	dpl := uint8(d.Flags >> 5 & 3)
	if d.Flags&0x18 != 0x18 || (d.Flags&4 == 0 && dpl != rpl) || (d.Flags&4 != 0 && dpl > rpl) {
		return bad()
	}
	if d.Flags&128 == 0 {
		return &Exception{Vector: 11, Code: uint32(sel &^ 3), HasCode: true}
	}
	if target > uint64(d.Limit) {
		return gp()
	}
	return nil
}

// privilegeStack reads the active 286 or 386 TSS without treating supervisor
// descriptor/TSS accesses as user memory references.
func (s *System) privilegeStack(level uint8) (uint64, uint16, error) {
	old := s.supervisor
	s.supervisor = true
	defer func() { s.supervisor = old }()
	kind := s.TR.Flags & 15
	off := uint64(4 + 8*level)
	width := 4
	if kind == 1 || kind == 3 {
		off = uint64(2 + 4*level)
		width = 2
	} else if kind != 9 && kind != 11 {
		return 0, 0, gp()
	}
	if off+uint64(width)+1 > uint64(s.TR.Limit) {
		return 0, 0, &Exception{Vector: 10, Code: uint32(s.TR.Selector &^ 3), HasCode: true}
	}
	sp, err := s.Read(s.TR.Base+off, width, false)
	if err != nil {
		return 0, 0, err
	}
	ss, err := s.Read(s.TR.Base+off+uint64(width), 2, false)
	return sp, uint16(ss), err
}

func (s *System) farTransfer(sel uint16, target, next uint64, w uint8, call bool) (uint64, error) {
	c := s.CPU
	oldCS, oldSS, oldSP, oldCPL := s.Segments[1].Selector, s.Segments[2].Selector, c.R[RSP], s.CPL
	pushReturn := func() error {
		if err := c.push(uint64(oldCS), w); err != nil {
			return err
		}
		return c.push(next, w)
	}
	if s.CR[0]&1 == 0 || c.Flags&(1<<17) != 0 {
		if call {
			if err := pushReturn(); err != nil {
				return 0, err
			}
		}
		return target, s.segment(1, sel)
	}
	d, err := s.descriptor(sel)
	if err != nil {
		return 0, err
	}
	if d.Flags&16 == 0 {
		kind := d.Flags & 15
		if kind != 4 && kind != 12 {
			return 0, gp()
		}
		gateDPL := uint8(d.Flags >> 5 & 3)
		if oldCPL > gateDPL || uint8(sel&3) > gateDPL {
			return 0, &Exception{Vector: 13, Code: uint32(sel &^ 3), HasCode: true}
		}
		if d.Flags&128 == 0 {
			return 0, &Exception{Vector: 11, Code: uint32(sel &^ 3), HasCode: true}
		}
		table := s.GDTR
		if sel&4 != 0 {
			table = Table{Base: s.LDTR.Base, Limit: uint16(s.LDTR.Limit)}
		}
		old := s.supervisor
		s.supervisor = true
		gate, e := s.Read(table.Base+uint64(sel&^7), 8, false)
		s.supervisor = old
		if e != nil {
			return 0, e
		}
		target = gate & 65535
		w = 2
		if kind == 12 {
			target |= gate >> 48 << 16
			w = 4
		}
		sel = uint16(gate >> 16)
		d, err = s.descriptor(sel)
		if err != nil {
			return 0, err
		}
		level := uint8(d.Flags >> 5 & 3)
		if d.Flags&0x18 != 0x18 || level > oldCPL {
			return 0, gp()
		}
		if d.Flags&128 == 0 {
			return 0, &Exception{Vector: 11, Code: uint32(sel &^ 3), HasCode: true}
		}
		if d.Flags&4 != 0 {
			level = oldCPL
		}
		if level < oldCPL {
			if !call {
				return 0, gp()
			}
			count := int(gate >> 32 & 31)
			var args [31]uint64
			for j := 0; j < count; j++ {
				a, e := s.segmentAddress(2, (oldSP+uint64(j)*uint64(w))&c.stackMask(), int(w), false, false)
				if e != nil {
					return 0, e
				}
				args[j], err = c.Memory.Read(a, int(w), false)
				if err != nil {
					return 0, err
				}
			}
			sp, ss, e := s.privilegeStack(level)
			if e != nil {
				return 0, e
			}
			s.CPL = level
			if err = s.segment(2, ss); err != nil {
				return 0, err
			}
			c.setSP(sp)
			if err = c.push(uint64(oldSS), w); err != nil {
				return 0, err
			}
			if err = c.push(oldSP, w); err != nil {
				return 0, err
			}
			for j := count - 1; j >= 0; j-- {
				if err = c.push(args[j], w); err != nil {
					return 0, err
				}
			}
		}
		sel = sel&^3 | uint16(level)
	} else {
		level := uint8(d.Flags >> 5 & 3)
		if d.Flags&8 == 0 || uint8(sel&3) > oldCPL || (d.Flags&4 == 0 && level != oldCPL) || (d.Flags&4 != 0 && level > oldCPL) {
			return 0, gp()
		}
		sel = sel&^3 | uint16(oldCPL)
	}
	if d.Flags&128 == 0 {
		return 0, &Exception{Vector: 11, Code: uint32(sel &^ 3), HasCode: true}
	}
	if target > uint64(d.Limit) {
		return 0, gp()
	}
	if call {
		if err = pushReturn(); err != nil {
			return 0, err
		}
	}
	return target, s.segment(1, sel)
}

-- gates_test.go --
package x86

import (
	"errors"
	"testing"
)

func TestLegacyCallGateCopiesParametersAndReturnsAcrossPrivilege(t *testing.T) {
	for _, w := range []uint8{2, 4} {
		t.Run(string(rune('0'+w)), func(t *testing.T) {
			c, s := protectedTestCPU(t)
			m := s.Physical
			s.GDTR.Limit = 55
			flags := uint64(0)
			limit := uint32(65535)
			if w == 4 {
				flags = 0x0040000000000000
				limit = 0xffffffff
			}
			m.Write(0x508, 8, flags|0x00009a000000ffff)
			m.Write(0x510, 8, flags|0x000092000000ffff)
			m.Write(0x518, 8, flags|0x0000fa000000ffff)
			m.Write(0x520, 8, flags|0x0000f2000000ffff)
			kind := uint64(4)
			trFlags := uint16(0x83)
			if w == 4 {
				kind = 12
				trFlags = 0x8b
			}
			m.Write(0x528, 8, 0x2000|8<<16|2<<32|(0xe0|kind)<<40)
			s.TR = Segment{Selector: 48, Base: 0x3000, Limit: 0x67, Flags: trFlags}
			if w == 2 {
				m.Write(0x3002, 2, 0x9000)
				m.Write(0x3004, 2, 16)
			} else {
				m.Write(0x3004, 4, 0x9000)
				m.Write(0x3008, 2, 16)
			}
			db := uint16(0)
			if w == 4 {
				db = 0x4000
			}
			s.CPL = 3
			s.Segments[1] = Segment{Selector: 0x1b, Limit: limit, Flags: db | 0xfb}
			s.Segments[2] = Segment{Selector: 0x23, Limit: limit, Flags: db | 0xf3}
			c.R[RSP] = 0x8000
			c.Flags = 0x3202
			m.Write(0x8000, int(w), 0xaaaa)
			m.Write(0x8000+uint64(w), int(w), 0xbbbb)
			i := Instruction{PC: 0x1000, Next: 0x1007, Op: "farcall", Dst: immediate(0x2b), Src: immediate(0), Width: w}
			if err := c.Execute(i); err != nil {
				t.Fatal(err)
			}
			if c.PC != 0x2000 || c.R[RSP] != 0x9000-uint64(6*w) || s.CPL != 0 || s.Segments[2].Selector != 16 {
				t.Fatalf("entry PC%x SP%x CPL%d SS%x", c.PC, c.R[RSP], s.CPL, s.Segments[2].Selector)
			}
			for j, want := range []uint64{0x1007, 0x1b, 0xaaaa, 0xbbbb, 0x8000, 0x23} {
				got, e := m.Read(c.R[RSP]+uint64(j)*uint64(w), int(w), false)
				if e != nil || got != want {
					t.Fatalf("frame[%d]=%x want%x err%v", j, got, want, e)
				}
			}
			if err := c.Execute(Instruction{PC: 0x2000, Next: 0x2003, Op: "lret", Src: immediate(uint64(2 * w)), Width: w}); err != nil {
				t.Fatal(err)
			}
			if c.PC != 0x1007 || s.CPL != 3 || s.Segments[1].Selector != 0x1b || s.Segments[2].Selector != 0x23 || c.R[RSP] != 0x8000+uint64(2*w) {
				t.Fatalf("return PC%x SP%x CPL%d CS%x SS%x", c.PC, c.R[RSP], s.CPL, s.Segments[1].Selector, s.Segments[2].Selector)
			}
		})
	}
}
func TestLegacyDemandCodeNotPresentPrecedesPlaceholderLimit(t *testing.T) {
	c, s := protectedTestCPU(t)
	s.GDTR.Limit = 31
	s.Physical.Write(0x518, 8, 0x00007a0000000000)
	s.CPL = 3
	c.R[RSP] = 0x8000
	_, err := s.farTransfer(0x1b, 0x1234, 0x1005, 2, true)
	var ex *Exception
	if !errors.As(err, &ex) || ex.Vector != 11 || ex.Code != 24 || c.R[RSP] != 0x8000 {
		t.Fatalf("demand load must fault #NP before #GP limit: %v SP%x", err, c.R[RSP])
	}
}
func TestLegacyReturnCannotAcquireInnerPrivilege(t *testing.T) {
	c, s := protectedTestCPU(t)
	s.CPL = 3
	err := s.returnCode(8, 0)
	var ex *Exception
	if !errors.As(err, &ex) || ex.Vector != 13 || ex.Code != 8 {
		t.Fatalf("return to inner ring accepted: %v", err)
	}
	_ = c
}
func TestLegacyVM86FlagStackFaultsAreRestartable(t *testing.T) {
	for _, op := range []string{"pushf", "popf", "iret", "int"} {
		t.Run(op, func(t *testing.T) {
			c, s, m := legacyCPU(t, []byte{0x90})
			s.CR[0] = 1
			s.CPL = 3
			c.Flags = 0x20202
			m.Write(0x8000, 4, 0x3003)
			err := c.Execute(Instruction{PC: 0x1000, Next: 0x1001, Op: op, Width: 2})
			var ex *Exception
			if !errors.As(err, &ex) || ex.Vector != 13 || c.R[RSP] != 0x8000 || c.PC != 0x1000 || c.Flags != 0x20202 {
				t.Fatalf("%s GP changed state: err%v SP%x PC%x flags%x", op, err, c.R[RSP], c.PC, c.Flags)
			}
		})
	}
}
func TestLegacySegmentRegisterMoveHonorsRegisterAndMemoryWidths(t *testing.T) {
	c, s, m := legacyCPU(t, []byte{0x8c, 0xd8, 0x66, 0x8c, 0xd8, 0x66, 0x8c, 0x1e, 0, 0x80})
	s.Segments[3].Selector = 0x1234
	c.R[RAX] = 0xdeadbeeffedcba98
	m.Write(0x8000, 4, 0xaabbccdd)
	step(t, c)
	if c.R[RAX] != 0xdeadbeeffedc1234 {
		t.Fatalf("MOV AX,DS: %x", c.R[RAX])
	}
	step(t, c)
	if c.R[RAX] != 0x1234 {
		t.Fatalf("MOV EAX,DS did not zero extend: %x", c.R[RAX])
	}
	step(t, c)
	got, _ := m.Read(0x8000, 4, false)
	if got != 0xaabb1234 {
		t.Fatalf("MOV memory,DS overwrote next word: %x", got)
	}
}

-- half_test.go --
package x86

import (
	"encoding/binary"
	"testing"
)

func TestSSEHalfMoves(t *testing.T) {
	for _, test := range []struct {
		code   []byte
		lo, hi uint64
	}{
		{[]byte{0x0f, 0x16, 0xc1}, 1, 3},       // MOVLHPS
		{[]byte{0x0f, 0x12, 0xc1}, 4, 2},       // MOVHLPS
		{[]byte{0x0f, 0x16, 0xc0}, 1, 1},       // aliased MOVLHPS
		{[]byte{0x0f, 0x12, 0xc0}, 2, 2},       // aliased MOVHLPS
		{[]byte{0x0f, 0x16, 0x00}, 1, 5},       // MOVHPS memory
		{[]byte{0x66, 0x0f, 0x12, 0x00}, 5, 2}, // MOVLPD memory
	} {
		c := testCPU(t, test.code)
		c.R[RAX] = 0x1800
		c.Memory.Write(0x1800, 8, 5)
		binary.LittleEndian.PutUint64(c.XMM[0][:], 1)
		binary.LittleEndian.PutUint64(c.XMM[0][8:], 2)
		binary.LittleEndian.PutUint64(c.XMM[1][:], 3)
		binary.LittleEndian.PutUint64(c.XMM[1][8:], 4)
		step(t, c)
		if binary.LittleEndian.Uint64(c.XMM[0][:]) != test.lo || binary.LittleEndian.Uint64(c.XMM[0][8:]) != test.hi {
			t.Fatalf("%x: %x", test.code, c.XMM[0])
		}
	}
	c := testCPU(t, []byte{0x0f, 0x17, 0x00}) // MOVHPS [RAX],XMM0
	c.R[RAX] = 0x1800
	binary.LittleEndian.PutUint64(c.XMM[0][8:], 0x1122334455667788)
	c.Memory.Write(0x1808, 8, 99)
	step(t, c)
	if got, _ := c.Memory.Read(0x1800, 8, false); got != 0x1122334455667788 {
		t.Fatal("high-half store", got)
	}
	if got, _ := c.Memory.Read(0x1808, 8, false); got != 99 {
		t.Fatal("half store overwrote adjacent memory", got)
	}
}

-- irq.go --
package x86

func (s *System) Interruptible() bool { return s.CPU.Flags&FlagIF != 0 && s.IRQShadow == 0 }

-- legacy.go --
package x86

import (
	"errors"
	"fmt"
)

// NewPCSystem enables real, protected, compatibility and long-mode decoding.
// PCJIT supplies mode-aware lowering; the original Architecture() ABI remains
// long-mode only. CPU.Step is the architectural reference in every mode.
func NewPCSystem(c *CPU, physical Memory, ports PortBus) *System {
	s := NewSystem(c, physical, ports)
	s.MultiMode = true
	s.CR[0] = 0x10
	s.IDTR.Limit = 0x3ff
	for j := range s.Segments {
		s.Segments[j] = Segment{Limit: 65535, Flags: 0x93}
	}
	s.Segments[1].Flags = 0x9b
	c.FPControl = 0x37f
	return s
}
func (s *System) CodeBits() int {
	if !s.MultiMode || s.EFER&(1<<10) != 0 && s.Segments[1].Flags&(1<<13) != 0 {
		return 64
	}
	if s.CR[0]&1 != 0 && s.CPU.Flags&(1<<17) == 0 && s.Segments[1].Flags&(1<<14) != 0 {
		return 32
	}
	return 16
}
func (s *System) legacy() bool { return s.MultiMode && s.CodeBits() != 64 }
func segmentIndex(prefix uint8) int {
	switch prefix {
	case 0x26:
		return 0
	case 0x2e:
		return 1
	case 0x36:
		return 2
	case 0x64:
		return 4
	case 0x65:
		return 5
	}
	return 3
}

type codeMemory struct{ s *System }

func (m codeMemory) Read(a uint64, n int, execute bool) (uint64, error) {
	address, err := m.s.segmentAddress(1, a, n, false, true)
	if err != nil {
		return 0, err
	}
	return m.s.Read(address, n, execute)
}
func (m codeMemory) Write(a uint64, n int, v uint64) error {
	return fmt.Errorf("write through instruction fetch bus")
}
func (m codeMemory) Peek(a uint64, n int) (uint64, bool) { return 0, false }
func (s *System) legacyStep() error {
	if s.Halted {
		return nil
	}
	i, err := DecodeMode(codeMemory{s}, s.CPU.PC, s.CodeBits())
	return s.executeLegacyDecoded(i, err)
}

// executeLegacyDecoded is also the architectural slow boundary for a JIT
// instruction whose bytes/mode/execute permission were already validated.
// The same rollback, fault RF, clock and interrupt-shadow rules apply.
func (s *System) executeLegacyDecoded(i Instruction, err error) error {
	if s.Halted {
		return nil
	}
	c := s.CPU
	bits := s.CodeBits()
	if err != nil {
		var ex *Exception
		if errors.As(err, &ex) {
			c.Flags |= 1 << 16 // Fault frames set RF, unlike software INT and external IRQ frames.
			return s.Interrupt(ex.Vector, ex.Code, ex.HasCode)
		}
		return err
	}
	// Faults and caller-serviced device exits restart the same instruction.
	// Preserve partial register/segment effects of multi-access stack operations;
	// page-table A/D writes are architectural side effects and remain visible.
	if err = c.executeLegacyRestartable(i, bits); err != nil {
		var ex *Exception
		if errors.As(err, &ex) {
			c.Flags |= 1 << 16 // Fault frames set RF, unlike software INT and external IRQ frames.
			return s.Interrupt(ex.Vector, ex.Code, ex.HasCode)
		}
		return fmt.Errorf("%d-bit cs=%#x pc=%#x %s: %w", bits, s.Segments[1].Selector, c.PC, i.Op, err)
	}
	if i.Op != "iret" {
		c.Flags &^= 1 << 16
	}
	// A far jump may have installed a different default code size.
	if s.CodeBits() != 64 {
		c.PC &= mask(uint8(s.CodeBits() / 8))
	}
	if !s.ExternalClock {
		s.TSC += TSCTicksPerInstruction
	}
	if s.IRQShadow > 0 {
		s.IRQShadow--
	}
	return nil
}
func (c *CPU) stackMask() uint64 {
	s := c.System
	if s != nil && s.legacy() {
		if s.CR[0]&1 == 0 || c.Flags&(1<<17) != 0 || s.Segments[2].Flags&(1<<14) == 0 {
			return 65535
		}
		return 0xffffffff
	}
	return ^uint64(0)
}
func (c *CPU) stackAddress(sp uint64) uint64 {
	if c.System != nil && c.System.legacy() {
		return c.System.Segments[2].Base + (sp & c.stackMask())
	}
	return sp
}
func (c *CPU) setSP(sp uint64) { m := c.stackMask(); c.R[RSP] = c.R[RSP]&^m | sp&m }
func (c *CPU) push(v uint64, w uint8) error {
	sp := (c.R[RSP] - uint64(w)) & c.stackMask()
	a := c.stackAddress(sp)
	if c.System != nil && c.System.legacy() {
		var err error
		a, err = c.System.segmentAddress(2, sp, int(w), true, false)
		if err != nil {
			return err
		}
	}
	if err := c.Memory.Write(a, int(w), v); err != nil {
		return err
	}
	c.setSP(sp)
	return nil
}
func (c *CPU) pop(w uint8) (uint64, error) {
	a := c.stackAddress(c.R[RSP])
	if c.System != nil && c.System.legacy() {
		var err error
		a, err = c.System.segmentAddress(2, c.R[RSP]&c.stackMask(), int(w), false, false)
		if err != nil {
			return 0, err
		}
	}
	v, err := c.Memory.Read(a, int(w), false)
	if err == nil {
		c.setSP(c.R[RSP] + uint64(w))
	}
	return v, err
}
func (s *System) legacyInterrupt(vector uint8, code uint32, hasCode bool) error {
	c := s.CPU
	w := uint8(2)
	flags := c.Flags
	var target, selector uint64
	gate := uint64(6)
	oldSP, oldSS, oldCS := c.R[RSP], s.Segments[2].Selector, s.Segments[1].Selector
	oldSegments := s.Segments
	vm := flags&(1<<17) != 0
	if s.CR[0]&1 == 0 {
		off := uint64(vector) * 4
		if off+3 > uint64(s.IDTR.Limit) {
			return gp()
		}
		v, err := s.Read(s.IDTR.Base+off, 4, false)
		if err != nil {
			return err
		}
		target, selector = v&65535, v>>16
	} else {
		oldSupervisor := s.supervisor
		s.supervisor = true
		defer func() { s.supervisor = oldSupervisor }()
		off := uint64(vector) * 8
		if off+7 > uint64(s.IDTR.Limit) {
			return gp()
		}
		v, err := s.Read(s.IDTR.Base+off, 8, false)
		if err != nil {
			return err
		}
		gate = v >> 40 & 31
		if v&(1<<47) == 0 || gate != 6 && gate != 7 && gate != 14 && gate != 15 {
			return fmt.Errorf("unsupported legacy IDT gate %#x", v)
		}
		target, selector = v&65535, v>>16&65535
		if gate >= 14 {
			w = 4
			target |= v >> 48 << 16
		}
		desc, err := s.descriptor(uint16(selector))
		if err != nil {
			return err
		}
		newCPL := uint8(desc.Flags >> 5 & 3)
		if newCPL > s.CPL {
			return gp()
		}
		if newCPL < s.CPL || vm {
			sp, ss, err := s.privilegeStack(newCPL)
			if err != nil {
				return err
			}
			c.Flags &^= 1 << 17
			s.CPL = newCPL
			s.Segments[1] = desc
			if err = s.segment(2, uint16(ss)); err != nil {
				return err
			}
			c.R[RSP] = sp
			if vm {
				for _, index := range []int{5, 4, 3, 0} {
					if err = c.push(uint64(oldSegments[index].Selector), w); err != nil {
						return err
					}
				}
			}
			if err = c.push(uint64(oldSS), w); err != nil {
				return err
			}
			if err = c.push(oldSP, w); err != nil {
				return err
			}
		}
	}
	for _, v := range []uint64{flags | 2, uint64(oldCS), c.PC} {
		if err := c.push(v, w); err != nil {
			return err
		}
	}
	if hasCode && s.CR[0]&1 != 0 {
		if err := c.push(uint64(code), w); err != nil {
			return err
		}
	}
	c.Flags &^= 1 << 17
	if err := s.segment(1, uint16(selector)); err != nil {
		return err
	}
	c.PC = target
	c.Flags &^= 1<<8 | 1<<16
	if s.CR[0]&1 != 0 {
		c.Flags &^= 1 << 14
	}
	if gate == 6 || gate == 14 {
		c.Flags &^= FlagIF
	}
	if vm {
		for _, index := range []int{0, 3, 4, 5} {
			s.Segments[index] = Segment{}
		}
	}
	s.Halted = false
	return nil
}

func (c *CPU) executeLegacy(i Instruction) (bool, error) {
	s, w, next := c.System, i.Width, i.Next
	var err error
	switch i.Op {
	case "bound":
		a := c.address(i.Src, next)
		var lo, hi, v uint64
		v, err = c.read(i.Dst, w, next)
		if err == nil {
			lo, err = c.Memory.Read(a, int(w), false)
		}
		if err == nil {
			hi, err = c.Memory.Read(a+uint64(w), int(w), false)
		}
		if err == nil && (signed(v, w) < signed(lo, w) || signed(v, w) > signed(hi, w)) {
			return true, &Exception{Vector: 5}
		}
	case "ins", "outs":
		aw := i.AddressWidth
		m := mask(aw)
		if i.Repeat != 0 && c.R[RCX]&m == 0 {
			break
		}
		port := uint16(c.R[RDX])
		if err = s.allowIO(port, int(w)); err != nil {
			break
		}
		if s.Ports == nil {
			return true, fmt.Errorf("no port bus")
		}
		reg := RSI
		if i.Op == "ins" {
			reg = RDI
		}
		seg := i.Segment
		if seg == 0 {
			seg = 0x3e
		}
		if i.Op == "ins" {
			seg = 0x26
		}
		a, addressErr := s.segmentAddress(segmentIndex(seg), c.R[reg]&m, int(w), i.Op == "ins", false)
		if addressErr != nil {
			return true, addressErr
		}
		var v uint64
		if i.Op == "outs" {
			v, err = c.Memory.Read(a, int(w), false)
			if err == nil {
				err = s.portWrite(port, int(w), uint32(v))
			}
		} else {
			for j := uint8(0); j < w; j++ {
				if _, err = s.translate(a+uint64(j), true, false); err != nil {
					break
				}
			}
			if err == nil {
				var value uint32
				value, err = s.portRead(port, int(w))
				v = uint64(value)
			}
			if err == nil {
				err = c.Memory.Write(a, int(w), v)
			}
		}
		if err != nil {
			break
		}
		delta := uint64(w)
		if c.Flags&FlagDF != 0 {
			delta = -delta
		}
		c.R[reg] = c.R[reg]&^m | (c.R[reg]+delta)&m
		if i.Repeat != 0 {
			c.R[RCX] = c.R[RCX]&^m | (c.R[RCX]-1)&m
			if c.R[RCX]&m != 0 {
				next = i.PC
			}
		}
	case "lar", "lsl":
		if s.CR[0]&1 == 0 || c.Flags&(1<<17) != 0 {
			return true, &Exception{Vector: 6}
		}
		var sel uint64
		sel, err = c.read(i.Src, 2, next)
		if err != nil {
			break
		}
		table := s.GDTR
		if sel&4 != 0 {
			table = Table{Base: s.LDTR.Base, Limit: uint16(s.LDTR.Limit)}
		}
		c.Flags &^= ZF
		if sel&^3 == 0 || sel&4 != 0 && s.LDTR.Selector&^3 == 0 || uint64(uint16(sel)&^7)+7 > uint64(table.Limit) {
			break
		}
		var d Segment
		d, err = s.descriptor(uint16(sel))
		if err != nil {
			break
		}
		code := d.Flags&0x18 == 0x18
		conforming := code && d.Flags&4 != 0
		dpl := uint8(d.Flags >> 5 & 3)
		if !conforming && (s.CPL > dpl || uint8(sel&3) > dpl) {
			break
		}
		if d.Flags&16 == 0 {
			kind := d.Flags & 15
			allowed := kind == 1 || kind == 2 || kind == 3 || kind == 9 || kind == 11
			if i.Op == "lar" {
				allowed = allowed || kind == 4 || kind == 5 || kind == 12
			}
			if !allowed {
				break
			}
		}
		v := uint64(d.Limit)
		if i.Op == "lar" {
			v = uint64(d.Flags) << 8 & 0x00f0ff00
		}
		err = c.write(i.Dst, w, next, v)
		if err == nil {
			c.Flags |= ZF
		}
	case "arpl":
		if s.CR[0]&1 == 0 || c.Flags&(1<<17) != 0 {
			return true, &Exception{Vector: 6}
		}
		var a, b uint64
		a, err = c.read(i.Dst, 2, next)
		if err == nil {
			b, err = c.read(i.Src, 2, next)
		}
		if err != nil {
			break
		}
		c.Flags &^= ZF
		if a&3 < b&3 {
			err = c.write(i.Dst, 2, next, a&^3|b&3)
			if err == nil {
				c.Flags |= ZF
			}
		}
	case "enter":
		bp := c.R[RBP] & mask(w)
		err = c.push(bp, w)
		frame := c.R[RSP]
		level := i.Src.Imm & 31
		if err == nil {
			for j := uint64(1); j < level; j++ {
				bp = (bp - uint64(w)) & mask(w)
				var v uint64
				v, err = c.Memory.Read(c.stackAddress(bp), int(w), false)
				if err == nil {
					err = c.push(v, w)
				}
				if err != nil {
					break
				}
			}
		}
		if err == nil && level != 0 {
			err = c.push(frame, w)
		}
		if err == nil {
			err = c.write(Operand{Kind: regOperand, Reg: RBP}, w, next, frame)
			c.setSP(c.R[RSP] - i.Dst.Imm)
		}
	case "xlat":
		seg := i.Segment
		if seg == 0 {
			seg = 0x3e
		}
		a := (c.R[RBX] + (c.R[RAX] & 255)) & mask(i.AddressWidth)
		var v uint64
		v, err = c.Memory.Read(s.Segments[segmentIndex(seg)].Base+a, 1, false)
		if err == nil {
			c.R[RAX] = c.R[RAX]&^255 | v
		}
	case "aam", "aad":
		al, ah, base := c.R[RAX]&255, c.R[RAX]>>8&255, i.Src.Imm
		if i.Op == "aam" {
			if base == 0 {
				return true, &Exception{Vector: 0}
			}
			ah, al = al/base, al%base
		} else {
			al, ah = (al+ah*base)&255, 0
		}
		c.R[RAX] = c.R[RAX]&^65535 | ah<<8 | al
		c.Flags = c.Flags&^(SF|ZF|PF) | szp(al, 1)
	case "daa", "das":
		old, carry := c.R[RAX]&255, c.Flags&CF != 0
		al := old
		f := c.Flags &^ (AF | CF | SF | ZF | PF)
		if old&15 > 9 || c.Flags&AF != 0 {
			if i.Op == "daa" {
				al = (al + 6) & 255
			} else {
				al = (al - 6) & 255
			}
			f |= AF
		}
		if old > 0x99 || carry {
			if i.Op == "daa" {
				al = (al + 0x60) & 255
			} else {
				al = (al - 0x60) & 255
			}
			f |= CF
		}
		if i.Op == "das" && (old&15 > 9 || c.Flags&AF != 0) && old < 6 {
			f |= CF
		}
		c.R[RAX] = c.R[RAX]&^255 | al
		c.Flags = f | szp(al, 1)
	case "aaa", "aas":
		ax := c.R[RAX] & 65535
		f := c.Flags &^ (AF | CF)
		if ax&15 > 9 || c.Flags&AF != 0 {
			if i.Op == "aaa" {
				ax += 0x106
			} else {
				ax -= 0x106
			}
			f |= AF | CF
		}
		c.R[RAX] = c.R[RAX]&^65535 | ax&0xff0f
		c.Flags = f
	case "rcl", "rcr":
		var v, count uint64
		v, err = c.read(i.Dst, w, next)
		if err == nil {
			count, err = c.read(i.Src, 1, next)
		}
		if err != nil {
			break
		}
		count &= 31
		if w < 4 {
			count %= uint64(w)*8 + 1
		}
		if count == 0 {
			break
		}
		old, carry := v, c.Flags&CF
		bits := uint(w) * 8
		for j := uint64(0); j < count; j++ {
			if i.Op == "rcl" {
				newCarry := v >> (bits - 1) & 1
				v = (v<<1 | carry) & mask(w)
				carry = newCarry
			} else {
				newCarry := v & 1
				v = v>>1 | carry<<(bits-1)
				carry = newCarry
			}
		}
		err = c.write(i.Dst, w, next, v)
		if err == nil {
			c.Flags = c.Flags&^CF | carry
			if count == 1 {
				c.Flags &^= OF
				overflow := (v >> (bits - 1)) ^ carry
				if i.Op == "rcr" {
					overflow = (old ^ v) >> (bits - 1)
				}
				c.Flags |= (overflow & 1) << 11
			}
		}
	case "loadfar":
		a := c.address(i.Src, next)
		var v, sel uint64
		v, err = c.Memory.Read(a, int(w), false)
		if err == nil {
			sel, err = c.Memory.Read(a+uint64(w), 2, false)
		}
		if err == nil {
			err = s.segment(i.CC, uint16(sel))
			if err == nil && i.CC == 2 {
				s.IRQShadow = 2
			}
		}
		if err == nil {
			err = c.write(i.Dst, w, next, v)
		}
	case "pusha":
		old := c.R[RSP]
		for _, r := range []int{RAX, RCX, RDX, RBX, RSP, RBP, RSI, RDI} {
			v := c.R[r]
			if r == RSP {
				v = old
			}
			if err = c.push(v, w); err != nil {
				break
			}
		}
	case "popa":
		for _, r := range []int{RDI, RSI, RBP, RSP, RBX, RDX, RCX, RAX} {
			var v uint64
			v, err = c.pop(w)
			if err != nil {
				break
			}
			if r != RSP {
				err = c.write(Operand{Kind: regOperand, Reg: r}, w, next, v)
				if err != nil {
					break
				}
			}
		}
	case "push":
		var v uint64
		v, err = c.read(i.Dst, w, next)
		if err == nil {
			err = c.push(v, w)
		}
	case "pop":
		var v uint64
		v, err = c.pop(w)
		if err == nil {
			err = c.write(i.Dst, w, next, v)
		}
	case "pushf":
		if s.CR[0]&1 != 0 && c.Flags&(1<<17) != 0 && c.Flags>>12&3 < 3 {
			return true, gp()
		}
		err = c.push(c.Flags&^(1<<16|1<<17)|2, w)
	case "popf":
		if s.CR[0]&1 != 0 && c.Flags&(1<<17) != 0 && c.Flags>>12&3 < 3 {
			return true, gp()
		}
		var v uint64
		v, err = c.pop(w)
		if err == nil {
			m := mask(w) & 0x257fd5 // POPF never changes VM, RF, VIF or VIP.
			if s.CR[0]&1 != 0 {
				if s.CPL != 0 {
					m &^= 0x3000
				}
				if s.CPL > uint8(c.Flags>>12&3) {
					m &^= FlagIF
				}
			}
			c.Flags = c.Flags&^m | v&m | 2
		}
	case "pushseg":
		err = c.push(uint64(s.Segments[i.CC].Selector), w)
	case "popseg":
		var v uint64
		v, err = c.pop(w)
		if err == nil {
			err = s.segment(i.CC, uint16(v))
			if i.CC == 2 {
				s.IRQShadow = 2
			}
		}
	case "call", "callind", "jmpind":
		target := i.Src.Imm
		if i.Op != "call" {
			target, err = c.read(i.Dst, w, next)
		}
		if err == nil && i.Op != "jmpind" {
			err = c.push(next, w)
		}
		next = target
	case "iret":
		if s.CR[0]&1 != 0 && c.Flags&(1<<17) != 0 && c.Flags>>12&3 < 3 {
			return true, gp()
		}
		oldCPL, oldFlags := s.CPL, c.Flags
		// Preflight the whole frame before changing privilege, flags or stack.
		var frame [9]uint64
		n := 3
		for j := 0; j < n; j++ {
			frame[j], err = c.Memory.Read(c.stackAddress(c.R[RSP]+uint64(j)*uint64(w)), int(w), false)
			if err != nil {
				break
			}
		}
		if err != nil {
			break
		}
		toVM := w == 4 && frame[2]&(1<<17) != 0 && s.CPL == 0 && s.CR[0]&1 != 0
		outer := !toVM && s.CR[0]&1 != 0 && c.Flags&(1<<17) == 0 && uint8(frame[1]&3) > s.CPL
		if toVM {
			n = 9
		} else if outer {
			n = 5
		}
		for j := 3; j < n; j++ {
			frame[j], err = c.Memory.Read(c.stackAddress(c.R[RSP]+uint64(j)*uint64(w)), int(w), false)
			if err != nil {
				break
			}
		}
		if err != nil {
			break
		}
		if toVM {
			if frame[0] > 65535 {
				err = gp()
				break
			}
			c.Flags = frame[2]&0x3f7fd7 | 2
			s.CPL = 3
			for j, index := range []uint8{1, 2, 0, 3, 4, 5} {
				k := j + 3
				if j == 0 {
					k = 1
				}
				if j == 1 {
					k = 4
				}
				if j >= 2 {
					k = j + 3
				}
				if err = s.segment(index, uint16(frame[k])); err != nil {
					break
				}
			}
			c.R[RSP] = frame[3]
			next = frame[0]
		} else {
			if s.CR[0]&1 != 0 && c.Flags&(1<<17) == 0 {
				if err = s.returnCode(uint16(frame[1]), frame[0]); err != nil {
					break
				}
			}
			if err = s.segment(1, uint16(frame[1])); err != nil {
				break
			}
			c.setSP(c.R[RSP] + uint64(3)*uint64(w))
			m := mask(w) & 0x3f7fd7
			if s.CR[0]&1 != 0 {
				m &^= 1<<17 | 1<<19 | 1<<20
				if oldCPL != 0 {
					m &^= 0x3000
				}
				if oldCPL > uint8(oldFlags>>12&3) {
					m &^= FlagIF
				}
			}
			c.Flags = c.Flags&^m | frame[2]&m | 2
			next = frame[0]
			if outer {
				if err = s.segment(2, uint16(frame[4])); err != nil {
					break
				}
				c.setSP(frame[3])
			}
		}
	case "ret", "lret":
		next, err = c.pop(w)
		if err == nil && i.Op == "lret" {
			var sel uint64
			sel, err = c.pop(w)
			if err == nil && s.CR[0]&1 != 0 && c.Flags&(1<<17) == 0 {
				err = s.returnCode(uint16(sel), next)
			}
			if err == nil {
				outer := s.CR[0]&1 != 0 && c.Flags&(1<<17) == 0 && uint8(sel&3) > s.CPL
				if outer {
					c.setSP(c.R[RSP] + i.Src.Imm)
					var sp, ss uint64
					sp, err = c.pop(w)
					if err == nil {
						ss, err = c.pop(w)
					}
					if err == nil {
						err = s.segment(1, uint16(sel))
					}
					if err == nil {
						err = s.segment(2, uint16(ss))
						c.setSP(sp)
					}
				} else {
					err = s.segment(1, uint16(sel))
				}
			}
		}
		if err == nil {
			c.setSP(c.R[RSP] + i.Src.Imm)
		}
	case "leave":
		c.setSP(c.R[RBP])
		var v uint64
		v, err = c.pop(w)
		if err == nil {
			err = c.write(Operand{Kind: regOperand, Reg: RBP}, w, next, v)
		}
	case "farjmpind", "farcallind":
		a := c.address(i.Dst, next)
		var target, sel uint64
		target, err = c.Memory.Read(a, int(w), false)
		if err == nil {
			sel, err = c.Memory.Read(a+uint64(w), 2, false)
		}
		if err == nil {
			next, err = s.farTransfer(uint16(sel), target, next, w, i.Op == "farcallind")
		}
	case "farjmp", "farcall":
		next, err = s.farTransfer(uint16(i.Dst.Imm), i.Src.Imm, next, w, i.Op == "farcall")
	case "movs", "cmps", "stos", "lods", "scas":
		aw := i.AddressWidth
		m := mask(aw)
		if i.Repeat != 0 && c.R[RCX]&m == 0 {
			break
		}
		seg := i.Segment
		if seg == 0 {
			seg = 0x3e
		}
		var src, dst uint64
		if i.Op == "movs" || i.Op == "cmps" || i.Op == "lods" {
			src, err = s.segmentAddress(segmentIndex(seg), c.R[RSI]&m, int(w), false, false)
			if err != nil {
				break
			}
		}
		if i.Op != "lods" {
			dst, err = s.segmentAddress(0, c.R[RDI]&m, int(w), i.Op == "movs" || i.Op == "stos", false)
			if err != nil {
				break
			}
		}
		a := c.R[RAX] & mask(w)
		var b uint64
		if i.Op == "movs" || i.Op == "cmps" || i.Op == "lods" {
			a, err = c.Memory.Read(src, int(w), false)
		}
		if err == nil && (i.Op == "cmps" || i.Op == "scas") {
			b, err = c.Memory.Read(dst, int(w), false)
			if err == nil {
				_, f := arithmetic(a, b, 0, w, true)
				c.Flags = c.Flags&^arithmeticFlags | f
			}
		}
		if err == nil && (i.Op == "movs" || i.Op == "stos") {
			err = c.Memory.Write(dst, int(w), a)
		}
		if err == nil && i.Op == "lods" {
			err = c.write(Operand{Kind: regOperand, Reg: RAX}, w, next, a)
		}
		if err != nil {
			break
		}
		delta := uint64(w)
		if c.Flags&FlagDF != 0 {
			delta = -delta
		}
		if i.Op == "movs" || i.Op == "cmps" || i.Op == "lods" {
			c.R[RSI] = c.R[RSI]&^m | (c.R[RSI]+delta)&m
		}
		if i.Op != "lods" {
			c.R[RDI] = c.R[RDI]&^m | (c.R[RDI]+delta)&m
		}
		if i.Repeat != 0 {
			c.R[RCX] = c.R[RCX]&^m | (c.R[RCX]-1)&m
			again := c.R[RCX]&m != 0
			if i.Op == "cmps" || i.Op == "scas" {
				again = again && ((c.Flags&ZF != 0) == (i.Repeat == 0xf3))
			}
			if again {
				next = i.PC
			}
		}
	case "loop":
		m := mask(i.AddressWidth)
		count := c.R[RCX] & m
		take := count == 0
		if i.CC != 3 {
			count = (count - 1) & m
			c.R[RCX] = c.R[RCX]&^m | count
			take = count != 0
			if i.CC == 0 {
				take = take && c.Flags&ZF == 0
			}
			if i.CC == 1 {
				take = take && c.Flags&ZF != 0
			}
		}
		if take {
			next = i.Src.Imm & mask(uint8(s.CodeBits()/8))
		}
	default:
		return false, nil
	}
	if err != nil {
		return true, err
	}
	c.PC = next
	c.Retired++
	return true, nil
}

// Non-PAE 386 paging with combined PDE/PTE permissions and architectural A/D
// writes. PAE is rejected explicitly until its separate walker is implemented.
// trackLegacyPageTable permits cached translations only with a coherent RAM
// owner. Generic physical buses retain their previous walk-on-access behavior.
func (s *System) trackLegacyPageTable(a uint64) bool {
	if m, ok := s.Physical.(interface{ TrackLegacyPageTable(uint64) bool }); ok {
		return m.TrackLegacyPageTable(a)
	}
	if m, ok := s.Physical.(interface{ MarkPageTable(uint64) }); ok {
		m.MarkPageTable(a)
	}
	return false
}
func (s *System) translateLegacy(address uint64, write, execute bool) (uint64, error) {
	if s.CR[4]&(1<<5) != 0 {
		return 0, fmt.Errorf("legacy PAE paging not implemented")
	}
	address = uint64(uint32(address))
	key := address >> 12
	e, cached := s.tlb[key]
	coherent := cached
	var pde, pte uint64
	var err error
	if !cached {
		pdeAddr := (s.CR[3] & 0xfffff000) + (address>>22)*4
		coherent = s.trackLegacyPageTable(pdeAddr)
		pde, err = s.Physical.Read(pdeAddr, 4, false)
		if err != nil {
			return 0, err
		}
		if pde&1 == 0 {
			return 0, s.Fault(address, write, execute, false)
		}
		pteAddr := (pde & 0xfffff000) + (address>>12&1023)*4
		pte = pde
		large := s.CR[4]&16 != 0 && pde&128 != 0
		if !large {
			tracked := s.trackLegacyPageTable(pteAddr)
			coherent = coherent && tracked
			pte, err = s.Physical.Read(pteAddr, 4, false)
			if err != nil {
				return 0, err
			}
			if pte&1 == 0 {
				return 0, s.Fault(address, write, execute, false)
			}
		}
		e = pageEntry{physical: pte & 0xfffff000, writable: (pde&pte)&2 != 0, user: (pde&pte)&4 != 0, dirty: pte&64 != 0, pte: pteAddr, legacyLarge: large}
		if large {
			e.physical = pde&0xffc00000 | address&0x3ff000
			e.pte = pdeAddr
		}
		user := s.CPL == 3 && !s.supervisor
		if user && !e.user || write && !e.writable && (user || s.CR[0]&(1<<16) != 0) {
			return 0, s.Fault(address, write, execute, true)
		}
		if err = s.setLegacyPageBits(pdeAddr, pde, 32); err != nil {
			return 0, err
		}
		bits := uint64(32)
		if write {
			bits |= 64
		}
		if err = s.setLegacyPageBits(e.pte, pte, bits); err != nil {
			return 0, err
		}
		e.dirty = e.dirty || write
	}
	user := s.CPL == 3 && !s.supervisor
	if user && !e.user || write && !e.writable && (user || s.CR[0]&(1<<16) != 0) {
		delete(s.tlb, key)
		return 0, s.Fault(address, write, execute, true)
	}
	if write && !e.dirty {
		// Re-read only on the first write; never OR into a stale saved PTE.
		pte, err = s.Physical.Read(e.pte, 4, false)
		if err != nil {
			return 0, err
		}
		if err = s.setLegacyPageBits(e.pte, pte, 64); err != nil {
			return 0, err
		}
		e.dirty = true
	}
	if coherent {
		if !cached {
			pdeAddr := (s.CR[3] & 0xfffff000) + (address>>22)*4
			s.addTableRef(&e.refs, pdeAddr, 4)
			if !e.legacyLarge {
				s.addTableRef(&e.refs, e.pte, 4)
			}
			s.cacheMapping(key, e)
		} else if write {
			s.tlb[key] = e
		}
	}
	// The immediately preceding walk also supplies NativeMapping metadata on
	// untracked buses. No second speculative walk (or cached permission grant).
	s.lastLegacy = e
	return e.physical | address&4095, nil
}

func (s *System) setLegacyPageBits(address, value, bits uint64) error {
	if value|bits == value {
		return nil
	}
	if memory, ok := s.Physical.(interface{ SetLegacyPageBits(uint64, uint64) error }); ok {
		return memory.SetLegacyPageBits(address, bits)
	}
	return s.Physical.Write(address, 4, value|bits)
}

-- legacy_privilege_test.go --
package x86

import "testing"

func protectedTestCPU(t *testing.T) (*CPU, *System) {
	c, s, m := legacyCPU(t, []byte{0xcf})
	s.CR[0] = 1
	s.GDTR = Table{Base: 0x500, Limit: 23}
	s.IDTR = Table{Base: 0x600, Limit: 255}
	m.Write(0x508, 8, 0x00cf9a000000ffff)
	m.Write(0x510, 8, 0x00cf92000000ffff)
	s.Segments[1] = Segment{Selector: 8, Limit: 0xffffffff, Flags: 0xcf9a}
	s.Segments[2] = Segment{Selector: 16, Limit: 0xffffffff, Flags: 0xcf92}
	return c, s
}
func TestRealModeInterruptPreservesNTAndIOPL(t *testing.T) {
	c, s, m := legacyCPU(t, []byte{0xcd, 0x21})
	m.Write(0x21*4, 4, 0x10000100)
	c.R[RSP] = 0x800
	c.Flags = 0x7703
	if err := c.Step(); err != nil {
		t.Fatal(err)
	}
	if c.Flags != 0x7403 || c.PC != 0x100 || s.Segments[1].Base != 0x10000 {
		t.Fatalf("interrupt flags=%#x pc=%#x", c.Flags, c.PC)
	}
	saved, _ := m.Read(0x7fe, 2, false)
	if saved != 0x7703 {
		t.Fatalf("saved flags %#x", saved)
	}
}
func TestLegacyVM86GPAndIRETRoundTrip(t *testing.T) {
	c, s := protectedTestCPU(t)
	m := s.Physical
	s.TR = Segment{Selector: 24, Base: 0x800, Limit: 0x67, Flags: 0x89}
	m.Write(0x804, 4, 0xa000)
	m.Write(0x808, 2, 16)
	m.Write(0x600+13*8, 8, 0x00008e0000084000)
	c.R[RSP] = 0x9000
	frame := []uint64{0x100, 0x1000, 0x20202, 0x800, 0x2000, 0x3000, 0x4000, 0x5000, 0x6000}
	for j, v := range frame {
		m.Write(0x9000+uint64(j)*4, 4, v)
	}
	m.Write(0x10100, 1, 0xfa) // CLI at IOPL0 must fault, not change IF.
	step(t, c)
	if s.CPL != 3 || c.Flags&(1<<17) == 0 || c.PC != 0x100 || c.R[RSP] != 0x800 || s.Segments[5].Base != 0x60000 {
		t.Fatalf("v8086 entry: CPL%d PC%x SP%x flags%x seg%+v", s.CPL, c.PC, c.R[RSP], c.Flags, s.Segments)
	}
	step(t, c)
	if s.CPL != 0 || c.PC != 0x4000 || c.R[RSP] != 0x9fd8 || c.Flags&(1<<17) != 0 {
		t.Fatalf("GP transition: CPL%d PC%x SP%x flags%x", s.CPL, c.PC, c.R[RSP], c.Flags)
	}
	errorCode, _ := m.Read(0x9fd8, 4, false)
	ip, _ := m.Read(0x9fdc, 4, false)
	if errorCode != 0 || ip != 0x100 {
		t.Fatalf("restart frame %x %x", errorCode, ip)
	}
	savedFlags, _ := m.Read(0x9fe4, 4, false)
	if savedFlags&(1<<16) == 0 {
		t.Fatal("fault frame omitted RF")
	}
	m.Write(0x4000, 4, 0xcf04c483) // ADD ESP,4; IRET
	step(t, c)
	step(t, c)
	if s.CPL != 3 || c.PC != 0x100 || c.R[RSP] != 0x800 || s.Segments[0].Selector != 0x3000 || s.Segments[3].Selector != 0x4000 || s.Segments[4].Selector != 0x5000 || s.Segments[5].Selector != 0x6000 {
		t.Fatalf("v8086 return: CPL%d PC%x SP%x seg%+v", s.CPL, c.PC, c.R[RSP], s.Segments)
	}
}
func TestLegacyInstructionFetchFaultRestartsThroughIDT(t *testing.T) {
	c, s := protectedTestCPU(t)
	m := s.Physical
	m.Write(0x600+14*8, 8, 0x00008e0000082000)
	s.CR[0] |= 1 << 31
	s.CR[3] = 0x4000
	m.Write(0x4000, 4, 0x5007)
	m.Write(0x5000, 4, 7)
	m.Write(0x5008, 4, 0x2007)
	m.Write(0x5020, 4, 0x8007)
	c.PC = 0x3000
	c.R[RSP] = 0x9000
	step(t, c)
	code, _ := m.Read(0x8ff0, 4, false)
	ip, _ := m.Read(0x8ff4, 4, false)
	if c.PC != 0x2000 || s.CR[2] != 0x3000 || code != 0 || ip != 0x3000 || c.Retired != 0 {
		t.Fatalf("fetch fault: pc%x cr2%x code%x ip%x retired%d", c.PC, s.CR[2], code, ip, c.Retired)
	}
}
func TestLegacyFarLoadENTERAndDecimalVectors(t *testing.T) {
	c, s, m := legacyCPU(t, []byte{0xc5, 0x1e, 0, 4, 0xc8, 8, 0, 0, 0xc9, 0xd5, 10, 0xf9, 0xd0, 0xd8})
	m.Write(0x400, 4, 0x12345678)
	step(t, c)
	if c.R[RBX] != 0x5678 || s.Segments[3].Base != 0x12340 {
		t.Fatal("LDS", c.R[RBX], s.Segments[3])
	}
	c.R[RBP] = 0x1111
	step(t, c)
	if c.R[RBP] != 0x7ffe || c.R[RSP] != 0x7ff6 {
		t.Fatal("ENTER", c.R)
	}
	step(t, c)
	if c.R[RBP] != 0x1111 || c.R[RSP] != 0x8000 {
		t.Fatal("LEAVE", c.R)
	}
	c.R[RAX] = 0x0203
	step(t, c)
	if c.R[RAX] != 23 {
		t.Fatal("AAD", c.R[RAX])
	}
	c.R[RAX] = 2
	step(t, c)
	step(t, c)
	if c.R[RAX] != 0x81 || c.Flags&CF != 0 || c.Flags&OF == 0 {
		t.Fatal("RCR", c.R[RAX], c.Flags)
	}
}

-- legacy_restart.go --
package x86

// Scalar instructions cannot alter privileged, vector or x87 state. Keep
// their small restart record out of the system-instruction snapshot frame.
// This is the same classification used by native lowering, not a separate
// incomplete list of opcodes allowed to fault without rollback.
func (c *CPU) executeLegacyRestartable(i Instruction, bits int) error {
	scalar := pcSupported(i, bits)
	switch i.Op {
	// These architectural slow paths also modify only integer registers and
	// flags. Interrupt delivery, STI/shadow, segment/control/MSR and FP/vector
	// instructions still use the full system restart record.
	case "in", "out", "ins", "outs", "pushf", "popf", "loop", "jcxz":
		scalar = true
	}
	if !scalar {
		return c.executeLegacySystemRestartable(i)
	}
	registers, pc, flags, retired := c.R, c.PC, c.Flags, c.Retired
	err := c.Execute(i)
	if err != nil {
		c.R, c.PC, c.Flags, c.Retired = registers, pc, flags, retired
	}
	return err
}
func (c *CPU) executeLegacySystemRestartable(i Instruction) error {
	s := c.System
	savedCPU, savedSystem := *c, *s
	err := c.Execute(i)
	if err != nil {
		cr2, count, trace := s.CR[2], s.FaultCount, s.FaultTrace
		*c, *s = savedCPU, savedSystem
		s.CR[2], s.FaultCount, s.FaultTrace = cr2, count, trace
	}
	return err
}

-- legacy_test.go --
package x86

import (
	"renvo.dev/internal/rfe/linuxuser"
	"testing"
)

func legacyCPU(t *testing.T, code []byte) (*CPU, *System, *linuxuser.Memory) {
	t.Helper()
	m := linuxuser.NewMemory()
	if err := m.Map(0, 1<<20, 7); err != nil {
		t.Fatal(err)
	}
	if err := m.WriteBytes(0x1000, code); err != nil {
		t.Fatal(err)
	}
	c := &CPU{PC: 0x1000, Flags: 2}
	s := NewPCSystem(c, m, nil)
	c.R[RSP] = 0x8000
	return c, s, m
}
func TestLegacySegmentedStackInterruptAndReturn(t *testing.T) {
	c, s, m := legacyCPU(t, []byte{0xb8, 0x34, 0x12, 0x50, 0x5b, 0xcd, 0x21, 0x40})
	s.Segments[2].Base = 0x20000
	m.Write(0x84, 4, 0x00003000)
	m.WriteBytes(0x3000, []byte{0x43, 0xcf})
	for j := 0; j < 7; j++ {
		step(t, c)
	}
	if c.R[RAX] != 0x1235 || c.R[RBX] != 0x1235 || c.R[RSP] != 0x8000 || c.PC != 0x1008 {
		t.Fatalf("state %+v", c)
	}
	v, _ := m.Read(0x27ffe, 2, false)
	if v != 2 {
		t.Fatalf("interrupt did not use SS:SP: %x", v)
	}
}
func TestLegacyAddressOverrideDefaultSSAndRep(t *testing.T) {
	c, s, m := legacyCPU(t, []byte{0x8b, 0x02, 0x67, 0x8b, 0x03, 0xf3, 0xa4})
	s.Segments[2].Base = 0x20000
	s.Segments[3].Base = 0x30000
	s.Segments[0].Base = 0x40000
	c.R[RBP] = 0x20
	c.R[RSI] = 0x10
	c.R[RBX] = 0x10020
	s.Segments[3].Limit = 0xffffffff // Address override uses an unreal-mode data cache.
	m.Write(0x20030, 2, 0xabcd)
	m.Write(0x40020, 2, 0x1234)
	step(t, c)
	if c.R[RAX] != 0xabcd {
		t.Fatalf("BP+SI default SS %x", c.R[RAX])
	}
	step(t, c)
	if c.R[RAX] != 0x1234 {
		t.Fatalf("32-bit address override %x", c.R[RAX])
	}
	c.R[RCX] = 2
	c.R[RSI] = 0xffff
	c.R[RDI] = 0
	m.Write(0x3ffff, 1, 0x41)
	m.Write(0x30000, 1, 0x42)
	step(t, c)
	step(t, c)
	v, _ := m.Read(0x40000, 2, false)
	if v != 0x4241 || c.R[RSI] != 1 || c.R[RCX] != 0 {
		t.Fatalf("REP wrapping %x %+v", v, c.R)
	}
}
func TestLegacyCodeSizesAndFarModeSwitch(t *testing.T) {
	c, s, m := legacyCPU(t, []byte{0x0f, 0x20, 0xc0, 0x66, 0x83, 0xc8, 1, 0x0f, 0x22, 0xc0, 0x66, 0xea, 0, 0x20, 0, 0, 8, 0})
	s.GDTR = Table{Base: 0x500, Limit: 15}
	m.Write(0x508, 8, 0x00cf9a000000ffff)
	m.WriteBytes(0x2000, []byte{0xb8, 0x78, 0x56, 0x34, 0x12, 0x40})
	for j := 0; j < 4; j++ {
		step(t, c)
	}
	if s.CodeBits() != 32 || c.PC != 0x2000 {
		t.Fatalf("mode switch bits=%d pc=%x", s.CodeBits(), c.PC)
	}
	step(t, c)
	step(t, c)
	if c.R[RAX] != 0x12345679 {
		t.Fatalf("32-bit code %x", c.R[RAX])
	}
	// Explicit long-mode entry must distinguish REX from legacy INC.
	s.EFER = 1 << 10
	s.Segments[1].Flags = 1 << 13
	c.PC = 0x3000
	m.WriteBytes(0x3000, []byte{0x48, 0xb8, 1, 2, 3, 4, 5, 6, 7, 8})
	step(t, c)
	if s.CodeBits() != 64 || c.R[RAX] != 0x0807060504030201 {
		t.Fatalf("64-bit code %x", c.R[RAX])
	}
}
func TestLegacyPagingPermissionsAndADBits(t *testing.T) {
	c, s, m := legacyCPU(t, nil)
	_ = c
	s.CR[0] = 1 | 1<<31 | 1<<16
	s.CR[3] = 0x4000
	m.Write(0x4000, 4, 0x5007)
	m.Write(0x500c, 4, 0x9007)
	if err := s.Write(0x3123, 1, 0x5a); err != nil {
		t.Fatal(err)
	}
	v, _ := m.Read(0x9123, 1, false)
	pde, _ := m.Read(0x4000, 4, false)
	pte, _ := m.Read(0x500c, 4, false)
	if v != 0x5a || pde&32 == 0 || pte&96 != 96 {
		t.Fatalf("paging %x %x %x", v, pde, pte)
	}
	m.Write(0x500c, 4, 0x9005)
	if err := s.Write(0x3123, 1, 1); err == nil {
		t.Fatal("write protection ignored")
	}
}

-- legacy_tlb_test.go --
package x86

import "testing"

// Opting in promises that EVERY table mutation (including borrowed host RAM)
// revokes translations before changing the bytes. Unknown buses do not opt in.
type legacyTLBRAM struct {
	pcFetchRAM
	s       *System
	watched map[uint64]bool
	reads   int
}

func (m *legacyTLBRAM) InvalidateNativeMappings() {}
func (m *legacyTLBRAM) TrackLegacyPageTable(a uint64) bool {
	m.watched[a>>12] = true
	return true
}
func (m *legacyTLBRAM) Read(a uint64, n int, x bool) (uint64, error) {
	if a>>12 == 1 || a>>12 == 2 {
		m.reads++
	}
	return m.pcFetchRAM.Read(a, n, x)
}
func (m *legacyTLBRAM) Write(a uint64, n int, v uint64) error {
	if m.watched[a>>12] {
		clear(m.s.tlb)
	}
	return m.pcFetchRAM.Write(a, n, v)
}
func (m *legacyTLBRAM) SetLegacyPageBits(a, bits uint64) error {
	v, err := m.pcFetchRAM.Read(a, 4, false)
	if err != nil {
		return err
	}
	return m.pcFetchRAM.Write(a, 4, v|bits)
}
func legacyTLBSetup(t *testing.T) (*System, *legacyTLBRAM) {
	t.Helper()
	m := &legacyTLBRAM{pcFetchRAM: pcFetchRAM{data: make([]byte, 8<<20)}, watched: make(map[uint64]bool)}
	s := NewPCSystem(&CPU{Flags: 2}, m, nil)
	m.s = s
	s.CR[0], s.CR[3] = 0x80010011, 0x1000
	m.Write(0x1000, 4, 0x2027)
	m.Write(0x2004, 4, 0x3027)
	return s, m
}
func TestLegacyTLBReusesWalkAndNativePermissions(t *testing.T) {
	s, m := legacyTLBSetup(t)
	p, w, err := s.NativeMapping(0x1234, false)
	if err != nil || p != 0x3234 || w {
		t.Fatal(p, w, err)
	}
	if m.reads != 2 {
		t.Fatalf("one native refill walked tables %d times, want 2 reads", m.reads)
	}
	for i := 0; i < 16; i++ {
		if _, _, err = s.NativeMapping(0x1234, false); err != nil {
			t.Fatal(err)
		}
	}
	if m.reads != 2 {
		t.Fatalf("cached page still walks: %d", m.reads)
	}
	if _, err = s.translate(0x1234, true, false); err != nil {
		t.Fatal(err)
	}
	p, w, err = s.NativeMapping(0x1234, false)
	if err != nil || !w || p != 0x3234 {
		t.Fatal(p, w, err)
	}
	v, _ := m.pcFetchRAM.Read(0x2004, 4, false)
	if v&64 == 0 {
		t.Fatal("first write did not set dirty bit")
	}
	// A host/guest PTE update must not preserve the old frame or permissions.
	m.Write(0x2004, 4, 0x5025)
	p, w, err = s.NativeMapping(0x1234, false)
	if err != nil || p != 0x5234 || w {
		t.Fatal("stale PTE", p, w, err)
	}
	s.CPL = 3
	if _, err = s.translate(0x1234, true, false); err == nil {
		t.Fatal("user write to readonly cached page")
	}
	s.CPL = 0
	s.CR[0] &^= 1 << 16
	if _, err = s.translate(0x1234, true, false); err != nil {
		t.Fatal("supervisor WP=0", err)
	}
	s.CR[0] |= 1 << 16
	if _, err = s.translate(0x1234, true, false); err == nil {
		t.Fatal("cached write ignored WP")
	}
	m.Write(0x2004, 4, 0x5063)
	if _, err = s.translate(0x1234, false, false); err != nil {
		t.Fatal(err)
	}
	s.CPL = 3
	if _, err = s.translate(0x1234, false, false); err == nil {
		t.Fatal("user read of supervisor cached page")
	}
	s.CPL = 0
	s.supervisor = true
	if _, err = s.translate(0x1234, false, false); err != nil {
		t.Fatal(err)
	}
}
func TestLegacyTLBInvalidationAndLargePages(t *testing.T) {
	s, m := legacyTLBSetup(t)
	s.CR[4] = 16
	if p, err := s.translate(0x1234, false, false); err != nil || p != 0x3234 {
		t.Fatal(p, err)
	}
	m.pcFetchRAM.Write(0x2004, 4, 0x7027)
	s.invalidatePage(0x1234)
	if p, err := s.translate(0x1234, false, false); err != nil || p != 0x7234 {
		t.Fatal("small INVLPG with PSE enabled", p, err)
	}
	m.Write(0x1000, 4, 0x4000e7)
	for _, a := range []uint64{0x1234, 0x2234} {
		if p, err := s.translate(a, false, false); err != nil || p != 0x400000+a {
			t.Fatal(p, err)
		}
	}
	// Simulate a guest PTE store, then INVLPG. All slices of the large
	// mapping must be revoked, not just the addressed 4KiB slice.
	m.pcFetchRAM.Write(0x1000, 4, 0xe7)
	s.invalidatePage(0x3234) // This 4KiB slice was never itself cached.
	if p, err := s.translate(0x2234, false, false); err != nil || p != 0x2234 {
		t.Fatal("large INVLPG", p, err)
	}
	m.Write(0x5000, 4, 0x4000e7)
	s.CR[3] = 0x5000
	s.switchAddressSpace()
	if p, err := s.translate(0x2234, false, false); err != nil || p != 0x402234 {
		t.Fatal("CR3", p, err)
	}
}
func TestLegacyUnknownOwnerDoesNotCacheTables(t *testing.T) {
	m := &pcFetchRAM{data: make([]byte, 1<<20)}
	s := NewPCSystem(&CPU{Flags: 2}, m, nil)
	s.CR[0], s.CR[3] = 0x80010011, 0x1000
	m.Write(0x1000, 4, 0x2067)
	m.Write(0x2004, 4, 0x3067)
	if p, _, err := s.NativeMapping(0x1234, false); err != nil || p != 0x3234 {
		t.Fatal(p, err)
	}
	m.Write(0x2004, 4, 0x5067)
	if p, _, err := s.NativeMapping(0x1234, false); err != nil || p != 0x5234 {
		t.Fatal("unknown bus cached stale mapping", p, err)
	}
}

