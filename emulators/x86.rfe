package x86

import "testing"

func TestLegacyXLATSegmentAndAddressSize(t *testing.T) {
	c, s, m := legacyCPU(t, []byte{0xd7, 0x26, 0xd7, 0x67, 0xd7})
	s.Segments[3].Base = 0x20000
	s.Segments[0].Base = 0x40000
	c.R[RBX] = 0x1ffff
	c.R[RAX] = 0x7701
	m.Write(0x20000, 1, 2)
