	m.Write(0x40002, 1, 4)
	step(t, c)
	if c.R[RAX] != 0x7702 {
		t.Fatalf("DS:BX+AL %x", c.R[RAX])
	}
	step(t, c)
	if c.R[RAX] != 0x7703 {
		t.Fatalf("ES override %x", c.R[RAX])
	}
	step(t, c)
	if c.R[RAX] != 0x7704 {
		t.Fatalf("EBX address override %x", c.R[RAX])
	}
}

-- mapping_dependencies.go --
package x86

// Dependencies outlive software-TLB permission evictions: a native read
// descriptor may still refer to that mapping until it is explicitly revoked.
type mappingSpace struct{ root, paging, features uint64 }
type mappingKey struct {
	space mappingSpace
	page  uint64
}

func (s *System) mappingSpace() mappingSpace {
	return mappingSpace{s.CR[3], s.CR[0]&(1<<31) | s.CR[4]<<32, s.EFER}
}

type pageTableRefs struct {
	shift uint8
	words [8]uint64
	n     uint8
}

func (s *System) addTableRef(refs *pageTableRefs, address uint64, size int) {
	if owner, ok := s.Physical.(interface{ PageTableOffset(uint64) (uint64, bool) }); ok {
		if off, valid := owner.PageTableOffset(address); valid {
			address = off
		}
	}
	for i := 0; i < size; i += 4 {
		word := (address + uint64(i)) &^ uint64(3)
		found := false
		for j := uint8(0); j < refs.n; j++ {
			found = found || refs.words[j] == word
		}
		if !found && refs.n < uint8(len(refs.words)) {
			refs.words[refs.n] = word
			refs.n++
		}
	}
}
func (s *System) forgetMappingRefs(page mappingKey) {
	refs, ok := s.mappingRefs[page]
	if !ok {
		return
	}
	for i := uint8(0); i < refs.n; i++ {
		word := refs.words[i]
		delete(s.tableUsers[word], page)
		if len(s.tableUsers[word]) == 0 {
			delete(s.tableUsers, word)
		}
	}
	delete(s.mappingRefs, page)
}
func (s *System) cacheMapping(page uint64, e pageEntry) {
	key := mappingKey{s.mappingSpace(), page}
	s.forgetMappingRefs(key)
	e.refs.shift = e.pageShift
	if e.legacyLarge {
		e.refs.shift = 22
	}
	if s.mappingRefs == nil {
		s.mappingRefs = make(map[mappingKey]pageTableRefs)
		s.tableUsers = make(map[uint64]map[mappingKey]struct{})
	}
	s.mappingRefs[key] = e.refs
	for i := uint8(0); i < e.refs.n; i++ {
		word := e.refs.words[i]
		users := s.tableUsers[word]
		if users == nil {
			users = make(map[mappingKey]struct{})
			s.tableUsers[word] = users
		}
		users[key] = struct{}{}
	}
	s.tlb[page] = e
}
func (s *System) clearTranslations() { clear(s.tlb); clear(s.mappingRefs); clear(s.tableUsers) }

// InvalidatePageTableWrite returns only translations which actually consumed
// an overlapping PDE/PTE word. The caller revokes the same native mappings.
func (s *System) InvalidatePageTableWrite(offset uint64, n int) []uint64 {
	keys := s.invalidatePageTableWrite(offset, n)
	pages := make([]uint64, 0, len(keys))
	for _, key := range keys {
		pages = append(pages, key.page)
	}
	return pages
}
func (s *System) invalidatePageTableWrite(offset uint64, n int) []mappingKey {
	if n < 1 || offset+uint64(n)-1 < offset {
		return nil
	}
	var pages []mappingKey
	last := (offset + uint64(n) - 1) &^ uint64(3)
	for word := offset &^ uint64(3); ; word += 4 {
		for page := range s.tableUsers[word] {
			if page.space == s.mappingSpace() {
				delete(s.tlb, page.page)
			}
			s.forgetMappingRefs(page)
			pages = append(pages, page)
		}
		if word == last {
			break
		}
	}
	return pages
}

-- native_privilege_test.go --
package x86

import "testing"

func TestNativeMappingIncludesIntermediatePrivilegeRings(t *testing.T) {
	s, m := legacyTLBSetup(t)
	m.Write(0x2004, 4, 0x3063) // supervisor-only writable, dirty
	for _, cpl := range []uint8{0, 1, 2} {
		s.CPL = cpl
		p, w, err := s.NativeMapping(0x1234, false)
		if err != nil || p != 0x3234 || !w {
			t.Fatal("legal supervisor mapping arbitrarily excluded", cpl, p, w, err)
		}
	}
	s.CPL = 3
	if _, _, err := s.NativeMapping(0x1234, false); err == nil {
		t.Fatal("ring3 bypassed supervisor page")
	}
}

-- native_test.go --
package x86

import (
	"renvo.dev/internal/rfe/engine"
	"renvo.dev/internal/rfe/linuxuser"
	"testing"
)

func TestNativeAndIRInstructionDifferential(t *testing.T) {
	codes := [][]byte{
		{0x48, 0x01, 0xd8}, {0x01, 0xd8}, {0x66, 0x01, 0xd8}, {0x00, 0xd8},
		{0x48, 0x29, 0xd8}, {0x29, 0xd8}, {0x66, 0x29, 0xd8}, {0x28, 0xd8},
		{0x48, 0x39, 0xd8}, {0x48, 0x21, 0xd8}, {0x48, 0x09, 0xd8}, {0x48, 0x31, 0xd8},
		{0x48, 0xff, 0xc0}, {0x48, 0xff, 0xc8}, {0x48, 0xf7, 0xd8}, {0x48, 0xf7, 0xd0},
		{0x48, 0x0f, 0xaf, 0xc3}, {0x0f, 0xaf, 0xc3}, {0x66, 0x0f, 0xaf, 0xc3},
		{0x48, 0x6b, 0xc3, 0xfd}, {0x0f, 0xb6, 0xc4}, {0x48, 0x0f, 0xbe, 0xc4},
		{0x48, 0x0f, 0xbf, 0xc3}, {0x48, 0x63, 0xc3}, {0x48, 0x8d, 0x44, 0xcb, 0xf0},
		{0x48, 0xb8, 0x11, 0x22, 0x33, 0x44, 0x55, 0x66, 0x77, 0x88},
		{0x48, 0xd3, 0xe0}, {0x48, 0xd3, 0xe8}, {0x48, 0xd3, 0xf8},
		{0xd3, 0xe0}, {0xd3, 0xe8}, {0xd3, 0xf8},
		{0x66, 0xc1, 0xe0, 3}, {0x66, 0xc1, 0xe8, 3}, {0x66, 0xc1, 0xf8, 3},
		{0xc0, 0xe0, 3}, {0xc0, 0xe8, 3}, {0xc0, 0xf8, 3},
		{0x66, 0xc1, 0xc0, 8}, {0xc0, 0xc0, 4}, {0x66, 0xc1, 0xc8, 8}, {0xc0, 0xc8, 4},
	}
	for cc := byte(0); cc < 16; cc++ {
		codes = append(codes, []byte{0x0f, 0x40 + cc, 0xc3}, []byte{0x0f, 0x90 + cc, 0xc0}, []byte{0x70 + cc, 0x10})
	}
	values := []uint64{0, 1, 0x7f, 0x80, 0x7fff, 0x8000, 0x7fffffff, 0x80000000, 0xffffffff, 0x7fffffffffffffff, 0x8000000000000000, ^uint64(0)}
	for _, mode := range []string{"ir", "native"} {
		for _, code := range codes {
			base := testCPU(t, code)
			config := engine.DefaultEngineConfig()
			config.Mode = mode
			config.IRThreshold = 1
			config.NativeThreshold = 1
			config.MaxInstructions = 1
			config.MaxRegionInstructions = 1
			e, err := engine.New(config, Architecture())
			if err != nil {
				t.Fatal(err)
			}
			for index, v := range values {
				expected := *base
				expected.R[0] = v
				expected.R[RBX] = values[len(values)-1-index]
				expected.R[RCX] = uint64(index * 7)
				expected.Flags = uint64(index)*0x111 | 2
				actual := expected
				adapter := NewAdapter(&actual)
				if err = expected.Step(); err != nil {
					t.Fatal(err)
				}
				if err = e.Step(adapter, 1); err != nil {
					t.Fatalf("%s %x: %v", mode, code, err)
				}
				adapter.Export()
				if actual.R != expected.R || actual.PC != expected.PC || actual.Flags != expected.Flags || actual.Retired != expected.Retired {
					t.Fatalf("%s code=%x value=%#x: R=%x flags=%x pc=%x; want R=%x flags=%x pc=%x", mode, code, v, actual.R, actual.Flags, actual.PC, expected.R, expected.Flags, expected.PC)
				}
			}
			if e.Stats.IR+e.Stats.Native == 0 {
				t.Fatalf("%s %x never compiled", mode, code)
			}
			if mode == "native" && e.NativeAvailable() && e.Stats.Native == 0 {
				t.Fatalf("%x never executed native", code)
			}
			if err = e.Close(); err != nil {
				t.Fatal(err)
			}
		}
	}
}
func TestNativeMemoryFaultsAndBudgets(t *testing.T) {
	// INC RAX; ADD dword [RBX],1; JMP back. The first instruction is permitted
	// to retire before a protected-memory fault; flags after it must survive.
	code := []byte{0x48, 0xff, 0xc0, 0x83, 0x03, 1, 0xeb, 0xf8}
	for _, budget := range []uint64{1, 2, 3, 5, 63, 65, 257} {
		expected := testCPU(t, code)
		actual := testCPU(t, code)
		expected.Memory.(*linuxuser.Memory).Map(0x3000, 4096, 3)
		actual.Memory.(*linuxuser.Memory).Map(0x3000, 4096, 3)
		expected.R[RBX] = 0x3000
		actual.R[RBX] = 0x3000
		config := engine.DefaultEngineConfig()
		config.IRThreshold = 1
		config.NativeThreshold = 1
		e, err := engine.New(config, Architecture())
		if err != nil {
			t.Fatal(err)
		}
		adapter := NewAdapter(actual)
		for expected.Retired < budget {
			step(t, expected)
		}
		for actual.Retired < budget {
			if err = e.RunQuanta(adapter, budget-actual.Retired); err != nil {
				t.Fatal(err)
			}
		}
		adapter.Export()
		if actual.R != expected.R || actual.PC != expected.PC || actual.Flags != expected.Flags || actual.Retired != budget {
			t.Fatal("budget mismatch", budget, actual, expected)
		}
		got, _ := actual.Memory.Read(0x3000, 4, false)
		want, _ := expected.Memory.Read(0x3000, 4, false)
		if got != want {
			t.Fatal("memory", got, want)
		}
		actual.PC = 0x1000
		adapter.Import()
		m := actual.Memory.(*linuxuser.Memory)
		if budget == 257 && e.NativeAvailable() && e.Stats.NativeMemory == 0 {
			t.Fatal("memory never ran native", e.Stats)
		}
		m.Protect(0x3000, 4096, 1)
		before := actual.Retired
		old := actual.R[0]
		for actual.Retired-before < 1 {
			if err = e.RunQuanta(adapter, 3); err != nil {
				break
			}
		}
		if err == nil {
			err = e.RunQuanta(adapter, 3)
		}
		adapter.Export()
		if err == nil || actual.PC != 0x1003 || actual.R[0] != old+1 || actual.Retired != before+1 {
			t.Fatal("precise native fault", err, actual)
		}
		if err = e.Close(); err != nil {
			t.Fatal(err)
		}
	}
}

-- page_metadata.go --
package x86

func (s *System) setPageTableBits(address, bits uint64) error {
	if memory, ok := s.Physical.(interface{ SetPageTableBits(uint64, uint64) error }); ok {
		return memory.SetPageTableBits(address, bits)
	}
	value, err := s.Physical.Read(address, 8, false)
	if err != nil {
		return err
	}
	return s.Physical.Write(address, 8, value|bits)
}

-- pc_cached_test.go --
package x86

import (
	"fmt"
	"renvo.dev/internal/rfe/engine"
	"testing"
)

type cachedExecuteMemory struct {
	Memory
	executeReads uint64
}

func (m *cachedExecuteMemory) Read(a uint64, n int, x bool) (uint64, error) {
	if a == 0x1000 {
		m.executeReads++
	}
	return m.Memory.Read(a, n, x)
}

func TestPCAdapterValidatedSlowInstructionDoesNotFetchTwice(t *testing.T) {
	for _, wide := range []bool{false, true} {
		actual, s, m := legacyCPU(t, []byte{0x9c}) // PUSHF remains an architectural slow path.
		expected, ref, _ := legacyCPU(t, []byte{0x9c})
		if wide {
			s.CR[0] |= 1
			ref.CR[0] |= 1
			s.Segments[1].Flags |= 1 << 14
			ref.Segments[1].Flags |= 1 << 14
		}
		s.IRQShadow, ref.IRQShadow = 1, 1
		counted := &cachedExecuteMemory{Memory: m}
		s.Physical = counted
		i, err := DecodeMode(codeMemory{s}, actual.PC, s.CodeBits())
		if err != nil {
			t.Fatal(err)
		}
		counted.executeReads = 0
		adapter := &pcAdapter{SystemAdapter: NewSystemAdapter(actual)}
		adapter.Import()
		if err = adapter.ExecuteInstruction(engine.Instruction{Decoded: i}); err != nil {
			t.Fatal(err)
		}
		if err = expected.Step(); err != nil {
			t.Fatal(err)
		}
		if actual.R != expected.R || actual.PC != expected.PC || actual.Flags != expected.Flags || actual.Retired != expected.Retired || s.TSC != ref.TSC || s.IRQShadow != ref.IRQShadow {
			t.Fatal("cached slow path changed architectural boundary", wide)
		}
		if counted.executeReads != 0 {
			t.Fatal("validated instruction was fetched again", wide, counted.executeReads)
		}
		got, _ := m.Read(actual.R[RSP], 4, false)
		want, _ := ref.Physical.Read(expected.R[RSP], 4, false)
		if got != want {
			t.Fatal("cached stack write", got, want)
		}
	}
}

type pcFetchRAM struct{ data []byte }

func (m *pcFetchRAM) Read(a uint64, n int, x bool) (uint64, error) {
	if n < 1 || n > 8 || a > uint64(len(m.data)) || uint64(n) > uint64(len(m.data))-a {
		return 0, fmt.Errorf("unmapped RAM")
	}
	var value uint64
	for i := 0; i < n; i++ {
		value |= uint64(m.data[a+uint64(i)]) << uint(i*8)
	}
	return value, nil
}
func (m *pcFetchRAM) Write(a uint64, n int, v uint64) error {
	if n < 1 || n > 8 || a > uint64(len(m.data)) || uint64(n) > uint64(len(m.data))-a {
		return fmt.Errorf("unmapped RAM")
	}
	for i := 0; i < n; i++ {
		m.data[a+uint64(i)] = byte(v >> uint(i*8))
	}
	return nil
}

func TestPCJITCodeFetchUsesOneExecuteCheckedResolution(t *testing.T) {
	memory := &pcFetchRAM{data: make([]byte, 1<<20)}
	cpu := &CPU{Flags: 2}
	system := NewPCSystem(cpu, memory, nil)
	resolutions := 0
	jit, err := NewPCJIT(cpu, memory.data, func(a uint64, n int) (uint64, bool) {
		resolutions++
		return a, a < uint64(len(memory.data)) && n > 0 && uint64(n) <= uint64(len(memory.data))-a
	})
	if err != nil {
		t.Fatal(err)
	}
	defer jit.Close()
	memory.data[0x1000] = 0x90
	if got, err := jit.Read(0x1000, 1, true); err != nil || got != 0x90 {
		t.Fatal("checked fetch", got, err)
	}
	if resolutions != 1 {
		t.Fatal("redundant instruction RAM resolution", resolutions)
	}
	before, err := jit.ram.CodeVersion(0x1000)
	if err != nil {
		t.Fatal(err)
	}
	jit.BeforeWrite(0x1100, 1)
	memory.Write(0x1100, 1, 0xcc)
	after, err := jit.ram.CodeVersion(0x1000)
	if err != nil || after != before {
		t.Fatal("mixed-page data discarded unchanged code", err)
	}
	jit.BeforeWrite(0x1000, 1)
	memory.Write(0x1000, 1, 0xcc)
	after, err = jit.ram.CodeVersion(0x1000)
	if err != nil || after == before {
		t.Fatal("fetch failed to watch actual opcode", err)
	}
	// A straddling virtual instruction need not be contiguous physical RAM.
	system.CR[0], system.CR[3] = 0x80000011, 0x1000
	memory.Write(0x1000, 4, 0x2067)
	memory.Write(0x2004, 4, 0x3067)
	memory.Write(0x2008, 4, 0x5067)
	memory.data[0x3fff], memory.data[0x5000] = 0x34, 0x12
	resolutions = 0
	if got, err := jit.Read(0x1fff, 2, true); err != nil || got != 0x1234 {
		t.Fatal("noncontiguous execute mapping", got, err)
	}
	if resolutions != 2 {
		t.Fatal("straddling byte mappings not independent", resolutions)
	}
	before, err = jit.ram.CodeVersion(0x2000)
	if err != nil {
		t.Fatal(err)
	}
	jit.BeforeWrite(0x5000, 1)
	memory.Write(0x5000, 1, 0x56)
	after, err = jit.ram.CodeVersion(0x2000)
	if err != nil || after == before {
		t.Fatal("straddling final-page code proof remained valid", err)
	}
	// The direct RAM read must never bypass a later user/execute revocation,
	// nor leak a speculative page fault into architectural fault state.
	system.CPL = 3
	system.Segments[1].Flags = 0xfb
	system.CR[2], system.FaultCount = 0xdead, 17
	memory.Write(0x2008, 4, 0x5063)
	_, err = jit.Read(0x2000, 1, true)
	fault, ok := err.(*Exception)
	if !ok || fault.Vector != 14 || system.CR[2] != 0xdead || system.FaultCount != 17 {
		t.Fatal("execute permission/fault state", err, system.CR[2], system.FaultCount)
	}
	system.CPL = 0
	system.Segments[1].Limit = 0x1000
	resolutions = 0
	if _, err = jit.Read(0x1fff, 2, true); err == nil || resolutions != 0 {
		t.Fatal("CS limit was bypassed", err, resolutions)
	}
	system.CR[4] = 1 << 5
	system.EFER = 1 << 10
	system.Segments[1].Flags |= 1 << 13
	_, err = jit.Read(^uint64(0), 2, true)
	fault, ok = err.(*Exception)
	if !ok || fault.Vector != 13 {
		t.Fatal("wrapping execute span did not fail before translation", err)
	}
}

-- pc_jit.go --
package x86

import (
	"fmt"
	"renvo.dev/internal/rfe/engine"
	emu "renvo.dev/internal/rfe/runtime"
	"renvo.dev/internal/rfe/systemmemory"
	"sync/atomic"
)

// PCJIT owns a bounded native-code arena and checked RAM views. Construction
// fails if executable host memory is unavailable; it never silently selects an
// interpreter-only backend. Privileged, I/O and unsupported instructions retain
// the architectural slow path at exact instruction boundaries.
type PCJIT struct {
	stop      *uint32
	codeBytes []uint64
	domains   map[pcKey]*pcDomain

	mappings map[pcMappingKey]*engine.CodeIdentity
	domain   *pcDomain
	cpu      *CPU
	adapter  *pcAdapter
	engine   *engine.Engine
	ram      *systemmemory.RAM
	key      pcKey
	tiers    [3]uint64
}
type pcDomain struct {
	identity *engine.CodeIdentity
	pages    map[*engine.CodeIdentity]*engine.CodeIdentity
}
type pcMappingKey struct {
	cr0, cr3, cr4, efer, vm uint64
	cpl                     uint8
}
type pcKey struct {
	code                    Segment
	cr0, cr3, cr4, efer, vm uint64
	cpl                     uint8
}

const pcStateWords = systemStateWords + 6*3 + 6
const pcSelectorSlot = systemStateWords + 6*3
const pcSegmentSlot = systemStateWords

type pcAdapter struct {
	native [pcStateWords]uint64
	*SystemAdapter
	jit *PCJIT
}

func (a *pcAdapter) Registers() []uint64 { return a.native[:] }
func (a *pcAdapter) Import() {
	c, s := a.CPU, a.CPU.System
	copy(a.native[:16], c.R[:])
	a.native[pcSlot], a.native[flagsSlot] = c.PC, c.Flags
	a.native[fsBaseSlot], a.native[gsBaseSlot] = s.FSBase, s.GSBase
	if s.CodeBits() != 64 {
		a.native[pcSlot] += s.Segments[1].Base
	}
	for i, seg := range s.Segments {
		a.native[pcSegmentSlot+i*3] = seg.Base
		a.native[pcSegmentSlot+i*3+1] = uint64(seg.Limit)
		a.native[pcSegmentSlot+i*3+2] = uint64(seg.Flags)
		a.native[pcSelectorSlot+i] = uint64(seg.Selector)
	}
}
func (a *pcAdapter) Export() {
	c := a.CPU
	copy(c.R[:], a.native[:16])
	c.PC, c.Flags = a.native[pcSlot], a.native[flagsSlot]
	if c.System.CodeBits() != 64 {
		c.PC -= c.System.Segments[1].Base
	}
}
func (a *pcAdapter) Step() error              { a.Export(); err := a.CPU.Step(); a.Import(); return err }
func (a *pcAdapter) MemoryBus() engine.Memory { return a.jit }
func (a *pcAdapter) ExecuteInstruction(ins engine.Instruction) error {
	a.Export()
	err := a.CPU.ExecuteCachedInstruction(ins.Decoded.(Instruction))
	a.Import()
	return err
}

func NewPCJIT(c *CPU, ram []byte, offset func(uint64, int) (uint64, bool)) (*PCJIT, error) {
	if c.System == nil || !c.System.MultiMode || offset == nil {
		return nil, fmt.Errorf("PC JIT requires a system and a physical RAM resolver")
	}
	j := &PCJIT{cpu: c, codeBytes: make([]uint64, (len(ram)+63)/64)}
	j.adapter = &pcAdapter{SystemAdapter: NewSystemAdapter(c), jit: j}
	s := c.System
	j.ram = systemmemory.New(ram, func() bool { return true }, func(a uint64, x bool) (uint64, bool, error) {
		p, w, err := s.NativeMapping(a, x)
		if err != nil {
			return 0, false, err
		}
		off, ok := offset(p, 1)
		if !ok || off >= uint64(len(ram)) || off&4095 != p&4095 {
			return 0, false, fmt.Errorf("native address is not page-aligned RAM")
		}
		return off, w, nil
	})
	j.ram.ReadGuest = s.NativeRead
	j.ram.WriteGuest = s.Write
	j.ram.EnableOwnedMemory()
	j.ram.EnableCodeProofs()
	config := engine.DefaultEngineConfig()
	config.CacheContexts = true
	config.DynamicCode = true
	config.NaturalBlocks = true
	config.MaxInstructions, config.MaxRegionInstructions = 0, 0
	config.Adaptive = true
	config.DiscoveryThreshold, config.IRThreshold, config.NativeThreshold, config.RegionThreshold = 0, 0, 0, 0
	config.LoopRegionsOnly = false
	config.MaxNativeInstructions = 4096
	config.MaxBlocks = 0
	config.NativeBytes = 64 << 20
	config.EvictCold = true
	config.RecycleNative = true
	// Native sessions own a bounded scheduling slice. Every architectural
	// slow instruction is a scheduling boundary, so mode/device transitions
	// cannot continue under the previous segment/MMU context.
	arch := engine.Architecture{Name: "x86_pc", StateWords: pcStateWords, PC: pcSlot, Alignment: 1}
	arch.Fetch = j.fetch
	arch.Lower = func(b *emu.Builder, ins engine.Instruction, completed int) bool {
		if !pcSupported(ins.Decoded.(Instruction), s.CodeBits()) {
			return false
		}
		if s.CodeBits() == 64 {
			return lowerInstruction(b, ins, completed, true)
		}
		return lowerInstruction(b, ins, completed, false, s)
	}
	var err error
	j.engine, err = engine.New(config, arch)
	if err != nil {
		return nil, err
	}
	if !j.engine.NativeAvailable() {
		j.engine.Close()
		return nil, fmt.Errorf("RFE PC JIT requires native code generation on this host")
	}
	return j, nil
}
func pcSupported(i Instruction, bits int) bool {
	if bits == 64 {
		return supportedSystem(i)
	}
	if legacyString(i.Op) {
		return true
	}
	if i.Op == "pusha" || i.Op == "popa" {
		return i.Width == 2 || i.Width == 4
	}
	if i.Op == "pushseg" || i.Op == "readseg" {
		return i.CC < 6
	}
	bare := i
	bare.Dst.Segment = 0
	bare.Src.Segment = 0
	if !supported(bare) {
		return false
	}
	// These instructions have additional implicit semantics not represented by
	// the scalar lowerer. Keep them at the architectural boundary for now.
	if i.Op == "pushf" || i.Op == "pop" && i.Dst.Kind == memOperand {
		return false
	}
	if (i.Op == "bt" || i.Op == "bts" || i.Op == "btr" || i.Op == "btc") && i.Dst.Kind == memOperand {
		return false
	}
	return true
}
func (j *PCJIT) fetch(m engine.Memory, pc uint64) (engine.Instruction, error) {
	s := j.cpu.System
	bits := s.CodeBits()
	base := uint64(0)
	if bits != 64 {
		base = j.cpu.System.Segments[1].Base
	}
	i, err := DecodeMode(pcFetch{j, base}, pc-base, bits)
	if err != nil {
		return engine.Instruction{}, err
	}
	memory := i.Dst.Kind == memOperand || i.Src.Kind == memOperand
	switch i.Op {
	case "call", "callind", "push", "pushf", "pop", "ret", "movs", "cmps", "stos", "lods", "scas", "leave", "pusha", "popa", "pushseg":
		memory = true
	case "lea", "nop":
		memory = false
	}
	ins := engine.Instruction{PC: pc, Length: uint8(i.Next - i.PC), Decoded: i, Memory: memory, InterpretOnly: !pcSupported(i, bits), ScheduleBoundary: !pcSupported(i, bits), Flow: engine.Successors{Known: true, Next: base + i.Next}}
	switch i.Op {
	case "jmp":
		ins.Terminal = true
		ins.Flow.Next = base + i.Src.Imm
	case "jcc", "loop":
		ins.Terminal = true
		ins.Flow.Next = base + i.Src.Imm
		ins.Flow.Alternate = base + i.Next
		ins.Flow.Conditional = true
	case "call", "callind", "jmpind", "ret":
		ins.Terminal = true
		ins.Flow.Known = false
	}
	if legacyString(i.Op) {
		ins.Terminal = true
		if i.Repeat != 0 {
			ins.Flow = engine.Successors{Known: true, Conditional: true, Next: pc, Alternate: base + i.Next}
		}
	}
	// No speculative block discovery may decode beyond legacy IP wrapping.
	if bits != 64 && i.Next > mask(uint8(bits/8)) {
		ins.Terminal = true
		ins.Flow.Known = false
	}
	return ins, nil
}
func (j *PCJIT) Read(a uint64, n int, x bool) (uint64, error) {
	s := j.cpu.System
	if !x {
		return s.NativeRead(a, n, false)
	}
	if s.CodeBits() != 64 {
		var err error
		a, err = s.segmentAddress(1, a-s.Segments[1].Base, n, false, true)
		if err != nil {
			return 0, err
		}
	}
	if n < 1 || n > 8 || a+uint64(n-1) < a {
		return 0, gp()
	}
	var value uint64
	// Resolve performs the architectural execute/MMU check and admits only
	// physical RAM owned by this backing. Reuse that proof for the byte read
	// and write watch, rather than walking the same mapping three times.
	// Straddling bytes resolve independently; frames need not be adjacent.
	for at := 0; at < n; at++ {
		offset, _, err := j.ram.Resolve(a+uint64(at), true)
		if err != nil {
			return 0, err
		}
		j.codeBytes[offset>>6] |= uint64(1) << (offset & 63)
		j.ram.MarkCodeBytes(offset, 1)
		value |= uint64(j.ram.Data[offset]) << uint(at*8)
	}
	return value, nil
}
func (j *PCJIT) Write(a uint64, n int, v uint64) error { return j.cpu.System.Write(a, n, v) }

type pcFetch struct {
	jit  *PCJIT
	base uint64
}

func (m pcFetch) Read(a uint64, n int, x bool) (uint64, error) { return m.jit.Read(m.base+a, n, x) }
func (m pcFetch) Write(a uint64, n int, v uint64) error        { return fmt.Errorf("write through code bus") }
func (j *PCJIT) CodeContext() engine.CodeStamp {
	stamp := j.ram.CodeContext()
	return engine.CodeStamp{Identity: j.domain.identity, Epoch: stamp.Epoch}
}
func (j *PCJIT) CodeVersion(a uint64) (engine.CodeStamp, error) {
	stamp, err := j.ram.CodeVersion(a)
	if err != nil {
		return engine.CodeStamp{}, err
	}
	identity := j.domain.pages[stamp.Identity]
	if identity == nil {
		identity = new(engine.CodeIdentity)
		j.domain.pages[stamp.Identity] = identity
	}
	return engine.CodeStamp{Identity: identity, Epoch: stamp.Epoch}, nil
}

// ExternalWrite is required after untracked host edits through borrowed RAM.
// Page-table/guest stores use the narrower physical barriers instead.
func (j *PCJIT) ExternalWrite()                    { j.Invalidate(); j.domains = nil; j.domain = nil }
func (j *PCJIT) SetStopFlag(stop *uint32)          { j.stop = stop; j.ram.StopFlag = stop }
func (j *PCJIT) NativeContext() *emu.MemoryContext { j.selectDomain(); return j.ram.NativeContext() }
func (j *PCJIT) NativeRefill(a uint64)             { j.selectDomain(); j.ram.NativeRefill(a) }
func (j *PCJIT) NativeBacking() []byte             { return j.ram.Data }
func (j *PCJIT) NativeCodeVersions() bool          { return true }
func (j *PCJIT) Invalidate()                       { j.cpu.System.clearTranslations(); j.ram.InvalidateMappings() }
func (j *PCJIT) overlapsCode(offset uint64, n int) bool {
	if n < 1 || offset >= uint64(len(j.ram.Data)) || uint64(n) > uint64(len(j.ram.Data))-offset {
		return true
	}
	for at := offset; at < offset+uint64(n); at++ {
		if j.codeBytes[at>>6]&(uint64(1)<<(at&63)) != 0 {
			return true
		}
	}
	return false
}
func (j *PCJIT) BeforeWrite(offset uint64, n int) {
	table := j.ram.IsPageTable(offset, n)
	if table {
		pages := j.cpu.System.invalidatePageTableWrite(offset, n)
		for _, page := range pages {
			j.invalidateMappingSpace(page.space, page.page<<12, 4096)
		}
	}
	if j.overlapsCode(offset, n) {
		j.ram.BeforeWrite(offset, n)
	} else if !table {
		j.ram.BeforeNonCodeWrite(offset, n)
	}
}
func (j *PCJIT) ReclaimCode()                            { clear(j.codeBytes); j.ram.ReclaimCode() }
func (j *PCJIT) MarkPageTable(offset uint64)             { j.ram.MarkPageTableEntry(offset&^uint64(4095), 4096) }
func (j *PCJIT) MarkPageTableEntry(offset uint64, n int) { j.ram.MarkPageTableEntry(offset, n) }
func (j *PCJIT) BeforePageTableMetadata(offset uint64, n int) {
	if j.overlapsCode(offset, n) {
		j.ram.BeforePageTableMetadata(offset, n)
	}
	// A/D are monotonically ORed by the hardware walker. They cannot revoke
	// any native permission; a dirty-bit upgrade is seen by the next refill.
}
func (j *PCJIT) Close() error { err := j.engine.Close(); j.ram.Close(); return err }
func (j *PCJIT) Run(budget uint64) error {
	if budget == 0 {
		return fmt.Errorf("instruction budget exhausted")
	}
	s := j.cpu.System
	j.selectDomain()
	key := j.key
	if s.IRQShadow != 0 || j.cpu.Flags&((1<<8)|(1<<16)) != 0 {
		return j.cpu.Step()
	}
	j.adapter.Import()
	nativeBefore := j.engine.Stats.Native
	start := j.cpu.Retired
	remaining := budget
	var err error
	for remaining != 0 {
		if j.stop != nil && atomic.LoadUint32(j.stop) != 0 {
			break
		}
		flagsBefore := j.adapter.native[flagsSlot]
		before := j.cpu.Retired
		compiledBefore := j.engine.Stats.Native + j.engine.Stats.IR
		err = j.engine.Run(j.adapter, remaining)
		compiled := j.engine.Stats.Native + j.engine.Stats.IR - compiledBefore
		// Commit time before another dispatch can read RDTSC or enter an
		// architectural path. The ABI already holds the live integer state.
		if !s.ExternalClock {
			s.TSC += compiled * TSCTicksPerInstruction
		}
		retired := j.cpu.Retired - before
		// Pure native/IR leaves may share state until this bounded edge.
		// ANY architectural instruction/fault/device path returns immediately,
		// so IF/shadow/mode/MMU changes cannot escape scheduler synchronization.
		if err != nil || retired == 0 {
			break
		}
		if retired != compiled {
			// An architectural helper need not force a scheduler round trip
			// when it left the execution context intact and raised no event.
			owner, ok := s.Physical.(interface{ ContinueExecution() bool })
			currentCode := s.Segments[1]
			currentCode.Selector = 0
			same := currentCode == key.code && s.CR[0]&(1|1<<16|1<<31) == key.cr0 && s.CR[3] == key.cr3 && s.CR[4] == key.cr4 && s.EFER == key.efer && s.CPL == key.cpl && j.cpu.Flags&(1<<17) == key.vm
			if j.stop == nil || !ok || !owner.ContinueExecution() || !same || s.Halted || s.IRQShadow != 0 || j.cpu.Flags&((1<<8)|(1<<16)) != 0 || (flagsBefore^j.cpu.Flags)&FlagIF != 0 {
				break
			}
		}
		if j.stop == nil && j.cpu.Retired-start >= 512 {
			break
		}
		if retired >= remaining {
			break
		}
		remaining -= retired
	}
	j.adapter.Export()
	if !j.engine.NativeAvailable() {
		return fmt.Errorf("RFE native code arena became unavailable")
	}
	index := 0
	if key.efer&(1<<10) != 0 && key.code.Flags&(1<<13) != 0 {
		index = 2
	} else if s.CodeBits() == 32 {
		index = 1
	}
	j.tiers[index] += j.engine.Stats.Native - nativeBefore
	return err
}
func (j *PCJIT) Stats() map[string]uint64 {
	s := j.engine.Stats
	result := map[string]uint64{"enabled": 1, "native": s.Native, "ir": s.IR, "interpreted": j.cpu.Retired - s.Native - s.IR, "blocks": s.Blocks, "arena_resets": s.ArenaResets, "promotions": s.Promotions, "invalidations": s.Invalidations, "identity_misses": s.VersionIdentityMisses, "epoch_misses": s.VersionEpochMisses, "version_faults": s.VersionFaults, "compile_failures": s.CompileFailures, "native_bytes": uint64(s.NativeBytes), "native_memory": s.NativeMemory, "linked": s.Linked, "native_sessions": s.NativeSessions, "regions": s.Regions, "memory_exits": s.MemoryExits, "native16": j.tiers[0], "native32": j.tiers[1], "native64": j.tiers[2]}
	return result

}

func (j *PCJIT) selectDomain() {
	s := j.cpu.System
	// Runtime segment bases are ABI inputs, not compilation identities. TS,
	// EM and MP affect only architectural x87/privileged slow paths; including
	// them would continually discard identical kernel code on task switches.
	code := s.Segments[1]
	code.Selector = 0
	key := pcKey{code: code, cr0: s.CR[0] & (1 | 1<<16 | 1<<31), cr3: s.CR[3], cr4: s.CR[4], efer: s.EFER, vm: j.cpu.Flags & (1 << 17), cpl: s.CPL}
	if key != j.key || j.domain == nil {
		j.key = key
		if j.domains == nil {
			j.domains = make(map[pcKey]*pcDomain)
		}
		j.domain = j.domains[key]
		if j.domain == nil {
			// Each live translation domain keeps its own stable identity.
			j.domain = &pcDomain{identity: new(engine.CodeIdentity), pages: make(map[*engine.CodeIdentity]*engine.CodeIdentity)}
			j.domains[key] = j.domain
		}
		mappingKey := pcMappingKey{key.cr0, key.cr3, key.cr4, key.efer, key.vm, key.cpl}
		if j.mappings == nil {
			j.mappings = make(map[pcMappingKey]*engine.CodeIdentity)
		}
		identity := j.mappings[mappingKey]
		if identity == nil {
			identity = new(engine.CodeIdentity)
			j.mappings[mappingKey] = identity
		}
		j.ram.SelectNativeContext(identity)
	}
}
func (j *PCJIT) SwitchAddressSpace() { j.selectDomain() }
func (j *PCJIT) InvalidateNativeRange(base, size uint64) {
	j.invalidateMappingSpace(j.cpu.System.mappingSpace(), base, size)
}

func (j *PCJIT) CodeMutation() uint64 { return j.ram.CodeMutation() }
func (j *PCJIT) ProveCode(ranges []engine.CodeRange, mutation uint64) engine.CodeProof {
	return j.ram.ProveCode(ranges, mutation)
}

func (j *PCJIT) invalidateMappingSpace(space mappingSpace, address, size uint64) {
	for key, identity := range j.mappings {
		if key.cr3 == space.root && key.cr0&(1<<31)|key.cr4<<32 == space.paging && key.efer == space.features {
			j.ram.InvalidateTaggedRange(identity, address, size)
		}
	}
}

func (j *PCJIT) CodeProofsEnabled() bool { return true }

-- pc_lower.go --
package x86

import emu "renvo.dev/internal/rfe/runtime"

// PC lowering uses the existing arithmetic IR, with legacy address-size,
// segment and stack rules. A failed guard returns at the instruction checkpoint
// before any store; the architectural interpreter then delivers the real fault.
func (l lowerer) controlWidth() uint8 {
	if l.pc != nil {
		return l.i.Width
	}
	return 8
}
func (l lowerer) storePC(v emu.Value) {
	if l.pc != nil && l.pc.CodeBits() != 64 {
		v = l.and(v, mask(uint8(l.pc.CodeBits()/8)))
	}
	if l.pc != nil {
		v = l.bin(emu.Add, v, l.b.Constant(l.pc.Segments[1].Base))
	}
	l.b.Store(pcSlot, v)
}
func (l lowerer) pcStackMask() emu.Value {
	if l.pc == nil {
		return l.b.Constant(^uint64(0))
	}
	if l.pc.CR[0]&1 == 0 || l.pc.CPU.Flags&(1<<17) != 0 {
		return l.b.Constant(65535)
	}
	wide := l.and(l.b.Load(pcSegmentSlot+2*3+2), 1<<14)
	return l.b.Choose(wide, l.b.Constant(0xffffffff), l.b.Constant(65535))
}
func (l lowerer) stackPointer(v emu.Value) emu.Value { return l.bin(emu.And, v, l.pcStackMask()) }
func (l lowerer) storeSP(v emu.Value) {
	m := l.pcStackMask()
	l.b.Store(RSP, l.bin(emu.Or, l.bin(emu.And, l.b.Load(RSP), l.bin(emu.Xor, m, l.b.Constant(^uint64(0)))), l.bin(emu.And, v, m)))
}
func (l lowerer) stackAddress(v emu.Value, w uint8, write bool) emu.Value {
	if l.pc == nil {
		return v
	}
	return l.segmentAddress(2, v, w, write)
}
func (l lowerer) segmentAddress(index int, offset emu.Value, w uint8, write bool) emu.Value {
	b := l.b
	base, limit, flags := b.Load(pcSegmentSlot+index*3), b.Load(pcSegmentSlot+index*3+1), b.Load(pcSegmentSlot+index*3+2)
	protected := l.pc.CR[0]&1 != 0 && l.pc.CPU.Flags&(1<<17) == 0
	if protected {
		present := l.bin(emu.Equal, l.and(flags, 0x90), b.Constant(0x90))
		b.Guard(present)
		code := l.and(flags, 8)
		if write {
			b.Guard(l.bin(emu.Equal, l.and(flags, 0xa), b.Constant(2)))
		} else {
			b.Guard(l.bin(emu.Or, l.not(l.bin(emu.Equal, code, b.Constant(8))), l.and(flags, 2)))
		}
	}
	end := l.bin(emu.Add, offset, b.Constant(uint64(w)-1))
	b.Guard(l.not(l.bin(emu.Less, end, offset)))
	rangeOK := l.not(l.bin(emu.Less, limit, end))
	if protected {
		expand := l.bin(emu.Equal, l.and(flags, 0xc), b.Constant(4))
		top := b.Choose(l.and(flags, 1<<14), b.Constant(0xffffffff), b.Constant(65535))
		downOK := l.bin(emu.And, l.bin(emu.Less, limit, offset), l.not(l.bin(emu.Less, top, end)))
		rangeOK = b.Choose(expand, downOK, rangeOK)
	}
	b.Guard(rangeOK)
	return l.bin(emu.Add, offset, base)
}
func (l lowerer) memoryAddress(o Operand, w uint8, write bool) emu.Value {
	if l.pc == nil {
		return l.address(o)
	}
	segment := segmentIndex(o.Segment)
	o.Segment = 0
	return l.segmentAddress(segment, l.address(o), w, write)
}

-- pc_register_stack.go --
package x86

import emu "renvo.dev/internal/rfe/runtime"

// All transfers share one architectural checkpoint. Stack-pointer wrapping is
// independent of operand width; guards preserve the original register state on
// a precise exit. Earlier plain-RAM writes are idempotent on architectural retry.
func (l lowerer) allRegisters() {
	b, w := l.b, l.i.Width
	original := b.Load(RSP)
	if l.i.Op == "pusha" {
		for i, reg := range []int{RAX, RCX, RDX, RBX, RSP, RBP, RSI, RDI} {
			value := b.Load(reg)
			if reg == RSP {
				value = original
			}
			sp := l.stackPointer(l.bin(emu.Sub, original, b.Constant(uint64(i+1)*uint64(w))))
			b.MemoryStore(l.stackAddress(sp, w, true), value, int(w))
		}
		l.storeSP(l.bin(emu.Sub, original, b.Constant(8*uint64(w))))
	} else {
		for i, reg := range []int{RDI, RSI, RBP, RSP, RBX, RDX, RCX, RAX} {
			sp := l.stackPointer(l.bin(emu.Add, original, b.Constant(uint64(i)*uint64(w))))
			value := b.MemoryLoad(l.stackAddress(sp, w, false), int(w))
			if reg != RSP {
				l.write(Operand{Kind: regOperand, Reg: reg}, w, value)
			}
		}
		l.storeSP(l.bin(emu.Add, original, b.Constant(8*uint64(w))))
	}
}

-- pc_string.go --
package x86

import emu "renvo.dev/internal/rfe/runtime"

func legacyString(op string) bool {
	switch op {
	case "movs", "cmps", "stos", "lods", "scas":
		return true
	}
	return false
}

// One precise string iteration is a native instruction, not a host memcpy.
// REP follows a guarded self edge under the ordinary scheduling budget. Page
// faults, code/table stores and MMIO exit BEFORE register/count/flag updates.
func (l lowerer) legacyString(next emu.Value) emu.Value {
	b, i := l.b, l.i
	w, m := i.Width, mask(i.AddressWidth)
	count := l.and(b.Load(RCX), m)
	if i.Repeat != 0 {
		b.Guard(l.not(l.bin(emu.Equal, count, b.Constant(0))))
	}
	src := i.Op == "movs" || i.Op == "cmps" || i.Op == "lods"
	dst := i.Op != "lods"
	var source, target emu.Value
	if src {
		seg := i.Segment
		if seg == 0 {
			seg = 0x3e
		}
		if l.pc != nil {
			source = l.segmentAddress(segmentIndex(seg), l.and(b.Load(RSI), m), w, false)
		} else {
			source = l.and(b.Load(RSI), m)
			if seg == 0x64 {
				source = l.bin(emu.Add, source, b.Load(fsBaseSlot))
			}
			if seg == 0x65 {
				source = l.bin(emu.Add, source, b.Load(gsBaseSlot))
			}
		}
	}
	if dst {
		target = l.and(b.Load(RDI), m)
		if l.pc != nil {
			target = l.segmentAddress(0, target, w, i.Op == "movs" || i.Op == "stos")
		}
	}
	a := l.narrow(b.Load(RAX), w)
	if src {
		a = b.MemoryLoad(source, int(w))
	}
	if i.Op == "cmps" || i.Op == "scas" {
		rhs := b.MemoryLoad(target, int(w))
		result := l.narrow(l.bin(emu.Sub, a, rhs), w)
		flags := l.arithmetic(a, rhs, result, w, true)
		b.Store(flagsSlot, l.bin(emu.Or, l.and(b.Load(flagsSlot), ^arithmeticFlags), flags))
	}
	if i.Op == "movs" || i.Op == "stos" {
		b.MemoryStore(target, a, int(w))
	}
	if i.Op == "lods" {
		l.write(Operand{Kind: regOperand, Reg: RAX}, w, a)
	}
	delta := b.Choose(l.and(b.Load(flagsSlot), FlagDF), b.Constant(-uint64(w)), b.Constant(uint64(w)))
	update := func(reg int, value emu.Value) {
		// Match the legacy architectural loop: address width wraps the low
		// slice without changing the unused upper register bits.
		if l.pc == nil {
			b.Store(reg, l.and(value, m))
		} else {
			b.Store(reg, l.bin(emu.Or, l.and(b.Load(reg), ^m), l.and(value, m)))
		}
	}
	if src {
		update(RSI, l.bin(emu.Add, b.Load(RSI), delta))
	}
	if dst {
		update(RDI, l.bin(emu.Add, b.Load(RDI), delta))
	}
	if i.Repeat != 0 {
		count = l.and(l.bin(emu.Sub, count, b.Constant(1)), m)
		update(RCX, count)
		again := l.not(l.bin(emu.Equal, count, b.Constant(0)))
		if i.Op == "cmps" || i.Op == "scas" {
			equal := l.not(l.bin(emu.Equal, l.and(b.Load(flagsSlot), ZF), b.Constant(0)))
			if i.Repeat != 0xf3 {
				equal = l.not(equal)
			}
			again = l.bin(emu.And, again, equal)
		}
		next = b.Choose(again, b.Constant(i.PC), next)
	}
	return next
}

-- ports.go --
package x86

// TransactionalPortBus suspends an instruction for a caller-serviced port
// access. A retry must return the previously completed access without replaying
// its device side effect, including when INS also needs an MMIO exit.
type TransactionalPortBus interface {
	ReadPort(uint16, int) (uint32, error)
	WritePort(uint16, int, uint32) error
}

func (s *System) portRead(port uint16, n int) (uint32, error) {
	if p, ok := s.Ports.(TransactionalPortBus); ok {
		return p.ReadPort(port, n)
	}
	return s.Ports.In(port, n), nil
}
func (s *System) portWrite(port uint16, n int, v uint32) error {
	if p, ok := s.Ports.(TransactionalPortBus); ok {
		return p.WritePort(port, n, v)
	}
	s.Ports.Out(port, n, v)
	return nil
}

// Protected-mode I/O below IOPL and ALL VM86 I/O consult the 386 TSS
// permission map. In VM86, IOPL3 permits CLI/STI but must NOT bypass port
// traps: VMMs rely on these traps to virtualize the PIC EOI. Check every
// byte of a word/dword operation.
func (s *System) allowIO(port uint16, n int) error {
	if s.CR[0]&1 == 0 || s.CPU.Flags&(1<<17) == 0 && s.CPL <= uint8(s.CPU.Flags>>12&3) {
		return nil
	}
	if s.TR.Limit < 103 || s.TR.Flags&15 != 9 && s.TR.Flags&15 != 11 {
		return gp()
	}
	old := s.supervisor
	s.supervisor = true
	defer func() { s.supervisor = old }()
	base, err := s.Read(s.TR.Base+102, 2, false)
	if err != nil {
		return err
	}
	for j := 0; j < n; j++ {
		p := uint64(port) + uint64(j)
		off := base + p/8
		if p > 65535 || off > uint64(s.TR.Limit) {
			return gp()
		}
		bits, err := s.Read(s.TR.Base+off, 1, false)
		if err != nil {
			return err
		}
		if bits&(1<<(p&7)) != 0 {
			return gp()
		}
	}
	return nil
}

-- ports_privilege_test.go --
package x86

import (
	"errors"
	"testing"
)

type permissionPorts struct{ calls int }

func (p *permissionPorts) In(uint16, int) uint32   { p.calls++; return 0xa5 }
func (p *permissionPorts) Out(uint16, int, uint32) { p.calls++ }

func TestVM86IOPL3StillTrapsDeniedPorts(t *testing.T) {
	for _, op := range []string{"in", "out", "ins", "outs"} {
		t.Run(op, func(t *testing.T) {
			c, s := protectedTestCPU(t)
			m := s.Physical
			ports := &permissionPorts{}
			s.Ports = ports
			s.CPL = 3
			c.Flags = 0x23202
			c.R[RAX] = 0x20
			c.R[RDX] = 0x20
			c.R[RCX] = 1
			c.R[RSI] = 0x400
			c.R[RDI] = 0x500
			s.TR = Segment{Base: 0x800, Limit: 0x100, Flags: 0x8b}
			m.Write(0x866, 2, 0x68)
			m.Write(0x86c, 1, 1)
			before := c.R
			i := Instruction{PC: c.PC, Next: c.PC + 1, Op: op, Width: 1, AddressWidth: 2, Src: Operand{Kind: regOperand, Reg: RDX}}
			err := c.Execute(i)
			var ex *Exception
			if !errors.As(err, &ex) || ex.Vector != 13 || !ex.HasCode || ex.Code != 0 || ports.calls != 0 || c.R != before {
				t.Fatalf("denied %s: err%v calls%d regs%x", op, err, ports.calls, c.R)
			}
			m.Write(0x86c, 1, 0)
			if err = c.Execute(i); err != nil || ports.calls != 1 {
				t.Fatalf("permitted %s: err%v calls%d", op, err, ports.calls)
			}
		})
	}
}
func TestIOPermissionMapCoversEveryPortByte(t *testing.T) {
	c, s := protectedTestCPU(t)
	c.Flags = 0x23002
	s.CPL = 3
	s.TR = Segment{Base: 0x800, Limit: 0x100, Flags: 0x8b}
	s.Physical.Write(0x866, 2, 0x68)
	// A word at 0x27 crosses bitmap bytes; denying only 0x28 denies the word.
	s.Physical.Write(0x86d, 1, 1)
	if err := s.allowIO(0x27, 1); err != nil {
		t.Fatal(err)
	}
	if err := s.allowIO(0x27, 2); err == nil {
		t.Fatal("word bypassed second port permission")
	}
	// Protected ring3 IOPL3 bypasses the map; virtual8086 does not.
	c.Flags &^= 1 << 17
	if err := s.allowIO(0x27, 2); err != nil {
		t.Fatal(err)
	}
}

-- scalar_legacy_native_test.go --
package x86

import (
	"bytes"
	"fmt"
	"renvo.dev/internal/rfe/engine"
	emu "renvo.dev/internal/rfe/runtime"
	"testing"
)

// One-instruction native blocks make the operation under test, rather than a
// neighboring branch, responsible for native retirement. Every case is also
// repeated after changing operand values and imported segment selectors.
func TestNativeLegacyScalarDifferential(t *testing.T) {
	for _, bits := range []int{16, 32, 64} {
		codes := [][]byte{{0x87, 0xc4}, {0x87, 0xc0}, {0x86, 0xdc}, {0x99}, {0x66, 0x99}, {0xc9}, {0x66, 0xc9}, {0x87, 0x03}}
		if bits == 64 {
			codes = append(codes, []byte{0x48, 0x99}, []byte{0x48, 0x87, 0x03})
		}
		if bits != 64 {
			for _, pre := range [][]byte{nil, {0x66}} {
				for _, op := range []byte{0x60, 0x61, 0x06, 0x0e, 0x16, 0x1e} {
					codes = append(codes, append(append([]byte{}, pre...), op))
				}
			}
			for _, mod := range []byte{0xc0, 0xc8, 0xd0, 0xd8, 0xe0, 0xe8, 0x03} {
				codes = append(codes, []byte{0x8c, mod})
			}
		}
		for _, pre := range [][]byte{nil, {0x67}} {
			for _, op := range []byte{0xe0, 0xe1, 0xe2, 0xe3} {
				codes = append(codes, append(append([]byte{}, pre...), op, 0x05))
			}
		}
		for _, code := range codes {
			if bits == 64 && bytes.Equal(code, []byte{0x66, 0xc9}) {
				continue
			}
			t.Run(fmt.Sprintf("%d/%x", bits, code), func(t *testing.T) {
				setup := func() (*CPU, *pcFetchRAM, *PCJIT) { return forcedNativePC(t, bits, code) }
				actual, am, j := setup()
				defer j.Close()
				expected, em, ref := setup()
				defer ref.Close()
				for pass := 0; pass < 12; pass++ {
					for _, c := range []*CPU{actual, expected} {
						c.PC = 0x1000
						c.Flags = 2 | FlagIF | FlagDF | arithmeticFlags
						if pass&1 != 0 {
							c.Flags &^= (1 << 6)
						}
						for r := range c.R {
							c.R[r] = uint64(0x8765432100000000 | uint64(pass*71+r*131))
						}
						c.R[RAX] = []uint64{0, 0x8000, 0x80000000, 0x8000000000000000}[pass%4]
						c.R[RCX] = []uint64{0, 1, 2, 0xffff, 0x10000, 0xffffffff}[pass%6] | 0x1234000000000000
						c.R[RBX] = 0x300
						c.R[RBP] = 0x800
						c.R[RSP] = 0x900
						for s := range c.System.Segments {
							c.System.Segments[s].Selector = uint16(pass*8 + s)
						}
					}
					for k := 0x200; k < 0x1000; k++ {
						am.data[k] = byte(k + pass)
						em.data[k] = byte(k + pass)
					}
					j.adapter.Import()
					if err := expected.Step(); err != nil {
						t.Fatal(err)
					}
					for actual.Retired < expected.Retired {
						if err := j.Run(1); err != nil {
							t.Fatal(err)
						}
					}
					if actual.R != expected.R || actual.Flags != expected.Flags || actual.PC != expected.PC || actual.Retired != expected.Retired || actual.System.TSC != expected.System.TSC || !bytes.Equal(am.data, em.data) {
						t.Fatalf("pass%d state R=%x/%x pc=%x/%x flags=%x/%x retired=%d/%d", pass, actual.R, expected.R, actual.PC, expected.PC, actual.Flags, expected.Flags, actual.Retired, expected.Retired)
					}
				}
				if j.engine.Stats.Native == 0 {
					t.Fatal("target instruction never native", j.engine.Stats)
				}
			})
		}
	}
}

func forcedNativePC(t *testing.T, bits int, code []byte) (*CPU, *pcFetchRAM, *PCJIT) {

	m := &pcFetchRAM{data: make([]byte, 1<<20)}
	c := &CPU{PC: 0x1000, Flags: 2}
	s := NewPCSystem(c, m, nil)
	if bits != 16 {
		s.CR[0] |= 1
		s.Segments[1].Flags |= 1 << 14
		s.Segments[2].Flags |= 1 << 14
	}
	if bits == 64 {
		s.EFER = 1 << 10
		s.Segments[1].Flags |= 1 << 13
	}
	copy(m.data[0x1000:], code)
	j, err := NewPCJIT(c, m.data, func(a uint64, n int) (uint64, bool) {
		return a, a < uint64(len(m.data)) && uint64(n) <= uint64(len(m.data))-a
	})
	if err != nil {
		t.Fatal(err)
	}
	j.engine.Close()
	cfg := engine.DefaultEngineConfig()
	cfg.CacheContexts = true
	cfg.IRThreshold = 1
	cfg.NativeThreshold = 1
	cfg.MaxInstructions = 1
	cfg.MaxRegionInstructions = 1
	arch := engine.Architecture{Name: "scalar_test", StateWords: pcStateWords, PC: pcSlot, Alignment: 1, Fetch: j.fetch}
	arch.Lower = func(b *emu.Builder, i engine.Instruction, n int) bool {
		if !pcSupported(i.Decoded.(Instruction), bits) {
			return false
		}
		if bits == 64 {
			return lowerInstruction(b, i, n, true)
		}
		return lowerInstruction(b, i, n, false, s)
	}
	j.engine, err = engine.New(cfg, arch)
	if err != nil {
		t.Fatal(err)
	}
	return c, m, j

}

func TestNativeLegacyStackOperationsPreserveFaultingInstruction(t *testing.T) {
	for _, bits := range []int{16, 32} {
		for _, op := range []byte{0x60, 0x61, 0xc9} {
			t.Run(fmt.Sprintf("%d/%x", bits, op), func(t *testing.T) {
				a, am, j := forcedNativePC(t, bits, []byte{op})
				defer j.Close()
				e, em, ref := forcedNativePC(t, bits, []byte{op})
				defer ref.Close()
				for pass := 0; pass < 3; pass++ {
					for _, c := range []*CPU{a, e} {
						c.PC = 0x1000
						c.Flags = 2
						c.R[RSP] = 0x800
						c.R[RBP] = 0x900
						c.System.IDTR.Limit = 0
						c.System.Segments[2].Limit = 65535
						if pass == 2 {
							c.System.Segments[2].Limit = 0x30
							c.R[RSP] = 4
							if op == 0x9c {
								c.R[RSP] = 1
							}
							if op == 0x61 || op == 0x9d {
								c.R[RSP] = 0x30
							}
							c.R[RBP] = 0x30
						}
					}
					clear(am.data[0x700:0xa00])
					clear(em.data[0x700:0xa00])
					want := e.Step()
					got := j.Run(1)
					if (want != nil) != (got != nil) || a.R != e.R || a.PC != e.PC || a.Flags != e.Flags || a.Retired != e.Retired || !bytes.Equal(am.data, em.data) {
						t.Fatalf("pass%d error=%v/%v R=%x/%x pc=%x/%x retired=%d/%d", pass, got, want, a.R, e.R, a.PC, e.PC, a.Retired, e.Retired)
					}
					if pass == 2 && want == nil {
						t.Fatal("missing reference stack fault")
					}
				}
				if j.engine.Stats.Native == 0 {
					t.Fatal("stack operation never native")
				}
			})
		}
	}
}

-- segmentation.go --
package x86

func (s *System) segmentAddress(index int, offset uint64, n int, write, execute bool) (uint64, error) {
	seg := s.Segments[index]
	if s.CR[0]&1 == 0 || s.CPU.Flags&(1<<17) != 0 {
		// Real mode still enforces the cached segment limit. HIMEM's
		// unreal-mode copy routine deliberately faults here, installs a
		// 4-GiB data cache in its #GP handler, and retries the instruction.
		end := offset + uint64(n) - 1
		if n < 1 || end < offset || end > uint64(seg.Limit) {
			if index == 2 {
				return 0, &Exception{Vector: 12, HasCode: s.CR[0]&1 != 0}
			}
			return 0, &Exception{Vector: 13, HasCode: s.CR[0]&1 != 0}
		}
		return seg.Base + offset, nil
	}
	fault := func() (uint64, error) {
		if index == 2 {
			return 0, &Exception{Vector: 12, HasCode: true}
		}
		return 0, gp()
	}
	if seg.Flags&0x80 == 0 || seg.Flags&16 == 0 {
		return fault()
	}
	code := seg.Flags&8 != 0
	if execute && !code || write && (code || seg.Flags&2 == 0) || !execute && !write && code && seg.Flags&2 == 0 {
		return fault()
	}
	end := offset + uint64(n) - 1
	if n < 1 || end < offset {
		return fault()
	}
	if !code && seg.Flags&4 != 0 {
		top := uint64(0xffff)
		if seg.Flags&(1<<14) != 0 {
			top = 0xffffffff
		}
		if offset <= uint64(seg.Limit) || end > top {
			return fault()
		}
	} else if end > uint64(seg.Limit) {
		return fault()
	}
	return seg.Base + offset, nil
}
func (c *CPU) memoryAddress(o Operand, next uint64, n int, write bool) (uint64, error) {
	a := c.address(o, next)
	if c.System == nil || !c.System.legacy() {
		return a, nil
	}
	index := segmentIndex(o.Segment)
	base := uint64(0)
	if o.Segment != 0 {
		base = c.System.Segments[index].Base
	}
	return c.System.segmentAddress(index, a-base, n, write, false)
}

