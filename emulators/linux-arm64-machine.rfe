-- boot.go --
package arm64machine

import (
	"bytes"
	"compress/gzip"
	"encoding/binary"
	"flag"
	"fmt"
	"io"
	"os"
	"renvo.dev/emulators/aarch64"
)

type deviceTree struct {
	body, strings []byte
	names         map[string]uint32
}

func (d *deviceTree) word(v uint32) { d.body = binary.BigEndian.AppendUint32(d.body, v) }
func (d *deviceTree) align() {
	for len(d.body)%4 != 0 {
		d.body = append(d.body, 0)
	}
}
func (d *deviceTree) node(n string) {
	d.word(1)
	d.body = append(d.body, []byte(n)...)
	d.body = append(d.body, 0)
	d.align()
}
func (d *deviceTree) end() { d.word(2) }
func (d *deviceTree) prop(n string, v []byte) {
	i, ok := d.names[n]
	if !ok {
		i = uint32(len(d.strings))
		d.names[n] = i
		d.strings = append(d.strings, []byte(n)...)
		d.strings = append(d.strings, 0)
	}
	d.word(3)
	d.word(uint32(len(v)))
	d.word(i)
	d.body = append(d.body, v...)
	d.align()
}
func (d *deviceTree) text(n, v string) { d.prop(n, append([]byte(v), 0)) }
func (d *deviceTree) cells(n string, v ...uint32) {
	var b []byte
	for _, x := range v {
		b = binary.BigEndian.AppendUint32(b, x)
	}
	d.prop(n, b)
}
func (m *Machine) dtb(args string, initStart, initEnd uint64) []byte {
	d := &deviceTree{names: map[string]uint32{}}
	d.node("")
	d.cells("#address-cells", 2)
	d.cells("#size-cells", 2)
	d.text("compatible", "linux,dummy-virt")
	d.text("model", "Renvo AArch64 virtual machine")
	d.cells("interrupt-parent", 1)
	d.node("chosen")
	d.text("bootargs", args)
	d.text("stdout-path", "/pl011@9000000")
	if initStart != 0 {
		d.cells("linux,initrd-start", uint32(initStart>>32), uint32(initStart))
		d.cells("linux,initrd-end", uint32(initEnd>>32), uint32(initEnd))
	}
	d.end()
	d.node("memory@40000000")
	d.text("device_type", "memory")
	d.cells("reg", 0, uint32(ramBase), 0, uint32(len(m.RAM)))
	d.end()
	d.node("cpus")
	d.cells("#address-cells", 1)
	d.cells("#size-cells", 0)
	d.node("cpu@0")
	d.text("device_type", "cpu")
	d.text("compatible", "arm,cortex-a53")
	d.cells("reg", 0)
	d.text("enable-method", "psci")
	d.end()
	d.end()
	d.node("psci")
	d.text("compatible", "arm,psci-0.2")
	d.text("method", "hvc")
	d.end()
	d.node("intc@8000000")
	d.text("compatible", "arm,cortex-a15-gic")
	d.cells("#interrupt-cells", 3)
	d.prop("interrupt-controller", nil)
	d.cells("#address-cells", 2)
	d.cells("#size-cells", 2)
	d.prop("ranges", nil)
	d.cells("reg", 0, uint32(gicDist), 0, 0x10000, 0, uint32(gicCPU), 0, 0x10000)
	d.cells("phandle", 1)
	d.end()
	d.node("timer")
	d.text("compatible", "arm,armv8-timer")
	d.cells("interrupts", 1, 13, 0xf08, 1, 14, 0xf08, 1, 11, 0xf08, 1, 10, 0xf08)
	d.prop("always-on", nil)
	d.end()
	d.node("apb-pclk")
	d.text("compatible", "fixed-clock")
	d.cells("#clock-cells", 0)
	d.cells("clock-frequency", 24000000)
	d.cells("phandle", 2)
	d.end()
	d.node("pl011@9000000")
	d.text("compatible", "arm,pl011\x00arm,primecell")
	d.cells("reg", 0, uint32(uartBase), 0, 0x1000)
	d.cells("interrupts", 0, 1, 4)
	d.cells("clocks", 2, 2)
	d.text("clock-names", "uartclk\x00apb_pclk")
	d.end()
	d.end()
	d.word(9)
	h := make([]byte, 56)
	values := []uint32{0xd00dfeed, uint32(56 + len(d.body) + len(d.strings)), 56, uint32(56 + len(d.body)), 40, 17, 16, 0, uint32(len(d.strings)), uint32(len(d.body))}
	for i, v := range values {
		binary.BigEndian.PutUint32(h[i*4:], v)
	}
	return append(append(h, d.body...), d.strings...)
}
func (m *Machine) Boot(kernel, initrd []byte, args string) error {
	if len(kernel) >= 2 && kernel[0] == 0x1f && kernel[1] == 0x8b {
		r, e := gzip.NewReader(bytes.NewReader(kernel))
		if e != nil {
			return e
		}
		kernel, e = io.ReadAll(io.LimitReader(r, int64(len(m.RAM))+1))
		r.Close()
		if e != nil {
			return e
		}
	}
	if len(kernel) < 64 || binary.LittleEndian.Uint32(kernel[56:]) != 0x644d5241 {
		return fmt.Errorf("kernel must be an uncompressed AArch64 Linux Image (or gzip Image)")
	}
	if binary.LittleEndian.Uint64(kernel[24:])&1 != 0 {
		return fmt.Errorf("big-endian kernel Images are unsupported")
	}
	offset := binary.LittleEndian.Uint64(kernel[8:])
	imageSize := binary.LittleEndian.Uint64(kernel[16:])
	if imageSize == 0 {
		offset = 0x80000
		imageSize = uint64(len(kernel))
	}
	if imageSize < uint64(len(kernel)) {
		imageSize = uint64(len(kernel))
	}
	if offset < 0x10000 {
		offset += 0x200000
	}
	if offset > uint64(len(m.RAM)) || imageSize > uint64(len(m.RAM))-offset {
		return fmt.Errorf("kernel does not fit guest RAM")
	}
	copy(m.RAM[offset:], kernel)
	initStart, initEnd := uint64(0), uint64(0)
	if len(initrd) > 0 {
		if uint64(len(initrd))+0x10000 > uint64(len(m.RAM)) {
			return fmt.Errorf("initramfs does not fit RAM")
		}
		initOffset := (uint64(len(m.RAM)) - uint64(len(initrd)) - 0x10000) &^ uint64(4095)
		if initOffset < offset+imageSize {
			return fmt.Errorf("initramfs overlaps kernel")
		}
		copy(m.RAM[initOffset:], initrd)
		initStart = ramBase + initOffset
		initEnd = initStart + uint64(len(initrd))
	}
	dt := m.dtb(args, initStart, initEnd)
	if len(dt) > 0x10000 {
		return fmt.Errorf("device tree too large")
	}
	copy(m.RAM, dt)
	m.CPU.State[aarch64.PC] = ramBase + offset
	m.CPU.State[0] = ramBase
	return nil
}
func Main(args []string) int {
	if err := run(args); err != nil {
		fmt.Fprintln(os.Stderr, "arm64-machine:", err)
		return 1
	}
	return 0
}
func run(args []string) error {
	f := flag.NewFlagSet("linux-arm64-machine", flag.ContinueOnError)
	kernel := f.String("kernel", "", "AArch64 Linux Image")
	initrd := f.String("initrd", "", "cpio initramfs (optionally compressed)")
	memory := f.Int("memory", 256, "RAM MiB")
	steps := f.Uint64("steps", 1000000000, "maximum guest instructions")
	appendArgs := f.String("append", "earlycon=pl011,0x09000000 console=ttyAMA0 rdinit=/init nokaslr maxcpus=1", "kernel command line")
	trace := f.String("trace", "", "instruction trace file")
	traceAfter := f.Uint64("trace-after", 0, "first instruction to trace")
	progress := f.Uint64("progress", 0, "diagnostic interval in guest instructions")
	stats := f.Bool("stats", false, "print retirement count")
	clockMode := f.String("clock", "deterministic", "system clock: realtime or deterministic")
	mode := f.String("engine", "native", "execution tier: native, ir, interpreter")
	jitProfile := f.Bool("jit-profile", false, "emit native JIT profiling symbols (diagnostic only)")
	jitCache := f.String("jit-cache", "default", "native cache preset: default, balanced8, balanced32, kernel32, balanced64")
	if e := f.Parse(args); e != nil {
		return e
	}
	if *kernel == "" {
		return fmt.Errorf("-kernel is required")
	}
	k, e := os.ReadFile(*kernel)
	if e != nil {
		return e
	}
	var init []byte
	if *initrd != "" {
		init, e = os.ReadFile(*initrd)
		if e != nil {
			return e
		}
	}
	// The checked RAM path remains the default. Fault-assisted direct RAM
	// is an explicit constructor experiment, not selected by execution tier.
	m, e := New(*memory, os.Stdout)
	if e != nil {
		return e
	}
	defer m.Close()
	if e = m.Boot(k, init, *appendArgs); e != nil {
		return e
	}
	if *trace != "" {
		out, e := os.Create(*trace)
		if e != nil {
			return e
		}
		defer out.Close()
		m.Trace = out
	}
	if *clockMode == "realtime" {
		m.UseRealtimeClock()
	} else if *clockMode != "deterministic" {
		return fmt.Errorf("clock must be realtime or deterministic")
	}
	m.ProfileJIT = *jitProfile
	m.JITCache = *jitCache
	if e = m.EnableSystemJIT(*mode); e != nil {
		return e
	}
	defer m.CloseJIT()
	defer m.printJITStats()
	input := make(chan []byte, 16)
	go func() {
		defer close(input)
		var b [256]byte
		for {
			n, e := os.Stdin.Read(b[:])
			if n > 0 {
				copyData := append([]byte(nil), b[:n]...)
				input <- copyData
			}
			if e != nil {
				return
			}
		}
	}()
	nextProgress := uint64(0)
	for i := uint64(0); i < *steps && !m.Done; {
		if *progress != 0 && i >= nextProgress {
			nextProgress = i + *progress
			fmt.Fprintf(os.Stderr, "progress instruction=%d pc=%#x ticks=%d pstate=%#x irq=%d cntv=%#x cval=%d\n", i, m.CPU.State[aarch64.PC], m.Ticks, m.Pstate, m.pendingIRQ(), m.Sys[0xdf19], m.Sys[0xdf1a])
			m.printJITStats()
		}
		if *traceAfter != 0 && i < *traceAfter {
			saved := m.Trace
			m.Trace = nil
			e = m.Step()
			m.Trace = saved
			if e != nil {
				return e
			}
			i++
			continue
		}
		if i&1023 == 0 && input != nil {
			select {
			case data, ok := <-input:
				if !ok {
					input = nil
				} else {
					m.Input = append(m.Input, data...)
				}
			default:
			}
		}

		budget := uint64(65536)
		if input != nil {
			budget = uint64(1024) - (i & 1023)
		}
		if *steps-i < budget {
			budget = *steps - i
		}
		consumed, err := m.RunQuantum(budget)
		if err != nil {
			return fmt.Errorf("instruction %d ticks=%d PC=%#x: %w", i, m.Ticks, m.CPU.State[aarch64.PC], err)
		}
		i += consumed
	}
	if *stats {
		fmt.Fprintf(os.Stderr, "instructions=%d ticks=%d pc=%#x done=%t\n", m.Instructions, m.Ticks, m.CPU.State[aarch64.PC], m.Done)
	}
	if !m.Done {
		return fmt.Errorf("instruction budget exhausted at %#x", m.CPU.State[aarch64.PC])
	}
	return nil
}

-- clock.go --
package arm64machine

import (
	"renvo.dev/internal/rfe/engine"
	"renvo.dev/internal/rfe/systemclock"
)

// Select the clock before JIT creation so counter reads are not compiled as
// instruction prefixes. Device and architectural timer frequencies stay fixed.
func (m *Machine) UseRealtimeClock() { m.Clock = systemclock.New(timerFreq) }
func (m *Machine) syncClock() {
	if m.Clock != nil {
		m.Ticks = m.Clock.Read()
	}
}

func (c *nativeCPU) PauseTranslationClock() {
	if c.m.Clock != nil {
		c.m.Clock.Pause()
	}
}
func (c *nativeCPU) ResumeTranslationClock() {
	if c.m.Clock != nil {
		c.m.Clock.Resume()
	}
}

var _ engine.TranslationClock = (*nativeCPU)(nil)

-- clock_test.go --
package arm64machine

import (
	"encoding/binary"
	"renvo.dev/emulators/aarch64"
	"renvo.dev/internal/rfe/systemclock"
	"testing"
	"time"
)

func TestRealtimeClockFrozenNativeRetirementAndCounterReads(t *testing.T) {
	for _, mode := range []string{"interpreter", "ir", "native"} {
		m := jitMachine(t, mode)
		m.JIT.Close()
		elapsed := 100 * time.Millisecond
		m.Clock = systemclock.WithSource(timerFreq, func() time.Duration { return elapsed }, func(time.Duration) { t.Fatal("busy CPU waited") })
		m.Sys[0xc708] = 3
		// MRS CNTVCT_EL0,x2; ADD x3,x3,#1; B back.
		for i, op := range []uint32{0xd53be042, 0x91000463, 0x17fffffe} {
			binary.LittleEndian.PutUint32(m.RAM[0x8000+4*i:], op)
		}
		if err := m.EnableJIT(mode); err != nil {
			t.Fatal(err)
		}
		m.syncClock()
		m.Sys[0xdf19], m.Sys[0xdf1a] = 1, m.Ticks+timerFreq/1000
		jitRun(t, m, 8192)
		if m.Ticks != 10000000 || m.CPU.State[2] != m.Ticks || m.CPU.Retired != 8192 || m.Instructions != 8192 || m.timerPending(0xdf19, 0xdf1a) {
			t.Fatal(mode, "retirement fabricated clock time", m.Ticks, m.CPU.State, m.CPU.Retired, m.Instructions)
		}
		elapsed += 20 * time.Millisecond
		jitRun(t, m, 12)
		if m.Ticks != 12000000 || m.CPU.State[2] != m.Ticks || !m.timerPending(0xdf19, 0xdf1a) {
			t.Fatal(mode, "host time/counter/deadline diverged", m.Ticks, m.CPU.State)
		}
		if mode == "native" && m.JIT.NativeAvailable() && m.JIT.Stats.Native == 0 {
			t.Fatal("no native execution tested")
		}
	}
}

func TestRealtimeClockWFIWaitsWithoutFabricatingTime(t *testing.T) {
	m := reviewMachine(t)
	elapsed := time.Duration(0)
	waits := 0
	m.Clock = systemclock.WithSource(timerFreq, func() time.Duration { return elapsed }, func(d time.Duration) { elapsed += d; waits++ })
	m.Pstate = 0x3c5
	m.CPU.State[aarch64.PC] = ramBase + 0x8000
	m.Sys[0xdf19], m.Sys[0xdf1a] = 1, timerFreq/1000
	binary.LittleEndian.PutUint32(m.RAM[0x8000:], 0xd503207f)
	if err := m.Step(); err != nil {
		t.Fatal(err)
	}
	if waits != 1 || elapsed != time.Millisecond || m.Ticks != timerFreq/1000 || m.CPU.Retired != 1 || m.Instructions != 1 {
		t.Fatal("idle invented time or retirement", waits, elapsed, m.Ticks, m.CPU.Retired, m.Instructions)
	}
}

-- jit.go --
package arm64machine

import (
	"fmt"
	"os"
	"renvo.dev/emulators/aarch64"
	"renvo.dev/internal/rfe/engine"
	emu "renvo.dev/internal/rfe/runtime"
	"renvo.dev/internal/rfe/systemmemory"
)

// Both EL0 and EL1 use checked native ISA lowering. Privileged instructions,
// device I/O, exclusive sequences and exception delivery retain slow paths.
func (m *Machine) nativeActive() bool { return !m.Exclusive && m.Trace == nil }
func (m *Machine) nativeDomain() int {
	if m.Pstate&0xc == 0 {
		return 0
	}
	if m.Sys[0xc080]&1 == 0 {
		return 2
	}
	return 1
}
func (m *Machine) nativeAddress(a uint64) uint64 {
	if m.nativeDomain() == 1 {
		return a | 0xffff000000000000
	}
	return a
}
func (m *Machine) nativeMapping(a uint64, exec bool) (uint64, bool, error) {
	p, err := m.translate(a, false, exec)
	if err != nil {
		return 0, false, err
	}
	if !m.inRAM(p, 1) {
		return 0, false, fmt.Errorf("native access is not RAM")
	}
	w, writeErr := m.translate(a, true, false)
	return p - ramBase, writeErr == nil && w == p, nil
}
func (m *Machine) EnableJIT(mode string) error {
	m.kernelThreshold = 4096
	config := engine.DefaultEngineConfig()
	config.Mode = mode
	config.EvictCold = true
	config.RecycleNative = true
	config.DiscoveryThreshold = 32
	return m.configureJIT(config)
}
func (m *Machine) configureJIT(config engine.EngineConfig) error {
	e, err := m.newJIT(config)
	if err == nil {
		m.JIT = e
	}
	return err
}
func (m *Machine) newJIT(config engine.EngineConfig) (*engine.Engine, error) {
	arch := aarch64.Architecture()
	arch.StateWords = systemStateWords
	fetch, lower := arch.Fetch, arch.Lower
	arch.Fetch = func(memory engine.Memory, pc uint64) (engine.Instruction, error) {
		ins, err := fetch(memory, pc)
		if m.nativeDomain() != 0 {
			ins.NativeThreshold = m.kernelThreshold
		}
		if nativeSystemBarrier(uint32(ins.Bits)) || nativeOrderedScalar(uint32(ins.Bits)) || nativeSystemRead(uint32(ins.Bits)) || nativeDAIFWrite(uint32(ins.Bits)) {
			ins.InterpretOnly = false
			ins.Memory = nativeOrderedScalar(uint32(ins.Bits)) || nativeSystemRead(uint32(ins.Bits)) || nativeDAIFWrite(uint32(ins.Bits))
		}
		if uint32(ins.Bits)&0x3b200c00 == 0x38000800 {
			ins.InterpretOnly = true
		}
		if m.Clock != nil && (uint32(ins.Bits)&0xffffffe0 == 0xd53be020 || uint32(ins.Bits)&0xffffffe0 == 0xd53be040) {
			ins.ScheduleBoundary = true
		}
		return ins, err
	}
	arch.Lower = func(b *emu.Builder, ins engine.Instruction, completed int) bool {
		b.MemoryAddress = nil
		if m.nativeDomain() == 1 {
			b.MemoryAddress = systemmemory.KernelAddress
		}
		if lowerDAIFWrite(b, ins, completed) || lowerClockedSystemRead(b, ins, completed, m.Clock == nil) || lowerSystemScalar(b, ins, completed) {
			return true
		}
		return lower(b, ins, completed)
	}
	return engine.New(config, arch)
}
func (m *Machine) printJITStats() {
	fmt.Fprintf(os.Stderr, "mapping changes [page-table code-write root-switch invalidation]=%v\n", m.NativeRAM.ProfileMappingCounters())
	if m.Clock != nil {
		fmt.Fprintf(os.Stderr, "clock mode=realtime ticks=%d instructions=%d translation_paused_ns=%d\n", m.Ticks, m.Instructions, m.Clock.PausedDuration())
	}
	m.printKernelJITStats()
	if m.ProfileJIT {
		if m.JIT != nil {
			fmt.Fprintf(os.Stderr, "jit user hot link misses=%+v\n", m.JIT.LinkMissProfile())
			fmt.Fprintf(os.Stderr, "jit user timeline=%s\n", m.JIT.DispatchProfileJSON())
		}
		if m.KernelJIT != nil {
			fmt.Fprintf(os.Stderr, "jit kernel hot link misses=%+v\n", m.KernelJIT.LinkMissProfile())
			fmt.Fprintf(os.Stderr, "jit kernel timeline=%s\n", m.KernelJIT.DispatchProfileJSON())
		}
	}
	if m.JIT != nil {
		s := m.JIT.Stats
		fmt.Fprintf(os.Stderr, "jit available=%t native=%d linked=%d interpreted=%d promotions=%d failures=%d bytes=%d\n", m.JIT.NativeAvailable(), s.Native, s.Linked, s.Interpreted, s.Promotions, s.CompileFailures, s.NativeBytes)
		fmt.Fprintf(os.Stderr, "jit stats=%+v cached=%d\n", s, m.JIT.CachedBlocks())
	}
}

const (
	systemPstate     = aarch64.StateWords
	systemSP0        = systemPstate + 1
	systemIRQRisk    = systemSP0 + 1
	systemTime       = systemIRQRisk + 1
	systemTPIDR      = systemTime + 1
	systemStateWords = systemTPIDR + 1
)

type nativeCPU struct {
	state     [systemStateWords]uint64
	m         *Machine
	accounted uint64
	consumed  uint64
}

func (c *nativeCPU) Registers() []uint64 { return c.state[:] }

// Banked SP and IRQ risk are read-only native inputs. Native Pstate writes
// may change only DAIF masks; every other control bit remains interpreter-owned.
func (c *nativeCPU) importState() {
	copy(c.state[:aarch64.StateWords], c.m.CPU.State[:])
	c.state[systemPstate], c.state[systemSP0], c.state[systemTime] = c.m.Pstate, c.m.SP[0], c.m.Ticks
	c.state[systemTPIDR] = c.m.Sys[0xc684]
	c.state[systemIRQRisk] = 0
	// Conservative risk, not interrupt authority. False positives fall back;
	// timers cap every native slice and devices/input require a host boundary.
	if c.m.timerPending(0xdf11, 0xdf12) || c.m.timerPending(0xdf19, 0xdf1a) || c.m.uartStatus()&c.m.UARTMask != 0 || c.m.SoftwarePending {
		c.state[systemIRQRisk] = 1
	}
}
func (c *nativeCPU) Retirement() *uint64      { return &c.m.CPU.Retired }
func (c *nativeCPU) MemoryBus() engine.Memory { return c.m.NativeRAM }
func (c *nativeCPU) sync() {
	copy(c.m.CPU.State[:], c.state[:aarch64.StateWords])
	c.m.Pstate = c.m.Pstate&^0x3c0 | c.state[systemPstate]&0x3c0
	count := c.m.CPU.Retired - c.accounted
	if c.m.Clock == nil {
		c.m.Ticks += count
	} else {
		c.m.syncClock()
	}
	c.m.Instructions += count
	c.consumed += count
	c.accounted = c.m.CPU.Retired
}
func (c *nativeCPU) Step() error {
	c.sync() // Precise time and progress before any slow memory/trap operation.
	err := c.m.Step()
	c.importState()
	c.accounted = c.m.CPU.Retired // Step already accounted its architectural work.
	c.consumed++                  // Also count fault/interrupt attempts against the fixed limit.
	return err
}
func (c *nativeCPU) ExecuteInstruction(ins engine.Instruction) error {
	// Engine validated the cached opcode's execute permission and code version
	// in this thread. Keep interrupt and architectural execution identical to
	// Step, but do not repeat its MMU fetch and decoder work.
	c.sync()
	var err error
	pc := c.m.CPU.State[aarch64.PC]
	if c.m.takePendingIRQ(pc) {
		err = nil
	} else {
		err = c.m.executeOpcode(uint32(ins.Bits))
	}
	c.importState()
	c.accounted = c.m.CPU.Retired
	c.consumed++
	return err
}
func (m *Machine) RunQuantum(remaining uint64) (uint64, error) {
	m.syncClock()
	if remaining == 0 {
		return 0, fmt.Errorf("instruction budget exhausted")
	}
	pending := m.Pstate&0x80 == 0 && (m.timerPending(0xdf11, 0xdf12) || m.timerPending(0xdf19, 0xdf1a) || m.uartStatus()&m.UARTMask != 0 || m.SoftwarePending) && m.pendingIRQ() != 1023
	if m.JIT == nil || !m.nativeActive() || pending {
		return 1, m.Step()
	}
	// The caller caps live console polling at its original 1024-instruction
	// boundary. Without live input, use the existing native session ceiling.
	// Architectural timers always cap the slice independently.
	budget := uint64(emu.NativeSessionLimit)
	if budget > remaining {
		budget = remaining
	}
	for _, timer := range [][2]uint32{{0xdf11, 0xdf12}, {0xdf19, 0xdf1a}} {
		if m.Clock == nil && m.Sys[timer[0]]&3 == 1 && m.Sys[timer[1]] > m.Ticks && m.Sys[timer[1]]-m.Ticks < budget {
			budget = m.Sys[timer[1]] - m.Ticks
		}
	}
	cpu := &m.adapter
	cpu.m, cpu.accounted, cpu.consumed = m, m.CPU.Retired, 0
	cpu.importState()
	err := m.activeJIT().RunQuanta(cpu, budget)
	cpu.sync()
	return cpu.consumed, err
}

-- jit_btf_repro_test.go --
package arm64machine

import (
	"encoding/binary"
	"renvo.dev/emulators/aarch64"
	"renvo.dev/internal/rfe/engine"
	"testing"
)

func mapKernelPage(t *testing.T, m *Machine, va, physical uint64, next *uint64) {
	t.Helper()
	table := uint64(0x1000)
	for level := 0; level < 4; level++ {
		at := table + ((va>>uint(12+9*(3-level)))&511)*8
		if level == 3 {
			reviewWord(m, at, ramBase+physical|3|1<<10)
			break
		}
		entry := binary.LittleEndian.Uint64(m.RAM[at:])
		if entry&3 == 0 {
			entry = ramBase + *next | 3
			reviewWord(m, at, entry)
			*next += 4096
		}
		table = (entry & 0x0000fffffffff000) - ramBase
	}
}
func btfReproMachine(t *testing.T, mode string) *Machine {
	m := reviewMachine(t)
	m.Sys[0xc080] = 1
	m.Sys[0xc101] = ramBase + 0x1000
	m.Sys[0xc102] = 16 | 16<<16 | 2<<30
	m.setPstate(5)
	next := uint64(0x20000)
	for _, p := range [][2]uint64{{0xffff8000802f6000, 0x8000}, {0xffff0000030cd000, 0x9000}, {0xffff8000822bb000, 0xa000}, {0xffff800081136000, 0xc000}} {
		mapKernelPage(t, m, p[0], p[1], &next)
	}
	for i := uint64(0); i < 8; i++ {
		mapKernelPage(t, m, 0xffff000003300000+i*4096, 0x10000+i*4096, &next)
	}
	opcodes := map[uint64]uint32{
		0xffff8000802f64c0: 0xb9409ae3,
		0xffff8000802f64c4: 0x2a1303f4,
		0xffff8000802f64c8: 0xaa1703e0,
		0xffff8000802f64cc: 0x6b13007f,
		0xffff8000802f64d0: 0x54000109,
		0xffff8000802f64f0: 0xb9404801,
		0xffff8000802f64f4: 0x4b030263,
		0xffff8000802f64f8: 0x6b01007f,
		0xffff8000802f64fc: 0x540009a2,
		0xffff8000802f6500: 0xf9400400,
		0xffff8000802f6504: 0xf8635816,
		0xffff8000802f6508: 0xb4000956,
		0xffff8000802f650c: 0xb94006c1,
		0xffff8000802f6510: 0xd3587020,
		0xffff8000802f6514: 0x71002c1f,
		0xffff8000802f6518: 0x540007c8,
		0xffff8000802f651c: 0x7205043f,
		0xffff8000802f6520: 0x54000560,
		0xffff8000802f65cc: 0x11000673,
		0xffff8000802f65d0: 0x6b13031f,
		0xffff8000802f65d4: 0x54fff761,
		0xffff8000802f6524: 0x1400002a, // other tags rejoin the independent loop
		0xffff8000802f6610: 0x17ffffef, // tags >11 rejoin increment at 65cc
	}
	for va, op := range opcodes {
		binary.LittleEndian.PutUint32(m.RAM[0x8000+(va&4095):], op)
	}
	binary.LittleEndian.PutUint64(m.RAM[0x9a08:], 0xffff000003300000)
	binary.LittleEndian.PutUint32(m.RAM[0x9a48:], 0x183ed)
	binary.LittleEndian.PutUint32(m.RAM[0xcbb4:], 0x02000000)
	binary.LittleEndian.PutUint32(m.RAM[0xcbc4:], 0x17000000)
	for i := 0; i < 4096; i++ {
		pointer := uint64(0xffff800081136bb0)
		if i%64 == 40 {
			pointer = 0xffff800081136bc0
		}
		binary.LittleEndian.PutUint64(m.RAM[0x10000+i*8:], pointer)
	}
	m.CPU.State = [aarch64.StateWords]uint64{0xffff0000030cda00, 0x183ed, 0x99, 0xa7, 0x0, 0x0, 0x0, 0x0, 0xffff0000029524a0, 0xffff8000822bb9a0, 0xec0, 0xc0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0x0, 0xa7, 0xa7, 0x9a, 0xffff800081136ba4, 0xffff0000030cda00, 0x183ed, 0x12000000, 0xffff00000319f800, 0x6484a38131c9ecd4, 0xa61eae039e2fee55, 0xffff8000822bbaf0, 0xffff8000802f6528, 0xffff8000822bbaf0, 0xffff8000802f6500, 0x80000000}
	m.CPU.State[0] = m.CPU.State[23]
	m.flush()
	config := engine.DefaultEngineConfig()
	config.Mode = mode
	config.EvictCold, config.RecycleNative = true, true
	if mode == "native-leaves" {
		config.Mode = "native"
		config.MaxRegionInstructions = 1
	}
	if err := m.configureJIT(config); err != nil {
		t.Fatal(err)
	}
	t.Cleanup(func() { m.JIT.Close() })
	if config.Mode == "native" && !m.JIT.NativeAvailable() {
		t.Skip("native host unavailable")
	}
	return m
}
func TestKernelJITPointerReloadAcrossTypeBranch(t *testing.T) {
	for _, mode := range []string{"ir", "native-leaves", "native"} {
		t.Run(mode, func(t *testing.T) {
			native, interpreted := btfReproMachine(t, mode), btfReproMachine(t, "interpreter")
			for i := 0; i < 4096; i++ {
				count := uint64(1 + i%256)
				if native.CPU.State[19] > 2000 {
					break
				}
				jitRun(t, native, count)
				jitRun(t, interpreted, count)
				if native.CPU.State != interpreted.CPU.State || native.Pstate != interpreted.Pstate || native.Ticks != interpreted.Ticks {
					t.Fatalf("slice %d count=%d native=%#x interpreted=%#x stats=%+v", i, count, native.CPU.State, interpreted.CPU.State, native.JIT.Stats)
				}
			}
			if mode != "ir" && native.JIT.Stats.Native == 0 {
				t.Fatalf("reproducer never reached native tier: %+v pc=%#x state=%#x", native.JIT.Stats, native.CPU.State[aarch64.PC], native.CPU.State)
			}
		})
	}
}

-- jit_daif_write.go --
package arm64machine

import (
	"renvo.dev/emulators/aarch64"
	"renvo.dev/internal/rfe/engine"
	emu "renvo.dev/internal/rfe/runtime"
)

func nativeDAIFWrite(op uint32) bool {
	return op&0xffffffe0 == 0xd51b4220 || op&0xfffff0df == 0xd50340df
}

func lowerDAIFWrite(b *emu.Builder, ins engine.Instruction, completed int) bool {
	op := uint32(ins.Bits)
	if !nativeDAIFWrite(op) {
		return false
	}
	b.Store(aarch64.PC, b.Constant(ins.PC))
	b.Checkpoint(systemStateWords, completed)
	pstate := b.Load(systemPstate)
	b.Guard(b.Binary(emu.Less, b.Constant(0), b.Binary(emu.And, pstate, b.Constant(0xc))))
	masks := b.Binary(emu.And, pstate, b.Constant(0x3c0))
	if op&0xffffffe0 == 0xd51b4220 {
		value := b.Constant(0)
		if rt := int(op & 31); rt != 31 {
			value = b.Load(rt)
		}
		masks = b.Binary(emu.And, value, b.Constant(0x3c0))
	} else {
		immediate := uint64(op>>8&15) << 6
		if op&0x20 == 0 {
			masks = b.Binary(emu.Or, masks, b.Constant(immediate))
		} else {
			masks = b.Binary(emu.And, masks, b.Constant(^immediate))
		}
	}
	// Native execution cannot introduce an IRQ: timers cap the slice, device
	// writes exit, and input is polled only at the existing host boundary. If an
	// IRQ could already be pending, unmasking must replay exactly this operation
	// through Step and then return to the scheduler before another instruction.
	masked := b.Binary(emu.Less, b.Constant(0), b.Binary(emu.And, masks, b.Constant(0x80)))
	quiet := b.Binary(emu.Equal, b.Load(systemIRQRisk), b.Constant(0))
	b.Guard(b.Binary(emu.Or, masked, quiet))
	b.Store(systemPstate, b.Binary(emu.Or, b.Binary(emu.And, pstate, b.Constant(^uint64(0x3c0))), masks))
	b.Store(aarch64.PC, b.Constant(ins.PC+4))
	// Commit DAIF now, so ordinary scalar/pair checkpoints that export 34 words
	// cannot lose a preceding mask update at a later precise memory fault.
	b.Checkpoint(systemStateWords, completed+1)
	return true
}

-- jit_daif_write_test.go --
package arm64machine

import (
	"encoding/binary"
	"renvo.dev/emulators/aarch64"
	"testing"
)

func daifMachines(t *testing.T, ops []uint32) []*Machine {
	t.Helper()
	machines := []*Machine{reviewMachine(t), reviewMachine(t)}
	for index, m := range machines {
		m.setPstate(0x3c5)
		m.CPU.State[aarch64.PC] = ramBase + 0x8000
		m.CPU.State[1] = ramBase + 0x9000
		for i, op := range ops {
			binary.LittleEndian.PutUint32(m.RAM[0x8000+4*i:], op)
		}
		mode := "interpreter"
		if index == 0 {
			mode = "native"
		}
		if err := m.EnableJIT(mode); err != nil {
			t.Fatal(err)
		}
		m.kernelThreshold = 64
		t.Cleanup(m.CloseJIT)
	}
	return machines
}

func TestNativeDAIFMasksAndReadForwardingAllImmediates(t *testing.T) {
	for mask := uint32(0); mask < 16; mask++ {
		ops := []uint32{0xd51b4220, 0xd53b4222, 0xd50340df | mask<<8, 0xd53b4223, 0xd50340ff | mask<<8, 0xd53b4224, 0x17fffffa}
		machines := daifMachines(t, ops)
		for _, m := range machines {
			m.CPU.State[0] = 0xaaaaaaaaaaaaaaaa
		}
		for _, budget := range []uint64{8192, 1, 2, 3, 4, 63, 65} {
			for _, m := range machines {
				runSystemReadBudget(t, m, budget)
			}
			compareSystemReadMachines(t, machines[0], machines[1])
		}
		if machines[0].JIT.Stats.Native <= machines[0].CPU.Retired*3/4 {
			t.Fatal("DAIF writes stayed interpreted", mask, machines[0].JIT.Stats)
		}
	}
}

func TestNativeDAIFUnmaskPendingIRQReturnsBeforeNextInstruction(t *testing.T) {
	for _, op := range []uint32{0xd50342ff, 0xd51b4220} {
		machines := daifMachines(t, []uint32{op, 0x91000421, 0x17fffffe})
		for _, m := range machines {
			runSystemReadBudget(t, m, 8192)
		}
		for _, m := range machines {
			m.setPstate(0x3c5)
			m.CPU.State[aarch64.PC] = ramBase + 0x8000
			m.CPU.State[0] = 0
			m.DistControl, m.CPUControl = 1, 1
			m.IRQEnabled[27] = true
			m.Sys[0xdf19], m.Sys[0xdf1a] = 1, 0
			m.Sys[0xc600] = ramBase + 0x10000
			retired, register := m.CPU.Retired, m.CPU.State[1]
			used, err := m.RunQuantum(64)
			if err != nil || used != 1 || m.CPU.Retired != retired+1 || m.CPU.State[aarch64.PC] != ramBase+0x8004 || m.CPU.State[1] != register || m.Pstate&0x80 != 0 {
				t.Fatal("unmask did not return before next instruction", used, err)
			}
			retired = m.CPU.Retired
			used, err = m.RunQuantum(64)
			if err != nil || used != 1 || m.CPU.Retired != retired || m.Sys[0xc201] != ramBase+0x8004 || m.CPU.State[1] != register {
				t.Fatal("pending IRQ delayed", used, err)
			}
		}
		compareSystemReadMachines(t, machines[0], machines[1])
	}
}

func TestNativeDAIFMaskSurvivesFollowingMemoryFault(t *testing.T) {
	machines := []*Machine{jitKernelMachine(t, "native"), jitKernelMachine(t, "interpreter")}
	for _, m := range machines {
		ops := []uint32{0xd5034fdf, 0xf9000020, 0x17fffffe}
		for i, op := range ops {
			binary.LittleEndian.PutUint32(m.RAM[reviewData+uint64(4*i):], op)
		}
		runSystemReadBudget(t, m, 8192)
	}
	nativeBefore := machines[0].JIT.Stats.Native
	for _, m := range machines {
		m.Pstate = 5
		m.CPU.State[aarch64.PC] = jitKernelVA
		m.CPU.State[1] = jitKernelVA + 8192 // architecturally unmapped, not a host fixture error
		m.Sys[0xc600] = jitKernelVA + 0x10000
		// Data aborts consume an attempt, not a retired instruction. Do not
		// continue at the exception vector trying to retire the fault itself.
		attempted := uint64(0)
		for attempted < 2 {
			used, err := m.RunQuantum(64)
			if err != nil || used == 0 || used > 2-attempted {
				t.Fatal("imprecise fault attempt", used, err)
			}
			attempted += used
		}
	}
	compareSystemReadMachines(t, machines[0], machines[1])
	if machines[0].JIT.Stats.Native != nativeBefore+1 {
		t.Fatal("fault test did not execute mask update natively")
	}
	if machines[0].Sys[0xc201] != jitKernelVA+4 || machines[0].Sys[0xc200]&0x3c0 != 0x3c0 {
		t.Fatal("fault lost preceding native DAIF mask", machines[0].Sys)
	}
}

func TestNativeDAIFWarmPrivilegeTrapAndLiveTimerBudget(t *testing.T) {
	machines := daifMachines(t, []uint32{0xd5034fdf, 0xd5034fff, 0x91000421, 0x17fffffd})
	for _, m := range machines {
		runSystemReadBudget(t, m, 8192)
	}
	for _, m := range machines {
		m.setPstate(0)
		m.CPU.State[aarch64.PC] = ramBase + 0x8000
		m.Sys[0xc600] = ramBase + 0x10000
		if _, err := m.RunQuantum(1); err != nil {
			t.Fatal(err)
		}
	}
	compareSystemReadMachines(t, machines[0], machines[1])
	if machines[0].Sys[0xc290]>>26 != 0 {
		t.Fatal("wrong immediate DAIF privilege syndrome")
	}
	machines = daifMachines(t, []uint32{0xd5034fdf, 0xd5034fff, 0x91000421, 0x17fffffd})
	for _, m := range machines {
		runSystemReadBudget(t, m, 8192)
	}
	for _, m := range machines {
		m.Pstate = 5
		m.CPU.State[aarch64.PC] = ramBase + 0x8000
		m.DistControl, m.CPUControl = 1, 1
		m.IRQEnabled[27] = true
		m.Sys[0xdf19] = 1
		m.Sys[0xdf1a] = m.Ticks + 2
		m.Sys[0xc600] = ramBase + 0x10000
		deadline := m.Ticks + 2
		for m.Ticks < deadline {
			used, err := m.RunQuantum(64)
			if err != nil || used == 0 || m.Ticks > deadline {
				t.Fatal("native DAIF crossed timer deadline", used, err, m.Ticks, deadline)
			}
		}
		retired, register := m.CPU.Retired, m.CPU.State[1]
		if used, err := m.RunQuantum(64); err != nil || used != 1 || m.CPU.Retired != retired || m.CPU.State[1] != register || m.Sys[0xc201] != ramBase+0x8008 {
			t.Fatal("timer IRQ delayed after native unmask", used, err)
		}
	}
	compareSystemReadMachines(t, machines[0], machines[1])
}

-- jit_domains.go --
package arm64machine

import (
	"fmt"
	"os"
	"renvo.dev/internal/rfe/engine"
)

func (m *Machine) activeJIT() *engine.Engine {
	if m.nativeDomain() != 0 && m.KernelJIT != nil {
		return m.KernelJIT
	}
	return m.JIT
}
func (m *Machine) EnableSystemJIT(mode string) error {
	cache, err := engine.SystemCachePreset(m.JITCache)
	if err != nil {
		return err
	}
	m.kernelThreshold = 256
	m.NativeRAM.Profile = m.ProfileJIT
	user := engine.DefaultEngineConfig()
	user.Mode = mode
	user.ProfileNative = m.ProfileJIT
	user.ProfileNativeMonotonic = m.ProfileJIT
	user.EvictCold, user.RecycleNative = true, true
	user.DiscoveryThreshold = 8
	user.MaxBlocks, user.NativeBytes = cache.UserBlocks, cache.UserBytes
	kernel := user
	kernel.DiscoveryThreshold = 64
	kernel.MaxBlocks, kernel.NativeBytes = cache.KernelBlocks, cache.KernelBytes
	kernel.MaxRegionInstructions = 64
	first, err := m.newJIT(user)
	if err != nil {
		return err
	}
	second, err := m.newJIT(kernel)
	if err != nil {
		first.Close()
		return err
	}
	m.JIT, m.KernelJIT = first, second
	m.NativeRAM.MultipleArenas = true
	return nil
}

// Close ends the machine/RAM lifetime; CloseJIT alone still permits interpreting.
func (m *Machine) Close() error {
	m.CloseJIT()
	err := m.NativeRAM.Close()
	m.RAM = nil
	return err
}

func (m *Machine) CloseJIT() {
	if m.JIT != nil {
		m.JIT.Close()
	}
	if m.KernelJIT != nil {
		m.KernelJIT.Close()
	}
}
func (m *Machine) printKernelJITStats() {
	if m.KernelJIT != nil {
		fmt.Fprintf(os.Stderr, "jit kernel stats=%+v cached=%d\n", m.KernelJIT.Stats, m.KernelJIT.CachedBlocks())
	}
}

-- jit_domains_test.go --
package arm64machine

import (
	"renvo.dev/emulators/aarch64"
	"testing"
)

func TestSystemJITSeparateDomainsDifferential(t *testing.T) {
	native, interpreted := jitKernelMachine(t, "native"), jitKernelMachine(t, "interpreter")
	for _, item := range []struct {
		m    *Machine
		mode string
	}{{native, "native"}, {interpreted, "interpreter"}} {
		item.m.CloseJIT()
		if err := item.m.EnableSystemJIT(item.mode); err != nil {
			t.Fatal(err)
		}
		t.Cleanup(item.m.CloseJIT)
	}
	for cycle := 0; cycle < 3; cycle++ {
		for _, m := range []*Machine{native, interpreted} {
			m.setPstate(5)
			m.CPU.State[aarch64.PC] = jitKernelVA
			m.CPU.State[1] = jitKernelVA + 4096
			jitRun(t, m, 16384)
			m.setPstate(0)
			m.CPU.State[aarch64.PC] = reviewVA
			m.CPU.State[1] = 0x5000
			jitRun(t, m, 16384)
		}
		if native.CPU.State != interpreted.CPU.State || native.CPU.Retired != interpreted.CPU.Retired || native.Ticks != interpreted.Ticks {
			t.Fatal("domain switch differs from interpreter")
		}
	}
	if native.JIT.Stats.NativeMemory == 0 || native.KernelJIT.Stats.NativeMemory == 0 {
		t.Fatal("both domain arenas must execute actual native RAM operations")
	}
	if native.JIT.CachedBlocks()+native.KernelJIT.CachedBlocks() > 4096 || native.JIT.Stats.NativeBytes > 6<<20 || native.KernelJIT.Stats.NativeBytes > 2<<20 {
		t.Fatal("system JIT expanded aggregate resource limits")
	}
}

-- jit_kernel_test.go --
package arm64machine

import (
	"encoding/binary"
	"renvo.dev/emulators/aarch64"
	"testing"
)

const jitKernelVA = uint64(0xffff800000004000)

func jitKernelMachine(t *testing.T, mode string) *Machine {
	m := jitMachine(t, mode)
	m.kernelThreshold = 64
	reviewWord(m, 0x1000+256*8, ramBase+0x2000|3)
	m.Sys[0xc101] = ramBase + 0x1000
	m.setPstate(5)
	m.flush()
	m.CPU.State[aarch64.PC] = jitKernelVA
	m.CPU.State[1] = jitKernelVA + 4096
	return m
}
func TestKernelJITHighVirtualRAMAndLowBankSlowPath(t *testing.T) {
	native, interpreted := jitKernelMachine(t, "native"), jitKernelMachine(t, "interpreter")
	jitRun(t, native, 4096)
	jitRun(t, interpreted, 4096)
	if native.JIT.Stats.NativeMemory == 0 || native.CPU.State != interpreted.CPU.State || native.Ticks != interpreted.Ticks || binary.LittleEndian.Uint64(native.RAM[0x9000:]) != 1024 {
		t.Fatal("high kernel JIT is not equivalent to interpreter")
	}
	if native.CPU.State[1] != jitKernelVA+4096 || native.CPU.State[aarch64.PC] != jitKernelVA {
		t.Fatal("native address key leaked into architectural registers")
	}
	// Kernel accesses to low user addresses must use their ORIGINAL address,
	// not silently gain access to the high bank's cached RAM descriptor.
	native.CPU.State[1] = 0x5000
	x := native.CPU.State[0]
	jitRun(t, native, 4)
	if native.CPU.State[0] != x+1 || native.CPU.State[2] != x+1 || native.CPU.State[1] != 0x5000 {
		t.Fatal("kernel low-bank access was redirected")
	}
	native.CPU.State[1] = jitKernelVA + 4096 + 4092
	x = native.CPU.State[0]
	jitRun(t, native, 2)
	if native.CPU.State[0] != x+1 || native.Sys[0xc201] != jitKernelVA+4 || native.Sys[0xc300] != jitKernelVA+8192 {
		t.Fatal("high kernel fault lost original VA or precise PC")
	}
}

-- jit_native_clock_test.go --
package arm64machine

import (
	"encoding/binary"
	"renvo.dev/emulators/aarch64"
	"testing"
)

func TestNativeCounterReadsExactPrefixesWrapAndPrivilege(t *testing.T) {
	machines := daifMachines(t, []uint32{0xd53be040, 0xd53be022, 0x91000484, 0xd53be05f, 0x17fffffc})
	for _, m := range machines {
		m.Ticks = ^uint64(0) - 200
	}
	for _, budget := range []uint64{8192, 1, 2, 3, 65, 1024} {
		for _, m := range machines {
			runSystemReadBudget(t, m, budget)
		}
		compareSystemReadMachines(t, machines[0], machines[1])
	}
	if machines[0].JIT.Stats.Native <= machines[0].CPU.Retired*3/4 {
		t.Fatal("counter reads stayed interpreted")
	}
	for _, m := range machines {
		m.Ticks += 5000
		m.CPU.State[aarch64.PC] = ramBase + 0x8000
		runSystemReadBudget(t, m, 64)
	}
	compareSystemReadMachines(t, machines[0], machines[1])
	// The conservative native EL guard must preserve both an allowed EL0 read
	// and an actual forbidden read's architectural syndrome at warmed code.
	for _, allow := range []uint64{2, 0} {
		for _, m := range machines {
			m.setPstate(0x3c0)
			m.Sys[0xc708] = allow
			m.Sys[0xc600] = ramBase + 0x10000
			m.CPU.State[aarch64.PC] = ramBase + 0x8000
			if _, err := m.RunQuantum(1); err != nil {
				t.Fatal(err)
			}
		}
		compareSystemReadMachines(t, machines[0], machines[1])
		if allow == 0 && machines[0].Sys[0xc290]>>26 != 0x18 {
			t.Fatal("forbidden EL0 clock read did not trap")
		}
	}
	// A following memory abort cannot replay a previously read timestamp.
	machines = []*Machine{jitKernelMachine(t, "native"), jitKernelMachine(t, "interpreter")}
	for _, m := range machines {
		for i, op := range []uint32{0xd53be040, 0xf9000020, 0x17fffffe} {
			binary.LittleEndian.PutUint32(m.RAM[reviewData+uint64(4*i):], op)
		}
		runSystemReadBudget(t, m, 8192)
		m.CPU.State[aarch64.PC] = jitKernelVA
		m.CPU.State[1] = jitKernelVA + 8192
		m.Sys[0xc600] = jitKernelVA + 0x10000
		attempted := uint64(0)
		for attempted < 2 {
			used, err := m.RunQuantum(64)
			if err != nil || used == 0 || used > 2-attempted {
				t.Fatal("counter fault progress", used, err)
			}
			attempted += used
		}
	}
	compareSystemReadMachines(t, machines[0], machines[1])
	if machines[0].Sys[0xc201] != jitKernelVA+4 {
		t.Fatal("clock read replayed before fault")
	}
}

