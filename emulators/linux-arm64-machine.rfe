package arm64machine

import (
	"renvo.dev/emulators/aarch64"
	"testing"
)

func TestNativeTPIDREL1RefreshWritesDiscardAndPrivilege(t *testing.T) {
	machines := daifMachines(t, []uint32{0xd538d082, 0xd518d081, 0xd538d083, 0xd538d09f, 0x17fffffc})
	for _, m := range machines {
		m.Sys[0xc684] = 0x8877665544332211
		m.CPU.State[1] = 0x123456789abcdef0
	}
	for _, budget := range []uint64{8192, 1, 2, 3, 4, 65} {
		for _, m := range machines {
			runSystemReadBudget(t, m, budget)
		}
		compareSystemReadMachines(t, machines[0], machines[1])
	}
	if machines[0].JIT.Stats.Native <= machines[0].CPU.Retired/2 {
		t.Fatal("thread-pointer reads stayed interpreted")
	}
	for _, m := range machines {
		m.Sys[0xc684] = 0x5a5a5a5a5a5a5a5a
		m.CPU.State[aarch64.PC] = ramBase + 0x8000
		runSystemReadBudget(t, m, 1)
	}
	compareSystemReadMachines(t, machines[0], machines[1])
	if machines[0].CPU.State[2] != 0x5a5a5a5a5a5a5a5a {
		t.Fatalf("native TPIDR read cached value: x2=%x sys=%x pc=%x pstate=%x", machines[0].CPU.State[2], machines[0].Sys[0xc684], machines[0].CPU.State[aarch64.PC], machines[0].Pstate)
	}
	for _, offset := range []uint64{0, 12} {
		for _, m := range machines {
			m.setPstate(0x3c0)
			m.Sys[0xc600] = ramBase + 0x10000
			m.CPU.State[aarch64.PC] = ramBase + 0x8000 + offset
			if _, err := m.RunQuantum(1); err != nil {
				t.Fatal(err)
			}
		}
		compareSystemReadMachines(t, machines[0], machines[1])
		if machines[0].Sys[0xc290]>>26 != 0x18 {
			t.Fatal("TPIDR EL0/XZR privilege check missing")
		}
	}
}

-- jit_ordered.go --
package arm64machine

import (
	"renvo.dev/emulators/aarch64"
	"renvo.dev/internal/rfe/engine"
	emu "renvo.dev/internal/rfe/runtime"
)

// The single-CPU architectural interpreter serializes all RAM operations and
// models these barriers as no-ops. Device accesses and page-table/code stores
// still exit before the architectural slow path; exclusives are NOT admitted.
func nativeSystemBarrier(op uint32) bool {
	v := op & 0xfffff0ff
	return v == 0xd503309f || v == 0xd50330bf || v == 0xd50330df || nativePrefetch(op)
}

// Like the single-CPU interpreter, prefetch hints do not perform a guest data
// access, change registers, or raise data aborts for the hinted address.
func nativePrefetch(op uint32) bool {
	return op&0x3f000000 == 0x18000000 && op>>30 == 3 ||
		(op&0x3b000000 == 0x39000000 || op&0x3b000000 == 0x38000000) && op>>22&3 == 2 && op>>30 == 3
}
func nativeOrderedScalar(op uint32) bool {
	return op&0x3fbffc00 == 0x089ffc00 // STLR/LDAR; no pairs or exclusive status
}
func lowerSystemScalar(b *emu.Builder, ins engine.Instruction, completed int) bool {
	op := uint32(ins.Bits)
	if nativeSystemBarrier(op) {
		b.Store(aarch64.PC, b.Constant(ins.PC+4))
		return true
	}
	if !nativeOrderedScalar(op) {
		return false
	}
	n := 1 << (op >> 30)
	rn, rt := int(op>>5&31), int(op&31)
	b.Store(aarch64.PC, b.Constant(ins.PC))
	b.Checkpoint(aarch64.StateWords, completed)
	address := b.Load(rn) // register 31 is SP only for the address
	b.Guard(b.Binary(emu.Equal, b.Binary(emu.And, address, b.Constant(uint64(n-1))), b.Constant(0)))
	if op>>22&1 != 0 {
		v := b.MemoryLoad(address, int(n))
		if rt != 31 {
			b.Store(rt, v)
		}
	} else {
		v := b.Constant(0)
		if rt != 31 {
			v = b.Load(rt)
		}
		b.MemoryStore(address, v, int(n))
	}
	b.Store(aarch64.PC, b.Constant(ins.PC+4))
	return true
}

-- jit_ordered_test.go --
package arm64machine

import (
	"bytes"
	"encoding/binary"
	"renvo.dev/emulators/aarch64"
	"testing"
)

func TestOrderedNativeScalarBarrierWidthsAndAlignment(t *testing.T) {
	for size := uint32(0); size < 4; size++ {
		for _, zero := range []bool{false, true} {
			var machines [2]*Machine
			for i, mode := range []string{"native", "interpreter"} {
				m := reviewMachine(t)
				machines[i] = m
				m.setPstate(5)
				m.CPU.State[aarch64.PC] = ramBase + 0x8000
				m.CPU.State[1] = ramBase + 0x9000
				m.CPU.State[0] = 0x1122334455667788
				rt := uint32(0)
				if zero {
					rt = 31
				}
				ops := []uint32{size<<30 | 0x089ffc20 | rt, 0xd5033abf, size<<30 | 0x08dffc22, 0x91000400, 0x17fffffc}
				for at, op := range ops {
					binary.LittleEndian.PutUint32(m.RAM[0x8000+4*at:], op)
				}
				if err := m.EnableJIT(mode); err != nil {
					t.Fatal(err)
				}
				m.kernelThreshold = 64
				t.Cleanup(m.CloseJIT)
			}
			for _, budget := range []uint64{4096, 1, 2, 3, 63, 65} {
				for _, m := range machines {
					end := m.CPU.Retired + budget
					for m.CPU.Retired < end {
						if _, err := m.RunQuantum(end - m.CPU.Retired); err != nil {
							t.Fatal(err)
						}
					}
				}
				native, reference := machines[0], machines[1]
				if native.CPU.State != reference.CPU.State || native.CPU.Retired != reference.CPU.Retired || native.Ticks != reference.Ticks ||
					!bytes.Equal(native.RAM[0x9000:0xa000], reference.RAM[0x9000:0xa000]) {
					t.Fatal("ordered/barrier native differs", size, zero, budget)
				}
			}
			if machines[0].JIT.Stats.NativeMemory == 0 {
				t.Fatal("ordered accesses never native")
			}
			if size != 0 {
				for _, m := range machines {
					m.CPU.State[aarch64.PC] = ramBase + 0x8000
					m.CPU.State[1] = ramBase + 0x9001
					m.Sys[0xc600] = ramBase + 0x10000
				}
				before := machines[0].CPU.Retired
				for _, m := range machines {
					if _, err := m.RunQuantum(1); err != nil {
						t.Fatal(err)
					}
				}
				a, b := machines[0], machines[1]
				if a.CPU.State != b.CPU.State || a.CPU.Retired != before || b.CPU.Retired != before || a.Sys[0xc300] != ramBase+0x9001 ||
					a.Sys[0xc290] != b.Sys[0xc290] || !bytes.Equal(a.RAM[0x9000:0xa000], b.RAM[0x9000:0xa000]) {
					t.Fatal("ordered alignment fault changed progress")
				}
			}
		}
	}
}

-- jit_prefetch_cached_test.go --
package arm64machine

import (
	"encoding/binary"
	"renvo.dev/emulators/aarch64"
	"testing"
)

func TestNativePrefetchHintsDoNotAccessUnmappedData(t *testing.T) {
	machines := []*Machine{jitMachine(t, "native"), jitMachine(t, "interpreter")}
	ops := []uint32{0xf9800011, 0xf8a06811, 0xf8800011, 0xd8000011, 0x91000421, 0x17fffffb}
	for _, m := range machines {
		for i, op := range ops {
			binary.LittleEndian.PutUint32(m.RAM[reviewData+uint64(4*i):], op)
		}
		m.CPU.State[0] = ^uint64(0) - 7 // no mapped RAM or device at the hinted address
		m.CPU.State[1] = 0
	}
	for _, budget := range []uint64{8192, 1, 2, 3, 65} {
		for _, m := range machines {
			jitRun(t, m, budget)
		}
		compareSystemReadMachines(t, machines[0], machines[1])
	}
	if machines[0].JIT.Stats.Native <= machines[0].CPU.Retired/2 {
		t.Fatal("prefetch hints stayed interpreted")
	}
	if machines[0].Sys[0xc290] != 0 || machines[0].Sys[0xc300] != 0 {
		t.Fatal("hint raised data abort")
	}
	// Revoking execution is different from the hinted-data address: code still
	// needs execute permission and an exact version even for a semantic no-op.
	for _, m := range machines {
		m.CPU.State[aarch64.PC] = reviewVA
		reviewWord(m, 0x4000+4*8, ramBase+reviewData|3|1<<10|1<<6|1<<54)
		m.flush()
		if _, err := m.RunQuantum(1); err != nil {
			t.Fatal(err)
		}
	}
	compareSystemReadMachines(t, machines[0], machines[1])
	if machines[0].Sys[0xc201] != reviewVA {
		t.Fatal("prefetch bypassed execute revoke")
	}
}

func TestCachedSystemOpcodesKeepTimePrivilegeAndControlState(t *testing.T) {
	machines := []*Machine{reviewMachine(t), reviewMachine(t)}
	for index, m := range machines {
		m.setPstate(0x3c5)
		m.CPU.State[aarch64.PC] = ramBase + 0x8000
		m.Sys[0xc684] = 0x8877665544332211
		ops := []uint32{0xd53be040, 0xd538d082, 0xd5034fdf, 0xd51b4229, 0x17fffffc}
		for i, op := range ops {
			binary.LittleEndian.PutUint32(m.RAM[0x8000+4*i:], op)
		}
		mode := "interpreter"
		if index == 0 {
			mode = "native"
		}
		if err := m.EnableJIT(mode); err != nil {
			t.Fatal(err)
		}
		t.Cleanup(m.CloseJIT)
	}
	for _, budget := range []uint64{8192, 1, 2, 4, 65, 1024} {
		for _, m := range machines {
			runSystemReadBudget(t, m, budget)
		}
		compareSystemReadMachines(t, machines[0], machines[1])
	}
	// Change a live register after warmup. Cached opcodes must not cache values.
	for _, m := range machines {
		m.Sys[0xc684] = 0x123456789abcdef0
		m.Ticks += 5000
		runSystemReadBudget(t, m, 100)
	}
	compareSystemReadMachines(t, machines[0], machines[1])
	if machines[0].CPU.State[2] != 0x123456789abcdef0 || machines[0].JIT.Stats.CodeReads >= machines[0].CPU.Retired/4 {
		t.Fatal("system opcode was not reused through checked cache")
	}
}

-- jit_revalidation_test.go --
package arm64machine

import "testing"

func TestUserJITMappingFlushRetainsUnmodifiedNativeCode(t *testing.T) {
	m := jitMachine(t, "native")
	jitRun(t, m, 4096)
	// Settle legitimate side-entry promotion before checking repeated flushes.
	m.flush()
	jitRun(t, m, 4096)
	bytes, promotions, invalidations := m.JIT.Stats.NativeBytes, m.JIT.Stats.Promotions, m.JIT.Stats.Invalidations
	native := m.JIT.Stats.Native
	for i := 0; i < 128; i++ {
		m.flush()
		jitRun(t, m, 64)
	}
	if m.JIT.Stats.NativeBytes != bytes || m.JIT.Stats.Promotions != promotions || m.JIT.Stats.Invalidations != invalidations || m.JIT.Stats.Native <= native {
		t.Fatalf("mapping flush recompiled unchanged physical text: %+v", m.JIT.Stats)
	}
}

