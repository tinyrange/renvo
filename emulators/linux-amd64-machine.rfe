-- boot_bounds_test.go --
package amd64machine

import (
	"encoding/binary"
	"testing"
)

func TestBootRejectsTruncatedBzImageHeader(t *testing.T) {
	m := &Machine{RAM: make([]byte, 20<<20)}
	kernel := make([]byte, 0x269)
	copy(kernel[0x202:], "HdrS")
	if err := m.Boot(kernel, nil, ""); err == nil {
		t.Fatal("truncated bzImage header accepted")
	}
}

func TestBootRejectsOversizedInitramfsWithoutPlacementUnderflow(t *testing.T) {
	// A valid, minimal ELF reaches placement independently of bzImage parsing.
	kernel := make([]byte, 64)
	copy(kernel, "\x7fELF")
	kernel[4], kernel[5], kernel[6] = 2, 1, 1
	binary.LittleEndian.PutUint16(kernel[16:], 2)
	binary.LittleEndian.PutUint16(kernel[18:], 62)
	binary.LittleEndian.PutUint32(kernel[20:], 1)
	binary.LittleEndian.PutUint64(kernel[24:], 0x100000)
	binary.LittleEndian.PutUint16(kernel[52:], 64)
	m := &Machine{RAM: make([]byte, 20<<20)}
	if err := m.Boot(kernel, make([]byte, 5<<20), ""); err == nil {
		t.Fatal("oversized initramfs accepted")
	}
}

-- clock.go --
package amd64machine

import (
	"renvo.dev/emulators/amd64"
	"renvo.dev/internal/rfe/engine"
	"renvo.dev/internal/rfe/systemclock"
)

// UseRealtimeClock is selected before enabling JIT so native counter reads
// use oscillator snapshots rather than retired-instruction timestamp prefixes.
// Constructors retain deterministic timing for embedding and reproducible tests.
func (m *Machine) UseRealtimeClock() {
	m.Clock = systemclock.New(uint64(m.System.TSCCrystalHz) * pitClocksPerTick)
	m.System.ExternalClock = true
}

func (m *Machine) syncClock() {
	if m.Clock == nil {
		return
	}
	ticks := m.Clock.Read()
	if ticks > m.ticks {
		m.System.TSC += (ticks - m.ticks) * amd64.TSCTicksPerInstruction
		m.ticks = ticks
	}
}

func (c *nativeCPU) PauseTranslationClock() {
	if c.m.Clock != nil {
		c.m.Clock.Pause()
	}
}
func (c *nativeCPU) ResumeTranslationClock() {
	if c.m.Clock != nil {
		c.m.Clock.Resume()
	}
}

var _ engine.TranslationClock = (*nativeCPU)(nil)

-- clock_boundary_test.go --
package amd64machine

import (
	"renvo.dev/emulators/amd64"
	"renvo.dev/internal/rfe/systemclock"
	"testing"
	"time"
)

func TestRealtimeNativeCounterReadEndsSliceBeforeFollowingInstruction(t *testing.T) {
	m := jitMachine(t, "native")
	m.JIT.Close()
	m.Clock = systemclock.WithSource(119318200, func() time.Duration { return 100 * time.Millisecond }, func(time.Duration) { t.Fatal("unexpected wait") })
	m.System.ExternalClock = true
	copy(m.RAM[0x10000:], []byte{0x0f, 0x31, 0x49, 0xff, 0xc1, 0xeb, 0xf9}) // RDTSC; INC R9; JMP back.
	if err := m.EnableJIT("native"); err != nil {
		t.Fatal(err)
	}
	jitRun(t, m, 8192)
	m.CPU.PC, m.CPU.R[9] = 0x8000, 0
	retired, native := m.CPU.Retired, m.JIT.Stats.Native
	if err := m.RunQuantum(65536); err != nil {
		t.Fatal(err)
	}
	if m.CPU.Retired-retired != 1 || m.CPU.PC != 0x8002 || m.CPU.R[9] != 0 || m.CPU.R[amd64.RAX] != 1193182000 {
		t.Fatal("native read held stale clock for whole slice", m.CPU.Retired-retired, m.CPU.PC, m.CPU.R)
	}
	if m.JIT.Stats.Native-native != 1 {
		t.Fatal("counter did not return through native boundary", m.JIT.Stats)
	}
}

-- clock_test.go --
package amd64machine

import (
	"encoding/binary"
	"renvo.dev/emulators/amd64"
	"renvo.dev/internal/rfe/systemclock"
	"testing"
	"time"
)

func TestRealtimeClockFrozenNativeRetirementAndCounterReads(t *testing.T) {
	for _, mode := range []string{"interpreter", "ir", "native"} {
		m := jitMachine(t, mode)
		m.JIT.Close()
		elapsed := 100 * time.Millisecond
		m.Clock = systemclock.WithSource(119318200, func() time.Duration { return elapsed }, func(time.Duration) { t.Fatal("busy CPU waited") })
		m.System.ExternalClock = true
		// RDTSC; MOV RSI,RAX; INC R9; JMP back. Real clock reads must not
		// synthesize an instruction-prefix increment inside native regions.
		copy(m.RAM[0x10000:], []byte{0x0f, 0x31, 0x48, 0x89, 0xc6, 0x49, 0xff, 0xc1, 0xeb, 0xf6})
		if err := m.EnableJIT(mode); err != nil {
			t.Fatal(err)
		}
		m.syncClock()
		start, tsc := m.ticks, m.System.TSC
		pitProgram(m, 0, 2, 1193)
		jitRun(t, m, 8192)
		m.servicePIT()
		if m.ticks != start || m.System.TSC != tsc || m.CPU.R[amd64.RSI] != tsc || m.pitEdges != 0 || m.CPU.Retired != 8192 {
			t.Fatal(mode, "retirement fabricated clock time", m.ticks, m.System.TSC, m.CPU.R, m.pitEdges)
		}
		elapsed += 20 * time.Millisecond
		jitRun(t, m, 16)
		m.servicePIT()
		if m.ticks != 14318184 || m.System.TSC != 1431818400 || m.CPU.R[amd64.RSI] != m.System.TSC || m.pitEdges != 20 || m.pitCoalesced != 19 {
			t.Fatal(mode, "elapsed host time/counter/PIT diverged", m.ticks, m.System.TSC, m.CPU.R, m.pitEdges, m.pitCoalesced)
		}
		if mode == "native" && m.JIT.NativeAvailable() && m.JIT.Stats.Native == 0 {
			t.Fatal("no native execution tested")
		}
	}
}

func TestRealtimeClockIdleWaitKeepsRetirementAndTSCOffset(t *testing.T) {
	m := pitDevice(t)
	elapsed := time.Duration(0)
	waits := 0
	m.Clock = systemclock.WithSource(119318200, func() time.Duration { return elapsed }, func(d time.Duration) { elapsed += d; waits++ })
	m.System.ExternalClock = true
	m.System.TSC = 77 // Architectural offset survives clock synchronization.
	m.CPU.Flags = 2 | amd64.FlagIF
	m.CPU.R[amd64.RSP] = 0x8000
	m.System.EFER = 1 << 10
	m.System.GDTR = amd64.Table{Base: 0x3000, Limit: 31}
	m.System.IDTR = amd64.Table{Base: 0x2000, Limit: 4095}
	m.System.Segments[1] = amd64.Segment{Selector: 8, Limit: 0xffffffff, Flags: 0xaf9a}
	binary.LittleEndian.PutUint64(m.RAM[0x3008:], 0x00af9a000000ffff)
	binary.LittleEndian.PutUint64(m.RAM[0x2000+32*16:], 0x00008e0000084000)
	copy(m.RAM[0x4000:], []byte{0x0f, 0x31, 0x49, 0x89, 0xc0, 0x66, 0xba, 0xf9, 0x0c, 0xb0, 0x06, 0xee})
	m.PIC[0].mask, m.PIC[0].vector = 0, 32
	m.System.Halted = true
	pitProgram(m, 0, 0, 5)
	if err := m.Run(100); err != nil {
		t.Fatal(err)
	}
	if waits != 1 || m.CPU.Retired != 5 || m.ticks != 500 || m.System.TSC != 50077 || m.CPU.R[8] != 50077 {
		t.Fatal("idle fabricated time/retirement or lost TSC offset", waits, m.CPU.Retired, m.ticks, m.System.TSC, m.CPU.R)
	}
}

-- code_epoch.go --
package amd64machine

func (m *Machine) CodeEpoch(address uint64) uint64 {
	if address >= uint64(len(m.RAM)) {
		return 0
	}
	return m.versions[address>>12]
}

-- invlpg_native_test.go --
package amd64machine

import (
	"renvo.dev/emulators/amd64"
	"testing"
)

func TestINVLPGRevokesNativeDescriptorsRefilledBeforeArchitecturalFlush(t *testing.T) {
	m := jitMachine(t, "native")
	jitRun(t, m, 4096)
	m.System.CPL = 0
	m.CPU.R[amd64.RBX] = 0x9000
	m.CPU.PC = 0x8000
	// PTE mutation revokes native grants, but the old architectural TLB may
	// still be used until INVLPG. A refill in this interval must be revoked too.
	if err := m.Write(0x4048, 8, 0x12067|1<<63); err != nil {
		t.Fatal(err)
	}
	if err := m.Write(0x10000, 3, 0x3b010f); err != nil { // INVLPG [RBX]
		t.Fatal(err)
	}
	m.NativeRAM.NativeRefill(0x9000)
	ctx := m.NativeRAM.NativeContext()
	if ctx.Pages[9].Data != (*[4096]byte)(m.RAM[0x11000:0x12000]) {
		t.Fatal("test did not establish a pre-INVLPG descriptor")
	}
	before := m.NativeRAM.CodeContext()
	if err := m.CPU.Step(); err != nil {
		t.Fatal(err)
	}
	if ctx.Pages[9].Data != nil || m.NativeRAM.CodeContext() == before {
		t.Fatal("INVLPG preserved stale native mapping authority")
	}
	m.NativeRAM.NativeRefill(0x9000)
	if ctx.Pages[9].Data != (*[4096]byte)(m.RAM[0x12000:0x13000]) {
		t.Fatal("refill did not use the new PTE")
	}
	// Single-page invalidation does not revoke other architectural TLB entries;
	// therefore it must not retire active page-table watches.
	before = m.NativeRAM.CodeContext()
	if err := m.Write(0x4048, 8, 0x11067|1<<63); err != nil {
		t.Fatal(err)
	}
	if m.NativeRAM.CodeContext() == before {
		t.Fatal("INVLPG incorrectly retired live page-table protection")
	}
}

-- irq_slice_test.go --
package amd64machine

import (
	"renvo.dev/emulators/amd64"
	"testing"
)

func TestBlockedPICPendingDoesNotSingleStepNativeCode(t *testing.T) {
	m := jitMachine(t, "native")
	jitRun(t, m, 8192)
	for _, active := range []byte{0, 1} {
		m.PIC[0].mask, m.PIC[0].irr, m.PIC[0].isr = 0, 1, active
		m.CPU.Flags = 2
		if active != 0 {
			m.CPU.Flags |= amd64.FlagIF
		}
		before := m.CPU.Retired
		if err := m.RunQuantum(64); err != nil {
			t.Fatal(err)
		}
		if used := m.CPU.Retired - before; used <= 1 || used > 64 {
			t.Fatal("undeliverable PIC request single-stepped native code", active, used)
		}
		if m.PIC[0].irr != 1 || m.PIC[0].isr != active {
			t.Fatal("pending IRQ lost or delivered while blocked")
		}
	}
	m.PIC[0].isr = 0
	m.CPU.Flags |= amd64.FlagIF
	before := m.CPU.Retired
	if err := m.RunQuantum(64); err != nil || m.CPU.Retired-before != 1 {
		t.Fatal("deliverable IRQ boundary crossed", err, m.CPU.Retired-before)
	}
}

-- jit.go --
package amd64machine

import (
	"fmt"
	"os"
	"renvo.dev/emulators/amd64"
	"renvo.dev/internal/rfe/engine"
	emu "renvo.dev/internal/rfe/runtime"
	"renvo.dev/internal/rfe/systemmemory"
)

func (m *Machine) nativeActive() bool {
	return (m.System.CPL == 0 || m.System.CPL == 3) && m.System.EFER&(1<<10) != 0 && !m.System.Halted && m.System.IRQShadow == 0
}
func (m *Machine) nativeDomain() int {
	if m.System.CPL == 3 {
		return 0
	}
	return 1
}
func (m *Machine) nativeAddress(a uint64) uint64 {
	if m.nativeDomain() == 0 {
		a = systemmemory.UnfoldPageCacheAddress(a)
	}
	if m.nativeDomain() == 1 && a&(1<<47) != 0 {
		return a | 0xffff000000000000
	}
	return a
}
func (m *Machine) InvalidateMappings() {
	// System.Flush has already revoked the complete architectural TLB.
	// Root-tagged CR3 switches use SwitchAddressSpace instead and keep their
	// table watches until such a full revocation.
	if m.NativeRAM != nil {
		m.NativeRAM.ClearPageTableWatches()
	}
}

// A single-page TLB invalidation keeps other cached translations live. Revoke
// native authority without retiring any of their page-table write barriers.
func (m *Machine) InvalidateNativeMappings() {
	if m.NativeRAM != nil {
		m.NativeRAM.InvalidateMappings()
	}
}
func (m *Machine) SwitchAddressSpace() {
	if m.NativeRAM != nil {
		m.NativeRAM.SwitchAddressSpace()
	}
}
func (m *Machine) MarkPageTable(address uint64) {
	if m.NativeRAM != nil {
		m.NativeRAM.MarkPageTable(address)
	}
}
func (m *Machine) EnableJIT(mode string) error {
	m.kernelThreshold = 4096
	config := engine.DefaultEngineConfig()
	config.Mode = mode
	config.EvictCold = true
	config.RecycleNative = true
	config.DiscoveryThreshold = 32
	e, err := m.newJIT(config)
	if err == nil {
		m.JIT = e
	}
	return err
}
func (m *Machine) newJIT(config engine.EngineConfig) (*engine.Engine, error) {
	arch := amd64.TimedSystemArchitecture()
	if m.Clock != nil {
		arch = amd64.SampledSystemArchitecture()
	}
	lower, fetch := arch.Lower, arch.Fetch
	arch.Fetch = func(memory engine.Memory, pc uint64) (engine.Instruction, error) {
		ins, err := fetch(memory, pc)
		if m.nativeDomain() != 0 {
			ins.NativeThreshold = m.kernelThreshold
		}
		return ins, err
	}
	arch.Lower = func(b *emu.Builder, ins engine.Instruction, completed int) bool {
		b.MemoryAddress = systemmemory.PageCacheAddress
		if m.nativeDomain() == 1 {
			b.MemoryAddress = systemmemory.X86KernelAddress
		}
		return lower(b, ins, completed)
	}
	return engine.New(config, arch)
}
func (m *Machine) printJITStats() {
	fmt.Fprintf(os.Stderr, "page-table hardware metadata updates=%d\n", m.ADUpdates)
	fmt.Fprintf(os.Stderr, "mapping changes [page-table code-write root-switch invalidation]=%v\n", m.NativeRAM.ProfileMappingCounters())
	if m.Clock != nil {
		fmt.Fprintf(os.Stderr, "clock mode=realtime translation_paused_ns=%d\n", m.Clock.PausedDuration())
	}
	fmt.Fprintf(os.Stderr, "clock ticks=%d tsc=%d tsc_offset=%d tsc_writes=%d pit_edges=%d pit_delivered=%d pit_coalesced=%d\n", m.ticks, m.System.TSC, m.System.TSC-m.ticks*amd64.TSCTicksPerInstruction, m.System.TSCWrites, m.pitEdges, m.pitDelivered, m.pitCoalesced)
	m.printKernelJITStats()
	if m.ProfileJIT {
		if m.JIT != nil {
			fmt.Fprintf(os.Stderr, "jit user hot link misses=%+v\n", m.JIT.LinkMissProfile())
			fmt.Fprintf(os.Stderr, "jit user timeline=%s\n", m.JIT.DispatchProfileJSON())
		}
		if m.KernelJIT != nil {
			fmt.Fprintf(os.Stderr, "jit kernel hot link misses=%+v\n", m.KernelJIT.LinkMissProfile())
			fmt.Fprintf(os.Stderr, "jit kernel timeline=%s\n", m.KernelJIT.DispatchProfileJSON())
		}
	}
	if m.JIT != nil {
		s := m.JIT.Stats
		fmt.Fprintf(os.Stderr, "jit available=%t native=%d linked=%d interpreted=%d promotions=%d failures=%d bytes=%d\n", m.JIT.NativeAvailable(), s.Native, s.Linked, s.Interpreted, s.Promotions, s.CompileFailures, s.NativeBytes)
		fmt.Fprintf(os.Stderr, "jit stats=%+v cached=%d\n", s, m.JIT.CachedBlocks())
	}
}

type nativeCPU struct {
	*amd64.SystemAdapter
	m         *Machine
	accounted uint64
}

func (c *nativeCPU) Registers() []uint64      { return c.SystemAdapter.TimedRegisters() }
func (c *nativeCPU) MemoryBus() engine.Memory { return c.m.NativeRAM }
func (c *nativeCPU) sync() {
	count := c.m.CPU.Retired - c.accounted
	if c.m.Clock == nil {
		c.m.ticks += count
		c.m.System.TSC += count * amd64.TSCTicksPerInstruction
	} else {
		c.m.syncClock()
	}
	c.accounted = c.m.CPU.Retired
}
func (c *nativeCPU) Step() error {
	c.Export()
	c.sync()
	err := c.m.CPU.Step()
	if err == nil && c.m.Clock == nil {
		c.m.ticks++
	}
	c.accounted = c.m.CPU.Retired
	c.Import()
	return err
}
func (c *nativeCPU) ExecuteInstruction(ins engine.Instruction) error {
	c.Export()
	c.sync()
	err := c.m.CPU.ExecuteCachedInstruction(ins.Decoded.(amd64.Instruction))
	if err == nil && c.m.Clock == nil {
		c.m.ticks++
	}
	c.accounted = c.m.CPU.Retired
	c.Import()
	return err
}
func (m *Machine) RunQuantum(remaining uint64) error {
	m.syncClock()
	if m.JIT == nil || !m.nativeActive() {
		err := m.CPU.Step()
		if err == nil && m.Clock == nil {
			m.ticks++
		}
		return err
	}
	budget := uint64(emu.NativeSessionLimit)
	// A live console preserves the original polling bound. Once EOF has
	// been observed there is no external input boundary to amortize across.
	if m.Input != nil {
		budget = 1024
	}
	if remaining < budget {
		budget = remaining
	}
	if m.Clock == nil && m.nextTimer > m.ticks && m.nextTimer-m.ticks < budget {
		budget = m.nextTimer - m.ticks
	}
	// Only deliverable PIC requests require the one-instruction boundary.
	// An IRR bit with IF clear or another IRQ in service cannot interrupt:
	// single-stepping it starves precisely the handler that must unblock it.
	if m.System.Interruptible() && m.PIC[0].isr == 0 && m.PIC[0].irr & ^m.PIC[0].mask != 0 {
		budget = 1
	}
	if m.adapter == nil {
		m.adapter = &nativeCPU{SystemAdapter: amd64.NewSystemAdapter(&m.CPU), m: m}
	}
	cpu := m.adapter
	cpu.Import()
	cpu.accounted = m.CPU.Retired
	err := m.activeJIT().RunQuanta(cpu, budget)
	cpu.sync()
	cpu.Export()
	return err
}

-- jit_cached_control_test.go --
package amd64machine

import (
	"renvo.dev/emulators/amd64"
	"testing"
)

func TestCheckedCachedKernelControlInstructionsKeepTimeShadowAndLiveState(t *testing.T) {
	native, interpreted := jitKernelMachine(t, "native"), jitKernelMachine(t, "interpreter")
	// CLI; SWAPGS; RDMSR GSBASE; STI; NOP; JMP back. Control operations
	// remain interpreted, and STI's shadow requires its old scheduling edge.
	code := []byte{0xfa, 0x0f, 0x01, 0xf8, 0x0f, 0x32, 0xfb, 0x90, 0xeb, 0xf6}
	for _, m := range []*Machine{native, interpreted} {
		for n, b := range code {
			if err := m.Write(0x10000+uint64(n), 1, uint64(b)); err != nil {
				t.Fatal(err)
			}
		}
		m.CPU.R[amd64.RCX] = 0xc0000101
		m.System.GSBase, m.System.KernelGSBase = 0x1122334455667788, 0x8877665544332211
		m.CPU.Flags = 2 | amd64.FlagIF
	}
	for _, budget := range []uint64{8192, 1, 2, 3, 65, 4096} {
		jitRun(t, native, budget)
		jitRun(t, interpreted, budget)
		if native.CPU.R != interpreted.CPU.R || native.CPU.Flags != interpreted.CPU.Flags || native.CPU.PC != interpreted.CPU.PC || native.CPU.Retired != interpreted.CPU.Retired || native.ticks != interpreted.ticks || native.System.TSC != interpreted.System.TSC || native.System.IRQShadow != interpreted.System.IRQShadow || native.System.GSBase != interpreted.System.GSBase || native.System.KernelGSBase != interpreted.System.KernelGSBase {
			t.Fatal("cached kernel control state/time/shadow differs", budget)
		}
	}
	if native.JIT.Stats.Interpreted == 0 || native.JIT.Stats.CodeReads >= native.CPU.Retired/4 {
		t.Fatal("validated control opcodes were not cached")
	}
	// Remapping execution to NX must revoke the cached opcode; no SWAPGS or
	// mask operation may run from a formerly valid decoded instruction.
	for _, m := range []*Machine{native, interpreted} {
		if err := m.Write(0x4040, 8, 0x10067|1<<63); err != nil {
			t.Fatal(err)
		}
		m.System.Flush()
		m.CPU.PC = 0xffff800000008000
	}
	beforeGS, beforeFlags := native.System.GSBase, native.CPU.Flags
	// No IDT is installed: both paths fail delivering the execute fault.
	nativeErr, interpErr := native.RunQuantum(1), interpreted.RunQuantum(1)
	if nativeErr == nil || interpErr == nil || native.System.GSBase != beforeGS || native.CPU.Flags != beforeFlags || native.CPU.Retired != interpreted.CPU.Retired {
		t.Fatal("cached opcode bypassed execute revoke", nativeErr, interpErr)
	}
}

-- jit_decode_mapping_test.go --
package amd64machine

import (
	"renvo.dev/emulators/amd64"
	"testing"
)

func TestSystemDecodeCacheRemapAndExecuteRevocation(t *testing.T) {
	m := jitMachine(t, "interpreter")
	if err := m.CPU.Step(); err != nil {
		t.Fatal(err)
	}
	if m.CPU.R[amd64.RAX] != 1 {
		t.Fatal("initial instruction")
	}
	// Same virtual PC, different physical code: cached INC RAX must not survive.
	copy(m.RAM[0x12000:], []byte{0x48, 0xff, 0xc3})
	if err := m.Write(0x4040, 8, 0x12067); err != nil {
		t.Fatal(err)
	}
	m.System.Flush()
	m.CPU.PC = 0x8000
	before := m.CPU.R[amd64.RBX]
	if err := m.CPU.Step(); err != nil {
		t.Fatal(err)
	}
	if m.CPU.R[amd64.RAX] != 1 || m.CPU.R[amd64.RBX] != before+1 {
		t.Fatal("stale physical decode")
	}
	if err := m.Write(0x4040, 8, 0x12067|1<<63); err != nil {
		t.Fatal(err)
	}
	m.System.Flush()
	m.CPU.PC = 0x8000
	before = m.CPU.R[amd64.RBX]
	if err := m.CPU.Step(); err == nil || m.System.CR[2] != 0x8000 || m.CPU.R[amd64.RBX] != before {
		t.Fatal("stale execute grant")
	}
}

func TestSystemDecodeCacheStraddlingSecondPageRemap(t *testing.T) {
	m := jitMachine(t, "interpreter")
	if err := m.Write(0x4048, 8, 0x11067); err != nil {
		t.Fatal(err)
	}
	if err := m.Write(0x10fff, 1, 0xb8); err != nil {
		t.Fatal(err)
	}
	if err := m.Write(0x11000, 4, 0x12345678); err != nil {
		t.Fatal(err)
	}
	m.System.Flush()
	m.CPU.PC = 0x8fff
	if err := m.CPU.Step(); err != nil {
		t.Fatal(err)
	}
	if m.CPU.R[amd64.RAX] != 0x12345678 {
		t.Fatal("initial straddling instruction")
	}
	if err := m.Write(0x12000, 4, 0x98765432); err != nil {
		t.Fatal(err)
	}
	if err := m.Write(0x4048, 8, 0x12067); err != nil {
		t.Fatal(err)
	}
	m.System.Flush()
	m.CPU.PC = 0x8fff
	if err := m.CPU.Step(); err != nil {
		t.Fatal(err)
	}
	if m.CPU.R[amd64.RAX] != 0x98765432 {
		t.Fatal("stale second-page instruction bytes")
	}
}

-- jit_domains.go --
package amd64machine

import (
	"fmt"
	"os"
	"renvo.dev/internal/rfe/engine"
)

func (m *Machine) activeJIT() *engine.Engine {
	if m.nativeDomain() != 0 && m.KernelJIT != nil {
		return m.KernelJIT
	}
	return m.JIT
}
func (m *Machine) EnableSystemJIT(mode string) error {
	cache, err := engine.SystemCachePreset(m.JITCache)
	if err != nil {
		return err
	}
	m.kernelThreshold = 256
	m.NativeRAM.Profile = m.ProfileJIT
	user := engine.DefaultEngineConfig()
	user.Mode = mode
	user.ProfileNative = m.ProfileJIT
	user.ProfileNativeMonotonic = m.ProfileJIT
	user.EvictCold, user.RecycleNative = true, true
	user.DiscoveryThreshold = 8
	user.MaxBlocks, user.NativeBytes = cache.UserBlocks, cache.UserBytes
	kernel := user
	kernel.DiscoveryThreshold = 64
	kernel.MaxBlocks, kernel.NativeBytes = cache.KernelBlocks, cache.KernelBytes
	kernel.MaxRegionInstructions = 64
	first, err := m.newJIT(user)
	if err != nil {
		return err
	}
	second, err := m.newJIT(kernel)
	if err != nil {
		first.Close()
		return err
	}
	m.JIT, m.KernelJIT = first, second
	m.NativeRAM.MultipleArenas = true
	return nil
}

// Close ends the machine/RAM lifetime; CloseJIT alone still permits interpreting.
func (m *Machine) Close() error {
	m.CloseJIT()
	err := m.NativeRAM.Close()
	m.RAM = nil
	return err
}

func (m *Machine) CloseJIT() {
	if m.JIT != nil {
		m.JIT.Close()
	}
	if m.KernelJIT != nil {
		m.KernelJIT.Close()
	}
}
func (m *Machine) printKernelJITStats() {
	if m.KernelJIT != nil {
		fmt.Fprintf(os.Stderr, "jit kernel stats=%+v cached=%d\n", m.KernelJIT.Stats, m.KernelJIT.CachedBlocks())
	}
}

-- jit_domains_test.go --
package amd64machine

import (
	"renvo.dev/emulators/amd64"
	"testing"
)

func TestSystemJITSeparateDomainsDifferential(t *testing.T) {
	native, interpreted := jitKernelMachine(t, "native"), jitKernelMachine(t, "interpreter")
	for _, item := range []struct {
		m    *Machine
		mode string
	}{{native, "native"}, {interpreted, "interpreter"}} {
		item.m.CloseJIT()
		if err := item.m.EnableSystemJIT(item.mode); err != nil {
			t.Fatal(err)
		}
		t.Cleanup(item.m.CloseJIT)
	}
	for cycle := 0; cycle < 3; cycle++ {
		for _, m := range []*Machine{native, interpreted} {
			m.System.CPL = 0
			m.CPU.PC = 0xffff800000008000
			m.CPU.R[amd64.RBX] = 0xffff800000009000
			jitRun(t, m, 16384)
			m.System.CPL = 3
			m.CPU.PC = 0x8000
			m.CPU.R[amd64.RBX] = 0x9000
			jitRun(t, m, 16384)
		}
		if native.CPU.R != interpreted.CPU.R || native.CPU.Flags != interpreted.CPU.Flags || native.CPU.PC != interpreted.CPU.PC || native.CPU.Retired != interpreted.CPU.Retired || native.ticks != interpreted.ticks || native.System.TSC != interpreted.System.TSC {
			t.Fatal("domain switch differs from interpreter")
		}
	}
	if native.JIT.Stats.NativeMemory == 0 || native.KernelJIT.Stats.NativeMemory == 0 {
		t.Fatal("both domain arenas must execute actual native RAM operations")
	}
	if native.JIT.CachedBlocks()+native.KernelJIT.CachedBlocks() > 4096 || native.JIT.Stats.NativeBytes > 6<<20 || native.KernelJIT.Stats.NativeBytes > 2<<20 {
		t.Fatal("system JIT expanded aggregate resource limits")
	}
}

-- jit_kernel_test.go --
package amd64machine

import (
	"encoding/binary"
	"renvo.dev/emulators/amd64"
	"testing"
)

func jitKernelMachine(t *testing.T, mode string) *Machine {
	m := jitMachine(t, mode)
	m.kernelThreshold = 64
	if err := m.Write(0x1800, 8, 0x2007); err != nil {
		t.Fatal(err)
	}
	m.System.CPL = 0
	m.System.Flush()
	m.CPU.PC = 0xffff800000008000
	m.CPU.R[amd64.RBX] = 0xffff800000009000
	return m
}
func TestKernelJITHighVirtualRAMAndDomainRevocation(t *testing.T) {
	native, interpreted := jitKernelMachine(t, "native"), jitKernelMachine(t, "interpreter")
	jitRun(t, native, 4096)
	jitRun(t, interpreted, 4096)
	if native.JIT.Stats.NativeMemory == 0 || native.CPU.R != interpreted.CPU.R || native.CPU.PC != interpreted.CPU.PC || native.CPU.Flags != interpreted.CPU.Flags || native.ticks != interpreted.ticks || native.System.TSC != interpreted.System.TSC || binary.LittleEndian.Uint64(native.RAM[0x11000:]) != 1024 {
		t.Fatal("high kernel JIT differs from interpreter")
	}
	key := uint64(0x800000009000)
	native.NativeRAM.NativeRefill(key)
	context := native.NativeRAM.NativeContext()
	if context.Pages[(key>>12)&63].Data == nil {
		t.Fatal("high kernel descriptor missing")
	}
	// The same low-48-bit key is NONCANONICAL in CPL3. The former kernel
	// descriptor must be gone before user native code could attempt access.
	native.System.CPL = 3
	if native.NativeRAM.NativeContext().Pages[(key>>12)&63].Data != nil {
		t.Fatal("kernel descriptor leaked across privilege domain")
	}
	native.NativeRAM.NativeRefill(key)
	if context.Pages[(key>>12)&63].Data != nil {
		t.Fatal("noncanonical user address admitted kernel RAM")
	}
}

-- jit_low_kernel_test.go --
package amd64machine

import (
	"renvo.dev/emulators/amd64"
	"testing"
)

func TestKernelJITCanonicalLowBankUsesOriginalMapping(t *testing.T) {
	native, interpreted := jitKernelMachine(t, "native"), jitKernelMachine(t, "interpreter")
	for _, m := range []*Machine{native, interpreted} {
		m.CPU.R[amd64.RBX] = 0x9000
		jitRun(t, m, 16384)
	}
	if native.CPU.R != interpreted.CPU.R || native.CPU.Flags != interpreted.CPU.Flags || native.CPU.PC != interpreted.CPU.PC || native.CPU.Retired != interpreted.CPU.Retired || native.ticks != interpreted.ticks {
		t.Fatal("kernel low-bank native mapping differs from architecture")
	}
	if native.JIT.Stats.NativeMemory < 4096 {
		t.Fatalf("canonical low-bank accesses never executed natively: %+v", native.JIT.Stats)
	}
	// A bit-47 key only sign-extends in the kernel; it cannot become a
	// canonical user address by inheriting a previous native descriptor.
	native.System.CPL = 3
	key := uint64(0x800000009000)
	native.NativeRAM.NativeRefill(key)
	if native.NativeRAM.NativeContext().Pages[(key>>12)&63].Data != nil {
		t.Fatal("kernel key leaked into noncanonical user address")
	}
}

-- jit_native_clock_test.go --
package amd64machine

import (
	"renvo.dev/emulators/amd64"
	"testing"
)

func TestNativeTimestampReadsExactPrefixesAndWrap(t *testing.T) {
	for _, cpl := range []int{0, 3} {
		native, expected := jitMachine(t, "native"), jitMachine(t, "interpreter")
		code := []byte{0x0f, 0x31, 0x48, 0x89, 0xc3, 0x49, 0xff, 0xc1, 0x0f, 0x01, 0xf9, 0xeb, 0xf3}
		for _, m := range []*Machine{native, expected} {
			copy(m.RAM[0x10000:], code)
			m.System.CPL = uint8(cpl)
			m.kernelThreshold = 64
			m.System.TSC = ^uint64(0) - 500
			m.CPU.R[amd64.RCX] = 0x8877665544332211
		}
		for _, budget := range []uint64{8192, 1, 2, 3, 4, 65, 1024} {
			jitRun(t, native, budget)
			jitRun(t, expected, budget)
			if native.CPU.R != expected.CPU.R || native.CPU.PC != expected.CPU.PC || native.CPU.Flags != expected.CPU.Flags || native.CPU.Retired != expected.CPU.Retired || native.ticks != expected.ticks || native.System.TSC != expected.System.TSC {
				t.Fatal("native clock drift", cpl, budget, native.CPU.R, expected.CPU.R, native.System.TSC, expected.System.TSC)
			}
		}
		if native.JIT.Stats.Native <= native.CPU.Retired*3/4 {
			t.Fatal("timestamp reads stayed interpreted")
		}
		for _, m := range []*Machine{native, expected} {
			m.System.TSC += 12345678
			m.CPU.PC = 0x8000
		}
		jitRun(t, native, 127)
		jitRun(t, expected, 127)
		if native.CPU.R != expected.CPU.R || native.System.TSC != expected.System.TSC {
			t.Fatal("stale native clock base")
		}
	}
}

