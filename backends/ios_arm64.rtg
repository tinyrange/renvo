@import "../backend/definitions/darwin_aarch64.rtg"

# The shared Darwin emitter already supplies AArch64 lowering, libSystem
# imports, Mach-O layout, and an ad-hoc signature. The iOS target changes the
# Mach-O platform contract and then refreshes the signature over that header.
go backend {
	const iosSelfLibrary = "renvo-ios"
	const iosObjCLibrary = "/usr/lib/libobjc.A.dylib"
	const iosCallbackRelocation = 16
	const iosCallbackDidFinish = 1
	const iosCallbackTouchesBegan = 2
	const iosCallbackTouchesMoved = 3
	const iosCallbackTouchesEnded = 4
	const iosCallbackTouchesCancelled = 5

	func iosCallbackName(id int) string {
		if id == iosCallbackDidFinish {
			return "iosDidFinishLaunching"
		}
		if id == iosCallbackTouchesBegan {
			return "iosTouchesBegan"
		}
		if id == iosCallbackTouchesMoved {
			return "iosTouchesMoved"
		}
		if id == iosCallbackTouchesEnded {
			return "iosTouchesEnded"
		}
		if id == iosCallbackTouchesCancelled {
			return "iosTouchesCancelled"
		}
		return ""
	}

	func iosSymbolPC(out *RTGEmitter, name string) int {
		for i := 0; i < out.SymbolCount(); i++ {
			if out.SymbolNameEquals(i, name) {
				return out.SymbolPC(i)
			}
		}
		return -1
	}

	func iosPatchCallbackPointers(out *RTGEmitter, image []byte) {
		for i := 0; i < out.AbsoluteRelocationCount(); i++ {
			if out.AbsoluteRelocationKind(i) != iosCallbackRelocation {
				continue
			}
			at := out.AbsoluteRelocationOffset(i)
			callback := out.AbsoluteRelocationAddend(i)
			targetPC := iosSymbolPC(out, iosCallbackName(callback))
			if targetPC < 0 {
				panic("iOS UIKit callback is missing")
			}
			instructionAt := darwin_aarch64.machCodeOffset + at
			target := darwin_aarch64.machImageBase +
				darwin_aarch64.machCodeOffset + targetPC
			pc := darwin_aarch64.machImageBase + instructionAt
			pageDelta := (target >> 12) - (pc >> 12)
			imm := pageDelta & 0x1fffff
			insn := RTGGet32At(image, instructionAt)
			reg := insn & 31
			RTGPut32At(image, instructionAt,
				0x90000000|((imm&3)<<29)|
					(((imm>>2)&0x7ffff)<<5)|reg)
			RTGPut32At(image, instructionAt+4,
				0x91000000|((target&0xfff)<<10)|(reg<<5)|reg)
		}
	}

	func iosEmitCallbackPointer(out *RTGEmitter, callback int) {
		at := out.Len()
		out.Uint32(0x90000000)
		out.Uint32(0x91000000)
		out.Uint32(0xd503201f)
		out.Uint32(0xd503201f)
		out.AbsoluteReloc(at, callback, iosCallbackRelocation)
	}

	func iosStaticCall(out *RTGEmitter, importID int, wordCount int) {
		library := out.StaticImportDLL(importID)
		name := out.StaticImportName(importID)
		rectCall := library == iosSelfLibrary &&
			name == "renvoIOSObjcMsgRect"
		sizeCall := library == iosSelfLibrary &&
			name == "renvoIOSObjcMsgSize"
		registerWords := wordCount
		if registerWords > 8 {
			registerWords = 8
		}
		if rectCall {
			aarch64.asmPopReg(out, 0)
			aarch64.asmPopReg(out, 1)
			for i := 0; i < 4; i++ {
				aarch64.asmPopReg(out, 16)
				out.Uint32(0x9e620000 | (16 << 5) | i)
			}
		} else if sizeCall {
			aarch64.asmPopReg(out, 0)
			aarch64.asmPopReg(out, 1)
			for i := 0; i < 2; i++ {
				aarch64.asmPopReg(out, 16)
				out.Uint32(0x9e620000 | (16 << 5) | i)
			}
		} else {
			for i := 0; i < registerWords; i++ {
				aarch64.asmPopReg(out, i)
			}
		}
		stackWords := wordCount - registerWords
		if rectCall || sizeCall {
			stackWords = 0
		}
		aarch64.asmEmit(out, 0x910003e9)
		savedSPOff := stackWords * 8
		allocation := RTGAlignValue(savedSPOff+8, 16)
		aarch64.asmAddRegImm(out, 31, 31, -allocation)
		for i := 0; i < stackWords; i++ {
			aarch64.asmLoadRegMem(out, 10, 9, i*16, 8)
			aarch64.asmStoreRegMem(out, 10, 31, i*8, 8)
		}
		aarch64.asmStoreRegMem(out, 9, 31, savedSPOff, 8)

		callback := 0
		if library == iosSelfLibrary {
			if name == "renvoIOSDelegateDidFinishCallback" {
				callback = iosCallbackDidFinish
			} else if name == "renvoIOSTouchesBeganCallback" {
				callback = iosCallbackTouchesBegan
			} else if name == "renvoIOSTouchesMovedCallback" {
				callback = iosCallbackTouchesMoved
			} else if name == "renvoIOSTouchesEndedCallback" {
				callback = iosCallbackTouchesEnded
			} else if name == "renvoIOSTouchesCancelledCallback" {
				callback = iosCallbackTouchesCancelled
			}
		}
		if callback != 0 {
			iosEmitCallbackPointer(out, callback)
		} else {
			actualLibrary := library
			actualName := name
			if library == iosSelfLibrary {
				actualLibrary = iosObjCLibrary
				actualName = "_objc_msgSend"
			}
			index := out.DynamicImport(actualLibrary, actualName)
			aarch64.asmCallLabel(out, out.DynamicImportLabel(index))
		}

		if library == iosSelfLibrary {
			resultFloat := -1
			if name == "renvoIOSObjcMsgFloat" {
				resultFloat = 0
			} else if name == "renvoIOSObjcMsgPointX" {
				resultFloat = 0
			} else if name == "renvoIOSObjcMsgPointY" {
				resultFloat = 1
			} else if name == "renvoIOSObjcMsgRectWidth" {
				resultFloat = 2
			} else if name == "renvoIOSObjcMsgRectHeight" {
				resultFloat = 3
			}
			if resultFloat >= 0 {
				out.Uint32(0x9e780000 | (resultFloat << 5))
			}
		}
		aarch64.asmMovRegReg(out, 10, 0)
		aarch64.asmLoadRegMem(out, 9, 31, savedSPOff, 8)
		aarch64.asmEmit(out, 0x9100013f)
		aarch64.asmAddRegImm(out, 31, 31, stackWords*16)
		aarch64.asmMovRegReg(out, 0, 10)
	}

	func iosSegmentNameEquals(image []byte, at int, name string) bool {
		if at < 0 || at+16 > len(image) {
			return false
		}
		for i := 0; i < 16; i++ {
			want := byte(0)
			if i < len(name) {
				want = name[i]
			}
			if image[at+i] != want {
				return false
			}
		}
		return true
	}

	func iosPatchImage(out *RTGEmitter, image []byte) []byte {
		if len(image) < 32 {
			return image
		}
		iosPatchCallbackPointers(out, image)
		commands := RTGGet32At(image, 16)
		at := 32
		signatureOffset := 0
		signatureSize := 0
		executableLimit := 0
		for i := 0; i < commands; i++ {
			if at < 0 || at+8 > len(image) {
				return image
			}
			command := RTGGet32At(image, at)
			size := RTGGet32At(image, at+4)
			if size < 8 || at+size > len(image) {
				return image
			}
			if command == 0x19 && size >= 72 &&
				iosSegmentNameEquals(image, at+8, "__TEXT") {
				executableLimit = RTGGet32At(image, at+48)
			}
			if command == 0x32 && size >= 24 {
				RTGPut32At(image, at+8, 2)
				RTGPut32At(image, at+12, 0x000d0000)
				RTGPut32At(image, at+16, 0x000d0000)
			}
			if command == 0x1d && size >= 16 {
				signatureOffset = RTGGet32At(image, at+8)
				signatureSize = RTGGet32At(image, at+12)
			}
			at += size
		}
		if signatureOffset <= 0 || signatureSize <= 0 ||
			signatureOffset+signatureSize > len(image) ||
			executableLimit <= 0 {
			return image
		}
		signature := darwin_aarch64.machCodeSignature(
			image[:signatureOffset], "renvo", executableLimit)
		if len(signature) != signatureSize {
			return image
		}
		for i := 0; i < len(signature); i++ {
			image[signatureOffset+i] = signature[i]
		}
		return image
	}
}

extend arch aarch64 {
	sequences {
		iosMachImage(out:emitter) -> bytes {
			let image = darwin_aarch64.machImage(out)
			return iosPatchImage(out, image)
		}
	}
}

runtime ios_arm64 {
	entry sequence darwin_aarch64.darwinEntry {
		max_parameters = 2
		requires_state = true
		bss args 32768 16
		bss environment 32768 16
	}
	entry_state_bytes = 24
	emit_entry_start = go darwin_aarch64.darwinEntryStart
	emit_exit = sequence darwin_aarch64.darwinExit
	emit_static_call = go iosStaticCall
	operation read { emit = sequence darwin_aarch64.darwinRead }
	operation write { emit = sequence darwin_aarch64.darwinWrite }
	operation read_at { emit = sequence darwin_aarch64.darwinReadAt }
	operation write_at { emit = sequence darwin_aarch64.darwinWriteAt }
	operation open { emit = sequence darwin_aarch64.darwinOpen }
	operation close { emit = sequence darwin_aarch64.darwinClose }
	operation chmod { emit = sequence darwin_aarch64.darwinChmod }
	operation print { use = write }
}

format macho64_ios_arm64 {
	byte_order = little
	address_bits = 64
	kind = "mach-o"
	cpu = 0x0100000c
	code_offset = 0x1000
	image = sequence iosMachImage
}

target ios/arm64 {
	family = native_v1
	os = darwin
	arch = aarch64
	frontend_arch = aarch64
	abi = aapcs64
	runtime = ios_arm64
	executable = macho64_ios_arm64
	build_tags = [ios, darwin, unix, aarch64, arm64]
	capabilities = [hosted, executable, filesystem, heap, argv, environment, function_symbols]
}
