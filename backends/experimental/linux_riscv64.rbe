# SPDX-License-Identifier: Apache-2.0
# Self-contained Linux backend. Copy this file to use or extend this target.
definition 1
unit linux_riscv64
implements direct_emitter_v1
go backend {
	func riscv64Emit(out *RTGEmitter, instruction int) {
		RTGUint32(out, instruction)
	}

	func riscv64EncodeR(
		out *RTGEmitter, opcode int, funct3 int, funct7 int,
		destination RTGRegister, left RTGRegister, right RTGRegister,
	) {
		riscv64Emit(out, opcode|(destination.Code<<7)|(funct3<<12)|
			(left.Code<<15)|(right.Code<<20)|(funct7<<25))
	}

	func riscv64EncodeI(
		out *RTGEmitter, opcode int, funct3 int, destination RTGRegister,
		source RTGRegister, immediate int,
	) {
		riscv64Emit(out, opcode|(destination.Code<<7)|(funct3<<12)|
			(source.Code<<15)|((immediate&0xfff)<<20))
	}

	func riscv64EncodeS(
		out *RTGEmitter, funct3 int, base RTGRegister,
		source RTGRegister, immediate int,
	) {
		value := immediate & 0xfff
		riscv64Emit(out, 0x23|((value&0x1f)<<7)|(funct3<<12)|
			(base.Code<<15)|(source.Code<<20)|((value>>5)<<25))
	}

	func riscv64EncodeU(out *RTGEmitter, opcode int, destination RTGRegister, immediate int) {
		riscv64Emit(out, opcode|(destination.Code<<7)|(immediate&0xfffff000))
	}

	func riscv64Move(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		if destination.Code != source.Code {
			riscv64EncodeI(out, 0x13, 0, destination, source, 0)
		}
	}

	func riscv64MoveImmediate(out *RTGEmitter, destination RTGRegister, value int64) {
		if value >= -2048 && value <= 2047 {
			riscv64EncodeI(out, 0x13, 0, destination, riscv64ZERO, int(value))
			return
		}
		low := int(value & 4095)
		if low >= 2048 {
			low -= 4096
		}
		upper := (value >> 12)
		if low < 0 {
			upper++
		}
		riscv64MoveImmediate(out, destination, upper)
		riscv64EncodeI(out, 0x13, 1, destination, destination, 12)
		if low != 0 {
			riscv64EncodeI(out, 0x13, 0, destination, destination, low)
		}
	}

	func riscv64EmitAddress(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		if RTGAddressValid(value) {
			at := out.Len()
			// Materialize code addresses relative to the current PC. Besides being
			// position independent, AUIPC keeps the architecture definition free of
			// a board-specific text base.
			riscv64EncodeU(out, 0x17, destination, 0)
			riscv64EncodeI(out, 0x13, 0, destination, destination, 0)
			RTGAddressRelocAt(out, value, at)
			return
		}
		base := value.Base
		if !base.Valid {
			base = riscv64ZERO
		}
		if value.Index.Valid {
			shift := RTGLog2(value.Scale)
			riscv64EncodeI(out, 0x13, 1, riscv64Address, value.Index, shift)
			riscv64EncodeR(out, 0x33, 0, 0, destination, base, riscv64Address)
			base = destination
		}
		if value.Displacement >= -2048 && value.Displacement <= 2047 {
			riscv64EncodeI(out, 0x13, 0, destination, base, value.Displacement)
			return
		}
		riscv64MoveImmediate(out, riscv64Address, int64(value.Displacement))
		riscv64EncodeR(out, 0x33, 0, 0, destination, base, riscv64Address)
	}

	func riscv64MaterializeAddress(out *RTGEmitter, value RTGAddress) RTGAddress {
		if !RTGAddressValid(value) && !value.Index.Valid &&
			value.Displacement >= -2048 && value.Displacement <= 2047 {
			return value
		}
		riscv64EmitAddress(out, riscv64Address, value)
		return RTGAddress{Base: riscv64Address}
	}

	func riscv64LoadWidth(
		out *RTGEmitter, destination RTGRegister, value RTGAddress,
		funct3 int,
	) {
		value = riscv64MaterializeAddress(out, value)
		base := value.Base
		if !base.Valid {
			base = riscv64ZERO
		}
		riscv64EncodeI(out, 0x03, funct3, destination, base, value.Displacement)
	}

	func riscv64StoreWidth(
		out *RTGEmitter, value RTGAddress, source RTGRegister, funct3 int,
	) {
		value = riscv64MaterializeAddress(out, value)
		base := value.Base
		if !base.Valid {
			base = riscv64ZERO
		}
		riscv64EncodeS(out, funct3, base, source, value.Displacement)
	}

	func riscv64LoadNative(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		riscv64LoadWidth(out, destination, value, 3)
	}
	func riscv64LoadI32(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		riscv64LoadWidth(out, destination, value, 2)
	}
	func riscv64LoadU32(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		riscv64LoadWidth(out, destination, value, 6)
	}
	func riscv64LoadI16(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		riscv64LoadWidth(out, destination, value, 1)
	}
	func riscv64LoadU16(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		riscv64LoadWidth(out, destination, value, 5)
	}
	func riscv64LoadI8(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		riscv64LoadWidth(out, destination, value, 0)
	}
	func riscv64LoadU8(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		riscv64LoadWidth(out, destination, value, 4)
	}
	func riscv64StoreNative(out *RTGEmitter, value RTGAddress, source RTGRegister) {
		riscv64StoreWidth(out, value, source, 3)
	}
	func riscv64StoreU32(out *RTGEmitter, value RTGAddress, source RTGRegister) {
		riscv64StoreWidth(out, value, source, 2)
	}
	func riscv64StoreU16(out *RTGEmitter, value RTGAddress, source RTGRegister) {
		riscv64StoreWidth(out, value, source, 1)
	}
	func riscv64StoreU8(out *RTGEmitter, value RTGAddress, source RTGRegister) {
		riscv64StoreWidth(out, value, source, 0)
	}

	func riscv64Add(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		riscv64EncodeR(out, 0x33, 0, 0, destination, destination, source)
	}
	func riscv64Subtract(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		riscv64EncodeR(out, 0x33, 0, 0x20, destination, destination, source)
	}
	func riscv64Multiply(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		riscv64EncodeR(out, 0x33, 0, 1, destination, destination, source)
	}
	func riscv64BitAnd(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		riscv64EncodeR(out, 0x33, 7, 0, destination, destination, source)
	}
	func riscv64BitOr(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		riscv64EncodeR(out, 0x33, 6, 0, destination, destination, source)
	}
	func riscv64BitXor(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		riscv64EncodeR(out, 0x33, 4, 0, destination, destination, source)
	}

	func riscv64Compare(out *RTGEmitter, left RTGRegister, right RTGRegister) {
		riscv64Move(out, riscv64CompareLeft, left)
		riscv64Move(out, riscv64CompareRight, right)
	}
	func riscv64Test(out *RTGEmitter, left RTGRegister, right RTGRegister) {
		riscv64Move(out, riscv64CompareLeft, left)
		riscv64BitAnd(out, riscv64CompareLeft, right)
		riscv64Move(out, riscv64CompareRight, riscv64ZERO)
	}

	func riscv64Increment(out *RTGEmitter, operand RTGRegister) {
		riscv64EncodeI(out, 0x13, 0, operand, operand, 1)
	}
	func riscv64Decrement(out *RTGEmitter, operand RTGRegister) {
		riscv64EncodeI(out, 0x13, 0, operand, operand, -1)
	}
	func riscv64ShiftLeftImmediate(out *RTGEmitter, operand RTGRegister, value byte) {
		riscv64EncodeI(out, 0x13, 1, operand, operand, int(value)&63)
	}
	func riscv64ShiftRightUnsignedImmediate(out *RTGEmitter, operand RTGRegister, value byte) {
		riscv64EncodeI(out, 0x13, 5, operand, operand, int(value)&63)
	}
	func riscv64ShiftRightSignedImmediate(out *RTGEmitter, operand RTGRegister, value byte) {
		riscv64EncodeI(out, 0x13, 5, operand, operand, (int(value)&63)|0x400)
	}

	func riscv64EmitJAL(out *RTGEmitter, destination RTGRegister, label RTGLabel) {
		riscv64Emit(out, 0x6f|(destination.Code<<7))
		out.Reloc(label)
	}
	func riscv64Call(out *RTGEmitter, label RTGLabel) {
		// JAL only reaches +/-1 MiB, which large Forms/terminal images exceed.
		// Reserve an AUIPC/JALR pair so relocation keeps the full PC-relative
		// displacement. ra is call-clobbered already; using it as the temporary
		// leaves arguments and every other live register untouched. JALR reads
		// its base before replacing ra with the return address after the pair.
		riscv64EncodeU(out, 0x17, riscv64LINK, 0)
		out.Reloc(label)
		riscv64EncodeI(out, 0x67, 0, riscv64LINK, riscv64LINK, 0)
	}
	func riscv64CallIndirect(out *RTGEmitter, operand RTGRegister) {
		riscv64EncodeI(out, 0x67, 0, riscv64LINK, operand, 0)
	}
	func riscv64Jump(out *RTGEmitter, label RTGLabel) {
		riscv64EmitJAL(out, riscv64ZERO, label)
	}

	func riscv64BranchInstruction(
		out *RTGEmitter, funct3 int, left RTGRegister,
		right RTGRegister, displacement int,
	) {
		value := displacement
		instruction := 0x63 | (funct3 << 12) | (left.Code << 15) | (right.Code << 20)
		instruction |= ((value >> 12) & 1) << 31
		instruction |= ((value >> 5) & 0x3f) << 25
		instruction |= ((value >> 1) & 0xf) << 8
		instruction |= ((value >> 11) & 1) << 7
		riscv64Emit(out, instruction)
	}

	func riscv64JumpCondition(out *RTGEmitter, condition RTGCondition, label RTGLabel) {
		// Skip the long-range JAL when the inverse condition is true. This keeps
		// every compiler-generated conditional branch independent of function size.
		code := condition.Code
		left := riscv64CompareLeft
		right := riscv64CompareRight
		inverse := code ^ 1
		if code == 2 || code == 3 || code == 8 || code == 9 {
			// RISC-V has no <= or > branch opcodes. Express signed and
			// unsigned forms by swapping operands.
			left = riscv64CompareRight
			right = riscv64CompareLeft
			if code == 2 {
				inverse = 4
			} else {
				if code == 3 {
					inverse = 5
				} else {
					if code == 8 {
						inverse = 6
					} else {
						inverse = 7
					}
				}
			}
		}
		riscv64BranchInstruction(out, inverse, left, right, 8)
		riscv64EmitJAL(out, riscv64ZERO, label)
	}

	func riscv64SetCondition(
		out *RTGEmitter, condition RTGCondition, destination RTGRegister,
	) {
		code := condition.Code
		if code == 0 || code == 1 {
			riscv64EncodeR(out, 0x33, 4, 0, destination, riscv64CompareLeft, riscv64CompareRight)
			if code == 0 {
				riscv64EncodeI(out, 0x13, 3, destination, destination, 1)
			} else {
				riscv64EncodeR(out, 0x33, 3, 0, destination, riscv64ZERO, destination)
			}
			return
		}
		left := riscv64CompareLeft
		right := riscv64CompareRight
		invert := false
		unsigned := code >= 6
		if code == 4 || code == 6 {
			// slt/ult
		} else {
			if code == 5 || code == 7 {
				invert = true
			} else {
				if code == 2 || code == 3 || code == 8 || code == 9 {
					// Greater-than forms compare in reverse.
					left = riscv64CompareRight
					right = riscv64CompareLeft
					if code == 2 || code == 8 {
						invert = true
					}
				}
			}
		}
		funct3 := 2
		if unsigned {
			funct3 = 3
		}
		riscv64EncodeR(out, 0x33, funct3, 0, destination, left, right)
		if invert {
			riscv64EncodeI(out, 0x13, 4, destination, destination, 1)
		}
	}

	func riscv64Ret(out *RTGEmitter) {
		riscv64EncodeI(out, 0x67, 0, riscv64ZERO, riscv64LINK, 0)
	}
	func riscv64Leave(out *RTGEmitter) {
		riscv64LoadWidth(out, riscv64LINK, RTGAddress{Base: riscv64FRAME, Displacement: -8}, 3)
		riscv64LoadWidth(out, riscv64Scratch, RTGAddress{Base: riscv64FRAME, Displacement: -16}, 3)
		riscv64Move(out, riscv64STACK, riscv64FRAME)
		riscv64Move(out, riscv64FRAME, riscv64Scratch)
	}

	func riscv64HostSyscall(out *RTGEmitter) {
		// Linux ECALL; arguments and number come from the runtime syscall contract.
		riscv64Emit(out, 0x73)
	}

	func riscv64VariableShift(out *RTGEmitter, direction RTGShiftDirection, signed bool) {
		funct3 := 1
		funct7 := 0
		if direction == RTGShiftRight {
			funct3 = 5
			if signed {
				funct7 = 0x20
			}
		}
		// The expression emitter leaves the shift count in primary and the
		// value in tertiary. RISC-V names both sources explicitly, unlike x86's
		// implicit count register, so preserve that operand order here.
		riscv64EncodeR(out, 0x33, funct3, funct7, riscv64Primary, riscv64Tertiary, riscv64Primary)
	}
	func riscv64UnsignedDivide(out *RTGEmitter, remainder bool) bool {
		funct3 := 5
		if remainder {
			funct3 = 7
		}
		riscv64EncodeR(out, 0x33, funct3, 1, riscv64Primary, riscv64Tertiary, riscv64Primary)
		return true
	}
	func riscv64SignedDivide(out *RTGEmitter, remainder bool) {
		funct3 := 4
		if remainder {
			funct3 = 6
		}
		riscv64EncodeR(out, 0x33, funct3, 1, riscv64Primary, riscv64Tertiary, riscv64Primary)
	}

	func riscv64PatchRelocations(out *RTGEmitter) {
		for index := 0; index < out.RelocationCount(); index++ {
			at := out.RelocationOffset(index)
			target := out.LabelPosition(out.RelocationLabel(index))
			delta := target - at
			instruction := RTGGet32At(out.Code(), at)
			if instruction&0x7f == 0x6f {
				instruction &= 0x00000fff
				instruction |= ((delta >> 20) & 1) << 31
				instruction |= ((delta >> 1) & 0x3ff) << 21
				instruction |= ((delta >> 11) & 1) << 20
				instruction |= ((delta >> 12) & 0xff) << 12
				out.PatchUint32(at, instruction)
			} else {
				if instruction&0x7f == 0x17 {
					// Both code addresses (ADDI) and calls (JALR) use AUIPC.
					// Preserve the second instruction's opcode/registers while patching
					// its signed low immediate, including the carry into the high part.
					register := (instruction >> 7) & 31
					hi := (delta + 0x800) >> 12
					lo := delta - (hi << 12)
					out.PatchUint32(at, 0x17|(register<<7)|(hi<<12))
					next := RTGGet32At(out.Code(), at+4) & 0x000fffff
					out.PatchUint32(at+4, next|((lo&0xfff)<<20))
				}
			}
		}
	}

	func riscv64FrameStart(out *RTGEmitter) int {
		// Preserve the incoming frame pointer while the final frame size is still
		// unknown. Local slots are biased by eight bytes below these saves.
		riscv64Move(out, riscv64Address, riscv64FRAME)
		at := out.Len()
		riscv64EncodeU(out, 0x37, riscv64Scratch, 0)
		riscv64EncodeI(out, 0x13, 0, riscv64Scratch, riscv64Scratch, 0)
		riscv64Subtract(out, riscv64STACK, riscv64Scratch)
		riscv64Move(out, riscv64FRAME, riscv64STACK)
		riscv64Add(out, riscv64FRAME, riscv64Scratch)
		riscv64StoreWidth(out, RTGAddress{Base: riscv64FRAME, Displacement: -8}, riscv64LINK, 3)
		riscv64StoreWidth(out, RTGAddress{Base: riscv64FRAME, Displacement: -16}, riscv64Address, 3)
		return at
	}

	func riscv64FrameFinish(out *RTGEmitter, at int, stackUsed int) {
		frameSize := (stackUsed + 31) & -16
		hi := (frameSize + 0x800) >> 12
		lo := frameSize - (hi << 12)
		out.PatchUint32(at, 0x37|(riscv64Scratch.Code<<7)|(hi<<12))
		out.PatchUint32(at+4, 0x13|(riscv64Scratch.Code<<7)|(riscv64Scratch.Code<<15)|((lo&0xfff)<<20))
	}

	func riscv64FrameLoad(
		out *RTGEmitter, destination RTGRegister, offset int,
	) {
		riscv64LoadWidth(out, destination,
			RTGAddress{Base: riscv64FRAME, Displacement: -(offset + 16)}, 3)
	}
	func riscv64FrameStore(out *RTGEmitter, offset int, source RTGRegister) {
		riscv64StoreWidth(out, RTGAddress{Base: riscv64FRAME, Displacement: -(offset + 16)}, source, 3)
	}
	func riscv64FrameAddress(
		out *RTGEmitter, destination RTGRegister, offset int,
	) {
		riscv64EmitAddress(out, destination,
			RTGAddress{Base: riscv64FRAME, Displacement: -(offset + 16)})
	}

	const elfCodeAddress = 0x11000

	func elfDataOffset(out *RTGEmitter) int  { return RTGAlignValue(0x1000+len(out.Code()), 0x10000) }
	func elfDataAddress(out *RTGEmitter) int { return 0x10000 + elfDataOffset(out) }
	func elfBssAddress(out *RTGEmitter) int {
		return RTGAlignValue(elfDataAddress(out)+len(out.Data()), 16)
	}
	func elfPut(image []byte, at int, value uint64, width int, big bool) {
		for i := 0; i < width; i++ {
			shift := i * 8
			if big {
				shift = (width - 1 - i) * 8
			}
			image[at+i] = byte(value >> uint(shift))
		}
	}
	func elfImage(out *RTGEmitter, machine int, flags int, bits int, big bool) []byte {
		offset := elfDataOffset(out)
		result := make([]byte, offset+len(out.Data()))
		result[0] = 0x7f
		result[1] = 'E'
		result[2] = 'L'
		result[3] = 'F'
		result[4] = 1
		if bits == 64 {
			result[4] = 2
		}
		result[5] = 1
		if big {
			result[5] = 2
		}
		result[6] = 1
		elfPut(result, 16, 2, 2, big)
		elfPut(result, 18, uint64(machine), 2, big)
		elfPut(result, 20, 1, 4, big)
		if bits == 32 {
			elfPut(result, 24, elfCodeAddress, 4, big)
			elfPut(result, 28, 52, 4, big)
			elfPut(result, 36, uint64(flags), 4, big)
			elfPut(result, 40, 52, 2, big)
			elfPut(result, 42, 32, 2, big)
			elfPut(result, 44, 2, 2, big)
		} else {
			elfPut(result, 24, elfCodeAddress, 8, big)
			elfPut(result, 32, 64, 8, big)
			elfPut(result, 48, uint64(flags), 4, big)
			elfPut(result, 52, 64, 2, big)
			elfPut(result, 54, 56, 2, big)
			elfPut(result, 56, 2, 2, big)
		}
		for i := 0; i < 2; i++ {
			file := 0
			address := 0x10000
			size := 0x1000 + len(out.Code())
			memory := size
			permissions := 5
			if i == 1 {
				file = offset
				address = elfDataAddress(out)
				size = len(out.Data())
				memory = elfBssAddress(out) - address + out.BSSSize()
				permissions = 6
			}
			if bits == 32 {
				at := 52 + i*32
				elfPut(result, at, 1, 4, big)
				elfPut(result, at+4, uint64(file), 4, big)
				elfPut(result, at+8, uint64(address), 4, big)
				elfPut(result, at+12, uint64(address), 4, big)
				elfPut(result, at+16, uint64(size), 4, big)
				elfPut(result, at+20, uint64(memory), 4, big)
				elfPut(result, at+24, uint64(permissions), 4, big)
				elfPut(result, at+28, 0x10000, 4, big)
			} else {
				at := 64 + i*56
				elfPut(result, at, 1, 4, big)
				elfPut(result, at+4, uint64(permissions), 4, big)
				elfPut(result, at+8, uint64(file), 8, big)
				elfPut(result, at+16, uint64(address), 8, big)
				elfPut(result, at+24, uint64(address), 8, big)
				elfPut(result, at+32, uint64(size), 8, big)
				elfPut(result, at+40, uint64(memory), 8, big)
				elfPut(result, at+48, 0x10000, 8, big)
			}
		}
		copy(result[0x1000:], out.Code())
		copy(result[offset:], out.Data())
		return result
	}

	func targetEntry(out *RTGEmitter, count int, state int) bool { _ = out; _ = state; return count == 0 }
	func targetSyscall(out *RTGEmitter, number int) {
		riscv64MoveImmediate(out, RTGRegister{Code: 17, Valid: true}, int64(number))
		riscv64Emit(out, 0x73)
	}
	func targetWrite(out *RTGEmitter) { targetSyscall(out, 64) }
	func targetRead(out *RTGEmitter)  { targetSyscall(out, 63) }
	func targetClose(out *RTGEmitter) { targetSyscall(out, 57) }
	func targetChmod(out *RTGEmitter) { targetSyscall(out, 52) }
	func targetExit(out *RTGEmitter, status RTGRegister) {
		riscv64Move(out, RTGRegister{Code: 10, Valid: true}, status)
		targetSyscall(out, 93)
	}
	func targetOpen(out *RTGEmitter) {
		riscv64Move(out, RTGRegister{Code: 13, Valid: true}, RTGRegister{Code: 12, Valid: true})
		riscv64Move(out, RTGRegister{Code: 12, Valid: true}, RTGRegister{Code: 11, Valid: true})
		riscv64Move(out, RTGRegister{Code: 11, Valid: true}, RTGRegister{Code: 10, Valid: true})
		riscv64MoveImmediate(out, RTGRegister{Code: 10, Valid: true}, -100)
		targetSyscall(out, 56)
	}
	func targetImage(out *RTGEmitter) []byte {
		for i := 0; i < out.AbsoluteRelocationCount(); i++ {
			at := out.AbsoluteRelocationOffset(i)
			target, ok := RTGResolveAbsoluteRelocation(out, out.AbsoluteRelocationKind(i), out.AbsoluteRelocationAddend(i), elfDataAddress(out), elfBssAddress(out))
			if !ok {
				return nil
			}
			delta := target - elfCodeAddress - at
			hi := (delta + 0x800) >> 12
			lo := delta - (hi << 12)
			instruction := RTGGet32At(out.Code(), at)
			out.PatchUint32(at, (instruction&0xfff)|(hi<<12))
			next := RTGGet32At(out.Code(), at+4)
			out.PatchUint32(at+4, (next&0xfffff)|((lo&0xfff)<<20))
		}
		return elfImage(out, 243, 0, 64, false)
	}
}

arch riscv64 {
	alias = "riscv64"
	endian = little
	word_bits = 64
	pointer_bits = 64
	instruction_alignment = 4
	stack_word_bytes = 8
	stack_alignment = 16
	patch_relocations = go riscv64PatchRelocations
	registers integer = [zero, link, stack, gp, tp, t0, t1, t2, frame, s1, a0, a1, a2, a3, a4, a5, a6, a7, s2, s3, s4, s5, s6, s7, s8, s9, s10, s11, t3, t4, t5, t6]
	locations {
		primary = a0
		secondary = a1
		tertiary = a2
		scratch = t0
		address = t6
		compareLeft = t3
		compareRight = t4
		copy_destination = a3
		copy_source = a4
		copy_count = a5
		stack = stack
		frame = frame
		link = link
	}
	conditions {
		eq = 0
		ne = 1
		sle = 2
		sgt = 3
		slt = 4
		sge = 5
		ult = 6
		uge = 7
		ule = 8
		ugt = 9
	}
	bind {
		move = go riscv64Move
		address = go riscv64EmitAddress
		load.native = go riscv64LoadNative
		load.i32 = go riscv64LoadI32
		load.u32 = go riscv64LoadU32
		load.i16 = go riscv64LoadI16
		load.u16 = go riscv64LoadU16
		load.i8 = go riscv64LoadI8
		load.u8 = go riscv64LoadU8
		store.native = go riscv64StoreNative
		store.u32 = go riscv64StoreU32
		store.u16 = go riscv64StoreU16
		store.u8 = go riscv64StoreU8
		add = go riscv64Add
		subtract = go riscv64Subtract
		multiply = go riscv64Multiply
		bit_and = go riscv64BitAnd
		bit_or = go riscv64BitOr
		bit_xor = go riscv64BitXor
		compare = go riscv64Compare
		test = go riscv64Test
		increment = go riscv64Increment
		decrement = go riscv64Decrement
		shift_left_immediate = go riscv64ShiftLeftImmediate
		shift_right_unsigned_immediate = go riscv64ShiftRightUnsignedImmediate
		shift_right_signed_immediate = go riscv64ShiftRightSignedImmediate
		call = go riscv64Call
		call_indirect = go riscv64CallIndirect
		jump = go riscv64Jump
		jump_condition = go riscv64JumpCondition
		set_condition = go riscv64SetCondition
		return = go riscv64Ret
		leave = go riscv64Leave
		host_syscall = go riscv64HostSyscall
		move_immediate = go riscv64MoveImmediate
		variable_shift = go riscv64VariableShift
		signed_divide = go riscv64SignedDivide
		copy_bytes = sequence riscv64CopyBytes
	}
	sequences {
		riscv64CopyBytes(out:emitter) {
			let forward = out.NewLabel()
			let backwardLoop = out.NewLabel()
			let forwardLoop = out.NewLabel()
			let done = out.NewLabel()
			riscv64Compare(out, riscv64CopyDestination, riscv64CopySource)
			riscv64JumpCondition(out, riscv64ULT, forward)
			riscv64EmitAddress(out, riscv64Scratch, record_address(Base:riscv64CopySource, Index:riscv64CopyCount, Scale:1,))
			riscv64Compare(out, riscv64CopyDestination, riscv64Scratch)
			riscv64JumpCondition(out, riscv64UGE, forward)
			riscv64EmitAddress(out, riscv64CopySource, record_address(Base:riscv64CopySource, Index:riscv64CopyCount, Scale:1, Displacement:-1,))
			riscv64EmitAddress(out, riscv64CopyDestination, record_address(Base:riscv64CopyDestination, Index:riscv64CopyCount, Scale:1, Displacement:-1,))
			out.Mark(backwardLoop)
			riscv64Compare(out, riscv64CopyCount, riscv64ZERO)
			riscv64JumpCondition(out, riscv64EQ, done)
			riscv64LoadU8(out, riscv64Scratch, record_address(Base:riscv64CopySource,))
			riscv64StoreU8(out, record_address(Base:riscv64CopyDestination,), riscv64Scratch)
			riscv64Decrement(out, riscv64CopySource)
			riscv64Decrement(out, riscv64CopyDestination)
			riscv64Decrement(out, riscv64CopyCount)
			riscv64Jump(out, backwardLoop)
			out.Mark(forward)
			out.Mark(forwardLoop)
			riscv64Compare(out, riscv64CopyCount, riscv64ZERO)
			riscv64JumpCondition(out, riscv64EQ, done)
			riscv64LoadU8(out, riscv64Scratch, record_address(Base:riscv64CopySource,))
			riscv64StoreU8(out, record_address(Base:riscv64CopyDestination,), riscv64Scratch)
			riscv64Increment(out, riscv64CopySource)
			riscv64Increment(out, riscv64CopyDestination)
			riscv64Decrement(out, riscv64CopyCount)
			riscv64Jump(out, forwardLoop)
			out.Mark(done)
		}
	}
}
abi riscv64_internal {
	unsigned_divide = go riscv64UnsignedDivide
	arch = riscv64
	arguments = [a0, a1, a2, a3, a4, a5]
	call_words = [a0, a1, a2, a3, a4, a5]
	result = [a0, a1]
	stack_alignment = 16
	return_address = link
	frame_pointer = frame
	frame_start = go riscv64FrameStart
	frame_finish = go riscv64FrameFinish
	frame_load = go riscv64FrameLoad
	frame_store = go riscv64FrameStore
	frame_address = go riscv64FrameAddress
}
runtime linux_riscv64 {
	managed_heap_abi = 1
	managed_word_bits = 64
	managed_source = go managedSource
	managed_startup = go managedStartup
	managed_boundary = go managedBoundary
	syscall {
		number = a7
		arguments = [a0, a1, a2, a3, a4, a5]
		result = a0
	}

	emit_entry = go targetEntry
	emit_exit = go targetExit
	operation write {
		emit = go targetWrite
	}
	operation read {
		emit = go targetRead
	}
	operation open {
		emit = go targetOpen
	}
	operation close {
		emit = go targetClose
	}
	operation chmod {
		emit = go targetChmod
	}
	operation print {
		use = write args = [stdout, buffer, count]
	}
}
format elf_riscv64 {
	kind = elf
	byte_order = little
	address_bits = 64
	code_offset = 0
	image = go targetImage
}
target experimental/linux-riscv64 {
	family = native_v1
	os = linux
	arch = riscv64
	abi = riscv64_internal
	runtime = linux_riscv64
	executable = elf_riscv64
	arena_default = 16777216
	build_tags = [linux, unix, riscv64]
	capabilities = [hosted, executable, filesystem, heap]
}

# Shared managed collector and Linux services embedded for standalone use.
go backend {
	func managedHeap64Source() string { return managedHeapSource(8) }
	func managedHeap32Source() string { return managedHeapSource(4) }

	// Headers keep their aligned layout; payload/root scanning follows native words.
	func managedHeapSource(wordBytes int) string {
		constants := "const __renvoManagedWordBytes = uintptr(8)\nconst __renvoManagedMax = uintptr(9223372036854775807)\n"
		if wordBytes == 4 {
			constants = "const __renvoManagedWordBytes = uintptr(4)\nconst __renvoManagedMax = uintptr(2147483647)\n"
		}
		return constants + `
					// Desktop heap runtime, parsed and compiled with the application. No helper
					// below allocates through make/new/append or calls application code.
					var __renvoManagedState [16]uintptr

					func __renvoManagedRead(p uintptr) uintptr { return *(*uintptr)(p) }
					func __renvoManagedWrite(p uintptr, v uintptr) { *(*uintptr)(p) = v }
					func __renvoManagedByte(p uintptr) byte { return *(*byte)(p) }

					func __renvoManagedLimit(p uintptr) uintptr {
						var value uintptr
						var digits int
						for __renvoManagedByte(p) >= '0' && __renvoManagedByte(p) <= '9' {
							digit := uintptr(__renvoManagedByte(p)-'0')
							if value > (__renvoManagedMax-digit)/10 { return 0 }
							value = value*10+digit
							p++
							digits++
						}
						if digits == 0 || value == 0 { return 0 }
						var shift uintptr
						if __renvoManagedByte(p) != 0 {
							c := __renvoManagedByte(p)
							if c == 'K' { shift = 10 } else if c == 'M' { shift = 20 } else if c == 'G' { shift = 30 } else if c == 'T' { shift = 40 } else { return 0 }
							if __renvoManagedByte(p+1) != 'i' || __renvoManagedByte(p+2) != 'B' || __renvoManagedByte(p+3) != 0 { return 0 }
						}
						if value > __renvoManagedMax>>shift { return 0 }
						return value << shift
					}

					func __renvoManagedInit(limit uintptr, stack uintptr, globals uintptr, end uintptr) {
						if limit == 0 { limit = __renvoManagedMax }
						override := __renvoManagedEnvironment(stack)
						if override != 0 {
							limit = __renvoManagedLimit(override)
							if limit == 0 { __renvoManagedFatal("renvo: invalid RENVO_HEAP_LIMIT\n") }
						}
						// State and the common allocator's 32-byte compatibility bookkeeping.
						if limit < 160 { __renvoManagedFatal("panic: out of memory\n") }
						__renvoManagedState[1] = limit
						__renvoManagedState[2] = 160
						__renvoManagedState[3] = stack
						__renvoManagedState[6] = globals
						__renvoManagedState[7] = end
						__renvoManagedState[8] = 65536
					}

					// Segment header: next, mapping size, payload offset, reserved word; then one
					// block-header index per mapped page. All of this resides in charged mappings.
					func __renvoManagedHeader(size uintptr) uintptr { return (32+(size/__renvoManagedPageSize)*8+15)&^uintptr(15) }
					func __renvoManagedIndex(s uintptr, b uintptr, span uintptr) {
						first := (b-s+(__renvoManagedPageSize-1))/__renvoManagedPageSize
						end := (b-s+span+(__renvoManagedPageSize-1))/__renvoManagedPageSize
						for page := first; page < end; page++ { __renvoManagedWrite(s+32+page*8, b) }
					}
					func __renvoManagedFind(pointer uintptr) uintptr {
						for s := __renvoManagedState[0]; s != 0; s = __renvoManagedRead(s) {
							size := __renvoManagedRead(s+8)
							if pointer < s+__renvoManagedRead(s+16)+16 || pointer-s >= size { continue }
							b := __renvoManagedRead(s+32+((pointer-s)/__renvoManagedPageSize)*8)
							for b < s+size {
								span := __renvoManagedRead(b)
								if pointer < b+span {
									if pointer >= b+16 && __renvoManagedRead(b+8)&1 != 0 { return b }
									return 0
								}
								b += span
							}
						}
						return 0
					}
					func __renvoManagedMark(pointer uintptr) {
						b := __renvoManagedFind(pointer)
						if b != 0 && __renvoManagedRead(b+8)&2 == 0 {
							// Block headers are 16-byte aligned. During marking the upper bits
							// hold the next work item; low bits retain allocated/marked flags.
							__renvoManagedWrite(b+8, __renvoManagedState[9]|3)
							__renvoManagedState[9] = b
						}
					}
					func __renvoManagedScan(start uintptr, end uintptr) {
						for p := start; p < end; p += __renvoManagedWordBytes { __renvoManagedMark(__renvoManagedRead(p)) }
					}
					func __renvoManagedCollect(roots uintptr) {
						__renvoManagedState[4] = 0
						__renvoManagedState[5] = 0
						__renvoManagedState[9] = 0
						__renvoManagedRoots(roots)
						state := uintptr(&__renvoManagedState[0])
						__renvoManagedScan(__renvoManagedState[6], state)
						__renvoManagedScan(state+16*__renvoManagedWordBytes, __renvoManagedState[7])
						for __renvoManagedState[9] != 0 {
							b := __renvoManagedState[9]
							__renvoManagedState[9] = __renvoManagedRead(b+8)&^uintptr(15)
							__renvoManagedWrite(b+8, 3)
							__renvoManagedScan(b+16, b+__renvoManagedRead(b))
						}
						var previous uintptr
						var live uintptr
						for s := __renvoManagedState[0]; s != 0; {
							size := __renvoManagedRead(s+8)
							var free uintptr
							used := false
							for b := s+__renvoManagedRead(s+16); b < s+size; {
								span := __renvoManagedRead(b)
								if __renvoManagedRead(b+8)&2 != 0 {
									__renvoManagedWrite(b+8, 1)
									free = 0
									used = true
									live += span
								} else {
									__renvoManagedWrite(b+8, 0)
									if free != 0 { __renvoManagedWrite(free, __renvoManagedRead(free)+span) } else { free = b }
								}
								b += span
							}
							next := __renvoManagedRead(s)
							if !used {
								if previous == 0 { __renvoManagedState[0] = next } else { __renvoManagedWrite(previous, next) }
								if !__renvoManagedRelease(s, size) { __renvoManagedFatal("renvo: managed heap release failed\n") }
								__renvoManagedState[2] -= size
							} else {
								previous = s
								__renvoManagedWrite(s+32, s+__renvoManagedRead(s+16))
								for b := s+__renvoManagedRead(s+16); b < s+size; b += __renvoManagedRead(b) {
									__renvoManagedIndex(s, b, __renvoManagedRead(b))
								}
							}
							s = next
						}
						__renvoManagedState[10]++
						__renvoManagedState[12] = live
					}
					func __renvoManagedClaim(s uintptr, b uintptr, span uintptr) uintptr {
						available := __renvoManagedRead(b)
						__renvoManagedState[4] = 0
						if available-span >= 32 {
							__renvoManagedWrite(b+span, available-span)
							__renvoManagedWrite(b+span+8, 0)
							__renvoManagedWrite(b, span)
							__renvoManagedState[4] = b+span
							__renvoManagedState[5] = s
							available = span
						}
						// Only occupied pages need a fresh index. An older free-page index is
						// still a valid earlier block; lookup walks forward until sweep rebuilds it.
						__renvoManagedIndex(s, b, available)
						__renvoManagedWrite(b+8, 1)
						for p := b+16; p < b+available; p += __renvoManagedWordBytes { __renvoManagedWrite(p, 0) }
						return b+16
					}
					func __renvoManagedTake(span uintptr) uintptr {
						b := __renvoManagedState[4]
						if b != 0 && __renvoManagedRead(b) >= span {
							return __renvoManagedClaim(__renvoManagedState[5], b, span)
						}
						for s := __renvoManagedState[0]; s != 0; s = __renvoManagedRead(s) {
							end := s+__renvoManagedRead(s+8)
							for b := s+__renvoManagedRead(s+16); b < end; b += __renvoManagedRead(b) {
								if __renvoManagedRead(b+8) == 0 && __renvoManagedRead(b) >= span {
									return __renvoManagedClaim(s, b, span)
								}
							}
						}
						return 0
					}
					func __renvoManagedRequest(size uintptr, roots uintptr) uintptr {
						if size > __renvoManagedMax-(__renvoManagedPageSize+31) { return 0 }
						if size == 0 { size = 16 }
						span := ((size+15)&^uintptr(15))+16
						result := __renvoManagedTake(span)
						if result != 0 { return result }
						if __renvoManagedState[0] != 0 {
							__renvoManagedCollect(roots)
							result = __renvoManagedTake(span)
							if result != 0 { return result }
						}
						minimum := (span+48+(__renvoManagedPageSize-1))&^uintptr((__renvoManagedPageSize-1))
						for minimum-__renvoManagedHeader(minimum) < span {
							minimum = (span+__renvoManagedHeader(minimum)+(__renvoManagedPageSize-1))&^uintptr((__renvoManagedPageSize-1))
						}
						available := (__renvoManagedState[1]-__renvoManagedState[2])&^uintptr((__renvoManagedPageSize-1))
						if minimum > available { return 0 }
						growth := __renvoManagedState[8]
						if growth < minimum { growth = minimum }
						if growth > available { growth = available }
						mapping := __renvoManagedMap(growth)
						if mapping == 0 && growth != minimum {
							growth = minimum
							mapping = __renvoManagedMap(growth)
						}
						if mapping == 0 { return 0 }
						base := uintptr(mapping)
						__renvoManagedWrite(base, __renvoManagedState[0])
						__renvoManagedWrite(base+8, growth)
						header := __renvoManagedHeader(growth)
						__renvoManagedWrite(base+16, header)
						for page := uintptr(0); page < growth/__renvoManagedPageSize; page++ { __renvoManagedWrite(base+32+page*8, base+header) }
						__renvoManagedWrite(base+header, growth-header)
						__renvoManagedState[4] = base+header
						__renvoManagedState[5] = base
						__renvoManagedState[0] = base
						__renvoManagedState[2] += growth
						if growth < __renvoManagedMax/2 { __renvoManagedState[8] = growth*2 }
						return __renvoManagedTake(span)
					}
					func __renvoManagedCollectBoundary(ignored uintptr, roots uintptr) uintptr {
						__renvoManagedCollect(roots)
						return 0
					}
					`
	}
}

go backend {
	func linuxManagedSource() string {
		return `
					//renvo:intrinsic renvo_runtime_Syscall
					func __renvoManagedSyscall(n int, a uintptr, b uintptr, c uintptr, d uintptr, e int, f uintptr) int { return -1 }
					
					func __renvoManagedMap(size uintptr) uintptr {
					 p := __renvoManagedSyscall(__renvoManagedMapNumber, 0, size, 3, __renvoManagedMapFlags, -1, 0)
					 if uintptr(p) >= ^uintptr(4094) { return 0 }; return uintptr(p)
					}
					func __renvoManagedRelease(base uintptr, size uintptr) bool { return __renvoManagedSyscall(__renvoManagedReleaseNumber, base, size, 0, 0, 0, 0) == 0 }
					func __renvoManagedFatal(message string) { print(message); __renvoManagedSyscall(__renvoManagedExitNumber, 2, 0, 0, 0, 0, 0) }
					func __renvoManagedEnvironment(stack uintptr) uintptr {
					 // Linux initial process stack: argc, argv[], null, envp[], null.
					 p := stack + 2*__renvoManagedWordBytes + __renvoManagedRead(stack)*__renvoManagedWordBytes
					 for __renvoManagedRead(p) != 0 {
					  entry := __renvoManagedRead(p)
					  matched := true
					  prefix := "RENVO_HEAP_LIMIT="
					  for i := 0; i < len(prefix); i++ {
					   if __renvoManagedByte(entry+uintptr(i)) != prefix[i] { matched = false; break }
					  }
					  if matched { return entry+17 }
					  p += __renvoManagedWordBytes
					 }
					 return 0
					}
					func __renvoManagedRoots(roots uintptr) {
					 if roots > __renvoManagedState[3] { __renvoManagedFatal("renvo: unsupported managed stack\n") }
					 __renvoManagedScan(roots, __renvoManagedState[3])
					}
					`
	}
}

go backend {
	func managedSource() string {
		return managedHeap64Source() + linuxManagedSource() + `
	const __renvoManagedPageSize = uintptr(4096)
	const __renvoManagedMapNumber = 222
	const __renvoManagedReleaseNumber = 215
	const __renvoManagedExitNumber = 93
	const __renvoManagedMapFlags = uintptr(34)
	`
	}
	func managedStartup(out *RTGEmitter, limit int, label int) {
		riscv64MoveImmediate(out, RTGRegister{Code: 13, Valid: true}, int64(limit))
		riscv64Move(out, RTGRegister{Code: 12, Valid: true}, riscv64FRAME)
		managedBSS(out, RTGRegister{Code: 11, Valid: true}, 0)
		managedBSS(out, RTGRegister{Code: 10, Valid: true}, out.BSSSize())
		managedCall(out, label)
	}
	func managedBSS(out *RTGEmitter, dest RTGRegister, offset int) {
		at := out.Len()
		riscv64EncodeU(out, 0x17, dest, 0)
		riscv64EncodeI(out, 0x13, 0, dest, dest, 0)
		out.AbsoluteReloc(at, offset, RTGRelocationAbsoluteBSS)
	}
	func managedBoundary(out *RTGEmitter, label int) {
		riscv64EncodeI(out, 0x13, 0, riscv64STACK, riscv64STACK, -256)
		for reg := 1; reg < 32; reg++ {
			if reg != 2 {
				riscv64StoreNative(out, RTGAddress{Base: riscv64STACK, Displacement: reg * 8}, RTGRegister{Code: reg, Valid: true})
			}
		}
		riscv64Move(out, RTGRegister{Code: 11, Valid: true}, riscv64Primary)
		riscv64Move(out, riscv64Primary, riscv64STACK)
		managedCall(out, label)
		for reg := 1; reg < 32; reg++ {
			if reg != 2 && reg != 10 {
				riscv64LoadNative(out, RTGRegister{Code: reg, Valid: true}, RTGAddress{Base: riscv64STACK, Displacement: reg * 8})
			}
		}
		riscv64EncodeI(out, 0x13, 0, riscv64STACK, riscv64STACK, 256)
	}
}

go backend {
	func managedCall(out *RTGEmitter, label int) {
		at := out.Len()
		riscv64EncodeU(out, 0x17, riscv64LINK, 0)
		out.RelocAt(at, label)
		riscv64EncodeI(out, 0x67, 0, riscv64LINK, riscv64LINK, 0)
	}
}
