@import "../../backend/definitions/riscv32.rtg"

# RV32 direct-load support shared by emulator targets with the full integer
# register file (ESP32-C6 and RP2350 Hazard3).
go backend {
	const testUART = 0xffff0100
	const testExit = 0xfffffff0

	func entry(out *RTGEmitter, stackTop int) bool {
		riscv32.moveImmediate(out, riscv32.stack, int64(stackTop))
		riscv32.move(out, riscv32.frame, riscv32.stack)
		return true
	}

	func write(out *RTGEmitter) {
		loop := out.NewLabel()
		done := out.NewLabel()
		riscv32.move(out, riscv32.copySource, riscv32.secondary)
		riscv32.move(out, riscv32.copyCount, riscv32.tertiary)
		out.Mark(loop)
		riscv32.compare(out, riscv32.copyCount, riscv32.zero)
		riscv32.jumpCondition(out, riscv32.eq, done)
		riscv32.loadU8(out, riscv32.scratch,
			RTGAddress{Base: riscv32.copySource})
		riscv32.storeU8(out, RTGAddress{Displacement: testUART},
			riscv32.scratch)
		riscv32.increment(out, riscv32.copySource)
		riscv32.decrement(out, riscv32.copyCount)
		riscv32.jump(out, loop)
		out.Mark(done)
		riscv32.move(out, riscv32.primary, riscv32.zero)
	}

	func exit(out *RTGEmitter, status RTGRegister) {
		riscv32.storeU32(out, RTGAddress{Displacement: testExit}, status)
		loop := out.NewLabel()
		out.Mark(loop)
		riscv32.jump(out, loop)
	}

	func patchAbsolute(out *RTGEmitter, dataAddress int) {
		bssAddress := RTGAlignValue(dataAddress+len(out.Data()), 8)
		for index := 0; index < out.AbsoluteRelocationCount(); index++ {
			at := out.AbsoluteRelocationOffset(index)
			target, resolved := RTGResolveAbsoluteRelocation(out,
				out.AbsoluteRelocationKind(index),
				out.AbsoluteRelocationAddend(index),
				dataAddress, bssAddress)
			if !resolved {
				continue
			}
			instruction := RTGGet32At(out.Code(), at)
			register := (instruction >> 7) & 31
			hi := (target + 0x800) >> 12
			lo := target - (hi << 12)
			out.PatchUint32(at, 0x37|(register<<7)|(hi<<12))
			out.PatchUint32(at+4,
				0x13|(register<<7)|(register<<15)|((lo&0xfff)<<20))
		}
	}
}
