# SPDX-License-Identifier: Apache-2.0
# Self-contained Linux backend. Copy this file to use or extend this target.
definition 1
unit linux_mips64el
implements direct_emitter_v1
go backend {
	var mips64MipsRelocationBase int
	var mips64MipsBigEndian bool

	func mips64MipsSetTargetCodeAddress(address int) {
		mips64MipsRelocationBase = address
	}
	func mips64MipsSetBigEndian(value bool) { mips64MipsBigEndian = value }

	func mips64MipsGetInstruction(out *RTGEmitter, at int) int {
		if !mips64MipsBigEndian {
			return RTGGet32At(out.Code(), at)
		}
		code := out.Code()
		return int(code[at])<<24 | int(code[at+1])<<16 | int(code[at+2])<<8 | int(code[at+3])
	}

	func mips64MipsPatchInstruction(out *RTGEmitter, at int, value int) {
		if !mips64MipsBigEndian {
			out.PatchUint32(at, value)
			return
		}
		code := out.Code()
		code[at] = byte(value >> 24)
		code[at+1] = byte(value >> 16)
		code[at+2] = byte(value >> 8)
		code[at+3] = byte(value)
	}

	func mips64MipsEmit(out *RTGEmitter, instruction int) {
		if !mips64MipsBigEndian {
			RTGUint32(out, instruction)
			return
		}
		RTGByte(out, byte(instruction>>24))
		RTGByte(out, byte(instruction>>16))
		RTGByte(out, byte(instruction>>8))
		RTGByte(out, byte(instruction))
	}

	func mips64MipsR(out *RTGEmitter, opcode int, source int, target int,
		destination int, shift int, function int) {
		mips64MipsEmit(out, (opcode<<26)|(source<<21)|(target<<16)|
			(destination<<11)|(shift<<6)|function)
	}

	func mips64MipsI(out *RTGEmitter, opcode int, source int, target int,
		immediate int) {
		mips64MipsEmit(out, (opcode<<26)|(source<<21)|(target<<16)|(immediate&0xffff))
	}

	func mips64MipsMove(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		if destination.Code != source.Code {
			mips64MipsR(out, 0, source.Code, 0, destination.Code, 0, 0x2d)
		}
	}

	func mips64MipsMoveImmediate(out *RTGEmitter, destination RTGRegister, value int64) {
		if value >= -32768 && value <= 32767 {
			mips64MipsI(out, 0x19, 0, destination.Code, int(value))
			return
		}
		mips64MipsI(out, 0x0d, 0, destination.Code, int(uint64(value)>>48))
		for shift := 32; shift >= 0; shift -= 16 {
			mips64MipsR(out, 0, 0, destination.Code, destination.Code, 16, 0x38)
			mips64MipsI(out, 0x0d, destination.Code, destination.Code, int(uint64(value)>>uint(shift)))
		}
	}

	func mips64MipsEmitAddress(out *RTGEmitter, destination RTGRegister,
		value RTGAddress) {
		if RTGAddressValid(value) {
			at := out.Len()
			mips64MipsI(out, 0x0f, 0, destination.Code, 0)
			mips64MipsI(out, 0x0d, destination.Code, destination.Code, 0)
			RTGAddressRelocAt(out, value, at)
			return
		}
		base := value.Base
		if !base.Valid {
			base = mips64MipsZero()
		}
		if value.Index.Valid {
			shift := RTGLog2(value.Scale)
			mips64MipsR(out, 0, 0, value.Index.Code, mips64MipsAddress().Code, shift, 0)
			mips64MipsR(out, 0, base.Code, mips64MipsAddress().Code,
				destination.Code, 0, 0x2d)
			base = destination
		}
		if value.Displacement >= -32768 && value.Displacement <= 32767 {
			mips64MipsI(out, 0x19, base.Code, destination.Code, value.Displacement)
			return
		}
		temporary := mips64MipsAddress()
		if destination.Code == temporary.Code || base.Code == temporary.Code {
			temporary = mips64MipsScratch()
		}
		mips64MipsMoveImmediate(out, temporary, int64(value.Displacement))
		mips64MipsR(out, 0, base.Code, temporary.Code, destination.Code, 0, 0x2d)
	}

	func mips64MipsMaterializeAddress(out *RTGEmitter, value RTGAddress) RTGAddress {
		if !RTGAddressValid(value) && !value.Index.Valid &&
			value.Displacement >= -32768 && value.Displacement <= 32767 {
			return value
		}
		mips64MipsEmitAddress(out, mips64MipsAddress(), value)
		return RTGAddress{Base: mips64MipsAddress()}
	}

	func mips64MipsLoadWidth(out *RTGEmitter, destination RTGRegister,
		value RTGAddress, opcode int) {
		value = mips64MipsMaterializeAddress(out, value)
		base := value.Base
		if !base.Valid {
			base = mips64MipsZero()
		}
		mips64MipsI(out, opcode, base.Code, destination.Code, value.Displacement)
		// MIPS I exposes a one-instruction load delay. Keeping a harmless slot
		// here makes the shared emitter correct on the R3000A while remaining
		// valid on Allegrex, whose interlocks make the slot unnecessary.
		mips64MipsEmit(out, 0)
	}

	func mips64MipsStoreWidth(out *RTGEmitter, value RTGAddress,
		source RTGRegister, opcode int) {
		value = mips64MipsMaterializeAddress(out, value)
		base := value.Base
		if !base.Valid {
			base = mips64MipsZero()
		}
		mips64MipsI(out, opcode, base.Code, source.Code, value.Displacement)
	}

	func mips64MipsLoadNative(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		mips64MipsLoadWidth(out, destination, value, 0x37)
	}
	func mips64MipsLoadI32(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		mips64MipsLoadWidth(out, destination, value, 0x23)
	}
	func mips64MipsLoadU32(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		mips64MipsLoadWidth(out, destination, value, 0x27)
	}
	func mips64MipsLoadI16(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		mips64MipsLoadWidth(out, destination, value, 0x21)
	}
	func mips64MipsLoadU16(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		mips64MipsLoadWidth(out, destination, value, 0x25)
	}
	func mips64MipsLoadI8(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		mips64MipsLoadWidth(out, destination, value, 0x20)
	}
	func mips64MipsLoadU8(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		mips64MipsLoadWidth(out, destination, value, 0x24)
	}
	func mips64MipsStoreNative(out *RTGEmitter, value RTGAddress, source RTGRegister) {
		mips64MipsStoreWidth(out, value, source, 0x3f)
	}
	func mips64MipsStoreU32(out *RTGEmitter, value RTGAddress, source RTGRegister) {
		mips64MipsStoreWidth(out, value, source, 0x2b)
	}
	func mips64MipsStoreU16(out *RTGEmitter, value RTGAddress, source RTGRegister) {
		mips64MipsStoreWidth(out, value, source, 0x29)
	}
	func mips64MipsStoreU8(out *RTGEmitter, value RTGAddress, source RTGRegister) {
		mips64MipsStoreWidth(out, value, source, 0x28)
	}

	func mips64MipsAdd(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		mips64MipsR(out, 0, destination.Code, source.Code, destination.Code, 0, 0x2d)
	}
	func mips64MipsSubtract(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		mips64MipsR(out, 0, destination.Code, source.Code, destination.Code, 0, 0x2f)
	}
	func mips64MipsMultiply(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		// MIPS I predates the MIPS32 SPECIAL2 three-operand MUL encoding.
		// Use the R3000A/Allegrex HI/LO sequence instead.
		mips64MipsR(out, 0, destination.Code, source.Code, 0, 0, 0x1c)
		mips64MipsR(out, 0, 0, 0, destination.Code, 0, 0x12)
	}
	func mips64MipsBitAnd(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		mips64MipsR(out, 0, destination.Code, source.Code, destination.Code, 0, 0x24)
	}
	func mips64MipsBitOr(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		mips64MipsR(out, 0, destination.Code, source.Code, destination.Code, 0, 0x25)
	}
	func mips64MipsBitXor(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		mips64MipsR(out, 0, destination.Code, source.Code, destination.Code, 0, 0x26)
	}

	func mips64MipsCompare(out *RTGEmitter, left RTGRegister, right RTGRegister) {
		mips64MipsMove(out, mips64MipsCompareLeft(), left)
		mips64MipsMove(out, mips64MipsCompareRight(), right)
	}
	func mips64MipsTest(out *RTGEmitter, left RTGRegister, right RTGRegister) {
		mips64MipsMove(out, mips64MipsCompareLeft(), left)
		mips64MipsBitAnd(out, mips64MipsCompareLeft(), right)
		mips64MipsMove(out, mips64MipsCompareRight(), mips64MipsZero())
	}
	func mips64MipsIncrement(out *RTGEmitter, operand RTGRegister) {
		mips64MipsI(out, 0x19, operand.Code, operand.Code, 1)
	}
	func mips64MipsDecrement(out *RTGEmitter, operand RTGRegister) {
		mips64MipsI(out, 0x19, operand.Code, operand.Code, -1)
	}
	func mips64MipsShiftLeftImmediate(out *RTGEmitter, operand RTGRegister, value byte) {
		function := 56
		if value&32 != 0 {
			function += 4
		}
		mips64MipsR(out, 0, 0, operand.Code, operand.Code, int(value)&31, function)
	}

	func mips64MipsShiftRightUnsignedImmediate(out *RTGEmitter, operand RTGRegister, value byte) {
		function := 58
		if value&32 != 0 {
			function += 4
		}
		mips64MipsR(out, 0, 0, operand.Code, operand.Code, int(value)&31, function)
	}

	func mips64MipsShiftRightSignedImmediate(out *RTGEmitter, operand RTGRegister, value byte) {
		function := 59
		if value&32 != 0 {
			function += 4
		}
		mips64MipsR(out, 0, 0, operand.Code, operand.Code, int(value)&31, function)
	}

	func mips64MipsCall(out *RTGEmitter, label RTGLabel) {
		mips64MipsEmit(out, 0x0c000000)
		out.Reloc(label)
		mips64MipsEmit(out, 0)
	}
	func mips64MipsCallIndirect(out *RTGEmitter, operand RTGRegister) {
		mips64MipsR(out, 0, operand.Code, 0, 31, 0, 9)
		mips64MipsEmit(out, 0)
	}
	func mips64MipsJump(out *RTGEmitter, label RTGLabel) {
		mips64MipsEmit(out, 0x08000000)
		out.Reloc(label)
		mips64MipsEmit(out, 0)
	}

	func mips64MipsSetCondition(out *RTGEmitter, condition RTGCondition,
		destination RTGRegister) {
		code := condition.Code
		left := mips64MipsCompareLeft()
		right := mips64MipsCompareRight()
		if code == 0 || code == 1 {
			mips64MipsR(out, 0, left.Code, right.Code, destination.Code, 0, 0x26)
			if code == 0 {
				mips64MipsI(out, 0x0b, destination.Code, destination.Code, 1)
			} else {
				mips64MipsR(out, 0, 0, destination.Code, destination.Code, 0, 0x2b)
			}
			return
		}
		unsigned := code >= 6
		invert := false
		if code == 2 || code == 3 || code == 8 || code == 9 {
			left, right = right, left
			if code == 2 || code == 8 {
				invert = true
			}
		} else {
			if code == 5 || code == 7 {
				invert = true
			}
		}
		function := 0x2a
		if unsigned {
			function = 0x2b
		}
		mips64MipsR(out, 0, left.Code, right.Code, destination.Code, 0, function)
		if invert {
			mips64MipsI(out, 0x0e, destination.Code, destination.Code, 1)
		}
	}

	func mips64MipsJumpCondition(out *RTGEmitter, condition RTGCondition, label RTGLabel) {
		mips64MipsSetCondition(out, condition, mips64MipsScratch())
		// Skip J/NOP when the requested condition is false.
		mips64MipsI(out, 4, mips64MipsScratch().Code, 0, 3)
		mips64MipsEmit(out, 0)
		mips64MipsEmit(out, 0x08000000)
		out.Reloc(label)
		mips64MipsEmit(out, 0)
	}

	func mips64MipsReturn(out *RTGEmitter) {
		mips64MipsR(out, 0, 31, 0, 0, 0, 8)
		mips64MipsEmit(out, 0)
	}
	func mips64MipsLeave(out *RTGEmitter) {
		mips64MipsLoadWidth(out, mips64MipsLink(), RTGAddress{Base: mips64MipsFrame(), Displacement: -8}, 0x37)
		mips64MipsLoadWidth(out, mips64MipsScratch(), RTGAddress{Base: mips64MipsFrame(), Displacement: -16}, 0x37)
		mips64MipsMove(out, mips64MipsStack(), mips64MipsFrame())
		mips64MipsMove(out, mips64MipsFrame(), mips64MipsScratch())
	}
	func mips64MipsHostSyscall(out *RTGEmitter) { mips64MipsEmit(out, 0x0000000c) }
	func mips64MipsVariableShift(out *RTGEmitter, direction RTGShiftDirection, signed bool) {
		function := 0x14
		if direction == RTGShiftRight {
			function = 0x16
			if signed {
				function = 0x17
			}
		}
		mips64MipsR(out, 0, mips64MipsPrimary().Code, mips64MipsTertiary().Code,
			mips64MipsPrimary().Code, 0, function)
	}
	func mips64MipsUnsignedDivide(out *RTGEmitter, remainder bool) bool {
		mips64MipsR(out, 0, mips64MipsTertiary().Code, mips64MipsPrimary().Code, 0, 0, 0x1f)
		function := 0x12
		if remainder {
			function = 0x10
		}
		mips64MipsR(out, 0, 0, 0, mips64MipsPrimary().Code, 0, function)
		return true
	}
	func mips64MipsSignedDivide(out *RTGEmitter, remainder bool) {
		mips64MipsR(out, 0, mips64MipsTertiary().Code, mips64MipsPrimary().Code, 0, 0, 0x1e)
		function := 0x12
		if remainder {
			function = 0x10
		}
		mips64MipsR(out, 0, 0, 0, mips64MipsPrimary().Code, 0, function)
	}

	func mips64MipsPatchRelocations(out *RTGEmitter) {
		for index := 0; index < out.RelocationCount(); index++ {
			at := out.RelocationOffset(index)
			target := mips64MipsRelocationBase + out.LabelPosition(out.RelocationLabel(index))
			instruction := mips64MipsGetInstruction(out, at)
			opcode := instruction >> 26
			if opcode == 2 || opcode == 3 {
				mips64MipsPatchInstruction(out, at, (instruction&0xfc000000)|((target>>2)&0x03ffffff))
			} else {
				if opcode == 0x0f {
					register := (instruction >> 16) & 31
					mips64MipsPatchInstruction(out, at, (0x0f<<26)|(register<<16)|((target>>16)&0xffff))
					mips64MipsPatchInstruction(out, at+4, (0x0d<<26)|(register<<21)|(register<<16)|(target&0xffff))
				}
			}
		}
	}

	func mips64MipsFrameStart(out *RTGEmitter) int {
		mips64MipsMove(out, mips64MipsAddress(), mips64MipsFrame())
		at := out.Len()
		mips64MipsI(out, 0x0f, 0, mips64MipsScratch().Code, 0)
		mips64MipsI(out, 0x0d, mips64MipsScratch().Code, mips64MipsScratch().Code, 0)
		mips64MipsSubtract(out, mips64MipsStack(), mips64MipsScratch())
		mips64MipsMove(out, mips64MipsFrame(), mips64MipsStack())
		mips64MipsAdd(out, mips64MipsFrame(), mips64MipsScratch())
		mips64MipsStoreWidth(out, RTGAddress{Base: mips64MipsFrame(), Displacement: -8}, mips64MipsLink(), 0x3f)
		mips64MipsStoreWidth(out, RTGAddress{Base: mips64MipsFrame(), Displacement: -16}, mips64MipsAddress(), 0x3f)
		return at
	}
	func mips64MipsFrameFinish(out *RTGEmitter, at int, stackUsed int) {
		frameSize := (stackUsed + 31) & -16
		mips64MipsPatchInstruction(out, at, (0x0f<<26)|(mips64MipsScratch().Code<<16)|((frameSize>>16)&0xffff))
		mips64MipsPatchInstruction(out, at+4, (0x0d<<26)|(mips64MipsScratch().Code<<21)|
			(mips64MipsScratch().Code<<16)|(frameSize&0xffff))
	}
	func mips64MipsFrameLoad(out *RTGEmitter, destination RTGRegister, offset int) {
		mips64MipsLoadWidth(out, destination, RTGAddress{Base: mips64MipsFrame(), Displacement: -(offset + 16)}, 0x37)
	}
	func mips64MipsFrameStore(out *RTGEmitter, offset int, source RTGRegister) {
		mips64MipsStoreWidth(out, RTGAddress{Base: mips64MipsFrame(), Displacement: -(offset + 16)}, source, 0x3f)
	}
	func mips64MipsFrameAddress(out *RTGEmitter, destination RTGRegister, offset int) {
		mips64MipsEmitAddress(out, destination, RTGAddress{Base: mips64MipsFrame(), Displacement: -(offset + 16)})
	}

	func mips64MipsZero() RTGRegister    { return RTGRegister{Code: 0, Valid: true} }
	func mips64MipsPrimary() RTGRegister { return RTGRegister{Code: 2, Valid: true} }

	func mips64MipsTertiary() RTGRegister     { return RTGRegister{Code: 4, Valid: true} }
	func mips64MipsScratch() RTGRegister      { return RTGRegister{Code: 8, Valid: true} }
	func mips64MipsAddress() RTGRegister      { return RTGRegister{Code: 9, Valid: true} }
	func mips64MipsCompareLeft() RTGRegister  { return RTGRegister{Code: 10, Valid: true} }
	func mips64MipsCompareRight() RTGRegister { return RTGRegister{Code: 11, Valid: true} }
	func mips64MipsStack() RTGRegister        { return RTGRegister{Code: 29, Valid: true} }
	func mips64MipsFrame() RTGRegister        { return RTGRegister{Code: 30, Valid: true} }
	func mips64MipsLink() RTGRegister         { return RTGRegister{Code: 31, Valid: true} }

	const elfCodeAddress = 0x11000

	func elfDataOffset(out *RTGEmitter) int  { return RTGAlignValue(0x1000+len(out.Code()), 0x10000) }
	func elfDataAddress(out *RTGEmitter) int { return 0x10000 + elfDataOffset(out) }
	func elfBssAddress(out *RTGEmitter) int {
		return RTGAlignValue(elfDataAddress(out)+len(out.Data()), 16)
	}
	func elfPut(image []byte, at int, value uint64, width int, big bool) {
		for i := 0; i < width; i++ {
			shift := i * 8
			if big {
				shift = (width - 1 - i) * 8
			}
			image[at+i] = byte(value >> uint(shift))
		}
	}
	func elfImage(out *RTGEmitter, machine int, flags int, bits int, big bool) []byte {
		offset := elfDataOffset(out)
		result := make([]byte, offset+len(out.Data()))
		result[0] = 0x7f
		result[1] = 'E'
		result[2] = 'L'
		result[3] = 'F'
		result[4] = 1
		if bits == 64 {
			result[4] = 2
		}
		result[5] = 1
		if big {
			result[5] = 2
		}
		result[6] = 1
		elfPut(result, 16, 2, 2, big)
		elfPut(result, 18, uint64(machine), 2, big)
		elfPut(result, 20, 1, 4, big)
		if bits == 32 {
			elfPut(result, 24, elfCodeAddress, 4, big)
			elfPut(result, 28, 52, 4, big)
			elfPut(result, 36, uint64(flags), 4, big)
			elfPut(result, 40, 52, 2, big)
			elfPut(result, 42, 32, 2, big)
			elfPut(result, 44, 2, 2, big)
		} else {
			elfPut(result, 24, elfCodeAddress, 8, big)
			elfPut(result, 32, 64, 8, big)
			elfPut(result, 48, uint64(flags), 4, big)
			elfPut(result, 52, 64, 2, big)
			elfPut(result, 54, 56, 2, big)
			elfPut(result, 56, 2, 2, big)
		}
		for i := 0; i < 2; i++ {
			file := 0
			address := 0x10000
			size := 0x1000 + len(out.Code())
			memory := size
			permissions := 5
			if i == 1 {
				file = offset
				address = elfDataAddress(out)
				size = len(out.Data())
				memory = elfBssAddress(out) - address + out.BSSSize()
				permissions = 6
			}
			if bits == 32 {
				at := 52 + i*32
				elfPut(result, at, 1, 4, big)
				elfPut(result, at+4, uint64(file), 4, big)
				elfPut(result, at+8, uint64(address), 4, big)
				elfPut(result, at+12, uint64(address), 4, big)
				elfPut(result, at+16, uint64(size), 4, big)
				elfPut(result, at+20, uint64(memory), 4, big)
				elfPut(result, at+24, uint64(permissions), 4, big)
				elfPut(result, at+28, 0x10000, 4, big)
			} else {
				at := 64 + i*56
				elfPut(result, at, 1, 4, big)
				elfPut(result, at+4, uint64(permissions), 4, big)
				elfPut(result, at+8, uint64(file), 8, big)
				elfPut(result, at+16, uint64(address), 8, big)
				elfPut(result, at+24, uint64(address), 8, big)
				elfPut(result, at+32, uint64(size), 8, big)
				elfPut(result, at+40, uint64(memory), 8, big)
				elfPut(result, at+48, 0x10000, 8, big)
			}
		}
		copy(result[0x1000:], out.Code())
		copy(result[offset:], out.Data())
		return result
	}

	func targetEntryStart(out *RTGEmitter, stateOffset int) bool {
		_ = stateOffset
		mips64MipsSetTargetCodeAddress(elfCodeAddress)
		mips64MipsSetBigEndian(false)
		return true
	}
	func targetEntry(out *RTGEmitter, count int, stateOffset int) bool {
		_ = out
		_ = stateOffset
		return count == 0
	}

	func targetImage(out *RTGEmitter) []byte {
		for i := 0; i < out.AbsoluteRelocationCount(); i++ {
			at := out.AbsoluteRelocationOffset(i)
			target, ok := RTGResolveAbsoluteRelocation(out, out.AbsoluteRelocationKind(i), out.AbsoluteRelocationAddend(i), elfDataAddress(out), elfBssAddress(out))
			if !ok {
				return nil
			}
			instruction := mips64MipsGetInstruction(out, at)
			register := (instruction >> 16) & 31
			mips64MipsPatchInstruction(out, at, (15<<26)|(register<<16)|((target>>16)&65535))
			mips64MipsPatchInstruction(out, at+4, (13<<26)|(register<<21)|(register<<16)|(target&65535))
		}
		return elfImage(out, 8, 0x20000000, 64, false)
	}
}

arch mips64el {
	alias = "mips64el"
	endian = little
	word_bits = 64
	pointer_bits = 64
	instruction_alignment = 4
	stack_word_bytes = 8
	stack_alignment = 16
	patch_relocations = go mips64MipsPatchRelocations
	registers integer = [zero, at, v0, v1, a0, a1, a2, a3, t0, t1, t2, t3, t4, t5, t6, t7, s0, s1, s2, s3, s4, s5, s6, s7, t8, t9, k0, k1, gp, stack, frame, link]
	locations {
		primary = v0
		secondary = v1
		tertiary = a0
		scratch = t0
		address = t1
		compareLeft = t2
		compareRight = t3
		copy_destination = a1
		copy_source = a2
		copy_count = a3
		stack = stack
		frame = frame
		link = link
	}
	conditions {
		eq = 0
		ne = 1
		sle = 2
		sgt = 3
		slt = 4
		sge = 5
		ult = 6
		uge = 7
		ule = 8
		ugt = 9
	}
	bind {
		move = go mips64MipsMove
		address = go mips64MipsEmitAddress
		load.native = go mips64MipsLoadNative
		load.i32 = go mips64MipsLoadI32
		load.u32 = go mips64MipsLoadU32
		load.i16 = go mips64MipsLoadI16
		load.u16 = go mips64MipsLoadU16
		load.i8 = go mips64MipsLoadI8
		load.u8 = go mips64MipsLoadU8
		store.native = go mips64MipsStoreNative
		store.u32 = go mips64MipsStoreU32
		store.u16 = go mips64MipsStoreU16
		store.u8 = go mips64MipsStoreU8
		add = go mips64MipsAdd
		subtract = go mips64MipsSubtract
		multiply = go mips64MipsMultiply
		bit_and = go mips64MipsBitAnd
		bit_or = go mips64MipsBitOr
		bit_xor = go mips64MipsBitXor
		compare = go mips64MipsCompare
		test = go mips64MipsTest
		increment = go mips64MipsIncrement
		decrement = go mips64MipsDecrement
		shift_left_immediate = go mips64MipsShiftLeftImmediate
		shift_right_unsigned_immediate = go mips64MipsShiftRightUnsignedImmediate
		shift_right_signed_immediate = go mips64MipsShiftRightSignedImmediate
		call = go mips64MipsCall
		call_indirect = go mips64MipsCallIndirect
		jump = go mips64MipsJump
		jump_condition = go mips64MipsJumpCondition
		set_condition = go mips64MipsSetCondition
		return = go mips64MipsReturn
		leave = go mips64MipsLeave
		host_syscall = go mips64MipsHostSyscall
		move_immediate = go mips64MipsMoveImmediate
		variable_shift = go mips64MipsVariableShift
		signed_divide = go mips64MipsSignedDivide
		copy_bytes = sequence mips64CopyBytes
	}
	sequences {
		mips64CopyBytes(out:emitter) {
			let forward = out.NewLabel()
			let backwardLoop = out.NewLabel()
			let forwardLoop = out.NewLabel()
			let done = out.NewLabel()
			mips64MipsCompare(out, mips64elA1, mips64elA2)
			mips64MipsJumpCondition(out, mips64elULT, forward)
			mips64MipsEmitAddress(out, mips64elT0, record_address(Base:mips64elA2, Index:mips64elA3, Scale:1,))
			mips64MipsCompare(out, mips64elA1, mips64elT0)
			mips64MipsJumpCondition(out, mips64elUGE, forward)
			mips64MipsEmitAddress(out, mips64elA2, record_address(Base:mips64elA2, Index:mips64elA3, Scale:1, Displacement:-1,))
			mips64MipsEmitAddress(out, mips64elA1, record_address(Base:mips64elA1, Index:mips64elA3, Scale:1, Displacement:-1,))
			out.Mark(backwardLoop)
			mips64MipsCompare(out, mips64elA3, mips64elZERO)
			mips64MipsJumpCondition(out, mips64elEQ, done)
			mips64MipsLoadU8(out, mips64elT0, record_address(Base:mips64elA2,))
			mips64MipsStoreU8(out, record_address(Base:mips64elA1,), mips64elT0)
			mips64MipsDecrement(out, mips64elA2)
			mips64MipsDecrement(out, mips64elA1)
			mips64MipsDecrement(out, mips64elA3)
			mips64MipsJump(out, backwardLoop)
			out.Mark(forward)
			out.Mark(forwardLoop)
			mips64MipsCompare(out, mips64elA3, mips64elZERO)
			mips64MipsJumpCondition(out, mips64elEQ, done)
			mips64MipsLoadU8(out, mips64elT0, record_address(Base:mips64elA2,))
			mips64MipsStoreU8(out, record_address(Base:mips64elA1,), mips64elT0)
			mips64MipsIncrement(out, mips64elA2)
			mips64MipsIncrement(out, mips64elA1)
			mips64MipsDecrement(out, mips64elA3)
			mips64MipsJump(out, forwardLoop)
			out.Mark(done)
		}
	}
}
abi mips64el_internal {
	unsigned_divide = go mips64MipsUnsignedDivide
	arch = mips64el
	arguments = [v0, v1, a0, a1, a2, a3]
	call_words = [v0, v1, a0, a1, a2, a3]
	result = [v0, v1]
	stack_alignment = 16
	return_address = link
	frame_pointer = frame
	frame_start = go mips64MipsFrameStart
	frame_finish = go mips64MipsFrameFinish
	frame_load = go mips64MipsFrameLoad
	frame_store = go mips64MipsFrameStore
	frame_address = go mips64MipsFrameAddress
}
runtime linux_mips64el {
	emit_entry_start = go targetEntryStart
	emit_entry = go targetEntry
	syscall {
		number = v0
		arguments = [a0, a1, a2, a3]
		result = v0
		instruction = host_syscall
	}
	operation read {
		number = 5000 args = [fd, buffer, count]
	}
	operation write {
		number = 5001 args = [fd, buffer, count]
	}
	operation open {
		number = 5002 args = [path, flags, mode]
	}
	operation close {
		number = 5003 args = [fd]
	}
	operation chmod {
		number = 5089 args = [fd, mode]
	}
	operation print {
		use = write args = [stdout, buffer, count]
	}
	operation exit {
		number = 5058 args = [status] noreturn = true
	}
}
format elf_mipsel {
	kind = elf
	byte_order = little
	address_bits = 64
	code_offset = 0
	image = go targetImage
}
target experimental/linux-mips64el {
	family = native_v1
	os = linux
	arch = mips64el
	frontend_arch = mips64el
	abi = mips64el_internal
	runtime = linux_mips64el
	executable = elf_mipsel
	arena_default = 16777216
	build_tags = [linux, unix, mipsel]
	capabilities = [hosted, executable, filesystem, heap]
}
