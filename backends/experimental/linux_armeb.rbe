	relocation branch24 {
		width = 4
		signed = true
		scale = 4
		bits = 24
		relative_to = instruction
	}
	relocation address32 {
		width = 8
		signed = true
		scale = 1
		bits = 32
		relative_to = pc_at_add
	}
	sequences {
		arm_beAsmAddRaxRcx(a:emitter) {
			arm_beAsmAddRegReg(a, armPrimary.Code, armPrimary.Code, armTertiary.Code)
		}
		arm_beAsmAddRdxImm(a:emitter, imm:int) {
			arm_beAsmAddRegImm(a, armSecondary.Code, armSecondary.Code, imm)
		}
		arm_beAsmAddRdxRcx(a:emitter) {
			arm_beAsmAddRegReg(a, armSecondary.Code, armSecondary.Code, armTertiary.Code)
		}
		arm_beAsmAddRegReg(a:emitter, dst:int, left:int, right:int) {
			arm_beAsmEmit(a, 0xe0800000 |(left << 16) |(dst << 12) | right)
		}
		arm_beAsmAddRegRegShift(a:emitter, dst:int, left:int, right:int, shift:int) {
			arm_beAsmEmit(a, 0xe0800000 |(left << 16) |(dst << 12) |(shift << 7) | right)
		}
		arm_beAsmBoolNotRax(a:emitter) {
			arm_beAsmCmpRaxImm8(a, 0)
			arm_beAsmCsetRax(a, 0)
		}
		arm_beAsmCmpRaxImm8(a:emitter, imm:int) {
			arm_beAsmCmpRegImm(a, armPrimary.Code, imm)
		}
		arm_beAsmCmpRegReg(a:emitter, left:int, right:int) {
			arm_beAsmEmit(a, 0xe1500000 |(left << 16) | right)
		}
		arm_beAsmCsetRax(a:emitter, cond:int) {
			arm_beAsmEmit(a, 0xe3a00000)
			arm_beAsmEmit(a,(cond << 28) | 0x03a00001)
		}
		arm_beAsmDecMemRdx(a:emitter) {
			arm_beAsmLoadRegMem(a, armScratch.Code, armSecondary.Code, 0, 4)
			arm_beAsmAddRegImm(a, armScratch.Code, armScratch.Code, -1)
			arm_beAsmStoreRegMem(a, armScratch.Code, armSecondary.Code, 0, 4)
		}
		arm_beAsmEmit(a:emitter, insn:int) {
			RTGUint32(a, insn)
		}
		arm_beAsmImulRcxImm(a:emitter, imm:int) {
			arm_beAsmMovRegImm(a, armScratch.Code, imm)
			arm_beAsmMulRegReg(a, armTertiary.Code, armTertiary.Code, armScratch.Code)
		}
		arm_beAsmIncMemRdx(a:emitter) {
			arm_beAsmLoadRegMem(a, armScratch.Code, armSecondary.Code, 0, 4)
			arm_beAsmAddRegImm(a, armScratch.Code, armScratch.Code, 1)
			arm_beAsmStoreRegMem(a, armScratch.Code, armSecondary.Code, 0, 4)
		}
		arm_beAsmIncRax(a:emitter) {
			arm_beAsmAddRegImm(a, armPrimary.Code, armPrimary.Code, 1)
		}
		arm_beAsmIncRcx(a:emitter) {
			arm_beAsmAddRegImm(a, armTertiary.Code, armTertiary.Code, 1)
		}
		arm_beAsmJnzLabel(a:emitter, label:int) {
			arm_beAsmBCondLabel(a, label, 1)
		}
		arm_beAsmJzLabel(a:emitter, label:int) {
			arm_beAsmBCondLabel(a, label, 0)
		}
		arm_beAsmLeaRegStack(a:emitter, dst:int, offset:int) {
			arm_beAsmAddRegImm(a, dst, armFrame.Code, -offset)
		}
		arm_beAsmLeave(a:emitter) {
			arm_beAsmMovRegReg(a, armStack.Code, armFrame.Code)
			arm_beAsmEmit(a, 0xe8bd4800)
		}
		arm_beAsmLoadByteRaxIndexRcx(a:emitter) {
			arm_beAsmAddRegReg(a, armAddress.Code, armPrimary.Code, armTertiary.Code)
			arm_beAsmLoadRegMem(a, armPrimary.Code, armAddress.Code, 0, 1)
		}
		arm_beAsmLoadQwordRaxIndexRcx8(a:emitter) {
			arm_beAsmAddRegRegShift(a, armAddress.Code, armPrimary.Code, armTertiary.Code, 3)
			arm_beAsmLoadRegMem(a, armPrimary.Code, armAddress.Code, 0, 4)
		}
		arm_beAsmLoadQwordRaxIndexRcxDisp(a:emitter, disp:int) {
			arm_beAsmAddRegReg(a, armAddress.Code, armPrimary.Code, armTertiary.Code)
			arm_beAsmLoadRegMem(a, armPrimary.Code, armAddress.Code, disp, 4)
		}
		arm_beAsmLoadRaxBss(a:emitter, bssOff:int) {
			arm_beAsmAccessRaxBss(a, bssOff, 0xe79f0000 | armAddress.Code)
		}
		arm_beAsmLoadRaxMemRdxDisp(a:emitter, disp:int) {
			arm_beAsmLoadRegMem(a, armPrimary.Code, armSecondary.Code, disp, 4)
		}
		arm_beAsmLoadRaxMemRdxDispSize(a:emitter, disp:int, size:int) {
			arm_beAsmLoadRegMem(a, armPrimary.Code, armSecondary.Code, disp, size)
		}
		arm_beAsmLoadRegStack(a:emitter, dst:int, offset:int) {
			arm_beAsmLoadRegMem(a, dst, armFrame.Code, -offset, 4)
		}
		arm_beAsmMovR10BssAddr(a:emitter, bssOff:int) {
			arm_beAsmMovRegAbs(a, armR8.Code, bssOff, RTGRelocationAbsoluteBSS)
		}
		arm_beAsmMovR8Rax(a:emitter) {
			arm_beAsmMovRegReg(a, armR5.Code, armPrimary.Code)
		}
		arm_beAsmMovR9Rax(a:emitter) {
			arm_beAsmMovRegReg(a, armR6.Code, armPrimary.Code)
		}
		arm_beAsmMovRaxBssAddr(a:emitter, bssOff:int) {
			arm_beAsmMovRegAbs(a, armPrimary.Code, bssOff, RTGRelocationAbsoluteBSS)
		}
		arm_beAsmMovRaxDataAddr(a:emitter, dataOff:int) {
			arm_beAsmMovRegAbs(a, armPrimary.Code, dataOff, 0)
		}
		arm_beAsmMovRaxImm(a:emitter, imm:int) {
			arm_beAsmMovRegImm(a, armPrimary.Code, imm)
		}
		arm_beAsmMovRaxImm64(a:emitter, imm:int) {
			arm_beAsmMovRaxImm(a, imm)
		}
		arm_beAsmMovRaxRdx(a:emitter) {
			arm_beAsmMovRegReg(a, armPrimary.Code, armSecondary.Code)
		}
		arm_beAsmMovRcxRax(a:emitter) {
			arm_beAsmMovRegReg(a, armTertiary.Code, armPrimary.Code)
		}
		arm_beAsmMovRcxRdx(a:emitter) {
			arm_beAsmMovRegReg(a, armTertiary.Code, armSecondary.Code)
		}
		arm_beAsmMovRdiRax(a:emitter) {
			arm_beAsmMovRegReg(a, armR3.Code, armPrimary.Code)
		}
		arm_beAsmMovRdxImm(a:emitter, imm:int) {
			arm_beAsmMovRegImm(a, armSecondary.Code, imm)
		}
		arm_beAsmMovRdxRax(a:emitter) {
			arm_beAsmMovRegReg(a, armSecondary.Code, armPrimary.Code)
		}
		arm_beAsmMovRsiRax(a:emitter) {
			arm_beAsmMovRegReg(a, armR4.Code, armPrimary.Code)
		}
		arm_beAsmMulRegReg(a:emitter, dst:int, left:int, right:int) {
			arm_beAsmEmit(a, 0xe0000090 |(dst << 16) |(right << 8) | left)
		}
		arm_beAsmNegRax(a:emitter) {
			arm_beAsmEmit(a, 0xe2600000)
		}
		arm_beAsmPopRax(a:emitter) {
			arm_beAsmPopReg(a, armPrimary.Code)
		}
		arm_beAsmPopRcx(a:emitter) {
			arm_beAsmPopReg(a, armTertiary.Code)
		}
		arm_beAsmPopRdi(a:emitter) {
			arm_beAsmPopReg(a, armR3.Code)
		}
		arm_beAsmPopRdx(a:emitter) {
			arm_beAsmPopReg(a, armSecondary.Code)
		}
		arm_beAsmPopReg(a:emitter, reg:int) {
			arm_beAsmEmit(a, 0xe49d0004 |(reg << 12))
		}
		arm_beAsmPopRsi(a:emitter) {
			arm_beAsmPopReg(a, armR4.Code)
		}
		arm_beAsmPushImm(a:emitter, imm:int) {
			arm_beAsmMovRegImm(a, armScratch.Code, imm)
			arm_beAsmPushReg(a, armScratch.Code)
		}
		arm_beAsmPushRax(a:emitter) {
			arm_beAsmPushReg(a, armPrimary.Code)
		}
		arm_beAsmPushRcx(a:emitter) {
			arm_beAsmPushReg(a, armTertiary.Code)
		}
		arm_beAsmPushRdx(a:emitter) {
			arm_beAsmPushReg(a, armSecondary.Code)
		}
		arm_beAsmPushReg(a:emitter, reg:int) {
			arm_beAsmEmit(a, 0xe52d0004 |(reg << 12))
		}
		arm_beAsmRet(a:emitter) {
			arm_beAsmEmit(a, 0xe12fff1e)
		}
		arm_beAsmSarRaxImm(a:emitter, imm:int) {
			arm_beAsmEmit(a, 0xe1a00040 |(armPrimary.Code << 12) |(imm << 7) | armPrimary.Code)
		}
		arm_beAsmShlRaxImm(a:emitter, imm:int) {
			arm_beAsmEmit(a, 0xe1a00000 |(armPrimary.Code << 12) |(imm << 7) | armPrimary.Code)
		}
		arm_beAsmShlRcxImm(a:emitter, imm:int) {
			arm_beAsmEmit(a, 0xe1a00000 |(armTertiary.Code << 12) |(imm << 7) | armTertiary.Code)
		}
		arm_beAsmShrRaxImm(a:emitter, imm:int) {
			arm_beAsmEmit(a, 0xe1a00020 |(armPrimary.Code << 12) |(imm << 7) | armPrimary.Code)
		}
		arm_beAsmStoreAlMemRdxRcx1(a:emitter) {
			arm_beAsmAddRegReg(a, armAddress.Code, armSecondary.Code, armTertiary.Code)
			arm_beAsmStoreRegMem(a, armPrimary.Code, armAddress.Code, 0, 1)
		}
		arm_beAsmStoreRaxBss(a:emitter, bssOff:int) {
			arm_beAsmAccessRaxBss(a, bssOff, 0xe78f0000 | armAddress.Code)
		}
		arm_beAsmStoreRaxMemRdxDisp(a:emitter, disp:int) {
			arm_beAsmStoreRegMem(a, armPrimary.Code, armSecondary.Code, disp, 4)
		}
		arm_beAsmStoreRaxMemRdxDispSize(a:emitter, disp:int, size:int) {
			arm_beAsmStoreRegMem(a, armPrimary.Code, armSecondary.Code, disp, size)
		}
		arm_beAsmStoreRaxMemRdxRcx8(a:emitter) {
			arm_beAsmAddRegRegShift(a, armAddress.Code, armSecondary.Code, armTertiary.Code, 3)
			arm_beAsmStoreRegMem(a, armPrimary.Code, armAddress.Code, 0, 4)
		}
		arm_beAsmStoreRegStack(a:emitter, src:int, offset:int) {
			arm_beAsmStoreRegMem(a, src, armFrame.Code, -offset, 4)
		}
		arm_beAsmStoreSliceStack(a:emitter, offset:int) {
			arm_beAsmStoreRegStack(a, armPrimary.Code, offset)
			arm_beAsmStoreRegStack(a, armSecondary.Code, offset - 8)
			arm_beAsmStoreRegStack(a, armTertiary.Code, offset - 16)
		}
		arm_beAsmSubRaxRcx(a:emitter) {
			arm_beAsmSubRegReg(a, armPrimary.Code, armPrimary.Code, armTertiary.Code)
		}
		arm_beAsmSubRegReg(a:emitter, dst:int, left:int, right:int) {
			arm_beAsmEmit(a, 0xe0400000 |(left << 16) |(dst << 12) | right)
		}
		arm_beAsmSyscall(a:emitter) {
			arm_beAsmMovRegReg(a, armSystem.Code, armPrimary.Code)
			arm_beAsmMovRegReg(a, armScratch.Code, armSecondary.Code)
			arm_beAsmMovRegReg(a, 0, armR3.Code)
			arm_beAsmMovRegReg(a, 1, armR4.Code)
			arm_beAsmMovRegReg(a, 2, armScratch.Code)
			arm_beAsmMovRegReg(a, 3, armR8.Code)
			arm_beAsmMovRegReg(a, 4, armR8.Code)
			arm_beAsmMovRegImm(a, 5, 0)
			arm_beAsmEmit(a, 0xef000000)
		}
		arm_beAsmAccessRaxBss(a:emitter, bssOff:int, insn:int) {
			let at = a.Len()
			RTGUint32(a, 0xe3000000 |(armAddress.Code << 12))
			RTGUint32(a, 0xe3400000 |(armAddress.Code << 12))
			RTGUint32(a, insn)
			a.AbsoluteReloc(at, bssOff, RTGRelocationAbsoluteBSS)
		}
		arm_beAsmBCondLabel(a:emitter, label:int, cond:int) {
			let at = a.Len()
			arm_beAsmEmit(a,(cond << 28) | 0x0a000000)
			a.RelocAt(at, label)
		}
		arm_beAsmCallLabel(a:emitter, label:int) {
			let at = a.Len()
			arm_beAsmEmit(a, 0xeb000000)
			a.RelocAt(at, label)
		}
		arm_beAsmCmpRcxRaxSet(a:emitter, setcc:int) {
			arm_beAsmCmpRegReg(a, armTertiary.Code, armPrimary.Code)
			let cond = arm_beCondFromSetcc(setcc)
			arm_beAsmCsetRax(a, cond)
		}
		arm_beAsmJmpLabel(a:emitter, label:int) {
			let at = a.Len()
			arm_beAsmEmit(a, 0xea000000)
			a.RelocAt(at, label)
		}
		arm_beAsmMovRegAbs(a:emitter, reg:int, off:int, kind:int) {
			let at = a.Len()
			RTGUint32(a, 0xe3000000 |(reg << 12))
			RTGUint32(a, 0xe3400000 |(reg << 12))
			RTGUint32(a, 0xe08f0000 |(reg << 12) | reg)
			a.AbsoluteReloc(at, off, kind)
		}
		arm_beAsmPatchMovRegImmAt(a:emitter, at:int, reg:int, imm:int) {
			let part = imm & 65535
			a.PatchUint32(at, 0xe3000000 |((part & 0xf000) << 4) |(reg << 12) |(part & 0x0fff))
			set part =(imm >> 16) & 65535
			a.PatchUint32(at + 4, 0xe3400000 |((part & 0xf000) << 4) |(reg << 12) |(part & 0x0fff))
		}
		arm_beCopyBytes(out:emitter) {
			let destination = armR3
			let source = armR4
			let count = armSecondary
			let value = armScratch2
			let forward = out.NewLabel()
			let forwardLoop = out.NewLabel()
			let backwardLoop = out.NewLabel()
			let done = out.NewLabel()
			armCompare(out, destination, source)
			armJumpCondition(out, record_condition(Code:9), forward)
			arm_beEmitAddress(out, armScratch, record_address(Base:source, Index:count, Scale:1,))
			armCompare(out, destination, armScratch)
			armJumpCondition(out, record_condition(Code:2), forward)
			arm_beEmitAddress(out, source, record_address(Base:source, Index:count, Scale:1, Displacement:-1,))
			arm_beEmitAddress(out, destination, record_address(Base:destination, Index:count, Scale:1, Displacement:-1,))
			out.Mark(backwardLoop)
			arm_beAsmCmpRegImm(out, count.Code, 0)
			armJumpCondition(out, record_condition(Code:0), done)
			arm_beLoadU8(out, value, record_address(Base:source))
			arm_beStoreU8(out, record_address(Base:destination), value)
			armDecrement(out, source)
			armDecrement(out, destination)
			armDecrement(out, count)
			armJump(out, backwardLoop)
			out.Mark(forward)
			out.Mark(forwardLoop)
			arm_beAsmCmpRegImm(out, count.Code, 0)
			armJumpCondition(out, record_condition(Code:0), done)
			arm_beLoadU8(out, value, record_address(Base:source))
			arm_beStoreU8(out, record_address(Base:destination), value)
			armIncrement(out, source)
			armIncrement(out, destination)
			armDecrement(out, count)
			armJump(out, forwardLoop)
			out.Mark(done)
		}
		arm_beFrameStart(out:emitter) -> int {
			out.Bytes4(0x00, 0x48, 0x2d, 0xe9)
			arm_beAsmMovRegReg(out, 11, 13)
			let at = out.Len()
			arm_beAsmEmit(out, 0xe3009000)
			arm_beAsmEmit(out, 0xe04dd009)
			return at
		}
		arm_beHostSyscall(out:emitter) {
			arm_beAsmEmit(out, 0xef000000)
		}
		arm_beMove(out:emitter, destination:register, source:register) {
			arm_beAsmMovRegReg(out, destination.Code, source.Code)
		}
		arm_beMoveImmediate(out:emitter, destination:register, value:int64) {
			arm_beAsmMovRegImm(out, destination.Code, int(value))
		}
		arm_beSetCondition(out:emitter, condition:condition, destination:register) {
			arm_beAsmEmit(out, 0xe3a00000 |(destination.Code << 12))
			arm_beAsmEmit(out,(condition.Code << 28) | 0x03a00001 |(destination.Code << 12))
		}
		arm_beShiftLeftImmediate(out:emitter, operand:register, value:byte) {
			arm_beShiftImmediate(out, operand, value, 0)
		}
		arm_beShiftRightSignedImmediate(out:emitter, operand:register, value:byte) {
			arm_beShiftImmediate(out, operand, value, 0x40)
		}
		arm_beShiftRightUnsignedImmediate(out:emitter, operand:register, value:byte) {
			arm_beShiftImmediate(out, operand, value, 0x20)
		}
		arm_beLoadI16(out:emitter, destination:register, address:address) {
			arm_beLoadExtra(out, destination, address, 0xe15000f0)
		}
		arm_beLoadI32(out:emitter, destination:register, address:address) {
			arm_beLoadNative(out, destination, address)
		}
		arm_beLoadI8(out:emitter, destination:register, address:address) {
			arm_beLoadExtra(out, destination, address, 0xe15000d0)
		}
		arm_beLoadNative(out:emitter, destination:register, address:address) {
			set address = arm_beMemoryAddress(out, address, 4)
			arm_beAsmLoadRegMem(out, destination.Code, address.Base.Code, address.Displacement, 4)
		}
		arm_beLoadU16(out:emitter, destination:register, address:address) {
			arm_beLoadExtra(out, destination, address, 0xe15000b0)
		}
		arm_beLoadU32(out:emitter, destination:register, address:address) {
			arm_beLoadNative(out, destination, address)
		}
		arm_beLoadU8(out:emitter, destination:register, address:address) {
			set address = arm_beMemoryAddress(out, address, 1)
			arm_beAsmLoadRegMem(out, destination.Code, address.Base.Code, address.Displacement, 1)
		}
		arm_beShiftImmediate(out:emitter, operand:register, value:byte, kind:int) {
			arm_beAsmEmit(out, 0xe1a00000 |(operand.Code << 12) |((int(value) & 31) << 7) | kind | operand.Code)
		}
		arm_beStoreNative(out:emitter, address:address, source:register) {
			arm_beStoreWidth(out, address, source, 4)
		}
		arm_beStoreU16(out:emitter, address:address, source:register) {
			arm_beStoreWidth(out, address, source, 2)
		}
		arm_beStoreU32(out:emitter, address:address, source:register) {
			arm_beStoreWidth(out, address, source, 4)
		}
		arm_beStoreU8(out:emitter, address:address, source:register) {
			arm_beStoreWidth(out, address, source, 1)
		}
		arm_beStoreWidth(out:emitter, address:address, source:register, size:int) {
			set address = arm_beMemoryAddress(out, address, size)
			arm_beAsmStoreRegMem(out, source.Code, address.Base.Code, address.Displacement, size)
		}
	}
}
abi renvo_arm {
	store_param_word = go arm_beStoreParamWord
	arch = arm
	frame_start = sequence arm_beFrameStart
	frame_finish = go arm_beFrameFinish
	call_words = [r0, r1, r2, r3, r4, r5]
	overflow_stride = 4
	scalar_result = r0
}
abi aapcs32 {
	internal = renvo_arm
	arguments = [r0, r1, r2, r3]
	result = [r0, r1]
	stack_alignment = 8
}
runtime linux_armeb {
	managed_heap_abi = 1
	managed_word_bits = 32
	managed_source = go managedSource
	managed_startup = go managedStartup
	managed_boundary = go managedBoundary

	emit_entry = go targetEntry
	syscall {
		number = r7
		arguments = [r0, r1, r2, r3, r4, r5]
		result = r0
		instruction = svc
	}
	operation read {
		number = 3 args = [fd, buffer, count]
	}
	operation write {
		number = 4 args = [fd, buffer, count]
	}
	operation read_at {
		number = 180 args = [fd, buffer, count, offset]
	}
	operation write_at {
		number = 181 args = [fd, buffer, count, offset]
	}
	operation open {
		number = 5 args = [path, flags, mode]
	}
	operation close {
		number = 6 args = [fd]
	}
	operation chmod {
		number = 94 args = [fd, mode]
	}
	operation print {
		use = write args = [stderr, buffer, count]
	}
	operation exit {
		number = 1 args = [status] noreturn = true
	}
}
format elf_armeb {
	kind = elf
	byte_order = big
	address_bits = 32
	code_offset = 0
	image = go targetImage
}
target experimental/linux-armeb {
	family = native_v1
	os = linux
	arch = arm
	abi = aapcs32
	runtime = linux_armeb
	executable = elf_armeb
	arena_default = 16777216
	build_tags = [linux, unix, arm]
	capabilities = [hosted, executable, filesystem, heap]
}

# Managed collector and Linux services shared with backend/definitions/managed_heap64.rtg
# and managed_linux.rtg, embedded to keep this RBE standalone.
go backend {
	func managedHeap64Source() string { return managedHeapSource(8) }
	func managedHeap32Source() string { return managedHeapSource(4) }

	// Headers keep their aligned layout; payload/root scanning follows native words.
	func managedHeapSource(wordBytes int) string {
		constants := "const __renvoManagedWordBytes = uintptr(8)\nconst __renvoManagedMax = uintptr(9223372036854775807)\n"
		if wordBytes == 4 {
			constants = "const __renvoManagedWordBytes = uintptr(4)\nconst __renvoManagedMax = uintptr(2147483647)\n"
		}
		return constants + `
					// Desktop heap runtime, parsed and compiled with the application. No helper
					// below allocates through make/new/append or calls application code.
					var __renvoManagedState [16]uintptr

					func __renvoManagedRead(p uintptr) uintptr { return *(*uintptr)(p) }
					func __renvoManagedWrite(p uintptr, v uintptr) { *(*uintptr)(p) = v }
					func __renvoManagedByte(p uintptr) byte { return *(*byte)(p) }

					func __renvoManagedLimit(p uintptr) uintptr {
						var value uintptr
						var digits int
						for __renvoManagedByte(p) >= '0' && __renvoManagedByte(p) <= '9' {
							digit := uintptr(__renvoManagedByte(p)-'0')
							if value > (__renvoManagedMax-digit)/10 { return 0 }
							value = value*10+digit
							p++
							digits++
						}
						if digits == 0 || value == 0 { return 0 }
						var shift uintptr
						if __renvoManagedByte(p) != 0 {
							c := __renvoManagedByte(p)
							if c == 'K' { shift = 10 } else if c == 'M' { shift = 20 } else if c == 'G' { shift = 30 } else if c == 'T' { shift = 40 } else { return 0 }
							if __renvoManagedByte(p+1) != 'i' || __renvoManagedByte(p+2) != 'B' || __renvoManagedByte(p+3) != 0 { return 0 }
						}
						if value > __renvoManagedMax>>shift { return 0 }
						return value << shift
					}

					func __renvoManagedInit(limit uintptr, stack uintptr, globals uintptr, end uintptr) {
						if limit == 0 { limit = __renvoManagedMax }
						override := __renvoManagedEnvironment(stack)
						if override != 0 {
							limit = __renvoManagedLimit(override)
							if limit == 0 { __renvoManagedFatal("renvo: invalid RENVO_HEAP_LIMIT\n") }
						}
						// State and the common allocator's 32-byte compatibility bookkeeping.
						if limit < 160 { __renvoManagedFatal("panic: out of memory\n") }
						__renvoManagedState[1] = limit
						__renvoManagedState[2] = 160
						__renvoManagedState[3] = stack
						__renvoManagedState[6] = globals
						__renvoManagedState[7] = end
						__renvoManagedState[8] = 65536
					}

					// Segment header: next, mapping size, payload offset, reserved word; then one
					// block-header index per mapped page. All of this resides in charged mappings.
					func __renvoManagedHeader(size uintptr) uintptr { return (32+(size/__renvoManagedPageSize)*8+15)&^uintptr(15) }
					func __renvoManagedIndex(s uintptr, b uintptr, span uintptr) {
						first := (b-s+(__renvoManagedPageSize-1))/__renvoManagedPageSize
						end := (b-s+span+(__renvoManagedPageSize-1))/__renvoManagedPageSize
						for page := first; page < end; page++ { __renvoManagedWrite(s+32+page*8, b) }
					}
					func __renvoManagedFind(pointer uintptr) uintptr {
						for s := __renvoManagedState[0]; s != 0; s = __renvoManagedRead(s) {
							size := __renvoManagedRead(s+8)
							if pointer < s+__renvoManagedRead(s+16)+16 || pointer-s >= size { continue }
							b := __renvoManagedRead(s+32+((pointer-s)/__renvoManagedPageSize)*8)
							for b < s+size {
								span := __renvoManagedRead(b)
								if pointer < b+span {
									if pointer >= b+16 && __renvoManagedRead(b+8)&1 != 0 { return b }
									return 0
								}
								b += span
							}
						}
						return 0
					}
					func __renvoManagedMark(pointer uintptr) {
						b := __renvoManagedFind(pointer)
						if b != 0 && __renvoManagedRead(b+8)&2 == 0 {
							// Block headers are 16-byte aligned. During marking the upper bits
							// hold the next work item; low bits retain allocated/marked flags.
							__renvoManagedWrite(b+8, __renvoManagedState[9]|3)
							__renvoManagedState[9] = b
						}
					}
					func __renvoManagedScan(start uintptr, end uintptr) {
						for p := start; p < end; p += __renvoManagedWordBytes { __renvoManagedMark(__renvoManagedRead(p)) }
					}
					func __renvoManagedCollect(roots uintptr) {
						__renvoManagedState[4] = 0
						__renvoManagedState[5] = 0
						__renvoManagedState[9] = 0
						__renvoManagedRoots(roots)
						state := uintptr(&__renvoManagedState[0])
						__renvoManagedScan(__renvoManagedState[6], state)
						__renvoManagedScan(state+16*__renvoManagedWordBytes, __renvoManagedState[7])
						for __renvoManagedState[9] != 0 {
							b := __renvoManagedState[9]
							__renvoManagedState[9] = __renvoManagedRead(b+8)&^uintptr(15)
							__renvoManagedWrite(b+8, 3)
							__renvoManagedScan(b+16, b+__renvoManagedRead(b))
						}
						var previous uintptr
						var live uintptr
						for s := __renvoManagedState[0]; s != 0; {
							size := __renvoManagedRead(s+8)
							var free uintptr
							used := false
							for b := s+__renvoManagedRead(s+16); b < s+size; {
								span := __renvoManagedRead(b)
								if __renvoManagedRead(b+8)&2 != 0 {
									__renvoManagedWrite(b+8, 1)
									free = 0
									used = true
									live += span
								} else {
									__renvoManagedWrite(b+8, 0)
									if free != 0 { __renvoManagedWrite(free, __renvoManagedRead(free)+span) } else { free = b }
								}
								b += span
							}
							next := __renvoManagedRead(s)
							if !used {
								if previous == 0 { __renvoManagedState[0] = next } else { __renvoManagedWrite(previous, next) }
								if !__renvoManagedRelease(s, size) { __renvoManagedFatal("renvo: managed heap release failed\n") }
								__renvoManagedState[2] -= size
							} else {
								previous = s
								__renvoManagedWrite(s+32, s+__renvoManagedRead(s+16))
								for b := s+__renvoManagedRead(s+16); b < s+size; b += __renvoManagedRead(b) {
									__renvoManagedIndex(s, b, __renvoManagedRead(b))
								}
							}
							s = next
						}
						__renvoManagedState[10]++
						__renvoManagedState[12] = live
					}
					func __renvoManagedClaim(s uintptr, b uintptr, span uintptr) uintptr {
						available := __renvoManagedRead(b)
						__renvoManagedState[4] = 0
						if available-span >= 32 {
							__renvoManagedWrite(b+span, available-span)
							__renvoManagedWrite(b+span+8, 0)
							__renvoManagedWrite(b, span)
							__renvoManagedState[4] = b+span
							__renvoManagedState[5] = s
							available = span
						}
						// Only occupied pages need a fresh index. An older free-page index is
						// still a valid earlier block; lookup walks forward until sweep rebuilds it.
						__renvoManagedIndex(s, b, available)
						__renvoManagedWrite(b+8, 1)
						for p := b+16; p < b+available; p += __renvoManagedWordBytes { __renvoManagedWrite(p, 0) }
						return b+16
					}
					func __renvoManagedTake(span uintptr) uintptr {
						b := __renvoManagedState[4]
						if b != 0 && __renvoManagedRead(b) >= span {
							return __renvoManagedClaim(__renvoManagedState[5], b, span)
						}
						for s := __renvoManagedState[0]; s != 0; s = __renvoManagedRead(s) {
							end := s+__renvoManagedRead(s+8)
							for b := s+__renvoManagedRead(s+16); b < end; b += __renvoManagedRead(b) {
								if __renvoManagedRead(b+8) == 0 && __renvoManagedRead(b) >= span {
									return __renvoManagedClaim(s, b, span)
								}
							}
						}
						return 0
					}
					func __renvoManagedRequest(size uintptr, roots uintptr) uintptr {
						if size > __renvoManagedMax-(__renvoManagedPageSize+31) { return 0 }
						if size == 0 { size = 16 }
						span := ((size+15)&^uintptr(15))+16
						result := __renvoManagedTake(span)
						if result != 0 { return result }
						if __renvoManagedState[0] != 0 {
							__renvoManagedCollect(roots)
							result = __renvoManagedTake(span)
							if result != 0 { return result }
						}
						minimum := (span+48+(__renvoManagedPageSize-1))&^uintptr((__renvoManagedPageSize-1))
						for minimum-__renvoManagedHeader(minimum) < span {
							minimum = (span+__renvoManagedHeader(minimum)+(__renvoManagedPageSize-1))&^uintptr((__renvoManagedPageSize-1))
						}
						available := (__renvoManagedState[1]-__renvoManagedState[2])&^uintptr((__renvoManagedPageSize-1))
						if minimum > available { return 0 }
						growth := __renvoManagedState[8]
						if growth < minimum { growth = minimum }
						if growth > available { growth = available }
						mapping := __renvoManagedMap(growth)
						if mapping == 0 && growth != minimum {
							growth = minimum
							mapping = __renvoManagedMap(growth)
						}
						if mapping == 0 { return 0 }
						base := uintptr(mapping)
						__renvoManagedWrite(base, __renvoManagedState[0])
						__renvoManagedWrite(base+8, growth)
						header := __renvoManagedHeader(growth)
						__renvoManagedWrite(base+16, header)
						for page := uintptr(0); page < growth/__renvoManagedPageSize; page++ { __renvoManagedWrite(base+32+page*8, base+header) }
						__renvoManagedWrite(base+header, growth-header)
						__renvoManagedState[4] = base+header
						__renvoManagedState[5] = base
						__renvoManagedState[0] = base
						__renvoManagedState[2] += growth
						if growth < __renvoManagedMax/2 { __renvoManagedState[8] = growth*2 }
						return __renvoManagedTake(span)
					}
					func __renvoManagedCollectBoundary(ignored uintptr, roots uintptr) uintptr {
						__renvoManagedCollect(roots)
						return 0
					}
					`
	}
}

go backend {
	func linuxManagedSource() string {
		return `
					//renvo:intrinsic renvo_runtime_Syscall
					func __renvoManagedSyscall(n int, a uintptr, b uintptr, c uintptr, d uintptr, e int, f uintptr) int { return -1 }
					
					func __renvoManagedMap(size uintptr) uintptr {
					 p := __renvoManagedSyscall(__renvoManagedMapNumber, 0, size, 3, __renvoManagedMapFlags, -1, 0)
					 if uintptr(p) >= ^uintptr(4094) { return 0 }; return uintptr(p)
					}
					func __renvoManagedRelease(base uintptr, size uintptr) bool { return __renvoManagedSyscall(__renvoManagedReleaseNumber, base, size, 0, 0, 0, 0) == 0 }
					func __renvoManagedFatal(message string) { print(message); __renvoManagedSyscall(__renvoManagedExitNumber, 2, 0, 0, 0, 0, 0) }
					func __renvoManagedEnvironment(stack uintptr) uintptr {
					 // Linux initial process stack: argc, argv[], null, envp[], null.
					 p := stack + 2*__renvoManagedWordBytes + __renvoManagedRead(stack)*__renvoManagedWordBytes
					 for __renvoManagedRead(p) != 0 {
					  entry := __renvoManagedRead(p)
					  matched := true
					  prefix := "RENVO_HEAP_LIMIT="
					  for i := 0; i < len(prefix); i++ {
					   if __renvoManagedByte(entry+uintptr(i)) != prefix[i] { matched = false; break }
					  }
					  if matched { return entry+17 }
					  p += __renvoManagedWordBytes
					 }
					 return 0
					}
					func __renvoManagedRoots(roots uintptr) {
					 if roots > __renvoManagedState[3] { __renvoManagedFatal("renvo: unsupported managed stack\n") }
					 __renvoManagedScan(roots, __renvoManagedState[3])
					}
					`
	}
}

go backend {
	func managedSource() string {
		return managedHeap32Source() + linuxManagedSource() + `
						const __renvoManagedPageSize = uintptr(4096)
				const __renvoManagedMapNumber = 192
				const __renvoManagedReleaseNumber = 91
				const __renvoManagedExitNumber = 1
				const __renvoManagedMapFlags = uintptr(34)
				`
	}
	func managedStartup(out *RTGEmitter, limit int, label int) {
		arm_beAsmMovRegImm(out, 3, limit)
		arm_beAsmAddRegImm(out, 2, 11, 8)
		arm_beAsmMovRegAbs(out, 1, 0, RTGRelocationAbsoluteBSS)
		arm_beAsmMovRegAbs(out, 0, out.BSSSize(), RTGRelocationAbsoluteBSS)
		managedCall(out, label)
	}
	func managedBoundary(out *RTGEmitter, label int) {
		arm_beAsmEmit(out, 0xe24dd040) // sub sp, sp, #64; preserve scratch roots
		for reg := 0; reg < 15; reg++ {
			if reg != 13 {
				arm_beAsmStoreRegMem(out, reg, 13, reg*4, 4)
			}
		}
		arm_beAsmMovRegReg(out, 1, 0)
		// Pass the saved-register snapshot as the root range bottom.
		arm_beAsmMovRegReg(out, 0, 13)
		managedCall(out, label)
		for reg := 1; reg < 15; reg++ {
			if reg != 13 {
				arm_beAsmLoadRegMem(out, reg, 13, reg*4, 4)
			}
		}
		arm_beAsmEmit(out, 0xe28dd040) // add sp, sp, #64
	}
}

go backend {
	func managedCall(out *RTGEmitter, label int) {
		at := out.Len()
		arm_beAsmEmit(out, 0xeb000000)
		out.RelocAt(at, label)
	}
}
