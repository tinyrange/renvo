# SPDX-License-Identifier: Apache-2.0
# Self-contained Linux backend. Copy this file to use or extend this target.
definition 1
unit linux_armeb
implements direct_emitter_v1
go backend {
	func arm_beStoreParamWord(out *RTGEmitter, word int, offset int) {
		if word < 6 {
			arm_beAsmStoreRegStack(out, word, offset)
			return
		}
		arm_beAsmLoadRegMem(out, armScratch.Code, armFrame.Code, 8+(word-6)*4, 4)
		arm_beAsmStoreRegStack(out, armScratch.Code, offset)
	}

	func arm_beBeAdd(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		RTGUint32(out, 0xe0800000|(destination.Code<<12)|(destination.Code<<16)|(source.Code<<0))
	}
	func arm_beBeSubtract(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		RTGUint32(out, 0xe0400000|(destination.Code<<12)|(destination.Code<<16)|(source.Code<<0))
	}
	func arm_beBeMultiply(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		RTGUint32(out, 0xe0000090|(destination.Code<<0)|(destination.Code<<16)|(source.Code<<8))
	}
	func arm_beBeBitAnd(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		RTGUint32(out, 0xe0000000|(destination.Code<<12)|(destination.Code<<16)|(source.Code<<0))
	}
	func arm_beBeBitOr(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		RTGUint32(out, 0xe1800000|(destination.Code<<12)|(destination.Code<<16)|(source.Code<<0))
	}
	func arm_beBeBitXor(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		RTGUint32(out, 0xe0200000|(destination.Code<<12)|(destination.Code<<16)|(source.Code<<0))
	}
	func arm_beBeCompare(out *RTGEmitter, left RTGRegister, right RTGRegister) {
		RTGUint32(out, 0xe1500000|(left.Code<<16)|(right.Code<<0))
	}
	func arm_beBeTest(out *RTGEmitter, left RTGRegister, right RTGRegister) {
		RTGUint32(out, 0xe1100000|(left.Code<<16)|(right.Code<<0))
	}
	func arm_beBeIncrement(out *RTGEmitter, operand RTGRegister) {
		RTGUint32(out, 0xe2800001|(operand.Code<<12)|(operand.Code<<16))
	}
	func arm_beBeDecrement(out *RTGEmitter, operand RTGRegister) {
		RTGUint32(out, 0xe2400001|(operand.Code<<12)|(operand.Code<<16))
	}
	func arm_beBeCallIndirect(out *RTGEmitter, operand RTGRegister) {
		RTGUint32(out, 0xe12fff30|(operand.Code<<0))
	}
	func arm_beBeCall(out *RTGEmitter, label RTGLabel) { RTGUint32(out, 0xeb000000); RTGReloc(out, label) }
	func arm_beBeJump(out *RTGEmitter, label RTGLabel) { RTGUint32(out, 0xea000000); RTGReloc(out, label) }
	func arm_beBeJumpCondition(out *RTGEmitter, condition RTGCondition, label RTGLabel) {
		RTGUint32(out, 0x0a000000|(condition.Code<<28))
		RTGReloc(out, label)
	}
	func arm_beAsmAlign(a *RTGEmitter) {
		for a.Len()%4 != 0 {
			RTGByte(a, 0)
		}
	}

	func arm_beAsmMovRegReg(a *RTGEmitter, dst int, src int) {
		if dst == src {
			return
		}
		arm_beAsmEmit(a, 0xe1a00000|(dst<<12)|src)
	}

	func arm_beAsmMovRegImm(a *RTGEmitter, reg int, imm int) {
		part := imm & 65535
		arm_beAsmEmit(a, 0xe3000000|((part&0xf000)<<4)|(reg<<12)|(part&0x0fff))
		part = (imm >> 16) & 65535
		if part != 0 {
			arm_beAsmEmit(a, 0xe3400000|((part&0xf000)<<4)|(reg<<12)|(part&0x0fff))
		}
	}

	func arm_beAsmAddRegImm(a *RTGEmitter, dst int, src int, imm int) {
		if imm == 0 {
			arm_beAsmMovRegReg(a, dst, src)
			return
		}
		tmp := armScratch.Code
		if dst == tmp || src == tmp {
			tmp = armScratch2.Code
		}
		if imm < 0 {
			arm_beAsmMovRegImm(a, tmp, -imm)
			arm_beAsmSubRegReg(a, dst, src, tmp)
			return
		}
		arm_beAsmMovRegImm(a, tmp, imm)
		arm_beAsmAddRegReg(a, dst, src, tmp)
	}

	func arm_beAsmFrameStart(a *RTGEmitter) int {
		at := a.Len()
		arm_beAsmEmit(a, 0xe3009000) // movw r9, #0
		arm_beAsmEmit(a, 0xe04dd009) // sub sp, sp, r9
		return at
	}

	func arm_beAsmPatchFrame(a *RTGEmitter, at int, stackUsed int) {
		frame := (stackUsed + 7) & -8
		if frame > 65528 {
			frame = 65528
		}
		a.PatchUint32(at, 0xe3009000|((frame&0xf000)<<4)|(frame&0x0fff))
	}

	func arm_beAsmAddRegSmallImm(a *RTGEmitter, dst int, src int, imm int) {
		if imm < 0 {
			arm_beAsmEmit(a, 0xe2400000|(src<<16)|(dst<<12)|(-imm))
			return
		}
		arm_beAsmEmit(a, 0xe2800000|(src<<16)|(dst<<12)|imm)
	}

	func arm_beAsmAddr(a *RTGEmitter, base int, disp int) int {
		if disp == 0 {
			return base
		}
		arm_beAsmAddRegImm(a, armAddress.Code, base, disp)
		return armAddress.Code
	}

	func arm_beAsmLoadStoreAddr(a *RTGEmitter, base int, disp int, size int) int {
		if size == 2 && (disp < 0 || disp > 255) {
			return arm_beAsmAddr(a, base, disp)
		}
		if size != 2 && (disp < -4095 || disp > 4095) {
			return arm_beAsmAddr(a, base, disp)
		}
		return base
	}

	func arm_beAsmLoadRegMem(a *RTGEmitter, dst int, base int, disp int, size int) {
		addr := arm_beAsmLoadStoreAddr(a, base, disp, size)
		if addr != base {
			disp = 0
		}
		up := 0x00800000
		if disp < 0 {
			up = 0
			disp = -disp
		}
		if size == 1 {
			arm_beAsmEmit(a, 0xe5500000|up|(addr<<16)|(dst<<12)|disp)
			return
		}
		if size == 2 {
			arm_beAsmEmit(a, 0xe15000f0|up|(addr<<16)|(dst<<12)|((disp&0xf0)<<4)|(disp&0x0f))
			return
		}
		arm_beAsmEmit(a, 0xe5100000|up|(addr<<16)|(dst<<12)|disp)
	}

	func arm_beAsmStoreRegMem(a *RTGEmitter, src int, base int, disp int, size int) {
		addr := arm_beAsmLoadStoreAddr(a, base, disp, size)
		if addr != base {
			disp = 0
		}
		up := 0x00800000
		if disp < 0 {
			up = 0
			disp = -disp
		}
		if size == 1 {
			arm_beAsmEmit(a, 0xe5400000|up|(addr<<16)|(src<<12)|disp)
			return
		}
		if size == 2 {
			arm_beAsmEmit(a, 0xe14000b0|up|(addr<<16)|(src<<12)|((disp&0xf0)<<4)|(disp&0x0f))
			return
		}
		arm_beAsmEmit(a, 0xe5000000|up|(addr<<16)|(src<<12)|disp)
	}

	func arm_beAsmStackMem(a *RTGEmitter, offset int, base int, disp8 int, disp32 int) {
		if base == 0x8948 && disp8 == 0x45 {
			arm_beAsmStoreRegStack(a, armPrimary.Code, offset)
			return
		}
		if base == 0x8948 && disp8 == 0x55 {
			arm_beAsmStoreRegStack(a, armSecondary.Code, offset)
			return
		}
		if base == 0x8948 && disp8 == 0x4d {
			arm_beAsmStoreRegStack(a, armTertiary.Code, offset)
			return
		}
		if base == 0x8b48 && disp8 == 0x45 {
			arm_beAsmLoadRegStack(a, armPrimary.Code, offset)
			return
		}
		if base == 0x8b48 && disp8 == 0x55 {
			arm_beAsmLoadRegStack(a, armSecondary.Code, offset)
			return
		}
		if base == 0x8b48 && disp8 == 0x4d {
			arm_beAsmLoadRegStack(a, armTertiary.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x45 {
			arm_beAsmLeaRegStack(a, armPrimary.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x55 {
			arm_beAsmLeaRegStack(a, armSecondary.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x7d {
			arm_beAsmLeaRegStack(a, armR3.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x75 {
			arm_beAsmLeaRegStack(a, armR4.Code, offset)
			return
		}
	}

	func arm_beAsmMemDisp(a *RTGEmitter, disp int, op int, disp8 int, disp32 int) {
		if op == 0x8b48 && disp8 == 0x4a {
			arm_beAsmLoadRegMem(a, armTertiary.Code, armSecondary.Code, disp, 4)
			return
		}
		if op == 0x8b48 && disp8 == 0x52 {
			arm_beAsmLoadRegMem(a, armSecondary.Code, armSecondary.Code, disp, 4)
			return
		}
		if op == 0x8948 && disp8 == 0x41 {
			arm_beAsmStoreRegMem(a, armPrimary.Code, armTertiary.Code, disp, 4)
			return
		}
	}

	func arm_beAsmLoadRaxIndexRcxSize(a *RTGEmitter, size int) {
		shift := 3
		if size == 1 {
			shift = 0
		}
		if size == 2 {
			shift = 1
		}
		if size == 4 {
			shift = 2
		}
		arm_beAsmAddRegRegShift(a, armAddress.Code, armPrimary.Code, armTertiary.Code, shift)
		arm_beAsmLoadRegMem(a, armPrimary.Code, armAddress.Code, 0, size)
	}

	func arm_beAsmNormalizeRaxForKind(a *RTGEmitter, kind int) {
		if kind == RTGScalarByte {
			arm_beAsmEmit(a, 0xe6ef0070)
			return
		}
		if kind == RTGScalarInt8 {
			arm_beAsmEmit(a, 0xe6af0070)
			return
		}
		if kind == RTGScalarInt16 {
			arm_beAsmEmit(a, 0xe6bf0070)
			return
		}
		if kind == RTGScalarUint16 {
			arm_beAsmEmit(a, 0xe6ff0070)
		}
	}

	func arm_beAsmCmpRegImm(a *RTGEmitter, reg int, imm int) {
		if imm >= 0 && imm <= 255 {
			arm_beAsmEmit(a, 0xe3500000|(reg<<16)|imm)
			return
		}
		tmp := armScratch.Code
		if reg == tmp {
			tmp = armScratch2.Code
		}
		arm_beAsmMovRegImm(a, tmp, imm)
		arm_beAsmCmpRegReg(a, reg, tmp)
	}

	func arm_beCondFromSetcc(setcc int) int {
		if setcc == 0x94 {
			return 0
		}
		if setcc == 0x95 {
			return 1
		}
		if setcc == 0x9c {
			return 11
		}
		if setcc == 0x9e {
			return 13
		}
		if setcc == 0x9f {
			return 12
		}
		return 10
	}

	func arm_beAsmDivLeftRcxRightRax(a *RTGEmitter, mod bool) {
		arm_beAsmMovRegReg(a, armScratch.Code, armPrimary.Code)
		arm_beAsmEmit(a, 0xe710f010|(armPrimary.Code<<16)|(armPrimary.Code<<8)|armTertiary.Code)
		if mod {
			arm_beAsmEmit(a, 0xe0600090|(armTertiary.Code<<12)|(armScratch.Code<<8)|armPrimary.Code)
		}
	}

	func arm_beAsmStoreRaxMemRdxRcxSize(a *RTGEmitter, size int) {
		shift := 3
		if size == 1 {
			shift = 0
		}
		if size == 2 {
			shift = 1
		}
		if size == 4 {
			shift = 2
		}
		arm_beAsmAddRegRegShift(a, armAddress.Code, armSecondary.Code, armTertiary.Code, shift)
		arm_beAsmStoreRegMem(a, armPrimary.Code, armAddress.Code, 0, size)
	}

	func arm_beEmitAddress(
		out *RTGEmitter, destination RTGRegister, memory RTGAddress,
	) {
		if RTGAddressValid(memory) {
			part := memory.Addend & 65535
			at := out.Len()
			arm_beAsmEmit(out,
				0xe3000000|((part&0xf000)<<4)|
					(destination.Code<<12)|(part&0x0fff))
			part = (memory.Addend >> 16) & 65535
			arm_beAsmEmit(out,
				0xe3400000|((part&0xf000)<<4)|
					(destination.Code<<12)|(part&0x0fff))
			arm_beAsmEmit(out,
				0xe08f0000|(destination.Code<<12)|destination.Code)
			RTGAddressRelocAt(out, memory, at)
			return
		}
		base := memory.Base.Code
		if memory.Index.Valid {
			shift := 0
			if memory.Scale == 2 {
				shift = 1
			} else {
				if memory.Scale == 4 {
					shift = 2
				} else {
					if memory.Scale == 8 {
						shift = 3
					}
				}
			}
			arm_beAsmAddRegRegShift(
				out, destination.Code, base, memory.Index.Code, shift)
			base = destination.Code
		}
		arm_beAsmAddRegImm(
			out, destination.Code, base, memory.Displacement)
	}

	func arm_beMemoryAddress(
		out *RTGEmitter, memory RTGAddress, size int,
	) RTGAddress {
		limit := 4095
		if size == 2 {
			limit = 255
		}
		if RTGAddressValid(memory) || memory.Index.Valid ||
			memory.Displacement < -limit ||
			memory.Displacement > limit {
			arm_beEmitAddress(out, armAddress, memory)
			return RTGAddress{Base: armAddress}
		}
		return memory
	}

	func arm_beLoadExtra(
		out *RTGEmitter,
		destination RTGRegister,
		memory RTGAddress,
		opcode int,
	) {
		memory = arm_beMemoryAddress(out, memory, 2)
		displacement := memory.Displacement
		up := 0x00800000
		if displacement < 0 {
			up = 0
			displacement = -displacement
		}
		arm_beAsmEmit(out,
			opcode|up|(memory.Base.Code<<16)|
				(destination.Code<<12)|
				((displacement&0xf0)<<4)|(displacement&0x0f))
	}

	func arm_beVariableShift(
		out *RTGEmitter, direction RTGShiftDirection, signed bool,
	) {
		kind := 0x20
		if direction == RTGShiftLeft {
			kind = 0
		} else {
			if signed {
				kind = 0x40
			}
		}
		arm_beAsmEmit(out,
			0xe1a00010|(armPrimary.Code<<12)|
				(armPrimary.Code<<8)|kind|armTertiary.Code)
	}

	func arm_beSignedDivide(out *RTGEmitter, remainder bool) {
		arm_beAsmMovRegReg(
			out, armScratch.Code, armPrimary.Code)
		arm_beAsmEmit(out,
			0xe710f010|(armPrimary.Code<<16)|
				(armPrimary.Code<<8)|armTertiary.Code)
		if remainder {
			arm_beAsmEmit(out,
				0xe0600090|(armTertiary.Code<<12)|
					(armScratch.Code<<8)|armPrimary.Code)
		}
	}

	func arm_beFrameFinish(out *RTGEmitter, at int, stackUsed int) {
		frame := (stackUsed + 7) & -8
		if frame > 65528 {
			frame = 65528
		}
		out.PatchUint32(at, 0xe3009000|((frame&0xf000)<<4)|(frame&0x0fff))
	}

	const elfCodeAddress = 0x11000

	func elfDataOffset(out *RTGEmitter) int  { return RTGAlignValue(0x1000+len(out.Code()), 0x10000) }
	func elfDataAddress(out *RTGEmitter) int { return 0x10000 + elfDataOffset(out) }
	func elfBssAddress(out *RTGEmitter) int {
		return RTGAlignValue(elfDataAddress(out)+len(out.Data()), 16)
	}
	func elfPut(image []byte, at int, value uint64, width int, big bool) {
		for i := 0; i < width; i++ {
			shift := i * 8
			if big {
				shift = (width - 1 - i) * 8
			}
			image[at+i] = byte(value >> uint(shift))
		}
	}
	func elfImage(out *RTGEmitter, machine int, flags int, bits int, big bool) []byte {
		offset := elfDataOffset(out)
		result := make([]byte, offset+len(out.Data()))
		result[0] = 0x7f
		result[1] = 'E'
		result[2] = 'L'
		result[3] = 'F'
		result[4] = 1
		if bits == 64 {
			result[4] = 2
		}
		result[5] = 1
		if big {
			result[5] = 2
		}
		result[6] = 1
		elfPut(result, 16, 2, 2, big)
		elfPut(result, 18, uint64(machine), 2, big)
		elfPut(result, 20, 1, 4, big)
		if bits == 32 {
			elfPut(result, 24, elfCodeAddress, 4, big)
			elfPut(result, 28, 52, 4, big)
			elfPut(result, 36, uint64(flags), 4, big)
			elfPut(result, 40, 52, 2, big)
			elfPut(result, 42, 32, 2, big)
			elfPut(result, 44, 2, 2, big)
		} else {
			elfPut(result, 24, elfCodeAddress, 8, big)
			elfPut(result, 32, 64, 8, big)
			elfPut(result, 48, uint64(flags), 4, big)
			elfPut(result, 52, 64, 2, big)
			elfPut(result, 54, 56, 2, big)
			elfPut(result, 56, 2, 2, big)
		}
		for i := 0; i < 2; i++ {
			file := 0
			address := 0x10000
			size := 0x1000 + len(out.Code())
			memory := size
			permissions := 5
			if i == 1 {
				file = offset
				address = elfDataAddress(out)
				size = len(out.Data())
				memory = elfBssAddress(out) - address + out.BSSSize()
				permissions = 6
			}
			if bits == 32 {
				at := 52 + i*32
				elfPut(result, at, 1, 4, big)
				elfPut(result, at+4, uint64(file), 4, big)
				elfPut(result, at+8, uint64(address), 4, big)
				elfPut(result, at+12, uint64(address), 4, big)
				elfPut(result, at+16, uint64(size), 4, big)
				elfPut(result, at+20, uint64(memory), 4, big)
				elfPut(result, at+24, uint64(permissions), 4, big)
				elfPut(result, at+28, 0x10000, 4, big)
			} else {
				at := 64 + i*56
				elfPut(result, at, 1, 4, big)
				elfPut(result, at+4, uint64(permissions), 4, big)
				elfPut(result, at+8, uint64(file), 8, big)
				elfPut(result, at+16, uint64(address), 8, big)
				elfPut(result, at+24, uint64(address), 8, big)
				elfPut(result, at+32, uint64(size), 8, big)
				elfPut(result, at+40, uint64(memory), 8, big)
				elfPut(result, at+48, 0x10000, 8, big)
			}
		}
		copy(result[0x1000:], out.Code())
		copy(result[offset:], out.Data())
		return result
	}

	func targetEntry(out *RTGEmitter, count int, state int) bool { _ = out; _ = state; return count == 0 }
	func targetImage(out *RTGEmitter) []byte {
		for i := 0; i < out.AbsoluteRelocationCount(); i++ {
			at := out.AbsoluteRelocationOffset(i)
			target, ok := RTGResolveAbsoluteRelocation(out, out.AbsoluteRelocationKind(i), out.AbsoluteRelocationAddend(i), elfDataAddress(out), elfBssAddress(out))
			if !ok {
				return nil
			}
			reg := (RTGGet32At(out.Code(), at) >> 12) & 15
			for part := 0; part < 2; part++ {
				value := (target >> uint(part*16)) & 65535
				out.PatchUint32(at+part*4, 0xe3000000|(part<<22)|((value&0xf000)<<4)|(reg<<12)|(value&4095))
			}
			out.PatchUint32(at+8, 0xe1a00000)
		}
		return elfImage(out, 40, 0x05800000, 32, true)
	}
}

arch arm {
	alias = "arm"
	endian = big
	word_bits = 32
	pointer_bits = 32
	instruction_alignment = 4
	patch_relocations = arm32_labels
	registers gpr32 = [r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12, r13, r14, r15]
	locations {
		primary = r0
		secondary = r1
		tertiary = r2
		system = r7
		scratch = r9
		scratch2 = r10
		address = r12
		copy_destination = r3
		copy_source = r4
		copy_count = r1
		frame = r11
		stack = r13
		link = r14
	}
	conditions {
		eq = 0
		ne = 1
		uge = 2
		ult = 3
		ugt = 8
		ule = 9
		sge = 10
		slt = 11
		sgt = 12
		sle = 13
	}
	forms {
		binary = word32(destination:reg@12+16, source:reg@0)
		multiply = word32(destination:reg@0+16, source:reg@8)
		compare = word32(left:reg@16, right:reg@0)
		unary = word32(operand:reg@12+16)
		register = word32(operand:reg@0)
		branch = word32(label:label@reloc)
		conditional_branch = word32(condition:condition@28, label:label@reloc)
		fixed = bytes
	}
	instructions {
		add = go arm_beBeAdd
		subtract = go arm_beBeSubtract
		multiply = go arm_beBeMultiply
		bit_and = go arm_beBeBitAnd
		bit_or = go arm_beBeBitOr
		bit_xor = go arm_beBeBitXor
		compare = go arm_beBeCompare
		test = go arm_beBeTest
		increment = go arm_beBeIncrement
		decrement = go arm_beBeDecrement
		call_indirect = go arm_beBeCallIndirect
		call = go arm_beBeCall
		jump = go arm_beBeJump
		jump_condition = go arm_beBeJumpCondition
		return fixed [0x1e, 0xff, 0x2f, 0xe1]
		leave fixed [0x0b, 0xd0, 0xa0, 0xe1, 0x00, 0x48, 0xbd, 0xe8]
	}
	bind {
		move = sequence arm_beMove
		address = go arm_beEmitAddress
		load.native = go arm_beLoadNative
		load.i32 = go arm_beLoadI32
		load.u32 = go arm_beLoadU32
		load.i16 = go arm_beLoadI16
		load.u16 = go arm_beLoadU16
		load.i8 = go arm_beLoadI8
		load.u8 = go arm_beLoadU8
		store.native = go arm_beStoreNative
		store.u32 = go arm_beStoreU32
		store.u16 = go arm_beStoreU16
		store.u8 = go arm_beStoreU8
		add = add
		subtract = subtract
		multiply = multiply
