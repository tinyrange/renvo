		aarch64_beAsmCmpRegReg(a:emitter, left:int, right:int) {
			aarch64_beAsmEmit(a, 0xeb00001f |(right << 16) |(left << 5))
		}
		aarch64_beAsmCsetRax(a:emitter, cond:int) {
