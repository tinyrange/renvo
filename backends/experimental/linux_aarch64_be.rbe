	relocation branch26 {
		width = 4
		signed = true
		scale = 4
		bits = 26
		relative_to = instruction
	}
	relocation branch19 {
		width = 4
		signed = true
		scale = 4
		bits = 19
		relative_to = instruction
	}
	relocation address21 {
		width = 4
		signed = true
		scale = 1
		bits = 21
		relative_to = instruction
	}
	sequences {
		aarch64_beAsmAddRaxRcx(a:emitter) {
