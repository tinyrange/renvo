			aarch64_beAsmEmit(a, 0xd65f03c0)
		}
		aarch64_beAsmSarRaxImm(a:emitter, imm:int) {
			aarch64_beAsmEmit(a, 0x9340fc00 |(imm << 16))
		}
		aarch64_beAsmShlRaxImm(a:emitter, imm:int) {
			aarch64_beAsmEmit(a, 0xd3400000 |((64 - imm) << 16) |((63 - imm) << 10))
		}
		aarch64_beAsmShlRcxImm(a:emitter, imm:int) {
			aarch64_beAsmEmit(a, 0xd3400000 |((64 - imm) << 16) |((63 - imm) << 10) |(aarch64Tertiary.Code << 5) | aarch64Tertiary.Code)
		}
		aarch64_beAsmStoreAlMemRdxRcx1(a:emitter) {
			aarch64_beAsmAddRegRegShift(a, aarch64Address.Code, aarch64Secondary.Code, aarch64Tertiary.Code, 0)
			aarch64_beAsmStoreRegMem(a, aarch64Primary.Code, aarch64Address.Code, 0, 1)
		}
		aarch64_beAsmStoreRaxBss(a:emitter, bssOff:int) {
			aarch64_beAsmMovRegAbs(a, aarch64Address.Code, bssOff, RTGRelocationAbsoluteBSS)
			aarch64_beAsmStoreRegMem(a, aarch64Primary.Code, aarch64Address.Code, 0, 8)
		}
		aarch64_beAsmStoreRaxMemRdxDisp(a:emitter, disp:int) {
			aarch64_beAsmStoreRegMem(a, aarch64Primary.Code, aarch64Secondary.Code, disp, 8)
		}
		aarch64_beAsmStoreRaxMemRdxDispSize(a:emitter, disp:int, size:int) {
			aarch64_beAsmStoreRegMem(a, aarch64Primary.Code, aarch64Secondary.Code, disp, size)
		}
		aarch64_beAsmStoreRaxMemRdxRcx8(a:emitter) {
			aarch64_beAsmAddRegRegShift(a, aarch64Address.Code, aarch64Secondary.Code, aarch64Tertiary.Code, 3)
			aarch64_beAsmStoreRegMem(a, aarch64Primary.Code, aarch64Address.Code, 0, 8)
		}
		aarch64_beAsmStoreRegStack(a:emitter, src:int, offset:int) {
			aarch64_beAsmStoreRegMem(a, src, aarch64Frame.Code, -offset, 8)
		}
		aarch64_beAsmStoreSliceStack(a:emitter, offset:int) {
			aarch64_beAsmStoreRegStack(a, aarch64Primary.Code, offset)
			aarch64_beAsmStoreRegStack(a, aarch64Secondary.Code, offset - 8)
			aarch64_beAsmStoreRegStack(a, aarch64Tertiary.Code, offset - 16)
		}
		aarch64_beAsmSubRaxRcx(a:emitter) {
			aarch64_beAsmSubRegReg(a, aarch64Primary.Code, aarch64Primary.Code, aarch64Tertiary.Code)
		}
		aarch64_beAsmSubRegReg(a:emitter, dst:int, left:int, right:int) {
			aarch64_beAsmEmit(a, 0xcb000000 |(right << 16) |(left << 5) | dst)
		}
		aarch64_beAsmSyscall(a:emitter) {
			aarch64_beAsmMovRegReg(a, aarch64System.Code, aarch64Primary.Code)
			aarch64_beAsmMovRegReg(a, aarch64Scratch.Code, aarch64Secondary.Code)
			aarch64_beAsmMovRegReg(a, 0, aarch64X3.Code)
			aarch64_beAsmMovRegReg(a, 1, aarch64X4.Code)
			aarch64_beAsmMovRegReg(a, 2, aarch64Scratch.Code)
			aarch64_beAsmMovRegReg(a, 3, aarch64X7.Code)
			aarch64_beAsmEmit(a, 0xd4000001)
		}
		aarch64_beAsmBCondLabel(a:emitter, label:int, cond:int) {
			let at = a.Len()
			aarch64_beAsmEmit(a, 0x54000000 | cond)
			a.RelocAt(at, label)
		}
		aarch64_beAsmCallLabel(a:emitter, label:int) {
			let at = a.Len()
			aarch64_beAsmEmit(a, 0x94000000)
			a.RelocAt(at, label)
		}
		aarch64_beAsmCmpRcxRaxSet(a:emitter, setcc:int) {
			aarch64_beAsmCmpRegReg(a, aarch64Tertiary.Code, aarch64Primary.Code)
			let cond = aarch64_beCondFromSetcc(setcc)
			aarch64_beAsmCsetRax(a, cond)
		}
		aarch64_beAsmJmpLabel(a:emitter, label:int) {
			let at = a.Len()
			aarch64_beAsmEmit(a, 0x14000000)
			a.RelocAt(at, label)
		}
		aarch64_beAsmMovRegAbs(a:emitter, reg:int, off:int, kind:int) {
			let at = a.Len()
			aarch64_beAsmMovRegImm(a, reg, 0)
			aarch64_beAsmEmit(a, 0xf2800000 |(1 << 21) | reg)
			aarch64_beAsmEmit(a, 0xf2800000 |(2 << 21) | reg)
			aarch64_beAsmEmit(a, 0xf2800000 |(3 << 21) | reg)
			a.AbsoluteReloc(at, off, kind)
		}
		aarch64_beCopyBytes(out:emitter) {
			let destination = aarch64X3
			let source = aarch64X4
			let count = aarch64Secondary
			let value = aarch64Scratch2
			let forward = out.NewLabel()
			let forwardLoop = out.NewLabel()
			let backwardLoop = out.NewLabel()
			let done = out.NewLabel()
			aarch64Compare(out, destination, source)
			aarch64JumpCondition(out, record_condition(Code:9), forward)
			aarch64_beEmitAddress(out, aarch64Scratch, record_address(Base:source, Index:count, Scale:1,))
			aarch64Compare(out, destination, aarch64Scratch)
			aarch64JumpCondition(out, record_condition(Code:2), forward)
			aarch64_beEmitAddress(out, source, record_address(Base:source, Index:count, Scale:1, Displacement:-1,))
			aarch64_beEmitAddress(out, destination, record_address(Base:destination, Index:count, Scale:1, Displacement:-1,))
			out.Mark(backwardLoop)
			aarch64Compare(out, count, aarch64Zero)
			aarch64JumpCondition(out, record_condition(Code:0), done)
			aarch64_beLoadU8(out, value, record_address(Base:source))
			aarch64_beStoreU8(out, record_address(Base:destination), value)
			aarch64Decrement(out, source)
			aarch64Decrement(out, destination)
			aarch64Decrement(out, count)
			aarch64Jump(out, backwardLoop)
			out.Mark(forward)
			out.Mark(forwardLoop)
			aarch64Compare(out, count, aarch64Zero)
			aarch64JumpCondition(out, record_condition(Code:0), done)
			aarch64_beLoadU8(out, value, record_address(Base:source))
			aarch64_beStoreU8(out, record_address(Base:destination), value)
			aarch64Increment(out, source)
			aarch64Increment(out, destination)
			aarch64Decrement(out, count)
			aarch64Jump(out, forwardLoop)
			out.Mark(done)
		}
		aarch64_beFrameStart(out:emitter) -> int {
			aarch64_beAsmEmit(out, 0xa9bf7bfd)
			aarch64_beAsmEmit(out, 0x910003fd)
			let at = out.Len()
			aarch64_beAsmEmit(out, 0xd503201f)
			aarch64_beAsmEmit(out, 0xd503201f)
			return at
		}
		aarch64_beHostSyscall(out:emitter) {
			aarch64_beAsmEmit(out, 0xd4000001)
		}
		aarch64_beMove(out:emitter, destination:register, source:register) {
			aarch64_beAsmMovRegReg(out, destination.Code, source.Code)
		}
		aarch64_beMoveImmediate(out:emitter, destination:register, value:int64) {
			aarch64_beAsmMovRegImm(out, destination.Code, int(value))
		}
		aarch64_beSetCondition(out:emitter, condition:condition, destination:register) {
			aarch64_beAsmEmit(out, 0x9a9f07e0 |((condition.Code ^ 1) << 12) | destination.Code)
		}
		aarch64_beShiftLeftImmediate(out:emitter, operand:register, value:byte) {
			let shift = int(value) & 63
			aarch64_beAsmEmit(out, 0xd3400000 |((64 - shift) << 16) |((63 - shift) << 10) |(operand.Code << 5) | operand.Code)
		}
		aarch64_beShiftRightSignedImmediate(out:emitter, operand:register, value:byte) {
			aarch64_beAsmEmit(out, 0x9340fc00 |((int(value) & 63) << 16) |(operand.Code << 5) | operand.Code)
		}
		aarch64_beShiftRightUnsignedImmediate(out:emitter, operand:register, value:byte) {
			aarch64_beAsmEmit(out, 0xd340fc00 |((int(value) & 63) << 16) |(operand.Code << 5) | operand.Code)
		}
		aarch64_beEmitADR(out:emitter, destination:register, address:address) {
			let at = out.Len()
			aarch64_beAsmEmit(out, 0x90000000 | destination.Code)
			aarch64_beAsmEmit(out, 0xd503201f)
			aarch64_beAsmEmit(out, 0xd503201f)
			aarch64_beAsmEmit(out, 0xd503201f)
			RTGAddressRelocAt(out, address, at)
		}
		aarch64_beLoadI16(out:emitter, destination:register, address:address) {
			aarch64_beLoadWidth(out, destination, address, 2, true)
		}
		aarch64_beLoadI32(out:emitter, destination:register, address:address) {
			aarch64_beLoadWidth(out, destination, address, 4, true)
		}
		aarch64_beLoadI8(out:emitter, destination:register, address:address) {
			aarch64_beLoadWidth(out, destination, address, 1, true)
		}
		aarch64_beLoadNative(out:emitter, destination:register, address:address) {
			aarch64_beLoadWidth(out, destination, address, 8, false)
		}
		aarch64_beLoadU16(out:emitter, destination:register, address:address) {
			aarch64_beLoadWidth(out, destination, address, 2, false)
		}
		aarch64_beLoadU32(out:emitter, destination:register, address:address) {
			aarch64_beLoadWidth(out, destination, address, 4, false)
		}
		aarch64_beLoadU8(out:emitter, destination:register, address:address) {
			aarch64_beLoadWidth(out, destination, address, 1, false)
		}
		aarch64_beStoreNative(out:emitter, address:address, source:register) {
			aarch64_beStoreWidth(out, address, source, 8)
		}
		aarch64_beStoreU16(out:emitter, address:address, source:register) {
			aarch64_beStoreWidth(out, address, source, 2)
		}
		aarch64_beStoreU32(out:emitter, address:address, source:register) {
			aarch64_beStoreWidth(out, address, source, 4)
		}
		aarch64_beStoreU8(out:emitter, address:address, source:register) {
			aarch64_beStoreWidth(out, address, source, 1)
		}
	}
}
abi aapcs64 {
	arch = aarch64
	frame_start = sequence aarch64_beFrameStart
	frame_finish = go aarch64_beFrameFinish
	push_register = go aarch64_beAapcs64PushRegister
	push_immediate = go aarch64_beAapcs64PushImmediate
	pop_register = go aarch64_beAapcs64PopRegister
	unsigned_divide = go aarch64_beAapcs64UnsignedDivide
	store_param_word = go aarch64_beAapcs64StoreParamWord
	call_word_count = go aarch64_beAapcs64CallWordCount
	call_words = [x3, x4, x1, x2, x5, x6]
	arguments = [x0, x1, x2, x3, x4, x5, x6, x7]
	result = [x0, x1]
	stack_alignment = 16
}
runtime linux_aarch64_be {
	emit_entry = go targetEntry
	syscall {
		number = x8
		arguments = [x0, x1, x2, x3, x4, x5]
		result = x0
		instruction = svc
	}
	operation read {
		number = 63 args = [fd, buffer, count]
	}
	operation write {
		number = 64 args = [fd, buffer, count]
	}
	operation read_at {
		number = 67 args = [fd, buffer, count, offset]
	}
	operation write_at {
		number = 68 args = [fd, buffer, count, offset]
	}
	operation open {
		number = 56 args = [dirfd, path, flags, mode]
	}
	operation close {
		number = 57 args = [fd]
	}
	operation chmod {
		number = 52 args = [fd, mode]
	}
	operation print {
		use = write args = [stderr, buffer, count]
	}
	operation exit {
		number = 93 args = [status] noreturn = true
	}
}
format elf_aarch64_be {
	kind = elf
	byte_order = big
	address_bits = 64
	code_offset = 0
	image = go targetImage
}
target experimental/linux-aarch64_be {
	family = native_v1
	os = linux
	arch = aarch64
	abi = aapcs64
	runtime = linux_aarch64_be
	executable = elf_aarch64_be
	arena_default = 16777216
	build_tags = [linux, unix, aarch64, arm64]
	capabilities = [hosted, executable, filesystem, heap]
}
