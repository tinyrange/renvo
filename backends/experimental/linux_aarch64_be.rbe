# Self-contained Linux backend. Copy this file to use or extend this target.
definition 1
unit linux_aarch64_be
implements direct_emitter_v1
go backend {
	func aarch64_beBeAdd(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		RTGUint32(out, 0x8b000000|(destination.Code<<0)|(destination.Code<<5)|(source.Code<<16))
	}
	func aarch64_beBeSubtract(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		RTGUint32(out, 0xcb000000|(destination.Code<<0)|(destination.Code<<5)|(source.Code<<16))
	}
	func aarch64_beBeMultiply(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		RTGUint32(out, 0x9b007c00|(destination.Code<<0)|(destination.Code<<5)|(source.Code<<16))
	}
	func aarch64_beBeBitAnd(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		RTGUint32(out, 0x8a000000|(destination.Code<<0)|(destination.Code<<5)|(source.Code<<16))
	}
	func aarch64_beBeBitOr(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		RTGUint32(out, 0xaa000000|(destination.Code<<0)|(destination.Code<<5)|(source.Code<<16))
	}
	func aarch64_beBeBitXor(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		RTGUint32(out, 0xca000000|(destination.Code<<0)|(destination.Code<<5)|(source.Code<<16))
	}
	func aarch64_beBeCompare(out *RTGEmitter, left RTGRegister, right RTGRegister) {
		RTGUint32(out, 0xeb00001f|(left.Code<<5)|(right.Code<<16))
	}
	func aarch64_beBeTest(out *RTGEmitter, left RTGRegister, right RTGRegister) {
		RTGUint32(out, 0xea00001f|(left.Code<<5)|(right.Code<<16))
	}
	func aarch64_beBeIncrement(out *RTGEmitter, operand RTGRegister) {
		RTGUint32(out, 0x91000400|(operand.Code<<0)|(operand.Code<<5))
	}
	func aarch64_beBeDecrement(out *RTGEmitter, operand RTGRegister) {
		RTGUint32(out, 0xd1000400|(operand.Code<<0)|(operand.Code<<5))
	}
	func aarch64_beBeCallIndirect(out *RTGEmitter, operand RTGRegister) {
		RTGUint32(out, 0xd63f0000|(operand.Code<<5))
	}
	func aarch64_beBeCall(out *RTGEmitter, label RTGLabel) {
		RTGUint32(out, 0x94000000)
		RTGReloc(out, label)
	}
	func aarch64_beBeJump(out *RTGEmitter, label RTGLabel) {
		RTGUint32(out, 0x14000000)
		RTGReloc(out, label)
	}
	func aarch64_beBeJumpCondition(out *RTGEmitter, condition RTGCondition, label RTGLabel) {
		RTGUint32(out, 0x54000000|(condition.Code<<0))
		RTGReloc(out, label)
	}
	func aarch64_beAsmAlign(a *RTGEmitter) {
		for a.Len()%4 != 0 {
			RTGByte(a, 0)
		}
	}

	func aarch64_beAsmMovRegReg(a *RTGEmitter, dst int, src int) {
		if dst == src {
			return
		}
		aarch64_beAsmEmit(a, 0xaa0003e0|(src<<16)|dst)
	}

	func aarch64_beAsmMovRegImm(a *RTGEmitter, reg int, imm int) {
		if imm < 0 {
			inv := -imm - 1
			part := inv & 65535
			aarch64_beAsmEmit(a, 0x92800000|(part<<5)|reg)
			for i := 1; i < 4; i++ {
				targetPart := (imm >> (i * 16)) & 65535
				if targetPart != 65535 {
					aarch64_beAsmEmit(a, 0xf2800000|(i<<21)|(targetPart<<5)|reg)
				}
			}
			return
		}
		part := imm & 65535
		aarch64_beAsmEmit(a, 0xd2800000|(part<<5)|reg)
		for i := 1; i < 4; i++ {
			part = (imm >> (i * 16)) & 65535
			if part != 0 {
				aarch64_beAsmEmit(a, 0xf2800000|(i<<21)|(part<<5)|reg)
			}
		}
	}

	func aarch64_beAsmPatchMovRegImmAt(a *RTGEmitter, at int, reg int, imm int) {
		part := imm & 65535
		a.PatchUint32(at, 0xd2800000|(part<<5)|reg)
		for i := 1; i < 4; i++ {
			part = (imm >> (i * 16)) & 65535
			a.PatchUint32(at+i*4, 0xf2800000|(i<<21)|(part<<5)|reg)
		}
	}

	func aarch64_beAsmAddRegImm(a *RTGEmitter, dst int, src int, imm int) {
		if imm == 0 {
			aarch64_beAsmMovRegReg(a, dst, src)
			return
		}
		op := 0x91000000
		if imm < 0 {
			op = 0xd1000000
			imm = -imm
		}
		cur := src
		for imm > 0 {
			shift := 0
			chunk := imm
			if chunk > 4095 {
				chunk = imm / 4096
				if chunk > 4095 {
					chunk = 4095
				}
				shift = 1
				imm = imm - chunk*4096
			} else {
				imm = 0
			}
			aarch64_beAsmEmit(a, op|(shift<<22)|(chunk<<10)|(cur<<5)|dst)
			cur = dst
		}
	}

	func aarch64_beAsmAddr(a *RTGEmitter, base int, disp int) int {
		if disp == 0 {
			return base
		}
		aarch64_beAsmAddRegImm(a, aarch64Address.Code, base, disp)
		return aarch64Address.Code
	}

	func aarch64_beAsmLoadRegMem(a *RTGEmitter, dst int, base int, disp int, size int) {
		if disp != 0 && disp >= -256 && disp <= 255 {
			imm := (disp & 511) << 12
			if size == 1 {
				aarch64_beAsmEmit(a, 0x38400000|imm|(base<<5)|dst)
				return
			}
			if size == 2 {
				aarch64_beAsmEmit(a, 0x78400000|imm|(base<<5)|dst)
				return
			}
			if size == 4 {
				aarch64_beAsmEmit(a, 0xb8400000|imm|(base<<5)|dst)
				return
			}
			aarch64_beAsmEmit(a, 0xf8400000|imm|(base<<5)|dst)
			return
		}
		addr := aarch64_beAsmAddr(a, base, disp)
		if size == 1 {
			aarch64_beAsmEmit(a, 0x39400000|(addr<<5)|dst)
			return
		}
		if size == 2 {
			aarch64_beAsmEmit(a, 0x79800000|(addr<<5)|dst)
			return
		}
		if size == 4 {
			aarch64_beAsmEmit(a, 0xb9800000|(addr<<5)|dst)
			return
		}
		aarch64_beAsmEmit(a, 0xf9400000|(addr<<5)|dst)
	}

	func aarch64_beAsmStoreRegMem(a *RTGEmitter, src int, base int, disp int, size int) {
		if disp != 0 && disp >= -256 && disp <= 255 {
			imm := (disp & 511) << 12
			if size == 1 {
				aarch64_beAsmEmit(a, 0x38000000|imm|(base<<5)|src)
				return
			}
			if size == 2 {
				aarch64_beAsmEmit(a, 0x78000000|imm|(base<<5)|src)
				return
			}
			if size == 4 {
				aarch64_beAsmEmit(a, 0xb8000000|imm|(base<<5)|src)
				return
			}
			aarch64_beAsmEmit(a, 0xf8000000|imm|(base<<5)|src)
			return
		}
		addr := aarch64_beAsmAddr(a, base, disp)
		if size == 1 {
			aarch64_beAsmEmit(a, 0x39000000|(addr<<5)|src)
			return
		}
		if size == 2 {
			aarch64_beAsmEmit(a, 0x79000000|(addr<<5)|src)
			return
		}
		if size == 4 {
			aarch64_beAsmEmit(a, 0xb9000000|(addr<<5)|src)
			return
		}
		aarch64_beAsmEmit(a, 0xf9000000|(addr<<5)|src)
	}

	func aarch64_beAsmStackMem(a *RTGEmitter, offset int, base int, disp8 int, disp32 int) {
		if base == 0x8948 && disp8 == 0x45 {
			aarch64_beAsmStoreRegStack(a, aarch64Primary.Code, offset)
			return
		}
		if base == 0x8948 && disp8 == 0x55 {
			aarch64_beAsmStoreRegStack(a, aarch64Secondary.Code, offset)
			return
		}
		if base == 0x8948 && disp8 == 0x4d {
			aarch64_beAsmStoreRegStack(a, aarch64Tertiary.Code, offset)
			return
		}
		if base == 0x8b48 && disp8 == 0x45 {
			aarch64_beAsmLoadRegStack(a, aarch64Primary.Code, offset)
			return
		}
		if base == 0x8b48 && disp8 == 0x55 {
			aarch64_beAsmLoadRegStack(a, aarch64Secondary.Code, offset)
			return
		}
		if base == 0x8b48 && disp8 == 0x4d {
			aarch64_beAsmLoadRegStack(a, aarch64Tertiary.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x45 {
			aarch64_beAsmLeaRegStack(a, aarch64Primary.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x55 {
			aarch64_beAsmLeaRegStack(a, aarch64Secondary.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x7d {
			aarch64_beAsmLeaRegStack(a, aarch64X3.Code, offset)
			return
		}
		if base == 0x8d48 && disp8 == 0x75 {
			aarch64_beAsmLeaRegStack(a, aarch64X4.Code, offset)
			return
		}
	}

	func aarch64_beAsmMemDisp(a *RTGEmitter, disp int, op int, disp8 int, disp32 int) {
		if op == 0x8b48 && disp8 == 0x4a {
			aarch64_beAsmLoadRegMem(a, aarch64Tertiary.Code, aarch64Secondary.Code, disp, 8)
			return
		}
		if op == 0x8b48 && disp8 == 0x52 {
			aarch64_beAsmLoadRegMem(a, aarch64Secondary.Code, aarch64Secondary.Code, disp, 8)
			return
		}
	}

	func aarch64_beAsmLoadRaxIndexRcxSize(a *RTGEmitter, size int) {
		shift := 3
		if size == 1 {
			shift = 0
		}
		if size == 2 {
			shift = 1
		}
		if size == 4 {
			shift = 2
		}
		aarch64_beAsmAddRegRegShift(a, aarch64Address.Code, aarch64Primary.Code, aarch64Tertiary.Code, shift)
		aarch64_beAsmLoadRegMem(a, aarch64Primary.Code, aarch64Address.Code, 0, size)
	}

	func aarch64_beAsmNormalizeRaxForKind(a *RTGEmitter, kind int) {
		if kind == RTGScalarByte {
			aarch64_beAsmEmit(a, 0x92401c00)
			return
		}
		if kind == RTGScalarInt8 {
			aarch64_beAsmEmit(a, 0x93401c00)
			return
		}
		if kind == RTGScalarInt16 {
			aarch64_beAsmEmit(a, 0x93403c00)
			return
		}
		if kind == RTGScalarUint16 {
			aarch64_beAsmEmit(a, 0x92403c00)
			return
		}
		if kind == RTGScalarInt32 {
			aarch64_beAsmEmit(a, 0x93407c00)
			return
		}
		if kind == RTGScalarUint32 {
			aarch64_beAsmEmit(a, 0x92407c00)
		}
	}

	func aarch64_beAsmCmpRegImm(a *RTGEmitter, reg int, imm int) {
		if imm >= 0 && imm <= 4095 {
			aarch64_beAsmEmit(a, 0xf100001f|(imm<<10)|(reg<<5))
			return
		}
		aarch64_beAsmMovRegImm(a, aarch64Scratch.Code, imm)
		aarch64_beAsmCmpRegReg(a, reg, aarch64Scratch.Code)
	}

	func aarch64_beAsmDivLeftRcxRightRax(a *RTGEmitter, mod bool) {
		aarch64_beAsmMovRegReg(a, aarch64Scratch.Code, aarch64Primary.Code)
		aarch64_beAsmEmit(a, 0x9ac00c40)
		if mod {
			aarch64_beAsmEmit(a, 0x9b098800)
		}
	}

	func aarch64_beCondFromSetcc(setcc int) int {
		if setcc == 0x94 {
			return 0
		}
		if setcc == 0x95 {
			return 1
		}
		if setcc == 0x92 {
			return 3
		}
		if setcc == 0x93 {
			return 2
		}
		if setcc == 0x96 {
			return 9
		}
		if setcc == 0x97 {
			return 8
		}
		if setcc == 0x9c {
			return 11
		}
		if setcc == 0x9e {
			return 13
		}
		if setcc == 0x9f {
			return 12
		}
		return 10
	}

	func aarch64_beAsmStoreRaxMemRdxRcxSize(a *RTGEmitter, size int) {
		shift := 3
		if size == 1 {
			shift = 0
		}
		if size == 2 {
			shift = 1
		}
		if size == 4 {
			shift = 2
		}
		aarch64_beAsmAddRegRegShift(a, aarch64Address.Code, aarch64Secondary.Code, aarch64Tertiary.Code, shift)
		aarch64_beAsmStoreRegMem(a, aarch64Primary.Code, aarch64Address.Code, 0, size)
	}

	func aarch64_beEmitAddress(out *RTGEmitter, destination RTGRegister, memory RTGAddress) {
		if RTGAddressValid(memory) {
			aarch64_beEmitADR(out, destination, memory)
			return
		}
		base := memory.Base.Code
		if memory.Index.Valid {
			shift := 0
			if memory.Scale == 2 {
				shift = 1
			} else {
				if memory.Scale == 4 {
					shift = 2
				} else {
					if memory.Scale == 8 {
						shift = 3
					}
				}
			}
			aarch64_beAsmAddRegRegShift(
				out, destination.Code, base, memory.Index.Code, shift)
			base = destination.Code
		}
		aarch64_beAsmAddRegImm(
			out, destination.Code, base, memory.Displacement)
	}

	func aarch64_beMemoryBase(out *RTGEmitter, memory RTGAddress) int {
		if RTGAddressValid(memory) || memory.Index.Valid {
			aarch64_beEmitAddress(out, aarch64Address, memory)
			return aarch64Address.Code
		}
		if memory.Displacement < -256 || memory.Displacement > 255 {
			aarch64_beEmitAddress(out, aarch64Address, memory)
			return aarch64Address.Code
		}
		return memory.Base.Code
	}

	func aarch64_beLoadWidth(
		out *RTGEmitter,
		destination RTGRegister,
		memory RTGAddress,
		size int,
		signed bool,
	) {
		base := aarch64_beMemoryBase(out, memory)
		displacement := memory.Displacement
		if base == aarch64Address.Code {
			displacement = 0
		}
		imm := (displacement & 511) << 12
		op := 0xf8400000
		if size == 1 {
			op = 0x38400000
			if signed {
				op = 0x38800000
			}
		} else {
			if size == 2 {
				op = 0x78400000
				if signed {
					op = 0x78800000
				}
			} else {
				if size == 4 {
					op = 0xb8400000
					if signed {
						op = 0xb8800000
					}
				}
			}
		}
		aarch64_beAsmEmit(
			out, op|imm|(base<<5)|destination.Code)
	}

	func aarch64_beStoreWidth(
		out *RTGEmitter,
		memory RTGAddress,
		source RTGRegister,
		size int,
	) {
		base := aarch64_beMemoryBase(out, memory)
		displacement := memory.Displacement
		if base == aarch64Address.Code {
			displacement = 0
		}
		imm := (displacement & 511) << 12
		op := 0xf8000000
		if size == 1 {
			op = 0x38000000
		} else {
			if size == 2 {
				op = 0x78000000
			} else {
				if size == 4 {
					op = 0xb8000000
				}
			}
		}
		aarch64_beAsmEmit(out, op|imm|(base<<5)|source.Code)
	}

	func aarch64_beVariableShift(
		out *RTGEmitter, direction RTGShiftDirection, signed bool,
	) {
		op := 0x9ac02400
		if direction == RTGShiftLeft {
			op = 0x9ac02000
		} else {
			if signed {
				op = 0x9ac02800
			}
		}
		aarch64_beAsmEmit(out,
			op|(aarch64Primary.Code<<16)|
				(aarch64Tertiary.Code<<5)|aarch64Primary.Code)
	}

	func aarch64_beSignedDivide(out *RTGEmitter, remainder bool) {
		aarch64_beAsmMovRegReg(
			out, aarch64Scratch.Code, aarch64Primary.Code)
		aarch64_beAsmEmit(out,
			0x9ac00c00|(aarch64Primary.Code<<16)|
				(aarch64Tertiary.Code<<5)|aarch64Primary.Code)
		if remainder {
			aarch64_beAsmEmit(out,
				0x9b008000|(aarch64Scratch.Code<<16)|
					(aarch64Tertiary.Code<<10)|
					(aarch64Primary.Code<<5)|aarch64Primary.Code)
		}
	}

	func aarch64_beFrameFinish(out *RTGEmitter, at int, stackUsed int) {
		frame := (stackUsed + 15) & -16
		high := frame / 4096
		low := frame % 4096
		if high > 0 {
			out.PatchUint32(at, 0xd14003ff|(high<<10))
		}
		if low > 0 {
			out.PatchUint32(at+4, 0xd10003ff|(low<<10))
		}
	}

	func aarch64_beAapcs64PushRegister(out *RTGEmitter, source RTGRegister) {
		aarch64_beAsmEmit(out, 0xf81f0fe0|source.Code)
	}

	func aarch64_beAapcs64PushImmediate(out *RTGEmitter, value int) {
		aarch64_beAsmMovRegImm(out, aarch64Scratch.Code, value)
		aarch64_beAsmEmit(out, 0xf81f0fe0|aarch64Scratch.Code)
	}

	func aarch64_beAapcs64PopRegister(out *RTGEmitter, destination RTGRegister) {
		aarch64_beAsmEmit(out, 0xf84107e0|destination.Code)
	}

	func aarch64_beAapcs64UnsignedDivide(out *RTGEmitter, remainder bool) bool {
		aarch64_beAsmMovRegReg(out, aarch64Scratch.Code, aarch64Primary.Code)
		aarch64_beAsmEmit(out, 0x9ac00840)
		if remainder {
			aarch64_beAsmEmit(out, 0x9b098800)
		}
		return true
	}

	func aarch64_beAapcs64StoreParamWord(out *RTGEmitter, word int, offset int) {
		if word < 6 {
			aarch64_beAsmStoreRegStack(out, word, offset)
			return
		}
		// Every pushed AArch64 call word occupies a 16-byte aligned slot.
		// FP points below the saved FP/LR pair, so stacked arguments begin
		// at FP+16 and retain that same stride.
		aarch64_beAsmLoadRegMem(out, aarch64Scratch.Code, aarch64Frame.Code,
			16+(word-6)*16, 8)
		aarch64_beAsmStoreRegStack(out, aarch64Scratch.Code, offset)
	}

	func aarch64_beAapcs64CallWordCount(out *RTGEmitter, label RTGLabel, wordCount int) {
		limit := wordCount
		if limit > 6 {
			limit = 6
		}
		for i := 0; i < limit; i++ {
			aarch64_beAapcs64PopRegister(out, RTGRegister{Code: i, Valid: true})
		}
		aarch64_beAsmCallLabel(out, label)
		if wordCount > 6 {
			aarch64_beAsmAddRegImm(out, 31, 31, (wordCount-6)*16)
		}
	}

	const elfCodeAddress = 0x11000

	func elfDataOffset(out *RTGEmitter) int  { return RTGAlignValue(0x1000+len(out.Code()), 0x10000) }
	func elfDataAddress(out *RTGEmitter) int { return 0x10000 + elfDataOffset(out) }
	func elfBssAddress(out *RTGEmitter) int {
		return RTGAlignValue(elfDataAddress(out)+len(out.Data()), 16)
	}
	func elfPut(image []byte, at int, value uint64, width int, big bool) {
		for i := 0; i < width; i++ {
			shift := i * 8
			if big {
				shift = (width - 1 - i) * 8
			}
			image[at+i] = byte(value >> uint(shift))
		}
	}
	func elfImage(out *RTGEmitter, machine int, flags int, bits int, big bool) []byte {
		offset := elfDataOffset(out)
		result := make([]byte, offset+len(out.Data()))
		result[0] = 0x7f
		result[1] = 'E'
		result[2] = 'L'
		result[3] = 'F'
		result[4] = 1
		if bits == 64 {
			result[4] = 2
		}
		result[5] = 1
		if big {
			result[5] = 2
		}
		result[6] = 1
		elfPut(result, 16, 2, 2, big)
		elfPut(result, 18, uint64(machine), 2, big)
		elfPut(result, 20, 1, 4, big)
		if bits == 32 {
			elfPut(result, 24, elfCodeAddress, 4, big)
			elfPut(result, 28, 52, 4, big)
			elfPut(result, 36, uint64(flags), 4, big)
			elfPut(result, 40, 52, 2, big)
			elfPut(result, 42, 32, 2, big)
			elfPut(result, 44, 2, 2, big)
		} else {
			elfPut(result, 24, elfCodeAddress, 8, big)
			elfPut(result, 32, 64, 8, big)
			elfPut(result, 48, uint64(flags), 4, big)
			elfPut(result, 52, 64, 2, big)
			elfPut(result, 54, 56, 2, big)
			elfPut(result, 56, 2, 2, big)
		}
		for i := 0; i < 2; i++ {
			file := 0
			address := 0x10000
			size := 0x1000 + len(out.Code())
			memory := size
			permissions := 5
			if i == 1 {
				file = offset
				address = elfDataAddress(out)
				size = len(out.Data())
				memory = elfBssAddress(out) - address + out.BSSSize()
				permissions = 6
			}
			if bits == 32 {
				at := 52 + i*32
				elfPut(result, at, 1, 4, big)
				elfPut(result, at+4, uint64(file), 4, big)
				elfPut(result, at+8, uint64(address), 4, big)
				elfPut(result, at+12, uint64(address), 4, big)
				elfPut(result, at+16, uint64(size), 4, big)
				elfPut(result, at+20, uint64(memory), 4, big)
				elfPut(result, at+24, uint64(permissions), 4, big)
				elfPut(result, at+28, 0x10000, 4, big)
			} else {
				at := 64 + i*56
				elfPut(result, at, 1, 4, big)
				elfPut(result, at+4, uint64(permissions), 4, big)
				elfPut(result, at+8, uint64(file), 8, big)
				elfPut(result, at+16, uint64(address), 8, big)
				elfPut(result, at+24, uint64(address), 8, big)
				elfPut(result, at+32, uint64(size), 8, big)
				elfPut(result, at+40, uint64(memory), 8, big)
				elfPut(result, at+48, 0x10000, 8, big)
			}
		}
		copy(result[0x1000:], out.Code())
		copy(result[offset:], out.Data())
		return result
	}

	func targetEntry(out *RTGEmitter, count int, state int) bool { _ = out; _ = state; return count == 0 }
	func targetImage(out *RTGEmitter) []byte {
		for i := 0; i < out.AbsoluteRelocationCount(); i++ {
			at := out.AbsoluteRelocationOffset(i)
			target, ok := RTGResolveAbsoluteRelocation(out, out.AbsoluteRelocationKind(i), out.AbsoluteRelocationAddend(i), elfDataAddress(out), elfBssAddress(out))
			if !ok {
				return nil
			}
			register := RTGGet32At(out.Code(), at) & 31
			for part := 0; part < 4; part++ {
				opcode := 0xf2800000
				if part == 0 {
					opcode = 0xd2800000
				}
				out.PatchUint32(at+part*4, opcode|(part<<21)|(((target>>uint(part*16))&65535)<<5)|register)
			}
		}
		return elfImage(out, 183, 0, 64, true)
	}
}

arch aarch64 {
	alias = "aarch64"
	endian = big
	word_bits = 64
	pointer_bits = 64
	instruction_alignment = 4
	patch_relocations = aarch64_labels
	registers gpr64 = [x0, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, x11, x12, x13, x14, x15, x16, x17, x18, x19, x20, x21, x22, x23, x24, x25, x26, x27, x28, x29, x30, sp]
	locations {
		primary = x0
		secondary = x1
		tertiary = x2
		call_words = [x3, x4, x1, x2, x5, x6]
		system = x8
		scratch = x9
		scratch2 = x10
		address = x12
		copy_destination = x3
		copy_source = x4
		copy_count = x1
		frame = x29
		link = x30
		stack = sp
		zero = xzr
	}
	conditions {
		eq = 0
		ne = 1
		uge = 2
		ult = 3
		ugt = 8
		ule = 9
		sge = 10
		slt = 11
		sgt = 12
		sle = 13
	}
	forms {
		binary = word32(destination:reg@0+5, source:reg@16)
		compare = word32(left:reg@5, right:reg@16)
		unary = word32(operand:reg@0+5)
		register = word32(operand:reg@5)
		branch = word32(label:label@reloc)
		conditional_branch = word32(condition:condition@0, label:label@reloc)
