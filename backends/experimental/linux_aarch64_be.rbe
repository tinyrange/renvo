		subtract = go aarch64_beBeSubtract
		multiply = go aarch64_beBeMultiply
		bit_and = go aarch64_beBeBitAnd
		bit_or = go aarch64_beBeBitOr
		bit_xor = go aarch64_beBeBitXor
		compare = go aarch64_beBeCompare
		test = go aarch64_beBeTest
