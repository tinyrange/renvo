definition 1
unit remu_rp2040
implements direct_emitter_v1

@import "thumb_mcu.rtg"
@import "image32.rtg"

go backend {
	const textAddress = 0x10000000
	const dataAddress = 0x20000000
	const stackTop = 0x20042000

	func entry(out *RTGEmitter, stateOffset int) bool {
		return thumb_mcu.entry(out, stackTop)
	}
	func image(out *RTGEmitter) []byte {
		thumb_mcu.patchAbsolute(out, dataAddress, textAddress+0x100)
		return image32.ELF(out, 40, 0x05000000,
			textAddress, dataAddress, true)
	}
}

runtime remu_rp2040_runtime {
	emit_entry_start = go entry
	emit_exit = go thumb_mcu.exit
	operation write { emit = go thumb_mcu.write }
	operation print { use = write args = [stderr, buffer, count] }
}
format remu_rp2040_elf {
	kind = elf
	byte_order = little
	address_bits = 32
	machine = 40
	code_offset = 0x100
	image = go image
}
target experimental/rp2040 {
	family = native_v1
	os = rp2
	arch = thumb
	frontend_arch = thumb
	abi = thumb_internal
	runtime = remu_rp2040_runtime
	executable = remu_rp2040_elf
	build_tags = [rp2, rp2040, thumb, tiny]
	capabilities = [freestanding, executable, volatile_memory]
	arena_default = 65536
}

@stdlib "device/remu/target_rp2040.go"
//go:build renvo && rp2040

// Package remu exposes the direct-load memory contract of the selected
// renvo_emu target.
package remu

const Target = "rp2040"
const FlashStart uintptr = 0x10000000
const FlashSize uintptr = 16 * 1024 * 1024
const RAMStart uintptr = 0x20000000
const RAMSize uintptr = 264 * 1024
const GPIOCount = 30
@endstdlib
