# SPDX-License-Identifier: Apache-2.0
# Self-contained Linux backend. Copy this file to use or extend this target.
definition 1
unit linux_mipsn32el
implements direct_emitter_v1
go backend {
	var mips32MipsRelocationBase int
	var mips32MipsBigEndian bool

	func mips32MipsSetTargetCodeAddress(address int) {
		mips32MipsRelocationBase = address
	}
	func mips32MipsSetBigEndian(value bool) { mips32MipsBigEndian = value }

	func mips32MipsGetInstruction(out *RTGEmitter, at int) int {
		if !mips32MipsBigEndian {
			return RTGGet32At(out.Code(), at)
		}
		code := out.Code()
		return int(code[at])<<24 | int(code[at+1])<<16 | int(code[at+2])<<8 | int(code[at+3])
	}

	func mips32MipsPatchInstruction(out *RTGEmitter, at int, value int) {
		if !mips32MipsBigEndian {
			out.PatchUint32(at, value)
			return
		}
		code := out.Code()
		code[at] = byte(value >> 24)
		code[at+1] = byte(value >> 16)
		code[at+2] = byte(value >> 8)
		code[at+3] = byte(value)
	}

	func mips32MipsEmit(out *RTGEmitter, instruction int) {
		if !mips32MipsBigEndian {
			RTGUint32(out, instruction)
			return
		}
		RTGByte(out, byte(instruction>>24))
		RTGByte(out, byte(instruction>>16))
		RTGByte(out, byte(instruction>>8))
		RTGByte(out, byte(instruction))
	}

	func mips32MipsR(out *RTGEmitter, opcode int, source int, target int,
		destination int, shift int, function int) {
		mips32MipsEmit(out, (opcode<<26)|(source<<21)|(target<<16)|
			(destination<<11)|(shift<<6)|function)
	}

	func mips32MipsI(out *RTGEmitter, opcode int, source int, target int,
		immediate int) {
		mips32MipsEmit(out, (opcode<<26)|(source<<21)|(target<<16)|(immediate&0xffff))
	}

	func mips32MipsMove(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		if destination.Code != source.Code {
			mips32MipsR(out, 0, source.Code, 0, destination.Code, 0, 0x21)
		}
	}

	func mips32MipsMoveImmediate(out *RTGEmitter, destination RTGRegister, value int64) {
		immediate := int(value)
		if immediate >= -32768 && immediate <= 32767 {
			mips32MipsI(out, 0x09, 0, destination.Code, immediate)
			return
		}
		mips32MipsI(out, 0x0f, 0, destination.Code, immediate>>16)
		if immediate&0xffff != 0 {
			mips32MipsI(out, 0x0d, destination.Code, destination.Code, immediate)
		}
	}

	func mips32MipsEmitAddress(out *RTGEmitter, destination RTGRegister,
		value RTGAddress) {
		if RTGAddressValid(value) {
			at := out.Len()
			mips32MipsI(out, 0x0f, 0, destination.Code, 0)
			mips32MipsI(out, 0x0d, destination.Code, destination.Code, 0)
			RTGAddressRelocAt(out, value, at)
			return
		}
		base := value.Base
		if !base.Valid {
			base = mips32MipsZero()
		}
		if value.Index.Valid {
			shift := RTGLog2(value.Scale)
			mips32MipsR(out, 0, 0, value.Index.Code, mips32MipsAddress().Code, shift, 0)
			mips32MipsR(out, 0, base.Code, mips32MipsAddress().Code,
				destination.Code, 0, 0x21)
			base = destination
		}
		if value.Displacement >= -32768 && value.Displacement <= 32767 {
			mips32MipsI(out, 0x09, base.Code, destination.Code, value.Displacement)
			return
		}
		temporary := mips32MipsAddress()
		if destination.Code == temporary.Code || base.Code == temporary.Code {
			temporary = mips32MipsScratch()
		}
		mips32MipsMoveImmediate(out, temporary, int64(value.Displacement))
		mips32MipsR(out, 0, base.Code, temporary.Code, destination.Code, 0, 0x21)
	}

	func mips32MipsMaterializeAddress(out *RTGEmitter, value RTGAddress) RTGAddress {
		if !RTGAddressValid(value) && !value.Index.Valid &&
			value.Displacement >= -32768 && value.Displacement <= 32767 {
			return value
		}
		mips32MipsEmitAddress(out, mips32MipsAddress(), value)
		return RTGAddress{Base: mips32MipsAddress()}
	}

	func mips32MipsLoadWidth(out *RTGEmitter, destination RTGRegister,
		value RTGAddress, opcode int) {
		value = mips32MipsMaterializeAddress(out, value)
		base := value.Base
		if !base.Valid {
			base = mips32MipsZero()
		}
		mips32MipsI(out, opcode, base.Code, destination.Code, value.Displacement)
		// MIPS I exposes a one-instruction load delay. Keeping a harmless slot
		// here makes the shared emitter correct on the R3000A while remaining
		// valid on Allegrex, whose interlocks make the slot unnecessary.
		mips32MipsEmit(out, 0)
	}

	func mips32MipsStoreWidth(out *RTGEmitter, value RTGAddress,
		source RTGRegister, opcode int) {
		value = mips32MipsMaterializeAddress(out, value)
		base := value.Base
		if !base.Valid {
			base = mips32MipsZero()
		}
		mips32MipsI(out, opcode, base.Code, source.Code, value.Displacement)
	}

	func mips32MipsLoadNative(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		mips32MipsLoadWidth(out, destination, value, 0x23)
	}
	func mips32MipsLoadI32(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		mips32MipsLoadWidth(out, destination, value, 0x23)
	}
	func mips32MipsLoadU32(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		mips32MipsLoadWidth(out, destination, value, 0x23)
	}
	func mips32MipsLoadI16(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		mips32MipsLoadWidth(out, destination, value, 0x21)
	}
	func mips32MipsLoadU16(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		mips32MipsLoadWidth(out, destination, value, 0x25)
	}
	func mips32MipsLoadI8(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		mips32MipsLoadWidth(out, destination, value, 0x20)
	}
	func mips32MipsLoadU8(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		mips32MipsLoadWidth(out, destination, value, 0x24)
	}
	func mips32MipsStoreNative(out *RTGEmitter, value RTGAddress, source RTGRegister) {
		mips32MipsStoreWidth(out, value, source, 0x2b)
	}
	func mips32MipsStoreU32(out *RTGEmitter, value RTGAddress, source RTGRegister) {
		mips32MipsStoreWidth(out, value, source, 0x2b)
	}
	func mips32MipsStoreU16(out *RTGEmitter, value RTGAddress, source RTGRegister) {
		mips32MipsStoreWidth(out, value, source, 0x29)
	}
	func mips32MipsStoreU8(out *RTGEmitter, value RTGAddress, source RTGRegister) {
		mips32MipsStoreWidth(out, value, source, 0x28)
	}

	func mips32MipsAdd(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		mips32MipsR(out, 0, destination.Code, source.Code, destination.Code, 0, 0x21)
	}
	func mips32MipsSubtract(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		mips32MipsR(out, 0, destination.Code, source.Code, destination.Code, 0, 0x23)
	}
	func mips32MipsMultiply(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		// MIPS I predates the MIPS32 SPECIAL2 three-operand MUL encoding.
		// Use the R3000A/Allegrex HI/LO sequence instead.
		mips32MipsR(out, 0, destination.Code, source.Code, 0, 0, 0x18)
		mips32MipsR(out, 0, 0, 0, destination.Code, 0, 0x12)
	}
	func mips32MipsBitAnd(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		mips32MipsR(out, 0, destination.Code, source.Code, destination.Code, 0, 0x24)
	}
	func mips32MipsBitOr(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		mips32MipsR(out, 0, destination.Code, source.Code, destination.Code, 0, 0x25)
	}
	func mips32MipsBitXor(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		mips32MipsR(out, 0, destination.Code, source.Code, destination.Code, 0, 0x26)
	}

	func mips32MipsCompare(out *RTGEmitter, left RTGRegister, right RTGRegister) {
		mips32MipsMove(out, mips32MipsCompareLeft(), left)
		mips32MipsMove(out, mips32MipsCompareRight(), right)
	}
	func mips32MipsTest(out *RTGEmitter, left RTGRegister, right RTGRegister) {
		mips32MipsMove(out, mips32MipsCompareLeft(), left)
		mips32MipsBitAnd(out, mips32MipsCompareLeft(), right)
		mips32MipsMove(out, mips32MipsCompareRight(), mips32MipsZero())
	}
	func mips32MipsIncrement(out *RTGEmitter, operand RTGRegister) {
		mips32MipsI(out, 0x09, operand.Code, operand.Code, 1)
	}
	func mips32MipsDecrement(out *RTGEmitter, operand RTGRegister) {
		mips32MipsI(out, 0x09, operand.Code, operand.Code, -1)
	}
	func mips32MipsShiftLeftImmediate(out *RTGEmitter, operand RTGRegister, value byte) {
		mips32MipsR(out, 0, 0, operand.Code, operand.Code, int(value)&31, 0)
	}
	func mips32MipsShiftRightUnsignedImmediate(out *RTGEmitter, operand RTGRegister, value byte) {
		mips32MipsR(out, 0, 0, operand.Code, operand.Code, int(value)&31, 2)
	}
	func mips32MipsShiftRightSignedImmediate(out *RTGEmitter, operand RTGRegister, value byte) {
		mips32MipsR(out, 0, 0, operand.Code, operand.Code, int(value)&31, 3)
	}

	func mips32MipsCall(out *RTGEmitter, label RTGLabel) {
		mips32MipsEmit(out, 0x0c000000)
		out.Reloc(label)
		mips32MipsEmit(out, 0)
	}
	func mips32MipsCallIndirect(out *RTGEmitter, operand RTGRegister) {
		mips32MipsR(out, 0, operand.Code, 0, 31, 0, 9)
		mips32MipsEmit(out, 0)
	}
	func mips32MipsJump(out *RTGEmitter, label RTGLabel) {
		mips32MipsEmit(out, 0x08000000)
		out.Reloc(label)
		mips32MipsEmit(out, 0)
	}

	func mips32MipsSetCondition(out *RTGEmitter, condition RTGCondition,
		destination RTGRegister) {
		code := condition.Code
		left := mips32MipsCompareLeft()
		right := mips32MipsCompareRight()
		if code == 0 || code == 1 {
			mips32MipsR(out, 0, left.Code, right.Code, destination.Code, 0, 0x26)
			if code == 0 {
				mips32MipsI(out, 0x0b, destination.Code, destination.Code, 1)
			} else {
				mips32MipsR(out, 0, 0, destination.Code, destination.Code, 0, 0x2b)
			}
			return
		}
		unsigned := code >= 6
		invert := false
		if code == 2 || code == 3 || code == 8 || code == 9 {
			left, right = right, left
			if code == 2 || code == 8 {
				invert = true
			}
		} else {
			if code == 5 || code == 7 {
				invert = true
			}
		}
		function := 0x2a
		if unsigned {
			function = 0x2b
		}
		mips32MipsR(out, 0, left.Code, right.Code, destination.Code, 0, function)
		if invert {
			mips32MipsI(out, 0x0e, destination.Code, destination.Code, 1)
		}
	}

	func mips32MipsJumpCondition(out *RTGEmitter, condition RTGCondition, label RTGLabel) {
		mips32MipsSetCondition(out, condition, mips32MipsScratch())
		// Skip J/NOP when the requested condition is false.
		mips32MipsI(out, 4, mips32MipsScratch().Code, 0, 3)
		mips32MipsEmit(out, 0)
		mips32MipsEmit(out, 0x08000000)
		out.Reloc(label)
		mips32MipsEmit(out, 0)
	}

	func mips32MipsReturn(out *RTGEmitter) {
		mips32MipsR(out, 0, 31, 0, 0, 0, 8)
		mips32MipsEmit(out, 0)
	}
	func mips32MipsLeave(out *RTGEmitter) {
		mips32MipsLoadWidth(out, mips32MipsLink(), RTGAddress{Base: mips32MipsFrame(), Displacement: -4}, 0x23)
		mips32MipsLoadWidth(out, mips32MipsScratch(), RTGAddress{Base: mips32MipsFrame(), Displacement: -8}, 0x23)
		mips32MipsMove(out, mips32MipsStack(), mips32MipsFrame())
		mips32MipsMove(out, mips32MipsFrame(), mips32MipsScratch())
	}
	func mips32MipsHostSyscall(out *RTGEmitter) { mips32MipsEmit(out, 0x0000000c) }
	func mips32MipsVariableShift(out *RTGEmitter, direction RTGShiftDirection, signed bool) {
		function := 4
		if direction == RTGShiftRight {
			function = 6
			if signed {
				function = 7
			}
		}
		mips32MipsR(out, 0, mips32MipsPrimary().Code, mips32MipsTertiary().Code,
			mips32MipsPrimary().Code, 0, function)
	}
	func mips32MipsSignedDivide(out *RTGEmitter, remainder bool) {
		mips32MipsR(out, 0, mips32MipsTertiary().Code, mips32MipsPrimary().Code, 0, 0, 0x1a)
		function := 0x12
		if remainder {
			function = 0x10
		}
		mips32MipsR(out, 0, 0, 0, mips32MipsPrimary().Code, 0, function)
	}

	func mips32MipsPatchRelocations(out *RTGEmitter) {
		for index := 0; index < out.RelocationCount(); index++ {
			at := out.RelocationOffset(index)
			target := mips32MipsRelocationBase + out.LabelPosition(out.RelocationLabel(index))
			instruction := mips32MipsGetInstruction(out, at)
			opcode := instruction >> 26
			if opcode == 2 || opcode == 3 {
				mips32MipsPatchInstruction(out, at, (instruction&0xfc000000)|((target>>2)&0x03ffffff))
			} else {
				if opcode == 0x0f {
					register := (instruction >> 16) & 31
					mips32MipsPatchInstruction(out, at, (0x0f<<26)|(register<<16)|((target>>16)&0xffff))
					mips32MipsPatchInstruction(out, at+4, (0x0d<<26)|(register<<21)|(register<<16)|(target&0xffff))
				}
			}
		}
	}

	func mips32MipsFrameStart(out *RTGEmitter) int {
		mips32MipsMove(out, mips32MipsAddress(), mips32MipsFrame())
		at := out.Len()
		mips32MipsI(out, 0x0f, 0, mips32MipsScratch().Code, 0)
		mips32MipsI(out, 0x0d, mips32MipsScratch().Code, mips32MipsScratch().Code, 0)
		mips32MipsSubtract(out, mips32MipsStack(), mips32MipsScratch())
		mips32MipsMove(out, mips32MipsFrame(), mips32MipsStack())
		mips32MipsAdd(out, mips32MipsFrame(), mips32MipsScratch())
		mips32MipsStoreWidth(out, RTGAddress{Base: mips32MipsFrame(), Displacement: -4}, mips32MipsLink(), 0x2b)
		mips32MipsStoreWidth(out, RTGAddress{Base: mips32MipsFrame(), Displacement: -8}, mips32MipsAddress(), 0x2b)
		return at
	}
	func mips32MipsFrameFinish(out *RTGEmitter, at int, stackUsed int) {
		frameSize := (stackUsed + 23) & -16
		mips32MipsPatchInstruction(out, at, (0x0f<<26)|(mips32MipsScratch().Code<<16)|((frameSize>>16)&0xffff))
		mips32MipsPatchInstruction(out, at+4, (0x0d<<26)|(mips32MipsScratch().Code<<21)|
			(mips32MipsScratch().Code<<16)|(frameSize&0xffff))
	}
	func mips32MipsFrameLoad(out *RTGEmitter, destination RTGRegister, offset int) {
		mips32MipsLoadWidth(out, destination, RTGAddress{Base: mips32MipsFrame(), Displacement: -(offset + 8)}, 0x23)
	}
	func mips32MipsFrameStore(out *RTGEmitter, offset int, source RTGRegister) {
		mips32MipsStoreWidth(out, RTGAddress{Base: mips32MipsFrame(), Displacement: -(offset + 8)}, source, 0x2b)
	}
	func mips32MipsFrameAddress(out *RTGEmitter, destination RTGRegister, offset int) {
		mips32MipsEmitAddress(out, destination, RTGAddress{Base: mips32MipsFrame(), Displacement: -(offset + 8)})
	}

	func mips32MipsZero() RTGRegister    { return RTGRegister{Code: 0, Valid: true} }
	func mips32MipsPrimary() RTGRegister { return RTGRegister{Code: 2, Valid: true} }

	func mips32MipsTertiary() RTGRegister     { return RTGRegister{Code: 4, Valid: true} }
	func mips32MipsScratch() RTGRegister      { return RTGRegister{Code: 8, Valid: true} }
	func mips32MipsAddress() RTGRegister      { return RTGRegister{Code: 9, Valid: true} }
	func mips32MipsCompareLeft() RTGRegister  { return RTGRegister{Code: 10, Valid: true} }
	func mips32MipsCompareRight() RTGRegister { return RTGRegister{Code: 11, Valid: true} }
	func mips32MipsStack() RTGRegister        { return RTGRegister{Code: 29, Valid: true} }
	func mips32MipsFrame() RTGRegister        { return RTGRegister{Code: 30, Valid: true} }
	func mips32MipsLink() RTGRegister         { return RTGRegister{Code: 31, Valid: true} }

	const elfCodeAddress = 0x11000

	func elfDataOffset(out *RTGEmitter) int  { return RTGAlignValue(0x1000+len(out.Code()), 0x10000) }
	func elfDataAddress(out *RTGEmitter) int { return 0x10000 + elfDataOffset(out) }
	func elfBssAddress(out *RTGEmitter) int {
		return RTGAlignValue(elfDataAddress(out)+len(out.Data()), 16)
	}
	func elfPut(image []byte, at int, value uint64, width int, big bool) {
		for i := 0; i < width; i++ {
			shift := i * 8
			if big {
				shift = (width - 1 - i) * 8
			}
			image[at+i] = byte(value >> uint(shift))
		}
	}
	func elfImage(out *RTGEmitter, machine int, flags int, bits int, big bool) []byte {
		offset := elfDataOffset(out)
		result := make([]byte, offset+len(out.Data()))
		result[0] = 0x7f
		result[1] = 'E'
		result[2] = 'L'
		result[3] = 'F'
		result[4] = 1
		if bits == 64 {
			result[4] = 2
		}
		result[5] = 1
		if big {
			result[5] = 2
		}
		result[6] = 1
		elfPut(result, 16, 2, 2, big)
		elfPut(result, 18, uint64(machine), 2, big)
		elfPut(result, 20, 1, 4, big)
		if bits == 32 {
			elfPut(result, 24, elfCodeAddress, 4, big)
			elfPut(result, 28, 52, 4, big)
			elfPut(result, 36, uint64(flags), 4, big)
			elfPut(result, 40, 52, 2, big)
			elfPut(result, 42, 32, 2, big)
			elfPut(result, 44, 2, 2, big)
		} else {
			elfPut(result, 24, elfCodeAddress, 8, big)
			elfPut(result, 32, 64, 8, big)
			elfPut(result, 48, uint64(flags), 4, big)
			elfPut(result, 52, 64, 2, big)
			elfPut(result, 54, 56, 2, big)
			elfPut(result, 56, 2, 2, big)
		}
		for i := 0; i < 2; i++ {
			file := 0
			address := 0x10000
			size := 0x1000 + len(out.Code())
			memory := size
			permissions := 5
			if i == 1 {
				file = offset
				address = elfDataAddress(out)
				size = len(out.Data())
				memory = elfBssAddress(out) - address + out.BSSSize()
				permissions = 6
			}
			if bits == 32 {
				at := 52 + i*32
				elfPut(result, at, 1, 4, big)
				elfPut(result, at+4, uint64(file), 4, big)
				elfPut(result, at+8, uint64(address), 4, big)
				elfPut(result, at+12, uint64(address), 4, big)
				elfPut(result, at+16, uint64(size), 4, big)
				elfPut(result, at+20, uint64(memory), 4, big)
				elfPut(result, at+24, uint64(permissions), 4, big)
				elfPut(result, at+28, 0x10000, 4, big)
			} else {
				at := 64 + i*56
				elfPut(result, at, 1, 4, big)
				elfPut(result, at+4, uint64(permissions), 4, big)
				elfPut(result, at+8, uint64(file), 8, big)
				elfPut(result, at+16, uint64(address), 8, big)
				elfPut(result, at+24, uint64(address), 8, big)
				elfPut(result, at+32, uint64(size), 8, big)
				elfPut(result, at+40, uint64(memory), 8, big)
				elfPut(result, at+48, 0x10000, 8, big)
			}
		}
		copy(result[0x1000:], out.Code())
		copy(result[offset:], out.Data())
		return result
	}

	func targetEntryStart(out *RTGEmitter, stateOffset int) bool {
		_ = stateOffset
		mips32MipsSetTargetCodeAddress(elfCodeAddress)
		mips32MipsSetBigEndian(false)
		return true
	}
	func targetEntry(out *RTGEmitter, count int, stateOffset int) bool {
		_ = out
		_ = stateOffset
		return count == 0
	}

	func targetImage(out *RTGEmitter) []byte {
		for i := 0; i < out.AbsoluteRelocationCount(); i++ {
			at := out.AbsoluteRelocationOffset(i)
			target, ok := RTGResolveAbsoluteRelocation(out, out.AbsoluteRelocationKind(i), out.AbsoluteRelocationAddend(i), elfDataAddress(out), elfBssAddress(out))
			if !ok {
				return nil
			}
			instruction := mips32MipsGetInstruction(out, at)
			register := (instruction >> 16) & 31
			mips32MipsPatchInstruction(out, at, (15<<26)|(register<<16)|((target>>16)&65535))
			mips32MipsPatchInstruction(out, at+4, (13<<26)|(register<<21)|(register<<16)|(target&65535))
		}
		return elfImage(out, 8, 0x20000020, 32, false)
	}
}

arch mips32el {
	alias = "mips32el"
	endian = little
	word_bits = 32
	pointer_bits = 32
	instruction_alignment = 4
	stack_word_bytes = 4
	stack_alignment = 16
	patch_relocations = go mips32MipsPatchRelocations
	registers integer = [zero, at, v0, v1, a0, a1, a2, a3, t0, t1, t2, t3, t4, t5, t6, t7, s0, s1, s2, s3, s4, s5, s6, s7, t8, t9, k0, k1, gp, stack, frame, link]
	locations {
		primary = v0
		secondary = v1
		tertiary = a0
		scratch = t0
		address = t1
		compareLeft = t2
		compareRight = t3
		copy_destination = a1
		copy_source = a2
		copy_count = a3
		stack = stack
		frame = frame
		link = link
	}
	conditions {
		eq = 0
		ne = 1
		sle = 2
		sgt = 3
		slt = 4
		sge = 5
		ult = 6
		uge = 7
		ule = 8
		ugt = 9
	}
	bind {
		move = go mips32MipsMove
		address = go mips32MipsEmitAddress
		load.native = go mips32MipsLoadNative
		load.i32 = go mips32MipsLoadI32
		load.u32 = go mips32MipsLoadU32
		load.i16 = go mips32MipsLoadI16
		load.u16 = go mips32MipsLoadU16
		load.i8 = go mips32MipsLoadI8
		load.u8 = go mips32MipsLoadU8
		store.native = go mips32MipsStoreNative
		store.u32 = go mips32MipsStoreU32
		store.u16 = go mips32MipsStoreU16
		store.u8 = go mips32MipsStoreU8
		add = go mips32MipsAdd
		subtract = go mips32MipsSubtract
		multiply = go mips32MipsMultiply
		bit_and = go mips32MipsBitAnd
		bit_or = go mips32MipsBitOr
		bit_xor = go mips32MipsBitXor
		compare = go mips32MipsCompare
		test = go mips32MipsTest
		increment = go mips32MipsIncrement
		decrement = go mips32MipsDecrement
		shift_left_immediate = go mips32MipsShiftLeftImmediate
		shift_right_unsigned_immediate = go mips32MipsShiftRightUnsignedImmediate
		shift_right_signed_immediate = go mips32MipsShiftRightSignedImmediate
		call = go mips32MipsCall
		call_indirect = go mips32MipsCallIndirect
		jump = go mips32MipsJump
		jump_condition = go mips32MipsJumpCondition
		set_condition = go mips32MipsSetCondition
		return = go mips32MipsReturn
		leave = go mips32MipsLeave
		host_syscall = go mips32MipsHostSyscall
		move_immediate = go mips32MipsMoveImmediate
		variable_shift = go mips32MipsVariableShift
		signed_divide = go mips32MipsSignedDivide
		copy_bytes = sequence mips32CopyBytes
	}
	sequences {
		mips32CopyBytes(out:emitter) {
			let forward = out.NewLabel()
			let backwardLoop = out.NewLabel()
			let forwardLoop = out.NewLabel()
			let done = out.NewLabel()
			mips32MipsCompare(out, mips32elA1, mips32elA2)
			mips32MipsJumpCondition(out, mips32elULT, forward)
			mips32MipsEmitAddress(out, mips32elT0, record_address(Base:mips32elA2, Index:mips32elA3, Scale:1,))
			mips32MipsCompare(out, mips32elA1, mips32elT0)
			mips32MipsJumpCondition(out, mips32elUGE, forward)
			mips32MipsEmitAddress(out, mips32elA2, record_address(Base:mips32elA2, Index:mips32elA3, Scale:1, Displacement:-1,))
			mips32MipsEmitAddress(out, mips32elA1, record_address(Base:mips32elA1, Index:mips32elA3, Scale:1, Displacement:-1,))
			out.Mark(backwardLoop)
			mips32MipsCompare(out, mips32elA3, mips32elZERO)
			mips32MipsJumpCondition(out, mips32elEQ, done)
			mips32MipsLoadU8(out, mips32elT0, record_address(Base:mips32elA2,))
			mips32MipsStoreU8(out, record_address(Base:mips32elA1,), mips32elT0)
			mips32MipsDecrement(out, mips32elA2)
			mips32MipsDecrement(out, mips32elA1)
			mips32MipsDecrement(out, mips32elA3)
			mips32MipsJump(out, backwardLoop)
			out.Mark(forward)
			out.Mark(forwardLoop)
			mips32MipsCompare(out, mips32elA3, mips32elZERO)
			mips32MipsJumpCondition(out, mips32elEQ, done)
			mips32MipsLoadU8(out, mips32elT0, record_address(Base:mips32elA2,))
			mips32MipsStoreU8(out, record_address(Base:mips32elA1,), mips32elT0)
			mips32MipsIncrement(out, mips32elA2)
			mips32MipsIncrement(out, mips32elA1)
			mips32MipsDecrement(out, mips32elA3)
			mips32MipsJump(out, forwardLoop)
			out.Mark(done)
		}
	}
}
abi mips32el_internal {
	arch = mips32el
	arguments = [v0, v1, a0, a1, a2, a3]
	call_words = [v0, v1, a0, a1, a2, a3]
	result = [v0, v1]
	stack_alignment = 16
	return_address = link
	frame_pointer = frame
	frame_start = go mips32MipsFrameStart
	frame_finish = go mips32MipsFrameFinish
	frame_load = go mips32MipsFrameLoad
	frame_store = go mips32MipsFrameStore
	frame_address = go mips32MipsFrameAddress
}
runtime linux_mipsn32el {
	managed_heap_abi = 1
	managed_word_bits = 32
	managed_source = go managedSource
	managed_startup = go managedStartup
	managed_boundary = go managedBoundary
	emit_syscall_from_stack = go managedRawSyscall

	emit_entry_start = go targetEntryStart
	emit_entry = go targetEntry
	syscall {
		number = v0
		arguments = [a0, a1, a2, a3]
		result = v0
		instruction = host_syscall
	}
	operation read {
		number = 6000 args = [fd, buffer, count]
	}
	operation write {
		number = 6001 args = [fd, buffer, count]
	}
	operation open {
		number = 6002 args = [path, flags, mode]
	}
	operation close {
		number = 6003 args = [fd]
	}
	operation chmod {
		number = 6089 args = [fd, mode]
	}
	operation print {
		use = write args = [stdout, buffer, count]
	}
	operation exit {
		number = 6058 args = [status] noreturn = true
	}
}
format elf_mipsel {
	kind = elf
	byte_order = little
	address_bits = 32
	code_offset = 0
	image = go targetImage
}
target experimental/linux-mipsn32el {
	family = native_v1
	os = linux
	arch = mips32el
	frontend_arch = mips32el
	abi = mips32el_internal
	runtime = linux_mipsn32el
	executable = elf_mipsel
	arena_default = 16777216
	build_tags = [linux, unix, mipsel]
	capabilities = [hosted, executable, filesystem, heap]
}

# Shared managed collector and Linux services embedded for standalone use.
go backend {
	func managedHeap64Source() string { return managedHeapSource(8) }
	func managedHeap32Source() string { return managedHeapSource(4) }

	// Headers keep their aligned layout; payload/root scanning follows native words.
	func managedHeapSource(wordBytes int) string {
		constants := "const __renvoManagedWordBytes = uintptr(8)\nconst __renvoManagedMax = uintptr(9223372036854775807)\n"
		if wordBytes == 4 {
			constants = "const __renvoManagedWordBytes = uintptr(4)\nconst __renvoManagedMax = uintptr(2147483647)\n"
		}
		return constants + `
					// Desktop heap runtime, parsed and compiled with the application. No helper
					// below allocates through make/new/append or calls application code.
					var __renvoManagedState [16]uintptr

					func __renvoManagedRead(p uintptr) uintptr { return *(*uintptr)(p) }
					func __renvoManagedWrite(p uintptr, v uintptr) { *(*uintptr)(p) = v }
					func __renvoManagedByte(p uintptr) byte { return *(*byte)(p) }

					func __renvoManagedLimit(p uintptr) uintptr {
						var value uintptr
						var digits int
						for __renvoManagedByte(p) >= '0' && __renvoManagedByte(p) <= '9' {
							digit := uintptr(__renvoManagedByte(p)-'0')
							if value > (__renvoManagedMax-digit)/10 { return 0 }
							value = value*10+digit
							p++
							digits++
						}
						if digits == 0 || value == 0 { return 0 }
						var shift uintptr
						if __renvoManagedByte(p) != 0 {
							c := __renvoManagedByte(p)
							if c == 'K' { shift = 10 } else if c == 'M' { shift = 20 } else if c == 'G' { shift = 30 } else if c == 'T' { shift = 40 } else { return 0 }
							if __renvoManagedByte(p+1) != 'i' || __renvoManagedByte(p+2) != 'B' || __renvoManagedByte(p+3) != 0 { return 0 }
						}
						if value > __renvoManagedMax>>shift { return 0 }
						return value << shift
					}

					func __renvoManagedInit(limit uintptr, stack uintptr, globals uintptr, end uintptr) {
						if limit == 0 { limit = __renvoManagedMax }
						override := __renvoManagedEnvironment(stack)
						if override != 0 {
							limit = __renvoManagedLimit(override)
							if limit == 0 { __renvoManagedFatal("renvo: invalid RENVO_HEAP_LIMIT\n") }
						}
						// State and the common allocator's 32-byte compatibility bookkeeping.
						if limit < 160 { __renvoManagedFatal("panic: out of memory\n") }
						__renvoManagedState[1] = limit
						__renvoManagedState[2] = 160
						__renvoManagedState[3] = stack
						__renvoManagedState[6] = globals
						__renvoManagedState[7] = end
						__renvoManagedState[8] = 65536
					}

					// Segment header: next, mapping size, payload offset, reserved word; then one
					// block-header index per mapped page. All of this resides in charged mappings.
					func __renvoManagedHeader(size uintptr) uintptr { return (32+(size/__renvoManagedPageSize)*8+15)&^uintptr(15) }
					func __renvoManagedIndex(s uintptr, b uintptr, span uintptr) {
						first := (b-s+(__renvoManagedPageSize-1))/__renvoManagedPageSize
						end := (b-s+span+(__renvoManagedPageSize-1))/__renvoManagedPageSize
						for page := first; page < end; page++ { __renvoManagedWrite(s+32+page*8, b) }
					}
					func __renvoManagedFind(pointer uintptr) uintptr {
						for s := __renvoManagedState[0]; s != 0; s = __renvoManagedRead(s) {
							size := __renvoManagedRead(s+8)
							if pointer < s+__renvoManagedRead(s+16)+16 || pointer-s >= size { continue }
							b := __renvoManagedRead(s+32+((pointer-s)/__renvoManagedPageSize)*8)
							for b < s+size {
								span := __renvoManagedRead(b)
								if pointer < b+span {
									if pointer >= b+16 && __renvoManagedRead(b+8)&1 != 0 { return b }
									return 0
								}
								b += span
							}
						}
						return 0
					}
					func __renvoManagedMark(pointer uintptr) {
						b := __renvoManagedFind(pointer)
						if b != 0 && __renvoManagedRead(b+8)&2 == 0 {
							// Block headers are 16-byte aligned. During marking the upper bits
							// hold the next work item; low bits retain allocated/marked flags.
							__renvoManagedWrite(b+8, __renvoManagedState[9]|3)
							__renvoManagedState[9] = b
						}
					}
					func __renvoManagedScan(start uintptr, end uintptr) {
						for p := start; p < end; p += __renvoManagedWordBytes { __renvoManagedMark(__renvoManagedRead(p)) }
					}
					func __renvoManagedCollect(roots uintptr) {
						__renvoManagedState[4] = 0
						__renvoManagedState[5] = 0
						__renvoManagedState[9] = 0
						__renvoManagedRoots(roots)
						state := uintptr(&__renvoManagedState[0])
						__renvoManagedScan(__renvoManagedState[6], state)
						__renvoManagedScan(state+16*__renvoManagedWordBytes, __renvoManagedState[7])
						for __renvoManagedState[9] != 0 {
							b := __renvoManagedState[9]
							__renvoManagedState[9] = __renvoManagedRead(b+8)&^uintptr(15)
							__renvoManagedWrite(b+8, 3)
							__renvoManagedScan(b+16, b+__renvoManagedRead(b))
						}
						var previous uintptr
						var live uintptr
						for s := __renvoManagedState[0]; s != 0; {
							size := __renvoManagedRead(s+8)
							var free uintptr
							used := false
							for b := s+__renvoManagedRead(s+16); b < s+size; {
								span := __renvoManagedRead(b)
								if __renvoManagedRead(b+8)&2 != 0 {
									__renvoManagedWrite(b+8, 1)
									free = 0
									used = true
									live += span
								} else {
									__renvoManagedWrite(b+8, 0)
									if free != 0 { __renvoManagedWrite(free, __renvoManagedRead(free)+span) } else { free = b }
								}
								b += span
							}
							next := __renvoManagedRead(s)
							if !used {
								if previous == 0 { __renvoManagedState[0] = next } else { __renvoManagedWrite(previous, next) }
								if !__renvoManagedRelease(s, size) { __renvoManagedFatal("renvo: managed heap release failed\n") }
								__renvoManagedState[2] -= size
							} else {
								previous = s
								__renvoManagedWrite(s+32, s+__renvoManagedRead(s+16))
								for b := s+__renvoManagedRead(s+16); b < s+size; b += __renvoManagedRead(b) {
									__renvoManagedIndex(s, b, __renvoManagedRead(b))
								}
							}
							s = next
						}
						__renvoManagedState[10]++
						__renvoManagedState[12] = live
					}
					func __renvoManagedClaim(s uintptr, b uintptr, span uintptr) uintptr {
						available := __renvoManagedRead(b)
						__renvoManagedState[4] = 0
						if available-span >= 32 {
							__renvoManagedWrite(b+span, available-span)
							__renvoManagedWrite(b+span+8, 0)
							__renvoManagedWrite(b, span)
							__renvoManagedState[4] = b+span
							__renvoManagedState[5] = s
							available = span
						}
						// Only occupied pages need a fresh index. An older free-page index is
						// still a valid earlier block; lookup walks forward until sweep rebuilds it.
						__renvoManagedIndex(s, b, available)
						__renvoManagedWrite(b+8, 1)
						for p := b+16; p < b+available; p += __renvoManagedWordBytes { __renvoManagedWrite(p, 0) }
						return b+16
					}
					func __renvoManagedTake(span uintptr) uintptr {
						b := __renvoManagedState[4]
						if b != 0 && __renvoManagedRead(b) >= span {
							return __renvoManagedClaim(__renvoManagedState[5], b, span)
						}
						for s := __renvoManagedState[0]; s != 0; s = __renvoManagedRead(s) {
							end := s+__renvoManagedRead(s+8)
							for b := s+__renvoManagedRead(s+16); b < end; b += __renvoManagedRead(b) {
								if __renvoManagedRead(b+8) == 0 && __renvoManagedRead(b) >= span {
									return __renvoManagedClaim(s, b, span)
								}
							}
						}
						return 0
					}
					func __renvoManagedRequest(size uintptr, roots uintptr) uintptr {
						if size > __renvoManagedMax-(__renvoManagedPageSize+31) { return 0 }
						if size == 0 { size = 16 }
						span := ((size+15)&^uintptr(15))+16
						result := __renvoManagedTake(span)
						if result != 0 { return result }
						if __renvoManagedState[0] != 0 {
							__renvoManagedCollect(roots)
							result = __renvoManagedTake(span)
							if result != 0 { return result }
						}
						minimum := (span+48+(__renvoManagedPageSize-1))&^uintptr((__renvoManagedPageSize-1))
						for minimum-__renvoManagedHeader(minimum) < span {
							minimum = (span+__renvoManagedHeader(minimum)+(__renvoManagedPageSize-1))&^uintptr((__renvoManagedPageSize-1))
						}
						available := (__renvoManagedState[1]-__renvoManagedState[2])&^uintptr((__renvoManagedPageSize-1))
						if minimum > available { return 0 }
						growth := __renvoManagedState[8]
						if growth < minimum { growth = minimum }
						if growth > available { growth = available }
						mapping := __renvoManagedMap(growth)
						if mapping == 0 && growth != minimum {
							growth = minimum
							mapping = __renvoManagedMap(growth)
						}
						if mapping == 0 { return 0 }
						base := uintptr(mapping)
						__renvoManagedWrite(base, __renvoManagedState[0])
						__renvoManagedWrite(base+8, growth)
						header := __renvoManagedHeader(growth)
						__renvoManagedWrite(base+16, header)
						for page := uintptr(0); page < growth/__renvoManagedPageSize; page++ { __renvoManagedWrite(base+32+page*8, base+header) }
						__renvoManagedWrite(base+header, growth-header)
						__renvoManagedState[4] = base+header
						__renvoManagedState[5] = base
						__renvoManagedState[0] = base
						__renvoManagedState[2] += growth
						if growth < __renvoManagedMax/2 { __renvoManagedState[8] = growth*2 }
						return __renvoManagedTake(span)
					}
					func __renvoManagedCollectBoundary(ignored uintptr, roots uintptr) uintptr {
						__renvoManagedCollect(roots)
						return 0
					}
					`
	}
}

go backend {
	func linuxManagedSource() string {
		return `
					//renvo:intrinsic renvo_runtime_Syscall
					func __renvoManagedSyscall(n int, a uintptr, b uintptr, c uintptr, d uintptr, e int, f uintptr) int { return -1 }
					
					func __renvoManagedMap(size uintptr) uintptr {
					 p := __renvoManagedSyscall(__renvoManagedMapNumber, 0, size, 3, __renvoManagedMapFlags, -1, 0)
					 if uintptr(p) >= ^uintptr(4094) { return 0 }; return uintptr(p)
					}
					func __renvoManagedRelease(base uintptr, size uintptr) bool { return __renvoManagedSyscall(__renvoManagedReleaseNumber, base, size, 0, 0, 0, 0) == 0 }
					func __renvoManagedFatal(message string) { print(message); __renvoManagedSyscall(__renvoManagedExitNumber, 2, 0, 0, 0, 0, 0) }
					func __renvoManagedEnvironment(stack uintptr) uintptr {
					 // Linux initial process stack: argc, argv[], null, envp[], null.
					 p := stack + 2*__renvoManagedWordBytes + __renvoManagedRead(stack)*__renvoManagedWordBytes
					 for __renvoManagedRead(p) != 0 {
					  entry := __renvoManagedRead(p)
					  matched := true
					  prefix := "RENVO_HEAP_LIMIT="
					  for i := 0; i < len(prefix); i++ {
					   if __renvoManagedByte(entry+uintptr(i)) != prefix[i] { matched = false; break }
					  }
					  if matched { return entry+17 }
					  p += __renvoManagedWordBytes
					 }
					 return 0
					}
					func __renvoManagedRoots(roots uintptr) {
					 if roots > __renvoManagedState[3] { __renvoManagedFatal("renvo: unsupported managed stack\n") }
					 __renvoManagedScan(roots, __renvoManagedState[3])
					}
					`
	}
}

go backend {
	func managedSource() string {
		return managedHeap32Source() + linuxManagedSource() + `
	const __renvoManagedPageSize = uintptr(4096)
	const __renvoManagedMapNumber = 6009
	const __renvoManagedReleaseNumber = 6011
	const __renvoManagedExitNumber = 6058
	const __renvoManagedMapFlags = uintptr(2050)
	`
	}
	func managedStartup(out *RTGEmitter, limit int, label int) {
		mips32MipsMoveImmediate(out, RTGRegister{Code: 5, Valid: true}, int64(limit))
		mips32MipsMove(out, RTGRegister{Code: 4, Valid: true}, mips32MipsFrame())
		managedBSS(out, 3, 0)
		managedBSS(out, 2, out.BSSSize())
		managedCall(out, label)
	}
	func managedBSS(out *RTGEmitter, reg int, offset int) {
		at := out.Len()
		mips32MipsI(out, 0x0f, 0, reg, 0)
		mips32MipsI(out, 0x0d, reg, reg, 0)
		out.AbsoluteReloc(at, offset, RTGRelocationAbsoluteBSS)
	}
	func managedCall(out *RTGEmitter, label int) {
		at := out.Len()
		mips32MipsEmit(out, 0x0c000000)
		out.RelocAt(at, label)
		mips32MipsEmit(out, 0)
	}
	func managedBoundary(out *RTGEmitter, label int) {
		mips32MipsI(out, 0x09, 29, 29, -256)
		for reg := 1; reg < 32; reg++ {
			if reg != 29 {
				mips32MipsStoreNative(out, RTGAddress{Base: mips32MipsStack(), Displacement: reg * 4}, RTGRegister{Code: reg, Valid: true})
			}
		}
		mips32MipsMove(out, RTGRegister{Code: 3, Valid: true}, mips32MipsPrimary())
		mips32MipsMove(out, mips32MipsPrimary(), mips32MipsStack())
		managedCall(out, label)
		for reg := 1; reg < 32; reg++ {
			if reg != 29 && reg != 2 {
				mips32MipsLoadNative(out, RTGRegister{Code: reg, Valid: true}, RTGAddress{Base: mips32MipsStack(), Displacement: reg * 4})
			}
		}
		mips32MipsI(out, 0x09, 29, 29, 256)
	}
	func managedRawSyscall(out *RTGEmitter, count int, number int) bool {
		_ = number
		if count < 1 || count > 7 {
			return false
		}
		registers := []int{2, 4, 5, 6, 7, 8, 9}
		for i := 0; i < count; i++ {
			mips32MipsLoadNative(out, RTGRegister{Code: registers[i], Valid: true}, RTGAddress{Base: mips32MipsStack(), Displacement: i * 4})
		}
		mips32MipsI(out, 0x09, 29, 29, count*4)

		mips32MipsHostSyscall(out)
		// Linux MIPS reports a positive errno and sets a3; normalize to -errno.
		mips32MipsI(out, 4, 7, 0, 2)
		mips32MipsEmit(out, 0)
		mips32MipsR(out, 0, 0, 2, 2, 0, 0x23)

		return true
	}
}
