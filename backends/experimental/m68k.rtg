# SPDX-License-Identifier: Apache-2.0

# Shared Motorola 68000 emitter with a Renvo-internal 32-bit register ABI.
# Platform definitions provide the final code address and own image packaging.
go backend {
	var m68CodeAddress int

	func m68SetCodeAddress(address int) { m68CodeAddress = address }

	func m68Emit16(out *RTGEmitter, value int) {
		RTGByte(out, byte(value>>8))
		RTGByte(out, byte(value))
	}

	func m68Emit32(out *RTGEmitter, value int) {
		RTGByte(out, byte(value>>24))
		RTGByte(out, byte(value>>16))
		RTGByte(out, byte(value>>8))
		RTGByte(out, byte(value))
	}

	func m68Patch16(out *RTGEmitter, at int, value int) {
		code := out.Code()
		code[at] = byte(value >> 8)
		code[at+1] = byte(value)
	}

	func m68Patch32(out *RTGEmitter, at int, value int) {
		code := out.Code()
		code[at] = byte(value >> 24)
		code[at+1] = byte(value >> 16)
		code[at+2] = byte(value >> 8)
		code[at+3] = byte(value)
	}

	func m68IsAddress(register RTGRegister) bool { return register.Code >= 8 }
	func m68RegisterNumber(register RTGRegister) int {
		if register.Code >= 8 {
			return register.Code - 8
		}
		return register.Code
	}
	func m68RegisterEA(register RTGRegister) int {
		if register.Code >= 8 {
			return 8 + (register.Code - 8)
		}
		return register.Code
	}

	func m68Move(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		if destination.Code == source.Code {
			return
		}
		sourceEA := m68RegisterEA(source)
		if m68IsAddress(destination) {
			m68Emit16(out, 0x2040|(m68RegisterNumber(destination)<<9)|sourceEA)
			return
		}
		m68Emit16(out, 0x2000|(destination.Code<<9)|sourceEA)
	}

	func m68MoveImmediate(out *RTGEmitter, destination RTGRegister, value int64) {
		immediate := int(value)
		if !m68IsAddress(destination) && immediate >= -128 && immediate <= 127 {
			m68Emit16(out, 0x7000|(destination.Code<<9)|(immediate&0xff))
			return
		}
		if m68IsAddress(destination) {
			m68Emit16(out, 0x207c|(m68RegisterNumber(destination)<<9))
		} else {
			m68Emit16(out, 0x203c|(destination.Code<<9))
		}
		m68Emit32(out, immediate)
	}

	func m68AddImmediate(out *RTGEmitter, destination RTGRegister, value int) {
		if value == 0 {
			return
		}
		if m68IsAddress(destination) {
			m68Emit16(out, 0xd1fc|(m68RegisterNumber(destination)<<9))
			m68Emit32(out, value)
			return
		}
		m68Emit16(out, 0x0680|destination.Code)
		m68Emit32(out, value)
	}

	func m68EmitAddress(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		if RTGAddressValid(value) {
			if m68IsAddress(destination) {
				m68Emit16(out, 0x207c|(m68RegisterNumber(destination)<<9))
			} else {
				m68Emit16(out, 0x203c|(destination.Code<<9))
			}
			at := out.Len()
			m68Emit32(out, 0)
			RTGAddressRelocAt(out, value, at)
			return
		}

		address := m68Address()
		index := value.Index
		if index.Valid && index.Code == address.Code {
			index = RTGRegister{Code: 9, Valid: true}
			m68Move(out, index, value.Index)
		}
		if value.Base.Valid {
			m68Move(out, address, value.Base)
		} else {
			m68MoveImmediate(out, address, 0)
		}
		if value.Index.Valid {
			for scale := 0; scale < value.Scale; scale++ {
				m68Emit16(out, 0xd1c0|(m68RegisterNumber(address)<<9)|m68RegisterEA(index))
			}
		}
		m68AddImmediate(out, address, value.Displacement)
		m68Move(out, destination, address)
	}

	func m68MaterializeAddress(out *RTGEmitter, value RTGAddress) RTGRegister {
		m68EmitAddress(out, m68Address(), value)
		return m68Address()
	}

	func m68LoadLong(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		address := m68MaterializeAddress(out, value)
		ea := 0x10 | m68RegisterNumber(address)
		if m68IsAddress(destination) {
			m68Emit16(out, 0x2040|(m68RegisterNumber(destination)<<9)|ea)
		} else {
			m68Emit16(out, 0x2000|(destination.Code<<9)|ea)
		}
	}

	func m68LoadI32(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		m68LoadLong(out, destination, value)
	}
	func m68LoadU32(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		m68LoadLong(out, destination, value)
	}
	func m68LoadNative(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		m68LoadLong(out, destination, value)
	}

	func m68LoadI16(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		address := m68MaterializeAddress(out, value)
		m68Emit16(out, 0x3000|(destination.Code<<9)|0x10|m68RegisterNumber(address))
		m68Emit16(out, 0x48c0|destination.Code)
	}
	func m68LoadU16(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		address := m68MaterializeAddress(out, value)
		m68Emit16(out, 0x3000|(destination.Code<<9)|0x10|m68RegisterNumber(address))
		m68Emit16(out, 0x0280|destination.Code)
		m68Emit32(out, 0xffff)
	}
	func m68LoadI8(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		address := m68MaterializeAddress(out, value)
		m68Emit16(out, 0x1000|(destination.Code<<9)|0x10|m68RegisterNumber(address))
		m68Emit16(out, 0x4880|destination.Code)
		m68Emit16(out, 0x48c0|destination.Code)
	}
	func m68LoadU8(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		address := m68MaterializeAddress(out, value)
		m68Emit16(out, 0x1000|(destination.Code<<9)|0x10|m68RegisterNumber(address))
		m68Emit16(out, 0x0280|destination.Code)
		m68Emit32(out, 0xff)
	}

	func m68StoreWidth(out *RTGEmitter, value RTGAddress, source RTGRegister, base int) {
		address := m68MaterializeAddress(out, value)
		m68Emit16(out, base|(m68RegisterNumber(address)<<9)|m68RegisterEA(source))
	}
	func m68StoreNative(out *RTGEmitter, value RTGAddress, source RTGRegister) {
		m68StoreWidth(out, value, source, 0x2080)
	}
	func m68StoreU32(out *RTGEmitter, value RTGAddress, source RTGRegister) {
		m68StoreWidth(out, value, source, 0x2080)
	}
	func m68StoreU16(out *RTGEmitter, value RTGAddress, source RTGRegister) {
		m68StoreWidth(out, value, source, 0x3080)
	}
	func m68StoreU8(out *RTGEmitter, value RTGAddress, source RTGRegister) {
		m68StoreWidth(out, value, source, 0x1080)
	}

	func m68Add(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		if m68IsAddress(destination) {
			m68Emit16(out, 0xd1c0|(m68RegisterNumber(destination)<<9)|m68RegisterEA(source))
		} else {
			m68Emit16(out, 0xd080|(destination.Code<<9)|m68RegisterEA(source))
		}
	}
	func m68Subtract(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		if m68IsAddress(destination) {
			m68Emit16(out, 0x91c0|(m68RegisterNumber(destination)<<9)|m68RegisterEA(source))
		} else {
			m68Emit16(out, 0x9080|(destination.Code<<9)|m68RegisterEA(source))
		}
	}
	func m68BitAnd(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		m68Emit16(out, 0xc080|(destination.Code<<9)|m68RegisterEA(source))
	}
	func m68BitOr(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		m68Emit16(out, 0x8080|(destination.Code<<9)|m68RegisterEA(source))
	}
	func m68BitXor(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		m68Emit16(out, 0xb180|(source.Code<<9)|m68RegisterEA(destination))
	}

	func m68Multiply(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		left := m68CompareLeft()
		right := m68CompareRight()
		product := RTGRegister{Code: 6, Valid: true}
		temporary := RTGRegister{Code: 7, Valid: true}
		m68PushRegister(out, destination)
		m68PushRegister(out, source)
		m68PushRegister(out, m68Scratch())
		m68PushRegister(out, left)
		m68PushRegister(out, right)
		m68PushRegister(out, product)
		m68PushRegister(out, temporary)
		m68LoadNative(out, left, RTGAddress{Base: m68Stack(), Displacement: 24})
		m68LoadNative(out, right, RTGAddress{Base: m68Stack(), Displacement: 20})

		m68Move(out, product, left)
		m68Emit16(out, 0xc0c0|(product.Code<<9)|m68RegisterEA(right))

		m68Move(out, temporary, left)
		m68Emit16(out, 0x4840|temporary.Code)
		m68Emit16(out, 0xc0c0|(temporary.Code<<9)|m68RegisterEA(right))
		m68Emit16(out, 0x4840|temporary.Code)
		m68Emit16(out, 0x4240|temporary.Code)
		m68Add(out, product, temporary)

		m68Move(out, temporary, right)
		m68Emit16(out, 0x4840|temporary.Code)
		m68Emit16(out, 0xc0c0|(temporary.Code<<9)|m68RegisterEA(left))
		m68Emit16(out, 0x4840|temporary.Code)
		m68Emit16(out, 0x4240|temporary.Code)
		m68Add(out, product, temporary)

		m68StoreU32(out, RTGAddress{Base: m68Stack(), Displacement: 24}, product)
		m68PopRegister(out, temporary)
		m68PopRegister(out, product)
		m68PopRegister(out, right)
		m68PopRegister(out, left)
		m68PopRegister(out, m68Scratch())
		m68AddImmediate(out, m68Stack(), 4)
		m68PopRegister(out, destination)
	}

	func m68Compare(out *RTGEmitter, left RTGRegister, right RTGRegister) {
		m68Emit16(out, 0xb080|(left.Code<<9)|m68RegisterEA(right))
	}
	func m68Test(out *RTGEmitter, left RTGRegister, right RTGRegister) {
		// MOVEM restores the designated scratch register without changing the
		// condition codes produced by AND.
		m68PushRegister(out, m68Scratch())
		m68Move(out, m68Scratch(), left)
		if right.Code == m68Scratch().Code && left.Code != right.Code {
			m68Emit16(out, 0xc080|(m68Scratch().Code<<9)|0x17)
		} else {
			m68BitAnd(out, m68Scratch(), right)
		}
		m68Emit16(out, 0x4cdf)
		m68Emit16(out, 1<<m68Scratch().Code)
	}
	func m68Increment(out *RTGEmitter, operand RTGRegister) {
		m68Emit16(out, 0x5280|m68RegisterEA(operand))
	}
	func m68Decrement(out *RTGEmitter, operand RTGRegister) {
		m68Emit16(out, 0x5380|m68RegisterEA(operand))
	}

	func m68VariableShift(out *RTGEmitter, direction RTGShiftDirection, signed bool) {
		// The direct-emitter contract supplies count in primary and value in
		// tertiary. EXG puts the value in the required in-place destination while
		// retaining the count in the only other register this operation may clobber.
		m68Emit16(out, 0xc140|(m68Primary().Code<<9)|m68Tertiary().Code)
		instruction := 0xe1a8
		if direction == RTGShiftRight {
			instruction = 0xe0a8
			if signed {
				instruction = 0xe0a0
			}
		}
		m68Emit16(out, instruction|(m68Tertiary().Code<<9)|m68Primary().Code)
	}
	func m68ShiftImmediate(out *RTGEmitter, operand RTGRegister, value byte, instruction int) {
		remaining := int(value) & 31
		for remaining > 0 {
			count := remaining
			if count > 8 {
				count = 8
			}
			m68Emit16(out, instruction|((count&7)<<9)|operand.Code)
			remaining -= count
		}
	}
	func m68ShiftLeftImmediate(out *RTGEmitter, operand RTGRegister, value byte) {
		m68ShiftImmediate(out, operand, value, 0xe188)
	}
	func m68ShiftRightUnsignedImmediate(out *RTGEmitter, operand RTGRegister, value byte) {
		m68ShiftImmediate(out, operand, value, 0xe088)
	}
	func m68ShiftRightSignedImmediate(out *RTGEmitter, operand RTGRegister, value byte) {
		m68ShiftImmediate(out, operand, value, 0xe080)
	}

	func m68ConditionCode(condition RTGCondition) int {
		if condition.Code == 0 {
			return 7
		}
		if condition.Code == 1 {
			return 6
		}
		if condition.Code == 2 {
			return 15
		}
		if condition.Code == 3 {
			return 14
		}
		if condition.Code == 4 {
			return 13
		}
		if condition.Code == 5 {
			return 12
		}
		if condition.Code == 6 {
			return 5
		}
		if condition.Code == 7 {
			return 4
		}
		if condition.Code == 8 {
			return 3
		}
		return 2
	}
	func m68Jump(out *RTGEmitter, label RTGLabel) {
		m68Emit16(out, 0x4ef9)
		m68Emit32(out, 0)
		out.Reloc(label)
	}
	func m68JumpCondition(out *RTGEmitter, condition RTGCondition, label RTGLabel) {
		code := m68ConditionCode(condition)
		m68Emit16(out, 0x6000|((code^1)<<8)|6)
		m68Jump(out, label)
	}
	func m68SetCondition(out *RTGEmitter, condition RTGCondition, destination RTGRegister) {
		code := m68ConditionCode(condition)
		m68Emit16(out, 0x50c0|(code<<8)|destination.Code)
		m68Emit16(out, 0x0280|destination.Code)
		m68Emit32(out, 1)
	}

	func m68Call(out *RTGEmitter, label RTGLabel) {
		m68Emit16(out, 0x4eb9)
		m68Emit32(out, 0)
		out.Reloc(label)
	}
	func m68CallIndirect(out *RTGEmitter, operand RTGRegister) {
		address := operand
		if !m68IsAddress(operand) {
			address = m68Address()
			m68Move(out, address, operand)
		}
		m68Emit16(out, 0x4e90|m68RegisterNumber(address))
	}
	func m68Return(out *RTGEmitter)      { m68Emit16(out, 0x4e75) }
	func m68Leave(out *RTGEmitter)       { m68Emit16(out, 0x4e5e) }
	func m68HostSyscall(out *RTGEmitter) { m68Emit16(out, 0x4e40) }

	func m68SignedDivide(out *RTGEmitter, remainder bool) {
		dividend := m68CompareLeft()
		divisor := m68CompareRight()
		unsignedRemainder := m68Secondary()
		quotient := RTGRegister{Code: 6, Valid: true}
		quotientSign := RTGRegister{Code: 7, Valid: true}
		dividendSign := RTGRegister{Code: 3, Valid: true}

		m68PushRegister(out, m68Tertiary())
		m68PushRegister(out, dividendSign)
		m68PushRegister(out, dividend)
		m68PushRegister(out, divisor)
		m68PushRegister(out, quotient)
		m68PushRegister(out, quotientSign)

		m68Move(out, dividend, m68Tertiary())
		m68Move(out, divisor, m68Primary())
		m68Move(out, dividendSign, dividend)
		m68Move(out, quotientSign, dividend)
		m68BitXor(out, quotientSign, divisor)

		positiveDividend := out.NewLabel()
		m68Emit16(out, 0x4a80|dividend.Code)
		m68JumpCondition(out, RTGCondition{Code: 5}, positiveDividend)
		m68Emit16(out, 0x4480|dividend.Code)
		out.Mark(positiveDividend)

		positiveDivisor := out.NewLabel()
		m68Emit16(out, 0x4a80|divisor.Code)
		m68JumpCondition(out, RTGCondition{Code: 5}, positiveDivisor)
		m68Emit16(out, 0x4480|divisor.Code)
		out.Mark(positiveDivisor)

		m68MoveImmediate(out, unsignedRemainder, 0)
		m68MoveImmediate(out, quotient, 0)
		for bit := 0; bit < 32; bit++ {
			m68Add(out, unsignedRemainder, unsignedRemainder)
			noDividendBit := out.NewLabel()
			m68Emit16(out, 0x4a80|dividend.Code)
			m68JumpCondition(out, RTGCondition{Code: 5}, noDividendBit)
			m68Increment(out, unsignedRemainder)
			out.Mark(noDividendBit)
			m68Add(out, dividend, dividend)
			m68Add(out, quotient, quotient)
			m68Compare(out, unsignedRemainder, divisor)
			skip := out.NewLabel()
			m68JumpCondition(out, RTGCondition{Code: 6}, skip)
			m68Subtract(out, unsignedRemainder, divisor)
			m68Increment(out, quotient)
			out.Mark(skip)
		}

		positiveQuotient := out.NewLabel()
		m68Emit16(out, 0x4a80|quotientSign.Code)
		m68JumpCondition(out, RTGCondition{Code: 5}, positiveQuotient)
		m68Emit16(out, 0x4480|quotient.Code)
		out.Mark(positiveQuotient)

		positiveRemainder := out.NewLabel()
		m68Emit16(out, 0x4a80|dividendSign.Code)
		m68JumpCondition(out, RTGCondition{Code: 5}, positiveRemainder)
		m68Emit16(out, 0x4480|unsignedRemainder.Code)
		out.Mark(positiveRemainder)
		if remainder {
			m68Move(out, m68Primary(), unsignedRemainder)
		} else {
			m68Move(out, m68Primary(), quotient)
		}
		m68PopRegister(out, quotientSign)
		m68PopRegister(out, quotient)
		m68PopRegister(out, divisor)
		m68PopRegister(out, dividend)
		m68PopRegister(out, dividendSign)
		m68PopRegister(out, m68Tertiary())
	}

	func m68PatchRelocations(out *RTGEmitter) {
		for index := 0; index < out.RelocationCount(); index++ {
			at := out.RelocationOffset(index)
			target := m68CodeAddress + out.LabelPosition(out.RelocationLabel(index))
			m68Patch32(out, at, target)
		}
	}

	func m68FrameStart(out *RTGEmitter) int {
		m68Emit16(out, 0x4e56)
		at := out.Len()
		m68Emit16(out, 0)
		return at
	}
	func m68FrameFinish(out *RTGEmitter, at int, stackUsed int) {
		// LINK already saves the caller's A6 at 0(A6). Frame slots are based at
		// -(offset+4), so reserve that saved-word bias in addition to stackUsed.
		frameSize := (stackUsed + 7) & -4
		m68Patch16(out, at, -frameSize)
	}
	func m68FrameLoad(out *RTGEmitter, destination RTGRegister, offset int) {
		m68LoadLong(out, destination, RTGAddress{Base: m68Frame(), Displacement: -(offset + 4)})
	}
	func m68FrameStore(out *RTGEmitter, offset int, source RTGRegister) {
		m68StoreU32(out, RTGAddress{Base: m68Frame(), Displacement: -(offset + 4)}, source)
	}
	func m68FrameAddress(out *RTGEmitter, destination RTGRegister, offset int) {
		m68EmitAddress(out, destination, RTGAddress{Base: m68Frame(), Displacement: -(offset + 4)})
	}
	func m68PushRegister(out *RTGEmitter, source RTGRegister) {
		m68AddImmediate(out, m68Stack(), -4)
		m68StoreU32(out, RTGAddress{Base: m68Stack()}, source)
	}
	func m68PushImmediate(out *RTGEmitter, value int) {
		m68AddImmediate(out, m68Stack(), -4)
		m68MoveImmediate(out, m68Scratch(), int64(value))
		m68StoreU32(out, RTGAddress{Base: m68Stack()}, m68Scratch())
	}
	func m68PopRegister(out *RTGEmitter, destination RTGRegister) {
		m68LoadNative(out, destination, RTGAddress{Base: m68Stack()})
		m68AddImmediate(out, m68Stack(), 4)
	}

	func m68Primary() RTGRegister      { return RTGRegister{Code: 0, Valid: true} }
	func m68Secondary() RTGRegister    { return RTGRegister{Code: 1, Valid: true} }
	func m68Tertiary() RTGRegister     { return RTGRegister{Code: 2, Valid: true} }
	func m68Scratch() RTGRegister      { return RTGRegister{Code: 7, Valid: true} }
	func m68CompareLeft() RTGRegister  { return RTGRegister{Code: 4, Valid: true} }
	func m68CompareRight() RTGRegister { return RTGRegister{Code: 5, Valid: true} }
	func m68Address() RTGRegister      { return RTGRegister{Code: 8, Valid: true} }
	func m68Frame() RTGRegister        { return RTGRegister{Code: 14, Valid: true} }
	func m68Stack() RTGRegister        { return RTGRegister{Code: 15, Valid: true} }
}

arch m68k {
	alias = "m68k"
	endian = big
	word_bits = 32
	pointer_bits = 32
	instruction_alignment = 2
	stack_word_bytes = 4
	stack_alignment = 4
	patch_relocations = go m68PatchRelocations
	registers integer = [d0, d1, d2, d3, d4, d5, d6, d7, a0, a1, a2, a3, a4, a5, a6, a7]
	locations {
		primary = d0
		secondary = d1
		tertiary = d2
		scratch = d7
		address = a0
		compareLeft = d4
		compareRight = d5
		copy_destination = d1
		copy_source = d4
		copy_count = d5
		stack = a7
		frame = a6
		link = a5
	}
	conditions {
		eq = 0
		ne = 1
		sle = 2
		sgt = 3
		slt = 4
		sge = 5
		ult = 6
		uge = 7
		ule = 8
		ugt = 9
	}
	bind {
		move = go m68Move
		address = go m68EmitAddress
		load.native = go m68LoadNative
		load.i32 = go m68LoadI32
		load.u32 = go m68LoadU32
		load.i16 = go m68LoadI16
		load.u16 = go m68LoadU16
		load.i8 = go m68LoadI8
		load.u8 = go m68LoadU8
		store.native = go m68StoreNative
		store.u32 = go m68StoreU32
		store.u16 = go m68StoreU16
		store.u8 = go m68StoreU8
		add = go m68Add
		subtract = go m68Subtract
		multiply = go m68Multiply
		bit_and = go m68BitAnd
		bit_or = go m68BitOr
		bit_xor = go m68BitXor
		compare = go m68Compare
		test = go m68Test
		increment = go m68Increment
		decrement = go m68Decrement
		shift_left_immediate = go m68ShiftLeftImmediate
		shift_right_unsigned_immediate = go m68ShiftRightUnsignedImmediate
		shift_right_signed_immediate = go m68ShiftRightSignedImmediate
		call = go m68Call
		call_indirect = go m68CallIndirect
		jump = go m68Jump
		jump_condition = go m68JumpCondition
		set_condition = go m68SetCondition
		return = go m68Return
		leave = go m68Leave
		host_syscall = go m68HostSyscall
		move_immediate = go m68MoveImmediate
		variable_shift = go m68VariableShift
		signed_divide = go m68SignedDivide
		copy_bytes = sequence copyBytes
	}
	sequences {
		copyBytes(out:emitter) {
			let forward = out.NewLabel()
			let backwardLoop = out.NewLabel()
			let forwardLoop = out.NewLabel()
			let done = out.NewLabel()
			m68Compare(out, d1, d4)
			m68JumpCondition(out, ult, forward)
			m68EmitAddress(out, d3, record_address(Base:d4, Index:d5, Scale:1,))
			m68Compare(out, d1, d3)
			m68JumpCondition(out, uge, forward)
			m68EmitAddress(out, d4, record_address(Base:d4, Index:d5, Scale:1, Displacement:-1,))
			m68EmitAddress(out, d1, record_address(Base:d1, Index:d5, Scale:1, Displacement:-1,))
			out.Mark(backwardLoop)
			m68MoveImmediate(out, d3, 0)
			m68Compare(out, d5, d3)
			m68JumpCondition(out, eq, done)
			m68LoadU8(out, d3, record_address(Base:d4,))
			m68StoreU8(out, record_address(Base:d1,), d3)
			m68Decrement(out, d4)
			m68Decrement(out, d1)
			m68Decrement(out, d5)
			m68Jump(out, backwardLoop)
			out.Mark(forward)
			out.Mark(forwardLoop)
			m68MoveImmediate(out, d3, 0)
			m68Compare(out, d5, d3)
			m68JumpCondition(out, eq, done)
			m68LoadU8(out, d3, record_address(Base:d4,))
			m68StoreU8(out, record_address(Base:d1,), d3)
			m68Increment(out, d4)
			m68Increment(out, d1)
			m68Decrement(out, d5)
			m68Jump(out, forwardLoop)
			out.Mark(done)
		}
	}
}

abi m68k_internal {
	arch = m68k
	# Keep the result register distinct from argument word zero. Besides matching
	# conventional register ABIs, this tells the generic lowering that overflow
	# arguments begin above LINK's saved frame pointer and JSR's return address.
	arguments = [d1, d2, d3, d4, d5, d6]
	call_words = [d1, d2, d3, d4, d5, d6]
	result = [d0, d1]
	stack_alignment = 4
	return_address = a5
	frame_pointer = a6
	frame_start = go m68FrameStart
	frame_finish = go m68FrameFinish
	push_register = go m68PushRegister
	push_immediate = go m68PushImmediate
	pop_register = go m68PopRegister
	frame_load = go m68FrameLoad
	frame_store = go m68FrameStore
	frame_address = go m68FrameAddress
}
