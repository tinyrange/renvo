			insn(out, 0x01000000)
			return
		}
		if cpu == 6 {
			insn(out, 0xb6000008|(15<<16))
			insn(out, 0x80000000)
			return
		}
		if cpu == 1 || cpu == 2 {
			insn(out, 0x4e800020)
			return
