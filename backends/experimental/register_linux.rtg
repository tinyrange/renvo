		}
		if (cpu == 1 || cpu == 2) && store && d.Code == 13 {
			insn(out, 0x7c0802a6|(r<<21))
		}
		if cpu == 1 || cpu == 2 {
			opcode := 0x88000000
			if size == 2 {
				opcode = 0xa0000000
			}
			if size == 4 {
				opcode = 0x80000000
			}
			if size == 8 {
				opcode = 0xe8000000
			}
			if store {
				opcode = 0x98000000
				if size == 2 {
					opcode = 0xb0000000
				}
				if size == 4 {
					opcode = 0x90000000
				}
				if size == 8 {
					opcode = 0xf8000000
				}
			}
			insn(out, opcode|(r<<21)|(a<<16))
			if !store && d.Code == 13 {
				insn(out, 0x7c0803a6|(r<<21))
			}
			return
		}
		opcode := 0x2a000000
		if size == 2 {
			opcode = 0x2a400000
		}
		if size == 4 {
			opcode = 0x2a800000
		}
		if size == 8 {
			opcode = 0x28c00000
		}
		if store {
			opcode = 0x29000000
			if size == 2 {
				opcode = 0x29400000
			}
			if size == 4 {
				opcode = 0x29800000
			}
			if size == 8 {
				opcode = 0x29c00000
			}
		}
		insn(out, opcode|(a<<5)|r)
