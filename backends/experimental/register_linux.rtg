			op := 12
			if unsigned {
				op = 4
			}
			insn(out, 0xe4000000|(op<<21)|(rl<<16)|(rr<<11))
			small(out, rd, 0)
			insn(out, 0x0c000003)
			insn(out, 0x15000000)
			small(out, rd, 1)
			return
		}
