	func condition(out *RTGEmitter, c RTGCondition, d RTGRegister) {
		code := c.Code
		invert := false
		l := reg(5)
		r := reg(6)
		if code < 2 {
			move(out, d, l)
			bitXor(out, d, r)
			immediate(out, reg(11), 0)
			less(out, d, reg(11), d, true)
			invert = code == 0
		} else {
			if code == 2 || code == 3 || code == 8 || code == 9 {
				l = reg(6)
				r = reg(5)
			}
			less(out, d, l, r, code >= 6)
			invert = code == 2 || code == 5 || code == 7 || code == 8
		}
