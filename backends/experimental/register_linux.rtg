			insn(out, 0x08000240)
			alu(out, 3, 26, 28, 28)
			return
		}
		if cpu == 8 {
			half(out, 0x0a00|number)
			return
		}
		if cpu == 4 {
			small(out, 0, number)
			insn(out, 0x83)
			alu(out, 3, 16, 0, 0)
			return
		}
		if cpu == 7 {
			small(out, 1, number)
			n := 16
			if word == 8 {
				n = 109
			}
			insn(out, 0x91d02000|n)
			return
		}
		if cpu == 5 {
			small(out, 11, number)
			insn(out, 0x20000001)
			alu(out, 3, 3, 11, 11)
			return
		}
		if cpu == 6 {
			small(out, 12, number)
			insn(out, 0xb9cc0008)
			alu(out, 3, 5, 3, 3)
			return
		}
		if cpu == 1 || cpu == 2 {
			small(out, 0, number)
			insn(out, 0x44000002)
			return
		}
		small(out, 11, number)
		insn(out, 0x002b0000)
