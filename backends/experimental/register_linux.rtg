	func loadNative(out *RTGEmitter, d RTGRegister, a RTGAddress) { memory(out, d, a, word, false) }
	func loadU32(out *RTGEmitter, d RTGRegister, a RTGAddress)    { memory(out, d, a, 4, false) }
	func loadU16(out *RTGEmitter, d RTGRegister, a RTGAddress)    { memory(out, d, a, 2, false) }
	func loadU8(out *RTGEmitter, d RTGRegister, a RTGAddress)     { memory(out, d, a, 1, false) }
	func signedLoad(out *RTGEmitter, d RTGRegister, a RTGAddress, size int) {
		memory(out, d, a, size, false)
