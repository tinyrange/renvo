			op := 0x7c000000
			if unsigned {
				op |= 0x40
			}
			if word == 8 {
				op |= 0x200000
			}
			insn(out, op|(rl<<16)|(rr<<11))
			small(out, rd, 0)
			insn(out, 0x40800008)
			small(out, rd, 1)
			return
		}
		op := 0x00120000
		if unsigned {
			op = 0x00128000
		}
		insn(out, op|(rr<<10)|(rl<<5)|rd)
	}
	func compare(out *RTGEmitter, l RTGRegister, r RTGRegister) {
		move(out, reg(11), r)
		move(out, reg(5), l)
		move(out, reg(6), reg(11))
	}
	func test(out *RTGEmitter, l RTGRegister, r RTGRegister) {
		move(out, reg(11), r)
		move(out, reg(5), l)
		bitAnd(out, reg(5), reg(11))
