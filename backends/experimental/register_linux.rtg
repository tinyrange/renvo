	func jump(out *RTGEmitter, label RTGLabel) {
		at := out.Len()
		immediate(out, reg(4), 0)
		out.RelocAt(at, label)
		branchRegister(out, reg(4), false)
	}
	func call(out *RTGEmitter, label RTGLabel) {
		at := out.Len()
		immediate(out, reg(4), 0)
		out.RelocAt(at, label)
		branchRegister(out, reg(4), true)
	}
	func callIndirect(out *RTGEmitter, r RTGRegister) { branchRegister(out, r, true) }
	func jumpCondition(out *RTGEmitter, c RTGCondition, label RTGLabel) {
		condition(out, c, reg(3))
		at := out.Len()
		branchZero(out, reg(3), at)
		jump(out, label)
		end := out.Len()
		patch = at
		branchZero(out, reg(3), end)
		patch = -1
	}
	func frameStart(out *RTGEmitter) int {
		if cpu == 1 || cpu == 2 {
			insn(out, 0x7c0802a6|(physical(13)<<21))
		}
		move(out, reg(4), reg(15))
		move(out, reg(15), reg(14))
		at := out.Len()
		immediate(out, reg(3), 0)
		subtract(out, reg(14), reg(3))
		storeNative(out, RTGAddress{Base: reg(15), Displacement: -word}, reg(13))
		storeNative(out, RTGAddress{Base: reg(15), Displacement: -2 * word}, reg(4))
		return at
	}
	func frameFinish(out *RTGEmitter, at int, size int) {
		patch = at
		immediate(out, reg(3), int64(RTGAlignValue(size+2*word, 16)))
		patch = -1
	}
	func frameLoad(out *RTGEmitter, d RTGRegister, offset int) {
		loadNative(out, d, RTGAddress{Base: reg(15), Displacement: -(offset + 2*word)})
	}
	func frameStore(out *RTGEmitter, offset int, s RTGRegister) {
		storeNative(out, RTGAddress{Base: reg(15), Displacement: -(offset + 2*word)}, s)
	}
	func frameAddress(out *RTGEmitter, d RTGRegister, offset int) {
		address(out, d, RTGAddress{Base: reg(15), Displacement: -(offset + 2*word)})
	}
	func leave(out *RTGEmitter) {
		loadNative(out, reg(13), RTGAddress{Base: reg(15), Displacement: -word})
		loadNative(out, reg(3), RTGAddress{Base: reg(15), Displacement: -2 * word})
