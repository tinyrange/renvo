		decrement(out, reg(8))
		decrement(out, reg(9))
		jump(out, backward)
		out.Mark(forward)
		out.Mark(loop)
		immediate(out, reg(3), 0)
		compare(out, reg(9), reg(3))
		jumpCondition(out, RTGCondition{Code: 0}, done)
		loadU8(out, reg(3), RTGAddress{Base: reg(8)})
		storeU8(out, RTGAddress{Base: reg(7)}, reg(3))
		increment(out, reg(7))
		increment(out, reg(8))
		decrement(out, reg(9))
		jump(out, loop)
		out.Mark(done)
	}
	func softwareDivide(out *RTGEmitter, remainder bool, unsigned bool) {
		immediate(out, reg(3), int64(word*5))
		subtract(out, reg(14), reg(3))
		for i := 7; i <= 10; i++ {
			storeNative(out, RTGAddress{Base: reg(14), Displacement: (i - 7) * word}, reg(i))
		}
		move(out, reg(7), reg(2))
		move(out, reg(8), reg(0))
		immediate(out, reg(3), 0)
		if !unsigned {
			move(out, reg(3), reg(7))
			if !remainder {
				bitXor(out, reg(3), reg(8))
			}
			shiftSigned(out, reg(3), byte(word*8-1))
		}
		storeNative(out, RTGAddress{Base: reg(14), Displacement: 4 * word}, reg(3))
		if !unsigned {
			for i := 7; i <= 8; i++ {
				move(out, reg(3), reg(i))
				shiftSigned(out, reg(3), byte(word*8-1))
				bitXor(out, reg(i), reg(3))
				subtract(out, reg(i), reg(3))
			}
		}
		immediate(out, reg(9), 0)
		immediate(out, reg(10), 0)
		for i := word*8 - 1; i >= 0; i-- {
			sub := out.NewLabel()
			skip := out.NewLabel()
			immediate(out, reg(3), 0)
			compare(out, reg(10), reg(3))
			shiftLeft(out, reg(10), 1)
			move(out, reg(3), reg(7))
			shiftRight(out, reg(3), byte(i))
			immediate(out, reg(0), 1)
			bitAnd(out, reg(3), reg(0))
			bitOr(out, reg(10), reg(3))
			shiftLeft(out, reg(9), 1)
			jumpCondition(out, RTGCondition{Code: 4}, sub)
			compare(out, reg(10), reg(8))
			jumpCondition(out, RTGCondition{Code: 6}, skip)
			out.Mark(sub)
			subtract(out, reg(10), reg(8))
			increment(out, reg(9))
			out.Mark(skip)
		}
		result := 9
		if remainder {
			result = 10
		}
		move(out, reg(0), reg(result))
		loadNative(out, reg(3), RTGAddress{Base: reg(14), Displacement: 4 * word})
		bitXor(out, reg(0), reg(3))
		subtract(out, reg(0), reg(3))
		for i := 7; i <= 10; i++ {
			loadNative(out, reg(i), RTGAddress{Base: reg(14), Displacement: (i - 7) * word})
		}
		immediate(out, reg(3), int64(word*5))
		add(out, reg(14), reg(3))
	}
	func hostSyscall(out *RTGEmitter) {
		if cpu == 1 || cpu == 2 {
			insn(out, 0x44000002)
			return
		}
		if cpu == 3 {
			insn(out, 0x002b0000)
			return
		}
		if cpu == 4 {
			insn(out, 0x83)
			return
		}
		if cpu == 5 {
			insn(out, 0x20000001)
			return
		}
		if cpu == 6 {
			insn(out, 0xb9cc0008)
			return
		}
		if cpu == 7 {
			n := 16
			if word == 8 {
				n = 109
			}
			insn(out, 0x91d02000|n)
			return
		}
		if cpu == 8 {
			half(out, 0x0a00)
			return
		}
		if cpu == 9 {
			small(out, 19, 256)
			insn(out, 0xe4000000|(19<<21))
			insn(out, 0x08000240)
			return
		}
		if cpu == 10 {
			insn(out, 0x5400c004)
			return
		}
		panic("unsupported Linux register-machine CPU")
	}
}
