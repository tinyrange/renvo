	func copyBytes(out *RTGEmitter) {
		forward := out.NewLabel()
		backward := out.NewLabel()
		loop := out.NewLabel()
		done := out.NewLabel()
		compare(out, reg(7), reg(8))
		jumpCondition(out, RTGCondition{Code: 6}, forward)
		move(out, reg(3), reg(8))
		add(out, reg(3), reg(9))
		compare(out, reg(7), reg(3))
		jumpCondition(out, RTGCondition{Code: 7}, forward)
		add(out, reg(7), reg(9))
		decrement(out, reg(7))
		add(out, reg(8), reg(9))
		decrement(out, reg(8))
		out.Mark(backward)
		immediate(out, reg(3), 0)
		compare(out, reg(9), reg(3))
		jumpCondition(out, RTGCondition{Code: 0}, done)
		loadU8(out, reg(3), RTGAddress{Base: reg(8)})
		storeU8(out, RTGAddress{Base: reg(7)}, reg(3))
