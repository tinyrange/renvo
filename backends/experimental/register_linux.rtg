		if cpu == 5 {
			op := 0x44000000
			if link {
				op = 0x48000000
			}
			insn(out, op|(rr<<11))
			insn(out, 0x15000000)
			return
		}
		if cpu == 6 {
			if link {
				insn(out, 0x98000000|(15<<21)|(28<<16)|(rr<<11))
				insn(out, 0x80000000)
			} else {
				insn(out, 0x98080000|(rr<<11))
			}
			return
		}
		if cpu == 1 || cpu == 2 {
			insn(out, 0x7c0903a6|(rr<<21))
			op := 0x4e800420
			if link {
				op++
