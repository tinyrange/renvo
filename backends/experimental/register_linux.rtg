	func storeU32(out *RTGEmitter, a RTGAddress, s RTGRegister)    { memory(out, s, a, 4, true) }
	func storeU16(out *RTGEmitter, a RTGAddress, s RTGRegister)    { memory(out, s, a, 2, true) }
	func storeU8(out *RTGEmitter, a RTGAddress, s RTGRegister)     { memory(out, s, a, 1, true) }
	func less(out *RTGEmitter, d RTGRegister, l RTGRegister, r RTGRegister, unsigned bool) {
		rd := physical(d.Code)
		rl := physical(l.Code)
		rr := physical(r.Code)
