	func loadI32(out *RTGEmitter, d RTGRegister, a RTGAddress)     { signedLoad(out, d, a, 4) }
	func loadI16(out *RTGEmitter, d RTGRegister, a RTGAddress)     { signedLoad(out, d, a, 2) }
	func loadI8(out *RTGEmitter, d RTGRegister, a RTGAddress)      { signedLoad(out, d, a, 1) }
