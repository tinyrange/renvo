			op := 0x20
			if unsigned {
				op = 0x21
			}
			insn(out, 0xb9000000|(op<<16)|(rl<<4)|rr)
			small(out, rd, 0)
			insn(out, 0xa7a40004)
			small(out, rd, 1)
