		branchRegister(out, reg(13), false)
	}
	func patchImmediate(out *RTGEmitter, at int, value int) {
		// The first instruction contains the destination register. Find its virtual
		// location using the selected ISA's one-to-one register mapping.
		bytes := out.Code()
		instruction := 0
		for i := 0; i < 4; i++ {
			shift := i * 8
			if big {
				shift = (3 - i) * 8
			}
			instruction |= int(bytes[at+i]) << uint(shift)
		}
		physicalReg := instruction & 31
		if cpu == 1 || cpu == 2 || cpu == 6 || cpu == 5 || cpu == 4 {
			physicalReg = (instruction >> 21) & 31
		}
		if cpu == 7 {
			physicalReg = (instruction >> 25) & 31
		}
		if cpu == 8 {
			physicalReg = (instruction >> 20) & 15
		}
		if cpu == 9 {
			physicalReg = (instruction >> 16) & 31
		}
		for i := 0; i < 16; i++ {
			if physical(i) == physicalReg {
				patch = at
				immediate(out, reg(i), int64(value))
				patch = -1
				return
			}
		}
	}
	func patchRelocations(out *RTGEmitter) {
		for i := 0; i < out.RelocationCount(); i++ {
			patchImmediate(out, out.RelocationOffset(i), linux_elf.codeAddress+out.LabelPosition(out.RelocationLabel(i)))
