		if cpu == 4 {
			lr := 31
			if link {
				lr = 26
			}
			insn(out, 0x68000000|(lr<<21)|(rr<<16))
			return
		}
		if cpu == 7 {
			lr := 0
			if link {
				lr = 15
			}
			insn(out, 0x81c00000|(lr<<25)|(rr<<14))
			insn(out, 0x01000000)
			return
