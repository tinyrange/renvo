	}
	func image(out *RTGEmitter, machine int, flags int) []byte {
		for i := 0; i < out.AbsoluteRelocationCount(); i++ {
			target, ok := RTGResolveAbsoluteRelocation(out, out.AbsoluteRelocationKind(i), out.AbsoluteRelocationAddend(i), linux_elf.dataAddress(out), linux_elf.bssAddress(out))
			if !ok {
				return nil
			}
			patchImmediate(out, out.AbsoluteRelocationOffset(i), target)
		}
		return linux_elf.image(out, machine, flags, word*8, big)
	}
	func init(out *RTGEmitter, kind int, width int, be bool) bool {
