# SPDX-License-Identifier: Apache-2.0
# Self-contained Linux backend. Copy this file to use or extend this target.
definition 1
unit linux_loongarch64
implements direct_emitter_v1
go backend {
	const elfCodeAddress = 0x11000

	func elfDataOffset(out *RTGEmitter) int  { return RTGAlignValue(0x1000+len(out.Code()), 0x10000) }
	func elfDataAddress(out *RTGEmitter) int { return 0x10000 + elfDataOffset(out) }
	func elfBssAddress(out *RTGEmitter) int {
		return RTGAlignValue(elfDataAddress(out)+len(out.Data()), 16)
	}
	func elfPut(image []byte, at int, value uint64, width int, big bool) {
		for i := 0; i < width; i++ {
			shift := i * 8
			if big {
				shift = (width - 1 - i) * 8
			}
			image[at+i] = byte(value >> uint(shift))
		}
	}
	func elfImage(out *RTGEmitter, machine int, flags int, bits int, big bool) []byte {
		offset := elfDataOffset(out)
		result := make([]byte, offset+len(out.Data()))
		result[0] = 0x7f
		result[1] = 'E'
		result[2] = 'L'
		result[3] = 'F'
		result[4] = 1
		if bits == 64 {
			result[4] = 2
		}
		result[5] = 1
		if big {
			result[5] = 2
		}
		result[6] = 1
		elfPut(result, 16, 2, 2, big)
		elfPut(result, 18, uint64(machine), 2, big)
		elfPut(result, 20, 1, 4, big)
		if bits == 32 {
			elfPut(result, 24, elfCodeAddress, 4, big)
			elfPut(result, 28, 52, 4, big)
			elfPut(result, 36, uint64(flags), 4, big)
			elfPut(result, 40, 52, 2, big)
			elfPut(result, 42, 32, 2, big)
			elfPut(result, 44, 2, 2, big)
		} else {
			elfPut(result, 24, elfCodeAddress, 8, big)
			elfPut(result, 32, 64, 8, big)
			elfPut(result, 48, uint64(flags), 4, big)
			elfPut(result, 52, 64, 2, big)
			elfPut(result, 54, 56, 2, big)
			elfPut(result, 56, 2, 2, big)
		}
		for i := 0; i < 2; i++ {
			file := 0
			address := 0x10000
			size := 0x1000 + len(out.Code())
			memory := size
			permissions := 5
			if i == 1 {
				file = offset
				address = elfDataAddress(out)
				size = len(out.Data())
				memory = elfBssAddress(out) - address + out.BSSSize()
				permissions = 6
			}
			if bits == 32 {
				at := 52 + i*32
				elfPut(result, at, 1, 4, big)
				elfPut(result, at+4, uint64(file), 4, big)
				elfPut(result, at+8, uint64(address), 4, big)
				elfPut(result, at+12, uint64(address), 4, big)
				elfPut(result, at+16, uint64(size), 4, big)
				elfPut(result, at+20, uint64(memory), 4, big)
				elfPut(result, at+24, uint64(permissions), 4, big)
				elfPut(result, at+28, 0x10000, 4, big)
			} else {
				at := 64 + i*56
				elfPut(result, at, 1, 4, big)
				elfPut(result, at+4, uint64(permissions), 4, big)
				elfPut(result, at+8, uint64(file), 8, big)
				elfPut(result, at+16, uint64(address), 8, big)
				elfPut(result, at+24, uint64(address), 8, big)
				elfPut(result, at+32, uint64(size), 8, big)
				elfPut(result, at+40, uint64(memory), 8, big)
				elfPut(result, at+48, 0x10000, 8, big)
			}
		}
		copy(result[0x1000:], out.Code())
		copy(result[offset:], out.Data())
		return result
	}

	const encoderWord = 8
	const encoderBig = false

	var encoderPatch int = -1

	func encoderReg(code int) RTGRegister { return RTGRegister{Code: code, Valid: true} }
	func encoderPosition(out *RTGEmitter) int {
		if encoderPatch >= 0 {
			return encoderPatch
		}
		return out.Len()
	}
	func encoderByteOut(out *RTGEmitter, value byte) {
		if encoderPatch >= 0 {
			out.SetByteAt(encoderPatch, value)
			encoderPatch++
			return
		}
		RTGByte(out, value)
	}
	func encoderInsn(out *RTGEmitter, value int) {
		for i := 0; i < 4; i++ {
			shift := i * 8

			encoderByteOut(out, byte(value>>uint(shift)))
		}
	}

	func encoderTempReg() int {
		return 31
	}
	func encoderPhysical(code int) int {
		if code < 3 {
			return code + 4
		}
		if code < 13 {
			return code + 9
		}
		if code == 13 {
			return 1
		}
		if code == 14 {
			return 3
		}
		return 22
	}
	func encoderSmall(out *RTGEmitter, destination int, value int) {
		encoderInsn(out, 0x02c00000|((value&4095)<<10)|destination)
	}

	func encoderAlu(out *RTGEmitter, op int, destination int, left int, right int) {
		opcode := 0x00108000
		if op == 1 {
			opcode = 0x00118000
		}
		if op == 2 {
			opcode = 0x00148000
		}
		if op == 3 {
			opcode = 0x00150000
		}
		if op == 4 {
			opcode = 0x00158000
		}
		if op == 5 {
			opcode = 0x001d8000
		}
		if op == 6 {
			opcode = 0x00188000
		}
		if op == 7 {
			opcode = 0x00190000
		}
		if op == 8 {
			opcode = 0x00198000
		}
		if op == 9 {
			opcode = 0x00220000
		}
		if op == 10 {
			opcode = 0x00230000
		}
		encoderInsn(out, opcode|(right<<10)|(left<<5)|destination)
	}
	func encoderMove(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		if destination.Code != source.Code {
			encoderAlu(out, 3, encoderPhysical(destination.Code), encoderPhysical(source.Code), encoderPhysical(source.Code))
		}
	}
	func encoderImmediate(out *RTGEmitter, destination RTGRegister, value int64) {
		d := encoderPhysical(destination.Code)

		encoderSmall(out, d, int(uint64(value)>>uint((encoderWord-1)*8))&255)
		for i := encoderWord - 2; i >= 0; i-- {
			encoderSmall(out, encoderTempReg(), 8)
			encoderAlu(out, 6, d, d, encoderTempReg())
			encoderSmall(out, encoderTempReg(), int(uint64(value)>>uint(i*8))&255)
			encoderAlu(out, 3, d, d, encoderTempReg())
		}
	}
	func encoderBinary(out *RTGEmitter, op int, destination RTGRegister, source RTGRegister) {
		encoderAlu(out, op, encoderPhysical(destination.Code), encoderPhysical(destination.Code), encoderPhysical(source.Code))
	}
	func encoderAdd(out *RTGEmitter, d RTGRegister, s RTGRegister)      { encoderBinary(out, 0, d, s) }
	func encoderSubtract(out *RTGEmitter, d RTGRegister, s RTGRegister) { encoderBinary(out, 1, d, s) }
	func encoderBitAnd(out *RTGEmitter, d RTGRegister, s RTGRegister)   { encoderBinary(out, 2, d, s) }
	func encoderBitOr(out *RTGEmitter, d RTGRegister, s RTGRegister)    { encoderBinary(out, 3, d, s) }
	func encoderBitXor(out *RTGEmitter, d RTGRegister, s RTGRegister)   { encoderBinary(out, 4, d, s) }
	func encoderMultiply(out *RTGEmitter, d RTGRegister, s RTGRegister) { encoderBinary(out, 5, d, s) }
	func encoderIncrement(out *RTGEmitter, d RTGRegister) {
		encoderSmall(out, encoderTempReg(), 1)
		encoderAlu(out, 0, encoderPhysical(d.Code), encoderPhysical(d.Code), encoderTempReg())
	}
	func encoderDecrement(out *RTGEmitter, d RTGRegister) {
		encoderSmall(out, encoderTempReg(), 1)
		encoderAlu(out, 1, encoderPhysical(d.Code), encoderPhysical(d.Code), encoderTempReg())
	}
	func encoderShiftImmediate(out *RTGEmitter, d RTGRegister, value byte, op int) {
		encoderSmall(out, encoderTempReg(), int(value))
		encoderAlu(out, op, encoderPhysical(d.Code), encoderPhysical(d.Code), encoderTempReg())
	}
	func encoderShiftLeft(out *RTGEmitter, d RTGRegister, value byte) {
		encoderShiftImmediate(out, d, value, 6)
	}
	func encoderShiftRight(out *RTGEmitter, d RTGRegister, value byte) {
		encoderShiftImmediate(out, d, value, 7)
	}
	func encoderShiftSigned(out *RTGEmitter, d RTGRegister, value byte) {
		encoderShiftImmediate(out, d, value, 8)
	}
	func encoderVariableShift(out *RTGEmitter, direction RTGShiftDirection, signed bool) {
		op := 6
		if direction == RTGShiftRight {
			op = 7
			if signed {
				op = 8
			}
		}
		encoderAlu(out, op, encoderPhysical(0), encoderPhysical(2), encoderPhysical(0))
	}
	func encoderDivide(out *RTGEmitter, remainder bool, unsigned bool) {
		op := 9
		if unsigned {
			op = 10
		}
		if remainder {
			encoderAlu(out, op, encoderPhysical(3), encoderPhysical(2), encoderPhysical(0))
			encoderAlu(out, 5, encoderPhysical(3), encoderPhysical(3), encoderPhysical(0))
			encoderAlu(out, 1, encoderPhysical(0), encoderPhysical(2), encoderPhysical(3))
		} else {
			encoderAlu(out, op, encoderPhysical(0), encoderPhysical(2), encoderPhysical(0))
		}
	}
	func encoderSignedDivide(out *RTGEmitter, remainder bool) { encoderDivide(out, remainder, false) }
	func encoderUnsignedDivide(out *RTGEmitter, remainder bool) bool {
		encoderDivide(out, remainder, true)
		return true
	}
	func encoderEffective(out *RTGEmitter, value RTGAddress) RTGRegister {
		d := encoderReg(12)
		if RTGAddressValid(value) {
			encoderAddress(out, d, value)
			return d
		}
		encoderImmediate(out, d, int64(value.Displacement))
		if value.Base.Valid {
			encoderAdd(out, d, value.Base)
		}
		if value.Index.Valid {
			encoderMove(out, encoderReg(11), value.Index)
			encoderShiftLeft(out, encoderReg(11), byte(RTGLog2(value.Scale)))
			encoderAdd(out, d, encoderReg(11))
		}
		return d
	}
	func encoderAddress(out *RTGEmitter, d RTGRegister, value RTGAddress) {
		if RTGAddressValid(value) {
			at := out.Len()
			encoderImmediate(out, d, 0)
			RTGAddressRelocAt(out, value, at)
			return
		}
		a := encoderEffective(out, value)
		encoderMove(out, d, a)
	}
	func encoderMemory(out *RTGEmitter, d RTGRegister, value RTGAddress, size int, store bool) {
		a := encoderPhysical(encoderEffective(out, value).Code)
		r := encoderPhysical(d.Code)

		opcode := 0x2a000000
		if size == 2 {
			opcode = 0x2a400000
		}
		if size == 4 {
			opcode = 0x2a800000
		}
		if size == 8 {
			opcode = 0x28c00000
		}
		if store {
			opcode = 0x29000000
			if size == 2 {
				opcode = 0x29400000
			}
			if size == 4 {
				opcode = 0x29800000
			}
			if size == 8 {
				opcode = 0x29c00000
			}
		}
		encoderInsn(out, opcode|(a<<5)|r)
	}
	func encoderLoadNative(out *RTGEmitter, d RTGRegister, a RTGAddress) {
		encoderMemory(out, d, a, encoderWord, false)
	}
	func encoderLoadU32(out *RTGEmitter, d RTGRegister, a RTGAddress) { encoderMemory(out, d, a, 4, false) }
	func encoderLoadU16(out *RTGEmitter, d RTGRegister, a RTGAddress) { encoderMemory(out, d, a, 2, false) }
	func encoderLoadU8(out *RTGEmitter, d RTGRegister, a RTGAddress)  { encoderMemory(out, d, a, 1, false) }
	func encoderSignedLoad(out *RTGEmitter, d RTGRegister, a RTGAddress, size int) {
		encoderMemory(out, d, a, size, false)
		if size < encoderWord {
			encoderShiftLeft(out, d, byte((encoderWord-size)*8))
			encoderShiftSigned(out, d, byte((encoderWord-size)*8))
		}
	}
	func encoderLoadI32(out *RTGEmitter, d RTGRegister, a RTGAddress) { encoderSignedLoad(out, d, a, 4) }
	func encoderLoadI16(out *RTGEmitter, d RTGRegister, a RTGAddress) { encoderSignedLoad(out, d, a, 2) }
	func encoderLoadI8(out *RTGEmitter, d RTGRegister, a RTGAddress)  { encoderSignedLoad(out, d, a, 1) }
	func encoderStoreNative(out *RTGEmitter, a RTGAddress, s RTGRegister) {
		encoderMemory(out, s, a, encoderWord, true)
	}
	func encoderStoreU32(out *RTGEmitter, a RTGAddress, s RTGRegister) { encoderMemory(out, s, a, 4, true) }
	func encoderStoreU16(out *RTGEmitter, a RTGAddress, s RTGRegister) { encoderMemory(out, s, a, 2, true) }
	func encoderStoreU8(out *RTGEmitter, a RTGAddress, s RTGRegister)  { encoderMemory(out, s, a, 1, true) }
	func encoderLess(out *RTGEmitter, d RTGRegister, l RTGRegister, r RTGRegister, unsigned bool) {
		rd := encoderPhysical(d.Code)
		rl := encoderPhysical(l.Code)
		rr := encoderPhysical(r.Code)

		op := 0x00120000
		if unsigned {
			op = 0x00128000
		}
		encoderInsn(out, op|(rr<<10)|(rl<<5)|rd)
	}
	func encoderCompare(out *RTGEmitter, l RTGRegister, r RTGRegister) {
		encoderMove(out, encoderReg(11), r)
		encoderMove(out, encoderReg(5), l)
		encoderMove(out, encoderReg(6), encoderReg(11))
	}
	func encoderTest(out *RTGEmitter, l RTGRegister, r RTGRegister) {
		encoderMove(out, encoderReg(11), r)
		encoderMove(out, encoderReg(5), l)
		encoderBitAnd(out, encoderReg(5), encoderReg(11))
		encoderImmediate(out, encoderReg(6), 0)
	}
	func encoderCondition(out *RTGEmitter, c RTGCondition, d RTGRegister) {
		code := c.Code
		invert := false
		l := encoderReg(5)
		r := encoderReg(6)
		if code < 2 {
			encoderMove(out, d, l)
			encoderBitXor(out, d, r)
			encoderImmediate(out, encoderReg(11), 0)
			encoderLess(out, d, encoderReg(11), d, true)
			invert = code == 0
		} else {
			if code == 2 || code == 3 || code == 8 || code == 9 {
				l = encoderReg(6)
				r = encoderReg(5)
			}
			encoderLess(out, d, l, r, code >= 6)
			invert = code == 2 || code == 5 || code == 7 || code == 8
		}
		if invert {
			encoderSmall(out, encoderTempReg(), 1)
			encoderAlu(out, 4, encoderPhysical(d.Code), encoderPhysical(d.Code), encoderTempReg())
		}
	}
	func encoderBranchZero(out *RTGEmitter, r RTGRegister, target int) {
		at := encoderPosition(out)
		rr := encoderPhysical(r.Code)

		delta := (target - at) >> 2
		encoderInsn(out, 0x58000000|((delta&65535)<<10)|(rr<<5))
	}
	func encoderBranchRegister(out *RTGEmitter, r RTGRegister, link bool) {
		rr := encoderPhysical(r.Code)

		lr := 0
		if link {
			lr = 1
		}
		encoderInsn(out, 0x4c000000|(rr<<5)|lr)
	}
	func encoderJump(out *RTGEmitter, label RTGLabel) {
		at := out.Len()
		encoderImmediate(out, encoderReg(4), 0)
		out.RelocAt(at, label)
		encoderBranchRegister(out, encoderReg(4), false)
	}
	func encoderCall(out *RTGEmitter, label RTGLabel) {
		at := out.Len()
		encoderImmediate(out, encoderReg(4), 0)
		out.RelocAt(at, label)
		encoderBranchRegister(out, encoderReg(4), true)
	}
	func encoderCallIndirect(out *RTGEmitter, r RTGRegister) { encoderBranchRegister(out, r, true) }
	func encoderJumpCondition(out *RTGEmitter, c RTGCondition, label RTGLabel) {
		encoderCondition(out, c, encoderReg(3))
		at := out.Len()
		encoderBranchZero(out, encoderReg(3), at)
		encoderJump(out, label)
		end := out.Len()
		encoderPatch = at
		encoderBranchZero(out, encoderReg(3), end)
		encoderPatch = -1
	}
	func encoderFrameStart(out *RTGEmitter) int {
		encoderMove(out, encoderReg(4), encoderReg(15))
		encoderMove(out, encoderReg(15), encoderReg(14))
		at := out.Len()
		encoderImmediate(out, encoderReg(3), 0)
		encoderSubtract(out, encoderReg(14), encoderReg(3))
		encoderStoreNative(out, RTGAddress{Base: encoderReg(15), Displacement: -encoderWord}, encoderReg(13))
		encoderStoreNative(out, RTGAddress{Base: encoderReg(15), Displacement: -2 * encoderWord}, encoderReg(4))
		return at
	}
	func encoderFrameFinish(out *RTGEmitter, at int, size int) {
		encoderPatch = at
		encoderImmediate(out, encoderReg(3), int64(RTGAlignValue(size+2*encoderWord, 16)))
		encoderPatch = -1
	}
	func encoderFrameLoad(out *RTGEmitter, d RTGRegister, offset int) {
		encoderLoadNative(out, d, RTGAddress{Base: encoderReg(15), Displacement: -(offset + 2*encoderWord)})
	}
	func encoderFrameStore(out *RTGEmitter, offset int, s RTGRegister) {
		encoderStoreNative(out, RTGAddress{Base: encoderReg(15), Displacement: -(offset + 2*encoderWord)}, s)
	}
	func encoderFrameAddress(out *RTGEmitter, d RTGRegister, offset int) {
		encoderAddress(out, d, RTGAddress{Base: encoderReg(15), Displacement: -(offset + 2*encoderWord)})
	}
	func encoderLeave(out *RTGEmitter) {
		encoderLoadNative(out, encoderReg(13), RTGAddress{Base: encoderReg(15), Displacement: -encoderWord})
		encoderLoadNative(out, encoderReg(3), RTGAddress{Base: encoderReg(15), Displacement: -2 * encoderWord})
		encoderMove(out, encoderReg(14), encoderReg(15))
		encoderMove(out, encoderReg(15), encoderReg(3))
	}
	func encoderRet(out *RTGEmitter) {
		encoderBranchRegister(out, encoderReg(13), false)
	}
	func encoderPatchImmediate(out *RTGEmitter, at int, value int) {
		bytes := out.Code()
		instruction := 0
		for i := 0; i < 4; i++ {
			shift := i * 8

			instruction |= int(bytes[at+i]) << uint(shift)
		}
		physicalReg := instruction & 31

		for i := 0; i < 16; i++ {
			if encoderPhysical(i) == physicalReg {
				encoderPatch = at
				encoderImmediate(out, encoderReg(i), int64(value))
				encoderPatch = -1
				return
			}
		}
	}
	func encoderPatchRelocations(out *RTGEmitter) {
		for i := 0; i < out.RelocationCount(); i++ {
			encoderPatchImmediate(out, out.RelocationOffset(i), elfCodeAddress+out.LabelPosition(out.RelocationLabel(i)))
		}
	}
	func encoderImage(out *RTGEmitter, machine int, flags int) []byte {
		for i := 0; i < out.AbsoluteRelocationCount(); i++ {
			target, ok := RTGResolveAbsoluteRelocation(out, out.AbsoluteRelocationKind(i), out.AbsoluteRelocationAddend(i), elfDataAddress(out), elfBssAddress(out))
			if !ok {
				return nil
			}
			encoderPatchImmediate(out, out.AbsoluteRelocationOffset(i), target)
		}
		return elfImage(out, machine, flags, encoderWord*8, encoderBig)
	}
	func encoderInit(out *RTGEmitter) bool {
		_ = out

		encoderPatch = -1

		return true
	}
	func encoderEntry(out *RTGEmitter, count int, state int) bool { _ = out; _ = state; return count == 0 }
	func encoderSyscall(out *RTGEmitter, number int) {
		encoderSmall(out, 11, number)
		encoderInsn(out, 0x002b0000)
	}
	func encoderWrite(out *RTGEmitter) {
		n := 64

		encoderSyscall(out, n)
	}
	func encoderRead(out *RTGEmitter) {
		n := 63

		encoderSyscall(out, n)
	}
	func encoderClose(out *RTGEmitter) {
		n := 57

		encoderSyscall(out, n)
	}
	func encoderChmod(out *RTGEmitter) {
		n := 52

		encoderSyscall(out, n)
	}
	func encoderOpen(out *RTGEmitter) {
		encoderAlu(out, 3, 7, 6, 6)
		encoderAlu(out, 3, 6, 5, 5)
		encoderAlu(out, 3, 5, 4, 4)
		encoderSmall(out, 4, -100)
		encoderSyscall(out, 56)
	}
	func encoderExit(out *RTGEmitter, status RTGRegister) {
		encoderMove(out, encoderReg(0), status)
		n := 93

		encoderSyscall(out, n)
	}
	func encoderCopyBytes(out *RTGEmitter) {
		forward := out.NewLabel()
		backward := out.NewLabel()
		loop := out.NewLabel()
		done := out.NewLabel()
		encoderCompare(out, encoderReg(7), encoderReg(8))
		encoderJumpCondition(out, RTGCondition{Code: 6}, forward)
		encoderMove(out, encoderReg(3), encoderReg(8))
		encoderAdd(out, encoderReg(3), encoderReg(9))
		encoderCompare(out, encoderReg(7), encoderReg(3))
		encoderJumpCondition(out, RTGCondition{Code: 7}, forward)
		encoderAdd(out, encoderReg(7), encoderReg(9))
		encoderDecrement(out, encoderReg(7))
		encoderAdd(out, encoderReg(8), encoderReg(9))
		encoderDecrement(out, encoderReg(8))
		out.Mark(backward)
		encoderImmediate(out, encoderReg(3), 0)
		encoderCompare(out, encoderReg(9), encoderReg(3))
		encoderJumpCondition(out, RTGCondition{Code: 0}, done)
		encoderLoadU8(out, encoderReg(3), RTGAddress{Base: encoderReg(8)})
		encoderStoreU8(out, RTGAddress{Base: encoderReg(7)}, encoderReg(3))
		encoderDecrement(out, encoderReg(7))
		encoderDecrement(out, encoderReg(8))
		encoderDecrement(out, encoderReg(9))
		encoderJump(out, backward)
		out.Mark(forward)
		out.Mark(loop)
		encoderImmediate(out, encoderReg(3), 0)
		encoderCompare(out, encoderReg(9), encoderReg(3))
		encoderJumpCondition(out, RTGCondition{Code: 0}, done)
		encoderLoadU8(out, encoderReg(3), RTGAddress{Base: encoderReg(8)})
		encoderStoreU8(out, RTGAddress{Base: encoderReg(7)}, encoderReg(3))
		encoderIncrement(out, encoderReg(7))
		encoderIncrement(out, encoderReg(8))
		encoderDecrement(out, encoderReg(9))
		encoderJump(out, loop)
		out.Mark(done)
	}

	func encoderHostSyscall(out *RTGEmitter) {
		encoderInsn(out, 0x002b0000)
		return
	}

	func targetStart(out *RTGEmitter, state int) bool { _ = state; return encoderInit(out) }
	func targetImage(out *RTGEmitter) []byte          { return encoderImage(out, 258, 67) }
}

arch loongarch64 {
	alias = "loongarch64"
	endian = little
	word_bits = 64
	pointer_bits = 64
	instruction_alignment = 4
	stack_word_bytes = 8
	stack_alignment = 16
	patch_relocations = go encoderPatchRelocations
	registers integer = [r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12, r13, r14, r15]
	locations {
		primary = r0
		secondary = r1
		tertiary = r2
		scratch = r3
		address = r4
		compareLeft = r5
		compareRight = r6
		copy_destination = r7
		copy_source = r8
		copy_count = r9
		link = r13
		stack = r14
		frame = r15
	}
	conditions {
		eq = 0
		ne = 1
		sle = 2
		sgt = 3
		slt = 4
		sge = 5
		ult = 6
		uge = 7
		ule = 8
		ugt = 9
	}
	bind {
		move = go encoderMove
		address = go encoderAddress
		load.native = go encoderLoadNative
		load.i32 = go encoderLoadI32
		load.u32 = go encoderLoadU32
		load.i16 = go encoderLoadI16
		load.u16 = go encoderLoadU16
		load.i8 = go encoderLoadI8
		load.u8 = go encoderLoadU8
		store.native = go encoderStoreNative
		store.u32 = go encoderStoreU32
		store.u16 = go encoderStoreU16
		store.u8 = go encoderStoreU8
		add = go encoderAdd
		subtract = go encoderSubtract
		multiply = go encoderMultiply
		bit_and = go encoderBitAnd
		bit_or = go encoderBitOr
		bit_xor = go encoderBitXor
		compare = go encoderCompare
		test = go encoderTest
		increment = go encoderIncrement
		decrement = go encoderDecrement
		shift_left_immediate = go encoderShiftLeft
		shift_right_unsigned_immediate = go encoderShiftRight
		shift_right_signed_immediate = go encoderShiftSigned
		call = go encoderCall
		call_indirect = go encoderCallIndirect
		jump = go encoderJump
		jump_condition = go encoderJumpCondition
		set_condition = go encoderCondition
		return = go encoderRet
		leave = go encoderLeave
		host_syscall = go encoderHostSyscall
		move_immediate = go encoderImmediate
		variable_shift = go encoderVariableShift
		signed_divide = go encoderSignedDivide
		copy_bytes = go encoderCopyBytes
	}
}
abi internal_loongarch64 {
	arch = loongarch64
	arguments = [r0, r1, r2, r7, r8, r9]
	call_words = [r0, r1, r2, r7, r8, r9]
	result = [r0, r1]
	stack_alignment = 16
	frame_start = go encoderFrameStart
	frame_finish = go encoderFrameFinish
	frame_load = go encoderFrameLoad
	frame_store = go encoderFrameStore
	frame_address = go encoderFrameAddress
	unsigned_divide = go encoderUnsignedDivide
}
runtime runtime_loongarch64 {
	managed_heap_abi = 1
	managed_word_bits = 64
	managed_source = go managedSource
	managed_startup = go managedStartup
	managed_boundary = go managedBoundary
	emit_syscall_from_stack = go managedRawSyscall

	emit_entry_start = go targetStart
	emit_entry = go encoderEntry
	emit_exit = go encoderExit
	operation write {
		emit = go encoderWrite
	}
	operation read {
		emit = go encoderRead
	}
	operation open {
		emit = go encoderOpen
	}
	operation close {
		emit = go encoderClose
	}
	operation chmod {
		emit = go encoderChmod
	}
	operation print {
		use = write args = [stdout, buffer, count]
	}
}
format elf_loongarch64 {
	kind = elf
	byte_order = little
	address_bits = 64
	code_offset = 0
	image = go targetImage
}
target experimental/linux-loongarch64 {
	family = native_v1
	os = linux
	arch = loongarch64
	abi = internal_loongarch64
	runtime = runtime_loongarch64
	executable = elf_loongarch64
	arena_default = 16777216
	build_tags = [linux, unix, loongarch64]
	capabilities = [hosted, executable, filesystem, heap]
}

# Shared managed collector and Linux services embedded for standalone use.
go backend {
	func managedHeap64Source() string { return managedHeapSource(8) }
	func managedHeap32Source() string { return managedHeapSource(4) }

	// Headers keep their aligned layout; payload/root scanning follows native words.
	func managedHeapSource(wordBytes int) string {
		constants := "const __renvoManagedWordBytes = uintptr(8)\nconst __renvoManagedMax = uintptr(9223372036854775807)\n"
		if wordBytes == 4 {
			constants = "const __renvoManagedWordBytes = uintptr(4)\nconst __renvoManagedMax = uintptr(2147483647)\n"
		}
		return constants + `
					// Desktop heap runtime, parsed and compiled with the application. No helper
					// below allocates through make/new/append or calls application code.
					var __renvoManagedState [16]uintptr

					func __renvoManagedRead(p uintptr) uintptr { return *(*uintptr)(p) }
					func __renvoManagedWrite(p uintptr, v uintptr) { *(*uintptr)(p) = v }
					func __renvoManagedByte(p uintptr) byte { return *(*byte)(p) }

					func __renvoManagedLimit(p uintptr) uintptr {
						var value uintptr
						var digits int
						for __renvoManagedByte(p) >= '0' && __renvoManagedByte(p) <= '9' {
							digit := uintptr(__renvoManagedByte(p)-'0')
							if value > (__renvoManagedMax-digit)/10 { return 0 }
							value = value*10+digit
							p++
							digits++
						}
						if digits == 0 || value == 0 { return 0 }
						var shift uintptr
						if __renvoManagedByte(p) != 0 {
							c := __renvoManagedByte(p)
							if c == 'K' { shift = 10 } else if c == 'M' { shift = 20 } else if c == 'G' { shift = 30 } else if c == 'T' { shift = 40 } else { return 0 }
							if __renvoManagedByte(p+1) != 'i' || __renvoManagedByte(p+2) != 'B' || __renvoManagedByte(p+3) != 0 { return 0 }
						}
						if value > __renvoManagedMax>>shift { return 0 }
						return value << shift
					}

					func __renvoManagedInit(limit uintptr, stack uintptr, globals uintptr, end uintptr) {
						if limit == 0 { limit = __renvoManagedMax }
						override := __renvoManagedEnvironment(stack)
						if override != 0 {
							limit = __renvoManagedLimit(override)
							if limit == 0 { __renvoManagedFatal("renvo: invalid RENVO_HEAP_LIMIT\n") }
						}
						// State and the common allocator's 32-byte compatibility bookkeeping.
						if limit < 160 { __renvoManagedFatal("panic: out of memory\n") }
						__renvoManagedState[1] = limit
						__renvoManagedState[2] = 160
						__renvoManagedState[3] = stack
						__renvoManagedState[6] = globals
						__renvoManagedState[7] = end
						__renvoManagedState[8] = 65536
					}

					// Segment header: next, mapping size, payload offset, reserved word; then one
					// block-header index per mapped page. All of this resides in charged mappings.
					func __renvoManagedHeader(size uintptr) uintptr { return (32+(size/__renvoManagedPageSize)*8+15)&^uintptr(15) }
					func __renvoManagedIndex(s uintptr, b uintptr, span uintptr) {
						first := (b-s+(__renvoManagedPageSize-1))/__renvoManagedPageSize
						end := (b-s+span+(__renvoManagedPageSize-1))/__renvoManagedPageSize
						for page := first; page < end; page++ { __renvoManagedWrite(s+32+page*8, b) }
					}
					func __renvoManagedFind(pointer uintptr) uintptr {
						for s := __renvoManagedState[0]; s != 0; s = __renvoManagedRead(s) {
							size := __renvoManagedRead(s+8)
							if pointer < s+__renvoManagedRead(s+16)+16 || pointer-s >= size { continue }
							b := __renvoManagedRead(s+32+((pointer-s)/__renvoManagedPageSize)*8)
							for b < s+size {
								span := __renvoManagedRead(b)
								if pointer < b+span {
									if pointer >= b+16 && __renvoManagedRead(b+8)&1 != 0 { return b }
									return 0
								}
								b += span
							}
						}
						return 0
					}
					func __renvoManagedMark(pointer uintptr) {
						b := __renvoManagedFind(pointer)
						if b != 0 && __renvoManagedRead(b+8)&2 == 0 {
							// Block headers are 16-byte aligned. During marking the upper bits
							// hold the next work item; low bits retain allocated/marked flags.
							__renvoManagedWrite(b+8, __renvoManagedState[9]|3)
							__renvoManagedState[9] = b
						}
					}
					func __renvoManagedScan(start uintptr, end uintptr) {
						for p := start; p < end; p += __renvoManagedWordBytes { __renvoManagedMark(__renvoManagedRead(p)) }
					}
					func __renvoManagedCollect(roots uintptr) {
						__renvoManagedState[4] = 0
						__renvoManagedState[5] = 0
						__renvoManagedState[9] = 0
						__renvoManagedRoots(roots)
						state := uintptr(&__renvoManagedState[0])
						__renvoManagedScan(__renvoManagedState[6], state)
						__renvoManagedScan(state+16*__renvoManagedWordBytes, __renvoManagedState[7])
						for __renvoManagedState[9] != 0 {
							b := __renvoManagedState[9]
							__renvoManagedState[9] = __renvoManagedRead(b+8)&^uintptr(15)
							__renvoManagedWrite(b+8, 3)
							__renvoManagedScan(b+16, b+__renvoManagedRead(b))
						}
						var previous uintptr
						var live uintptr
						for s := __renvoManagedState[0]; s != 0; {
							size := __renvoManagedRead(s+8)
							var free uintptr
							used := false
							for b := s+__renvoManagedRead(s+16); b < s+size; {
								span := __renvoManagedRead(b)
								if __renvoManagedRead(b+8)&2 != 0 {
									__renvoManagedWrite(b+8, 1)
									free = 0
									used = true
									live += span
								} else {
									__renvoManagedWrite(b+8, 0)
									if free != 0 { __renvoManagedWrite(free, __renvoManagedRead(free)+span) } else { free = b }
								}
								b += span
							}
							next := __renvoManagedRead(s)
							if !used {
								if previous == 0 { __renvoManagedState[0] = next } else { __renvoManagedWrite(previous, next) }
								if !__renvoManagedRelease(s, size) { __renvoManagedFatal("renvo: managed heap release failed\n") }
								__renvoManagedState[2] -= size
							} else {
								previous = s
								__renvoManagedWrite(s+32, s+__renvoManagedRead(s+16))
								for b := s+__renvoManagedRead(s+16); b < s+size; b += __renvoManagedRead(b) {
									__renvoManagedIndex(s, b, __renvoManagedRead(b))
								}
							}
							s = next
						}
						__renvoManagedState[10]++
						__renvoManagedState[12] = live
					}
					func __renvoManagedClaim(s uintptr, b uintptr, span uintptr) uintptr {
						available := __renvoManagedRead(b)
						__renvoManagedState[4] = 0
						if available-span >= 32 {
							__renvoManagedWrite(b+span, available-span)
							__renvoManagedWrite(b+span+8, 0)
							__renvoManagedWrite(b, span)
							__renvoManagedState[4] = b+span
							__renvoManagedState[5] = s
							available = span
						}
						// Only occupied pages need a fresh index. An older free-page index is
						// still a valid earlier block; lookup walks forward until sweep rebuilds it.
						__renvoManagedIndex(s, b, available)
						__renvoManagedWrite(b+8, 1)
						for p := b+16; p < b+available; p += __renvoManagedWordBytes { __renvoManagedWrite(p, 0) }
						return b+16
					}
					func __renvoManagedTake(span uintptr) uintptr {
						b := __renvoManagedState[4]
						if b != 0 && __renvoManagedRead(b) >= span {
							return __renvoManagedClaim(__renvoManagedState[5], b, span)
						}
						for s := __renvoManagedState[0]; s != 0; s = __renvoManagedRead(s) {
							end := s+__renvoManagedRead(s+8)
							for b := s+__renvoManagedRead(s+16); b < end; b += __renvoManagedRead(b) {
								if __renvoManagedRead(b+8) == 0 && __renvoManagedRead(b) >= span {
									return __renvoManagedClaim(s, b, span)
								}
							}
						}
						return 0
					}
					func __renvoManagedRequest(size uintptr, roots uintptr) uintptr {
						if size > __renvoManagedMax-(__renvoManagedPageSize+31) { return 0 }
						if size == 0 { size = 16 }
						span := ((size+15)&^uintptr(15))+16
						result := __renvoManagedTake(span)
						if result != 0 { return result }
						if __renvoManagedState[0] != 0 {
							__renvoManagedCollect(roots)
							result = __renvoManagedTake(span)
							if result != 0 { return result }
						}
						minimum := (span+48+(__renvoManagedPageSize-1))&^uintptr((__renvoManagedPageSize-1))
						for minimum-__renvoManagedHeader(minimum) < span {
							minimum = (span+__renvoManagedHeader(minimum)+(__renvoManagedPageSize-1))&^uintptr((__renvoManagedPageSize-1))
						}
						available := (__renvoManagedState[1]-__renvoManagedState[2])&^uintptr((__renvoManagedPageSize-1))
						if minimum > available { return 0 }
						growth := __renvoManagedState[8]
						if growth < minimum { growth = minimum }
						if growth > available { growth = available }
						mapping := __renvoManagedMap(growth)
						if mapping == 0 && growth != minimum {
							growth = minimum
							mapping = __renvoManagedMap(growth)
						}
						if mapping == 0 { return 0 }
						base := uintptr(mapping)
						__renvoManagedWrite(base, __renvoManagedState[0])
						__renvoManagedWrite(base+8, growth)
						header := __renvoManagedHeader(growth)
						__renvoManagedWrite(base+16, header)
						for page := uintptr(0); page < growth/__renvoManagedPageSize; page++ { __renvoManagedWrite(base+32+page*8, base+header) }
						__renvoManagedWrite(base+header, growth-header)
						__renvoManagedState[4] = base+header
						__renvoManagedState[5] = base
						__renvoManagedState[0] = base
						__renvoManagedState[2] += growth
						if growth < __renvoManagedMax/2 { __renvoManagedState[8] = growth*2 }
						return __renvoManagedTake(span)
					}
					func __renvoManagedCollectBoundary(ignored uintptr, roots uintptr) uintptr {
						__renvoManagedCollect(roots)
						return 0
					}
					`
	}
}

go backend {
	func linuxManagedSource() string {
		return `
					//renvo:intrinsic renvo_runtime_Syscall
					func __renvoManagedSyscall(n int, a uintptr, b uintptr, c uintptr, d uintptr, e int, f uintptr) int { return -1 }
					
					func __renvoManagedMap(size uintptr) uintptr {
					 p := __renvoManagedSyscall(__renvoManagedMapNumber, 0, size, 3, __renvoManagedMapFlags, -1, 0)
					 if uintptr(p) >= ^uintptr(4094) { return 0 }; return uintptr(p)
					}
					func __renvoManagedRelease(base uintptr, size uintptr) bool { return __renvoManagedSyscall(__renvoManagedReleaseNumber, base, size, 0, 0, 0, 0) == 0 }
					func __renvoManagedFatal(message string) { print(message); __renvoManagedSyscall(__renvoManagedExitNumber, 2, 0, 0, 0, 0, 0) }
					func __renvoManagedEnvironment(stack uintptr) uintptr {
					 // Linux initial process stack: argc, argv[], null, envp[], null.
					 p := stack + 2*__renvoManagedWordBytes + __renvoManagedRead(stack)*__renvoManagedWordBytes
					 for __renvoManagedRead(p) != 0 {
					  entry := __renvoManagedRead(p)
					  matched := true
					  prefix := "RENVO_HEAP_LIMIT="
					  for i := 0; i < len(prefix); i++ {
					   if __renvoManagedByte(entry+uintptr(i)) != prefix[i] { matched = false; break }
					  }
					  if matched { return entry+17 }
					  p += __renvoManagedWordBytes
					 }
					 return 0
					}
					func __renvoManagedRoots(roots uintptr) {
					 if roots > __renvoManagedState[3] { __renvoManagedFatal("renvo: unsupported managed stack\n") }
					 __renvoManagedScan(roots, __renvoManagedState[3])
					}
					`
	}
}

go backend {
	func managedSource() string {
		return managedHeap64Source() + linuxManagedSource() + `
	const __renvoManagedPageSize = uintptr(4096)
	const __renvoManagedMapNumber = 222
	const __renvoManagedReleaseNumber = 215
	const __renvoManagedExitNumber = 93
	const __renvoManagedMapFlags = uintptr(34)
	`
	}
	func managedBSS(out *RTGEmitter, reg int, offset int) {
		at := out.Len()
		encoderImmediate(out, encoderReg(reg), 0)
		out.AbsoluteReloc(at, offset, RTGRelocationAbsoluteBSS)
	}
	func managedCall(out *RTGEmitter, label int) {
		at := out.Len()
		encoderImmediate(out, encoderReg(4), 0)
		out.RelocAt(at, label)
		encoderBranchRegister(out, encoderReg(4), true)
	}
	func managedStartup(out *RTGEmitter, limit int, label int) {
		encoderImmediate(out, encoderReg(7), int64(limit))
		encoderMove(out, encoderReg(2), encoderReg(15))
		managedBSS(out, 1, 0)
		managedBSS(out, 0, out.BSSSize())
		managedCall(out, label)
	}
	func managedStack(out *RTGEmitter, delta int) {
		encoderInsn(out, 0x02c00000|((delta&4095)<<10)|(3<<5)|3)
	}
	func managedMemory(out *RTGEmitter, reg int, offset int, store bool) {
		op := 0x28c00000
		if store {
			op = 0x29c00000
		}
		encoderInsn(out, op|((offset&4095)<<10)|(3<<5)|reg)
	}
	func managedBoundary(out *RTGEmitter, label int) {
		managedStack(out, -288)
		for reg := 0; reg < 32; reg++ {
			if reg != 3 {
				managedMemory(out, reg, reg*8, true)
			}
		}

		encoderMove(out, encoderReg(1), encoderReg(0))
		encoderMove(out, encoderReg(0), encoderReg(14))
		managedCall(out, label)

		for reg := 0; reg < 32; reg++ {
			if reg != 3 && reg != 4 {
				managedMemory(out, reg, reg*8, false)
			}
		}
		managedStack(out, 288)
	}
	func managedRawSyscall(out *RTGEmitter, count int, number int) bool {
		_ = number
		if count < 1 || count > 7 {
			return false
		}
		registers := []int{11, 4, 5, 6, 7, 8, 9}
		for i := 0; i < count; i++ {
			managedMemory(out, registers[i], i*8, false)
		}
		encoderInsn(out, 0x002b0000)
		managedStack(out, count*8)
		return true
	}
}
