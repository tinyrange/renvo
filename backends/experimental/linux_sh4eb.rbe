# SPDX-License-Identifier: Apache-2.0
# Self-contained Linux backend. Copy this file to use or extend this target.
definition 1
unit linux_sh4eb
implements direct_emitter_v1
go backend {
	var superhShCodeAddress int
	var superhShBigEndian bool
	var superhShComparisonSaved bool

	func superhShSetCodeAddress(address int) { superhShCodeAddress = address }
	func superhShSetBigEndian(value bool)    { superhShBigEndian = value }

	func superhShEmit16(out *RTGEmitter, value int) {
		if superhShBigEndian {
			RTGByte(out, byte(value>>8))
			RTGByte(out, byte(value))
			return
		}
		RTGByte(out, byte(value))
		RTGByte(out, byte(value>>8))
	}

	func superhShEmit32(out *RTGEmitter, value int) {
		if superhShBigEndian {
			RTGByte(out, byte(value>>24))
			RTGByte(out, byte(value>>16))
			RTGByte(out, byte(value>>8))
			RTGByte(out, byte(value))
			return
		}
		RTGUint32(out, value)
	}

	func superhShPatch16(out *RTGEmitter, at int, value int) {
		code := out.Code()
		if superhShBigEndian {
			code[at] = byte(value >> 8)
			code[at+1] = byte(value)
			return
		}
		code[at] = byte(value)
		code[at+1] = byte(value >> 8)
	}

	func superhShPatch32(out *RTGEmitter, at int, value int) {
		code := out.Code()
		if superhShBigEndian {
			code[at] = byte(value >> 24)
			code[at+1] = byte(value >> 16)
			code[at+2] = byte(value >> 8)
			code[at+3] = byte(value)
			return
		}
		out.PatchUint32(at, value)
	}

	func superhShMove(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		if destination.Code != source.Code {
			superhShEmit16(out, 0x6003|(destination.Code<<8)|(source.Code<<4))
		}
	}

	func superhShLiteral(out *RTGEmitter, destination RTGRegister, value int) int {
		if out.Len()&3 != 0 {
			superhShEmit16(out, 0x0009)
		}
		superhShEmit16(out, 0xd000|(destination.Code<<8)|1)
		superhShEmit16(out, 0xa003)
		superhShEmit16(out, 0x0009)
		superhShEmit16(out, 0x0009)
		at := out.Len()
		superhShEmit32(out, value)
		return at
	}

	func superhShMoveImmediate(out *RTGEmitter, destination RTGRegister, value int64) {
		immediate := int(value)
		if immediate >= -128 && immediate <= 127 {
			superhShEmit16(out, 0xe000|(destination.Code<<8)|(immediate&0xff))
			return
		}
		superhShLiteral(out, destination, immediate)
	}

	func superhShEmitAddress(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		if RTGAddressValid(value) {
			at := superhShLiteral(out, destination, 0)
			RTGAddressRelocAt(out, value, at)
			return
		}
		index := value.Index
		if index.Valid && (value.Scale != 1 || (index.Code == destination.Code && (!value.Base.Valid || value.Base.Code != destination.Code))) {
			// Preserve an index which aliases the destination before materializing
			// the base. Pick a temporary distinct from the base as well, since the
			// scaled-index path must retain both values until the final addition.
			temporary := superhShScratch()
			if value.Base.Valid && value.Base.Code == temporary.Code {
				temporary = superhShCompareLeft()
			}
			superhShMove(out, temporary, index)
			index = temporary
		}
		if value.Base.Valid {
			superhShMove(out, destination, value.Base)
		} else {
			superhShMoveImmediate(out, destination, 0)
		}
		if index.Valid {
			shift := RTGLog2(value.Scale)
			for shift > 0 {
				superhShEmit16(out, 0x4000|(index.Code<<8))
				shift--
			}
			superhShEmit16(out, 0x300c|(destination.Code<<8)|(index.Code<<4))
		}
		if value.Displacement != 0 {
			if value.Displacement >= -128 && value.Displacement <= 127 {
				superhShEmit16(out, 0x7000|(destination.Code<<8)|(value.Displacement&0xff))
			} else {
				temporary := superhShScratch()
				if destination.Code == temporary.Code {
					temporary = superhShCompareLeft()
				}
				superhShMoveImmediate(out, temporary, int64(value.Displacement))
				superhShEmit16(out, 0x300c|(destination.Code<<8)|(temporary.Code<<4))
			}
		}
	}

	func superhShMaterializeAddress(out *RTGEmitter, value RTGAddress) RTGRegister {
		superhShEmitAddress(out, superhShAddress(), value)
		return superhShAddress()
	}

	func superhShLoadWidth(out *RTGEmitter, destination RTGRegister, value RTGAddress, opcode int) {
		// Address formation borrows four physical helper registers. Save them,
		// load through compareRight, restore them, and only then publish the
		// result to its requested location.
		superhShEmit16(out, 0x2006|(superhShStack().Code<<8)|(superhShAddress().Code<<4))
		superhShEmit16(out, 0x2006|(superhShStack().Code<<8)|(superhShScratch().Code<<4))
		superhShEmit16(out, 0x2006|(superhShStack().Code<<8)|(superhShCompareLeft().Code<<4))
		superhShEmit16(out, 0x2006|(superhShStack().Code<<8)|(superhShCompareRight().Code<<4))
		adjusted := value
		if adjusted.Base.Valid && adjusted.Base.Code == superhShStack().Code {
			adjusted.Displacement += 16
		}
		address := superhShMaterializeAddress(out, adjusted)
		superhShEmit16(out, opcode|(superhShCompareRight().Code<<8)|(address.Code<<4))
		superhShEmit16(out, 0x2006|(superhShStack().Code<<8)|(superhShCompareRight().Code<<4))
		superhShEmit16(out, 0x5000|(superhShCompareRight().Code<<8)|(superhShStack().Code<<4)|1)
		superhShEmit16(out, 0x5000|(superhShCompareLeft().Code<<8)|(superhShStack().Code<<4)|2)
		superhShEmit16(out, 0x5000|(superhShScratch().Code<<8)|(superhShStack().Code<<4)|3)
		superhShEmit16(out, 0x5000|(superhShAddress().Code<<8)|(superhShStack().Code<<4)|4)
		superhShEmit16(out, 0x5000|(destination.Code<<8)|(superhShStack().Code<<4)|0)
		superhShEmit16(out, 0x7000|(superhShStack().Code<<8)|20)
	}
	func superhShLoadNative(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		superhShLoadWidth(out, destination, value, 0x6002)
	}
	func superhShLoadI32(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		superhShLoadWidth(out, destination, value, 0x6002)
	}
	func superhShLoadU32(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		superhShLoadWidth(out, destination, value, 0x6002)
	}
	func superhShLoadI16(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		superhShLoadWidth(out, destination, value, 0x6001)
	}
	func superhShLoadU16(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		superhShLoadWidth(out, destination, value, 0x6001)
		superhShEmit16(out, 0x600d|(destination.Code<<8)|(destination.Code<<4))
	}
	func superhShLoadI8(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		superhShLoadWidth(out, destination, value, 0x6000)
	}
	func superhShLoadU8(out *RTGEmitter, destination RTGRegister, value RTGAddress) {
		superhShLoadWidth(out, destination, value, 0x6000)
		superhShEmit16(out, 0x600c|(destination.Code<<8)|(destination.Code<<4))
	}

	func superhShStoreWidth(out *RTGEmitter, value RTGAddress, source RTGRegister, opcode int) {
		// Preserve every helper register as required by the store contract, plus
		// the value itself while the target address is formed.
		superhShEmit16(out, 0x2006|(superhShStack().Code<<8)|(superhShAddress().Code<<4))
		superhShEmit16(out, 0x2006|(superhShStack().Code<<8)|(superhShScratch().Code<<4))
		superhShEmit16(out, 0x2006|(superhShStack().Code<<8)|(superhShCompareLeft().Code<<4))
		superhShEmit16(out, 0x2006|(superhShStack().Code<<8)|(superhShCompareRight().Code<<4))
		superhShEmit16(out, 0x2006|(superhShStack().Code<<8)|(source.Code<<4))
		adjusted := value
		if adjusted.Base.Valid && adjusted.Base.Code == superhShStack().Code {
			adjusted.Displacement += 20
		}
		address := superhShMaterializeAddress(out, adjusted)
		superhShEmit16(out, 0x5000|(superhShCompareRight().Code<<8)|(superhShStack().Code<<4)|0)
		superhShEmit16(out, opcode|(address.Code<<8)|(superhShCompareRight().Code<<4))
		superhShEmit16(out, 0x5000|(superhShCompareRight().Code<<8)|(superhShStack().Code<<4)|1)
		superhShEmit16(out, 0x5000|(superhShCompareLeft().Code<<8)|(superhShStack().Code<<4)|2)
		superhShEmit16(out, 0x5000|(superhShScratch().Code<<8)|(superhShStack().Code<<4)|3)
		superhShEmit16(out, 0x5000|(superhShAddress().Code<<8)|(superhShStack().Code<<4)|4)
		superhShEmit16(out, 0x7000|(superhShStack().Code<<8)|20)
	}
	func superhShStoreNative(out *RTGEmitter, value RTGAddress, source RTGRegister) {
		superhShStoreWidth(out, value, source, 0x2002)
	}
	func superhShStoreU32(out *RTGEmitter, value RTGAddress, source RTGRegister) {
		superhShStoreWidth(out, value, source, 0x2002)
	}
	func superhShStoreU16(out *RTGEmitter, value RTGAddress, source RTGRegister) {
		superhShStoreWidth(out, value, source, 0x2001)
	}
	func superhShStoreU8(out *RTGEmitter, value RTGAddress, source RTGRegister) {
		superhShStoreWidth(out, value, source, 0x2000)
	}

	func superhShAdd(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		superhShEmit16(out, 0x300c|(destination.Code<<8)|(source.Code<<4))
	}
	func superhShSubtract(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		superhShEmit16(out, 0x3008|(destination.Code<<8)|(source.Code<<4))
	}
	func superhShMultiply(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		superhShEmit16(out, 0x0007|(destination.Code<<8)|(source.Code<<4))
		superhShEmit16(out, 0x001a|(destination.Code<<8))
	}
	func superhShBitAnd(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		superhShEmit16(out, 0x2009|(destination.Code<<8)|(source.Code<<4))
	}
	func superhShBitOr(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		superhShEmit16(out, 0x200b|(destination.Code<<8)|(source.Code<<4))
	}
	func superhShBitXor(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		superhShEmit16(out, 0x200a|(destination.Code<<8)|(source.Code<<4))
	}

	func superhShCompare(out *RTGEmitter, left RTGRegister, right RTGRegister) {
		compareLeft := superhShCompareLeft()
		compareRight := superhShCompareRight()
		// The contract for compare preserves all locations. Keep the previous
		// contents until shConditionT has consumed the operands into the T bit.
		superhShEmit16(out, 0x2006|(superhShStack().Code<<8)|(compareLeft.Code<<4))
		superhShEmit16(out, 0x2006|(superhShStack().Code<<8)|(compareRight.Code<<4))
		superhShComparisonSaved = true
		if left.Code == compareLeft.Code {
			superhShMove(out, compareRight, right)
			return
		}
		if right.Code == compareRight.Code {
			superhShMove(out, compareLeft, left)
			return
		}
		if left.Code == compareRight.Code && right.Code == compareLeft.Code {
			// Swap the two dedicated comparison registers without borrowing a
			// general register whose live value the operation must preserve.
			superhShBitXor(out, compareLeft, compareRight)
			superhShBitXor(out, compareRight, compareLeft)
			superhShBitXor(out, compareLeft, compareRight)
			return
		}
		if right.Code == compareLeft.Code {
			// Preserve the right operand before replacing compareLeft.
			superhShMove(out, compareRight, right)
			superhShMove(out, compareLeft, left)
			return
		}
		superhShMove(out, superhShCompareLeft(), left)
		superhShMove(out, superhShCompareRight(), right)
	}
	func superhShRestoreComparison(out *RTGEmitter) {
		if !superhShComparisonSaved {
			return
		}
		superhShEmit16(out, 0x6006|(superhShCompareRight().Code<<8)|(superhShStack().Code<<4))
		superhShEmit16(out, 0x6006|(superhShCompareLeft().Code<<8)|(superhShStack().Code<<4))
		superhShComparisonSaved = false
	}
	func superhShTest(out *RTGEmitter, left RTGRegister, right RTGRegister) {
		superhShCompare(out, left, right)
		superhShBitAnd(out, superhShCompareLeft(), superhShCompareRight())
		superhShMoveImmediate(out, superhShCompareRight(), 0)
	}

	func superhShConditionT(out *RTGEmitter, condition RTGCondition) bool {
		left := superhShCompareLeft()
		right := superhShCompareRight()
		code := condition.Code
		if code == 0 || code == 1 {
			superhShEmit16(out, 0x3000|(left.Code<<8)|(right.Code<<4))
			superhShRestoreComparison(out)
			return code == 1
		}
		if code == 2 {
			superhShEmit16(out, 0x3003|(right.Code<<8)|(left.Code<<4))
			superhShRestoreComparison(out)
			return false
		}
		if code == 3 {
			superhShEmit16(out, 0x3007|(left.Code<<8)|(right.Code<<4))
			superhShRestoreComparison(out)
			return false
		}
		if code == 4 {
			superhShEmit16(out, 0x3007|(right.Code<<8)|(left.Code<<4))
			superhShRestoreComparison(out)
			return false
		}
		if code == 5 {
			superhShEmit16(out, 0x3003|(left.Code<<8)|(right.Code<<4))
			superhShRestoreComparison(out)
			return false
		}
		if code == 6 {
			superhShEmit16(out, 0x3006|(right.Code<<8)|(left.Code<<4))
			superhShRestoreComparison(out)
			return false
		}
		if code == 7 {
			superhShEmit16(out, 0x3002|(left.Code<<8)|(right.Code<<4))
			superhShRestoreComparison(out)
			return false
		}
		if code == 8 {
			superhShEmit16(out, 0x3002|(right.Code<<8)|(left.Code<<4))
			superhShRestoreComparison(out)
			return false
		}
		superhShEmit16(out, 0x3006|(left.Code<<8)|(right.Code<<4))
		superhShRestoreComparison(out)
		return false
	}

	func superhShSetCondition(out *RTGEmitter, condition RTGCondition, destination RTGRegister) {
		invert := superhShConditionT(out, condition)
		superhShEmit16(out, 0x0029|(destination.Code<<8))
		if invert {
			superhShEmit16(out, 0x600b|(destination.Code<<8)|(destination.Code<<4))
			superhShEmit16(out, 0x7000|(destination.Code<<8)|1)
		}
	}

	func superhShLocalBranch(out *RTGEmitter, whenTrue bool) int {
		at := out.Len()
		opcode := 0x8b00
		if whenTrue {
			opcode = 0x8900
		}
		superhShEmit16(out, opcode)
		return at
	}
	func superhShPatchLocalBranch(out *RTGEmitter, at int, target int) {
		displacement := (target - (at + 4)) / 2
		code := out.Code()
		opcode := int(code[at]) | int(code[at+1])<<8
		if superhShBigEndian {
			opcode = int(code[at])<<8 | int(code[at+1])
		}
		superhShPatch16(out, at, (opcode&0xff00)|(displacement&0xff))
	}

	func superhShLoadLabel(out *RTGEmitter, destination RTGRegister, label RTGLabel) {
		at := superhShLiteral(out, destination, 0)
		out.Reloc(label)
		_ = at
	}
	func superhShCall(out *RTGEmitter, label RTGLabel) {
		superhShLoadLabel(out, superhShScratch(), label)
		superhShEmit16(out, 0x400b|(superhShScratch().Code<<8))
		superhShEmit16(out, 0x0009)
	}
	func superhShCallIndirect(out *RTGEmitter, operand RTGRegister) {
		superhShEmit16(out, 0x400b|(operand.Code<<8))
		superhShEmit16(out, 0x0009)
	}
	func superhShJump(out *RTGEmitter, label RTGLabel) {
		superhShEmit16(out, 0x2006|(superhShStack().Code<<8)|(superhShScratch().Code<<4))
		superhShLoadLabel(out, superhShScratch(), label)
		superhShEmit16(out, 0x402b|(superhShScratch().Code<<8))
		superhShEmit16(out, 0x6006|(superhShScratch().Code<<8)|(superhShStack().Code<<4))
	}
	func superhShJumpCondition(out *RTGEmitter, condition RTGCondition, label RTGLabel) {
		invert := superhShConditionT(out, condition)
		// Skip the long jump when the requested predicate is false. BT/BF do
		// not have delay slots, while shJump restores its temporary in JMP's.
		skip := superhShLocalBranch(out, invert)
		superhShJump(out, label)
		superhShPatchLocalBranch(out, skip, out.Len())
	}

	func superhShIncrement(out *RTGEmitter, operand RTGRegister) {
		superhShEmit16(out, 0x7000|(operand.Code<<8)|1)
	}
	func superhShDecrement(out *RTGEmitter, operand RTGRegister) {
		superhShEmit16(out, 0x7000|(operand.Code<<8)|0xff)
	}
	func superhShShiftLeftImmediate(out *RTGEmitter, operand RTGRegister, value byte) {
		count := int(value) & 31
		for count >= 16 {
			superhShEmit16(out, 0x4028|(operand.Code<<8))
			count -= 16
		}
		for count >= 8 {
			superhShEmit16(out, 0x4018|(operand.Code<<8))
			count -= 8
		}
		for count >= 2 {
			superhShEmit16(out, 0x4008|(operand.Code<<8))
			count -= 2
		}
		for count > 0 {
			superhShEmit16(out, 0x4000|(operand.Code<<8))
			count--
		}
	}
	func superhShShiftRightUnsignedImmediate(out *RTGEmitter, operand RTGRegister, value byte) {
		count := int(value) & 31
		for count >= 16 {
			superhShEmit16(out, 0x4029|(operand.Code<<8))
			count -= 16
		}
		for count >= 8 {
			superhShEmit16(out, 0x4019|(operand.Code<<8))
			count -= 8
		}
		for count >= 2 {
			superhShEmit16(out, 0x4009|(operand.Code<<8))
			count -= 2
		}
		for count > 0 {
			superhShEmit16(out, 0x4001|(operand.Code<<8))
			count--
		}
	}
	func superhShShiftRightSignedImmediate(out *RTGEmitter, operand RTGRegister, value byte) {
		count := int(value) & 31
		for count > 0 {
			superhShEmit16(out, 0x4021|(operand.Code<<8))
			count--
		}
	}

	func superhShVariableShift(out *RTGEmitter, direction RTGShiftDirection, signed bool) {
		superhShMove(out, superhShScratch(), superhShTertiary())
		loop := out.NewLabel()
		out.Mark(loop)
		superhShEmit16(out, 0x8800|(superhShPrimary().Code<<8))
		// CMP/EQ #0,R0 produces the T bit directly, so use a local BT rather
		// than re-evaluating the backend's saved comparison operands.
		done := superhShLocalBranch(out, true)
		if direction == RTGShiftLeft {
			superhShEmit16(out, 0x4000|(superhShScratch().Code<<8))
		} else {
			if signed {
				superhShEmit16(out, 0x4021|(superhShScratch().Code<<8))
			} else {
				superhShEmit16(out, 0x4001|(superhShScratch().Code<<8))
			}
		}
		superhShDecrement(out, superhShPrimary())
		superhShJump(out, loop)
		superhShPatchLocalBranch(out, done, out.Len())
		superhShMove(out, superhShPrimary(), superhShScratch())
	}

	func superhShSignedDivide(out *RTGEmitter, remainder bool) {
		// Preserve every non-result location used by the software division. The
		// direct-emitter contract exposes only secondary and flags as clobbered;
		// larger expressions can keep live values in all four helper registers.
		superhShEmit16(out, 0x2006|(superhShStack().Code<<8)|(superhShTertiary().Code<<4))
		superhShEmit16(out, 0x2006|(superhShStack().Code<<8)|(superhShScratch().Code<<4))
		superhShEmit16(out, 0x2006|(superhShStack().Code<<8)|(superhShAddress().Code<<4))
		superhShEmit16(out, 0x2006|(superhShStack().Code<<8)|(superhShCompareLeft().Code<<4))
		superhShEmit16(out, 0x2006|(superhShStack().Code<<8)|(superhShCompareRight().Code<<4))
		superhShEmit16(out, 0x2006|(superhShStack().Code<<8)|(superhShPrimary().Code<<4))
		superhShMove(out, superhShCompareRight(), superhShPrimary())
		superhShEmit16(out, 0x4011|(superhShCompareRight().Code<<8))
		positiveDivisor := superhShLocalBranch(out, true)
		superhShEmit16(out, 0x600b|(superhShCompareRight().Code<<8)|(superhShCompareRight().Code<<4))
		superhShPatchLocalBranch(out, positiveDivisor, out.Len())
		superhShEmit16(out, 0x4011|(superhShTertiary().Code<<8))
		positiveDividend := superhShLocalBranch(out, true)
		superhShEmit16(out, 0x600b|(superhShTertiary().Code<<8)|(superhShTertiary().Code<<4))
		superhShPatchLocalBranch(out, positiveDividend, out.Len())
		superhShMoveImmediate(out, superhShScratch(), 0)
		superhShMoveImmediate(out, superhShAddress(), 0)
		superhShMoveImmediate(out, superhShCompareLeft(), 32)
		loop := out.Len()
		superhShEmit16(out, 0x4000|(superhShTertiary().Code<<8))
		superhShEmit16(out, 0x4024|(superhShAddress().Code<<8))
		superhShEmit16(out, 0x3002|(superhShAddress().Code<<8)|(superhShCompareRight().Code<<4))
		skipSubtract := superhShLocalBranch(out, false)
		superhShSubtract(out, superhShAddress(), superhShCompareRight())
		superhShEmit16(out, 0x0018)
		superhShPatchLocalBranch(out, skipSubtract, out.Len())
		superhShEmit16(out, 0x4024|(superhShScratch().Code<<8))
		superhShDecrement(out, superhShCompareLeft())
		// CMP/EQ #imm is restricted to R0. TST Rn,Rn gives the same zero
		// predicate for the dedicated loop counter without emitting an illegal
		// 0x8Axx opcode on SH-2/SH-4.
		superhShEmit16(out, 0x2008|(superhShCompareLeft().Code<<8)|(superhShCompareLeft().Code<<4))
		back := superhShLocalBranch(out, false)
		superhShPatchLocalBranch(out, back, loop)
		if remainder {
			superhShMove(out, superhShPrimary(), superhShAddress())
		} else {
			superhShMove(out, superhShPrimary(), superhShScratch())
		}
		// The divisor is at stack offset zero; the original dividend precedes the
		// five saved helper locations at offset twenty.
		superhShEmit16(out, 0x5000|(superhShCompareLeft().Code<<8)|(superhShStack().Code<<4)|0)
		superhShMove(out, superhShAddress(), superhShStack())
		superhShEmit16(out, 0x7000|(superhShAddress().Code<<8)|20)
		superhShEmit16(out, 0x6002|(superhShCompareRight().Code<<8)|(superhShAddress().Code<<4))
		if !remainder {
			superhShBitXor(out, superhShCompareRight(), superhShCompareLeft())
		}
		superhShEmit16(out, 0x4011|(superhShCompareRight().Code<<8))
		positiveResult := superhShLocalBranch(out, true)
		superhShEmit16(out, 0x600b|(superhShPrimary().Code<<8)|(superhShPrimary().Code<<4))
		superhShPatchLocalBranch(out, positiveResult, out.Len())
		superhShEmit16(out, 0x7000|(superhShStack().Code<<8)|4)
		superhShEmit16(out, 0x6006|(superhShCompareRight().Code<<8)|(superhShStack().Code<<4))
		superhShEmit16(out, 0x6006|(superhShCompareLeft().Code<<8)|(superhShStack().Code<<4))
		superhShEmit16(out, 0x6006|(superhShAddress().Code<<8)|(superhShStack().Code<<4))
		superhShEmit16(out, 0x6006|(superhShScratch().Code<<8)|(superhShStack().Code<<4))
		superhShEmit16(out, 0x6006|(superhShTertiary().Code<<8)|(superhShStack().Code<<4))
	}

	func superhShReturn(out *RTGEmitter) { superhShEmit16(out, 0x000b); superhShEmit16(out, 0x0009) }
	func superhShLeave(out *RTGEmitter) {
		superhShLoadNative(out, superhShScratch(), RTGAddress{Base: superhShFrame(), Displacement: -4})
		superhShEmit16(out, 0x402a|(superhShScratch().Code<<8))
		superhShLoadNative(out, superhShAddress(), RTGAddress{Base: superhShFrame(), Displacement: -8})
		superhShMove(out, superhShStack(), superhShFrame())
		superhShMove(out, superhShFrame(), superhShAddress())
	}
	func superhShHostSyscall(out *RTGEmitter) { superhShEmit16(out, 0xc314) }

	func superhShPatchRelocations(out *RTGEmitter) {
		for index := 0; index < out.RelocationCount(); index++ {
			at := out.RelocationOffset(index)
			target := superhShCodeAddress + out.LabelPosition(out.RelocationLabel(index))
			superhShPatch32(out, at, target)
		}
	}

	func superhShFrameStart(out *RTGEmitter) int {
		superhShMove(out, superhShAddress(), superhShFrame())
		at := superhShLiteral(out, superhShScratch(), 0)
		superhShSubtract(out, superhShStack(), superhShScratch())
		superhShMove(out, superhShFrame(), superhShStack())
		superhShAdd(out, superhShFrame(), superhShScratch())
		superhShStoreNative(out, RTGAddress{Base: superhShFrame(), Displacement: -8}, superhShAddress())
		superhShEmit16(out, 0x002a|(superhShScratch().Code<<8))
		superhShStoreNative(out, RTGAddress{Base: superhShFrame(), Displacement: -4}, superhShScratch())
		return at
	}
	func superhShFrameFinish(out *RTGEmitter, at int, stackUsed int) {
		// Reserve both linkage words even without locals so a callee's frame
		// cannot overlap this function's saved PR/frame pair.
		superhShPatch32(out, at, (stackUsed+23)&-16)
	}
	func superhShFrameLoad(out *RTGEmitter, destination RTGRegister, offset int) {
		superhShLoadNative(out, destination, RTGAddress{Base: superhShFrame(), Displacement: -(offset + 8)})
	}
	func superhShFrameStore(out *RTGEmitter, offset int, source RTGRegister) {
		superhShStoreNative(out, RTGAddress{Base: superhShFrame(), Displacement: -(offset + 8)}, source)
	}
	func superhShFrameAddress(out *RTGEmitter, destination RTGRegister, offset int) {
		superhShEmitAddress(out, destination, RTGAddress{Base: superhShFrame(), Displacement: -(offset + 8)})
	}

	func superhShPrimary() RTGRegister { return RTGRegister{Code: 0, Valid: true} }

	func superhShTertiary() RTGRegister     { return RTGRegister{Code: 2, Valid: true} }
	func superhShScratch() RTGRegister      { return RTGRegister{Code: 8, Valid: true} }
	func superhShAddress() RTGRegister      { return RTGRegister{Code: 9, Valid: true} }
	func superhShCompareLeft() RTGRegister  { return RTGRegister{Code: 10, Valid: true} }
	func superhShCompareRight() RTGRegister { return RTGRegister{Code: 11, Valid: true} }
	func superhShFrame() RTGRegister        { return RTGRegister{Code: 14, Valid: true} }
	func superhShStack() RTGRegister        { return RTGRegister{Code: 15, Valid: true} }

	const elfCodeAddress = 0x11000

	func elfDataOffset(out *RTGEmitter) int  { return RTGAlignValue(0x1000+len(out.Code()), 0x10000) }
	func elfDataAddress(out *RTGEmitter) int { return 0x10000 + elfDataOffset(out) }
	func elfBssAddress(out *RTGEmitter) int {
		return RTGAlignValue(elfDataAddress(out)+len(out.Data()), 16)
	}
	func elfPut(image []byte, at int, value uint64, width int, big bool) {
		for i := 0; i < width; i++ {
			shift := i * 8
			if big {
				shift = (width - 1 - i) * 8
			}
			image[at+i] = byte(value >> uint(shift))
		}
	}
	func elfImage(out *RTGEmitter, machine int, flags int, bits int, big bool) []byte {
		offset := elfDataOffset(out)
		result := make([]byte, offset+len(out.Data()))
		result[0] = 0x7f
		result[1] = 'E'
		result[2] = 'L'
		result[3] = 'F'
		result[4] = 1
		if bits == 64 {
			result[4] = 2
		}
		result[5] = 1
		if big {
			result[5] = 2
		}
		result[6] = 1
		elfPut(result, 16, 2, 2, big)
		elfPut(result, 18, uint64(machine), 2, big)
		elfPut(result, 20, 1, 4, big)
		if bits == 32 {
			elfPut(result, 24, elfCodeAddress, 4, big)
			elfPut(result, 28, 52, 4, big)
			elfPut(result, 36, uint64(flags), 4, big)
			elfPut(result, 40, 52, 2, big)
			elfPut(result, 42, 32, 2, big)
			elfPut(result, 44, 2, 2, big)
		} else {
			elfPut(result, 24, elfCodeAddress, 8, big)
			elfPut(result, 32, 64, 8, big)
			elfPut(result, 48, uint64(flags), 4, big)
			elfPut(result, 52, 64, 2, big)
			elfPut(result, 54, 56, 2, big)
			elfPut(result, 56, 2, 2, big)
		}
		for i := 0; i < 2; i++ {
			file := 0
			address := 0x10000
			size := 0x1000 + len(out.Code())
			memory := size
			permissions := 5
			if i == 1 {
				file = offset
				address = elfDataAddress(out)
				size = len(out.Data())
				memory = elfBssAddress(out) - address + out.BSSSize()
				permissions = 6
			}
			if bits == 32 {
				at := 52 + i*32
				elfPut(result, at, 1, 4, big)
				elfPut(result, at+4, uint64(file), 4, big)
				elfPut(result, at+8, uint64(address), 4, big)
				elfPut(result, at+12, uint64(address), 4, big)
				elfPut(result, at+16, uint64(size), 4, big)
				elfPut(result, at+20, uint64(memory), 4, big)
				elfPut(result, at+24, uint64(permissions), 4, big)
				elfPut(result, at+28, 0x10000, 4, big)
			} else {
				at := 64 + i*56
				elfPut(result, at, 1, 4, big)
				elfPut(result, at+4, uint64(permissions), 4, big)
				elfPut(result, at+8, uint64(file), 8, big)
				elfPut(result, at+16, uint64(address), 8, big)
				elfPut(result, at+24, uint64(address), 8, big)
				elfPut(result, at+32, uint64(size), 8, big)
				elfPut(result, at+40, uint64(memory), 8, big)
				elfPut(result, at+48, 0x10000, 8, big)
			}
		}
		copy(result[0x1000:], out.Code())
		copy(result[offset:], out.Data())
		return result
	}

	func targetEntryStart(out *RTGEmitter, stateOffset int) bool {
		_ = stateOffset
		superhShSetCodeAddress(elfCodeAddress)
		superhShSetBigEndian(true)
		return true
	}
	func targetEntry(out *RTGEmitter, count int, stateOffset int) bool {
		_ = out
		_ = stateOffset
		return count == 0
	}

	func targetImage(out *RTGEmitter) []byte {
		for i := 0; i < out.AbsoluteRelocationCount(); i++ {
			at := out.AbsoluteRelocationOffset(i)
			target, ok := RTGResolveAbsoluteRelocation(out, out.AbsoluteRelocationKind(i), out.AbsoluteRelocationAddend(i), elfDataAddress(out), elfBssAddress(out))
			if !ok {
				return nil
			}
			superhShPatch32(out, at, target)
		}
		return elfImage(out, 42, 9, 32, true)
	}
}

arch sh2be {
	alias = "sh2be"
	endian = big
	word_bits = 32
	pointer_bits = 32
	instruction_alignment = 2
	stack_word_bytes = 4
	stack_alignment = 16
	patch_relocations = go superhShPatchRelocations
	registers integer = [value0, value1, value2, arg3, arg4, arg5, work6, work7, scratch, address, compareLeft, compareRight, work12, link, frame, stack]
	locations {
		primary = value0
		secondary = value1
		tertiary = value2
		scratch = scratch
		address = address
		compareLeft = compareLeft
		compareRight = compareRight
		copy_destination = arg3
		copy_source = arg4
		copy_count = arg5
		stack = stack
		frame = frame
		link = link
	}
	conditions {
		eq = 0
		ne = 1
		sle = 2
		sgt = 3
		slt = 4
		sge = 5
		ult = 6
		uge = 7
		ule = 8
		ugt = 9
	}
	bind {
		move = go superhShMove
		address = go superhShEmitAddress
		load.native = go superhShLoadNative
		load.i32 = go superhShLoadI32
		load.u32 = go superhShLoadU32
		load.i16 = go superhShLoadI16
		load.u16 = go superhShLoadU16
		load.i8 = go superhShLoadI8
		load.u8 = go superhShLoadU8
		store.native = go superhShStoreNative
		store.u32 = go superhShStoreU32
		store.u16 = go superhShStoreU16
		store.u8 = go superhShStoreU8
		add = go superhShAdd
		subtract = go superhShSubtract
		multiply = go superhShMultiply
		bit_and = go superhShBitAnd
		bit_or = go superhShBitOr
		bit_xor = go superhShBitXor
		compare = go superhShCompare
		test = go superhShTest
		increment = go superhShIncrement
		decrement = go superhShDecrement
		shift_left_immediate = go superhShShiftLeftImmediate
		shift_right_unsigned_immediate = go superhShShiftRightUnsignedImmediate
		shift_right_signed_immediate = go superhShShiftRightSignedImmediate
		call = go superhShCall
		call_indirect = go superhShCallIndirect
		jump = go superhShJump
		jump_condition = go superhShJumpCondition
		set_condition = go superhShSetCondition
		return = go superhShReturn
		leave = go superhShLeave
		host_syscall = go superhShHostSyscall
		move_immediate = go superhShMoveImmediate
		variable_shift = go superhShVariableShift
		signed_divide = go superhShSignedDivide
		copy_bytes = sequence superhCopyBytesBE
	}
	sequences {
		superhCopyBytesBE(out:emitter) {
			let forward = out.NewLabel()
			let backwardLoop = out.NewLabel()
			let forwardLoop = out.NewLabel()
			let done = out.NewLabel()
			superhShCompare(out, sh2beARG3, sh2beARG4)
			superhShJumpCondition(out, sh2beULT, forward)
			superhShEmitAddress(out, sh2beSCRATCH, record_address(Base:sh2beARG4, Index:sh2beARG5, Scale:1,))
			superhShCompare(out, sh2beARG3, sh2beSCRATCH)
			superhShJumpCondition(out, sh2beUGE, forward)
			superhShEmitAddress(out, sh2beARG4, record_address(Base:sh2beARG4, Index:sh2beARG5, Scale:1, Displacement:-1,))
			superhShEmitAddress(out, sh2beARG3, record_address(Base:sh2beARG3, Index:sh2beARG5, Scale:1, Displacement:-1,))
			out.Mark(backwardLoop)
			superhShMoveImmediate(out, sh2beSCRATCH, 0)
			superhShCompare(out, sh2beARG5, sh2beSCRATCH)
			superhShJumpCondition(out, sh2beEQ, done)
			superhShLoadU8(out, sh2beSCRATCH, record_address(Base:sh2beARG4,))
			superhShStoreU8(out, record_address(Base:sh2beARG3,), sh2beSCRATCH)
			superhShDecrement(out, sh2beARG4) ; superhShDecrement(out, sh2beARG3) ; superhShDecrement(out, sh2beARG5)
			superhShJump(out, backwardLoop)
			out.Mark(forward) ; out.Mark(forwardLoop)
			superhShMoveImmediate(out, sh2beSCRATCH, 0)
			superhShCompare(out, sh2beARG5, sh2beSCRATCH)
			superhShJumpCondition(out, sh2beEQ, done)
			superhShLoadU8(out, sh2beSCRATCH, record_address(Base:sh2beARG4,))
			superhShStoreU8(out, record_address(Base:sh2beARG3,), sh2beSCRATCH)
			superhShIncrement(out, sh2beARG4) ; superhShIncrement(out, sh2beARG3) ; superhShDecrement(out, sh2beARG5)
			superhShJump(out, forwardLoop)
			out.Mark(done)
		}
	}
}
abi sh2be_internal {
	arch = sh2be
	arguments = [value0, value1, value2, arg3, arg4, arg5]
	call_words = [value0, value1, value2, arg3, arg4, arg5]
	result = [value0, value1]
	caller_saved = [value0, value1, value2, arg3, arg4, arg5, work6, work7, scratch, address, compareLeft, compareRight, work12]
	callee_saved = [frame]
	clobbered = [value0, value1, value2, arg3, arg4, arg5, work6, work7, scratch, address, compareLeft, compareRight, work12]
	saved = [frame]
	stack_alignment = 16
	return_address = link
	frame_pointer = frame
	frame_start = go superhShFrameStart
	frame_finish = go superhShFrameFinish
	frame_load = go superhShFrameLoad
	frame_store = go superhShFrameStore
	frame_address = go superhShFrameAddress
}
runtime linux_sh4eb {
	managed_heap_abi = 1
	managed_word_bits = 32
	managed_source = go managedSource
	managed_startup = go managedStartup
	managed_boundary = go managedBoundary
	emit_syscall_from_stack = go managedRawSyscall

	emit_entry_start = go targetEntryStart
	emit_entry = go targetEntry
	syscall {
		number = arg3
		arguments = [arg4, arg5, work6, work7]
		result = value0
		instruction = host_syscall
	}
	operation read {
		number = 3 args = [fd, buffer, count]
	}
	operation write {
		number = 4 args = [fd, buffer, count]
	}
	operation open {
		number = 5 args = [path, flags, mode]
	}
	operation close {
		number = 6 args = [fd]
	}
	operation chmod {
		number = 94 args = [fd, mode]
	}
	operation print {
		use = write args = [stdout, buffer, count]
	}
	operation exit {
		number = 1 args = [status] noreturn = true
	}
}
format elf_sh4eb {
	kind = elf
	byte_order = big
	address_bits = 32
	code_offset = 0
	image = go targetImage
}
target experimental/linux-sh4eb {
	family = native_v1
	os = linux
	arch = sh2be
	frontend_arch = sh2be
	abi = sh2be_internal
	runtime = linux_sh4eb
	executable = elf_sh4eb
	arena_default = 16777216
	build_tags = [linux, unix, sh4eb]
	capabilities = [hosted, executable, filesystem, heap]
}

# Shared managed collector and Linux services embedded for standalone use.
go backend {
	func managedHeap64Source() string { return managedHeapSource(8) }
	func managedHeap32Source() string { return managedHeapSource(4) }

	// Headers keep their aligned layout; payload/root scanning follows native words.
	func managedHeapSource(wordBytes int) string {
		constants := "const __renvoManagedWordBytes = uintptr(8)\nconst __renvoManagedMax = uintptr(9223372036854775807)\n"
		if wordBytes == 4 {
			constants = "const __renvoManagedWordBytes = uintptr(4)\nconst __renvoManagedMax = uintptr(2147483647)\n"
		}
		return constants + `
					// Desktop heap runtime, parsed and compiled with the application. No helper
					// below allocates through make/new/append or calls application code.
					var __renvoManagedState [16]uintptr

					func __renvoManagedRead(p uintptr) uintptr { return *(*uintptr)(p) }
					func __renvoManagedWrite(p uintptr, v uintptr) { *(*uintptr)(p) = v }
					func __renvoManagedByte(p uintptr) byte { return *(*byte)(p) }

					func __renvoManagedLimit(p uintptr) uintptr {
						var value uintptr
						var digits int
						for __renvoManagedByte(p) >= '0' && __renvoManagedByte(p) <= '9' {
							digit := uintptr(__renvoManagedByte(p)-'0')
							if value > (__renvoManagedMax-digit)/10 { return 0 }
							value = value*10+digit
							p++
							digits++
						}
						if digits == 0 || value == 0 { return 0 }
						var shift uintptr
						if __renvoManagedByte(p) != 0 {
							c := __renvoManagedByte(p)
							if c == 'K' { shift = 10 } else if c == 'M' { shift = 20 } else if c == 'G' { shift = 30 } else if c == 'T' { shift = 40 } else { return 0 }
							if __renvoManagedByte(p+1) != 'i' || __renvoManagedByte(p+2) != 'B' || __renvoManagedByte(p+3) != 0 { return 0 }
						}
						if value > __renvoManagedMax>>shift { return 0 }
						return value << shift
					}

					func __renvoManagedInit(limit uintptr, stack uintptr, globals uintptr, end uintptr) {
						if limit == 0 { limit = __renvoManagedMax }
						override := __renvoManagedEnvironment(stack)
						if override != 0 {
							limit = __renvoManagedLimit(override)
							if limit == 0 { __renvoManagedFatal("renvo: invalid RENVO_HEAP_LIMIT\n") }
						}
						// State and the common allocator's 32-byte compatibility bookkeeping.
						if limit < 160 { __renvoManagedFatal("panic: out of memory\n") }
						__renvoManagedState[1] = limit
						__renvoManagedState[2] = 160
						__renvoManagedState[3] = stack
						__renvoManagedState[6] = globals
						__renvoManagedState[7] = end
						__renvoManagedState[8] = 65536
					}

					// Segment header: next, mapping size, payload offset, reserved word; then one
					// block-header index per mapped page. All of this resides in charged mappings.
					func __renvoManagedHeader(size uintptr) uintptr { return (32+(size/__renvoManagedPageSize)*8+15)&^uintptr(15) }
					func __renvoManagedIndex(s uintptr, b uintptr, span uintptr) {
						first := (b-s+(__renvoManagedPageSize-1))/__renvoManagedPageSize
						end := (b-s+span+(__renvoManagedPageSize-1))/__renvoManagedPageSize
						for page := first; page < end; page++ { __renvoManagedWrite(s+32+page*8, b) }
					}
					func __renvoManagedFind(pointer uintptr) uintptr {
						for s := __renvoManagedState[0]; s != 0; s = __renvoManagedRead(s) {
							size := __renvoManagedRead(s+8)
							if pointer < s+__renvoManagedRead(s+16)+16 || pointer-s >= size { continue }
							b := __renvoManagedRead(s+32+((pointer-s)/__renvoManagedPageSize)*8)
							for b < s+size {
								span := __renvoManagedRead(b)
								if pointer < b+span {
									if pointer >= b+16 && __renvoManagedRead(b+8)&1 != 0 { return b }
									return 0
								}
								b += span
							}
						}
						return 0
					}
					func __renvoManagedMark(pointer uintptr) {
						b := __renvoManagedFind(pointer)
						if b != 0 && __renvoManagedRead(b+8)&2 == 0 {
							// Block headers are 16-byte aligned. During marking the upper bits
							// hold the next work item; low bits retain allocated/marked flags.
							__renvoManagedWrite(b+8, __renvoManagedState[9]|3)
							__renvoManagedState[9] = b
						}
					}
					func __renvoManagedScan(start uintptr, end uintptr) {
						for p := start; p < end; p += __renvoManagedWordBytes { __renvoManagedMark(__renvoManagedRead(p)) }
					}
					func __renvoManagedCollect(roots uintptr) {
						__renvoManagedState[4] = 0
						__renvoManagedState[5] = 0
						__renvoManagedState[9] = 0
						__renvoManagedRoots(roots)
						state := uintptr(&__renvoManagedState[0])
						__renvoManagedScan(__renvoManagedState[6], state)
						__renvoManagedScan(state+16*__renvoManagedWordBytes, __renvoManagedState[7])
						for __renvoManagedState[9] != 0 {
							b := __renvoManagedState[9]
							__renvoManagedState[9] = __renvoManagedRead(b+8)&^uintptr(15)
							__renvoManagedWrite(b+8, 3)
							__renvoManagedScan(b+16, b+__renvoManagedRead(b))
						}
						var previous uintptr
						var live uintptr
						for s := __renvoManagedState[0]; s != 0; {
							size := __renvoManagedRead(s+8)
							var free uintptr
							used := false
							for b := s+__renvoManagedRead(s+16); b < s+size; {
								span := __renvoManagedRead(b)
								if __renvoManagedRead(b+8)&2 != 0 {
									__renvoManagedWrite(b+8, 1)
									free = 0
									used = true
									live += span
								} else {
									__renvoManagedWrite(b+8, 0)
									if free != 0 { __renvoManagedWrite(free, __renvoManagedRead(free)+span) } else { free = b }
								}
								b += span
							}
							next := __renvoManagedRead(s)
							if !used {
								if previous == 0 { __renvoManagedState[0] = next } else { __renvoManagedWrite(previous, next) }
								if !__renvoManagedRelease(s, size) { __renvoManagedFatal("renvo: managed heap release failed\n") }
								__renvoManagedState[2] -= size
							} else {
								previous = s
								__renvoManagedWrite(s+32, s+__renvoManagedRead(s+16))
								for b := s+__renvoManagedRead(s+16); b < s+size; b += __renvoManagedRead(b) {
									__renvoManagedIndex(s, b, __renvoManagedRead(b))
								}
							}
							s = next
						}
						__renvoManagedState[10]++
						__renvoManagedState[12] = live
					}
					func __renvoManagedClaim(s uintptr, b uintptr, span uintptr) uintptr {
						available := __renvoManagedRead(b)
						__renvoManagedState[4] = 0
						if available-span >= 32 {
							__renvoManagedWrite(b+span, available-span)
							__renvoManagedWrite(b+span+8, 0)
							__renvoManagedWrite(b, span)
							__renvoManagedState[4] = b+span
							__renvoManagedState[5] = s
							available = span
						}
						// Only occupied pages need a fresh index. An older free-page index is
						// still a valid earlier block; lookup walks forward until sweep rebuilds it.
						__renvoManagedIndex(s, b, available)
						__renvoManagedWrite(b+8, 1)
						for p := b+16; p < b+available; p += __renvoManagedWordBytes { __renvoManagedWrite(p, 0) }
						return b+16
					}
					func __renvoManagedTake(span uintptr) uintptr {
						b := __renvoManagedState[4]
						if b != 0 && __renvoManagedRead(b) >= span {
							return __renvoManagedClaim(__renvoManagedState[5], b, span)
						}
						for s := __renvoManagedState[0]; s != 0; s = __renvoManagedRead(s) {
							end := s+__renvoManagedRead(s+8)
							for b := s+__renvoManagedRead(s+16); b < end; b += __renvoManagedRead(b) {
								if __renvoManagedRead(b+8) == 0 && __renvoManagedRead(b) >= span {
									return __renvoManagedClaim(s, b, span)
								}
							}
						}
						return 0
					}
					func __renvoManagedRequest(size uintptr, roots uintptr) uintptr {
						if size > __renvoManagedMax-(__renvoManagedPageSize+31) { return 0 }
						if size == 0 { size = 16 }
						span := ((size+15)&^uintptr(15))+16
						result := __renvoManagedTake(span)
						if result != 0 { return result }
						if __renvoManagedState[0] != 0 {
							__renvoManagedCollect(roots)
							result = __renvoManagedTake(span)
							if result != 0 { return result }
						}
						minimum := (span+48+(__renvoManagedPageSize-1))&^uintptr((__renvoManagedPageSize-1))
						for minimum-__renvoManagedHeader(minimum) < span {
							minimum = (span+__renvoManagedHeader(minimum)+(__renvoManagedPageSize-1))&^uintptr((__renvoManagedPageSize-1))
						}
						available := (__renvoManagedState[1]-__renvoManagedState[2])&^uintptr((__renvoManagedPageSize-1))
						if minimum > available { return 0 }
						growth := __renvoManagedState[8]
						if growth < minimum { growth = minimum }
						if growth > available { growth = available }
						mapping := __renvoManagedMap(growth)
						if mapping == 0 && growth != minimum {
							growth = minimum
							mapping = __renvoManagedMap(growth)
						}
						if mapping == 0 { return 0 }
						base := uintptr(mapping)
						__renvoManagedWrite(base, __renvoManagedState[0])
						__renvoManagedWrite(base+8, growth)
						header := __renvoManagedHeader(growth)
						__renvoManagedWrite(base+16, header)
						for page := uintptr(0); page < growth/__renvoManagedPageSize; page++ { __renvoManagedWrite(base+32+page*8, base+header) }
						__renvoManagedWrite(base+header, growth-header)
						__renvoManagedState[4] = base+header
						__renvoManagedState[5] = base
						__renvoManagedState[0] = base
						__renvoManagedState[2] += growth
						if growth < __renvoManagedMax/2 { __renvoManagedState[8] = growth*2 }
						return __renvoManagedTake(span)
					}
					func __renvoManagedCollectBoundary(ignored uintptr, roots uintptr) uintptr {
						__renvoManagedCollect(roots)
						return 0
					}
					`
	}
}

go backend {
	func linuxManagedSource() string {
		return `
					//renvo:intrinsic renvo_runtime_Syscall
					func __renvoManagedSyscall(n int, a uintptr, b uintptr, c uintptr, d uintptr, e int, f uintptr) int { return -1 }
					
					func __renvoManagedMap(size uintptr) uintptr {
					 p := __renvoManagedSyscall(__renvoManagedMapNumber, 0, size, 3, __renvoManagedMapFlags, -1, 0)
					 if uintptr(p) >= ^uintptr(4094) { return 0 }; return uintptr(p)
					}
					func __renvoManagedRelease(base uintptr, size uintptr) bool { return __renvoManagedSyscall(__renvoManagedReleaseNumber, base, size, 0, 0, 0, 0) == 0 }
					func __renvoManagedFatal(message string) { print(message); __renvoManagedSyscall(__renvoManagedExitNumber, 2, 0, 0, 0, 0, 0) }
					func __renvoManagedEnvironment(stack uintptr) uintptr {
					 // Linux initial process stack: argc, argv[], null, envp[], null.
					 p := stack + 2*__renvoManagedWordBytes + __renvoManagedRead(stack)*__renvoManagedWordBytes
					 for __renvoManagedRead(p) != 0 {
					  entry := __renvoManagedRead(p)
					  matched := true
					  prefix := "RENVO_HEAP_LIMIT="
					  for i := 0; i < len(prefix); i++ {
					   if __renvoManagedByte(entry+uintptr(i)) != prefix[i] { matched = false; break }
					  }
					  if matched { return entry+17 }
					  p += __renvoManagedWordBytes
					 }
					 return 0
					}
					func __renvoManagedRoots(roots uintptr) {
					 if roots > __renvoManagedState[3] { __renvoManagedFatal("renvo: unsupported managed stack\n") }
					 __renvoManagedScan(roots, __renvoManagedState[3])
					}
					`
	}
}

go backend {
	func managedSource() string {
		return managedHeap32Source() + linuxManagedSource() + `
	const __renvoManagedPageSize = uintptr(4096)
	const __renvoManagedMapNumber = 192
	const __renvoManagedReleaseNumber = 91
	const __renvoManagedExitNumber = 1
	const __renvoManagedMapFlags = uintptr(34)
	`
	}

	func managedStartup(out *RTGEmitter, limit int, label int) {
		superhShMoveImmediate(out, RTGRegister{Code: 3, Valid: true}, int64(limit))
		superhShMove(out, RTGRegister{Code: 2, Valid: true}, superhShFrame())
		managedBSS(out, 1, 0)
		managedBSS(out, 0, out.BSSSize())
		superhShCall(out, RTGLabelFromCode(label))
	}
	func managedBSS(out *RTGEmitter, reg int, offset int) {
		at := superhShLiteral(out, RTGRegister{Code: reg, Valid: true}, 0)
		out.AbsoluteReloc(at, offset, RTGRelocationAbsoluteBSS)
	}
	func managedBoundary(out *RTGEmitter, label int) {
		superhShEmit16(out, 0x7fc0)
		for reg := 0; reg < 15; reg++ {
			superhShEmit16(out, 0x1f00|(reg<<4)|reg)
		}
		superhShEmit16(out, 0x002a) // sts pr,r0, after saving r0
		superhShEmit16(out, 0x1f0f)
		superhShEmit16(out, 0x51f0) // size in r1
		superhShMove(out, superhShPrimary(), superhShStack())
		superhShCall(out, RTGLabelFromCode(label))
		superhShEmit16(out, 0x51ff)
		superhShEmit16(out, 0x412a) // restore PR using r1
		for reg := 1; reg < 15; reg++ {
			superhShEmit16(out, 0x50f0|(reg<<8)|reg)
		}
		superhShEmit16(out, 0x7f40)
	}
	func managedRawSyscall(out *RTGEmitter, count int, number int) bool {
		_ = number
		if count < 1 || count > 7 {
			return false
		}
		regs := []int{3, 4, 5, 6, 7, 0, 1}
		for i := 0; i < count; i++ {
			superhShEmit16(out, 0x50f0|(regs[i]<<8)|i)
		}
		superhShEmit16(out, 0x7f00|(count*4))
		superhShEmit16(out, 0xc310|(count-1))
		return true
	}
}
