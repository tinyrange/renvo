@import "../backend/definitions/esp32c6_common.rtg"

target esp32c6-jtag/riscv32 {
	family = native_v1
	os = esp32c6
	arch = riscv32
	frontend_arch = riscv32
	abi = riscv32_internal
	runtime = esp32c6_freestanding
	executable = esp32c6_jtag_elf
	build_tags = [esp32c6, riscv32, m5nanoc6, renvo_hotreload]
	capabilities = [freestanding, executable, volatile_memory]
	arena_default = 65536
}
