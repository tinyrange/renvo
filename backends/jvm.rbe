definition 1
unit jvm
implements direct_emitter_v1

# Direct JVM classfile backend. The ordinary backend lowering feeds its
# direct_emitter_v1 bindings; the image writer constructs a self-contained
# Java 5 classfile without javac. Renvo pointers remain 32-bit linear-memory
# offsets; Java references cross the explicit RBE-provided interop boundary.
go backend {
	const jvmOpExit = 1
	const jvmOpFrame = 2
	const jvmOpMoveImmediate = 3
	const jvmOpMove = 4
	const jvmOpPushRegister = 5
	const jvmOpPushImmediate = 6
	const jvmOpPopRegister = 7
	const jvmOpLoadFrame = 8
	const jvmOpStoreFrame = 9
	const jvmOpAddressFrame = 10
	const jvmOpLoadMemory = 11
	const jvmOpStoreMemory = 12
	const jvmOpLoadIndex = 13
	const jvmOpStoreIndex = 14
	const jvmOpAdd = 15
	const jvmOpSubtract = 16
	const jvmOpMultiply = 17
	const jvmOpDivide = 18
	const jvmOpRemainder = 19
	const jvmOpAnd = 20
	const jvmOpOr = 21
	const jvmOpXor = 22
	const jvmOpShiftLeft = 23
	const jvmOpShiftRightSigned = 24
	const jvmOpShiftRightUnsigned = 25
	const jvmOpIncrement = 26
	const jvmOpCompare = 27
	const jvmOpSetCondition = 28
	const jvmOpJump = 29
	const jvmOpJumpCondition = 30
	const jvmOpCall = 31
	const jvmOpReturn = 32
	const jvmOpSyscall = 33
	const jvmOpCopyBytes = 34
	const jvmOpAddress = 35
	const jvmOpWrite = 36
	const jvmOpCallIndirect = 37
	const jvmOpOpen = 38
	const jvmOpClose = 39
	const jvmOpRead = 40
	const jvmOpChmod = 41
	const jvmOpReadAt = 42
	const jvmOpWriteAt = 43
	const jvmOpBuildArgsEnv = 44
	const jvmOpDecrement = 45
	const jvmOpHostSyscall = 46
	const jvmHostArgsBytes = 65536

	const jvmDataBase = 256
	const jvmStackBytes = 1048576

	func jvmEmitRegister(out *RTGEmitter, operation int, register int) {
		out.Int8(operation)
		out.Int8(register)
	}

	func jvmEmitRegisters(
		out *RTGEmitter, operation int, destination int, source int,
	) {
		out.Int8(operation)
		out.Int8(destination)
		out.Int8(source)
	}

	func jvmEmitRegisterImmediate(
		out *RTGEmitter, operation int, register int, value int,
	) {
		out.Int8(operation)
		out.Int8(register)
		out.Int32(value)
	}

	func jvmMove(
		out *RTGEmitter, destination RTGRegister, source RTGRegister,
	) {
		jvmEmitRegisters(out, jvmOpMove, destination.Code, source.Code)
	}

	func jvmAddress(
		out *RTGEmitter, destination RTGRegister, address RTGAddress,
	) {
		if RTGAddressValid(address) {
			jvmEmitRegisterImmediate(
				out, jvmOpMoveImmediate, destination.Code, address.Addend)
			RTGAddressRelocAt(out, address, out.Len()-4)
			return
		}
		out.Int8(jvmOpAddress)
		out.Int8(destination.Code)
		if address.Base.Valid {
			out.Int8(address.Base.Code)
		} else {
			out.Int8(255)
		}
		if address.Index.Valid {
			out.Int8(address.Index.Code)
		} else {
			out.Int8(255)
		}
		scale := address.Scale
		if scale == 0 {
			scale = 1
		}
		out.Int32(scale)
		out.Int32(address.Displacement)
	}

	func jvmLoadWidth(
		out *RTGEmitter, destination RTGRegister,
		address RTGAddress, size int,
	) {
		if RTGAddressValid(address) {
			jvmAddress(out, jvmvm32Scratch, address)
			address = RTGAddress{Base: jvmvm32Scratch}
		}
		if address.Index.Valid {
			scale := address.Scale
			if scale == 0 {
				scale = 1
			}
			out.Int8(jvmOpLoadIndex)
			out.Int8(destination.Code)
			out.Int8(address.Base.Code)
			out.Int8(address.Index.Code)
			out.Int8(scale)
			out.Int32(address.Displacement)
			out.Int8(size)
			return
		}
		out.Int8(jvmOpLoadMemory)
		out.Int8(destination.Code)
		out.Int8(address.Base.Code)
		out.Int32(address.Displacement)
		out.Int8(size)
	}

	func jvmLoadNative(out *RTGEmitter, destination RTGRegister, address RTGAddress) {
		jvmLoadWidth(out, destination, address, 4)
	}
	func jvmLoadI32(out *RTGEmitter, destination RTGRegister, address RTGAddress) {
		jvmLoadWidth(out, destination, address, 4)
	}
	func jvmLoadU32(out *RTGEmitter, destination RTGRegister, address RTGAddress) {
		jvmLoadWidth(out, destination, address, 4)
	}
	func jvmLoadI16(out *RTGEmitter, destination RTGRegister, address RTGAddress) {
		jvmLoadWidth(out, destination, address, 18)
	}
	func jvmLoadU16(out *RTGEmitter, destination RTGRegister, address RTGAddress) {
		jvmLoadWidth(out, destination, address, 2)
	}
	func jvmLoadI8(out *RTGEmitter, destination RTGRegister, address RTGAddress) {
		jvmLoadWidth(out, destination, address, 17)
	}
	func jvmLoadU8(out *RTGEmitter, destination RTGRegister, address RTGAddress) {
		jvmLoadWidth(out, destination, address, 1)
	}

	func jvmStoreWidth(
		out *RTGEmitter, address RTGAddress,
		source RTGRegister, size int,
	) {
		if RTGAddressValid(address) {
			jvmAddress(out, jvmvm32Scratch, address)
			address = RTGAddress{Base: jvmvm32Scratch}
		}
		if address.Index.Valid {
			scale := address.Scale
			if scale == 0 {
				scale = 1
			}
			out.Int8(jvmOpStoreIndex)
			out.Int8(source.Code)
			out.Int8(address.Base.Code)
			out.Int8(address.Index.Code)
			out.Int8(scale)
			out.Int32(address.Displacement)
			out.Int8(size)
			return
		}
		out.Int8(jvmOpStoreMemory)
		out.Int8(source.Code)
		out.Int8(address.Base.Code)
		out.Int32(address.Displacement)
		out.Int8(size)
	}

	func jvmStoreNative(out *RTGEmitter, address RTGAddress, source RTGRegister) {
		jvmStoreWidth(out, address, source, 4)
	}
	func jvmStoreU32(out *RTGEmitter, address RTGAddress, source RTGRegister) {
		jvmStoreWidth(out, address, source, 4)
	}
	func jvmStoreU16(out *RTGEmitter, address RTGAddress, source RTGRegister) {
		jvmStoreWidth(out, address, source, 2)
	}
	func jvmStoreU8(out *RTGEmitter, address RTGAddress, source RTGRegister) {
		jvmStoreWidth(out, address, source, 1)
	}

	func jvmBinary(out *RTGEmitter, operation int, destination RTGRegister, source RTGRegister) {
		jvmEmitRegisters(out, operation, destination.Code, source.Code)
	}
	func jvmAdd(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		jvmBinary(out, jvmOpAdd, destination, source)
	}
	func jvmSubtract(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		jvmBinary(out, jvmOpSubtract, destination, source)
	}
	func jvmMultiply(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		jvmBinary(out, jvmOpMultiply, destination, source)
	}
	func jvmBitAnd(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		jvmBinary(out, jvmOpAnd, destination, source)
	}
	func jvmBitOr(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		jvmBinary(out, jvmOpOr, destination, source)
	}
	func jvmBitXor(out *RTGEmitter, destination RTGRegister, source RTGRegister) {
		jvmBinary(out, jvmOpXor, destination, source)
	}
	func jvmCompare(out *RTGEmitter, left RTGRegister, right RTGRegister) {
		jvmBinary(out, jvmOpCompare, left, right)
	}
	func jvmTest(out *RTGEmitter, left RTGRegister, right RTGRegister) {
		jvmMove(out, jvmvm32Scratch, left)
		jvmBinary(out, jvmOpAnd, jvmvm32Scratch, right)
		jvmEmitRegisterImmediate(out, jvmOpMoveImmediate, jvmvm32Primary.Code, 0)
		jvmBinary(out, jvmOpCompare, jvmvm32Scratch, jvmvm32Primary)
	}
	func jvmIncrement(out *RTGEmitter, operand RTGRegister) {
		jvmEmitRegister(out, jvmOpIncrement, operand.Code)
	}
	func jvmDecrement(out *RTGEmitter, operand RTGRegister) {
		jvmEmitRegister(out, jvmOpDecrement, operand.Code)
	}

	func jvmShiftImmediate(
		out *RTGEmitter, operation int, operand RTGRegister, value byte,
	) {
		jvmEmitRegisterImmediate(
			out, jvmOpMoveImmediate, jvmvm32Scratch.Code, int(value))
		jvmBinary(out, operation, operand, jvmvm32Scratch)
	}
	func jvmShiftLeftImmediate(out *RTGEmitter, operand RTGRegister, value byte) {
		jvmShiftImmediate(out, jvmOpShiftLeft, operand, value)
	}
	func jvmShiftRightUnsignedImmediate(out *RTGEmitter, operand RTGRegister, value byte) {
		jvmShiftImmediate(out, jvmOpShiftRightUnsigned, operand, value)
	}
	func jvmShiftRightSignedImmediate(out *RTGEmitter, operand RTGRegister, value byte) {
		jvmShiftImmediate(out, jvmOpShiftRightSigned, operand, value)
	}

	func jvmCall(out *RTGEmitter, label RTGLabel) {
		out.Int8(jvmOpCall)
		at := out.Len()
		out.Int32(0)
		out.RelocAt(at, RTGLabelIndex(label))
		out.Int32(0)
	}
	func jvmCallIndirectWordCount(
		out *RTGEmitter, target RTGRegister, wordCount int,
	) {
		out.Int8(jvmOpCallIndirect)
		out.Int8(target.Code)
		out.Int32(wordCount)
	}
	func jvmCallIndirect(out *RTGEmitter, target RTGRegister) {
		jvmCallIndirectWordCount(out, target, 0)
	}
	func jvmJump(out *RTGEmitter, label RTGLabel) {
		out.Int8(jvmOpJump)
		at := out.Len()
		out.Int32(0)
		out.RelocAt(at, RTGLabelIndex(label))
	}
	func jvmJumpCondition(out *RTGEmitter, condition RTGCondition, label RTGLabel) {
		out.Int8(jvmOpJumpCondition)
		out.Int8(condition.Code)
		at := out.Len()
		out.Int32(0)
		out.RelocAt(at, RTGLabelIndex(label))
	}
	func jvmSetCondition(out *RTGEmitter, condition RTGCondition, destination RTGRegister) {
		out.Int8(jvmOpSetCondition)
		out.Int8(condition.Code)
		out.Int8(destination.Code)
	}
	func jvmReturn(out *RTGEmitter) {
		out.Int8(jvmOpReturn)
	}
	func jvmLeave(out *RTGEmitter) {
	}
	func jvmHostSyscall(out *RTGEmitter) {
		out.Int8(jvmOpHostSyscall)
	}
	func jvmWrite(out *RTGEmitter) {
		out.Int8(jvmOpWrite)
	}
	func jvmOpen(out *RTGEmitter) {
		out.Int8(jvmOpOpen)
	}
	func jvmClose(out *RTGEmitter) {
		out.Int8(jvmOpClose)
	}
	func jvmRead(out *RTGEmitter) {
		out.Int8(jvmOpRead)
	}
	func jvmChmod(out *RTGEmitter) {
		out.Int8(jvmOpChmod)
	}
	func jvmReadAt(out *RTGEmitter) {
		out.Int8(jvmOpReadAt)
	}
	func jvmWriteAt(out *RTGEmitter) {
		out.Int8(jvmOpWriteAt)
	}
	func jvmStaticCall(out *RTGEmitter, importID int, wordCount int) {
		for i := 0; i < wordCount; i++ {
			jvmPopRegister(out, jvmvm32Scratch)
		}
		result := -1
		if importID >= 0 && importID < out.StaticImportCount() &&
			out.StaticImportName(importID) == "CC_SHA256" {
			// The backend already contains its defined-operation SHA-256 fallback.
			// Returning zero selects it when ISO JVM cannot provide CommonCrypto.
			result = 0
		}
		jvmMoveImmediate(out, jvmvm32Primary, int64(result))
	}
	func jvmMoveImmediate(out *RTGEmitter, destination RTGRegister, value int64) {
		jvmEmitRegisterImmediate(out, jvmOpMoveImmediate, destination.Code, int(value))
	}
	func jvmVariableShift(out *RTGEmitter, direction RTGShiftDirection, signed bool) {
		jvmMove(out, jvmvm32Scratch, jvmvm32Primary)
		jvmMove(out, jvmvm32Primary, jvmvm32Tertiary)
		operation := jvmOpShiftRightUnsigned
		if direction == RTGShiftLeft {
			operation = jvmOpShiftLeft
		} else if signed {
			operation = jvmOpShiftRightSigned
		}
		jvmBinary(out, operation, jvmvm32Primary, jvmvm32Scratch)
	}
	func jvmSignedDivide(out *RTGEmitter, remainder bool) {
		operation := jvmOpDivide
		if remainder {
			operation = jvmOpRemainder
		}
		jvmMove(out, jvmvm32Scratch, jvmvm32Primary)
		jvmMove(out, jvmvm32Primary, jvmvm32Tertiary)
		jvmBinary(out, operation, jvmvm32Primary, jvmvm32Scratch)
	}
	func jvmCopyBytes(out *RTGEmitter) {
		out.Int8(jvmOpCopyBytes)
	}

	func jvmPatchRelocations(out *RTGEmitter) {
		dataBase := jvmDataBase
		bssBase := RTGAlignValue(dataBase+len(out.Data()), 8)
		for i := 0; i < out.RelocationCount(); i++ {
			at := out.RelocationOffset(i)
			target := out.LabelPosition(out.RelocationLabel(i))
			if target >= 0 {
				RTGPut32At(out.Code(), at, target+RTGGet32At(out.Code(), at))
			}
		}
		for i := 0; i < out.AbsoluteRelocationCount(); i++ {
			at := out.AbsoluteRelocationOffset(i)
			target, resolved := RTGResolveAbsoluteRelocation(out,
				out.AbsoluteRelocationKind(i), out.AbsoluteRelocationAddend(i),
				dataBase, bssBase)
			if resolved {
				RTGPut32At(out.Code(), at, target)
			}
		}
	}

	func jvmFrameStart(out *RTGEmitter) int {
		out.Int8(jvmOpFrame)
		at := out.Len()
		out.Int32(0)
		return at
	}
	func jvmFrameFinish(out *RTGEmitter, framePatch int, stackUsed int) {
		out.PatchUint32(framePatch, RTGAlignValue(stackUsed, 8))
	}
	func jvmPushRegister(out *RTGEmitter, source RTGRegister) {
		jvmEmitRegister(out, jvmOpPushRegister, source.Code)
	}
	func jvmPushImmediate(out *RTGEmitter, value int) {
		out.Int8(jvmOpPushImmediate)
		out.Int32(value)
	}
	func jvmPopRegister(out *RTGEmitter, destination RTGRegister) {
		jvmEmitRegister(out, jvmOpPopRegister, destination.Code)
	}
	func jvmLoadFrame(out *RTGEmitter, destination RTGRegister, offset int) {
		jvmEmitRegisterImmediate(out, jvmOpLoadFrame, destination.Code, offset)
	}
	func jvmStoreFrame(out *RTGEmitter, offset int, source RTGRegister) {
		jvmEmitRegisterImmediate(out, jvmOpStoreFrame, source.Code, offset)
	}
	func jvmAddressFrame(out *RTGEmitter, destination RTGRegister, offset int) {
		jvmEmitRegisterImmediate(out, jvmOpAddressFrame, destination.Code, offset)
	}
	func jvmStoreParamWord(out *RTGEmitter, word int, offset int) {
		registers := []RTGRegister{
			{Code: 3, Valid: true}, {Code: 4, Valid: true},
			{Code: 1, Valid: true}, {Code: 2, Valid: true},
			{Code: 5, Valid: true}, {Code: 6, Valid: true},
		}
		register := jvmvm32Primary
		if word >= 0 && word < len(registers) {
			register = registers[word]
		} else {
			jvmPopRegister(out, register)
		}
		jvmStoreFrame(out, offset, register)
	}
	func jvmCallWordCount(out *RTGEmitter, label RTGLabel, wordCount int) {
		registers := []RTGRegister{
			{Code: 3, Valid: true}, {Code: 4, Valid: true},
			{Code: 1, Valid: true}, {Code: 2, Valid: true},
			{Code: 5, Valid: true}, {Code: 6, Valid: true},
		}
		limit := wordCount
		if limit > len(registers) {
			limit = len(registers)
		}
		for i := 0; i < limit; i++ {
			jvmPopRegister(out, registers[i])
		}
		jvmEmitRegisterImmediate(
			out, jvmOpMoveImmediate, jvmvm32Scratch.Code, 0)
		at := out.Len()-4
		out.RelocAt(at, RTGLabelIndex(label))
		jvmCallIndirectWordCount(out, jvmvm32Scratch, wordCount)
	}
	func jvmHostedEntry(out *RTGEmitter, parameterCount int, stateOffset int) bool {
		_ = stateOffset
		if parameterCount < 0 || parameterCount > 2 {
			return false
		}
		if parameterCount > 0 {
			argsOffset := out.ReserveBSS(jvmHostArgsBytes, 16)
			out.Int8(jvmOpBuildArgsEnv)
			at := out.Len()
			out.Int32(argsOffset)
			out.AbsoluteReloc(at, argsOffset, RTGRelocationAbsoluteBSS)
			out.Int8(parameterCount)
		}
		return true
	}
	func jvmFreestandingEntry(out *RTGEmitter, parameterCount int, stateOffset int) bool {
		_ = out
		_ = stateOffset
		return parameterCount >= 0 && parameterCount <= 2
	}
	func jvmExit(out *RTGEmitter, status RTGRegister) {
		if status.Code != jvmvm32Primary.Code {
			jvmMove(out, jvmvm32Primary, status)
		}
		out.Int8(jvmOpExit)
	}


	type jvmConstantPool struct {
		entries [][]byte
		keys []string
	}

	type jvmMethod struct {
		access int
		name string
		descriptor string
		maxStack int
		maxLocals int
		code []byte
		exceptionStart []int
		exceptionEnd []int
		exceptionHandler []int
		exceptionClass []int
	}

	type jvmAssembler struct {
		code []byte
		labels []int
		fixAt []int
		fixBase []int
		fixLabel []int
		fixWide []bool
	}

	func jvmBE16(out []byte, value int) []byte {
		return append(out, byte(value>>8), byte(value))
	}

	func jvmBE32(out []byte, value int) []byte {
		return append(out, byte(value>>24), byte(value>>16),
			byte(value>>8), byte(value))
	}

	func jvmPoolFind(pool *jvmConstantPool, key string) int {
		for i := 0; i < len(pool.keys); i++ {
			if pool.keys[i] == key {
				return i+1
			}
		}
		return 0
	}

	func jvmPoolAdd(pool *jvmConstantPool, key string, entry []byte) int {
		if found := jvmPoolFind(pool, key); found != 0 {
			return found
		}
		pool.keys = append(pool.keys, key)
		pool.entries = append(pool.entries, entry)
		return len(pool.entries)
	}

	func jvmPoolUTF8(pool *jvmConstantPool, value string) int {
		key := "U"+value
		if found := jvmPoolFind(pool, key); found != 0 {
			return found
		}
		entry := []byte{1}
		entry = jvmBE16(entry, len(value))
		for i := 0; i < len(value); i++ {
			entry = append(entry, value[i])
		}
		return jvmPoolAdd(pool, key, entry)
	}

	func jvmPoolClass(pool *jvmConstantPool, name string) int {
		key := "C"+name
		if found := jvmPoolFind(pool, key); found != 0 {
			return found
		}
		entry := []byte{7}
		entry = jvmBE16(entry, jvmPoolUTF8(pool, name))
		return jvmPoolAdd(pool, key, entry)
	}

	func jvmPoolString(pool *jvmConstantPool, value string) int {
		key := "S"+value
		if found := jvmPoolFind(pool, key); found != 0 {
			return found
		}
		entry := []byte{8}
		entry = jvmBE16(entry, jvmPoolUTF8(pool, value))
		return jvmPoolAdd(pool, key, entry)
	}

	func jvmPoolByteString(pool *jvmConstantPool, value []byte) int {
		raw := string(value)
		key := "B"+raw
		if found := jvmPoolFind(pool, key); found != 0 {
			return found
		}
		utfKey := "b"+raw
		utfIndex := jvmPoolFind(pool, utfKey)
		if utfIndex == 0 {
			encoded := make([]byte, 0, len(value)*2)
			for i := 0; i < len(value); i++ {
				ch := int(value[i])
				if ch == 0 {
					encoded = append(encoded, 0xc0, 0x80)
				} else if ch < 0x80 {
					encoded = append(encoded, byte(ch))
				} else {
					encoded = append(encoded, byte(0xc0|(ch>>6)), byte(0x80|(ch&63)))
				}
			}
			entry := []byte{1}
			entry = jvmBE16(entry, len(encoded))
			entry = append(entry, encoded...)
			utfIndex = jvmPoolAdd(pool, utfKey, entry)
		}
		entry := []byte{8}
		entry = jvmBE16(entry, utfIndex)
		return jvmPoolAdd(pool, key, entry)
	}

	func jvmPoolInteger(pool *jvmConstantPool, value int) int {
		key := "I"+jvmDecimalText(value)
		if found := jvmPoolFind(pool, key); found != 0 {
			return found
		}
		entry := []byte{3}
		entry = jvmBE32(entry, value)
		return jvmPoolAdd(pool, key, entry)
	}

	func jvmPoolNameType(
		pool *jvmConstantPool, name string, descriptor string,
	) int {
		key := "N"+name+":"+descriptor
		if found := jvmPoolFind(pool, key); found != 0 {
			return found
		}
		entry := []byte{12}
		entry = jvmBE16(entry, jvmPoolUTF8(pool, name))
		entry = jvmBE16(entry, jvmPoolUTF8(pool, descriptor))
		return jvmPoolAdd(pool, key, entry)
	}

	func jvmPoolMember(
		pool *jvmConstantPool, tag byte, owner string,
		name string, descriptor string,
	) int {
		key := string([]byte{tag})+owner+"."+name+descriptor
		if found := jvmPoolFind(pool, key); found != 0 {
			return found
		}
		entry := []byte{tag}
		entry = jvmBE16(entry, jvmPoolClass(pool, owner))
		entry = jvmBE16(entry, jvmPoolNameType(pool, name, descriptor))
		return jvmPoolAdd(pool, key, entry)
	}

	func jvmPoolField(
		pool *jvmConstantPool, owner string, name string, descriptor string,
	) int {
		return jvmPoolMember(pool, 9, owner, name, descriptor)
	}

	func jvmPoolMethod(
		pool *jvmConstantPool, owner string, name string, descriptor string,
	) int {
		return jvmPoolMember(pool, 10, owner, name, descriptor)
	}

	func jvmPoolInterfaceMethod(
		pool *jvmConstantPool, owner string, name string, descriptor string,
	) int {
		return jvmPoolMember(pool, 11, owner, name, descriptor)
	}

	func jvmDecimalText(value int) string {
		if value == 0 {
			return "0"
		}
		negative := value < 0
		if negative {
			value = -value
		}
		var digits []byte
		for value > 0 {
			digits = append(digits, byte('0'+value%10))
			value /= 10
		}
		var result []byte
		if negative {
			result = append(result, '-')
		}
		for i := len(digits)-1; i >= 0; i-- {
			result = append(result, digits[i])
		}
		return string(result)
	}

	func jvmAsmNewLabel(asm *jvmAssembler) int {
		asm.labels = append(asm.labels, -1)
		return len(asm.labels)-1
	}

	func jvmAsmMark(asm *jvmAssembler, label int) {
		asm.labels[label] = len(asm.code)
	}

	func jvmAsmU1(asm *jvmAssembler, value int) {
		asm.code = append(asm.code, byte(value))
	}

	func jvmAsmU2(asm *jvmAssembler, value int) {
		asm.code = jvmBE16(asm.code, value)
	}

	func jvmAsmBranch(asm *jvmAssembler, opcode int, label int) {
		base := len(asm.code)
		jvmAsmU1(asm, opcode)
		at := len(asm.code)
		jvmAsmU2(asm, 0)
		asm.fixAt = append(asm.fixAt, at)
		asm.fixBase = append(asm.fixBase, base)
		asm.fixLabel = append(asm.fixLabel, label)
		asm.fixWide = append(asm.fixWide, false)
	}

	func jvmAsmGoto(asm *jvmAssembler, label int) {
		base := len(asm.code)
		jvmAsmU1(asm, 0xc8)
		at := len(asm.code)
		asm.code = jvmBE32(asm.code, 0)
		asm.fixAt = append(asm.fixAt, at)
		asm.fixBase = append(asm.fixBase, base)
		asm.fixLabel = append(asm.fixLabel, label)
		asm.fixWide = append(asm.fixWide, true)
	}

	func jvmAsmPatch(asm *jvmAssembler) []byte {
		for i := 0; i < len(asm.fixAt); i++ {
			target := asm.labels[asm.fixLabel[i]]
			delta := target-asm.fixBase[i]
			at := asm.fixAt[i]
			if asm.fixWide[i] {
				asm.code[at] = byte(delta>>24)
				asm.code[at+1] = byte(delta>>16)
				asm.code[at+2] = byte(delta>>8)
				asm.code[at+3] = byte(delta)
			} else {
				asm.code[at] = byte(delta>>8)
				asm.code[at+1] = byte(delta)
			}
		}
		return asm.code
	}

	func jvmAsmLocal(asm *jvmAssembler, opcode int, local int) {
		if local >= 0 && local <= 3 &&
			(opcode == 0x15 || opcode == 0x36 || opcode == 0x19 || opcode == 0x3a) {
			base := 0x1a
			if opcode == 0x36 { base = 0x3b }
			if opcode == 0x19 { base = 0x2a }
			if opcode == 0x3a { base = 0x4b }
			jvmAsmU1(asm, base+local)
			return
		}
		jvmAsmU1(asm, opcode)
		jvmAsmU1(asm, local)
	}

	func jvmAsmInt(asm *jvmAssembler, pool *jvmConstantPool, value int) {
		if value >= -1 && value <= 5 {
			jvmAsmU1(asm, 3+value)
			return
		}
		if value >= -128 && value <= 127 {
			jvmAsmU1(asm, 0x10)
			jvmAsmU1(asm, value)
			return
		}
		if value >= -32768 && value <= 32767 {
			jvmAsmU1(asm, 0x11)
			jvmAsmU2(asm, value)
			return
		}
		index := jvmPoolInteger(pool, value)
		if index <= 255 {
			jvmAsmU1(asm, 0x12)
			jvmAsmU1(asm, index)
		} else {
			jvmAsmU1(asm, 0x13)
			jvmAsmU2(asm, index)
		}
	}

	func jvmAsmMember(asm *jvmAssembler, opcode int, index int) {
		jvmAsmU1(asm, opcode)
		jvmAsmU2(asm, index)
	}

	func jvmAsmTableSwitch(
		asm *jvmAssembler, low int, labels []int, defaultLabel int,
	) {
		base := len(asm.code)
		jvmAsmU1(asm, 0xaa)
		for len(asm.code)%4 != 0 {
			jvmAsmU1(asm, 0)
		}
		at := len(asm.code)
		asm.code = jvmBE32(asm.code, 0)
		asm.fixAt = append(asm.fixAt, at)
		asm.fixBase = append(asm.fixBase, base)
		asm.fixLabel = append(asm.fixLabel, defaultLabel)
		asm.fixWide = append(asm.fixWide, true)
		asm.code = jvmBE32(asm.code, low)
		asm.code = jvmBE32(asm.code, low+len(labels)-1)
		for i := 0; i < len(labels); i++ {
			at = len(asm.code)
			asm.code = jvmBE32(asm.code, 0)
			asm.fixAt = append(asm.fixAt, at)
			asm.fixBase = append(asm.fixBase, base)
			asm.fixLabel = append(asm.fixLabel, labels[i])
			asm.fixWide = append(asm.fixWide, true)
		}
	}

	func jvmAsmGetStatic(
		asm *jvmAssembler, pool *jvmConstantPool, name string, descriptor string,
	) {
		jvmAsmMember(asm, 0xb2,
			jvmPoolField(pool, "RenvoProgram", name, descriptor))
	}

	func jvmAsmPutStatic(
		asm *jvmAssembler, pool *jvmConstantPool, name string, descriptor string,
	) {
		jvmAsmMember(asm, 0xb3,
			jvmPoolField(pool, "RenvoProgram", name, descriptor))
	}

	func jvmAsmInvokeStatic(
		asm *jvmAssembler, pool *jvmConstantPool,
		owner string, name string, descriptor string,
	) {
		jvmAsmMember(asm, 0xb8, jvmPoolMethod(pool, owner, name, descriptor))
	}

	func jvmAsmInvokeVirtual(
		asm *jvmAssembler, pool *jvmConstantPool,
		owner string, name string, descriptor string,
	) {
		jvmAsmMember(asm, 0xb6, jvmPoolMethod(pool, owner, name, descriptor))
	}

	func jvmAsmInvokeInterface(
		asm *jvmAssembler, pool *jvmConstantPool,
		owner string, name string, descriptor string, words int,
	) {
		jvmAsmMember(asm, 0xb9,
			jvmPoolInterfaceMethod(pool, owner, name, descriptor))
		jvmAsmU1(asm, words)
		jvmAsmU1(asm, 0)
	}

	func jvmAsmRLoadConst(
		asm *jvmAssembler, pool *jvmConstantPool, index int,
	) {
		jvmAsmGetStatic(asm, pool, "R", "[I")
		jvmAsmInt(asm, pool, index)
		jvmAsmU1(asm, 0x2e)
	}

	func jvmAsmRStoreConstPrefix(
		asm *jvmAssembler, pool *jvmConstantPool, index int,
	) {
		jvmAsmGetStatic(asm, pool, "R", "[I")
		jvmAsmInt(asm, pool, index)
	}

	func jvmMakeConstructor(pool *jvmConstantPool) jvmMethod {
		var asm jvmAssembler
		jvmAsmLocal(&asm, 0x19, 0)
		jvmAsmMember(&asm, 0xb7,
			jvmPoolMethod(pool, "java/lang/Object", "<init>", "()V"))
		jvmAsmU1(&asm, 0xb1)
		return jvmMethod{access: 1, name: "<init>", descriptor: "()V",
			maxStack: 1, maxLocals: 1, code: asm.code}
	}

	func jvmMakeU8(pool *jvmConstantPool) jvmMethod {
		var asm jvmAssembler
		jvmAsmGetStatic(&asm, pool, "C", "[B")
		jvmAsmGetStatic(&asm, pool, "PC", "I")
		jvmAsmU1(&asm, 0x59)
		jvmAsmU1(&asm, 0x04)
		jvmAsmU1(&asm, 0x60)
		jvmAsmPutStatic(&asm, pool, "PC", "I")
		jvmAsmU1(&asm, 0x33)
		jvmAsmInt(&asm, pool, 255)
		jvmAsmU1(&asm, 0x7e)
		jvmAsmU1(&asm, 0xac)
		return jvmMethod{access: 0x000a, name: "u8", descriptor: "()I",
			maxStack: 4, maxLocals: 0, code: asm.code}
	}

	func jvmMakeI32(pool *jvmConstantPool) jvmMethod {
		var asm jvmAssembler
		for i := 0; i < 4; i++ {
			jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "u8", "()I")
			if i > 0 {
				jvmAsmInt(&asm, pool, i*8)
				jvmAsmU1(&asm, 0x78)
				jvmAsmU1(&asm, 0x80)
			}
		}
		jvmAsmU1(&asm, 0xac)
		return jvmMethod{access: 0x000a, name: "i32", descriptor: "()I",
			maxStack: 3, maxLocals: 0, code: asm.code}
	}

	func jvmMakeLoad(pool *jvmConstantPool) jvmMethod {
		var asm jvmAssembler
		bad := jvmAsmNewLabel(&asm)
		done1 := jvmAsmNewLabel(&asm)
		done2 := jvmAsmNewLabel(&asm)
		jvmAsmLocal(&asm, 0x15, 0)
		jvmAsmBranch(&asm, 0x9b, bad)
		jvmAsmLocal(&asm, 0x15, 0)
		jvmAsmLocal(&asm, 0x15, 1)
		jvmAsmU1(&asm, 0x60)
		jvmAsmGetStatic(&asm, pool, "M", "[B")
		jvmAsmU1(&asm, 0xbe)
		jvmAsmBranch(&asm, 0xa3, bad)
		jvmAsmGetStatic(&asm, pool, "M", "[B")
		jvmAsmLocal(&asm, 0x15, 0)
		jvmAsmU1(&asm, 0x33)
		jvmAsmInt(&asm, pool, 255)
		jvmAsmU1(&asm, 0x7e)
		jvmAsmLocal(&asm, 0x36, 2)
		jvmAsmLocal(&asm, 0x15, 1)
		jvmAsmInt(&asm, pool, 1)
		jvmAsmBranch(&asm, 0x9f, done1)
		jvmAsmLocal(&asm, 0x15, 2)
		jvmAsmGetStatic(&asm, pool, "M", "[B")
		jvmAsmLocal(&asm, 0x15, 0)
		jvmAsmInt(&asm, pool, 1)
		jvmAsmU1(&asm, 0x60)
		jvmAsmU1(&asm, 0x33)
		jvmAsmInt(&asm, pool, 255)
		jvmAsmU1(&asm, 0x7e)
		jvmAsmInt(&asm, pool, 8)
		jvmAsmU1(&asm, 0x78)
		jvmAsmU1(&asm, 0x80)
		jvmAsmLocal(&asm, 0x36, 2)
		jvmAsmLocal(&asm, 0x15, 1)
		jvmAsmInt(&asm, pool, 2)
		jvmAsmBranch(&asm, 0x9f, done2)
		for i := 2; i < 4; i++ {
			jvmAsmLocal(&asm, 0x15, 2)
			jvmAsmGetStatic(&asm, pool, "M", "[B")
			jvmAsmLocal(&asm, 0x15, 0)
			jvmAsmInt(&asm, pool, i)
			jvmAsmU1(&asm, 0x60)
			jvmAsmU1(&asm, 0x33)
			jvmAsmInt(&asm, pool, 255)
			jvmAsmU1(&asm, 0x7e)
			jvmAsmInt(&asm, pool, i*8)
			jvmAsmU1(&asm, 0x78)
			jvmAsmU1(&asm, 0x80)
			jvmAsmLocal(&asm, 0x36, 2)
		}
		jvmAsmMark(&asm, done2)
		jvmAsmMark(&asm, done1)
		jvmAsmLocal(&asm, 0x15, 2)
		jvmAsmU1(&asm, 0xac)
		jvmAsmMark(&asm, bad)
		jvmAsmU1(&asm, 0x03)
		jvmAsmU1(&asm, 0xac)
		return jvmMethod{access: 0x000a, name: "load", descriptor: "(II)I",
			maxStack: 5, maxLocals: 3, code: jvmAsmPatch(&asm)}
	}

	func jvmMakeStore(pool *jvmConstantPool) jvmMethod {
		var asm jvmAssembler
		bad := jvmAsmNewLabel(&asm)
		done := jvmAsmNewLabel(&asm)
		jvmAsmLocal(&asm, 0x15, 0)
		jvmAsmBranch(&asm, 0x9b, bad)
		jvmAsmLocal(&asm, 0x15, 0)
		jvmAsmLocal(&asm, 0x15, 1)
		jvmAsmU1(&asm, 0x60)
		jvmAsmGetStatic(&asm, pool, "M", "[B")
		jvmAsmU1(&asm, 0xbe)
		jvmAsmBranch(&asm, 0xa3, bad)
		jvmAsmU1(&asm, 0x03)
		jvmAsmLocal(&asm, 0x36, 3)
		loop := jvmAsmNewLabel(&asm)
		jvmAsmMark(&asm, loop)
		jvmAsmLocal(&asm, 0x15, 3)
		jvmAsmLocal(&asm, 0x15, 1)
		jvmAsmBranch(&asm, 0xa2, done)
		jvmAsmGetStatic(&asm, pool, "M", "[B")
		jvmAsmLocal(&asm, 0x15, 0)
		jvmAsmLocal(&asm, 0x15, 3)
		jvmAsmU1(&asm, 0x60)
		jvmAsmLocal(&asm, 0x15, 2)
		jvmAsmLocal(&asm, 0x15, 3)
		jvmAsmInt(&asm, pool, 8)
		jvmAsmU1(&asm, 0x68)
		jvmAsmU1(&asm, 0x7c)
		jvmAsmU1(&asm, 0x54)
		jvmAsmLocal(&asm, 0x15, 3)
		jvmAsmU1(&asm, 0x04)
		jvmAsmU1(&asm, 0x60)
		jvmAsmLocal(&asm, 0x36, 3)
		jvmAsmGoto(&asm, loop)
		jvmAsmMark(&asm, done)
		jvmAsmU1(&asm, 0x04)
		jvmAsmU1(&asm, 0xac)
		jvmAsmMark(&asm, bad)
		jvmAsmU1(&asm, 0x03)
		jvmAsmU1(&asm, 0xac)
		return jvmMethod{access: 0x000a, name: "store", descriptor: "(III)Z",
			maxStack: 6, maxLocals: 4, code: jvmAsmPatch(&asm)}
	}

	func jvmMakeLoadLong(pool *jvmConstantPool) jvmMethod {
		var asm jvmAssembler
		jvmAsmLocal(&asm, 0x15, 0)
		jvmAsmInt(&asm, pool, 4)
		jvmAsmU1(&asm, 0x60)
		jvmAsmInt(&asm, pool, 4)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "load", "(II)I")
		jvmAsmU1(&asm, 0x85)
		jvmAsmInt(&asm, pool, 32)
		jvmAsmU1(&asm, 0x79)
		jvmAsmLocal(&asm, 0x15, 0)
		jvmAsmInt(&asm, pool, 4)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "load", "(II)I")
		jvmAsmU1(&asm, 0x85)
		jvmAsmInt(&asm, pool, 32)
		jvmAsmU1(&asm, 0x79)
		jvmAsmInt(&asm, pool, 32)
		jvmAsmU1(&asm, 0x7d)
		jvmAsmU1(&asm, 0x81)
		jvmAsmU1(&asm, 0xad)
		return jvmMethod{access: 0x000a, name: "loadLong", descriptor: "(I)J",
			maxStack: 6, maxLocals: 1, code: asm.code}
	}

	func jvmMakeStoreLong(pool *jvmConstantPool) jvmMethod {
		var asm jvmAssembler
		jvmAsmLocal(&asm, 0x15, 0)
		jvmAsmInt(&asm, pool, 4)
		jvmAsmLocal(&asm, 0x16, 1)
		jvmAsmU1(&asm, 0x88)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "store", "(III)Z")
		jvmAsmU1(&asm, 0x57)
		jvmAsmLocal(&asm, 0x15, 0)
		jvmAsmInt(&asm, pool, 4)
		jvmAsmU1(&asm, 0x60)
		jvmAsmInt(&asm, pool, 4)
		jvmAsmLocal(&asm, 0x16, 1)
		jvmAsmInt(&asm, pool, 32)
		jvmAsmU1(&asm, 0x7d)
		jvmAsmU1(&asm, 0x88)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "store", "(III)Z")
		jvmAsmU1(&asm, 0x57)
		jvmAsmU1(&asm, 0xb1)
		return jvmMethod{access: 0x000a, name: "storeLong", descriptor: "(IJ)V",
			maxStack: 5, maxLocals: 3, code: asm.code}
	}

	func jvmAsmLoadFloat(
		asm *jvmAssembler, pool *jvmConstantPool, addressLocal int, wide bool,
	) {
		jvmAsmLocal(asm, 0x15, addressLocal)
		if wide {
			jvmAsmInvokeStatic(asm, pool, "RenvoProgram", "loadLong", "(I)J")
			jvmAsmInvokeStatic(asm, pool, "java/lang/Double", "longBitsToDouble", "(J)D")
		} else {
			jvmAsmInt(asm, pool, 4)
			jvmAsmInvokeStatic(asm, pool, "RenvoProgram", "load", "(II)I")
			jvmAsmInvokeStatic(asm, pool, "java/lang/Float", "intBitsToFloat", "(I)F")
		}
	}

	func jvmAsmStoreFloat(
		asm *jvmAssembler, pool *jvmConstantPool, addressLocal int, wide bool,
	) {
		if wide {
			jvmAsmInvokeStatic(asm, pool, "java/lang/Double", "doubleToRawLongBits", "(D)J")
			jvmAsmLocal(asm, 0x37, 5)
			jvmAsmLocal(asm, 0x15, addressLocal)
			jvmAsmLocal(asm, 0x16, 5)
			jvmAsmInvokeStatic(asm, pool, "RenvoProgram", "storeLong", "(IJ)V")
		} else {
			jvmAsmInvokeStatic(asm, pool, "java/lang/Float", "floatToRawIntBits", "(F)I")
			jvmAsmLocal(asm, 0x36, 5)
			jvmAsmLocal(asm, 0x15, addressLocal)
			jvmAsmInt(asm, pool, 4)
			jvmAsmLocal(asm, 0x15, 5)
			jvmAsmInvokeStatic(asm, pool, "RenvoProgram", "store", "(III)Z")
			jvmAsmU1(asm, 0x57)
		}
	}

	func jvmAsmFloatBinaryCase(
		asm *jvmAssembler, pool *jvmConstantPool,
		label int, opcode int, wide bool, done int,
	) {
		jvmAsmMark(asm, label)
		jvmAsmLoadFloat(asm, pool, 1, wide)
		jvmAsmLoadFloat(asm, pool, 2, wide)
		jvmAsmU1(asm, opcode)
		jvmAsmStoreFloat(asm, pool, 0, wide)
		jvmAsmGoto(asm, done)
	}

	func jvmAsmFloatBinaryDispatch(
		asm *jvmAssembler, pool *jvmConstantPool, wide bool, done int,
	) {
		add := jvmAsmNewLabel(asm)
		sub := jvmAsmNewLabel(asm)
		mul := jvmAsmNewLabel(asm)
		div := jvmAsmNewLabel(asm)
		jvmAsmLocal(asm, 0x15, 3)
		jvmAsmInt(asm, pool, int('+'))
		jvmAsmBranch(asm, 0x9f, add)
		jvmAsmLocal(asm, 0x15, 3)
		jvmAsmInt(asm, pool, int('-'))
		jvmAsmBranch(asm, 0x9f, sub)
		jvmAsmLocal(asm, 0x15, 3)
		jvmAsmInt(asm, pool, int('*'))
		jvmAsmBranch(asm, 0x9f, mul)
		jvmAsmLocal(asm, 0x15, 3)
		jvmAsmInt(asm, pool, int('/'))
		jvmAsmBranch(asm, 0x9f, div)
		jvmAsmGoto(asm, done)
		base := 0x62
		if wide { base = 0x63 }
		jvmAsmFloatBinaryCase(asm, pool, add, base, wide, done)
		jvmAsmFloatBinaryCase(asm, pool, sub, base+4, wide, done)
		jvmAsmFloatBinaryCase(asm, pool, mul, base+8, wide, done)
		jvmAsmFloatBinaryCase(asm, pool, div, base+12, wide, done)
	}

	func jvmMakeFloatBinary(pool *jvmConstantPool) jvmMethod {
		var asm jvmAssembler
		wide := jvmAsmNewLabel(&asm)
		done := jvmAsmNewLabel(&asm)
		jvmAsmLocal(&asm, 0x15, 4)
		jvmAsmInt(&asm, pool, 8)
		jvmAsmBranch(&asm, 0x9f, wide)
		jvmAsmFloatBinaryDispatch(&asm, pool, false, done)
		jvmAsmMark(&asm, wide)
		jvmAsmFloatBinaryDispatch(&asm, pool, true, done)
		jvmAsmMark(&asm, done)
		jvmAsmU1(&asm, 0xb1)
		return jvmMethod{access: 0x000a, name: "floatBinary", descriptor: "(IIIII)V",
			maxStack: 6, maxLocals: 7, code: jvmAsmPatch(&asm)}
	}

	func jvmAsmFloatCompareValue(
		asm *jvmAssembler, pool *jvmConstantPool, wide bool,
	) {
		greater := jvmAsmNewLabel(asm)
		after := jvmAsmNewLabel(asm)
		jvmAsmLocal(asm, 0x15, 2)
		jvmAsmInt(asm, pool, 255)
		jvmAsmU1(asm, 0x7e)
		jvmAsmInt(asm, pool, int('>'))
		jvmAsmBranch(asm, 0x9f, greater)
		jvmAsmLoadFloat(asm, pool, 0, wide)
		jvmAsmLoadFloat(asm, pool, 1, wide)
		jvmAsmU1(asm, 0x96+2*boolInt(wide))
		jvmAsmGoto(asm, after)
		jvmAsmMark(asm, greater)
		jvmAsmLoadFloat(asm, pool, 0, wide)
		jvmAsmLoadFloat(asm, pool, 1, wide)
		jvmAsmU1(asm, 0x95+2*boolInt(wide))
		jvmAsmMark(asm, after)
		jvmAsmLocal(asm, 0x36, 4)
	}

	func boolInt(value bool) int {
		if value { return 1 }
		return 0
	}

	func jvmAsmFloatCompareReturn(
		asm *jvmAssembler, pool *jvmConstantPool, predicate int, opcode int,
	) {
		next := jvmAsmNewLabel(asm)
		jvmAsmLocal(asm, 0x15, 2)
		jvmAsmInt(asm, pool, predicate)
		jvmAsmBranch(asm, 0xa0, next)
		jvmAsmLocal(asm, 0x15, 4)
		jvmAsmU1(asm, 0x03)
		jvmEmitBooleanResult(asm, opcode)
		jvmAsmMark(asm, next)
	}

	func jvmMakeFloatCompare(pool *jvmConstantPool) jvmMethod {
		var asm jvmAssembler
		wide := jvmAsmNewLabel(&asm)
		after := jvmAsmNewLabel(&asm)
		jvmAsmLocal(&asm, 0x15, 3)
		jvmAsmInt(&asm, pool, 8)
		jvmAsmBranch(&asm, 0x9f, wide)
		jvmAsmFloatCompareValue(&asm, pool, false)
		jvmAsmGoto(&asm, after)
		jvmAsmMark(&asm, wide)
		jvmAsmFloatCompareValue(&asm, pool, true)
		jvmAsmMark(&asm, after)
		jvmAsmFloatCompareReturn(&asm, pool, int('=')|int('=')<<8, 0x9f)
		jvmAsmFloatCompareReturn(&asm, pool, int('!')|int('=')<<8, 0xa0)
		jvmAsmFloatCompareReturn(&asm, pool, int('<'), 0xa1)
		jvmAsmFloatCompareReturn(&asm, pool, int('<')|int('=')<<8, 0xa4)
		jvmAsmFloatCompareReturn(&asm, pool, int('>'), 0xa3)
		jvmAsmFloatCompareReturn(&asm, pool, int('>')|int('=')<<8, 0xa2)
		jvmAsmU1(&asm, 0x03)
		jvmAsmU1(&asm, 0xac)
		return jvmMethod{access: 0x000a, name: "floatCompare", descriptor: "(IIII)I",
			maxStack: 5, maxLocals: 5, code: jvmAsmPatch(&asm)}
	}

	func jvmMakeFloatConvert(pool *jvmConstantPool) jvmMethod {
		var asm jvmAssembler
		sourceWide := jvmAsmNewLabel(&asm)
		floatToFloat := jvmAsmNewLabel(&asm)
		done := jvmAsmNewLabel(&asm)
		jvmAsmLocal(&asm, 0x15, 2)
		jvmAsmInt(&asm, pool, 8)
		jvmAsmBranch(&asm, 0x9f, sourceWide)
