	func jvmBE16(out []byte, value int) []byte {
		return append(out, byte(value>>8), byte(value))
	}

	func jvmBE32(out []byte, value int) []byte {
		return append(out, byte(value>>24), byte(value>>16),
			byte(value>>8), byte(value))
	}

	func jvmPoolFind(pool *jvmConstantPool, key string) int {
		for i := 0; i < len(pool.keys); i++ {
			if pool.keys[i] == key {
				return i+1
			}
		}
		return 0
	}

	func jvmPoolAdd(pool *jvmConstantPool, key string, entry []byte) int {
		if found := jvmPoolFind(pool, key); found != 0 {
			return found
		}
		pool.keys = append(pool.keys, key)
		pool.entries = append(pool.entries, entry)
		return len(pool.entries)
	}

	func jvmPoolUTF8(pool *jvmConstantPool, value string) int {
		key := "U"+value
		if found := jvmPoolFind(pool, key); found != 0 {
			return found
		}
		entry := []byte{1}
		entry = jvmBE16(entry, len(value))
		for i := 0; i < len(value); i++ {
			entry = append(entry, value[i])
		}
		return jvmPoolAdd(pool, key, entry)
	}

	func jvmPoolClass(pool *jvmConstantPool, name string) int {
		key := "C"+name
		if found := jvmPoolFind(pool, key); found != 0 {
			return found
		}
		entry := []byte{7}
		entry = jvmBE16(entry, jvmPoolUTF8(pool, name))
		return jvmPoolAdd(pool, key, entry)
	}

	func jvmPoolString(pool *jvmConstantPool, value string) int {
		key := "S"+value
		if found := jvmPoolFind(pool, key); found != 0 {
			return found
		}
		entry := []byte{8}
		entry = jvmBE16(entry, jvmPoolUTF8(pool, value))
		return jvmPoolAdd(pool, key, entry)
	}

	func jvmPoolByteString(pool *jvmConstantPool, value []byte) int {
		raw := string(value)
		key := "B"+raw
		if found := jvmPoolFind(pool, key); found != 0 {
			return found
		}
		utfKey := "b"+raw
		utfIndex := jvmPoolFind(pool, utfKey)
		if utfIndex == 0 {
			encoded := make([]byte, 0, len(value)*2)
			for i := 0; i < len(value); i++ {
				ch := int(value[i])
				if ch == 0 {
					encoded = append(encoded, 0xc0, 0x80)
				} else if ch < 0x80 {
					encoded = append(encoded, byte(ch))
				} else {
					encoded = append(encoded, byte(0xc0|(ch>>6)), byte(0x80|(ch&63)))
				}
			}
			entry := []byte{1}
			entry = jvmBE16(entry, len(encoded))
			entry = append(entry, encoded...)
			utfIndex = jvmPoolAdd(pool, utfKey, entry)
		}
		entry := []byte{8}
		entry = jvmBE16(entry, utfIndex)
		return jvmPoolAdd(pool, key, entry)
	}

	func jvmPoolInteger(pool *jvmConstantPool, value int) int {
		key := "I"+jvmDecimalText(value)
		if found := jvmPoolFind(pool, key); found != 0 {
			return found
		}
		entry := []byte{3}
		entry = jvmBE32(entry, value)
		return jvmPoolAdd(pool, key, entry)
	}

	func jvmPoolNameType(
		pool *jvmConstantPool, name string, descriptor string,
	) int {
		key := "N"+name+":"+descriptor
		if found := jvmPoolFind(pool, key); found != 0 {
			return found
		}
		entry := []byte{12}
		entry = jvmBE16(entry, jvmPoolUTF8(pool, name))
		entry = jvmBE16(entry, jvmPoolUTF8(pool, descriptor))
		return jvmPoolAdd(pool, key, entry)
	}

	func jvmPoolMember(
		pool *jvmConstantPool, tag byte, owner string,
		name string, descriptor string,
	) int {
		key := string([]byte{tag})+owner+"."+name+descriptor
		if found := jvmPoolFind(pool, key); found != 0 {
			return found
		}
		entry := []byte{tag}
		entry = jvmBE16(entry, jvmPoolClass(pool, owner))
		entry = jvmBE16(entry, jvmPoolNameType(pool, name, descriptor))
		return jvmPoolAdd(pool, key, entry)
	}

	func jvmPoolField(
		pool *jvmConstantPool, owner string, name string, descriptor string,
	) int {
		return jvmPoolMember(pool, 9, owner, name, descriptor)
	}

	func jvmPoolMethod(
		pool *jvmConstantPool, owner string, name string, descriptor string,
	) int {
		return jvmPoolMember(pool, 10, owner, name, descriptor)
	}

	func jvmPoolInterfaceMethod(
		pool *jvmConstantPool, owner string, name string, descriptor string,
	) int {
		return jvmPoolMember(pool, 11, owner, name, descriptor)
	}

	func jvmDecimalText(value int) string {
		if value == 0 {
			return "0"
		}
		negative := value < 0
		if negative {
			value = -value
		}
		var digits []byte
		for value > 0 {
			digits = append(digits, byte('0'+value%10))
			value /= 10
		}
		var result []byte
		if negative {
			result = append(result, '-')
		}
		for i := len(digits)-1; i >= 0; i-- {
			result = append(result, digits[i])
		}
		return string(result)
	}

	func androidBE16(data []byte, at int) int {
		return int(data[at])<<8 | int(data[at+1])
	}

	func androidBE32(data []byte, at int) int {
		return int(data[at])<<24 | int(data[at+1])<<16 |
			int(data[at+2])<<8 | int(data[at+3])
	}

	func androidPoolEntry(pool *jvmConstantPool, index int) []byte {
		if index <= 0 || index > len(pool.entries) { return nil }
		return pool.entries[index-1]
	}

	func androidPoolUTF8(pool *jvmConstantPool, index int) string {
		entry := androidPoolEntry(pool, index)
		if len(entry) < 3 || entry[0] != 1 { return "" }
		length := androidBE16(entry, 1)
		if 3+length > len(entry) { return "" }
		var result []byte
		for at := 3; at < 3+length; {
			first := int(entry[at])
			at++
			if first < 0x80 {
				result = append(result, byte(first))
			} else if first < 0xe0 && at < 3+length {
				second := int(entry[at]); at++
				value := (first&31)<<6 | (second&63)
				if value == 0 { result = append(result, 0) } else if value < 0x80 {
					result = append(result, byte(value))
				} else {
					result = append(result, byte(0xc0|(value>>6)), byte(0x80|(value&63)))
				}
			} else if at+1 < 3+length {
				second := int(entry[at]); third := int(entry[at+1]); at += 2
				value := (first&15)<<12 | (second&63)<<6 | (third&63)
				result = append(result, byte(0xe0|(value>>12)),
					byte(0x80|((value>>6)&63)), byte(0x80|(value&63)))
			}
		}
		return string(result)
	}

	func androidPoolClass(pool *jvmConstantPool, index int) string {
		entry := androidPoolEntry(pool, index)
		if len(entry) != 3 || entry[0] != 7 { return "" }
		return androidPoolUTF8(pool, androidBE16(entry, 1))
	}

	func androidPoolString(pool *jvmConstantPool, index int) string {
		entry := androidPoolEntry(pool, index)
		if len(entry) != 3 || entry[0] != 8 { return "" }
		return androidPoolUTF8(pool, androidBE16(entry, 1))
	}

	func androidPoolMember(
		pool *jvmConstantPool, index int,
	) (string, string, string, int) {
		entry := androidPoolEntry(pool, index)
		if len(entry) != 5 || (entry[0] != 9 && entry[0] != 10 && entry[0] != 11) {
			return "", "", "", 0
		}
		owner := androidPoolClass(pool, androidBE16(entry, 1))
		nameType := androidPoolEntry(pool, androidBE16(entry, 3))
		if len(nameType) != 5 || nameType[0] != 12 { return "", "", "", 0 }
		name := androidPoolUTF8(pool, androidBE16(nameType, 1))
		descriptor := androidPoolUTF8(pool, androidBE16(nameType, 3))
		return owner, name, descriptor, int(entry[0])
	}

	func androidClassDescriptor(name string) string {
		if len(name) > 0 && name[0] == '[' { return name }
		return "L"+name+";"
	}

	func androidDescriptorType(
		descriptor string, at int, allowVoid bool,
	) (string, int, bool) {
		if at >= len(descriptor) { return "", at, false }
		start := at
		for at < len(descriptor) && descriptor[at] == '[' { at++ }
		if at >= len(descriptor) { return "", at, false }
		ch := descriptor[at]
		if ch == 'L' {
			for at < len(descriptor) && descriptor[at] != ';' { at++ }
			if at >= len(descriptor) { return "", at, false }
			at++
		} else if ch == 'V' {
			if at != start || !allowVoid { return "", at, false }
			at++
		} else if ch == 'B' || ch == 'C' || ch == 'D' || ch == 'F' ||
			ch == 'I' || ch == 'J' || ch == 'S' || ch == 'Z' {
			at++
		} else { return "", at, false }
		return descriptor[start:at], at, true
	}

	func androidMethodDescriptor(
		descriptor string,
	) ([]string, string, bool) {
		if len(descriptor) < 3 || descriptor[0] != '(' { return nil, "", false }
		at := 1
		var parameters []string
		for at < len(descriptor) && descriptor[at] != ')' {
			value, next, ok := androidDescriptorType(descriptor, at, false)
			if !ok { return nil, "", false }
			parameters = append(parameters, value); at = next
		}
		if at >= len(descriptor) || descriptor[at] != ')' { return nil, "", false }
		result, next, ok := androidDescriptorType(descriptor, at+1, true)
		return parameters, result, ok && next == len(descriptor)
	}

	func androidTypeWords(descriptor string) int {
		if descriptor == "V" { return 0 }
		if descriptor == "J" || descriptor == "D" { return 2 }
		return 1
	}

	func androidValueKind(descriptor string) int {
		if len(descriptor) == 0 { return 0 }
		if descriptor[0] == 'L' || descriptor[0] == '[' { return androidValueReference }
		if descriptor[0] == 'J' { return androidValueLong }
		if descriptor[0] == 'F' { return androidValueFloat }
		if descriptor[0] == 'D' { return androidValueDouble }
		if descriptor[0] == 'V' { return 0 }
		return androidValueInt
	}

	func androidKindWords(kind int) int {
		if kind == androidValueLong || kind == androidValueDouble { return 2 }
		return 1
	}

	func androidStackWords(stack []int) int {
		result := 0
		for i := 0; i < len(stack); i++ { result += androidKindWords(stack[i]) }
		return result
	}

	func androidSigned16(value int) int {
		if value&0x8000 != 0 { return value-0x10000 }
		return value
	}
	func androidSigned32(value int) int { if value&0x80000000!=0{return value-0x100000000};return value }

	func androidDecodeInstructions(code []byte) ([]jvmAndroidInstruction, bool) {
		var result []jvmAndroidInstruction
		for at := 0; at < len(code); {
			instruction := jvmAndroidInstruction{offset: at, opcode: int(code[at]), length: 1}
			op := instruction.opcode
			if op == 0xaa {
				cursor := at+1
				for cursor%4 != 0 { cursor++ }
				if cursor+12 > len(code) { return nil, false }
				defaultTarget := at+androidSigned32(androidBE32(code, cursor))
				low := androidSigned32(androidBE32(code, cursor+4)); high := androidSigned32(androidBE32(code, cursor+8))
				if high < low || high-low > 65535 || cursor+12+(high-low+1)*4 > len(code) { return nil, false }
				instruction.low = low
				instruction.targets = append(instruction.targets, defaultTarget)
				for i := 0; i <= high-low; i++ {
					instruction.targets = append(instruction.targets,
						at+androidSigned32(androidBE32(code, cursor+12+i*4)))
				}
				instruction.length = cursor+12+(high-low+1)*4-at
			} else {
				length := androidJVMLength(op)
				if length == 0 || at+length > len(code) { return nil, false }
				instruction.length = length
				if length == 2 { instruction.operand = int(code[at+1]) }
				if length >= 3 { instruction.operand = androidBE16(code, at+1) }
				if op == 0xb9 { instruction.operand2 = int(code[at+3]) }
				if op >= 0x99 && op <= 0xa6 {
					instruction.targets = append(instruction.targets,
						at+androidSigned16(instruction.operand))
				} else if op == 0xc6 || op == 0xc7 {
					instruction.targets = append(instruction.targets,
						at+androidSigned16(instruction.operand))
				} else if op == 0xc8 {
					instruction.targets = append(instruction.targets,
						at+androidSigned32(androidBE32(code, at+1)))
				}
			}
			result = append(result, instruction)
			at += instruction.length
		}
		return result, true
	}

	func androidJVMLength(op int) int {
		if (op >= 0x15 && op <= 0x19) || (op >= 0x36 && op <= 0x3a) ||
			op == 0x10 || op == 0x12 || op == 0xbc { return 2 }
		if op == 0x11 || op == 0x13 || op == 0x14 || (op >= 0x99 && op <= 0xa8) ||
			op == 0xb2 || op == 0xb3 || op == 0xb4 || op == 0xb5 ||
			op == 0xb6 || op == 0xb7 || op == 0xb8 || op == 0xbb ||
			op == 0xbd || op == 0xc0 || op == 0xc1 || op == 0xc6 || op == 0xc7 { return 3 }
		if op == 0xb9 { return 5 }
		if op == 0xc8 { return 5 }
		if op >= 0x00 && op <= 0x0f || op >= 0x1a && op <= 0x35 ||
			op >= 0x3b && op <= 0x83 || op >= 0x85 && op <= 0x98 ||
			op >= 0xac && op <= 0xb1 || op == 0xbe || op == 0xbf { return 1 }
		return 0
	}

	func androidInstructionIndex(instructions []jvmAndroidInstruction, offset int) int {
		for i := 0; i < len(instructions); i++ {
			if instructions[i].offset == offset { return i }
		}
		return -1
	}

	func androidCloneStack(stack []int) []int {
		result := make([]int, len(stack)); copy(result, stack); return result
	}

	func androidPush(stack []int, kind int) []int { return append(stack, kind) }

	func androidPop(stack []int) ([]int, bool) {
		if len(stack) == 0 { return stack, false }
		return stack[:len(stack)-1], true
	}

	func androidPopCount(stack []int, count int) ([]int, bool) {
		if count < 0 || count > len(stack) { return stack, false }
		return stack[:len(stack)-count], true
	}

	func androidSimulate(
		pool *jvmConstantPool, instruction jvmAndroidInstruction, stack []int,
	) ([]int, bool, bool) {
		op := instruction.opcode
		terminal := false
		if op == 0x01 { stack = androidPush(stack, androidValueReference)
		} else if op >= 0x02 && op <= 0x08 || op == 0x10 || op == 0x11 {
			stack = androidPush(stack, androidValueInt)
		} else if op == 0x09 || op == 0x0a { stack = androidPush(stack, androidValueLong)
		} else if op >= 0x0b && op <= 0x0d { stack = androidPush(stack, androidValueFloat)
		} else if op == 0x0e || op == 0x0f { stack = androidPush(stack, androidValueDouble)
		} else if op == 0x12 || op == 0x13 || op == 0x14 {
			entry := androidPoolEntry(pool, instruction.operand)
			if len(entry) == 0 { return stack, false, false }
			kind := androidValueInt
			if entry[0] == 4 { kind = androidValueFloat }
			if entry[0] == 5 { kind = androidValueLong }
			if entry[0] == 6 { kind = androidValueDouble }
			if entry[0] == 7 || entry[0] == 8 { kind = androidValueReference }
			stack = androidPush(stack, kind)
		} else if op == 0x15 || op >= 0x1a && op <= 0x1d { stack = androidPush(stack, androidValueInt)
		} else if op == 0x16 || op >= 0x1e && op <= 0x21 { stack = androidPush(stack, androidValueLong)
		} else if op == 0x17 || op >= 0x22 && op <= 0x25 { stack = androidPush(stack, androidValueFloat)
		} else if op == 0x18 || op >= 0x26 && op <= 0x29 { stack = androidPush(stack, androidValueDouble)
		} else if op == 0x19 || op >= 0x2a && op <= 0x2d { stack = androidPush(stack, androidValueReference)
		} else if op >= 0x2e && op <= 0x35 {
			var ok bool; stack, ok = androidPopCount(stack, 2); if !ok { return stack, false, false }
			kind := androidValueInt
			if op == 0x2f { kind = androidValueLong }; if op == 0x30 { kind = androidValueFloat }
			if op == 0x31 { kind = androidValueDouble }; if op == 0x32 { kind = androidValueReference }
			stack = androidPush(stack, kind)
		} else if op >= 0x36 && op <= 0x4e {
			var ok bool; stack, ok = androidPop(stack); if !ok { return stack, false, false }
		} else if op >= 0x4f && op <= 0x56 {
			var ok bool; stack, ok = androidPopCount(stack, 3); if !ok { return stack, false, false }
		} else if op == 0x57 {
			var ok bool; stack, ok = androidPop(stack); if !ok { return stack, false, false }
		} else if op == 0x58 {
			if len(stack) == 0 { return stack, false, false }
			if androidKindWords(stack[len(stack)-1]) == 2 { stack = stack[:len(stack)-1]
			} else { var ok bool; stack, ok = androidPopCount(stack, 2); if !ok { return stack, false, false } }
		} else if op == 0x59 {
			if len(stack) == 0 || androidKindWords(stack[len(stack)-1]) != 1 { return stack, false, false }
			stack = append(stack, stack[len(stack)-1])
		} else if op == 0x5c {
			if len(stack) == 0 { return stack, false, false }
			top := stack[len(stack)-1]
			if androidKindWords(top) == 2 { stack = append(stack, top)
			} else if len(stack) >= 2 && androidKindWords(stack[len(stack)-2]) == 1 {
				stack = append(stack, stack[len(stack)-2], top)
			} else { return stack, false, false }
		} else if op >= 0x74 && op <= 0x77 {
			var ok bool; stack, ok = androidPop(stack); if !ok { return stack, false, false }
			kind:=androidValueInt;if op==0x75{kind=androidValueLong};if op==0x76{kind=androidValueFloat};if op==0x77{kind=androidValueDouble};stack=androidPush(stack,kind)
		} else if op >= 0x60 && op <= 0x83 {
			var ok bool; stack, ok = androidPopCount(stack, 2); if !ok { return stack, false, false }
			kind := androidValueInt
			if op == 0x61 || op == 0x65 || op == 0x69 || op == 0x6d || op == 0x71 ||
				op == 0x79 || op == 0x7b || op == 0x7d || op == 0x7f || op == 0x81 || op == 0x83 { kind = androidValueLong }
			if op == 0x62 || op == 0x66 || op == 0x6a || op == 0x6e || op == 0x72 { kind = androidValueFloat }
			if op == 0x63 || op == 0x67 || op == 0x6b || op == 0x6f || op == 0x73 { kind = androidValueDouble }
			stack = androidPush(stack, kind)
		} else if op >= 0x85 && op <= 0x93 {
			var ok bool; stack, ok = androidPop(stack); if !ok { return stack, false, false }
			kind := androidValueInt
			if op == 0x85 || op == 0x8c || op == 0x8f { kind = androidValueLong }
			if op == 0x86 || op == 0x89 || op == 0x90 { kind = androidValueFloat }
			if op == 0x87 || op == 0x8a || op == 0x8d { kind = androidValueDouble }
			stack = androidPush(stack, kind)
		} else if op >= 0x94 && op <= 0x98 {
			var ok bool; stack, ok = androidPopCount(stack, 2); if !ok { return stack, false, false }
			stack = androidPush(stack, androidValueInt)
		} else if op >= 0x99 && op <= 0x9e || op == 0xc6 || op == 0xc7 {
			var ok bool; stack, ok = androidPop(stack); if !ok { return stack, false, false }
		} else if op >= 0x9f && op <= 0xa6 {
			var ok bool; stack, ok = androidPopCount(stack, 2); if !ok { return stack, false, false }
		} else if op == 0xaa {
			var ok bool; stack, ok = androidPop(stack); if !ok { return stack, false, false }; terminal = true
		} else if op == 0xc8 { terminal = true
		} else if op >= 0xac && op <= 0xb0 {
			var ok bool; stack, ok = androidPop(stack); if !ok { return stack, false, false }; terminal = true
		} else if op == 0xb1 { terminal = true
		} else if op == 0xb2 || op == 0xb3 {
			_, _, descriptor, _ := androidPoolMember(pool, instruction.operand)
			if descriptor == "" { return stack, false, false }
			if op == 0xb2 { stack = androidPush(stack, androidValueKind(descriptor))
			} else { var ok bool; stack, ok = androidPop(stack); if !ok { return stack, false, false } }
		} else if op >= 0xb6 && op <= 0xb9 {
			_, _, descriptor, _ := androidPoolMember(pool, instruction.operand)
			parameters, result, ok := androidMethodDescriptor(descriptor); if !ok { return stack, false, false }
			pop := len(parameters); if op != 0xb8 { pop++ }
			stack, ok = androidPopCount(stack, pop); if !ok { return stack, false, false }
			kind := androidValueKind(result); if kind != 0 { stack = androidPush(stack, kind) }
		} else if op == 0xbb { stack = androidPush(stack, androidValueReference)
		} else if op == 0xbc || op == 0xbd {
			var ok bool; stack, ok = androidPop(stack); if !ok { return stack, false, false }
			stack = androidPush(stack, androidValueReference)
		} else if op == 0xbe {
			var ok bool; stack, ok = androidPop(stack); if !ok { return stack, false, false }
			stack = androidPush(stack, androidValueInt)
		} else if op == 0xbf {
			var ok bool; stack, ok = androidPop(stack); if !ok { return stack, false, false }; terminal = true
		} else if op == 0xc0 {
		} else if op == 0xc1 {
			var ok bool; stack, ok = androidPop(stack); if !ok { return stack, false, false }
			stack = androidPush(stack, androidValueInt)
		} else { return stack, false, false }
		return stack, true, terminal
	}

	func androidFrames(
		pool *jvmConstantPool, method jvmMethod, instructions []jvmAndroidInstruction,
	) ([]jvmAndroidFrame, bool) {
		frames := make([]jvmAndroidFrame, len(instructions))
		if len(instructions) == 0 { return frames, false }
		frames[0] = jvmAndroidFrame{valid: true}
		var queue []int; queue = append(queue, 0)
		for i := 0; i < len(method.exceptionHandler); i++ {
			index := androidInstructionIndex(instructions, method.exceptionHandler[i])
			if index < 0 { return frames, false }
			frames[index] = jvmAndroidFrame{valid: true, stack: []int{androidValueReference}}
			queue = append(queue, index)
		}
		for len(queue) > 0 {
			index := queue[0]; queue = queue[1:]
			instruction := instructions[index]
			stack, ok, terminal := androidSimulate(pool, instruction,
				androidCloneStack(frames[index].stack))
			if !ok || androidStackWords(stack) > method.maxStack { return frames, false }
			var successors []int
			for _, target := range instruction.targets {
				targetIndex := androidInstructionIndex(instructions, target)
				if targetIndex < 0 { return frames, false }
				successors = append(successors, targetIndex)
			}
			conditional := instruction.opcode >= 0x99 && instruction.opcode <= 0xa6 ||
				instruction.opcode == 0xc6 || instruction.opcode == 0xc7
			if !terminal && (len(instruction.targets) == 0 || conditional) && index+1 < len(instructions) {
				successors = append(successors, index+1)
			}
			for _, successor := range successors {
				if !frames[successor].valid {
					frames[successor] = jvmAndroidFrame{valid: true, stack: androidCloneStack(stack)}
					queue = append(queue, successor)
				} else {
					other := frames[successor].stack
					if len(other) != len(stack) { return frames, false }
					for i := 0; i < len(stack); i++ {
						if other[i] != stack[i] && !(other[i] == androidValueReference && stack[i] == androidValueReference) { return frames, false }
					}
				}
			}
		}
		return frames, true
	}

	func androidStringIndex(values []string, value string) int {
		for i := 0; i < len(values); i++ { if values[i] == value { return i } }
		return -1
	}

	func androidStringLess(left string, right string) bool {
		limit := len(left); if len(right) < limit { limit = len(right) }
		for i := 0; i < limit; i++ {
			if left[i] != right[i] { return left[i] < right[i] }
		}
		return len(left) < len(right)
	}

	func androidDexAddString(pool *jvmAndroidDexPool, value string) {
		if androidStringIndex(pool.strings, value) < 0 { pool.strings = append(pool.strings, value) }
	}

	func androidDexAddType(pool *jvmAndroidDexPool, descriptor string) {
		if androidStringIndex(pool.types, descriptor) < 0 { pool.types = append(pool.types, descriptor) }
		androidDexAddString(pool, descriptor)
	}

	func androidShorty(descriptor string) string {
		if len(descriptor) > 0 && (descriptor[0] == 'L' || descriptor[0] == '[') { return "L" }
		if len(descriptor) == 0 { return "" }
		return descriptor[:1]
	}

	func androidDexAddProto(pool *jvmAndroidDexPool, descriptor string) bool {
		for i := 0; i < len(pool.protos); i++ { if pool.protos[i].descriptor == descriptor { return true } }
		parameters, result, ok := androidMethodDescriptor(descriptor); if !ok { return false }
		shorty := androidShorty(result)
		androidDexAddType(pool, result)
		for _, parameter := range parameters { androidDexAddType(pool, parameter); shorty += androidShorty(parameter) }
		androidDexAddString(pool, shorty)
		pool.protos = append(pool.protos, jvmAndroidDexProto{descriptor: descriptor,
			result: result, parameters: parameters, shorty: shorty})
		return true
	}

	func androidFieldEqual(a jvmAndroidDexFieldRef, b jvmAndroidDexFieldRef) bool {
		return a.owner == b.owner && a.name == b.name && a.descriptor == b.descriptor
	}

	func androidMethodEqual(a jvmAndroidDexMethodRef, b jvmAndroidDexMethodRef) bool {
		return a.owner == b.owner && a.name == b.name && a.descriptor == b.descriptor
	}

	func androidDexAddField(pool *jvmAndroidDexPool, ref jvmAndroidDexFieldRef) {
		for i := 0; i < len(pool.fields); i++ { if androidFieldEqual(pool.fields[i], ref) { return } }
		pool.fields = append(pool.fields, ref); androidDexAddType(pool, ref.owner)
		androidDexAddType(pool, ref.descriptor); androidDexAddString(pool, ref.name)
	}

	func androidDexAddMethod(pool *jvmAndroidDexPool, ref jvmAndroidDexMethodRef) bool {
		found := false
