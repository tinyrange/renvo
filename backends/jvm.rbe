		superOnCreate:=jvmAndroidDexMethodRef{owner:super,name:"onCreate",descriptor:"(Landroid/os/Bundle;)V"}
		runRef:=jvmAndroidDexMethodRef{owner:"LRenvoProgram;",name:"run",descriptor:"([Ljava/lang/String;)I"}
		onCreate:=jvmDexCode{registers:2,ins:2,outs:2}
		androidDexWord(&onCreate,0x275);androidDexReferenceAt(&onCreate,4,"",jvmAndroidDexFieldRef{},superOnCreate);androidDexWord(&onCreate,0)
		androidDexWord(&onCreate,0x12)
		androidDexWord(&onCreate,0x23);androidDexReferenceAt(&onCreate,2,"[Ljava/lang/String;",jvmAndroidDexFieldRef{},jvmAndroidDexMethodRef{})
		androidDexWord(&onCreate,0x177);androidDexReferenceAt(&onCreate,4,"",jvmAndroidDexFieldRef{},runRef);androidDexWord(&onCreate,0)
		androidDexWord(&onCreate,0x0a);androidDexWord(&onCreate,0x0e)
		return jvmAndroidDexClass{descriptor:activity,super:super,access:1,methods:[]jvmAndroidDexMethod{
			{ref:constructorRef,access:0x10001,code:constructor,hasCode:true},
			{ref:onCreateRef,access:4,code:onCreate,hasCode:true},
		}}
	}

	func androidCollectPool(classes []jvmAndroidDexClass) (pool jvmAndroidDexPool, valid bool) {
		for ci:=0;ci<len(classes);ci++ { class:=classes[ci];androidDexAddType(&pool,class.descriptor);androidDexAddType(&pool,class.super)
			for _,iface:=range class.interfaces{androidDexAddType(&pool,iface)}
			for _,field:=range class.fields{androidDexAddField(&pool,field.ref)}
			for _,method:=range class.methods{if !androidDexAddMethod(&pool,method.ref){return pool,false};if method.hasCode{for _,reference:=range method.code.references{if reference.kind==1{androidDexAddString(&pool,reference.text)}else if reference.kind==2{androidDexAddType(&pool,reference.text)}else if reference.kind==3{androidDexAddField(&pool,reference.field)}else if reference.kind==4{if !androidDexAddMethod(&pool,reference.method){return pool,false}}};for _,try:=range method.code.tries{for _,handler:=range try.handlers{if handler.descriptor!=""{androidDexAddType(&pool,handler.descriptor)}}}}}
		}
		androidDexFinalize(&pool)
		return pool,len(pool.types)<=65535&&len(pool.protos)<=65535&&len(pool.fields)<=65535&&len(pool.methods)<=65535
	}

	func androidResolveCode(code *jvmDexCode,pool *jvmAndroidDexPool) bool {
		for _,reference:=range code.references { index:=-1;if reference.kind==1{index=androidStringIndex(pool.strings,reference.text)}else if reference.kind==2{index=androidDexTypeIndex(pool,reference.text)}else if reference.kind==3{index=androidDexFieldIndex(pool,reference.field)}else if reference.kind==4{index=androidDexMethodIndex(pool,reference.method)};if index<0||reference.at<0||reference.at>=len(code.words){return false};code.words[reference.at]=index&65535;if reference.kind==1{if reference.at+1>=len(code.words){return false};code.words[reference.at+1]=(index>>16)&65535}else if index>65535{return false}}
		for _,branch:=range code.branches { target:=androidDexOffset(code,branch.targetJVM);if target<0{return false};delta:=target-branch.base;if branch.width==2{if delta < -32768||delta>32767{return false};code.words[branch.at]=delta&65535}else{code.words[branch.at]=delta&65535;code.words[branch.at+1]=(delta>>16)&65535} }
		for _,switchPatch:=range code.switches { for i,targetJVM:=range switchPatch.targets{target:=androidDexOffset(code,targetJVM);if target<0{return false};delta:=target-switchPatch.base;code.words[switchPatch.at+i*2]=delta&65535;code.words[switchPatch.at+i*2+1]=(delta>>16)&65535} }
		return true
	}

	func androidLE16(out []byte,value int) []byte{return append(out,byte(value),byte(value>>8))}
	func androidLE32(out []byte,value int) []byte{return append(out,byte(value),byte(value>>8),byte(value>>16),byte(value>>24))}
	func androidPut16(out []byte,at int,value int){out[at]=byte(value);out[at+1]=byte(value>>8)}
	func androidPut32(out []byte,at int,value int){out[at]=byte(value);out[at+1]=byte(value>>8);out[at+2]=byte(value>>16);out[at+3]=byte(value>>24)}
	func androidAlign4(value int)int{return (value+3)&^3}
	func androidPad4(out []byte)[]byte{for len(out)%4!=0{out=append(out,0)};return out}
	func androidULEB(out []byte,value int)[]byte{for{next:=value>>7;digit:=byte(value&127);if next!=0{digit|=128};out=append(out,digit);value=next;if value==0{return out}}}
	func androidSLEB(out []byte,value int)[]byte{for{digit:=byte(value&127);value>>=7;done:=(value==0&&digit&64==0)||(value==-1&&digit&64!=0);if !done{digit|=128};out=append(out,digit);if done{return out}}}

	func androidUTF16Length(value string)int{count:=0;for i:=0;i<len(value);i++{if value[i]&0xc0!=0x80{count++}};return count}
	func androidModifiedUTF8(value string)[]byte{var out []byte;for i:=0;i<len(value);i++{if value[i]==0{out=append(out,0xc0,0x80)}else{out=append(out,value[i])}};return out}

	func androidTypeListEqual(a []string,b []string)bool{if len(a)!=len(b){return false};for i:=0;i<len(a);i++{if a[i]!=b[i]{return false}};return true}
	func androidCloneStrings(values []string)[]string{result:=make([]string,len(values));copy(result,values);return result}
	func androidTypeListFind(lists []jvmAndroidDexTypeList,values []string)int{for i:=0;i<len(lists);i++{if androidTypeListEqual(lists[i].values,values){return i}};return -1}
	func androidTypeListOffset(lists []jvmAndroidDexTypeList,values []string)int{if len(values)==0{return 0};index:=androidTypeListFind(lists,values);if index<0{return 0};return lists[index].offset}

	func androidCodeOffset(values []jvmAndroidDexCodeOffset,ref jvmAndroidDexMethodRef)int{for _,value:=range values{if androidMethodEqual(value.ref,ref){return value.offset}};return 0}
	func androidClassOffset(values []jvmAndroidDexClassOffset,descriptor string)int{for _,value:=range values{if value.descriptor==descriptor{return value.offset}};return 0}

	func androidSortFields(fields []jvmAndroidDexField,pool *jvmAndroidDexPool){for i:=1;i<len(fields);i++{value:=fields[i];at:=i;for at>0&&androidDexFieldIndex(pool,value.ref)<androidDexFieldIndex(pool,fields[at-1].ref){fields[at]=fields[at-1];at--};fields[at]=value}}
	func androidSortMethods(methods []jvmAndroidDexMethod,pool *jvmAndroidDexPool){for i:=1;i<len(methods);i++{value:=methods[i];at:=i;for at>0&&androidDexMethodIndex(pool,value.ref)<androidDexMethodIndex(pool,methods[at-1].ref){methods[at]=methods[at-1];at--};methods[at]=value}}

	func androidEncodeClassData(class jvmAndroidDexClass,pool *jvmAndroidDexPool,offsets []jvmAndroidDexCodeOffset)[]byte{
		var staticFields,instanceFields []jvmAndroidDexField;for _,field:=range class.fields{if field.access&8!=0{staticFields=append(staticFields,field)}else{instanceFields=append(instanceFields,field)}}
		var direct,virtual []jvmAndroidDexMethod;for _,method:=range class.methods{if method.access&8!=0||method.access&2!=0||method.ref.name=="<init>"||method.ref.name=="<clinit>"{direct=append(direct,method)}else{virtual=append(virtual,method)}}
		androidSortFields(staticFields,pool);androidSortFields(instanceFields,pool);androidSortMethods(direct,pool);androidSortMethods(virtual,pool)
		var out []byte;out=androidULEB(out,len(staticFields));out=androidULEB(out,len(instanceFields));out=androidULEB(out,len(direct));out=androidULEB(out,len(virtual))
		last:=0;for _,field:=range staticFields{index:=androidDexFieldIndex(pool,field.ref);out=androidULEB(out,index-last);out=androidULEB(out,field.access);last=index}
		last=0;for _,field:=range instanceFields{index:=androidDexFieldIndex(pool,field.ref);out=androidULEB(out,index-last);out=androidULEB(out,field.access);last=index}
		last=0;for _,method:=range direct{index:=androidDexMethodIndex(pool,method.ref);out=androidULEB(out,index-last);out=androidULEB(out,method.access);out=androidULEB(out,androidCodeOffset(offsets,method.ref));last=index}
		last=0;for _,method:=range virtual{index:=androidDexMethodIndex(pool,method.ref);out=androidULEB(out,index-last);out=androidULEB(out,method.access);out=androidULEB(out,androidCodeOffset(offsets,method.ref));last=index}
		return out
	}

	func androidCatchKey(handlers []jvmAndroidDexCatch)string{var result []byte;for _,handler:=range handlers{result=append(result,handler.descriptor...);result=append(result,0);result=androidLE32(result,handler.target)};return string(result)}
	func androidEncodeCode(code jvmDexCode,pool *jvmAndroidDexPool)([]byte,bool){
		var out []byte;out=androidLE16(out,code.registers);out=androidLE16(out,code.ins);out=androidLE16(out,code.outs);out=androidLE16(out,len(code.tries));out=androidLE32(out,0);out=androidLE32(out,len(code.words));for _,word:=range code.words{out=androidLE16(out,word)}
		if len(code.tries)==0{return out,true};if len(code.words)%2!=0{out=androidLE16(out,0)}
		prefix:=androidULEB(nil,len(code.tries));handlerOffsets:=make([]int,len(code.tries));var handlerData []byte
		for i,try:=range code.tries{handlerOffsets[i]=len(prefix)+len(handlerData);typed:=len(try.handlers);catchAll:=typed>0&&try.handlers[typed-1].descriptor=="";if catchAll{typed--;handlerData=androidSLEB(handlerData,-typed)}else{handlerData=androidSLEB(handlerData,typed)};for h:=0;h<typed;h++{index:=androidDexTypeIndex(pool,try.handlers[h].descriptor);if index<0{return nil,false};handlerData=androidULEB(handlerData,index);handlerData=androidULEB(handlerData,try.handlers[h].target)};if catchAll{handlerData=androidULEB(handlerData,try.handlers[len(try.handlers)-1].target)}}
		for i,try:=range code.tries{if try.start<0||try.end<=try.start||try.end-try.start>65535||handlerOffsets[i]>65535{return nil,false};out=androidLE32(out,try.start);out=androidLE16(out,try.end-try.start);out=androidLE16(out,handlerOffsets[i])}
		out=append(out,prefix...);out=append(out,handlerData...);return out,true
	}

	func androidSHA1(data []byte)[]byte{
		message:=make([]byte,len(data));copy(message,data);bitLength:=uint64(len(message))*8;message=append(message,0x80);for len(message)%64!=56{message=append(message,0)};for shift:=56;shift>=0;shift-=8{message=append(message,byte(bitLength>>uint(shift)))}
		h0:=uint32(0x67452301);h1:=uint32(0xefcdab89);h2:=uint32(0x98badcfe);h3:=uint32(0x10325476);h4:=uint32(0xc3d2e1f0)
		for block:=0;block<len(message);block+=64{var words [80]uint32;for i:=0;i<16;i++{at:=block+i*4;words[i]=uint32(message[at])<<24|uint32(message[at+1])<<16|uint32(message[at+2])<<8|uint32(message[at+3])};for i:=16;i<80;i++{value:=words[i-3]^words[i-8]^words[i-14]^words[i-16];words[i]=value<<1|value>>31};a,b,c,d,e:=h0,h1,h2,h3,h4;for i:=0;i<80;i++{var f,k uint32;if i<20{f=(b&c)|(^b&d);k=0x5a827999}else if i<40{f=b^c^d;k=0x6ed9eba1}else if i<60{f=(b&c)|(b&d)|(c&d);k=0x8f1bbcdc}else{f=b^c^d;k=0xca62c1d6};temp:=(a<<5|a>>27)+f+e+k+words[i];e=d;d=c;c=b<<30|b>>2;b=a;a=temp};h0+=a;h1+=b;h2+=c;h3+=d;h4+=e}
		var out []byte;for _,value:=range []uint32{h0,h1,h2,h3,h4}{out=append(out,byte(value>>24),byte(value>>16),byte(value>>8),byte(value))};return out
	}
	func androidAdler32(data []byte)int{a:=1;b:=0;for i,value:=range data{_ = i;a=(a+int(value))%65521;b=(b+a)%65521};return b<<16|a}

	func androidEncodeDex(classes []jvmAndroidDexClass)([]byte,bool){
		pool,ok:=androidCollectPool(classes);if !ok{return nil,false}
		for i:=1;i<len(classes);i++{value:=classes[i];at:=i;for at>0&&androidDexTypeIndex(&pool,value.descriptor)<androidDexTypeIndex(&pool,classes[at-1].descriptor){classes[at]=classes[at-1];at--};classes[at]=value}
		stringIDs:=0x70;typeIDs:=stringIDs+len(pool.strings)*4;protoIDs:=typeIDs+len(pool.types)*4;fieldIDs:=protoIDs+len(pool.protos)*12;methodIDs:=fieldIDs+len(pool.fields)*8;classDefs:=methodIDs+len(pool.methods)*8;dataOffset:=androidAlign4(classDefs+len(classes)*32);out:=make([]byte,dataOffset);copy(out,[]byte{'d','e','x','\n','0','3','5',0});androidPut32(out,36,0x70);androidPut32(out,40,0x12345678);androidPut32(out,56,len(pool.strings));if len(pool.strings)>0{androidPut32(out,60,stringIDs)};androidPut32(out,64,len(pool.types));if len(pool.types)>0{androidPut32(out,68,typeIDs)};androidPut32(out,72,len(pool.protos));if len(pool.protos)>0{androidPut32(out,76,protoIDs)};androidPut32(out,80,len(pool.fields));if len(pool.fields)>0{androidPut32(out,84,fieldIDs)};androidPut32(out,88,len(pool.methods));if len(pool.methods)>0{androidPut32(out,92,methodIDs)};androidPut32(out,96,len(classes));if len(classes)>0{androidPut32(out,100,classDefs)}
		for i,descriptor:=range pool.types{androidPut32(out,typeIDs+i*4,androidStringIndex(pool.strings,descriptor))}
		for i,field:=range pool.fields{at:=fieldIDs+i*8;androidPut16(out,at,androidDexTypeIndex(&pool,field.owner));androidPut16(out,at+2,androidDexTypeIndex(&pool,field.descriptor));androidPut32(out,at+4,androidStringIndex(pool.strings,field.name))}
		for i,method:=range pool.methods{at:=methodIDs+i*8;androidPut16(out,at,androidDexTypeIndex(&pool,method.owner));androidPut16(out,at+2,androidDexProtoIndex(&pool,method.descriptor));androidPut32(out,at+4,androidStringIndex(pool.strings,method.name))}
		var lists []jvmAndroidDexTypeList;for _,proto:=range pool.protos{if len(proto.parameters)>0&&androidTypeListFind(lists,proto.parameters)<0{copyValues:=androidCloneStrings(proto.parameters);lists=append(lists,jvmAndroidDexTypeList{values:copyValues})}};for _,class:=range classes{if len(class.interfaces)>0&&androidTypeListFind(lists,class.interfaces)<0{copyValues:=androidCloneStrings(class.interfaces);lists=append(lists,jvmAndroidDexTypeList{values:copyValues})}}
		typeListStart:=0;for i:=0;i<len(lists);i++{out=androidPad4(out);if typeListStart==0{typeListStart=len(out)};lists[i].offset=len(out);out=androidLE32(out,len(lists[i].values));for _,value:=range lists[i].values{out=androidLE16(out,androidDexTypeIndex(&pool,value))}}
		for i,proto:=range pool.protos{at:=protoIDs+i*12;androidPut32(out,at,androidStringIndex(pool.strings,proto.shorty));androidPut32(out,at+4,androidDexTypeIndex(&pool,proto.result));androidPut32(out,at+8,androidTypeListOffset(lists,proto.parameters))}
		stringDataStart:=len(out);for i,value:=range pool.strings{androidPut32(out,stringIDs+i*4,len(out));out=androidULEB(out,androidUTF16Length(value));out=append(out,androidModifiedUTF8(value)...);out=append(out,0)}
		var codeOffsets []jvmAndroidDexCodeOffset;codeStart:=0;codeCount:=0;for ci:=0;ci<len(classes);ci++{androidSortMethods(classes[ci].methods,&pool);for mi:=0;mi<len(classes[ci].methods);mi++{method:=&classes[ci].methods[mi];if !method.hasCode{continue};if !androidResolveCode(&method.code,&pool){return nil,false};out=androidPad4(out);if codeStart==0{codeStart=len(out)};codeOffsets=append(codeOffsets,jvmAndroidDexCodeOffset{ref:method.ref,offset:len(out)});encoded,valid:=androidEncodeCode(method.code,&pool);if !valid{return nil,false};out=append(out,encoded...);codeCount++}}
		classDataStart:=len(out);var classOffsets []jvmAndroidDexClassOffset;for _,class:=range classes{classOffsets=append(classOffsets,jvmAndroidDexClassOffset{descriptor:class.descriptor,offset:len(out)});out=append(out,androidEncodeClassData(class,&pool,codeOffsets)...)}
		out=androidPad4(out);mapOffset:=len(out);var maps []jvmAndroidDexMapItem;maps=append(maps,jvmAndroidDexMapItem{kind:0,size:1,offset:0});if len(pool.strings)>0{maps=append(maps,jvmAndroidDexMapItem{kind:1,size:len(pool.strings),offset:stringIDs})};if len(pool.types)>0{maps=append(maps,jvmAndroidDexMapItem{kind:2,size:len(pool.types),offset:typeIDs})};if len(pool.protos)>0{maps=append(maps,jvmAndroidDexMapItem{kind:3,size:len(pool.protos),offset:protoIDs})};if len(pool.fields)>0{maps=append(maps,jvmAndroidDexMapItem{kind:4,size:len(pool.fields),offset:fieldIDs})};if len(pool.methods)>0{maps=append(maps,jvmAndroidDexMapItem{kind:5,size:len(pool.methods),offset:methodIDs})};if len(classes)>0{maps=append(maps,jvmAndroidDexMapItem{kind:6,size:len(classes),offset:classDefs})};if len(lists)>0{maps=append(maps,jvmAndroidDexMapItem{kind:0x1001,size:len(lists),offset:typeListStart})};if len(pool.strings)>0{maps=append(maps,jvmAndroidDexMapItem{kind:0x2002,size:len(pool.strings),offset:stringDataStart})};if codeCount>0{maps=append(maps,jvmAndroidDexMapItem{kind:0x2001,size:codeCount,offset:codeStart})};if len(classes)>0{maps=append(maps,jvmAndroidDexMapItem{kind:0x2000,size:len(classes),offset:classDataStart})};maps=append(maps,jvmAndroidDexMapItem{kind:0x1000,size:1,offset:mapOffset});for i:=1;i<len(maps);i++{value:=maps[i];at:=i;for at>0&&value.offset<maps[at-1].offset{maps[at]=maps[at-1];at--};maps[at]=value};out=androidLE32(out,len(maps));for _,item:=range maps{out=androidLE16(out,item.kind);out=androidLE16(out,0);out=androidLE32(out,item.size);out=androidLE32(out,item.offset)}
		for i,class:=range classes{at:=classDefs+i*32;androidPut32(out,at,androidDexTypeIndex(&pool,class.descriptor));androidPut32(out,at+4,class.access);androidPut32(out,at+8,androidDexTypeIndex(&pool,class.super));androidPut32(out,at+12,androidTypeListOffset(lists,class.interfaces));androidPut32(out,at+16,-1);androidPut32(out,at+24,androidClassOffset(classOffsets,class.descriptor))}
		androidPut32(out,32,len(out));androidPut32(out,52,mapOffset);androidPut32(out,104,len(out)-dataOffset);androidPut32(out,108,dataOffset);signature:=androidSHA1(out[32:]);copy(out[12:32],signature);androidPut32(out,8,androidAdler32(out[12:]));return out,true
	}

	func androidBuildDEX(model jvmClassModel) []byte {
		program,ok:=androidTranslateClass(model);if !ok{return nil}
		dex,ok:=androidEncodeDex([]jvmAndroidDexClass{program,androidActivityClass()});if !ok{return nil}
		return dex
	}

	func jvmAsmNewLabel(asm *jvmAssembler) int {
		asm.labels = append(asm.labels, -1)
		return len(asm.labels)-1
	}

	func jvmAsmMark(asm *jvmAssembler, label int) {
		asm.labels[label] = len(asm.code)
	}

	func jvmAsmU1(asm *jvmAssembler, value int) {
		asm.code = append(asm.code, byte(value))
	}

	func jvmAsmU2(asm *jvmAssembler, value int) {
		asm.code = jvmBE16(asm.code, value)
	}

	func jvmAsmBranch(asm *jvmAssembler, opcode int, label int) {
		base := len(asm.code)
		jvmAsmU1(asm, opcode)
		at := len(asm.code)
		jvmAsmU2(asm, 0)
		asm.fixAt = append(asm.fixAt, at)
		asm.fixBase = append(asm.fixBase, base)
		asm.fixLabel = append(asm.fixLabel, label)
		asm.fixWide = append(asm.fixWide, false)
	}

	func jvmAsmGoto(asm *jvmAssembler, label int) {
		base := len(asm.code)
		jvmAsmU1(asm, 0xc8)
		at := len(asm.code)
		asm.code = jvmBE32(asm.code, 0)
		asm.fixAt = append(asm.fixAt, at)
		asm.fixBase = append(asm.fixBase, base)
		asm.fixLabel = append(asm.fixLabel, label)
		asm.fixWide = append(asm.fixWide, true)
	}

	func jvmAsmPatch(asm *jvmAssembler) []byte {
		for i := 0; i < len(asm.fixAt); i++ {
			target := asm.labels[asm.fixLabel[i]]
			delta := target-asm.fixBase[i]
			at := asm.fixAt[i]
			if asm.fixWide[i] {
				asm.code[at] = byte(delta>>24)
				asm.code[at+1] = byte(delta>>16)
				asm.code[at+2] = byte(delta>>8)
				asm.code[at+3] = byte(delta)
			} else {
				asm.code[at] = byte(delta>>8)
				asm.code[at+1] = byte(delta)
			}
		}
		return asm.code
	}

	func jvmAsmLocal(asm *jvmAssembler, opcode int, local int) {
		if local >= 0 && local <= 3 &&
			(opcode == 0x15 || opcode == 0x36 || opcode == 0x19 || opcode == 0x3a) {
			base := 0x1a
			if opcode == 0x36 { base = 0x3b }
			if opcode == 0x19 { base = 0x2a }
			if opcode == 0x3a { base = 0x4b }
			jvmAsmU1(asm, base+local)
			return
		}
		jvmAsmU1(asm, opcode)
		jvmAsmU1(asm, local)
	}

	func jvmAsmInt(asm *jvmAssembler, pool *jvmConstantPool, value int) {
		if value >= -1 && value <= 5 {
			jvmAsmU1(asm, 3+value)
			return
		}
		if value >= -128 && value <= 127 {
			jvmAsmU1(asm, 0x10)
			jvmAsmU1(asm, value)
			return
		}
		if value >= -32768 && value <= 32767 {
			jvmAsmU1(asm, 0x11)
			jvmAsmU2(asm, value)
			return
		}
		index := jvmPoolInteger(pool, value)
		if index <= 255 {
			jvmAsmU1(asm, 0x12)
			jvmAsmU1(asm, index)
		} else {
			jvmAsmU1(asm, 0x13)
			jvmAsmU2(asm, index)
		}
	}

	func jvmAsmMember(asm *jvmAssembler, opcode int, index int) {
		jvmAsmU1(asm, opcode)
		jvmAsmU2(asm, index)
	}

	func jvmAsmTableSwitch(
		asm *jvmAssembler, low int, labels []int, defaultLabel int,
	) {
		base := len(asm.code)
		jvmAsmU1(asm, 0xaa)
		for len(asm.code)%4 != 0 {
			jvmAsmU1(asm, 0)
		}
		at := len(asm.code)
		asm.code = jvmBE32(asm.code, 0)
		asm.fixAt = append(asm.fixAt, at)
		asm.fixBase = append(asm.fixBase, base)
		asm.fixLabel = append(asm.fixLabel, defaultLabel)
		asm.fixWide = append(asm.fixWide, true)
		asm.code = jvmBE32(asm.code, low)
		asm.code = jvmBE32(asm.code, low+len(labels)-1)
		for i := 0; i < len(labels); i++ {
			at = len(asm.code)
			asm.code = jvmBE32(asm.code, 0)
			asm.fixAt = append(asm.fixAt, at)
			asm.fixBase = append(asm.fixBase, base)
			asm.fixLabel = append(asm.fixLabel, labels[i])
			asm.fixWide = append(asm.fixWide, true)
		}
	}

	func jvmAsmGetStatic(
		asm *jvmAssembler, pool *jvmConstantPool, name string, descriptor string,
	) {
