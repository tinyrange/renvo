		jvmAsmLocal(&asm, 0x15, 3)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "copyOut", "([BII)I")
		jvmAsmU1(&asm, 0xac)
		tryEnd := len(asm.code)
		handler := len(asm.code)
		jvmAsmU1(&asm, 0x57)
		jvmAsmU1(&asm, 0x02)
		jvmAsmU1(&asm, 0xac)
		method := jvmMethod{access: 0x000a, name: "reflectString", descriptor: "(IIII)I",
			maxStack: 7, maxLocals: 12, code: asm.code}
		method.exceptionStart = []int{tryStart}
		method.exceptionEnd = []int{tryEnd}
		method.exceptionHandler = []int{handler}
		method.exceptionClass = []int{0}
		return method
	}

	func jvmMakeHost(pool *jvmConstantPool) jvmMethod {
		var asm jvmAssembler
		property := jvmAsmNewLabel(&asm)
		reflectCall := jvmAsmNewLabel(&asm)
		floatBinary := jvmAsmNewLabel(&asm)
		floatCompare := jvmAsmNewLabel(&asm)
		floatConvert := jvmAsmNewLabel(&asm)
		intToFloat := jvmAsmNewLabel(&asm)
		floatToInt := jvmAsmNewLabel(&asm)
		floatNegate := jvmAsmNewLabel(&asm)
		failed := jvmAsmNewLabel(&asm)
		done := jvmAsmNewLabel(&asm)
		jvmAsmRLoadConst(&asm, pool, 0)
		jvmAsmInt(&asm, pool, 0x4a01)
		jvmAsmBranch(&asm, 0x9f, property)
		jvmAsmRLoadConst(&asm, pool, 0)
		jvmAsmInt(&asm, pool, 0x4a02)
		jvmAsmBranch(&asm, 0x9f, reflectCall)
		jvmAsmRLoadConst(&asm, pool, 0)
		jvmAsmInt(&asm, pool, 0x4b01)
		jvmAsmBranch(&asm, 0x9f, floatBinary)
		jvmAsmRLoadConst(&asm, pool, 0)
		jvmAsmInt(&asm, pool, 0x4b02)
		jvmAsmBranch(&asm, 0x9f, floatCompare)
		jvmAsmRLoadConst(&asm, pool, 0)
		jvmAsmInt(&asm, pool, 0x4b03)
		jvmAsmBranch(&asm, 0x9f, floatConvert)
		jvmAsmRLoadConst(&asm, pool, 0)
		jvmAsmInt(&asm, pool, 0x4b04)
		jvmAsmBranch(&asm, 0x9f, intToFloat)
		jvmAsmRLoadConst(&asm, pool, 0)
		jvmAsmInt(&asm, pool, 0x4b05)
		jvmAsmBranch(&asm, 0x9f, floatToInt)
		jvmAsmRLoadConst(&asm, pool, 0)
		jvmAsmInt(&asm, pool, 0x4b06)
		jvmAsmBranch(&asm, 0x9f, floatNegate)
		jvmAsmGoto(&asm, failed)
		jvmAsmMark(&asm, property)
		tryStart := len(asm.code)
		jvmAsmRStoreConstPrefix(&asm, pool, 0)
		jvmAsmRLoadConst(&asm, pool, 3)
		jvmAsmRLoadConst(&asm, pool, 4)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "stringAt", "(II)Ljava/lang/String;")
		jvmAsmInvokeStatic(&asm, pool, "java/lang/System", "getProperty",
			"(Ljava/lang/String;)Ljava/lang/String;")
		jvmAsmU1(&asm, 0x59)
		propertyPresent := jvmAsmNewLabel(&asm)
		jvmAsmBranch(&asm, 0xc7, propertyPresent)
		jvmAsmU1(&asm, 0x57)
		jvmAsmU1(&asm, 0x58)
		jvmAsmGoto(&asm, failed)
		jvmAsmMark(&asm, propertyPresent)
		jvmAsmLdcString(&asm, pool, "UTF-8")
		jvmAsmInvokeVirtual(&asm, pool, "java/lang/String", "getBytes",
			"(Ljava/lang/String;)[B")
		jvmAsmRLoadConst(&asm, pool, 1)
		jvmAsmRLoadConst(&asm, pool, 2)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "copyOut", "([BII)I")
		jvmAsmU1(&asm, 0x4f)
		jvmAsmGoto(&asm, done)
		tryEnd := len(asm.code)
		jvmAsmMark(&asm, reflectCall)
		jvmAsmRStoreConstPrefix(&asm, pool, 0)
		jvmAsmRLoadConst(&asm, pool, 3)
		jvmAsmRLoadConst(&asm, pool, 4)
		jvmAsmRLoadConst(&asm, pool, 1)
		jvmAsmRLoadConst(&asm, pool, 2)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "reflectString", "(IIII)I")
		jvmAsmU1(&asm, 0x4f)
		jvmAsmGoto(&asm, done)
		jvmAsmMark(&asm, floatBinary)
		jvmAsmRLoadConst(&asm, pool, 3)
		jvmAsmRLoadConst(&asm, pool, 4)
		jvmAsmRLoadConst(&asm, pool, 1)
		jvmAsmRLoadConst(&asm, pool, 2)
		jvmAsmRLoadConst(&asm, pool, 5)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "floatBinary", "(IIIII)V")
		jvmAsmRStoreConstPrefix(&asm, pool, 0)
		jvmAsmU1(&asm, 0x03)
		jvmAsmU1(&asm, 0x4f)
		jvmAsmGoto(&asm, done)
		jvmAsmMark(&asm, floatCompare)
		jvmAsmRStoreConstPrefix(&asm, pool, 0)
		jvmAsmRLoadConst(&asm, pool, 3)
		jvmAsmRLoadConst(&asm, pool, 4)
		jvmAsmRLoadConst(&asm, pool, 1)
		jvmAsmRLoadConst(&asm, pool, 2)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "floatCompare", "(IIII)I")
		jvmAsmU1(&asm, 0x4f)
		jvmAsmGoto(&asm, done)
		jvmAsmMark(&asm, floatConvert)
		jvmAsmRLoadConst(&asm, pool, 3)
		jvmAsmRLoadConst(&asm, pool, 4)
		jvmAsmRLoadConst(&asm, pool, 1)
		jvmAsmRLoadConst(&asm, pool, 2)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "floatConvert", "(IIII)V")
		jvmAsmGoto(&asm, done)
		jvmAsmMark(&asm, intToFloat)
		jvmAsmRLoadConst(&asm, pool, 3)
		jvmAsmRLoadConst(&asm, pool, 4)
		jvmAsmRLoadConst(&asm, pool, 1)
		jvmAsmRLoadConst(&asm, pool, 2)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "intToFloat", "(IIII)V")
		jvmAsmGoto(&asm, done)
		jvmAsmMark(&asm, floatToInt)
		jvmAsmRLoadConst(&asm, pool, 3)
		jvmAsmRLoadConst(&asm, pool, 4)
		jvmAsmRLoadConst(&asm, pool, 1)
		jvmAsmRLoadConst(&asm, pool, 2)
		jvmAsmRLoadConst(&asm, pool, 5)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "floatToInt", "(IIIII)V")
		jvmAsmGoto(&asm, done)
		jvmAsmMark(&asm, floatNegate)
		jvmAsmRLoadConst(&asm, pool, 3)
		jvmAsmRLoadConst(&asm, pool, 4)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "floatNegate", "(II)V")
		jvmAsmGoto(&asm, done)
		jvmAsmMark(&asm, failed)
		jvmAsmRStoreConstPrefix(&asm, pool, 0)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "syscall", "()I")
		jvmAsmU1(&asm, 0x4f)
		jvmAsmMark(&asm, done)
		jvmAsmU1(&asm, 0xb1)
		handler := len(asm.code)
		jvmAsmU1(&asm, 0x57)
		jvmAsmGoto(&asm, failed)
		method := jvmMethod{access: 0x000a, name: "host", descriptor: "()V",
			maxStack: 7, maxLocals: 0, code: jvmAsmPatch(&asm)}
		method.exceptionStart = []int{tryStart}
		method.exceptionEnd = []int{tryEnd}
		method.exceptionHandler = []int{handler}
		method.exceptionClass = []int{0}
		return method
	}

	func jvmRunNextLocal(
		asm *jvmAssembler, pool *jvmConstantPool, local int,
	) {
		jvmAsmInvokeStatic(asm, pool, "RenvoProgram", "u8", "()I")
		jvmAsmLocal(asm, 0x36, local)
	}

	func jvmRunI32Local(
		asm *jvmAssembler, pool *jvmConstantPool, local int,
	) {
		jvmAsmInvokeStatic(asm, pool, "RenvoProgram", "i32", "()I")
		jvmAsmLocal(asm, 0x36, local)
	}

	func jvmRunRLoadLocal(
		asm *jvmAssembler, pool *jvmConstantPool, local int,
	) {
		jvmAsmGetStatic(asm, pool, "R", "[I")
		jvmAsmLocal(asm, 0x15, local)
		jvmAsmU1(asm, 0x2e)
	}

	func jvmRunRStoreLocalPrefix(
		asm *jvmAssembler, pool *jvmConstantPool, local int,
	) {
		jvmAsmGetStatic(asm, pool, "R", "[I")
		jvmAsmLocal(asm, 0x15, local)
	}

	func jvmRunContinue(asm *jvmAssembler, loop int) {
		jvmAsmGoto(asm, loop)
	}

	func jvmMakeRun(pool *jvmConstantPool) jvmMethod {
		var asm jvmAssembler
		loop := jvmAsmNewLabel(&asm)
		invalid := jvmAsmNewLabel(&asm)
		labels := make([]int, 46)
		for i := 0; i < len(labels); i++ { labels[i] = jvmAsmNewLabel(&asm) }
		jvmAsmLocal(&asm, 0x19, 0)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "arguments",
			"([Ljava/lang/String;)[Ljava/lang/String;")
		jvmAsmPutStatic(&asm, pool, "A", "[Ljava/lang/String;")
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "environment",
			"()[Ljava/lang/String;")
		jvmAsmPutStatic(&asm, pool, "E", "[Ljava/lang/String;")
		jvmAsmMark(&asm, loop)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "u8", "()I")
		jvmAsmTableSwitch(&asm, 1, labels, invalid)

		// exit
		jvmAsmMark(&asm, labels[0])
		jvmAsmRLoadConst(&asm, pool, 0)
		jvmAsmInt(&asm, pool, 255)
		jvmAsmU1(&asm, 0x7e)
		jvmAsmU1(&asm, 0xac)

		// frame, move-immediate, move
		jvmAsmMark(&asm, labels[1])
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "i32", "()I")
		jvmAsmPutStatic(&asm, pool, "FS", "I")
		jvmRunContinue(&asm, loop)
		jvmAsmMark(&asm, labels[2])
		jvmRunNextLocal(&asm, pool, 1)
		jvmRunRStoreLocalPrefix(&asm, pool, 1)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "i32", "()I")
		jvmAsmU1(&asm, 0x4f)
		jvmRunContinue(&asm, loop)
		jvmAsmMark(&asm, labels[3])
		jvmRunNextLocal(&asm, pool, 1)
		jvmRunNextLocal(&asm, pool, 2)
		jvmRunRStoreLocalPrefix(&asm, pool, 1)
		jvmRunRLoadLocal(&asm, pool, 2)
		jvmAsmU1(&asm, 0x4f)
		jvmRunContinue(&asm, loop)

		// push register / immediate and pop register.
		for op := 5; op <= 6; op++ {
			jvmAsmMark(&asm, labels[op-1])
			jvmAsmGetStatic(&asm, pool, "SP", "I")
			jvmAsmInt(&asm, pool, 4)
			if op == 5 {
				jvmRunNextLocal(&asm, pool, 1)
				jvmRunRLoadLocal(&asm, pool, 1)
			} else {
				jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "i32", "()I")
			}
			jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "store", "(III)Z")
			jvmAsmU1(&asm, 0x57)
			jvmAsmGetStatic(&asm, pool, "SP", "I")
			jvmAsmInt(&asm, pool, 4)
			jvmAsmU1(&asm, 0x60)
			jvmAsmPutStatic(&asm, pool, "SP", "I")
			jvmRunContinue(&asm, loop)
		}
		jvmAsmMark(&asm, labels[6])
		jvmRunNextLocal(&asm, pool, 1)
		jvmAsmGetStatic(&asm, pool, "SP", "I")
		jvmAsmInt(&asm, pool, 4)
		jvmAsmU1(&asm, 0x64)
		jvmAsmU1(&asm, 0x59)
		jvmAsmPutStatic(&asm, pool, "SP", "I")
		jvmAsmLocal(&asm, 0x36, 2)
		jvmRunRStoreLocalPrefix(&asm, pool, 1)
		jvmAsmLocal(&asm, 0x15, 2)
		jvmAsmInt(&asm, pool, 4)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "load", "(II)I")
		jvmAsmU1(&asm, 0x4f)
		jvmRunContinue(&asm, loop)

		// frame load/store/address.
		for op := 8; op <= 10; op++ {
			jvmAsmMark(&asm, labels[op-1])
			jvmRunNextLocal(&asm, pool, 1)
			jvmRunI32Local(&asm, pool, 2)
			jvmAsmGetStatic(&asm, pool, "FP", "I")
			jvmAsmLocal(&asm, 0x15, 2)
			jvmAsmU1(&asm, 0x64)
			jvmAsmLocal(&asm, 0x36, 3)
			if op == 8 {
				jvmRunRStoreLocalPrefix(&asm, pool, 1)
				jvmAsmLocal(&asm, 0x15, 3)
				jvmAsmInt(&asm, pool, 4)
				jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "load", "(II)I")
				jvmAsmU1(&asm, 0x4f)
			} else if op == 9 {
				jvmAsmLocal(&asm, 0x15, 3)
				jvmAsmInt(&asm, pool, 4)
				jvmRunRLoadLocal(&asm, pool, 1)
				jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "store", "(III)Z")
				jvmAsmU1(&asm, 0x57)
			} else {
				jvmRunRStoreLocalPrefix(&asm, pool, 1)
				jvmAsmLocal(&asm, 0x15, 3)
				jvmAsmU1(&asm, 0x4f)
			}
			jvmRunContinue(&asm, loop)
		}

		// memory load/store.
		for op := 11; op <= 12; op++ {
			jvmAsmMark(&asm, labels[op-1])
			jvmRunNextLocal(&asm, pool, 1)
			jvmRunNextLocal(&asm, pool, 2)
			jvmRunRLoadLocal(&asm, pool, 2)
			jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "i32", "()I")
			jvmAsmU1(&asm, 0x60)
			jvmAsmLocal(&asm, 0x36, 3)
			jvmRunNextLocal(&asm, pool, 4)
			if op == 11 {
				jvmRunRStoreLocalPrefix(&asm, pool, 1)
				jvmAsmLocal(&asm, 0x15, 3)
				jvmAsmLocal(&asm, 0x15, 4)
				jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "loadCode", "(II)I")
				jvmAsmU1(&asm, 0x4f)
			} else {
				jvmAsmLocal(&asm, 0x15, 3)
				jvmAsmLocal(&asm, 0x15, 4)
				jvmRunRLoadLocal(&asm, pool, 1)
				jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "store", "(III)Z")
				jvmAsmU1(&asm, 0x57)
			}
			jvmRunContinue(&asm, loop)
		}

		// indexed memory load/store.
		for op := 13; op <= 14; op++ {
			jvmAsmMark(&asm, labels[op-1])
			jvmRunNextLocal(&asm, pool, 1)
			jvmRunNextLocal(&asm, pool, 2)
			jvmRunNextLocal(&asm, pool, 3)
			jvmRunNextLocal(&asm, pool, 4)
			jvmRunRLoadLocal(&asm, pool, 2)
			jvmRunRLoadLocal(&asm, pool, 3)
			jvmAsmLocal(&asm, 0x15, 4)
			jvmAsmU1(&asm, 0x68)
			jvmAsmU1(&asm, 0x60)
			jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "i32", "()I")
			jvmAsmU1(&asm, 0x60)
			jvmAsmLocal(&asm, 0x36, 5)
			jvmRunNextLocal(&asm, pool, 4)
			if op == 13 {
				jvmRunRStoreLocalPrefix(&asm, pool, 1)
				jvmAsmLocal(&asm, 0x15, 5)
				jvmAsmLocal(&asm, 0x15, 4)
				jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "loadCode", "(II)I")
				jvmAsmU1(&asm, 0x4f)
			} else {
				jvmAsmLocal(&asm, 0x15, 5)
				jvmAsmLocal(&asm, 0x15, 4)
				jvmRunRLoadLocal(&asm, pool, 1)
				jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "store", "(III)Z")
				jvmAsmU1(&asm, 0x57)
			}
			jvmRunContinue(&asm, loop)
		}

		// arithmetic and bitwise operations.
		for op := 15; op <= 25; op++ {
			jvmAsmMark(&asm, labels[op-1])
			jvmRunNextLocal(&asm, pool, 1)
			jvmRunNextLocal(&asm, pool, 2)
			jvmRunRStoreLocalPrefix(&asm, pool, 1)
			jvmAsmInt(&asm, pool, op)
			jvmRunRLoadLocal(&asm, pool, 1)
			jvmRunRLoadLocal(&asm, pool, 2)
			jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "binary", "(III)I")
			jvmAsmU1(&asm, 0x4f)
			jvmRunContinue(&asm, loop)
		}

		jvmAsmMark(&asm, labels[25])
		jvmRunNextLocal(&asm, pool, 1)
		jvmRunRStoreLocalPrefix(&asm, pool, 1)
		jvmRunRLoadLocal(&asm, pool, 1)
		jvmAsmU1(&asm, 0x04)
		jvmAsmU1(&asm, 0x60)
		jvmAsmU1(&asm, 0x4f)
		jvmRunContinue(&asm, loop)

		jvmAsmMark(&asm, labels[26])
		jvmRunNextLocal(&asm, pool, 1)
		jvmRunNextLocal(&asm, pool, 2)
		jvmRunRLoadLocal(&asm, pool, 1)
		jvmAsmPutStatic(&asm, pool, "FL", "I")
		jvmRunRLoadLocal(&asm, pool, 2)
		jvmAsmPutStatic(&asm, pool, "FR", "I")
		jvmRunContinue(&asm, loop)

		jvmAsmMark(&asm, labels[27])
		jvmRunNextLocal(&asm, pool, 1)
		jvmRunNextLocal(&asm, pool, 2)
		jvmRunRStoreLocalPrefix(&asm, pool, 2)
		jvmAsmGetStatic(&asm, pool, "FL", "I")
		jvmAsmGetStatic(&asm, pool, "FR", "I")
		jvmAsmLocal(&asm, 0x15, 1)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "condition", "(III)Z")
		jvmAsmU1(&asm, 0x4f)
		jvmRunContinue(&asm, loop)

		jvmAsmMark(&asm, labels[28])
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "i32", "()I")
		jvmAsmPutStatic(&asm, pool, "PC", "I")
		jvmRunContinue(&asm, loop)

		jvmAsmMark(&asm, labels[29])
		jvmRunNextLocal(&asm, pool, 1)
		jvmRunI32Local(&asm, pool, 2)
		jvmAsmGetStatic(&asm, pool, "FL", "I")
		jvmAsmGetStatic(&asm, pool, "FR", "I")
		jvmAsmLocal(&asm, 0x15, 1)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "condition", "(III)Z")
		notTaken := jvmAsmNewLabel(&asm)
		jvmAsmBranch(&asm, 0x99, notTaken)
		jvmAsmLocal(&asm, 0x15, 2)
		jvmAsmPutStatic(&asm, pool, "PC", "I")
		jvmAsmMark(&asm, notTaken)
		jvmRunContinue(&asm, loop)

		jvmAsmMark(&asm, labels[30])
		jvmRunI32Local(&asm, pool, 1)
		jvmRunI32Local(&asm, pool, 2)
		jvmAsmLocal(&asm, 0x15, 1)
		jvmAsmLocal(&asm, 0x15, 2)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "call", "(II)V")
		jvmRunContinue(&asm, loop)

		jvmAsmMark(&asm, labels[31])
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "ret", "()Z")
		returned := jvmAsmNewLabel(&asm)
		jvmAsmBranch(&asm, 0x9a, returned)
		jvmAsmRLoadConst(&asm, pool, 0)
		jvmAsmInt(&asm, pool, 255)
		jvmAsmU1(&asm, 0x7e)
		jvmAsmU1(&asm, 0xac)
		jvmAsmMark(&asm, returned)
		jvmRunContinue(&asm, loop)

		jvmAsmMark(&asm, labels[32])
		jvmAsmRStoreConstPrefix(&asm, pool, 0)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "syscall", "()I")
		jvmAsmU1(&asm, 0x4f)
		jvmRunContinue(&asm, loop)

		jvmAsmMark(&asm, labels[33])
		jvmAsmGetStatic(&asm, pool, "M", "[B")
		jvmAsmRLoadConst(&asm, pool, 4)
		jvmAsmGetStatic(&asm, pool, "M", "[B")
		jvmAsmRLoadConst(&asm, pool, 3)
		jvmAsmRLoadConst(&asm, pool, 1)
		jvmAsmInvokeStatic(&asm, pool, "java/lang/System", "arraycopy", "(Ljava/lang/Object;ILjava/lang/Object;II)V")
		jvmRunContinue(&asm, loop)

		jvmAsmMark(&asm, labels[34])
		jvmRunNextLocal(&asm, pool, 1)
		jvmRunNextLocal(&asm, pool, 2)
		jvmRunNextLocal(&asm, pool, 3)
		jvmRunI32Local(&asm, pool, 4)
		jvmRunI32Local(&asm, pool, 5)
		jvmRunRStoreLocalPrefix(&asm, pool, 1)
		baseMissing := jvmAsmNewLabel(&asm)
		baseDone := jvmAsmNewLabel(&asm)
		jvmAsmLocal(&asm, 0x15, 2)
		jvmAsmInt(&asm, pool, 8)
		jvmAsmBranch(&asm, 0xa2, baseMissing)
		jvmRunRLoadLocal(&asm, pool, 2)
		jvmAsmGoto(&asm, baseDone)
		jvmAsmMark(&asm, baseMissing)
		jvmAsmU1(&asm, 0x03)
		jvmAsmMark(&asm, baseDone)
		indexMissing := jvmAsmNewLabel(&asm)
		indexDone := jvmAsmNewLabel(&asm)
		jvmAsmLocal(&asm, 0x15, 3)
		jvmAsmInt(&asm, pool, 8)
		jvmAsmBranch(&asm, 0xa2, indexMissing)
		jvmRunRLoadLocal(&asm, pool, 3)
		jvmAsmGoto(&asm, indexDone)
		jvmAsmMark(&asm, indexMissing)
		jvmAsmU1(&asm, 0x03)
		jvmAsmMark(&asm, indexDone)
		jvmAsmLocal(&asm, 0x15, 4)
		jvmAsmU1(&asm, 0x68)
		jvmAsmU1(&asm, 0x60)
		jvmAsmLocal(&asm, 0x15, 5)
		jvmAsmU1(&asm, 0x60)
		jvmAsmU1(&asm, 0x4f)
		jvmRunContinue(&asm, loop)

		jvmAsmMark(&asm, labels[35])
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "write", "()V")
		jvmRunContinue(&asm, loop)

		jvmAsmMark(&asm, labels[36])
		jvmRunNextLocal(&asm, pool, 1)
		jvmRunI32Local(&asm, pool, 2)
		jvmRunRLoadLocal(&asm, pool, 1)
		jvmAsmLocal(&asm, 0x15, 2)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "call", "(II)V")
		jvmRunContinue(&asm, loop)

		jvmAsmMark(&asm, labels[37])
		jvmAsmRStoreConstPrefix(&asm, pool, 0)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "fileOpen", "()I")
		jvmAsmU1(&asm, 0x4f)
		jvmRunContinue(&asm, loop)

		jvmAsmMark(&asm, labels[38])
		jvmAsmRStoreConstPrefix(&asm, pool, 0)
		jvmAsmRLoadConst(&asm, pool, 3)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "fileClose", "(I)I")
		jvmAsmU1(&asm, 0x4f)
		jvmRunContinue(&asm, loop)

		jvmAsmMark(&asm, labels[39])
		jvmAsmRStoreConstPrefix(&asm, pool, 0)
		jvmAsmRLoadConst(&asm, pool, 3)
		jvmAsmRLoadConst(&asm, pool, 4)
		jvmAsmRLoadConst(&asm, pool, 1)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "fileRead", "(III)I")
		jvmAsmU1(&asm, 0x4f)
		jvmRunContinue(&asm, loop)

		jvmAsmMark(&asm, labels[40])
		jvmAsmRStoreConstPrefix(&asm, pool, 0)
		jvmAsmRLoadConst(&asm, pool, 3)
		jvmAsmRLoadConst(&asm, pool, 4)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "fileChmod", "(II)I")
		jvmAsmU1(&asm, 0x4f)
		jvmRunContinue(&asm, loop)

		for op := 42; op <= 43; op++ {
			jvmAsmMark(&asm, labels[op-1])
			jvmAsmRStoreConstPrefix(&asm, pool, 0)
			jvmAsmRLoadConst(&asm, pool, 3)
			jvmAsmRLoadConst(&asm, pool, 4)
			jvmAsmRLoadConst(&asm, pool, 1)
			jvmAsmRLoadConst(&asm, pool, 2)
			name := "fileReadAt"
			if op == 43 { name = "fileWriteAt" }
			jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", name, "(IIII)I")
			jvmAsmU1(&asm, 0x4f)
			jvmRunContinue(&asm, loop)
		}

		jvmAsmMark(&asm, labels[43])
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "i32", "()I")
		jvmAsmLocal(&asm, 0x36, 1)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "u8", "()I")
		jvmAsmLocal(&asm, 0x36, 2)
		jvmAsmLocal(&asm, 0x15, 1)
		jvmAsmLocal(&asm, 0x15, 2)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "buildArgsEnv", "(II)V")
		jvmRunContinue(&asm, loop)

		jvmAsmMark(&asm, labels[44])
		jvmRunNextLocal(&asm, pool, 1)
		jvmRunRStoreLocalPrefix(&asm, pool, 1)
		jvmRunRLoadLocal(&asm, pool, 1)
		jvmAsmU1(&asm, 0x04)
		jvmAsmU1(&asm, 0x64)
		jvmAsmU1(&asm, 0x4f)
		jvmRunContinue(&asm, loop)

		jvmAsmMark(&asm, labels[45])
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "host", "()V")
		jvmRunContinue(&asm, loop)

		jvmAsmMark(&asm, invalid)
		jvmAsmInt(&asm, pool, 126)
		jvmAsmU1(&asm, 0xac)
		return jvmMethod{access: 0x0009, name: "run",
			descriptor: "([Ljava/lang/String;)I", maxStack: 8,
			maxLocals: 6, code: jvmAsmPatch(&asm)}
	}

	func jvmAsmLdcString(
		asm *jvmAssembler, pool *jvmConstantPool, value string,
	) {
		index := jvmPoolString(pool, value)
		if index <= 255 {
			jvmAsmU1(asm, 0x12)
			jvmAsmU1(asm, index)
		} else {
			jvmAsmU1(asm, 0x13)
			jvmAsmU2(asm, index)
		}
	}

	func jvmAsmLdcClass(
		asm *jvmAssembler, pool *jvmConstantPool, name string,
	) {
		index := jvmPoolClass(pool, name)
		if index <= 255 {
			jvmAsmU1(asm, 0x12)
			jvmAsmU1(asm, index)
		} else {
			jvmAsmU1(asm, 0x13)
			jvmAsmU2(asm, index)
		}
	}

	func jvmAsmLdcByteString(
		asm *jvmAssembler, pool *jvmConstantPool, value []byte,
	) {
		index := jvmPoolByteString(pool, value)
		if index <= 255 {
			jvmAsmU1(asm, 0x12)
			jvmAsmU1(asm, index)
		} else {
			jvmAsmU1(asm, 0x13)
			jvmAsmU2(asm, index)
		}
	}

	func jvmMakeCopyChars(pool *jvmConstantPool) jvmMethod {
		var asm jvmAssembler
		loop := jvmAsmNewLabel(&asm)
		done := jvmAsmNewLabel(&asm)
		jvmAsmU1(&asm, 0x03)
		jvmAsmLocal(&asm, 0x36, 3)
		jvmAsmMark(&asm, loop)
		jvmAsmLocal(&asm, 0x15, 3)
		jvmAsmLocal(&asm, 0x19, 1)
		jvmAsmInvokeVirtual(&asm, pool, "java/lang/String", "length", "()I")
		jvmAsmBranch(&asm, 0xa2, done)
		jvmAsmLocal(&asm, 0x19, 0)
		jvmAsmLocal(&asm, 0x15, 2)
		jvmAsmLocal(&asm, 0x15, 3)
		jvmAsmU1(&asm, 0x60)
		jvmAsmLocal(&asm, 0x19, 1)
		jvmAsmLocal(&asm, 0x15, 3)
		jvmAsmInvokeVirtual(&asm, pool, "java/lang/String", "charAt", "(I)C")
		jvmAsmU1(&asm, 0x91)
		jvmAsmU1(&asm, 0x54)
		jvmAsmLocal(&asm, 0x15, 3)
		jvmAsmU1(&asm, 0x04)
		jvmAsmU1(&asm, 0x60)
		jvmAsmLocal(&asm, 0x36, 3)
		jvmAsmGoto(&asm, loop)
		jvmAsmMark(&asm, done)
		jvmAsmU1(&asm, 0xb1)
		return jvmMethod{access: 0x000a, name: "copyChars",
			descriptor: "([BLjava/lang/String;I)V", maxStack: 5,
			maxLocals: 4, code: jvmAsmPatch(&asm)}
	}

	func jvmEmitDecodedBytes(
		asm *jvmAssembler, pool *jvmConstantPool, data []byte,
	) {
		chunkSize := 24000
		jvmAsmInt(asm, pool, len(data))
		jvmAsmU1(asm, 0xbc)
		jvmAsmU1(asm, 8)
		count := (len(data)+chunkSize-1)/chunkSize
		for i := 0; i < count; i++ {
			start := i*chunkSize
			end := start+chunkSize
			if end > len(data) { end = len(data) }
			jvmAsmU1(asm, 0x59)
			jvmAsmLdcByteString(asm, pool, data[start:end])
			jvmAsmInt(asm, pool, start)
			jvmAsmInvokeStatic(asm, pool, "RenvoProgram", "copyChars",
				"([BLjava/lang/String;I)V")
		}
	}

	func jvmMakeClassInit(
		pool *jvmConstantPool, code []byte, data []byte,
		dataBase int, bssBase int, bssSize int,
	) jvmMethod {
		var asm jvmAssembler
		jvmEmitDecodedBytes(&asm, pool, code)
		jvmAsmPutStatic(&asm, pool, "C", "[B")
		jvmEmitDecodedBytes(&asm, pool, data)
		jvmAsmPutStatic(&asm, pool, "D", "[B")
		memorySize := bssBase+bssSize+jvmStackBytes
		jvmAsmInt(&asm, pool, memorySize)
		jvmAsmU1(&asm, 0xbc)
		jvmAsmU1(&asm, 8)
		jvmAsmPutStatic(&asm, pool, "M", "[B")
		jvmAsmGetStatic(&asm, pool, "D", "[B")
		jvmAsmU1(&asm, 0x03)
		jvmAsmGetStatic(&asm, pool, "M", "[B")
		jvmAsmInt(&asm, pool, dataBase)
		jvmAsmGetStatic(&asm, pool, "D", "[B")
		jvmAsmU1(&asm, 0xbe)
		jvmAsmInvokeStatic(&asm, pool, "java/lang/System", "arraycopy",
			"(Ljava/lang/Object;ILjava/lang/Object;II)V")
		jvmAsmInt(&asm, pool, 8)
		jvmAsmU1(&asm, 0xbc)
		jvmAsmU1(&asm, 10)
		jvmAsmPutStatic(&asm, pool, "R", "[I")
		jvmAsmInt(&asm, pool, 256)
		jvmAsmMember(&asm, 0xbd, jvmPoolClass(pool, "java/lang/Object"))
		jvmAsmPutStatic(&asm, pool, "F", "[Ljava/lang/Object;")
		jvmAsmInt(&asm, pool, 256)
		jvmAsmU1(&asm, 0xbc)
		jvmAsmU1(&asm, 10)
		jvmAsmPutStatic(&asm, pool, "FO", "[I")
		frameArrays := []string{"CPC", "CFP", "CSP", "CFS", "CDROP"}
		for i := 0; i < len(frameArrays); i++ {
			jvmAsmInt(&asm, pool, 65536)
			jvmAsmU1(&asm, 0xbc)
			jvmAsmU1(&asm, 10)
			jvmAsmPutStatic(&asm, pool, frameArrays[i], "[I")
		}
		jvmAsmInt(&asm, pool, bssBase+bssSize)
		jvmAsmPutStatic(&asm, pool, "SP", "I")
		jvmAsmInt(&asm, pool, memorySize)
		jvmAsmPutStatic(&asm, pool, "FP", "I")
		jvmAsmU1(&asm, 0xb1)
		return jvmMethod{access: 0x0008, name: "<clinit>", descriptor: "()V",
			maxStack: 6, maxLocals: 0, code: asm.code}
	}

	func jvmMakeMain(pool *jvmConstantPool) jvmMethod {
		var asm jvmAssembler
		jvmAsmLocal(&asm, 0x19, 0)
		jvmAsmInvokeStatic(&asm, pool, "RenvoProgram", "run",
			"([Ljava/lang/String;)I")
		jvmAsmInvokeStatic(&asm, pool, "java/lang/System", "exit", "(I)V")
		jvmAsmU1(&asm, 0xb1)
		return jvmMethod{access: 0x0009, name: "main",
			descriptor: "([Ljava/lang/String;)V", maxStack: 1,
			maxLocals: 1, code: asm.code}
	}

	func jvmFieldBytes(
		pool *jvmConstantPool, name string, descriptor string,
	) []byte {
		var result []byte
		result = jvmBE16(result, 0x000a)
		result = jvmBE16(result, jvmPoolUTF8(pool, name))
		result = jvmBE16(result, jvmPoolUTF8(pool, descriptor))
		return jvmBE16(result, 0)
	}

	func jvmBuildClass(out *RTGEmitter) []byte {
		code := out.Code()
		data := out.Data()
		dataBase := jvmDataBase
		bssBase := RTGAlignValue(dataBase+len(data), 8)
		var pool jvmConstantPool
		thisClass := jvmPoolClass(&pool, "RenvoProgram")
		superClass := jvmPoolClass(&pool, "java/lang/Object")
		fieldNames := []string{"C", "D", "M", "R", "A", "E", "F", "FO", "PC", "SP", "FP", "FS", "FL", "FR", "CS", "CPC", "CFP", "CSP", "CFS", "CDROP"}
		fieldTypes := []string{"[B", "[B", "[B", "[I", "[Ljava/lang/String;", "[Ljava/lang/String;", "[Ljava/lang/Object;", "[I", "I", "I", "I", "I", "I", "I", "I", "[I", "[I", "[I", "[I", "[I"}
		fieldBytes := make([][]byte, len(fieldNames))
		for i := 0; i < len(fieldNames); i++ {
			fieldBytes[i] = jvmFieldBytes(&pool, fieldNames[i], fieldTypes[i])
		}
		methods := []jvmMethod{
			jvmMakeConstructor(&pool),
			jvmMakeCopyChars(&pool),
			jvmMakeArguments(&pool),
			jvmMakeEnvironment(&pool),
			jvmMakeU8(&pool),
			jvmMakeI32(&pool),
			jvmMakeLoad(&pool),
			jvmMakeStore(&pool),
			jvmMakeLoadLong(&pool),
			jvmMakeStoreLong(&pool),
			jvmMakeFloatBinary(&pool),
			jvmMakeFloatCompare(&pool),
			jvmMakeFloatConvert(&pool),
			jvmMakeIntToFloat(&pool),
			jvmMakeFloatToInt(&pool),
			jvmMakeFloatNegate(&pool),
			jvmMakeLoadCode(&pool),
			jvmMakeCondition(&pool),
			jvmMakeBinary(&pool),
			jvmMakeCall(&pool),
			jvmMakeReturn(&pool),
			jvmMakeWrite(&pool),
			jvmMakeStringAt(&pool),
			jvmMakePathAt(&pool),
			jvmMakeFileOpen(&pool),
			jvmMakeFileClose(&pool),
			jvmMakeFileRead(&pool),
			jvmMakeFileWrite(&pool),
			jvmMakeFileChmod(&pool),
			jvmMakeFileAt(&pool, false),
			jvmMakeFileAt(&pool, true),
			jvmMakeFileGetdents(&pool),
			jvmMakeSyscall(&pool),
			jvmMakeRead16(&pool),
			jvmMakeCopyOut(&pool),
			jvmMakeBuildStrings(&pool),
			jvmMakeBuildArgsEnv(&pool),
			jvmMakeReflectString(&pool),
			jvmMakeHost(&pool),
			jvmMakeClassInit(&pool, code, data, dataBase, bssBase, out.BSSSize()),
			jvmMakeRun(&pool),
			jvmMakeMain(&pool),
		}
		methodBytes := make([][]byte, len(methods))
		for i := 0; i < len(methods); i++ {
			methodBytes[i] = jvmClassMethodBytes(&pool, methods[i])
		}
		var result []byte
		result = append(result, 0xca, 0xfe, 0xba, 0xbe)
		result = jvmBE16(result, 0)
		result = jvmBE16(result, 49)
		result = jvmBE16(result, len(pool.entries)+1)
		for i := 0; i < len(pool.entries); i++ {
			result = append(result, pool.entries[i]...)
		}
		result = jvmBE16(result, 0x0031)
		result = jvmBE16(result, thisClass)
		result = jvmBE16(result, superClass)
		result = jvmBE16(result, 0)
		result = jvmBE16(result, len(fieldBytes))
		for i := 0; i < len(fieldBytes); i++ {
			result = append(result, fieldBytes[i]...)
		}
		result = jvmBE16(result, len(methodBytes))
		for i := 0; i < len(methodBytes); i++ {
			result = append(result, methodBytes[i]...)
		}
		return jvmBE16(result, 0)
	}

	func jvmClassMethodBytes(
		pool *jvmConstantPool, method jvmMethod,
	) []byte {
		var result []byte
		result = jvmBE16(result, method.access)
		result = jvmBE16(result, jvmPoolUTF8(pool, method.name))
		result = jvmBE16(result, jvmPoolUTF8(pool, method.descriptor))
		result = jvmBE16(result, 1)
		result = jvmBE16(result, jvmPoolUTF8(pool, "Code"))
		exceptionBytes := len(method.exceptionStart)*8
		result = jvmBE32(result, 12+len(method.code)+exceptionBytes)
		result = jvmBE16(result, method.maxStack)
		result = jvmBE16(result, method.maxLocals)
		result = jvmBE32(result, len(method.code))
		result = append(result, method.code...)
		result = jvmBE16(result, len(method.exceptionStart))
		for i := 0; i < len(method.exceptionStart); i++ {
			result = jvmBE16(result, method.exceptionStart[i])
			result = jvmBE16(result, method.exceptionEnd[i])
			result = jvmBE16(result, method.exceptionHandler[i])
			result = jvmBE16(result, method.exceptionClass[i])
		}
		result = jvmBE16(result, 0)
		return result
	}

	func jvmImage(out *RTGEmitter) []byte {
		return jvmBuildClass(out)
	}
}

arch jvmvm32 {
	alias = jvmvm32
	endian = little
	word_bits = 32
	pointer_bits = 32
	stack_word_bytes = 4
	stack_alignment = 8
	unaligned_memory = true
	patch_relocations = go jvmPatchRelocations
	registers virtual = [rax, rdx, rcx, rdi, rsi, r8, r9, r10]
	locations {
		primary = rax
		secondary = rdx
		tertiary = rcx
		scratch = r10
		copy_destination = rdi
		copy_source = rsi
		copy_count = rdx
	}
	conditions {
		eq = 0
		ne = 1
		slt = 2
		sle = 3
		sgt = 4
		sge = 5
		ult = 6
		uge = 7
		ule = 8
		ugt = 9
	}
	bind {
		move = go jvmMove
		address = go jvmAddress
		load.native = go jvmLoadNative
		load.i32 = go jvmLoadI32
		load.u32 = go jvmLoadU32
		load.i16 = go jvmLoadI16
		load.u16 = go jvmLoadU16
		load.i8 = go jvmLoadI8
		load.u8 = go jvmLoadU8
		store.native = go jvmStoreNative
		store.u32 = go jvmStoreU32
		store.u16 = go jvmStoreU16
		store.u8 = go jvmStoreU8
		add = go jvmAdd
		subtract = go jvmSubtract
		multiply = go jvmMultiply
		bit_and = go jvmBitAnd
		bit_or = go jvmBitOr
		bit_xor = go jvmBitXor
		compare = go jvmCompare
		test = go jvmTest
		increment = go jvmIncrement
		decrement = go jvmDecrement
		shift_left_immediate = go jvmShiftLeftImmediate
		shift_right_unsigned_immediate = go jvmShiftRightUnsignedImmediate
		shift_right_signed_immediate = go jvmShiftRightSignedImmediate
		call = go jvmCall
		call_indirect = go jvmCallIndirect
		jump = go jvmJump
		jump_condition = go jvmJumpCondition
		set_condition = go jvmSetCondition
		return = go jvmReturn
		leave = go jvmLeave
		host_syscall = go jvmHostSyscall
		move_immediate = go jvmMoveImmediate
		variable_shift = go jvmVariableShift
		signed_divide = go jvmSignedDivide
		copy_bytes = go jvmCopyBytes
	}
}

abi jvm_internal {
	arch = jvmvm32
	frame_start = go jvmFrameStart
	frame_finish = go jvmFrameFinish
	push_register = go jvmPushRegister
	push_immediate = go jvmPushImmediate
	pop_register = go jvmPopRegister
	frame_load = go jvmLoadFrame
	frame_store = go jvmStoreFrame
	frame_address = go jvmAddressFrame
	store_param_word = go jvmStoreParamWord
	call_word_count = go jvmCallWordCount
	call_words = [rdi, rsi, rdx, rcx, r8, r9]
	result = [primary, secondary, tertiary]
	stack_alignment = 8
}

runtime jvm_hosted {
	emit_entry = go jvmHostedEntry
	emit_exit = go jvmExit
	emit_static_call = go jvmStaticCall
	syscall {
		number = rax
		arguments = [rdi, rsi, rdx, rcx, r8, r9]
		result = rax
		instruction = host_syscall
	}
	operation write { emit = go jvmWrite }
	operation open { emit = go jvmOpen }
	operation close { emit = go jvmClose }
	operation read { emit = go jvmRead }
	operation chmod { emit = go jvmChmod }
	operation read_at { emit = go jvmReadAt }
	operation write_at { emit = go jvmWriteAt }
	operation print { use = write args = [stderr, buffer, count] }
}

format jvm_classfile {
	# Renvo linear memory is little-endian. The image hook writes the JVM's
	# independently big-endian classfile structures explicitly.
	byte_order = little
	address_bits = 32
	kind = "jvm-class"
	code_offset = 0
	image = go jvmImage
}

target jvm/vm32 {
	family = structured32
	os = jvm
	arch = jvmvm32
	frontend_arch = vm32
	max_align = 8
	abi = jvm_internal
	runtime = jvm_hosted
	executable = jvm_classfile
	arena_default = 16777216
	build_tags = [jvm, vm, vm32, renvo_jvm_prepared]
	capabilities = [hosted, executable, filesystem, heap, argv, environment, ieee_float]
}

@stdlib "syscall/syscall_jvm_vm32_renvo.go"
//go:build renvo && jvm && vm32

package syscall

// renvoSyscallJVM is recognized by the linker as the JVM host-call boundary.
func renvoSyscallJVM(number int, first string, firstLen int, output []byte, outputLen int) int {
	return 0
}

func JVMCall(number int, first string, output []byte) int {
	return renvoSyscallJVM(number, first, len(first), output, len(output))
}
@endstdlib

@stdlib "java/java_jvm_vm32_renvo.go"
//go:build renvo && jvm && vm32

// Package java exposes the explicit Java boundary supplied by the JVM RBE.
// This v1 surface copies strings and does not expose JVM references.
package java

import "syscall"

const (
	hostSystemProperty = 0x4a01
	hostCallStaticString = 0x4a02
)

func GetProperty(name string) (string, bool) {
	buffer := make([]byte, 4096)
	n := syscall.JVMCall(hostSystemProperty, name, buffer)
	if n < 0 || n > len(buffer) {
		return "", false
	}
	return string(buffer[:n]), true
}

// CallStaticString invokes a public static Java method with exactly one
// java.lang.String parameter. The result is converted with String.valueOf.
func CallStaticString(className, methodName, argument string) (string, bool) {
	request := make([]byte, 6+len(className)+len(methodName)+len(argument))
	put16(request, 0, len(className))
	put16(request, 2, len(methodName))
	put16(request, 4, len(argument))
	at := 6
	at = copyText(request, at, className)
	at = copyText(request, at, methodName)
	copyText(request, at, argument)
	buffer := make([]byte, 4096)
	n := syscall.JVMCall(hostCallStaticString, string(request), buffer)
	if n < 0 || n > len(buffer) {
		return "", false
	}
	return string(buffer[:n]), true
}

func put16(data []byte, at, value int) {
	data[at] = byte(value)
	data[at+1] = byte(value >> 8)
}

func copyText(data []byte, at int, value string) int {
	for i := 0; i < len(value); i++ {
		data[at+i] = value[i]
	}
	return at + len(value)
}
@endstdlib
