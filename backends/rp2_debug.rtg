@import "../backend/definitions/rp2_common.rtg"

go backend {
	func hotReloadFunctionFinish(out *RTGEmitter) {
		for out.Len()&255 != 0 {
			thumb.emit16(out, 0x46c0)
		}
	}
}

abi rp2_debug_internal {
	internal = thumb_internal
	function_finish = go hotReloadFunctionFinish
}

target rp2-debug/thumb {
	family = native_v1
	os = rp2
	arch = thumb
	frontend_arch = thumb
	abi = rp2_debug_internal
	runtime = rp2_debug_freestanding
	executable = rp2_debug_elf
	build_tags = [rp2, thumb, renvo_hotreload]
	capabilities = [freestanding, executable, volatile_memory]
	// SRAM 0x20010000..0x20020000 is shared by globals, runtime state, and
	// the arena. Leave half of that partition for non-arena data; text begins
	// at 0x20020000.
	arena_default = 32768
}
