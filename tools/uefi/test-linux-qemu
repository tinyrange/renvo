#!/bin/sh
set -eu

tool_root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repository_root=$(CDPATH= cd -- "$tool_root/../.." && pwd)
alpine_base=${RENVO_ALPINE_BASE:-https://dl-cdn.alpinelinux.org/alpine/latest-stable/releases/x86_64}
cache=${RENVO_UEFI_CACHE:-$repository_root/sandbox/uefi-cache}

for command in curl tar cpio gzip truncate mkfs.vfat mmd mcopy; do
	if ! command -v "$command" >/dev/null 2>&1; then
		echo "$command not found" >&2
		exit 2
	fi
done

qemu=${RENVO_UEFI_QEMU:-qemu-system-x86_64}
if ! command -v "$qemu" >/dev/null 2>&1; then
	echo "qemu-system-x86_64 not found; set RENVO_UEFI_QEMU" >&2
	exit 2
fi

timeout_command=${RENVO_UEFI_TIMEOUT:-}
boot_timeout=${RENVO_UEFI_BOOT_TIMEOUT:-60s}
if [ -z "$timeout_command" ]; then
	if command -v timeout >/dev/null 2>&1; then
		timeout_command=timeout
	elif command -v gtimeout >/dev/null 2>&1; then
		timeout_command=gtimeout
	else
		echo "timeout or gtimeout not found; set RENVO_UEFI_TIMEOUT" >&2
		exit 2
	fi
fi

ovmf_code=${RENVO_OVMF_CODE:-}
if [ -z "$ovmf_code" ]; then
	for candidate in \
		/usr/share/OVMF/OVMF_CODE.fd \
		/usr/share/OVMF/OVMF_CODE_4M.fd \
		/usr/share/edk2/x64/OVMF_CODE.fd \
		/usr/share/edk2/ovmf/OVMF_CODE.fd \
		/usr/share/qemu/OVMF_CODE.fd
	do
		if [ -f "$candidate" ]; then ovmf_code=$candidate; break; fi
	done
fi
if [ -z "$ovmf_code" ] || [ ! -f "$ovmf_code" ]; then
	echo "OVMF_CODE.fd not found; set RENVO_OVMF_CODE" >&2
	exit 2
fi

mkdir -p "$cache"
metadata=$cache/latest-releases.yaml
curl -fsSL "$alpine_base/latest-releases.yaml" -o "$metadata"
minirootfs=$(awk '
	$1 == "flavor:" && $2 == "alpine-minirootfs" { found = 1 }
	found && $1 == "file:" { print $2; exit }
' "$metadata")
minirootfs_sha256=$(awk '
	$1 == "flavor:" && $2 == "alpine-minirootfs" { found = 1 }
	found && $1 == "sha256:" { print $2; exit }
' "$metadata")
if [ -z "$minirootfs" ] || [ -z "$minirootfs_sha256" ]; then
	echo "could not find the Alpine minirootfs in latest-releases.yaml" >&2
	exit 1
fi

rootfs_archive=$cache/$minirootfs
kernel=$cache/vmlinuz-virt
if [ ! -f "$rootfs_archive" ]; then
	curl -fL "$alpine_base/$minirootfs" -o "$rootfs_archive"
fi
if command -v sha256sum >/dev/null 2>&1; then
	actual_sha256=$(sha256sum "$rootfs_archive" | awk '{print $1}')
else
	actual_sha256=$(shasum -a 256 "$rootfs_archive" | awk '{print $1}')
fi
if [ "$actual_sha256" != "$minirootfs_sha256" ]; then
	echo "Alpine minirootfs checksum mismatch" >&2
	exit 1
fi
if [ ! -f "$kernel" ]; then
	curl -fL "$alpine_base/netboot/vmlinuz-virt" -o "$kernel"
fi

temporary=$(mktemp -d)
trap 'rm -rf "$temporary"' EXIT HUP INT TERM
rootfs=$temporary/rootfs
esp=$temporary/esp
serial_log=$temporary/serial.log
mkdir -p "$rootfs" "$esp/EFI/BOOT"
tar -xzf "$rootfs_archive" -C "$rootfs"
printf '%s\n' \
	'#!/bin/busybox sh' \
	'mount -t devtmpfs devtmpfs /dev' \
	'mount -t proc proc /proc' \
	'mount -t sysfs sysfs /sys' \
	'echo "RENVO UEFI ALPINE PASS" >/dev/ttyS0' \
	'echo "Alpine $(cat /etc/alpine-release), Linux $(uname -r)" >/dev/ttyS0' \
	'sync' \
	'poweroff -f' \
	'exec /bin/busybox sh' >"$rootfs/init"
chmod 0755 "$rootfs/init"
(cd "$rootfs" && find . -print0 | cpio --null --quiet -o --format=newc | gzip -9) >"$esp/initramfs"
cp "$kernel" "$esp/vmlinuz"
cp "$repository_root/examples/uefi-linux-boot/config.txt" "$esp/config.txt"

if [ -n "${RENVO:-}" ]; then
	renvo=$RENVO
else
	renvo=$temporary/renvo
	(cd "$repository_root" && go build -o "$renvo" ./cmd/renvo)
fi
"$renvo" -backend "$repository_root/backends/uefi_amd64.rtg" \
	-t uefi/amd64 -s -o "$esp/EFI/BOOT/BOOTX64.EFI" \
	"$repository_root/examples/uefi-linux-boot"

# QEMU's virtual fat: directory backend can deadlock OVMF while opening larger
# payloads. A real FAT image also better matches the disk layout used by UEFI.
esp_image=$temporary/esp.img
truncate -s 128M "$esp_image"
mkfs.vfat "$esp_image" >/dev/null
mmd -i "$esp_image" ::/EFI ::/EFI/BOOT
mcopy -i "$esp_image" "$esp/EFI/BOOT/BOOTX64.EFI" ::/EFI/BOOT/BOOTX64.EFI
mcopy -i "$esp_image" "$esp/config.txt" "$esp/vmlinuz" "$esp/initramfs" ::/

set +e
"$timeout_command" "$boot_timeout" "$qemu" \
	-machine q35 -cpu max -m 256M -display none -monitor none -no-reboot \
	-serial "file:$serial_log" \
	-drive "if=pflash,format=raw,readonly=on,file=$ovmf_code" \
	-drive "format=raw,file=$esp_image"
status=$?
set -e

if ! grep -q "RENVO UEFI ALPINE PASS" "$serial_log"; then
	echo "Linux boot smoke failed: emulator exit status $status" >&2
	tail -80 "$serial_log" >&2
	exit 1
fi
echo "PASS: Renvo loaded a Linux bzImage and Alpine initramfs through the native x86-64 boot protocol"
