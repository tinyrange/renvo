# Pinned Linux/x86_64 M9 boot profile. This is an additive tinyconfig fragment;
# Kconfig continues to choose dependency values for the pinned 6.12.99 tree.
CONFIG_64BIT=y
CONFIG_EXPERT=y
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_PRINTK=y
CONFIG_TTY=y
CONFIG_SERIAL_EARLYCON=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_DEPRECATED_OPTIONS=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_PHYSICAL_START=0x200000
CONFIG_PHYSICAL_ALIGN=0x200000
CONFIG_INIT_STACK_NONE=y
