func rtgNativeAarch64EmitAddress(out *RTGEmitter, destination RTGRegister, address RTGAddress) {
	if RTGAddressValid(address) {
		rtgNativeAarch64EmitADR(out, destination, address)
		return
	}
	base := address.Base.Code
	if address.Index.Valid {
		shift := 0
		if address.Scale == 2 {
			shift = 1
		} else if address.Scale == 4 {
			shift = 2
		} else if address.Scale == 8 {
			shift = 3
		}
		renvoAarch64AsmAddRegRegShift(
			out, destination.Code, base, address.Index.Code, shift)
		base = destination.Code
	}
	renvoAarch64AsmAddRegImm(
		out, destination.Code, base, address.Displacement)
}
func rtgNativeAarch64MemoryBase(out *RTGEmitter, address RTGAddress) int {
	if RTGAddressValid(address) || address.Index.Valid {
		rtgNativeAarch64EmitAddress(out, rtgNativeAddress, address)
		return rtgNativeAddress.Code
	}
	if address.Displacement < -256 || address.Displacement > 255 {
		rtgNativeAarch64EmitAddress(out, rtgNativeAddress, address)
		return rtgNativeAddress.Code
	}
	return address.Base.Code
}
func rtgNativeAarch64LoadWidth(
	out *RTGEmitter,
	destination RTGRegister,
	address RTGAddress,
	size int,
	signed bool,
) {
	base := rtgNativeAarch64MemoryBase(out, address)
	displacement := address.Displacement
	if base == rtgNativeAddress.Code {
		displacement = 0
	}
	imm := (displacement & 511) << 12
	op := 0xf8400000
	if size == 1 {
		op = 0x38400000
		if signed {
			op = 0x38800000
		}
	} else if size == 2 {
		op = 0x78400000
		if signed {
			op = 0x78800000
		}
	} else if size == 4 {
		op = 0xb8400000
		if signed {
			op = 0xb8800000
		}
	}
	renvoAarch64AsmEmit(
		out, op|imm|(base<<5)|destination.Code)
}
func rtgNativeAarch64StoreWidth(
	out *RTGEmitter,
	address RTGAddress,
	source RTGRegister,
	size int,
) {
	base := rtgNativeAarch64MemoryBase(out, address)
	displacement := address.Displacement
	if base == rtgNativeAddress.Code {
		displacement = 0
	}
	imm := (displacement & 511) << 12
	op := 0xf8000000
	if size == 1 {
		op = 0x38000000
	} else if size == 2 {
		op = 0x78000000
	} else if size == 4 {
		op = 0xb8000000
	}
	renvoAarch64AsmEmit(out, op|imm|(base<<5)|source.Code)
}
func rtgNativeAarch64VariableShift(
	out *RTGEmitter, direction RTGShiftDirection, signed bool,
) {
	op := 0x9ac02400
	if direction == RTGShiftLeft {
		op = 0x9ac02000
	} else if signed {
		op = 0x9ac02800
	}
	renvoAarch64AsmEmit(out,
		op|(rtgNativePrimary.Code<<16)|
			(rtgNativeTertiary.Code<<5)|rtgNativePrimary.Code)
}
func rtgNativeAarch64SignedDivide(out *RTGEmitter, remainder bool) {
	renvoAarch64AsmMovRegReg(
		out, rtgNativeScratch.Code, rtgNativePrimary.Code)
	renvoAarch64AsmEmit(out,
		0x9ac00c00|(rtgNativePrimary.Code<<16)|
			(rtgNativeTertiary.Code<<5)|rtgNativePrimary.Code)
	if remainder {
		renvoAarch64AsmEmit(out,
			0x9b008000|(rtgNativeScratch.Code<<16)|
				(rtgNativePrimary.Code<<10)|
				(rtgNativeTertiary.Code<<5)|rtgNativePrimary.Code)
