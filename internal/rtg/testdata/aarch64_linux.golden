func renvoAarch64AsmStackMem(a *RTGEmitter, offset int, base int, disp8 int, disp32 int) {
	if base == 0x8948 && disp8 == 0x45 {
		renvoAarch64AsmStoreRegStack(a, rtgAarch64Primary.Code, offset)
		return
	}
	if base == 0x8948 && disp8 == 0x55 {
		renvoAarch64AsmStoreRegStack(a, rtgAarch64Secondary.Code, offset)
		return
	}
	if base == 0x8948 && disp8 == 0x4d {
		renvoAarch64AsmStoreRegStack(a, rtgAarch64Tertiary.Code, offset)
		return
	}
	if base == 0x8b48 && disp8 == 0x45 {
		renvoAarch64AsmLoadRegStack(a, rtgAarch64Primary.Code, offset)
		return
	}
	if base == 0x8b48 && disp8 == 0x55 {
		renvoAarch64AsmLoadRegStack(a, rtgAarch64Secondary.Code, offset)
		return
	}
	if base == 0x8b48 && disp8 == 0x4d {
		renvoAarch64AsmLoadRegStack(a, rtgAarch64Tertiary.Code, offset)
		return
	}
	if base == 0x8d48 && disp8 == 0x45 {
		renvoAarch64AsmLeaRegStack(a, rtgAarch64Primary.Code, offset)
		return
	}
	if base == 0x8d48 && disp8 == 0x55 {
		renvoAarch64AsmLeaRegStack(a, rtgAarch64Secondary.Code, offset)
		return
	}
	if base == 0x8d48 && disp8 == 0x7d {
		renvoAarch64AsmLeaRegStack(a, rtgAarch64X3.Code, offset)
		return
	}
	if base == 0x8d48 && disp8 == 0x75 {
		renvoAarch64AsmLeaRegStack(a, rtgAarch64X4.Code, offset)
		return
	}
}
