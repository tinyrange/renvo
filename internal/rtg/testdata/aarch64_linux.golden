	rtgAarch64Aarch64Jump(out, environmentLength)
	out.Mark(environmentLengthDone)
	renvoAarch64AsmStoreRegMem(out, 0, 7, 8, 8)
	renvoAarch64AsmAddRegImm(out, 7, 7, 16)
	renvoAarch64AsmAddRegImm(out, 10, 10, 8)
	renvoAarch64AsmAddRegImm(out, 11, 11, 1)
	rtgAarch64Aarch64Jump(out, environmentLoop)
	out.Mark(environmentDone)
	renvoAarch64AsmMovRegAbs(out, 12, environmentLengthOffset, RTGRelocationAbsoluteBSS)
	renvoAarch64AsmStoreRegMem(out, 11, 12, 0, 8)

	renvoAarch64AsmMovRegAbs(out, 3, argsOffset, RTGRelocationAbsoluteBSS)
	renvoAarch64AsmMovRegReg(out, 4, 13)
	renvoAarch64AsmMovRegReg(out, 1, 13)
	renvoAarch64AsmMovRegAbs(out, 2, environmentOffset, RTGRelocationAbsoluteBSS)
	renvoAarch64AsmMovRegReg(out, 5, 11)
	renvoAarch64AsmMovRegReg(out, 6, 11)
	return true
}
func rtgAarch64Aarch64ELFPatchAbsoluteRelocations(a *RTGEmitter, codeOffset int, dataOffset int, bssOffset int) {
	code := a.Code()
	for i := 0; i < a.AbsoluteRelocationCount(); i++ {
		at := a.AbsoluteRelocationOffset(i)
		addend := a.AbsoluteRelocationAddend(i)
		kind := a.AbsoluteRelocationKind(i)
		target := dataOffset + addend
		if kind == RTGRelocationAbsoluteBSS {
			target = bssOffset + addend
		}
		insn := int(code[at]) | int(code[at+1])<<8 | int(code[at+2])<<16 | int(code[at+3])<<24
		reg := insn & 31
		pcPage := (codeOffset + at) & -4096
		targetPage := target & -4096
		pageDelta := (targetPage - pcPage) >> 12
		immlo := pageDelta & 3
		immhi := pageDelta >> 2 & 524287
		a.PatchUint32(at, 0x90000000|(immlo<<29)|(immhi<<5)|reg)
		a.PatchUint32(at+4, 0x91000000|((target&4095)<<10)|(reg<<5)|reg)
		a.PatchUint32(at+8, 0xd503201f)
		a.PatchUint32(at+12, 0xd503201f)
	}
}
func rtgAarch64Aarch64ELF64Image(a *RTGEmitter) []byte {
	codeOffset := 176
	code := a.Code()
	data := a.Data()
	dataOffset := codeOffset + len(code)
	fileSize := dataOffset + len(data)
	bssOffset := RTGAlignValue(fileSize, 4096)
	rtgAarch64Aarch64ELFPatchAbsoluteRelocations(a, codeOffset, dataOffset, bssOffset)
	code = a.Code()
	var out []byte
	out = append(out, 0x7f, 'E', 'L', 'F', 2, 1, 1, 0)
	for len(out) < 16 {
		out = append(out, 0)
	}
	out = rtgAarch64Aarch64ELFAppend16(out, 3)
	out = rtgAarch64Aarch64ELFAppend16(out, 183)
	out = rtgAarch64Aarch64ELFAppend32(out, 1)
	out = rtgAarch64Aarch64ELFAppend64(out, codeOffset)
	out = rtgAarch64Aarch64ELFAppend64(out, 64)
	out = rtgAarch64Aarch64ELFAppend64(out, 0)
	out = rtgAarch64Aarch64ELFAppend32(out, 0)
	out = rtgAarch64Aarch64ELFAppend16(out, 64)
	out = rtgAarch64Aarch64ELFAppend16(out, 56)
	out = rtgAarch64Aarch64ELFAppend16(out, 2)
	out = rtgAarch64Aarch64ELFAppend16(out, 0)
	out = rtgAarch64Aarch64ELFAppend16(out, 0)
	out = rtgAarch64Aarch64ELFAppend16(out, 0)
	out = rtgAarch64Aarch64ELFAppend32(out, 1)
	out = rtgAarch64Aarch64ELFAppend32(out, 5)
	out = rtgAarch64Aarch64ELFAppend64(out, 0)
	out = rtgAarch64Aarch64ELFAppend64(out, 0)
	out = rtgAarch64Aarch64ELFAppend64(out, 0)
	out = rtgAarch64Aarch64ELFAppend64(out, fileSize)
	out = rtgAarch64Aarch64ELFAppend64(out, fileSize)
	out = rtgAarch64Aarch64ELFAppend64(out, 4096)
	out = rtgAarch64Aarch64ELFAppend32(out, 1)
	out = rtgAarch64Aarch64ELFAppend32(out, 6)
	out = rtgAarch64Aarch64ELFAppend64(out, bssOffset)
	out = rtgAarch64Aarch64ELFAppend64(out, bssOffset)
	out = rtgAarch64Aarch64ELFAppend64(out, bssOffset)
	out = rtgAarch64Aarch64ELFAppend64(out, 0)
	out = rtgAarch64Aarch64ELFAppend64(out, a.BSSSize())
	out = rtgAarch64Aarch64ELFAppend64(out, 4096)
	out = append(out, code...)
	out = append(out, data...)
	return out
}
func renvoAarch64AsmEmit(a *RTGEmitter, insn int) {
	RTGUint32(a, insn)
}
func renvoAarch64AsmAlign(a *RTGEmitter) {
	for a.Len()%4 != 0 {
		RTGByte(a, 0)
	}
}
func renvoAarch64AsmMovRegReg(a *RTGEmitter, dst int, src int) {
	if dst == src {
		return
	}
	renvoAarch64AsmEmit(a, 0xaa0003e0|(src<<16)|dst)
}
func renvoAarch64AsmMovRegImm(a *RTGEmitter, reg int, imm int) {
	if imm < 0 {
		inv := -imm - 1
		part := inv & 65535
		renvoAarch64AsmEmit(a, 0x92800000|(part<<5)|reg)
		for i := 1; i < 4; i++ {
			targetPart := (imm >> (i * 16)) & 65535
			if targetPart != 65535 {
				renvoAarch64AsmEmit(a, 0xf2800000|(i<<21)|(targetPart<<5)|reg)
			}
		}
		return
	}
	part := imm & 65535
	renvoAarch64AsmEmit(a, 0xd2800000|(part<<5)|reg)
	for i := 1; i < 4; i++ {
		part = (imm >> (i * 16)) & 65535
		if part != 0 {
			renvoAarch64AsmEmit(a, 0xf2800000|(i<<21)|(part<<5)|reg)
		}
	}
}
func renvoAarch64AsmPatchMovRegImmAt(a *RTGEmitter, at int, reg int, imm int) {
	part := imm & 65535
	a.PatchUint32( at, 0xd2800000|(part<<5)|reg)
	for i := 1; i < 4; i++ {
		part = (imm >> (i * 16)) & 65535
		a.PatchUint32( at+i*4, 0xf2800000|(i<<21)|(part<<5)|reg)
	}
}
func renvoAarch64AsmMovRegAbs(a *RTGEmitter, reg int, off int, kind int) {
	at := a.Len()
	renvoAarch64AsmMovRegImm(a, reg, 0)
	renvoAarch64AsmEmit(a, 0xf2800000|(1<<21)|reg)
	renvoAarch64AsmEmit(a, 0xf2800000|(2<<21)|reg)
	renvoAarch64AsmEmit(a, 0xf2800000|(3<<21)|reg)
	a.AbsoluteReloc( at, off, kind)
}
func renvoAarch64AsmAddRegImm(a *RTGEmitter, dst int, src int, imm int) {
	if imm == 0 {
		renvoAarch64AsmMovRegReg(a, dst, src)
		return
	}
	op := 0x91000000
	if imm < 0 {
		op = 0xd1000000
		imm = -imm
	}
	cur := src
	for imm > 0 {
		shift := 0
		chunk := imm
		if chunk > 4095 {
			chunk = imm / 4096
			if chunk > 4095 {
				chunk = 4095
			}
			shift = 1
			imm = imm - chunk*4096
		} else {
			imm = 0
		}
		renvoAarch64AsmEmit(a, op|(shift<<22)|(chunk<<10)|(cur<<5)|dst)
		cur = dst
	}
}
func renvoAarch64AsmAddRegReg(a *RTGEmitter, dst int, left int, right int) {
	renvoAarch64AsmEmit(a, 0x8b000000|(right<<16)|(left<<5)|dst)
}
