	rtgAarch64Aarch64Jump(out, backwardLoop)

	out.Mark(forward)
	out.Mark(forwardLoop)
	rtgAarch64Aarch64Compare(out, count, rtgAarch64Zero)
	rtgAarch64Aarch64JumpCondition(out, RTGCondition{Code: 0}, done)
	rtgAarch64Aarch64LoadU8(out, value, RTGAddress{Base: source})
