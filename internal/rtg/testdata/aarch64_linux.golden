	out.Mark(forward)
	out.Mark(forwardLoop)
	rtgNativeCompare(out,count,rtgNativeZero)
	rtgNativeJumpCondition(out,RTGCondition{Code:0},done)
	rtgNativeAarch64LoadU8(out,value,RTGAddress{Base:source})
	rtgNativeAarch64StoreU8(out,RTGAddress{Base:destination},value)
	rtgNativeIncrement(out,source)
	rtgNativeIncrement(out,destination)
	rtgNativeDecrement(out,count)
	rtgNativeJump(out,forwardLoop)
	out.Mark(done)
